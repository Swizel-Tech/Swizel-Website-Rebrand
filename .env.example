# ── Mail ──────────────────────────────────────────────────────────────
# Copy these into Vercel → Settings → Environment Variables, and tick
# Production, Preview AND Development. Nothing here belongs in git: this
# file is the shape of the config, never the values.
#
# From cPanel → Email Accounts → Connect Devices, for contact@swizel.co.
SMTP_HOST=mail.swizel.co
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@swizel.co
SMTP_PASS=

# Where each kind of message lands. Only contact@ needs a password: the
# server signs in as that mailbox and simply addresses careers mail to
# the other one.
MAIL_TO_CONTACT=contact@swizel.co
MAIL_TO_CAREERS=career@swizel.co

# ── Analytics ─────────────────────────────────────────────────────────
# Optional. The measurement ID is committed in src/consts.ts because it
# is printed into the page for every visitor to read; this only exists so
# the property can be changed without touching code.
# PUBLIC_GA_ID=
