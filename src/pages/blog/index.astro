---
import MainLayout from '../../layouts/MainLayout.astro';
import BlogBoardroom from '../../components/sections/BlogBoardroom.astro';
import { PAGES } from '../../data/seo';
import { blogPosts } from '../../lib/pages/blog';
const world = 'boardroom' as const;
const seo = PAGES['/blog'];
const posts = await blogPosts();
---
{/* One page per world — see src/lib/worlds.ts. This file is the Boardroom
    version of /blog; the others sit beside it under src/pages/v/<world>/
    and share everything but the world component. */}
<MainLayout title={seo.title} description={seo.description} image={seo.image} world={world}>
	<BlogBoardroom posts={posts} />
</MainLayout>
