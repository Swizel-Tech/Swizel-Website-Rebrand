---
// The application page. Two tracks, what each one actually involves, and
// one form that carries enough for us to make a decision without a chase
// of follow-up emails.
import { Icon } from 'astro-icon/components';
import MainLayout from '../../layouts/MainLayout.astro';
import { bootCampFaq } from '../../consts';

const SEO_TITLE = 'Internships & NYSC Placement | Swizel Technologies Limited';
const SEO_DESC =
	'Do your IT / SIWES industrial training or your NYSC service year at Swizel Technologies Limited, building live client products beside working engineers and designers. A small, selective intake. Apply here.';

const tracks = [
	{
		id: 'internship',
		icon: 'mdi:badge-account-outline',
		kicker: 'Track one',
		name: 'IT / SIWES Internship',
		length: 'Three or six months',
		who: 'Undergraduates whose institution requires industrial training.',
		does: [
			'We teach you first: the fundamentals, our tools and how we actually work',
			'Then a squad on a live client product, with tickets of your own',
			'A named mentor who reviews your work every week',
			'Your school logbook and ITF paperwork signed off properly',
			'Real tickets, real deadlines, real code review',
		],
		wants: [
			'Enough to show us you can build something, however small',
			'A portfolio, a repository, a design file, a campaign you ran',
			'Evidence that you finish what you start',
			'Your school letter and the dates you must cover',
		],
	},
	{
		id: 'nysc',
		icon: 'mdi:flag-outline',
		kicker: 'Track two',
		name: 'NYSC Placement',
		length: 'The full service year',
		who: 'Corps members posted to, or able to redeploy to, Abuja.',
		does: [
			'We teach you first, then you are placed on a live client product',
			'Treated as part of the team, not an errand runner',
			'Ownership of features that ship with your name on them',
			'A reference and a body of real work to show at the end of the year',
			'The ones who deliver are considered for a paid role after',
		],
		wants: [
			'Enough to show us you can build something, however small',
			'A portfolio, a repository, a design file, a campaign you ran',
			'Evidence that you finish what you start',
			'Your call-up letter or posting details',
		],
	},
];

// the promise under both tracks, in the order it actually happens
const plan = [
	{ ic: '🧑\u200d🏫', t: 'We teach you' },
	{ ic: '📚', t: 'You learn' },
	{ ic: '🛠️', t: 'We place you on a project' },
	{ ic: '⚡', t: 'You gain experience' },
	{ ic: '🌱', t: 'You grow' },
];

const steps = [
	{ n: '01', t: 'You apply', d: 'This form. Take your time with the last two questions, they are the ones we read closely.' },
	{ n: '02', t: 'A virtual meeting', d: 'Twenty minutes on a link we send you. We want to hear how you think, not quiz you on syntax.' },
	{ n: '03', t: 'A small task', d: 'Something practical and scoped to a few hours. You keep whatever you build.' },
	{ n: '04', t: 'A straight answer', d: 'Yes or no, quickly. We would rather tell you now than leave you waiting on us.' },
];

const disciplines = [
	'Web development',
	'Mobile development',
	'Product design',
	'Digital marketing',
	'Project management',
];

const levels = ['100 level', '200 level', '300 level', '400 level', '500 level', 'Graduate', 'NYSC corps member'];
---

<MainLayout title={SEO_TITLE} description={SEO_DESC} image="/images/og/og-bootcamp.jpg">
	<article class="pg">
		<!-- Only when you followed Programs out of another world. It does not
		     interrupt the click and it does not shout — a hairline strip in
		     the colour of the world you left, saying where you are and
		     offering the way back. -->
		<div class="pg-from" data-came-from hidden>
			<div class="pg-wrap pg-from-in">
				<span class="pg-from-dot" aria-hidden="true"></span>
				<p>Programs lives in the <b>Campus</b> world, which is the change of colour.</p>
				<a href="/" data-came-from-link>
					<Icon width={14} name="mdi:arrow-left" />
					Back to <b data-came-from-name>Boardroom</b>
				</a>
				<button type="button" data-came-from-x aria-label="Dismiss">
					<Icon width={14} name="mdi:close" />
				</button>
			</div>
		</div>

		<!-- ── hero ── -->
		<header class="pg-hero">
			<div class="pg-wrap">
				<span class="pg-eyebrow">
					<Icon width={14} name="mdi:school-outline" />
					Applications open · Limited seats
				</span>
				<h1 class="pg-title">Two ways in. <em>Both are earned.</em></h1>
				<p class="pg-lead">
					We do not run an open bootcamp any more. You join us for your
					industrial training or for your service year, and either way we
					teach you first, then put you on a live client product beside the
					people who build it for a living. You do not need experience to
					start. You need to be willing to learn.
				</p>
				<div class="pg-herocta">
					<button type="button" class="pg-btn" data-focus="internship" aria-pressed="false">
						IT / SIWES Internship
						<Icon width={17} name="mdi:arrow-down" />
					</button>
					<button type="button" class="pg-btn pg-btn--ghost" data-focus="nysc" aria-pressed="false">
						NYSC Placement
						<Icon width={17} name="mdi:arrow-down" />
					</button>
				</div>
			</div>
		</header>

		<!-- ── the two tracks ── -->
		<!-- Pick one and the pair switches: the chosen track slides to the
		     front and opens up to be read, the other steps back. -->
		<section class="pg-sec" data-cursor="pen">
			<div class="pg-wrap pg-tracks" id="pg-tracks">
				{
					tracks.map((t) => (
						<div class="pg-track" id={t.id} data-track={t.id}>
							<div class="pg-track-head">
								<span class="pg-track-ic"><Icon width={22} name={t.icon} /></span>
								<div>
									<span class="pg-track-kicker">{t.kicker}</span>
									<h2 class="pg-track-name">{t.name}</h2>
								</div>
							</div>
							<p class="pg-track-len">
								<Icon width={15} name="mdi:clock-outline" />
								{t.length}
							</p>
							<p class="pg-track-who">{t.who}</p>

							<span class="pg-track-label">What you actually do</span>
							<ul class="pg-list">
								{t.does.map((d) => (
									<li>
										<Icon width={15} name="mdi:check-circle-outline" />
										<span>{d}</span>
									</li>
								))}
							</ul>

							<span class="pg-track-label">What we look for</span>
							<ul class="pg-list pg-list--want">
								{t.wants.map((wt) => (
									<li>
										<Icon width={15} name="mdi:circle-medium" />
										<span>{wt}</span>
									</li>
								))}
							</ul>

							<p class="pg-track-note">
								No experience yet? Come anyway. We teach and guide you, for
								as long as you are willing to learn.
							</p>

							<a href="#apply" class="pg-track-go" data-pick-track={t.name}>
								Apply for this track
								<Icon width={16} name="mdi:arrow-right" />
							</a>
							<button type="button" class="pg-track-back" data-focus-clear>
								<Icon width={14} name="mdi:arrow-left" />
								See both tracks
							</button>
						</div>
					))
				}
			</div>

			<!-- the promise, in the order it actually happens -->
			<ol class="pg-wrap pg-plan" aria-label="How the year runs">
				{
					plan.map((st, i) => (
						<li class="pg-plan-step" style={`--i:${i}`}>
							<span class="pg-plan-ic" aria-hidden="true">{st.ic}</span>
							<span class="pg-plan-t">{st.t}</span>
						</li>
					))
				}
			</ol>
		</section>

		<!-- ── how it goes ── -->
		<section class="pg-sec pg-sec--steps" data-cursor="pen">
			<div class="pg-wrap">
				<div class="pg-hrow">
					<h2 class="pg-h">How the application goes</h2>
					<!-- a pen that signs the page: it draws itself the first time
					     this section comes into view, then keeps a slow idle wobble
					     so the page never feels like a form and nothing else. -->
					<span class="pg-pen" aria-hidden="true" data-pen>
						<svg viewBox="0 0 190 64" class="pg-pen-sig">
							<path
								class="pg-pen-line"
								d="M6 44c14-22 22 6 33-4S58 8 66 14s-3 34 6 32 14-26 24-24 2 26 12 24 16-22 26-20 10 16 22 10"
								fill="none"
								stroke="currentColor"
								stroke-width="4"
								stroke-linecap="round"
								stroke-linejoin="round"
							/>
						</svg>
						<svg viewBox="0 0 24 24" class="pg-pen-nib" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
							<path d="M4 20l1.2-4.2L16.4 4.6a2 2 0 0 1 2.8 0l.2.2a2 2 0 0 1 0 2.8L8.2 18.8z" />
							<path d="M14.5 6.5l3 3" />
						</svg>
					</span>
				</div>
				<p class="pg-steps-lead">
					Four steps, no games, and a real answer at the end of them.
				</p>
				<ol class="pg-steps">
					{
						steps.map((st) => (
							<li class="pg-step">
								<span class="pg-step-n">{st.n}</span>
								<h3 class="pg-step-t">{st.t}</h3>
								<p class="pg-step-d">{st.d}</p>
							</li>
						))
					}
				</ol>
			</div>
		</section>

		<!-- ── the form ── -->
		<section class="pg-sec" id="apply">
			<div class="pg-wrap pg-formwrap">
				<div class="pg-formhead">
					<h2 class="pg-h">Your application</h2>
					<p class="pg-formlead">
						Everything here is read by a person. The last two questions
						carry the most weight, so answer them in your own words
						rather than the words you think we want.
					</p>
				</div>

				<form id="pg-form" class="pg-form" novalidate>
					<div class="pg-grid">
						<label class="pg-field">
							<span class="pg-label">Full name <em>*</em></span>
							<input type="text" name="fullName" placeholder="As it appears on your school records" required />
						</label>
						<label class="pg-field">
							<span class="pg-label">Email address <em>*</em></span>
							<input type="email" name="email" placeholder="you@example.com" required />
						</label>
						<label class="pg-field">
							<span class="pg-label">Phone number <em>*</em></span>
							<input type="tel" name="phone" placeholder="+234 800 000 0000" required />
						</label>
						<label class="pg-field">
							<span class="pg-label">Which track? <em>*</em></span>
							<span class="pg-select">
								<select name="track" required>
									<option value="">Choose a track</option>
									<option value="IT / SIWES Internship">IT / SIWES Internship</option>
									<option value="NYSC Placement">NYSC Placement</option>
								</select>
								<Icon class="pg-caret" width={18} name="mdi:chevron-down" />
							</span>
						</label>

						<label class="pg-field">
							<span class="pg-label">Institution <em>*</em></span>
							<input type="text" name="institution" placeholder="University, polytechnic or college" required />
						</label>
						<label class="pg-field">
							<span class="pg-label">Course of study <em>*</em></span>
							<input type="text" name="course" placeholder="e.g. Computer Engineering" required />
						</label>
						<label class="pg-field">
							<span class="pg-label">Level <em>*</em></span>
							<span class="pg-select">
								<select name="level" required>
									<option value="">Choose your level</option>
									{levels.map((l) => <option value={l}>{l}</option>)}
								</select>
								<Icon class="pg-caret" width={18} name="mdi:chevron-down" />
							</span>
						</label>
						<label class="pg-field">
							<span class="pg-label">Discipline you want <em>*</em></span>
							<span class="pg-select">
								<select name="discipline" required>
									<option value="">Choose a discipline</option>
									{disciplines.map((d) => <option value={d}>{d}</option>)}
								</select>
								<Icon class="pg-caret" width={18} name="mdi:chevron-down" />
							</span>
						</label>

						<label class="pg-field pg-field--full">
							<span class="pg-label">Home address <em>*</em></span>
							<input type="text" name="address" placeholder="Street, area, city, state" required />
						</label>

						<label class="pg-field">
							<span class="pg-label">When can you start? <em>*</em></span>
							<input type="text" name="startDate" placeholder="e.g. March 2026, or immediately" required />
						</label>
						<label class="pg-field">
							<span class="pg-label">Portfolio or repository <span class="pg-opt">(optional)</span></span>
							<input type="url" name="portfolio" placeholder="GitHub, Behance, a live link" />
						</label>

						<label class="pg-field pg-field--full">
							<span class="pg-label">Tell us about something you have built <em>*</em></span>
							<textarea
								name="built"
								rows="4"
								placeholder="It does not have to be impressive. It has to be finished, and it has to be yours. Tell us what it was, what broke, and what you did about it."
								required></textarea>
						</label>

						<label class="pg-field pg-field--full">
							<span class="pg-label">What do you hope to get out of this? <em>*</em></span>
							<textarea
								name="goal"
								rows="4"
								placeholder="Be specific. What do you want to be able to do at the end of this that you cannot do today?"
								required></textarea>
						</label>
					</div>

					<div class="pg-submitrow">
						<button type="submit" class="pg-submit" id="pg-submit">
							Submit application
							<Icon width={18} name="mdi:arrow-right" />
						</button>
						<p class="pg-fine">
							<Icon width={15} name="mdi:lock-outline" />
							Your application goes straight to contact@swizel.co, where a
							person reads it. We get back to every applicant, usually
							within a week.
						</p>
					</div>
				</form>
			</div>
		</section>

		<!-- ── questions ── -->
		<section class="pg-sec pg-sec--faq">
			<div class="pg-wrap">
				<h2 class="pg-h">Before you ask</h2>
				<div class="pg-faq">
					{
						bootCampFaq.map((f) => (
							<details class="pg-q">
								<summary>
									<span>{f.question}</span>
									<Icon width={18} name="mdi:plus" />
								</summary>
								<p>{f.answer}</p>
							</details>
						))
					}
				</div>
			</div>
		</section>
	</article>
</MainLayout>

<style>
	.pg {
		--pg-acc: #f59e0b;
		--pg-acc2: #fb7185;
		--pg-ink: #fdf6ea;
		--pg-muted: rgba(253, 246, 234, 0.64);
		--pg-faint: rgba(253, 246, 234, 0.42);
		--pg-line: rgba(255, 255, 255, 0.1);
		--pg-card: rgba(255, 255, 255, 0.035);
		--pg-input: rgba(255, 255, 255, 0.045);
		color: var(--pg-ink);
		background:
			radial-gradient(1000px 540px at 82% -6%, rgba(245, 158, 11, 0.13), transparent 62%),
			radial-gradient(820px 480px at 6% 40%, rgba(251, 113, 133, 0.07), transparent 60%),
			linear-gradient(180deg, #120c04 0%, #160f08 50%, #0e0903 100%);
	}
	:global(html:not(.dark)) .pg {
		--pg-acc: #b45309;
		--pg-ink: #2b1c08;
		--pg-muted: rgba(43, 28, 8, 0.7);
		--pg-faint: rgba(43, 28, 8, 0.48);
		--pg-line: rgba(43, 28, 8, 0.12);
		--pg-card: rgba(255, 255, 255, 0.7);
		--pg-input: rgba(255, 255, 255, 0.8);
		background:
			radial-gradient(1000px 540px at 82% -6%, rgba(245, 158, 11, 0.14), transparent 62%),
			linear-gradient(180deg, #fdf4e3 0%, #faecd4 55%, #fdf4e3 100%);
	}

	.pg-wrap { max-width: 74rem; margin-inline: auto; padding-inline: clamp(1rem, 3vw, 2rem); }
	.pg-sec { padding-block: clamp(2.6rem, 6vw, 4.5rem); position: relative; }
	.pg-sec + .pg-sec::before {
		content: '';
		position: absolute;
		top: 0;
		left: 50%;
		transform: translateX(-50%);
		width: min(74rem, calc(100% - 2rem));
		height: 1px;
		background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--pg-acc) 30%, transparent) 18%, color-mix(in srgb, var(--pg-acc) 30%, transparent) 82%, transparent);
	}

	/* ── hero ── */
	/* ── the quiet way back to the world you came from ── */
	.pg-from {
		border-bottom: 1px solid color-mix(in srgb, var(--from-accent, #28a6ec) 22%, transparent);
		background: color-mix(in srgb, var(--from-accent, #28a6ec) 6%, transparent);
		animation: pg-from-in 0.5s ease 0.35s both;
	}
	.pg-from[hidden] { display: none; }
	@keyframes pg-from-in {
		from { opacity: 0; }
		to { opacity: 1; }
	}
	.pg-from-in {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem 0.8rem;
		padding-block: 0.55rem;
	}
	.pg-from-dot {
		flex: none;
		width: 7px;
		height: 7px;
		border-radius: 9999px;
		background: var(--from-accent, #28a6ec);
	}
	.pg-from p {
		flex: 1 1 12rem;
		margin: 0;
		font-size: 0.78rem;
		line-height: 1.45;
		color: var(--pg-muted);
	}
	.pg-from p b { color: var(--pg-ink); font-weight: 600; }
	.pg-from a {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.78rem;
		font-weight: 500;
		color: var(--pg-muted);
		text-decoration: none;
		border-bottom: 1px solid transparent;
		transition: color 0.2s ease, border-color 0.2s ease;
	}
	.pg-from a b { font-weight: 700; color: var(--pg-ink); }
	.pg-from a:hover {
		color: var(--pg-ink);
		border-bottom-color: color-mix(in srgb, var(--from-accent, #28a6ec) 70%, transparent);
	}
	.pg-from button {
		display: grid;
		place-items: center;
		width: 22px;
		height: 22px;
		border-radius: 9999px;
		border: 0;
		background: transparent;
		color: var(--pg-faint, var(--pg-muted));
		cursor: pointer;
		opacity: 0.6;
		transition: opacity 0.2s ease;
	}
	.pg-from button:hover { opacity: 1; }
	@media (prefers-reduced-motion: reduce) {
		.pg-from { animation: none; }
	}

	.pg-hero { padding-block: clamp(3rem, 8vw, 5.5rem) clamp(2rem, 5vw, 3rem); }
	.pg-eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font-family: ui-monospace, monospace;
		font-size: 0.7rem;
		font-weight: 800;
		letter-spacing: 0.13em;
		text-transform: uppercase;
		color: var(--pg-acc);
		border: 1.5px solid color-mix(in srgb, var(--pg-acc) 45%, transparent);
		padding: 0.32rem 0.8rem;
		border-radius: 0.4rem;
		box-shadow: 2.5px 2.5px 0 color-mix(in srgb, var(--pg-acc) 30%, transparent);
	}
	.pg-title {
		font-size: clamp(2.3rem, 6vw, 4.4rem);
		font-weight: 850;
		letter-spacing: -0.03em;
		line-height: 1.03;
		margin: 1.1rem 0 1rem;
	}
	.pg-title em {
		font-style: normal;
		background: linear-gradient(95deg, var(--pg-acc), var(--pg-acc2));
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}
	.pg-lead { max-width: 44rem; font-size: 1.02rem; line-height: 1.7; color: var(--pg-muted); margin: 0 0 1.6rem; }
	.pg-herocta { display: flex; flex-wrap: wrap; gap: 0.7rem; }
	.pg-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		cursor: pointer;
		font-family: inherit;
		font-size: 0.9rem;
		font-weight: 800;
		color: #2b1c08;
		background: linear-gradient(180deg, #fcd34d, #f59e0b);
		padding: 0.85rem 1.5rem;
		border-radius: 0.8rem;
		border: 1px solid rgba(255, 255, 255, 0.35);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.5), 0 6px 0 rgba(120, 67, 5, 0.75);
		transition: transform 0.15s ease, box-shadow 0.15s ease;
	}
	.pg-btn:hover { transform: translateY(2px); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.5), 0 4px 0 rgba(120, 67, 5, 0.75); }
	.pg-btn--ghost {
		color: var(--pg-ink);
		background: color-mix(in srgb, var(--pg-acc) 10%, transparent);
		border: 1px solid color-mix(in srgb, var(--pg-acc) 45%, transparent);
		box-shadow: none;
	}
	.pg-btn--ghost:hover { transform: translateY(-1px); box-shadow: none; background: color-mix(in srgb, var(--pg-acc) 18%, transparent); }

	/* ── tracks ── */
	.pg-tracks {
		display: grid;
		gap: clamp(1rem, 2.5vw, 1.75rem);
		perspective: 1400px;
		/* the chosen card grows a little; nothing may spill sideways for it */
		overflow-x: clip;
		overflow-y: visible;
		padding: 0.6rem clamp(1rem, 3vw, 2rem);
	}
	@media (min-width: 900px) { .pg-tracks { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

	/* ── picking a track ──
	   The pair swaps places and the chosen one opens up: bigger type, the
	   full list, and an apply button you cannot miss. The other steps back
	   rather than disappearing, so the choice is still reversible. */
	.pg-track {
		transition:
			transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
			opacity 0.4s ease,
			border-color 0.4s ease,
			box-shadow 0.5s ease,
			filter 0.4s ease;
	}
	.pg-tracks[data-focus] .pg-track { transform-origin: center top; }
	.pg-tracks[data-focus='internship'] .pg-track[data-track='internship'],
	.pg-tracks[data-focus='nysc'] .pg-track[data-track='nysc'] {
		order: -1;
