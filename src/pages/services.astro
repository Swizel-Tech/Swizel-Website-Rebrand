---
import MainLayout from '../layouts/MainLayout.astro';
import ServicesBoardroom from '../components/sections/ServicesBoardroom.astro';
import { servicesSeo as seo, servicesSchema } from '../lib/pages/services';
const world = 'boardroom' as const;
---
{/* One page per world — see src/lib/worlds.ts. This file is the Boardroom
    version of /services; the others sit beside it under src/pages/v/<world>/
    and share everything but the world component. */}
<MainLayout title={seo.title} description={seo.description} image={seo.image} schema={servicesSchema} world={world}>
	<ServicesBoardroom />
</MainLayout>
