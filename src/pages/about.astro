---
import MainLayout from '../layouts/MainLayout.astro';
import AboutBoardroom from '../components/sections/AboutBoardroom.astro';
import { PAGES } from '../data/seo';
const world = 'boardroom' as const;
const seo = PAGES['/about'];
---
{/* One page per world — see src/lib/worlds.ts. This file is the Boardroom
    version of /about; the others sit beside it under src/pages/v/<world>/
    and share everything but the world component. */}
<MainLayout title={seo.title} description={seo.description} image="/images/og/og-about.jpg" world={world}>
	<AboutBoardroom />
</MainLayout>
