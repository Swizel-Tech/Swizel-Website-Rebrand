---
import MainLayout from '../../../layouts/MainLayout.astro';
import ServicesFounder from '../../../components/sections/ServicesFounder.astro';
import { servicesSchema } from '../../../lib/pages/services';
import { worldSeo } from '../../../data/worldSeo';
const world = 'founder' as const;
const seo = worldSeo(world, '/services');
---
{/* One page per world — see src/lib/worlds.ts. This file is the Founder
    version of /services; the others sit beside it under src/pages/v/<world>/
    and share everything but the world component. */}
<MainLayout title={seo.title} description={seo.description} image={seo.image} schema={servicesSchema} world={world}>
	<ServicesFounder />
</MainLayout>
