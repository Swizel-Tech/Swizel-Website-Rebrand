---
import MainLayout from '../../../../layouts/MainLayout.astro';
import PortfolioFounder from '../../../../components/sections/PortfolioFounder.astro';
import { worldSeo } from '../../../../data/worldSeo';
const world = 'founder' as const;
const seo = worldSeo(world, '/portfolio');
---
{/* One page per world — see src/lib/worlds.ts. This file is the Founder
    version of /portfolio; the others sit beside it under src/pages/v/<world>/
    and share everything but the world component. */}
<MainLayout title={seo.title} description={seo.description} image={seo.image} world={world}>
	<PortfolioFounder />
</MainLayout>
