---
import MainLayout from '../../../layouts/MainLayout.astro';
import ContactStudio from '../../../components/sections/ContactStudio.astro';
import { worldSeo } from '../../../data/worldSeo';
const world = 'studio' as const;
const seo = worldSeo(world, '/contact');
---
{/* One page per world — see src/lib/worlds.ts. This file is the Studio
    version of /contact; the others sit beside it under src/pages/v/<world>/
    and share everything but the world component. */}
<MainLayout title={seo.title} description={seo.description} image="/images/og/og-contact.jpg" world={world}>
	<ContactStudio />
</MainLayout>
