---
import MainLayout from '../../../../layouts/MainLayout.astro';
import PortfolioStudio from '../../../../components/sections/PortfolioStudio.astro';
import { PAGES } from '../../../../data/seo';
const world = 'studio' as const;
const seo = PAGES['/portfolio'];
---
{/* One page per world — see src/lib/worlds.ts. This file is the Studio
    version of /portfolio; the others sit beside it under src/pages/v/<world>/
    and share everything but the world component. */}
<MainLayout title={seo.title} description={seo.description} image={seo.image} world={world}>
	<PortfolioStudio />
</MainLayout>
