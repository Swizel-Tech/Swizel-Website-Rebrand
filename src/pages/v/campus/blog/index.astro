---
import MainLayout from '../../../../layouts/MainLayout.astro';
import BlogCampus from '../../../../components/sections/BlogCampus.astro';
import { worldSeo } from '../../../../data/worldSeo';
import { blogPosts } from '../../../../lib/pages/blog';
const world = 'campus' as const;
const seo = worldSeo(world, '/blog');
const posts = await blogPosts();
---
{/* One page per world — see src/lib/worlds.ts. This file is the Campus
    version of /blog; the others sit beside it under src/pages/v/<world>/
    and share everything but the world component. */}
<MainLayout title={seo.title} description={seo.description} image={seo.image} world={world}>
	<BlogCampus posts={posts} />
</MainLayout>
