---
import MainLayout from '../../../layouts/MainLayout.astro';
import AboutCampus from '../../../components/sections/AboutCampus.astro';
import { worldSeo } from '../../../data/worldSeo';
const world = 'campus' as const;
const seo = worldSeo(world, '/about');
---
{/* One page per world — see src/lib/worlds.ts. This file is the Campus
    version of /about; the others sit beside it under src/pages/v/<world>/
    and share everything but the world component. */}
<MainLayout title={seo.title} description={seo.description} image="/images/og/og-about.jpg" world={world}>
	<AboutCampus />
</MainLayout>
