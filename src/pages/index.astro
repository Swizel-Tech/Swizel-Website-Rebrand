---
import MainLayout from '../layouts/MainLayout.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import BoardroomBody from '../components/sections/BoardroomBody.astro';
import ViewBanner from '../components/ViewBanner.astro';
import { homeSeo } from '../lib/pages/home';
const world = 'boardroom' as const;
const seo = homeSeo(world);
---
{/* One page per world — see src/lib/worlds.ts. This file is the Boardroom
    version of the home page; the others sit beside it under src/pages/v/<world>/
    and share everything but the world component. */}
<MainLayout
	title={seo.title}
	description={seo.description}
	shareTitle={seo.shareTitle}
	shareDescription={seo.shareDescription}
	world={world}
>
	<HeroSection />
	{/* "You are here" — orient the visitor, let them switch worlds */}
	<ViewBanner />
	<BoardroomBody />
</MainLayout>
