---
import MainLayout from '../../layouts/MainLayout.astro';
import ServiceDetail from '../../components/sections/ServiceDetail.astro';
import ServiceDetailFounder from '../../components/sections/ServiceDetailFounder.astro';
import ServiceDetailBuilder from '../../components/sections/ServiceDetailBuilder.astro';
import ServiceDetailStudio from '../../components/sections/ServiceDetailStudio.astro';
import ServiceDetailCampus from '../../components/sections/ServiceDetailCampus.astro';
import CustomButton from '../../components/CustomButton.astro';
import { Icon } from 'astro-icon/components';
import { disciplines } from '../../data/disciplines';
import { DISCIPLINE_SEO, snippet } from '../../data/seo';
import { graph, service, faqPage } from '../../data/schema';

export function getStaticPaths() {
	return disciplines.map((d) => ({
		params: { slug: d.slug },
		props: { discipline: d, others: disciplines.filter((x) => x.slug !== d.slug) },
	}));
}

const { discipline, others } = Astro.props;

// "Design | Swizel Services" is a title only somebody who already knows
// Swizel would ever search for. Each discipline gets the phrase a
// stranger would actually type instead. The set lives in
// src/data/seo.ts with every other title on the site, so it is possible
// to see at a glance that no two of them are chasing the same words —
// which matters more now that /services/custom-software,
// /services/app-development and /services/erp-systems sit alongside
// these six and must stay out of their way.
const d = DISCIPLINE_SEO[discipline.slug];
const pageTitle = d ? d.title : `${discipline.title} | Swizel`;

// heroDesc is written for the page, not for a search result, so some of
// them run well past the ~160 characters Google shows. Cut on a sentence
// where there is one to cut on, and on a word otherwise, rather than
// letting the snippet end mid-word. snippet() lives in src/data/seo.ts.
//
// The other half of the problem: four of the six heroDescs are SHORT —
// 73 to 93 characters — and Google treats a description under about 70
// as too thin to bother with, replacing it with whatever it scrapes off
// the page. So the hero line and the overview are joined and then cut,
// which lands every one of the six between 140 and 158.
//
// And where even both together fall short — /services/development's two
// fields come to 93 characters between them — the reach is added, which
// is true, is the thing somebody comparing agencies wants to know, and
// gets every one of the six over the line Google draws at about 120.
const written = [discipline.heroDesc, discipline.overview].filter(Boolean).join(' ');
const pageDescription = snippet(
	written.length < 120
		? `${written.replace(/\s*$/, '')} For businesses in Nigeria, the UK, the US and across the EU.`
		: written
);

// One discipline, described to search engines the way it is described on
// the page: what it is, who provides it, where it is provided from and
// who it is for — plus the page's own questions, which is the record
// Google draws an expandable FAQ from under a result.
const pageSchema = graph(
	service({
		name: discipline.title,
		description: discipline.overview || discipline.heroDesc,
		path: `/services/${discipline.slug}`,
		serviceType: discipline.title,
		offers: discipline.included?.map((s) => ({ name: s.title, description: s.desc })),
	}),
	discipline.faqs?.length ? faqPage(discipline.faqs, `/services/${discipline.slug}`) : null
);
---

<MainLayout
	title={pageTitle}
	description={pageDescription}
	image="/images/og/og-services.jpg"
	schema={pageSchema}
>
	<!-- Boardroom world (also the default). Hidden in other views. -->
	<ServiceDetail discipline={discipline} others={others} />

	<!-- Founder world: same discipline, founder telling. -->
	<ServiceDetailFounder discipline={discipline} others={others} />

	<!-- Builder world: the discipline as a module in the repo. -->
	<ServiceDetailBuilder discipline={discipline} others={others} />

	<!-- Studio world: the discipline as a room in the Ateliers Wing. -->
	<ServiceDetailStudio discipline={discipline} others={others} />

	<!-- Campus world: the discipline as a department in the school. -->
	<ServiceDetailCampus discipline={discipline} others={others} />

	<!-- Minimal fallback for the remaining worlds. -->
	<div class="alt-view-only svc-detail-fallback">
		<section class="px-[5%] py-24 max-w-3xl mx-auto text-center space-y-6">
			<p class="uppercase tracking-widest text-sm text-swizelGreen font-semibold">
				Services
			</p>
			<h2 class="text-4xl font-bold">{discipline.title}</h2>
			<p class="text-swizelDark/60 dark:text-white/60 leading-loose">
				{discipline.overview}
			</p>
			<div class="flex flex-wrap gap-3 justify-center pt-4">
				<CustomButton
					class="rounded-full flex items-center gap-2"
					elementType="a"
					href="/contact"
				>
					Talk to a project manager
					<Icon width={18} name="mdi:arrow-right" />
				</CustomButton>
				<a href="/services" class="rounded-full px-6 py-3 border border-current">
					All services
				</a>
			</div>
		</section>
	</div>
</MainLayout>

<style is:global>
	/* Founder, Builder and Studio views have their own service detail now —
	   hide the generic fallback there. */
	html[data-view='founder'] .svc-detail-fallback,
	html[data-view='builder'] .svc-detail-fallback,
	html[data-view='studio'] .svc-detail-fallback,
	html[data-view='campus'] .svc-detail-fallback {
		display: none !important;
	}
</style>
