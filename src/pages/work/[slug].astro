---
import MainLayout from '../../layouts/MainLayout.astro';
import CaseStudy from '../../components/sections/CaseStudy.astro';
import CaseStudyFounder from '../../components/sections/CaseStudyFounder.astro';
import CaseStudyBuilder from '../../components/sections/CaseStudyBuilder.astro';
import CaseStudyStudio from '../../components/sections/CaseStudyStudio.astro';
import CaseStudyCampus from '../../components/sections/CaseStudyCampus.astro';
import { featuredProjects, projects, sectorLabels } from '../../data/projects';
import { snippet } from '../../data/seo';

export async function getStaticPaths() {
	// Six works have neither a live site nor a written case study, so their
	// tiles on the wall pointed nowhere at all. Every project gets a page
	// now: the seven with a full case study get the full telling, and the
	// rest get a short exhibition entry built only from what is on record.
	// Every project with a written case study gets a page. The six that
	// had neither a case study nor a live site have proper write-ups now,
	// so nothing is left pointing at a stand-in.
	return projects
		.filter((p) => p.caseStudy)
		.map((p) => {
			const others = featuredProjects.filter((o) => o.slug !== p.slug);
			return { params: { slug: p.slug }, props: { project: p, others } };
		});
}

const { project, others } = Astro.props;

// The long legal name ate 30 characters of a title Google cuts at 60,
// which pushed the project's own name out of the result. But
// "Saros Case Study | Swizel" is only 25 characters — half the space
// Google gives us, spent on two words that say nothing about the work.
// The first discipline goes in, because "website case study" and "app
// case study" are things people search and "case study" alone is not.
const trade = (project.tags || [])[0] || '';
const plain = `${project.name} Case Study | Swizel`;
const withTrade = `${project.name} ${trade} Case Study | Swizel`;
// Only widen if the result still fits inside the blue link. Trimming a
// finished title to a character count is how you end up with "| Swize".
const seoTitle = trade && withTrade.length <= 62 ? withTrade : plain;

// ── the snippet ───────────────────────────────────────────────────────
//
// This was `project.tagline || intro`, and a tagline is written to sit
// over a photograph — "Nigeria's gas delivery app", twenty-three
// characters. Every one of the thirteen case studies was shipping a
// description between 21 and 59 characters long, which Google treats as
// too thin to use and replaces with whatever text it scrapes off the
// page instead. So the tagline is now the opening clause and the blurb
// — which is a real sentence about what the product is — carries the
// rest, with the sector and the discipline named because those are the
// words somebody comparing agencies is searching. snippet() lives in
// src/data/seo.ts, since three different templates needed it.
const lead = (project.tagline || '').replace(/\.$/, '');
const body = project.blurb || project.caseStudy?.intro || '';
const trades = (project.tags || []).join(', ').toLowerCase();
const seoDesc = snippet(
	[lead, body, trades && `${trades} by Swizel Technologies.`]
		.filter(Boolean)
		.join(lead && body ? ' — ' : ' ')
		.replace(' — ' + trades, ' ' + trades)
);

// A case study, described as the thing it is: a piece of writing about a
// product we made for a client. `about` is what lets it be associated
// with the sector rather than floating free.
const caseSchema = {
	'@context': 'https://schema.org',
	'@type': 'CreativeWork',
	'@id': `https://www.swizel.co/work/${project.slug}/#case-study`,
	name: `${project.name} — case study`,
	headline: `${project.name}: ${lead}`,
	description: seoDesc,
	url: `https://www.swizel.co/work/${project.slug}/`,
	image: `https://www.swizel.co${project.img}`,
	...(project.year ? { dateCreated: String(project.year) } : {}),
	creator: { '@id': 'https://www.swizel.co/#organization' },
	publisher: { '@id': 'https://www.swizel.co/#organization' },
	about: {
		'@type': 'Thing',
		name: project.name,
		description: body,
	},
	keywords: [...(project.tags || []), sectorLabels[project.sector], 'Swizel'].join(', '),
	inLanguage: 'en',
};
---

<MainLayout title={seoTitle} description={seoDesc} image={project.img} schema={caseSchema}>
	<CaseStudy project={project} others={others} />

	<!-- Founder world: the whole launch story, founder momentum. -->
	<CaseStudyFounder project={project} others={others} />

	<!-- Builder world: the launch as a deploy report. -->
	<CaseStudyBuilder project={project} others={others} />

	<!-- Studio world: the launch as a single-work exhibition. -->
	<CaseStudyStudio project={project} others={others} />

	<!-- Campus world: the launch as a gold-star write-up. -->
	<CaseStudyCampus project={project} others={others} />

	<!-- Fallback for the remaining worlds: a simple summary + link out. -->
	<div class="alt-view-only case-fallback" style="max-width:48rem;margin:0 auto;padding:5rem 1.5rem;">
		<a href="/portfolio" style="font-size:.9rem;font-weight:600;">← All work</a>
		<h2 style="font-size:2.2rem;font-weight:800;margin:1.5rem 0 1rem;">{project.name}</h2>
		<p style="font-size:1.1rem;line-height:1.6;opacity:.75;">{project.caseStudy?.intro}</p>
		{project.caseStudy?.liveUrl && (
			<p style="margin-top:1.5rem;"><a href={project.caseStudy.liveUrl} target="_blank" rel="noopener" data-leaving={project.host} data-leaving-name={project.name} style="font-weight:700;">Visit live site →</a></p>
		)}
	</div>
</MainLayout>

<style is:global>
	/* Founder, Builder and Studio views have their own case study now —
	   hide the generic fallback there. */
	html[data-view='founder'] .case-fallback,
	html[data-view='builder'] .case-fallback,
	html[data-view='studio'] .case-fallback,
	html[data-view='campus'] .case-fallback {
		display: none !important;
	}
</style>
