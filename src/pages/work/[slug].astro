---
import MainLayout from '../../layouts/MainLayout.astro';
import CaseStudy from '../../components/sections/CaseStudy.astro';
import { workPaths, workSeo } from '../../lib/pages/work';
const world = 'boardroom' as const;
export const getStaticPaths = workPaths;
const { project, others } = Astro.props;
const { seoTitle, seoDesc, caseSchema } = workSeo(project);
---
{/* One page per world — see src/lib/worlds.ts. This file is the Boardroom
    version of /work/<slug>; the others sit beside it under src/pages/v/<world>/
    and share everything but the world component. */}
<MainLayout title={seoTitle} description={seoDesc} image={project.img} schema={caseSchema} world={world}>
	<CaseStudy project={project} others={others} />
</MainLayout>
