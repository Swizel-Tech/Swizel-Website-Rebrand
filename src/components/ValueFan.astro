---
// The fan.
//
// Anna Vital draws a sequence as a fan of blades opening out of one pivot:
// every step is a blade, the blades darken as they go, and the whole thing
// reads as one motion rather than four separate boxes. That is exactly what
// "in the order the work happens" is — a sweep, not a list — so this is the
// fan, built for the founder world.
//
// The blades open one after another when the section arrives, then the fan
// walks itself: one blade lifts at a time, its answer written on the pad
// beside the pivot, and it hands over the moment you point at a blade.
import { Icon } from 'astro-icon/components';

export interface FanItem {
	icon: string;
	title: string;
	desc: string;
}

interface Props {
	items: FanItem[];
	/** the line written under the pivot */
	label?: string;
	/** seconds each blade stays lifted; 0 holds still */
	every?: number;
	class?: string;
}

const { items, label = 'In the order the work happens', every = 5, class: klass = '' } = Astro.props;

const n = items.length;
// the blades open through a quarter turn, widest blade last
// Four blades, not fifteen, so the arc is a quarter rather than a half: any
// wider and they read as four separate sticks instead of one fan.
const SWEEP = 62;
const angle = (i: number) => -(SWEEP * (i / Math.max(n - 1, 1)));
---

<div
	class:list={['vfan', klass]}
	data-vfan
	data-every={String(every)}
	style={`--vf-n:${n}`}
>
	<div class="vfan__stage">
		<!-- the blades, all hinged on the same pivot -->
		<div class="vfan__blades">
			{
				items.map((it, i) => (
					<button
						class="vfan__blade"
						type="button"
						data-vfan-blade={i}
						style={`--a:${angle(i)}deg; --i:${i}; --d:${(n - i) / n}`}
						aria-pressed={i === 0 ? 'true' : 'false'}
					>
						<span class="vfan__blade-in">
							<span class="vfan__no">{String(i + 1).padStart(2, '0')}</span>
							<span class="vfan__blade-t">{it.title}</span>
							<span class="vfan__cap" aria-hidden="true" />
						</span>
					</button>
				))
			}
		</div>

		<!-- the pivot everything turns on -->
		<span class="vfan__pivot" aria-hidden="true">
			<span class="vfan__pivot-r vfan__pivot-r--1" />
			<span class="vfan__pivot-r vfan__pivot-r--2" />
			<span class="vfan__pivot-dot" />
		</span>
	</div>

	<!-- the pad: whichever blade is up, written out -->
	<div class="vfan__pad">
		<span class="vfan__pad-k">{label}</span>
		<div class="vfan__slots">
			{
				items.map((it, i) => (
					<article
						class:list={['vfan__slot', { 'is-on': i === 0 }]}
						data-vfan-slot={i}
						aria-hidden={i === 0 ? 'false' : 'true'}
					>
						<span class="vfan__slot-ic">
							<Icon width={20} name={it.icon} />
						</span>
						<h3 class="vfan__slot-t">{it.title}</h3>
						<p class="vfan__slot-d">{it.desc}</p>
					</article>
				))
			}
		</div>
		<div class="vfan__dots" role="tablist" aria-label="Core values">
			{
				items.map((it, i) => (
					<button
						class="vfan__dot"
						type="button"
						role="tab"
						data-vfan-dot={i}
						aria-selected={i === 0 ? 'true' : 'false'}
						aria-label={it.title}
					>
						<span class="vfan__dot-f" />
					</button>
				))
			}
		</div>
	</div>
</div>

<style>
	.vfan {
		--vf-acc: var(--view-accent, #8b5cf6);
		--vf-acc2: #ec4899;
		--vf-ink: #1d1430;
		--vf-muted: rgba(29, 20, 48, 0.66);
		--vf-line: rgba(29, 20, 48, 0.12);
		--vf-paper: #ffffff;
		--vf-blade-t: #ffffff;
		display: grid;
		gap: clamp(1.2rem, 2.6vw, 2.2rem);
		align-items: center;
		width: 100%;
		color: var(--vf-ink);
	}
	@media (min-width: 900px) {
		.vfan { grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); }
	}

	/* ── the fan ────────────────────────────────────────────────────── */
	.vfan__stage {
		position: relative;
		/* The pivot sits at the bottom left and the longest blade stands
		   almost upright, so the box has to be tall enough to hold the whole
		   sweep — the first cut let the top blades run straight off the top
		   of the section. Height is a ratio of width, and every measurement
		   inside is in cqi, so the rig is the same shape at any size. */
		container-type: inline-size;
		aspect-ratio: 1 / 0.92;
		width: min(100%, 34rem);
		margin-inline: auto;
	}
	.vfan__blades {
		position: absolute;
		inset: 0;
	}
	.vfan__blade {
		position: absolute;
		left: 9%;
		bottom: 11%;
		/* every blade is hinged on its own left edge, which is the pivot */
		transform-origin: 0% 50%;
		transform: rotate(var(--a)) scaleX(0.2);
		opacity: 0;
		width: 66cqi;
		height: clamp(32px, 9.6cqi, 50px);
		margin: 0;
		padding: 0;
		border: 0;
		background: none;
		font: inherit;
		cursor: pointer;
		animation: vf-open 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
		animation-delay: calc(var(--i) * 0.11s + 0.1s);
		z-index: calc(20 - var(--i));
	}
	@keyframes vf-open {
		from { opacity: 0; transform: rotate(0deg) scaleX(0.2); }
		to { opacity: 1; transform: rotate(var(--a)) scaleX(1); }
	}
	.vfan__blade-in {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		width: 100%;
		height: 100%;
		/* The blades all hinge on the same point, so near the pivot they lie
		   on top of one another and anything written there is buried by the
		   blade in front. The words start past the overlap, in the open half
		   of the blade, which is where the reference puts them too. */
		padding: 0 0.9rem 0 34%;
		border-radius: 0 9999px 9999px 0;
		/* the blades deepen as the work goes on, the way the reference does */
		background: linear-gradient(
			90deg,
			color-mix(in srgb, var(--vf-acc) calc(22% + var(--d) * 58%), #ffffff),
			color-mix(in srgb, var(--vf-acc) calc(40% + var(--d) * 55%), var(--vf-acc2))
		);
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.4) inset,
			0 14px 26px -18px rgba(28, 12, 64, 0.8);
		transition: transform 0.4s cubic-bezier(0.34, 1.3, 0.64, 1), box-shadow 0.35s ease, filter 0.35s ease;
	}
	.vfan__no {
		flex: none;
		font-family: ui-monospace, monospace;
		font-size: 0.72rem;
		font-weight: 700;
		color: rgba(255, 255, 255, 0.72);
	}
	.vfan__blade-t {
		flex: 1;
		min-width: 0;
		font-size: clamp(0.76rem, 2.5cqi, 1rem);
		font-weight: 800;
		letter-spacing: -0.01em;
		line-height: 1.1;
		text-align: left;
		color: var(--vf-blade-t);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	/* the blunt tip, so a blade reads as a blade and not a bar */
	.vfan__cap {
		flex: none;
		width: 10px;
		height: 62%;
		border-radius: 2px;
		background: rgba(255, 255, 255, 0.34);
	}
	.vfan__blade:hover .vfan__blade-in { transform: translateX(3px) scaleY(1.06); }
	.vfan__blade[aria-pressed='true'] {
		z-index: 30;
	}
	.vfan__blade[aria-pressed='true'] .vfan__blade-in {
		transform: translateX(6px) scaleY(1.14);
		filter: saturate(1.15);
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.55) inset,
			0 22px 40px -18px color-mix(in srgb, var(--vf-acc) 85%, transparent),
			0 0 0 2px rgba(255, 255, 255, 0.55);
	}

	/* ── the pivot ──────────────────────────────────────────────────── */
	.vfan__pivot {
		position: absolute;
		left: 9%;
		bottom: 11%;
		width: 0;
		height: 0;
		z-index: 40;
		pointer-events: none;
	}
	.vfan__pivot-r,
	.vfan__pivot-dot {
		position: absolute;
		top: 50%;
		left: 0;
		border-radius: 9999px;
		transform: translate(-50%, -50%);
	}
	.vfan__pivot-r {
		border: 2px solid color-mix(in srgb, var(--vf-acc) 55%, transparent);
	}
	.vfan__pivot-r--1 { width: 46px; height: 46px; animation: vf-ping 3.4s ease-out infinite; }
	.vfan__pivot-r--2 { width: 30px; height: 30px; opacity: 0.7; }
	.vfan__pivot-dot {
		width: 15px;
		height: 15px;
		background: linear-gradient(140deg, var(--vf-acc), var(--vf-acc2));
		box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.85), 0 10px 22px -10px rgba(28, 12, 64, 0.9);
	}
	@keyframes vf-ping {
		0% { transform: translate(-50%, -50%) scale(0.72); opacity: 0.85; }
		70%, 100% { transform: translate(-50%, -50%) scale(1.5); opacity: 0; }
	}

	/* ── the pad ────────────────────────────────────────────────────── */
	.vfan__pad {
		display: grid;
		gap: 0.85rem;
		padding: clamp(1.1rem, 2.2vw, 1.6rem);
		border-radius: 1.2rem;
		background: var(--vf-paper);
		border: 1px solid var(--vf-line);
		box-shadow: 0 1px 0 #fff inset, 0 26px 50px -34px rgba(48, 26, 100, 0.42);
	}
	.vfan__pad-k {
		font-size: 0.7rem;
		font-weight: 800;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--vf-muted);
	}
	.vfan__slots { display: grid; min-height: 9.5rem; }
	.vfan__slot {
		grid-area: 1 / 1;
		display: grid;
		gap: 0.5rem;
		align-content: start;
		opacity: 0;
		transform: translateY(10px);
		transition: opacity 0.35s ease, transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
		pointer-events: none;
	}
	.vfan__slot.is-on { opacity: 1; transform: none; pointer-events: auto; }
	.vfan__slot-ic {
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		border-radius: 0.8rem;
		color: #fff;
		background: linear-gradient(140deg, var(--vf-acc), var(--vf-acc2));
		box-shadow: 0 14px 26px -14px color-mix(in srgb, var(--vf-acc) 85%, transparent);
	}
	.vfan__slot-t {
		margin: 0;
		font-size: clamp(1.1rem, 2.1vw, 1.45rem);
		font-weight: 800;
		letter-spacing: -0.015em;
		line-height: 1.2;
	}
	.vfan__slot-d {
		margin: 0;
		font-size: 0.94rem;
		line-height: 1.6;
		color: var(--vf-muted);
	}

	.vfan__dots { display: flex; gap: 0.4rem; }
	.vfan__dot {
		flex: 1;
		height: 4px;
		padding: 0;
		border: 0;
		border-radius: 9999px;
		background: var(--vf-line);
		cursor: pointer;
		overflow: hidden;
	}
	.vfan__dot-f {
		display: block;
		width: 0;
		height: 100%;
		border-radius: 9999px;
		background: linear-gradient(90deg, var(--vf-acc), var(--vf-acc2));
	}
	.vfan__dot[aria-selected='true'] .vfan__dot-f {
		width: 100%;
		transition: width var(--vf-hold, 5s) linear;
	}

	/* ── narrow ─────────────────────────────────────────────────────── */
	@media (max-width: 899px) {
		.vfan__stage { width: min(100%, 30rem); }
	}
	@media (max-width: 560px) {
		.vfan__stage { aspect-ratio: 1 / 0.98; }
		.vfan__blade { width: 72cqi; height: clamp(28px, 10.4cqi, 44px); }
		.vfan__blade-in { padding: 0 0.55rem 0 27%; gap: 0.3rem; }
		.vfan__blade-t { font-size: clamp(0.72rem, 3.4cqi, 0.88rem); }
		.vfan__no { display: none; }
		.vfan__cap { width: 7px; }
		.vfan__slots { min-height: 11rem; }
	}

	@media (prefers-reduced-motion: reduce) {
		.vfan__blade { animation: none; opacity: 1; transform: rotate(var(--a)); }
		.vfan__pivot-r--1 { animation: none; }
		.vfan__dot[aria-selected='true'] .vfan__dot-f { transition: none; }
	}
	:global(html.perf-lite) .vfan__pivot-r--1 { animation: none; }

	/* ══ lights out ═══════════════════════════════════════════════════ */
	:global(html.dark) .vfan {
		--vf-ink: #f1edfb;
		--vf-muted: rgba(241, 237, 251, 0.68);
		--vf-line: rgba(255, 255, 255, 0.1);
		--vf-paper: rgba(255, 255, 255, 0.04);
	}
	:global(html.dark) .vfan__pad { box-shadow: none; }
	:global(html.dark) .vfan__pivot-dot { box-shadow: 0 0 0 4px rgba(12, 8, 26, 0.9); }
</style>
