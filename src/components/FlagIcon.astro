---
// Small hand drawn flags (3:2). Deliberately simplified so they read cleanly
// at ~22px and carry no external dependency — no sprite sheet, no CDN.
interface Props {
	code: 'ng' | 'uk' | 'us' | 'ie' | 'ca' | 'nz';
	class?: string;
}
const { code, class: cls = '' } = Astro.props;
---

<span class:list={['flag', cls]} role="img" aria-hidden="true">
	{
		code === 'ng' && (
			<svg viewBox="0 0 60 40">
				<rect width="60" height="40" fill="#fff" />
				<rect width="20" height="40" fill="#008751" />
				<rect x="40" width="20" height="40" fill="#008751" />
			</svg>
		)
	}
	{
		code === 'ie' && (
			<svg viewBox="0 0 60 40">
				<rect width="60" height="40" fill="#fff" />
				<rect width="20" height="40" fill="#169b62" />
				<rect x="40" width="20" height="40" fill="#ff883e" />
			</svg>
		)
	}
	{
		code === 'uk' && (
			<svg viewBox="0 0 60 40">
				<rect width="60" height="40" fill="#012169" />
				<path d="M0 0 60 40M60 0 0 40" stroke="#fff" stroke-width="9" />
				<path d="M0 0 60 40M60 0 0 40" stroke="#c8102e" stroke-width="4" />
				<path d="M30 0V40M0 20H60" stroke="#fff" stroke-width="13" />
				<path d="M30 0V40M0 20H60" stroke="#c8102e" stroke-width="7" />
			</svg>
		)
	}
	{
		code === 'us' && (
			<svg viewBox="0 0 60 40">
				<rect width="60" height="40" fill="#fff" />
				{[0, 2, 4, 6, 8, 10, 12].map((i) => (
					<rect y={i * (40 / 13)} width="60" height={40 / 13} fill="#b22234" />
				))}
				<rect width="26" height={40 / 13 * 7} fill="#3c3b6e" />
				{[0, 1, 2].map((r) =>
					[0, 1, 2, 3].map((c) => (
						<circle cx={4.5 + c * 6} cy={4 + r * 6} r="1.5" fill="#fff" />
					))
				)}
			</svg>
		)
	}
	{
		code === 'ca' && (
			<svg viewBox="0 0 60 40">
				<rect width="60" height="40" fill="#fff" />
				<rect width="15" height="40" fill="#d52b1e" />
				<rect x="45" width="15" height="40" fill="#d52b1e" />
				<path
					fill="#d52b1e"
					d="M30 8.5l3 6.2 5.9-1.4-1.7 4.5 6.1 3.2-4.8 2 1.4 4.3-6-1.2-.6 5.6h-2.6l-.6-5.6-6 1.2 1.4-4.3-4.8-2 6.1-3.2-1.7-4.5 5.9 1.4z"
				/>
			</svg>
		)
	}
	{
		code === 'nz' && (
			<svg viewBox="0 0 60 40">
				<rect width="60" height="40" fill="#00247d" />
				<g transform="scale(0.5)">
					<path d="M0 0 60 40M60 0 0 40" stroke="#fff" stroke-width="9" />
					<path d="M0 0 60 40M60 0 0 40" stroke="#c8102e" stroke-width="4" />
					<path d="M30 0V40M0 20H60" stroke="#fff" stroke-width="13" />
					<path d="M30 0V40M0 20H60" stroke="#c8102e" stroke-width="7" />
				</g>
				<g fill="#c8102e" stroke="#fff" stroke-width="0.8">
					<circle cx="47" cy="10" r="2" />
					<circle cx="52" cy="20" r="2.4" />
					<circle cx="43" cy="24" r="2" />
					<circle cx="48" cy="32" r="2.2" />
				</g>
			</svg>
		)
	}
</span>

<style>
	.flag {
		display: inline-block;
		width: 1.45em;
		aspect-ratio: 3 / 2;
		border-radius: 2px;
		overflow: hidden;
		box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.28), 0 2px 6px rgba(0, 0, 0, 0.45);
		flex: none;
	}
	.flag svg { display: block; width: 100%; height: 100%; }
</style>
