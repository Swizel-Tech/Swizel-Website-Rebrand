---
// The launch console — the six-week build, as an instrument you can drive.
//
// It came out of the hero (the film lives there now) and grew up on the way
// down: the ring still runs a whole launch end to end, but every stage is
// now a real control. Press one and the console jumps to that week, the
// deliverables panel swaps to what you actually receive, and the ring
// settles on the share of the build that is behind you.
import { Icon } from 'astro-icon/components';

const stages = [
	{
		n: '01',
		name: 'Discover & define',
		when: 'Week 1',
		pct: 22,
		blurb: 'We lock the goal, the user and the scope, in writing, before a line of code.',
		gives: ['Product brief & scope', 'User + competitor map', 'Fixed six-week plan'],
	},
	{
		n: '02',
		name: 'Design & prototype',
		when: 'Week 2',
		pct: 48,
		blurb: 'A prototype you can click, feel and pitch to an investor before we build it.',
		gives: ['Clickable prototype', 'Design system', 'Brand pass'],
	},
	{
		n: '03',
		name: 'Build & test',
		when: 'Weeks 3 to 5',
		pct: 82,
		blurb: 'Senior engineers, sprints you can watch, and a build reviewed every Friday.',
		gives: ['Working product', 'Weekly demo build', 'QA + test suite'],
	},
	{
		n: '04',
		name: 'Launch & scale',
		when: 'Week 6 or sooner',
		pct: 100,
		blurb: 'Live, measured, and in your users’ hands. Then we stay to scale what works.',
		gives: ['Production launch', 'Analytics from day one', '30 days of support'],
	},
];

---

<div class="founder--widget lcon" id="founder-widget" data-tour="pipeline">
	<div class="fw--head">
		<div class="lcon__id">
			<span class="fw--title">Idea → MVP</span>
			<span class="fw--eta">
				<Icon class="lcon__eta-ic" width={13} name="mdi:timer-outline" />
				six weeks at the outside, often less
			</span>
		</div>
		<button class="fw--launch" type="button" data-fw-launch>
			<Icon width={15} name="mdi:rocket-launch-outline" />
			<span class="fw--launch-txt">Run a launch</span>
		</button>
	</div>

	<div class="fw--body">
		<div class="fw--ring" data-tour="ring">
			<svg class="fw--ringsvg" viewBox="0 0 120 120" aria-hidden="true">
				<circle class="fw--ringbg" cx="60" cy="60" r="52"></circle>
				<circle class="fw--ringfg" id="fw-ring" cx="60" cy="60" r="52"></circle>
			</svg>
			<span class="fw--pct" id="fw-pct">0%</span>
			<span class="fw--ringlabel">to launch</span>
		</div>

		<ol class="fw--stages" data-lcon-stages>
			{
				stages.map((s, i) => (
					<li>
						<button
							class="fw--stage"
							type="button"
							data-pct={s.pct}
							data-stage={i}
							aria-pressed={i === 0 ? 'true' : 'false'}
						>
							<span class="fw--stagenum">{s.n}</span>
							<span class="fw--stagebody">
								<span class="fw--stagename">{s.name}</span>
								<span class="fw--stageweek">{s.when}</span>
							</span>
							<span class="fw--check">
								<Icon width={14} name="mdi:check" />
							</span>
						</button>
					</li>
				))
			}
		</ol>
	</div>

	<!-- what actually lands on your side of the table, per stage -->
	<div class="lcon__panel" data-lcon-panel>
		{
			stages.map((s, i) => (
				<div class="lcon__sheet" data-sheet={i} hidden={i !== 0}>
					<p class="lcon__blurb">{s.blurb}</p>
					<ul class="lcon__gives">
						{s.gives.map((g) => (
							<li>
								<Icon width={13} name="mdi:check-circle-outline" />
								{g}
							</li>
						))}
					</ul>
				</div>
			))
		}
	</div>

	<p class="lcon__foot">
		<Icon width={14} name="mdi:clock-fast" />
		A booking site can be live in two. A marketplace takes longer. We tell
		you which one you are on day one.
	</p>
</div>

<style>
	/* ===== Launch console ===== */
	.founder--widget {
		position: relative;
		border-radius: 1.25rem;
		padding: 1.25rem;
		background: rgba(22, 18, 41, 0.66);
		border: 1px solid rgba(167, 139, 250, 0.22);
		-webkit-backdrop-filter: blur(14px);
		backdrop-filter: blur(14px);
		box-shadow: 0 40px 90px -40px rgba(0, 0, 0, 0.85);
		overflow: hidden;
	}
	/* a slow sweep of light across the glass, so the panel reads as live */
	.founder--widget::before {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: linear-gradient(115deg, transparent 38%, rgba(196, 181, 253, 0.09) 50%, transparent 62%);
		transform: translateX(-60%);
		animation: lcon-sweep 9s ease-in-out infinite;
	}
	@keyframes lcon-sweep {
		0%, 62% { transform: translateX(-60%); }
		100% { transform: translateX(60%); }
	}

	.fw--head { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.25rem; }
	.lcon__id { min-width: 0; }
	.fw--title { font-size: 1.15rem; font-weight: 800; color: #fff; }
	.fw--eta { display: flex; align-items: center; gap: 0.4rem; font-size: 0.78rem; color: rgba(237, 233, 251, 0.55); }
	.lcon :global(.lcon__eta-ic) {
		flex: none;
		color: var(--view-accent, #8b5cf6);
		animation: lcon-tick 2.6s ease-in-out infinite;
	}
	@keyframes lcon-tick {
		0%, 100% { opacity: 0.65; transform: rotate(0deg); }
		50% { opacity: 1; transform: rotate(14deg); }
	}

	.fw--launch {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font-size: 0.8rem;
		font-weight: 700;
		color: #1a1030;
		background: linear-gradient(95deg, #c4b5fd, #8b5cf6);
		padding: 0.6rem 1.05rem;
		border-radius: 9999px;
		border: 0;
		cursor: pointer;
		transition: transform 0.2s ease, filter 0.2s ease;
		white-space: nowrap;
	}
	.fw--launch:hover { transform: translateY(-1px); filter: brightness(1.05); }

	.fw--body { position: relative; display: flex; gap: 1rem; align-items: center; }
	.fw--ring { position: relative; width: 174px; height: 174px; flex-shrink: 0; display: grid; place-items: center; }
	.fw--ringsvg { width: 174px; height: 174px; transform: rotate(-90deg); }
	.fw--ringbg { fill: none; stroke: rgba(255, 255, 255, 0.08); stroke-width: 9; }
	.fw--ringfg {
		fill: none;
		stroke: #a78bfa;
		stroke-width: 9;
		stroke-linecap: round;
		stroke-dasharray: 326.7;
		stroke-dashoffset: 326.7;
		filter: drop-shadow(0 0 6px rgba(167, 139, 250, 0.55));
	}
	.fw--pct { position: absolute; font-family: 'Bebas Neue', sans-serif; font-size: 2.6rem; color: #fff; line-height: 1; transform: translateY(-0.85rem); }
	.fw--ringlabel { position: absolute; margin-top: 2.2rem; font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.1em; color: rgba(237, 233, 251, 0.5); }

	.fw--stages { display: grid; gap: 0.55rem; flex: 1; min-width: 0; list-style: none; margin: 0; padding: 0; }
	.fw--stage {
		display: flex;
		width: 100%;
		text-align: left;
		align-items: center;
		gap: 0.7rem;
		padding: 0.5rem 0.95rem;
		border-radius: 0.7rem;
		border: 1px solid rgba(255, 255, 255, 0.07);
		background: rgba(255, 255, 255, 0.02);
		cursor: pointer;
		font-family: inherit;
		transition: border-color 0.35s ease, background 0.35s ease, transform 0.2s ease;
	}
	.fw--stage:hover { transform: translateX(2px); border-color: rgba(167, 139, 250, 0.4); }
	.fw--stage.is-done { border-color: rgba(167, 139, 250, 0.5); background: rgba(139, 92, 246, 0.12); }
	.fw--stage.is-open {
		border-color: rgba(236, 72, 153, 0.55);
		box-shadow: 0 0 0 1px rgba(236, 72, 153, 0.28) inset;
	}
	.fw--stagenum { font-family: ui-monospace, monospace; font-size: 0.72rem; color: rgba(237, 233, 251, 0.4); }
	.fw--stage.is-done .fw--stagenum { color: #c4b5fd; }
	.fw--stagebody { flex: 1; min-width: 0; display: flex; flex-direction: column; }
	.fw--stagename { font-size: 0.84rem; font-weight: 600; color: #eee9fb; }
	.fw--stageweek { font-size: 0.7rem; color: rgba(237, 233, 251, 0.45); }
	.fw--check {
		display: grid;
		place-items: center;
		width: 22px;
		height: 22px;
		flex: none;
		border-radius: 9999px;
		background: rgba(255, 255, 255, 0.06);
		color: transparent;
		transform: scale(0.6);
		transition: transform 0.3s ease, background 0.3s ease, color 0.3s ease;
	}
	.fw--stage.is-done .fw--check { background: #8b5cf6; color: #fff; transform: scale(1); }

	/* the deliverables sheet */
	.lcon__panel {
		position: relative;
		margin-top: 1rem;
		padding: 0.85rem 1rem;
		border-radius: 0.9rem;
		border: 1px dashed rgba(167, 139, 250, 0.28);
		background: rgba(139, 92, 246, 0.06);
	}
	.lcon__blurb { margin: 0 0 0.6rem; font-size: 0.84rem; line-height: 1.5; color: rgba(237, 233, 251, 0.78); }
	.lcon__gives {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 0.5rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.lcon__gives li {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0.24rem 0.6rem;
		border-radius: 9999px;
		font-size: 0.7rem;
		font-weight: 650;
		color: #ede9fb;
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid rgba(255, 255, 255, 0.09);
	}
	.lcon__gives :global(svg) { color: #c4b5fd; flex: none; }
	.lcon__sheet { animation: lcon-fade 0.35s ease both; }
	@keyframes lcon-fade { from { opacity: 0; transform: translateY(5px); } }

	.lcon__foot {
		position: relative;
		display: flex;
		align-items: flex-start;
		gap: 0.45rem;
		margin: 1rem 0 0;
		padding-top: 0.9rem;
		border-top: 1px dashed rgba(255, 255, 255, 0.1);
		font-size: 0.78rem;
		line-height: 1.5;
		color: rgba(237, 233, 251, 0.6);
	}
	.lcon__foot :global(svg) { color: #c4b5fd; flex: none; margin-top: 0.15rem; }
	:global(html:not(.dark)) .lcon__foot { color: rgba(23, 19, 49, 0.62); border-top-color: rgba(23, 19, 49, 0.12); }
	:global(html:not(.dark)) .lcon__foot :global(svg) { color: #6d28d9; }
	@keyframes fwcard { to { opacity: 1; transform: translateY(0); } }

	@media (max-width: 768px) {
		.fw--body { flex-direction: column; }
		.fw--ring { width: 128px; height: 128px; }
		.fw--ringsvg { width: 128px; height: 128px; }
		.fw--stages { width: 100%; }
		}
	@media (prefers-reduced-motion: reduce) {
		.founder--widget::before,
		.lcon :global(.lcon__eta-ic) { animation: none !important; }
	}

	/* ══ daylight ══ */
	:global(html:not(.dark)) .founder--widget {
		background: rgba(255, 255, 255, 0.86);
		border-color: rgba(109, 40, 217, 0.18);
		box-shadow: 0 40px 90px -44px rgba(23, 19, 49, 0.35);
	}
	:global(html:not(.dark)) .fw--title { color: #171331; }
	:global(html:not(.dark)) .fw--eta { color: rgba(23, 19, 49, 0.55); }
	:global(html:not(.dark)) .fw--ringbg { stroke: rgba(23, 19, 49, 0.08); }
	:global(html:not(.dark)) .fw--pct { color: #171331; }
	:global(html:not(.dark)) .fw--ringlabel { color: rgba(23, 19, 49, 0.5); }
	:global(html:not(.dark)) .fw--stage {
		border-color: rgba(23, 19, 49, 0.1);
		background: rgba(23, 19, 49, 0.03);
	}
	:global(html:not(.dark)) .fw--stage.is-done {
		border-color: rgba(139, 92, 246, 0.5);
		background: rgba(139, 92, 246, 0.1);
	}
	:global(html:not(.dark)) .fw--stagenum { color: rgba(23, 19, 49, 0.4); }
	:global(html:not(.dark)) .fw--stage.is-done .fw--stagenum { color: #6d28d9; }
	:global(html:not(.dark)) .fw--stagename { color: #171331; }
	:global(html:not(.dark)) .fw--stageweek { color: rgba(23, 19, 49, 0.5); }
	:global(html:not(.dark)) .fw--check { background: rgba(23, 19, 49, 0.08); }
	:global(html:not(.dark)) .lcon__blurb { color: rgba(23, 19, 49, 0.72); }
	:global(html:not(.dark)) .lcon__gives li {
		color: #2b1f52;
		background: rgba(109, 40, 217, 0.08);
		border-color: rgba(109, 40, 217, 0.16);
	}
	:global(html:not(.dark)) .lcon__gives :global(svg) { color: #6d28d9; }
</style>
