---
// The tree.
//
// One idea at the top, a hand-drawn line running down and out to each
// branch, and the answer waiting at the end of it — the shape of the
// founder infographics Tosky keeps pinned. The trunk lines draw themselves
// in when the section arrives, and one branch is lit at a time so the
// thing is never a still picture.
//
// Two modes:
//   open  — every branch carries its own copy (good for four to six)
//   focus — branch heads only, and the lit branch's detail in a tray
//           underneath (good for seven or more)
import { Icon } from 'astro-icon/components';

export interface BranchItem {
	icon: string;
	label: string;
	desc?: string;
	/** attribution line, the way the reference credits each person */
	who?: string;
	chips?: string[];
	color?: string;
}

interface Props {
	root: string;
	rootIcon?: string;
	rootNote?: string;
	items: BranchItem[];
	mode?: 'open' | 'focus';
	/** seconds each branch stays lit; 0 holds still */
	every?: number;
	class?: string;
}

const {
	root,
	rootIcon = 'mdi:lightbulb-on-outline',
	rootNote,
	items,
	mode = 'open',
	every = 4,
	class: klass = '',
} = Astro.props;

const n = items.length;
// where each branch head sits across the width, as a percentage
const at = (i: number) => ((i + 0.5) / n) * 100;
---

<div class:list={['tree', `tree--${mode}`, klass]} data-tree data-every={String(every)}>
	<!-- ── the trunk ── -->
	<div class="tree__root">
		<span class="tree__root-ic">
			<Icon width={22} name={rootIcon} />
		</span>
		<span class="tree__root-t">{root}</span>
		{rootNote && <span class="tree__root-n">{rootNote}</span>}
	</div>

	<!-- ── the lines out to each branch ── -->
	<svg
		class="tree__wires"
		viewBox="0 0 1000 120"
		preserveAspectRatio="none"
		aria-hidden="true"
	>
		{
			items.map((it, i) => (
				<path
					class="tree__wire"
					data-tree-wire={i}
					style={`--c:${it.color || 'var(--tr-acc)'}; --d:${i * 0.09}s`}
					d={`M500 0 C500 62 ${at(i) * 10} 62 ${at(i) * 10} 120`}
				/>
			))
		}
	</svg>

	<!-- ── the branches ── -->
	<div class="tree__row">
		{
			items.map((it, i) => (
				<button
					class="tree__branch"
					type="button"
					data-tree-branch={i}
					style={`--c:${it.color || 'var(--tr-acc)'}; --i:${i}`}
					aria-pressed={i === 0 ? 'true' : 'false'}
				>
					<span class="tree__label">{it.label}</span>
					<span class="tree__disc">
						<Icon width={24} name={it.icon} />
					</span>
					<span class="tree__stem" aria-hidden="true" />
					{mode === 'open' && (
						<span class="tree__body">
							{it.who && <em class="tree__who">{it.who}</em>}
							{it.desc && <span class="tree__desc">{it.desc}</span>}
						</span>
					)}
				</button>
			))
		}
	</div>

	<!-- ── the tray, for the crowded version ── -->
	{
		mode === 'focus' && (
			<div class="tree__tray">
				{items.map((it, i) => (
					<div
						class="tree__panel"
						data-tree-panel={i}
						style={`--c:${it.color || 'var(--tr-acc)'}`}
						aria-hidden={i === 0 ? 'false' : 'true'}
					>
						<span class="tree__panel-h">
							<Icon width={16} name={it.icon} />
							{it.label}
						</span>
						{it.desc && <p class="tree__panel-d">{it.desc}</p>}
						{it.chips && (
							<ul class="tree__chips">
								{it.chips.map((c) => (
									<li>{c}</li>
								))}
							</ul>
						)}
					</div>
				))}
			</div>
		)
	}
</div>

<style>
	.tree {
		--tr-acc: var(--view-accent, #8b5cf6);
		--tr-ink: #1b1332;
		--tr-muted: rgba(27, 19, 50, 0.72);
		--tr-faint: rgba(27, 19, 50, 0.5);
		--tr-line: rgba(27, 19, 50, 0.16);
		--tr-paper: rgba(255, 255, 255, 0.86);
		position: relative;
		display: grid;
		justify-items: center;
		width: 100%;
		color: var(--tr-ink);
	}

	/* ── the trunk ──────────────────────────────────────────────────── */
	.tree__root {
		display: grid;
		justify-items: center;
		gap: 0.3rem;
		text-align: center;
	}
	.tree__root-ic {
		display: grid;
		place-items: center;
		width: 52px;
		height: 52px;
		border-radius: 9999px;
		color: #fff;
		background: linear-gradient(150deg, var(--tr-acc), #ec4899);
		box-shadow: 0 16px 32px -16px color-mix(in srgb, var(--tr-acc) 90%, transparent);
	}
	.tree__root-t {
		font-size: clamp(0.95rem, 1.6vw, 1.15rem);
		font-weight: 800;
		letter-spacing: -0.01em;
	}
	.tree__root-n {
		font-family: 'Bradley Hand', 'Segoe Print', 'Comic Sans MS', cursive;
		font-size: 0.88rem;
		color: var(--tr-faint);
		transform: rotate(-1.2deg);
	}

	/* ── the wires ──────────────────────────────────────────────────── */
	.tree__wires {
		width: 100%;
		height: clamp(56px, 8vw, 104px);
		overflow: visible;
	}
	.tree__wire {
		fill: none;
		stroke: var(--c);
		stroke-width: 2.4;
		stroke-linecap: round;
		opacity: 0.34;
		vector-effect: non-scaling-stroke;
		stroke-dasharray: 320;
		stroke-dashoffset: 320;
		animation: tr-draw 1.1s cubic-bezier(0.5, 0, 0.2, 1) var(--d) forwards;
		transition: opacity 0.35s ease, stroke-width 0.35s ease;
	}
	@keyframes tr-draw { to { stroke-dashoffset: 0; } }
	.tree__wire.is-lit { opacity: 1; stroke-width: 3.4; }

	/* ── the branches ───────────────────────────────────────────────── */
	.tree__row {
		display: flex;
		align-items: flex-start;
		justify-content: center;
		gap: clamp(0.4rem, 1.4vw, 1.2rem);
		width: 100%;
	}
	.tree__branch {
		flex: 1 1 0;
		min-width: 0;
		display: grid;
		justify-items: center;
		gap: 0.4rem;
		padding: 0;
		border: 0;
		background: none;
		color: inherit;
		font: inherit;
		text-align: center;
		cursor: pointer;
	}
	.tree__label {
		font-family: 'Bradley Hand', 'Segoe Print', 'Comic Sans MS', cursive;
		font-size: clamp(0.86rem, 1.5vw, 1.08rem);
		font-weight: 700;
		line-height: 1.1;
		color: var(--c);
		transition: transform 0.35s ease;
	}
	.tree__disc {
		display: grid;
		place-items: center;
		width: clamp(44px, 5.4vw, 62px);
		height: clamp(44px, 5.4vw, 62px);
		border-radius: 9999px;
		color: var(--c);
		background: color-mix(in srgb, var(--c) 12%, var(--tr-paper));
		border: 2px solid color-mix(in srgb, var(--c) 42%, transparent);
		transition: transform 0.42s cubic-bezier(0.34, 1.4, 0.64, 1),
			box-shadow 0.35s ease, background 0.35s ease, color 0.35s ease;
	}
	.tree__branch:hover .tree__disc { transform: translateY(-3px) scale(1.06); }
	.tree__branch[aria-pressed='true'] .tree__disc {
		color: #fff;
		background: linear-gradient(150deg, var(--c), color-mix(in srgb, var(--c) 55%, #ec4899));
		border-color: transparent;
		transform: translateY(-4px) scale(1.12);
		box-shadow: 0 18px 34px -16px color-mix(in srgb, var(--c) 90%, transparent);
	}
	.tree__branch[aria-pressed='true'] .tree__label { transform: translateY(-2px); }

	/* the short stem under the disc, before the words */
	.tree__stem {
		width: 2px;
		height: clamp(14px, 2vw, 26px);
		border-radius: 2px;
		background: linear-gradient(180deg, color-mix(in srgb, var(--c) 60%, transparent), transparent);
	}
	.tree--focus .tree__stem { display: none; }

	.tree__body {
		display: grid;
		gap: 0.2rem;
		max-width: 15rem;
	}
	.tree__who {
		font-style: normal;
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.04em;
		color: var(--c);
	}
	.tree__desc {
		font-size: clamp(0.74rem, 1.15vw, 0.88rem);
		line-height: 1.5;
		color: var(--tr-muted);
	}

	/* ── the tray ───────────────────────────────────────────────────── */
	.tree__tray {
		display: grid;
		width: min(58rem, 100%);
		margin-top: 1.1rem;
		padding: clamp(1rem, 2vw, 1.4rem);
		border-radius: 1.1rem;
		background: var(--tr-paper);
		border: 1px solid var(--tr-line);
		box-shadow: 0 24px 50px -34px rgba(40, 24, 70, 0.5);
	}
	.tree__panel {
		grid-area: 1 / 1;
		display: grid;
		justify-items: center;
		gap: 0.5rem;
		opacity: 0;
		transform: translateY(8px);
		transition: opacity 0.35s ease, transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
		pointer-events: none;
	}
	.tree__panel.is-on { opacity: 1; transform: none; pointer-events: auto; }
	.tree__panel-h {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.95rem;
		font-weight: 800;
		color: var(--c);
	}
	.tree__panel-d {
		margin: 0;
		font-size: 0.86rem;
		color: var(--tr-muted);
		text-align: center;
	}
	.tree__chips {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.35rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.tree__chips li {
		padding: 0.28rem 0.7rem;
		border-radius: 9999px;
		font-size: 0.76rem;
		font-weight: 700;
		color: var(--tr-ink);
		background: color-mix(in srgb, var(--c) 10%, transparent);
		border: 1px solid color-mix(in srgb, var(--c) 24%, transparent);
	}

	/* ── narrow: the fan folds into a stack, wires go ────────────────── */
	@media (max-width: 760px) {
		.tree__wires { display: none; }
		.tree__row {
			flex-wrap: wrap;
			gap: 1.1rem 0.6rem;
			margin-top: 1.1rem;
			/* a dotted spine instead of the fan of wires */
			padding-top: 1.2rem;
			background: radial-gradient(circle, color-mix(in srgb, var(--tr-acc) 45%, transparent) 1px, transparent 1.2px)
				top center / 12px 12px repeat-y;
			background-size: 2px 10px;
		}
		.tree__branch { flex: 1 1 7.5rem; }
		.tree--focus .tree__branch { flex: 0 1 5.5rem; }
		.tree__body { max-width: 11rem; }
		.tree__desc { font-size: 0.76rem; }
	}
	@media (max-width: 460px) {
		.tree--open .tree__branch { flex: 1 1 100%; }
		.tree--open .tree__body { max-width: 20rem; }
	}

	@media (prefers-reduced-motion: reduce) {
		.tree__wire { animation: none; stroke-dashoffset: 0; }
		.tree__disc, .tree__panel { transition: opacity 0.2s ease; }
	}

	/* ══ lights out ═══════════════════════════════════════════════════ */
	:global(html.dark) .tree {
		--tr-ink: #f1edfb;
		--tr-muted: rgba(241, 237, 251, 0.7);
		--tr-faint: rgba(241, 237, 251, 0.5);
		--tr-line: rgba(255, 255, 255, 0.12);
		--tr-paper: rgba(255, 255, 255, 0.05);
	}
	:global(html.dark) .tree__chips li { color: #efe8ff; }
</style>
