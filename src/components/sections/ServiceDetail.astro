---
// A single service/discipline detail page — Boardroom world, themed in the
// discipline's own colour. Reuses initBoardroomBody reveals + the boardroom
// cursor (.bd-services). Self-contained .bd-* base styles.
import { Icon } from 'astro-icon/components';
import type { Discipline } from '../../data/disciplines';
import ServiceVisual from './ServiceVisual.astro';
import FilmPlayer from '../FilmPlayer.astro';
import CardShuffle from '../CardShuffle.astro';

interface Props {
	discipline: Discipline;
	others: Discipline[];
}
const { discipline: d, others } = Astro.props;
// The Design page leads with the work (show, don't tell); others keep the
// standard "selected work" lower down.
const isDesign = d.slug === 'design';

// Which side the hero's visual sits on, so the six pages are not one page
// six times. The "included" block used to take three shapes as well; that
// varied the arrangement without varying what it said, and it is a hand of
// cards on every page now.
type Lay = { heroRev?: boolean };
const layouts: Record<string, Lay> = {
	design: {},
	development: { heroRev: true },
	marketing: {},
	strategy: { heroRev: true },
	maintenance: {},
	'ai-automation': { heroRev: true },
};
const L: Lay = layouts[d.slug] ?? {};

// Real media for every discipline. Each page shipped a dashed box reading
// "video placeholder" or "image placeholder"; six pages, six placeholders.
// Films are ours, photographs are of this studio or of work it shipped.
type Slot =
	| { kind: 'film'; videoId?: string; src?: string; poster?: string; fallback?: string; label: string; tag: string }
	| { kind: 'shot'; img: string; pos: string; alt: string; label: string };

const slots: Record<string, Slot> = {
	design: {
		kind: 'film', videoId: 'EHi0Z2yqAr8', fallback: '/images/film/room.jpg',
		label: 'Inside the studio', tag: 'the studio',
	},
	development: {
		kind: 'film', src: '/videos/how-we-build.mp4', poster: '/images/how-we-build-poster.jpg',
		label: 'See how we build', tag: 'the build reel',
	},
	marketing: {
		kind: 'shot', img: '/images/marketing/the-floor.jpg', pos: '50% 50%',
		alt: 'The Swizel marketing team at work', label: 'The floor, mid-campaign',
	},
	strategy: {
		kind: 'shot', img: '/images/builder/the-table.jpg', pos: '50% 40%',
		alt: 'A Swizel planning session', label: 'The table, before the pixels',
	},
	maintenance: {
		kind: 'shot', img: '/images/builder/over-the-shoulder.jpg', pos: '46% 38%',
		alt: "One engineer reading another's screen", label: 'Watched, year after year',
	},
	'ai-automation': {
		kind: 'film', videoId: 'nFbBpQvT5fQ', fallback: '/images/campus/the-lab.jpg',
		label: 'Live products, running now', tag: 'the proof',
	},
};
const slot: Slot = slots[d.slug] ?? slots.marketing!;
const slotIsFilm = slot.kind === 'film';
---

<div class="bdbody bd-services bd-detail view-body view-body-boardroom" style={`--c:${d.color}`}>
	<!-- ── Hero — split: copy on one side, signature visual on the other ── -->
	<header class:list={['det-hero', 'bd-reveal', { 'det-hero--rev': L.heroRev }]} data-cursor={d.cursor}>
		<span class="det-aurora" aria-hidden="true"></span>
		<div class="det-hero-text">
			<a href="/services" class="det-back">
				<Icon width={15} name="mdi:arrow-left" />
				All services
			</a>
			<span class="det-kicker">
				<span class="det-kicker-ic"><Icon width={17} name={d.icon} /></span>
				{d.title}
			</span>
			<h1 class="bd-display det-h1">{d.tagline}</h1>
			<p class="bd-sub det-sub">{d.heroDesc}</p>
			<p class="det-clarify">{d.clarifier}</p>
			<div class="bd-links det-links">
				<a href="/contact" class="bd-pill">Start a project</a>
				<a href="#det-included" class="bd-link">
					What's included
					<Icon width={15} name="mdi:chevron-down" />
				</a>
			</div>
		</div>
		<div class="det-hero-visual">
			<ServiceVisual d={d} />
		</div>
	</header>

	{
		isDesign && (
			<section class="det-gallery bd-reveal" data-cursor={d.cursor}>
				<div class="det-gallery-grid">
					{d.projects.map((p, i) => (
						<a href="/portfolio" class:list={['det-gallery-card', { 'det-gallery-card--lead': i === 0 }]}>
							<img src={p.img} alt={p.name} loading={i === 0 ? 'eager' : 'lazy'} />
							<span class="det-gallery-veil" aria-hidden="true" />
							<span class="det-gallery-meta">
								<strong>{p.name}</strong>
								<em>{p.sector}</em>
							</span>
						</a>
					))}
				</div>
				<p class="det-gallery-cap">
					A few things we've designed.
					<a href="/portfolio" class="bd-link">See the full portfolio <Icon width={15} name="mdi:chevron-right" /></a>
				</p>
			</section>
		)
	}

	<!-- ── What it is ──────────────────────────────────────── -->
	<section class="det-about bd-reveal" data-cursor="vector">
		<span class="bd-eyebrow">What it is</span>
		<p class="det-overview-text">{d.overview}</p>
		<p class="det-outcome">
			<svg class="det-outcome-spark" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l1.9 5.6L19 9.5l-5.1 1.9L12 17l-1.9-5.6L5 9.5l5.1-1.9z" /></svg>
			{d.outcome}
		</p>
	</section>

	<!-- ── What's included ─────────────────────────────────── -->
	<section class="bd-head bd-reveal" id="det-included">
		<h2 class="bd-h bd-h--center">What's included.</h2>
		<p class="bd-p bd-p--center">Everything under {d.title}, handled by one team.</p>
	</section>
	{/* What's included, dealt as a hand: one card a sub-service, the
	    items as its line, and the ranks walking down from the ace so a
	    spread reads as a hand rather than one card printed six times.
	    The three layouts this block used to take are gone with it — they
	    varied the arrangement without varying what it said. */}
	<div class="det-deck bd-reveal">
		<CardShuffle
			variant="deck"
			label="What's included"
			every={6}
			items={d.included.map((sv) => ({
				title: sv.title,
				desc: sv.items.join(' · '),
			}))}
		/>
	</div>

	<!-- ── Ways we can work together ───────────────────────── -->
	<section class="bd-head bd-reveal">
		<h2 class="bd-h bd-h--center">However you want to work.</h2>
		<p class="bd-p bd-p--center">Hands-on or hands-off, we shape the engagement around you, and nothing ships until you're happy.</p>
	</section>
	<div class="det-ways">
		{
			d.ways.map((w) => (
				<article class="det-way bd-reveal" data-cursor="branch">
					<span class="det-way-ic"><Icon width={24} name={w.icon} /></span>
					<h3 class="det-way-t">{w.title}</h3>
					<p class="det-way-d">{w.desc}</p>
				</article>
			))
		}
	</div>

	<!-- ── How we approach it ──────────────────────────────── -->
	<section class="det-approach bd-reveal" data-cursor="chart">
		<span class="det-approach-aurora" aria-hidden="true"></span>
		<div class="bd-head">
			<h2 class="bd-h bd-h--center">How we approach it.</h2>
		</div>
		<ol class="det-steps">
			<span class="det-steps-line" aria-hidden="true"></span>
			{
				d.approach.map((p) => (
					<li class="det-step">
						<span class="det-step-n">{p.n}</span>
						<h3 class="det-step-t">{p.title}</h3>
						<p class="det-step-d">{p.desc}</p>
					</li>
				))
			}
		</ol>
	</section>

	<!-- ── Selected work (Design leads with its gallery instead) ── -->
	{
		!isDesign && (
			<section class="det-work-wrap bd-reveal" data-cursor="repo">
				<div class="bd-head">
					<h2 class="bd-h bd-h--center">{d.title} we've shipped.</h2>
					<p class="bd-p bd-p--center">A few of the products this discipline helped build.</p>
				</div>
				<div class="det-work">
					{d.projects.map((p) => (
						<a href="/portfolio" class="det-work-card">
							<img src={p.img} alt={p.name} loading="lazy" />
							<span class="det-work-veil" aria-hidden="true" />
							<span class="det-work-meta">
								<strong>{p.name}</strong>
								<em>{p.sector}</em>
							</span>
							<span class="det-work-go" aria-hidden="true"><Icon width={16} name="mdi:arrow-top-right" /></span>
						</a>
					))}
				</div>
				<p class="det-work-all">
					<a href="/portfolio" class="bd-link">See the full portfolio <Icon width={15} name="mdi:chevron-right" /></a>
				</p>
			</section>
		)
	}

	<!-- ── In action — the real thing, not a dashed box ────── -->
	<section class="det-media-band bd-reveal" data-cursor={slotIsFilm ? 'play' : 'repo'}>
		<div class="det-media-grid">
			<div class="det-media-copy">
				<span class="bd-eyebrow">{slotIsFilm ? 'Watch' : 'See it'}</span>
				<h2 class="det-media-h">{slot.label}</h2>
				<p class="det-media-p">
					A closer look at how {d.title.toLowerCase()} actually comes
					together, real work, from first move to finished result.
				</p>
				<a href="/portfolio" class="bd-link det-media-go">
					See the work
					<Icon width={15} name="mdi:chevron-right" />
				</a>
			</div>
			<figure class="det-media-stage">
				{
					slot.kind === 'film' ? (
						<FilmPlayer
							videoId={slot.videoId}
							src={slot.src}
							poster={slot.poster}
							fallback={slot.fallback}
							label={slot.label}
							tag={slot.tag}
						/>
					) : (
						<img
							class="det-media-shot"
							src={slot.img}
							alt={slot.alt}
							style={`object-position:${slot.pos}`}
							loading="lazy"
							decoding="async"
						/>
					)
				}
			</figure>
		</div>
	</section>

	<!-- ── Review ──────────────────────────────────────────── -->
	<div class="bd-grid bd-grid--narrow">
		<section class="det-review bd-reveal" data-cursor="quote">
			<Icon class="det-quote-mark" width={40} name="mdi:format-quote-close" />
			<blockquote>{d.review.quote}</blockquote>
			<footer>
				<img src={d.review.img} alt="" loading="lazy" />
				<span>
					<strong>{d.review.name}</strong>
					<em>{d.review.role}</em>
				</span>
			</footer>
		</section>
	</div>

	<!-- ── FAQ ─────────────────────────────────────────────── -->
	{
		d.faqs && d.faqs.length > 0 && (
			<section class="det-faq bd-reveal" data-cursor="quote">
				<div class="bd-head">
					<h2 class="bd-h bd-h--center">Questions, answered.</h2>
					<p class="bd-p bd-p--center">The things people ask us most about {d.title.toLowerCase()}.</p>
				</div>
				<div class="det-faq-list">
					{d.faqs.map((f, i) => (
						<details class="det-faq-item" open={i === 0}>
							<summary>
								<span class="det-faq-n">{String(i + 1).padStart(2, '0')}</span>
									<span class="det-faq-q">{f.q}</span>
								<span class="det-faq-ic" aria-hidden="true">
									<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
								</span>
							</summary>
							<div class="det-faq-ans"><p>{f.a}</p></div>
						</details>
					))}
				</div>
			</section>
		)
	}

	<!-- Final CTA — the desk on the right, the ask on the left.
	     The type is set live rather than baked into the picture, so it
	     reflows, it is readable to a crawler, and it can be changed
	     without opening an image editor. -->
	<section class="bd-grid">
		<div class="bd-tile bd-tile--full bd-tile--cta bd-reveal" data-cursor="phone">
			<div class="bd-cta-copy">
				<span class="bd-cta-kick"><i aria-hidden="true" />Let's connect</span>
				<h3 class="bd-display bd-display--cta">
					Let's talk
					<em>{d.title.toLowerCase()}.</em>
				</h3>
				<div class="bd-cta-act">
					<a href="/contact" class="bd-cta-go">
						<Icon width={18} name="mdi:arrow-right" />
						<span class="bd-cta-go-l">Start your project</span>
						<span class="bd-cta-go-s">Start a project</span>
					</a>
					<a href="tel:+2348100204570" class="bd-call">
						<span class="bd-call-hint">or call us now</span>
						<span class="bd-call-num">
							<Icon width={22} name="mdi:phone" />
							+234 810 020 4570
						</span>
					</a>
				</div>
			</div>
			<figure class="bd-cta-shot">
				<img
					src="/images/cta/talk-business.jpg"
					alt="A Swizel desk at the end of the day"
					loading="lazy"
					decoding="async"
				/>
				<figcaption class="bd-cta-stamp">
					Bigger ideas.
					<strong>Real results.</strong>
				</figcaption>
			</figure>
		</div>
	</section>

	<!-- ── Explore other disciplines (even grid: + Overview) ── -->
	<section class="det-others bd-reveal" data-cursor="repo">
		<h2 class="bd-h bd-h--center">Explore the rest.</h2>
		<div class="det-others-grid">
			{
				others.map((o) => (
					<a href={`/services/${o.slug}`} class="det-other" style={`--c:${o.color}`} data-cursor={o.cursor}>
						<span class="det-other-ic"><Icon width={22} name={o.icon} /></span>
						<span class="det-other-meta">
							<strong>{o.title}</strong>
							<em>{o.tagline}</em>
						</span>
						<Icon width={18} name="mdi:arrow-right" />
					</a>
				))
			}
			<a href="/services" class="det-other det-other--over" style="--c:#28a6ec">
				<span class="det-other-ic">
					<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /></svg>
				</span>
				<span class="det-other-meta">
					<strong>All services</strong>
					<em>The full overview</em>
				</span>
				<Icon width={18} name="mdi:arrow-right" />
			</a>
		</div>
	</section>
</div>

<style>
	/* ════ Boardroom base (self-contained), themed by --c ════ */
	.bdbody {
		--bd-accent: var(--c, #28a6ec);
		--bd-ink: #f4f6fb;
		--bd-muted: rgba(244, 246, 251, 0.62);
		--bd-glass: linear-gradient(160deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.02) 55%);
		--bd-glass-border: rgba(255, 255, 255, 0.1);
		--bd-shadow: 0 34px 80px -34px rgba(0, 0, 0, 0.8);
		font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
		position: relative;
		isolation: isolate;
		background:
			radial-gradient(1100px 540px at 78% -6%, color-mix(in srgb, var(--c) 16%, transparent), transparent 62%),
			radial-gradient(900px 520px at 8% 38%, rgba(58, 90, 200, 0.1), transparent 60%),
			linear-gradient(180deg, #070910 0%, #0a0d1c 45%, #05060d 100%);
		color: var(--bd-ink);
		padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1rem, 3vw, 2rem) clamp(2.5rem, 5vw, 4rem);
	}
	:global(html:not(.dark)) .bdbody {
		--bd-ink: #14162a;
		--bd-muted: rgba(20, 22, 40, 0.64);
		--bd-glass: linear-gradient(160deg, rgba(255, 255, 255, 0.82), rgba(255, 255, 255, 0.55) 55%);
		--bd-glass-border: rgba(20, 22, 40, 0.1);
		--bd-shadow: 0 30px 70px -34px rgba(20, 22, 40, 0.25);
		background:
			radial-gradient(1100px 540px at 78% -6%, color-mix(in srgb, var(--c) 12%, transparent), transparent 62%),
			linear-gradient(180deg, #eef2f7 0%, #e7edf6 50%, #eef2f7 100%);
	}

	.bd-display { font-size: clamp(2.4rem, 5.5vw, 4.2rem); font-weight: 700; letter-spacing: -0.025em; line-height: 1.05; margin: 0 0 1.1rem; }
	.bd-sub { font-size: clamp(1.05rem, 2vw, 1.32rem); line-height: 1.5; color: var(--bd-muted); max-width: 40rem; margin: 0 auto 1rem; }
	.bd-h { font-size: clamp(1.7rem, 3.4vw, 2.5rem); font-weight: 700; letter-spacing: -0.02em; line-height: 1.1; margin: 0 0 0.7rem; }
	.bd-h--center { text-align: center; }
	.bd-p { font-size: 1.02rem; line-height: 1.6; color: var(--bd-muted); max-width: 34rem; margin: 0 auto 1.2rem; }
	.bd-p--center { margin-inline: auto; text-align: center; }
	.bd-eyebrow { display: block; font-size: 0.78rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--c); margin-bottom: 0.7rem; }
	.bd-head { max-width: 56rem; margin: clamp(2.5rem, 6vw, 4rem) auto clamp(1.5rem, 3vw, 2rem); text-align: center; }

	.bd-links { display: flex; align-items: center; justify-content: center; gap: 1.4rem; flex-wrap: wrap; margin-top: 1.4rem; }
	.bd-links--center { justify-content: center; }
	.bd-pill {
		display: inline-flex; align-items: center; padding: 0.78rem 1.5rem; border-radius: 9999px;
		background: linear-gradient(180deg, color-mix(in srgb, var(--c) 88%, #fff), var(--c) 45%, color-mix(in srgb, var(--c) 72%, #03244a));
		border: 1px solid color-mix(in srgb, var(--c) 60%, rgba(255, 255, 255, 0.4)); color: #fff; font-size: 0.95rem; font-weight: 600;
		text-shadow: 0 1px 2px rgba(0, 0, 0, 0.25); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35), 0 12px 28px -12px color-mix(in srgb, var(--c) 65%, transparent);
		transition: transform 0.25s ease, box-shadow 0.25s ease;
	}
	.bd-pill:hover { transform: translateY(-2px); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.4), 0 18px 38px -12px color-mix(in srgb, var(--c) 80%, transparent); }
	.bd-pill--light { background: linear-gradient(180deg, #fff, #dfe6f2); border-color: rgba(255, 255, 255, 0.8); color: #0b0d18; text-shadow: none; }
	.bd-link { display: inline-flex; align-items: center; gap: 0.3rem; font-size: 0.98rem; font-weight: 600; color: var(--c); transition: gap 0.25s ease; }
	.bd-link:hover { gap: 0.5rem; }
	.bd-link--invert { color: color-mix(in srgb, var(--c) 60%, #fff); }

	.bd-grid { display: grid; gap: clamp(0.9rem, 2vw, 1.4rem); max-width: 88rem; margin: 0 auto clamp(0.9rem, 2vw, 1.4rem); }
	.bd-grid--narrow { max-width: 60rem; }
	.bd-tile { position: relative; border-radius: 1.75rem; background: var(--bd-glass); border: 1px solid var(--bd-glass-border); box-shadow: var(--bd-shadow); backdrop-filter: blur(22px) saturate(130%); -webkit-backdrop-filter: blur(22px) saturate(130%); overflow: hidden; padding: clamp(2rem, 4vw, 3rem) clamp(1.5rem, 3vw, 2.5rem); }
	.bd-tile--full { grid-column: 1 / -1; }

	/* ── Hero — split: copy + signature visual side by side ── */
	.det-hero { position: relative; overflow: hidden; max-width: 84rem; margin: 0 auto clamp(2rem, 5vw, 3.5rem); padding: clamp(1rem, 3vw, 2.5rem) clamp(0.5rem, 2vw, 1.5rem) clamp(2rem, 4vw, 3rem); display: grid; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
	@media (min-width: 940px) { .det-hero { grid-template-columns: 1.02fr 0.98fr; } .det-hero--rev .det-hero-text { order: 2; } }
	.det-aurora { position: absolute; inset: -25% -10% auto; height: 120%; z-index: -1; pointer-events: none; background: radial-gradient(520px 380px at 30% 14%, color-mix(in srgb, var(--c) 34%, transparent), transparent 62%); filter: blur(54px); opacity: 0.65; animation: det-float 16s ease-in-out infinite; }
	.det-hero--rev .det-aurora { background: radial-gradient(520px 380px at 70% 14%, color-mix(in srgb, var(--c) 34%, transparent), transparent 62%); }
	:global(html:not(.dark)) .det-aurora { opacity: 0.4; }
	@keyframes det-float { 0%,100%{ transform: translateY(0) scale(1); } 50%{ transform: translateY(-3%) scale(1.07); } }
	.det-hero-text { text-align: left; }
	.det-back { display: flex; width: fit-content; align-items: center; gap: 0.35rem; font-size: 0.82rem; font-weight: 600; color: var(--bd-muted); margin-bottom: 1.4rem; padding: 0.4rem 0.85rem 0.4rem 0.7rem; border-radius: 9999px; background: var(--bd-glass); border: 1px solid var(--bd-glass-border); transition: gap 0.25s ease, color 0.25s ease, border-color 0.25s ease; }
	.det-back:hover { border-color: color-mix(in srgb, var(--c) 40%, var(--bd-glass-border)); }
	.det-back:hover { gap: 0.55rem; color: var(--c); }
	.det-kicker { display: inline-flex; align-items: center; gap: 0.55rem; font-size: 0.82rem; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; color: var(--c); margin-bottom: 1rem; }
	.det-kicker-ic { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 0.7rem; color: var(--c); background: linear-gradient(135deg, color-mix(in srgb, var(--c) 28%, transparent), color-mix(in srgb, var(--c) 8%, transparent)); border: 1px solid color-mix(in srgb, var(--c) 38%, transparent); }
	.det-h1 { max-width: 14ch; margin: 0 0 1.1rem; }
	.det-sub { margin-inline: 0; }
	.det-clarify { font-size: 0.92rem; font-weight: 600; letter-spacing: 0.01em; color: color-mix(in srgb, var(--c) 78%, var(--bd-ink)); margin: 0 0 0.4rem; max-width: 34rem; }
	.det-links { justify-content: flex-start; }
	.det-hero-visual { width: 100%; }

	/* ── What it is (centered editorial lead, no template bar) ── */
	.det-about { position: relative; max-width: 50rem; margin: clamp(2.5rem, 5vw, 3.5rem) auto clamp(1.5rem, 2vw, 2rem); text-align: center; }
	.det-overview-text { font-size: clamp(1.15rem, 2.4vw, 1.55rem); font-weight: 500; line-height: 1.5; letter-spacing: -0.01em; margin: 0.6rem 0 1.5rem; }
	.det-outcome { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.92rem; font-weight: 700; color: var(--c); margin: 0; padding: 0.5rem 1.1rem; border-radius: 9999px; background: color-mix(in srgb, var(--c) 12%, transparent); border: 1px solid color-mix(in srgb, var(--c) 30%, transparent); }
	.det-outcome :global(svg) { color: var(--c); }

	/* ── Media slot — copy paired with the placeholder (never a lone empty box) ── */
	.det-media-band { max-width: 76rem; margin: clamp(2.5rem, 6vw, 4rem) auto; }
	.det-media-grid { display: grid; gap: clamp(1.5rem, 3vw, 2.5rem); align-items: center; }
	@media (min-width: 820px) { .det-media-grid { grid-template-columns: 0.82fr 1.18fr; } }
	.det-media-copy { text-align: left; }
	.det-media-h { font-size: clamp(1.5rem, 3vw, 2.1rem); font-weight: 700; letter-spacing: -0.02em; line-height: 1.12; margin: 0.2rem 0 0.7rem; }
	.det-media-p { font-size: 0.98rem; line-height: 1.6; color: var(--bd-muted); margin: 0 0 1.3rem; }
	.det-media-cta { display: inline-flex; align-items: center; gap: 0.55rem; padding: 0.7rem 1.3rem; border-radius: 9999px; font-size: 0.92rem; font-weight: 700; color: var(--c); border: 1.5px solid color-mix(in srgb, var(--c) 50%, transparent); background: color-mix(in srgb, var(--c) 10%, transparent); cursor: pointer; transition: background 0.25s ease, color 0.25s ease, transform 0.25s ease; }
	.det-media-cta:hover { background: var(--c); color: #06121a; transform: translateY(-2px); }
	.det-media-cta-ic { display: inline-grid; place-items: center; }
	.det-media-slot {
		position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.45rem;
		aspect-ratio: 16 / 10; border-radius: 1.5rem; overflow: hidden; cursor: pointer;
		border: 1.5px dashed color-mix(in srgb, var(--c) 40%, transparent);
		background: radial-gradient(560px 280px at 50% 0%, color-mix(in srgb, var(--c) 18%, transparent), transparent 65%), linear-gradient(180deg, rgba(18, 22, 42, 0.6), rgba(5, 6, 13, 0.8));
		color: var(--bd-muted); box-shadow: var(--bd-shadow);
	}
	:global(html:not(.dark)) .det-media-slot { background: radial-gradient(560px 280px at 50% 0%, color-mix(in srgb, var(--c) 14%, transparent), transparent 65%), linear-gradient(180deg, rgba(255, 255, 255, 0.72), rgba(255, 255, 255, 0.44)); }
	.det-media-grid-lines { position: absolute; inset: 0; pointer-events: none; opacity: 0.5; background-image: linear-gradient(color-mix(in srgb, var(--c) 14%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--c) 14%, transparent) 1px, transparent 1px); background-size: 38px 38px; -webkit-mask-image: radial-gradient(closest-side at 50% 50%, #000, transparent); mask-image: radial-gradient(closest-side at 50% 50%, #000, transparent); }
	.det-media-ic { position: relative; display: grid; place-items: center; width: 62px; height: 62px; border-radius: 9999px; color: #fff; background: linear-gradient(180deg, color-mix(in srgb, var(--c) 90%, #fff), var(--c)); box-shadow: 0 16px 36px -12px color-mix(in srgb, var(--c) 70%, transparent); margin-bottom: 0.35rem; }
	.det-media-ic::after { content: ''; position: absolute; inset: -8px; border-radius: 9999px; border: 1.5px solid color-mix(in srgb, var(--c) 45%, transparent); animation: det-ping 2.6s ease-out infinite; }
	@keyframes det-ping { 0% { transform: scale(0.85); opacity: 0.8; } 100% { transform: scale(1.5); opacity: 0; } }
	.det-media-label { position: relative; font-size: 0.76rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; }
	.det-media-sheen { position: absolute; inset: 0; background: linear-gradient(115deg, transparent 35%, rgba(255, 255, 255, 0.06) 50%, transparent 64%); transform: translateX(-100%); animation: det-sheen 6s ease-in-out infinite; pointer-events: none; }
	@keyframes det-sheen { 0%, 55% { transform: translateX(-100%); } 85%, 100% { transform: translateX(100%); } }

	/* ── Included — grid (2 or 3 col) or numbered list ── */
	.det-grid { display: grid; gap: clamp(1rem, 2vw, 1.5rem); max-width: 72rem; margin: 0 auto; }
	.det-grid--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	.det-grid--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
	@media (max-width: 940px) { .det-grid--3 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
	@media (max-width: 720px) { .det-grid--2, .det-grid--3 { grid-template-columns: 1fr; } }
	.det-list { list-style: none; margin: 0 auto; padding: 0; max-width: 56rem; display: grid; gap: 0.9rem; }
	.det-list-item { display: flex; gap: clamp(1rem, 2.5vw, 1.5rem); padding: clamp(1.3rem, 3vw, 1.8rem); border-radius: 1.3rem; background: var(--bd-glass); border: 1px solid var(--bd-glass-border); box-shadow: var(--bd-shadow); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); transition: transform 0.35s ease, border-color 0.35s ease; }
	.det-list-item:hover { transform: translateX(5px); border-color: color-mix(in srgb, var(--c) 45%, var(--bd-glass-border)); }
	.det-list-n { flex-shrink: 0; font-size: clamp(1.4rem, 3vw, 1.9rem); font-weight: 800; letter-spacing: -0.02em; line-height: 1; color: color-mix(in srgb, var(--c) 70%, transparent); font-variant-numeric: tabular-nums; }
	.det-list-body { flex: 1; min-width: 0; }
	.det-card { position: relative; padding: clamp(1.5rem, 3vw, 2.2rem); border-radius: 1.4rem; background: var(--bd-glass); border: 1px solid var(--bd-glass-border); box-shadow: var(--bd-shadow); backdrop-filter: blur(18px) saturate(130%); -webkit-backdrop-filter: blur(18px) saturate(130%); transition: transform 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease; overflow: hidden; }
	.det-card::before { content: ''; position: absolute; left: clamp(1.5rem, 3vw, 2.2rem); top: 0; width: 30px; height: 3px; border-radius: 0 0 3px 3px; background: var(--c); }
	.det-card:hover { transform: translateY(-5px); border-color: color-mix(in srgb, var(--c) 50%, var(--bd-glass-border)); box-shadow: 0 40px 90px -36px color-mix(in srgb, var(--c) 34%, rgba(0,0,0,0.85)); }
	.det-card-t { font-size: 1.25rem; font-weight: 700; letter-spacing: -0.01em; margin: 0 0 0.4rem; }
	.det-card-d { font-size: 0.95rem; line-height: 1.55; color: var(--bd-muted); margin: 0 0 1rem; }
	/* A calm vertical checklist (one item per row) reads as an organised list
	   rather than a packed, ragged cloud of wrapping chips. */
	.det-card-items { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.55rem; }
	.det-card-items li { display: flex; align-items: center; gap: 0.55rem; font-size: 0.85rem; font-weight: 600; color: color-mix(in srgb, var(--bd-ink) 72%, transparent); }
	.det-card-items :global(svg) { color: var(--c); flex-shrink: 0; }

	/* ── Ways we can work ── */
	.det-ways { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1rem, 2vw, 1.4rem); max-width: 72rem; margin: 0 auto; }
	@media (max-width: 820px) { .det-ways { grid-template-columns: 1fr; } }
	.det-way { padding: clamp(1.5rem, 3vw, 2.1rem); border-radius: 1.4rem; background: color-mix(in srgb, var(--c) 7%, var(--bd-glass)); border: 1px solid color-mix(in srgb, var(--c) 22%, var(--bd-glass-border)); box-shadow: var(--bd-shadow); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); transition: transform 0.35s ease, border-color 0.35s ease; }
	.det-way:hover { transform: translateY(-4px); border-color: color-mix(in srgb, var(--c) 45%, transparent); }
	.det-way-ic { display: grid; place-items: center; width: 52px; height: 52px; margin-bottom: 1rem; border-radius: 1rem; color: var(--c); background: color-mix(in srgb, var(--c) 16%, transparent); border: 1px solid color-mix(in srgb, var(--c) 32%, transparent); }
	.det-way-t { font-size: 1.12rem; font-weight: 700; margin: 0 0 0.4rem; }
	.det-way-d { font-size: 0.92rem; line-height: 1.55; color: var(--bd-muted); margin: 0; }

	/* ── Approach ── */
	.det-approach { position: relative; overflow: hidden; max-width: 72rem; margin: clamp(2.5rem, 6vw, 4rem) auto; padding: clamp(2rem, 5vw, 3.5rem) clamp(1rem, 3vw, 2rem); border-radius: 2rem; isolation: isolate; }
	.det-approach-aurora { position: absolute; inset: 0; z-index: -1; pointer-events: none; background: radial-gradient(600px 320px at 50% 0%, color-mix(in srgb, var(--c) 18%, transparent), transparent 62%); filter: blur(34px); opacity: 0.7; }
	.det-steps { position: relative; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1rem, 2.5vw, 1.75rem); }
	.det-steps-line { position: absolute; top: 38px; left: 14%; right: 14%; height: 2px; background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--c) 55%, transparent), transparent); z-index: 0; }
	@media (max-width: 720px) { .det-steps { grid-template-columns: 1fr; } .det-steps-line { display: none; } }
	.det-step { position: relative; z-index: 1; padding: 1.6rem 1.4rem; border-radius: 1.25rem; background: var(--bd-glass); border: 1px solid var(--bd-glass-border); box-shadow: var(--bd-shadow); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); text-align: center; }
	.det-step-n { display: grid; place-items: center; width: 46px; height: 46px; margin: 0 auto 0.9rem; border-radius: 9999px; font-weight: 800; color: #06121a; background: linear-gradient(135deg, color-mix(in srgb, var(--c) 85%, #fff), var(--c)); box-shadow: 0 10px 24px -10px color-mix(in srgb, var(--c) 70%, transparent); }
	.det-step-t { font-size: 1.15rem; font-weight: 700; margin: 0 0 0.35rem; }
	.det-step-d { font-size: 0.9rem; line-height: 1.55; color: var(--bd-muted); margin: 0; }

	/* ── Selected work ── */
	.det-work-wrap { max-width: 80rem; margin: 0 auto; }
	.det-work { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(0.9rem, 2vw, 1.4rem); }
	@media (max-width: 820px) { .det-work { grid-template-columns: 1fr 1fr; } }
	@media (max-width: 520px) { .det-work { grid-template-columns: 1fr; } }
	.det-work-card { position: relative; display: block; aspect-ratio: 4 / 3; border-radius: 1.3rem; overflow: hidden; border: 1px solid var(--bd-glass-border); box-shadow: var(--bd-shadow); }
	.det-work-card img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1); }
	.det-work-card:hover img { transform: scale(1.06); }
	.det-work-veil { position: absolute; inset: 0; background: linear-gradient(180deg, transparent 40%, rgba(5, 6, 14, 0.85)); }
	.det-work-meta { position: absolute; left: 1.1rem; right: 1.1rem; bottom: 0.95rem; display: flex; flex-direction: column; color: #fff; }
	.det-work-meta strong { font-size: 1.05rem; font-weight: 700; }
	.det-work-meta em { font-style: normal; font-size: 0.78rem; color: rgba(255, 255, 255, 0.66); }
	.det-work-go { position: absolute; top: 0.9rem; right: 0.9rem; display: grid; place-items: center; width: 34px; height: 34px; border-radius: 9999px; background: color-mix(in srgb, var(--c) 80%, transparent); color: #fff; opacity: 0; transform: translate(4px, -4px); transition: opacity 0.3s ease, transform 0.3s ease; }
	.det-work-card:hover .det-work-go { opacity: 1; transform: translate(0, 0); }
	.det-work-all { text-align: center; margin: 1.5rem 0 0; }

	/* ── Design gallery (Design page leads with work) ── */
	.det-gallery { max-width: 84rem; margin: 0 auto clamp(2rem, 5vw, 3.5rem); }
	.det-gallery-grid { display: grid; grid-template-columns: 1.5fr 1fr; grid-auto-rows: minmax(150px, 1fr); gap: clamp(0.8rem, 2vw, 1.3rem); }
	@media (max-width: 700px) { .det-gallery-grid { grid-template-columns: 1fr; } }
	.det-gallery-card { position: relative; overflow: hidden; border-radius: 1.5rem; border: 1px solid var(--bd-glass-border); box-shadow: var(--bd-shadow); min-height: 170px; }
	.det-gallery-card--lead { grid-row: span 2; }
	@media (max-width: 700px) { .det-gallery-card--lead { grid-row: auto; aspect-ratio: 4 / 3; } }
	.det-gallery-card img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1); }
	.det-gallery-card:hover img { transform: scale(1.05); }
	.det-gallery-veil { position: absolute; inset: 0; background: linear-gradient(180deg, transparent 45%, rgba(5, 6, 14, 0.86)); }
	.det-gallery-meta { position: absolute; left: 1.2rem; right: 1.2rem; bottom: 1.1rem; display: flex; flex-direction: column; color: #fff; }
	.det-gallery-meta strong { font-size: 1.15rem; font-weight: 700; letter-spacing: -0.01em; }
	.det-gallery-card--lead .det-gallery-meta strong { font-size: clamp(1.3rem, 2.4vw, 1.8rem); }
	.det-gallery-meta em { font-style: normal; font-size: 0.82rem; color: rgba(255, 255, 255, 0.7); }
	.det-gallery-cap { display: flex; align-items: center; justify-content: center; gap: 0.5rem; flex-wrap: wrap; margin: 1.4rem 0 0; font-size: 0.95rem; color: var(--bd-muted); }

	/* ── Review ── */
	.det-review { position: relative; text-align: center; padding: clamp(2.25rem, 5vw, 3.5rem) clamp(1.5rem, 4vw, 3rem); border-radius: 1.75rem; overflow: hidden; background: radial-gradient(620px 300px at 50% -10%, color-mix(in srgb, var(--c) 18%, transparent), transparent 65%), var(--bd-glass); border: 1px solid color-mix(in srgb, var(--c) 24%, var(--bd-glass-border)); box-shadow: var(--bd-shadow); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); }
	.det-quote-mark { color: var(--c); opacity: 0.5; }
	.det-review blockquote { font-size: clamp(1.25rem, 2.6vw, 1.8rem); font-weight: 600; line-height: 1.4; letter-spacing: -0.01em; max-width: 40rem; margin: 0.6rem auto 1.6rem; }
	.det-review footer { display: flex; align-items: center; justify-content: center; gap: 0.75rem; }
	.det-review footer img { width: 46px; height: 46px; border-radius: 9999px; object-fit: cover; border: 2px solid color-mix(in srgb, var(--c) 55%, transparent); }
	.det-review footer span { display: flex; flex-direction: column; text-align: left; line-height: 1.25; }
	.det-review footer strong { font-size: 0.95rem; }
	.det-review footer em { font-style: normal; font-size: 0.8rem; color: var(--bd-muted); }

	/* ── CTA ── */
	.det-cta { text-align: center; background: radial-gradient(820px 380px at 50% 130%, color-mix(in srgb, var(--c) 38%, transparent), transparent 72%), linear-gradient(180deg, rgba(18, 22, 42, 0.92), rgba(5, 6, 13, 0.96)); color: #f5f5f7; border-color: color-mix(in srgb, var(--c) 26%, rgba(255, 255, 255, 0.1)); padding-block: clamp(3rem, 6vw, 4.5rem); }
	.det-cta-h { font-size: clamp(2rem, 4.5vw, 3.4rem); }
	.det-cta .bd-sub { color: rgba(245, 245, 247, 0.62); }

	/* ── Explore others ── */
	.det-others { max-width: 72rem; margin: clamp(2.5rem, 6vw, 4rem) auto 0; text-align: center; }
	.det-others .bd-h { margin-bottom: 1.6rem; }
	.det-others-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.9rem; }
	@media (max-width: 860px) { .det-others-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
	@media (max-width: 540px) { .det-others-grid { grid-template-columns: 1fr; } }
	.det-other { display: flex; align-items: center; gap: 0.8rem; text-align: left; padding: 0.9rem 1rem; border-radius: 1.1rem; background: var(--bd-glass); border: 1px solid var(--bd-glass-border); box-shadow: var(--bd-shadow); transition: transform 0.3s ease, border-color 0.3s ease; }
	.det-other:hover { transform: translateY(-3px); border-color: color-mix(in srgb, var(--c) 50%, var(--bd-glass-border)); }
	.det-other--over { background: color-mix(in srgb, #28a6ec 10%, var(--bd-glass)); }
	.det-other-ic { display: grid; place-items: center; width: 42px; height: 42px; flex-shrink: 0; border-radius: 0.8rem; color: var(--c); background: color-mix(in srgb, var(--c) 14%, transparent); border: 1px solid color-mix(in srgb, var(--c) 30%, transparent); }
	.det-other-meta { display: flex; flex-direction: column; line-height: 1.25; min-width: 0; flex: 1; }
	.det-other-meta strong { font-size: 0.98rem; }
	.det-other-meta em { font-style: normal; font-size: 0.78rem; color: var(--bd-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
	.det-other > :global(svg) { color: var(--c); flex-shrink: 0; }

	/* ── FAQ accordion ── */
	.det-faq { max-width: 50rem; margin: clamp(2.5rem, 6vw, 4rem) auto clamp(2.5rem, 6vw, 4rem); }
	.det-faq-list { display: grid; gap: 0.75rem; }
	.det-faq-item { position: relative; border-radius: 1.15rem; background: var(--bd-glass); border: 1px solid var(--bd-glass-border); box-shadow: var(--bd-shadow); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); overflow: hidden; transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease; }
	.det-faq-item::before { content: ''; position: absolute; left: clamp(1.2rem, 3vw, 1.6rem); top: 0; width: 26px; height: 3px; border-radius: 0 0 3px 3px; background: var(--c); opacity: 0; transition: opacity 0.3s ease; }
	.det-faq-item[open] { border-color: color-mix(in srgb, var(--c) 42%, var(--bd-glass-border)); box-shadow: 0 30px 70px -40px color-mix(in srgb, var(--c) 50%, rgba(0,0,0,0.8)); }
	.det-faq-item[open]::before { opacity: 0.9; }
	.det-faq-item:hover { border-color: color-mix(in srgb, var(--c) 30%, var(--bd-glass-border)); }
	.det-faq-item summary { display: flex; align-items: center; gap: 0.9rem; padding: 1.2rem 1.4rem; cursor: pointer; list-style: none; }
	.det-faq-item summary::-webkit-details-marker { display: none; }
	.det-faq-n { flex-shrink: 0; font-size: 0.82rem; font-weight: 800; letter-spacing: 0.04em; color: color-mix(in srgb, var(--c) 78%, var(--bd-ink)); font-variant-numeric: tabular-nums; }
	.det-faq-q { flex: 1; font-size: clamp(1rem, 2vw, 1.1rem); font-weight: 600; letter-spacing: -0.01em; color: var(--bd-ink); }
	.det-faq-ic { display: grid; place-items: center; width: 30px; height: 30px; flex-shrink: 0; border-radius: 9999px; color: var(--c); background: color-mix(in srgb, var(--c) 13%, transparent); border: 1px solid color-mix(in srgb, var(--c) 28%, transparent); transition: transform 0.35s cubic-bezier(0.22,1,0.36,1), background 0.3s ease; }
	.det-faq-item[open] .det-faq-ic { transform: rotate(135deg); background: var(--c); color: #06121a; border-color: var(--c); }
	.det-faq-ans { overflow: hidden; }
	.det-faq-item[open] .det-faq-ans { animation: det-faq-open 0.4s cubic-bezier(0.22, 1, 0.36, 1); }
	@keyframes det-faq-open { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: translateY(0); } }
	.det-faq-ans p { margin: 0; padding: 0 1.4rem 1.3rem 3.35rem; font-size: 0.97rem; line-height: 1.65; color: var(--bd-muted); }
	@media (max-width: 540px) { .det-faq-ans p { padding-left: 1.4rem; } }

	/* ── Reveal ── */
	.bd-reveal { opacity: 0; transform: translateY(26px); transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.22, 1, 0.36, 1); }
	.bd-reveal.is-on { opacity: 1; transform: translateY(0); }
	@media (prefers-reduced-motion: reduce) {
		.bd-reveal { opacity: 1; transform: none; transition: none; }
		.det-aurora, .det-media-sheen, .det-media-ic::after { animation: none; }
		.det-card:hover, .det-other:hover, .det-way:hover, .det-work-card:hover img { transform: none; }
	}

	/* ═══ shared with the rest of the site ═══════════════════════════ */
	/* ── the closing tile ── */
	.bd-tile--cta {
		position: relative;
		overflow: hidden;
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
		align-items: stretch;
		gap: 0;
		padding: 0;
		text-align: left;
		background:
			radial-gradient(760px 420px at 6% 110%, color-mix(in srgb, var(--bd-accent) 26%, transparent), transparent 70%),
			linear-gradient(180deg, rgba(14, 19, 36, 0.96), rgba(4, 6, 13, 0.98));
		color: #f5f5f7;
		border-color: color-mix(in srgb, var(--bd-accent) 26%, rgba(255, 255, 255, 0.1));
	}
	.bd-cta-copy {
		padding: clamp(2.2rem, 5vw, 4.2rem) clamp(1.4rem, 3.4vw, 3.4rem);
		align-self: center;
		/* a grid item's automatic minimum is its content, and a phone
		   number set nowrap is wide content: without this the column grows
		   past the tile and the tile quietly clips it */
		min-width: 0;
	}
	.bd-cta-kick {
		display: inline-flex;
		align-items: center;
		gap: 0.85rem;
		font-size: 0.72rem;
		font-weight: 700;
