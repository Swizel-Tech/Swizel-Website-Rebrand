---
// A short exhibition entry.
//
// Six works in the collection have neither a live site nor a written case
// study, so their tiles pointed nowhere at all — a wall you cannot walk
// into. This gives each of them a real page built only from what is
// actually recorded about the piece: the shot, the sector, the year, the
// disciplines and the blurb. It does not invent a brief, a process or a
// result, and it says plainly that the full write-up is still to come.
//
// One component for all five worlds: it reads --view-accent, so it takes
// the colour of whichever room the visitor is standing in.
import { Icon } from 'astro-icon/components';
import type { Project } from '../../data/projects';
import { sectorLabels } from '../../data/projects';

interface Props {
	project: Project;
	others: Project[];
}
const { project: p, others } = Astro.props;
const more = others.slice(0, 3);
---

<article class="csh" style={`--c:${p.color}`}>
	<div class="csh-bg" aria-hidden="true">
		<span class="csh-orb"></span>
		<span class="csh-grid"></span>
	</div>

	<section class="csh-sec">
		<div class="csh-wrap">
			<nav class="csh-back">
				<a href="/portfolio">
					<Icon width={15} name="mdi:arrow-left" />
					Back to the collection
				</a>
			</nav>

			<div class="csh-open">
				<div class="csh-copy">
					<span class="csh-kick">
						<i aria-hidden="true"></i>
						{sectorLabels[p.sector]} · {p.year}
					</span>
					<h1 class="csh-h">{p.name}</h1>
					<p class="csh-tag">{p.tagline}</p>
					<p class="csh-blurb">{p.blurb}</p>

					<ul class="csh-tags">
						{p.tags.map((t) => <li>{t}</li>)}
					</ul>

					<p class="csh-note">
						<Icon width={16} name="mdi:information-outline" />
						The full write&#8209;up for this piece is still being
						prepared. Everything above is on record; the brief, the
						process and the results will be hung here once the
						studio has written them up.
					</p>

					<div class="csh-cta">
						<a class="csh-btn" href="/contact">
							Ask us about this work
							<Icon width={16} name="mdi:arrow-right" />
						</a>
						<a class="csh-ghost" href="/portfolio#sp-wall">See the whole collection</a>
					</div>
				</div>

				<figure class="csh-frame">
					<span class="csh-frame-wire" aria-hidden="true"></span>
					<span class="csh-frame-mat">
						<img src={p.img} alt={`${p.name}, ${p.tagline}`} loading="eager" decoding="async" />
						<span class="csh-frame-glass" aria-hidden="true"></span>
					</span>
					<figcaption class="csh-plaque">
						<strong>{p.name}</strong>
						<span>{sectorLabels[p.sector]} · {p.tags.join(' · ')} · {p.year}</span>
					</figcaption>
				</figure>
			</div>
		</div>
	</section>

	{
		more.length > 0 && (
			<section class="csh-sec csh-sec--more">
				<div class="csh-wrap">
					<div class="csh-rule">
						<span>Also in the collection</span>
						<span>Three more from the wall</span>
					</div>
					<div class="csh-more">
						{more.map((o) => (
							<a
								class="csh-more-item"
								href={o.caseStudy || !o.url ? `/work/${o.slug}` : o.url}
								target={!o.caseStudy && o.url ? '_blank' : undefined}
								rel={!o.caseStudy && o.url ? 'noopener noreferrer' : undefined}
								style={`--c:${o.color}`}
							>
								<span class="csh-more-pic">
									<img src={o.img} alt={o.name} loading="lazy" decoding="async" />
								</span>
								<span class="csh-more-txt">
									<b>{o.name}</b>
									<em>{sectorLabels[o.sector]} · {o.year}</em>
								</span>
							</a>
						))}
					</div>
				</div>
			</section>
		)
	}
</article>

<style>
	.csh {
		--ink: #f3edf0;
		--muted: rgba(243, 237, 240, 0.66);
		--faint: rgba(243, 237, 240, 0.46);
		--line: rgba(243, 237, 240, 0.14);
		--card: rgba(255, 255, 255, 0.04);
		--acc: var(--view-accent, #ec4899);
		--serif: 'Playfair Display', Georgia, 'Times New Roman', serif;
		position: relative;
		isolation: isolate;
		overflow: hidden;
		display: block;
		color: var(--ink);
		background:
			radial-gradient(1000px 520px at 84% -8%, color-mix(in srgb, var(--c) 16%, transparent), transparent 62%),
			linear-gradient(180deg, #100b0e 0%, #140d11 52%, #0c0709 100%);
	}
	:global(html:not(.dark)) .csh {
		--ink: #1c151a;
		--muted: rgba(28, 21, 26, 0.72);
		--faint: rgba(28, 21, 26, 0.5);
		--line: rgba(28, 21, 26, 0.14);
		--card: rgba(28, 21, 26, 0.035);
		background:
			radial-gradient(1000px 520px at 84% -8%, color-mix(in srgb, var(--c) 12%, transparent), transparent 62%),
			linear-gradient(180deg, #faf4f1 0%, #f4ece8 52%, #efe6e1 100%);
	}

	.csh-bg { position: absolute; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
	.csh-orb {
		position: absolute;
		top: -18%;
		right: -8%;
		width: 42vw;
		height: 42vw;
		border-radius: 9999px;
		filter: blur(90px);
		background: radial-gradient(circle, color-mix(in srgb, var(--c) 38%, transparent), transparent 66%);
		animation: csh-drift 24s ease-in-out infinite;
	}
	@keyframes csh-drift {
		0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
		50% { transform: translate3d(-5%, 6%, 0) scale(1.12); }
	}
	.csh-grid {
		position: absolute;
		inset: 0;
		background-image:
			repeating-linear-gradient(90deg, transparent 0 87px, color-mix(in srgb, var(--ink) 5%, transparent) 87px 88px),
			repeating-linear-gradient(180deg, transparent 0 87px, color-mix(in srgb, var(--ink) 3%, transparent) 87px 88px);
		mask-image: linear-gradient(180deg, #000, transparent 88%);
		-webkit-mask-image: linear-gradient(180deg, #000, transparent 88%);
	}

	.csh-sec { position: relative; z-index: 1; padding: clamp(1.4rem, 3vw, 2.4rem) 5% clamp(2.5rem, 5vw, 4rem); }
	.csh-sec--more { padding-top: 0; }
	.csh-wrap { max-width: 78rem; margin: 0 auto; }

	.csh-back { margin-bottom: clamp(1.2rem, 3vw, 2rem); }
	.csh-back a {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font-size: 0.82rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--faint);
		transition: color 0.25s ease, gap 0.25s ease;
	}
	.csh-back a:hover { color: var(--acc); gap: 0.7rem; }

	.csh-open {
		display: grid;
		gap: clamp(1.6rem, 3.4vw, 2.8rem);
		align-items: center;
	}
	@media (min-width: 940px) {
		.csh-open { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); }
	}
	.csh-copy { min-width: 0; }

	.csh-kick {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.7rem;
		font-weight: 800;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--acc);
		margin-bottom: 1rem;
	}
	.csh-kick i {
		width: 8px;
		height: 8px;
		border-radius: 9999px;
		background: var(--c);
		box-shadow: 0 0 10px 1px color-mix(in srgb, var(--c) 70%, transparent);
	}
	.csh-h {
		margin: 0 0 0.5rem;
		font-family: var(--serif);
		font-weight: 500;
		font-size: clamp(2.2rem, 5vw, 3.6rem);
		line-height: 1.04;
		letter-spacing: -0.02em;
	}
	.csh-tag {
		margin: 0 0 1rem;
		font-family: var(--serif);
		font-style: italic;
		font-size: clamp(1.05rem, 1.7vw, 1.35rem);
		color: color-mix(in srgb, var(--c) 55%, var(--ink));
	}
	.csh-blurb {
		margin: 0 0 1.2rem;
		max-width: 34rem;
		font-size: 1rem;
		line-height: 1.68;
		color: var(--muted);
	}
	.csh-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; margin: 0 0 1.4rem; padding: 0; }
	.csh-tags li {
		font-size: 0.76rem;
		padding: 0.24rem 0.7rem;
		border-radius: 9999px;
		border: 1px solid var(--line);
		color: var(--muted);
	}

	/* said plainly, not dressed up as content */
	.csh-note {
		display: flex;
		gap: 0.6rem;
		margin: 0 0 1.6rem;
		max-width: 34rem;
		padding: 0.85rem 1rem;
		border-radius: 0.6rem;
		border: 1px dashed color-mix(in srgb, var(--acc) 34%, transparent);
		background: color-mix(in srgb, var(--acc) 6%, transparent);
		font-size: 0.88rem;
		line-height: 1.6;
		color: var(--muted);
	}
	.csh-note :global(svg) { flex: none; margin-top: 0.15rem; color: var(--acc); }

	.csh-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.8rem; }
	.csh-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.85rem 1.5rem;
		border-radius: 9999px;
		font-size: 0.86rem;
		font-weight: 800;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: #fff;
		background: linear-gradient(96deg, var(--c), color-mix(in srgb, var(--c) 45%, #6d1440));
		box-shadow: 0 16px 36px -14px color-mix(in srgb, var(--c) 75%, transparent);
		transition: transform 0.25s ease, box-shadow 0.25s ease;
	}
	.csh-btn:hover { transform: translateY(-2px); box-shadow: 0 24px 48px -14px color-mix(in srgb, var(--c) 85%, transparent); }
	.csh-ghost {
		font-family: var(--serif);
		font-style: italic;
		font-size: 0.95rem;
		color: var(--muted);
		border-bottom: 1px solid var(--line);
		transition: color 0.25s ease, border-color 0.25s ease;
	}
	.csh-ghost:hover { color: var(--acc); border-color: var(--acc); }

	/* ── the piece, framed ── */
	.csh-frame { position: relative; margin: 0; padding-top: 1.3rem; }
	.csh-frame-wire {
		position: absolute;
		top: 0;
		left: 50%;
		width: 40px;
		height: 1.4rem;
		margin-left: -20px;
		pointer-events: none;
	}
	.csh-frame-wire::before,
	.csh-frame-wire::after {
		content: '';
		position: absolute;
		top: 0;
		bottom: 0;
		width: 1px;
		background: linear-gradient(180deg, color-mix(in srgb, var(--c) 60%, rgba(216, 178, 113, 0.9)), transparent);
		transform-origin: top center;
	}
	.csh-frame-wire::before { left: 0; transform: rotate(10deg); }
	.csh-frame-wire::after { right: 0; transform: rotate(-10deg); }
	.csh-frame-mat {
		position: relative;
		display: block;
		padding: 0.55rem;
		border-radius: 2px;
		overflow: hidden;
		background: linear-gradient(140deg, #f4e2bb 0%, #c9a05a 19%, #8d6a32 36%, #e8ce99 56%, #b8873f 74%, #f0dcae 90%, #9c7436 100%);
		box-shadow:
			inset 0 0 0 1px rgba(255, 246, 224, 0.5),
			inset 0 0 0 5px rgba(92, 64, 24, 0.26),
			0 2px 0 rgba(60, 40, 14, 0.45),
			0 30px 56px -24px rgba(0, 0, 0, 0.8);
	}
	.csh-frame-mat img { display: block; width: 100%; border-radius: 1px; }
	.csh-frame-glass {
		position: absolute;
		inset: 0.55rem;
		background: linear-gradient(116deg, rgba(255, 255, 255, 0.24) 0%, transparent 34%, transparent 68%, rgba(255, 255, 255, 0.1) 100%);
		transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.5s ease;
		pointer-events: none;
	}
	.csh-frame:hover .csh-frame-glass { transform: translateX(16%); opacity: 0.4; }
	.csh-plaque {
		display: grid;
		justify-items: center;
		gap: 0.05rem;
		margin: 0.7rem auto 0;
		width: fit-content;
		max-width: 100%;
		padding: 0.28rem 1.1rem;
		border-radius: 1px;
		background: linear-gradient(168deg, #e8cd9b 0%, #c2a061 40%, #f1ddb4 62%, #b08c4c 100%);
		box-shadow: inset 0 1px 0 rgba(255, 250, 233, 0.75), 0 5px 12px -7px rgba(0, 0, 0, 0.7);
		text-align: center;
	}
	.csh-plaque strong { font-family: var(--serif); font-size: 0.86rem; font-weight: 600; color: #3a2a10; }
	.csh-plaque span { font-family: var(--serif); font-style: italic; font-size: 0.7rem; color: rgba(58, 42, 16, 0.78); }

	/* ── also in the collection ── */
	.csh-rule {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
		padding-bottom: 0.7rem;
		margin-bottom: clamp(1.1rem, 2.4vw, 1.6rem);
		border-bottom: 1px solid var(--line);
	}
	.csh-rule span:first-child {
		font-size: 0.74rem;
		font-weight: 800;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--acc);
	}
	.csh-rule span:last-child {
		font-family: var(--serif);
		font-style: italic;
		font-size: 0.95rem;
		color: var(--faint);
	}
	.csh-more { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); }
	.csh-more-item {
		display: grid;
		gap: 0.6rem;
		color: inherit;
		transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.csh-more-item:hover { transform: translateY(-4px); }
	.csh-more-pic {
		display: block;
		border-radius: 0.4rem;
		overflow: hidden;
		border: 1px solid var(--line);
		box-shadow: 0 20px 40px -26px rgba(0, 0, 0, 0.7);
	}
	.csh-more-pic img { display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; transition: transform 0.6s ease; }
	.csh-more-item:hover .csh-more-pic img { transform: scale(1.05); }
	.csh-more-txt { display: grid; gap: 0.1rem; }
	.csh-more-txt b { font-size: 0.95rem; font-weight: 800; }
	.csh-more-txt em {
		font-family: var(--serif);
		font-style: italic;
		font-size: 0.82rem;
		color: var(--faint);
	}

	@media (prefers-reduced-motion: reduce) {
		.csh-orb { animation: none; }
	}
</style>
