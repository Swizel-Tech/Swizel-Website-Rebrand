		color: rgba(245, 245, 247, 0.62);
	}
	.bd-links--center {
		justify-content: center;
	}
	/* the phone number — impossible to miss */
	.bd-call {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.15rem;
	}
	.bd-call-hint {
