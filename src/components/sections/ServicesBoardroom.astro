	}
	.bd-cta-act {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: clamp(1rem, 2.4vw, 2rem);
		margin-top: clamp(1.5rem, 3.2vw, 2.4rem);
	}
	/* the one thing on this tile we want pressed: it breathes until it is */
	.bd-cta-go {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		min-height: 3.35rem;
		padding: 0 1.8rem;
		border-radius: 999px;
		background: linear-gradient(120deg, var(--bd-accent), #3b7dfd);
		color: #04101a;
		font-size: 1rem;
		font-weight: 700;
		white-space: nowrap;
		transition: transform 0.25s ease, filter 0.25s ease;
	}
	.bd-cta-go::after {
		content: '';
		position: absolute;
		inset: -3px;
		border-radius: inherit;
		border: 2px solid var(--bd-accent);
		opacity: 0;
		pointer-events: none;
		animation: bd-cta-ring 2.6s cubic-bezier(0.22, 1, 0.36, 1) infinite;
	}
	@keyframes bd-cta-ring {
		0%   { transform: scale(1); opacity: 0.55; }
		70%  { transform: scale(1.16); opacity: 0; }
		100% { transform: scale(1.16); opacity: 0; }
	}
	.bd-cta-go:hover { transform: translateY(-2px); filter: brightness(1.06); }
	.bd-cta-go-s { display: none; }
	.bd-cta-go:hover::after { animation-play-state: paused; opacity: 0; }

	/* the photograph, with the promise stamped in its corner */
	.bd-cta-shot {
		position: relative;
		margin: 0;
		min-height: clamp(18rem, 30vw, 27rem);
	}
	/* The picture is dissolved into the tile rather than laid on top of
	   it: a dark veil over the photograph left a visible seam wherever the
	   veil's black and the tile's own gradient disagreed, which they do
	   everywhere except one row of pixels. Masking the image instead means
	   there is nothing to match — the photograph simply stops. */
	.bd-cta-shot img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 42% 50%;
		mask-image: linear-gradient(
			90deg,
			transparent 0%,
			rgba(0, 0, 0, 0.28) 14%,
			rgba(0, 0, 0, 0.82) 38%,
			#000 62%
		);
		-webkit-mask-image: linear-gradient(
			90deg,
			transparent 0%,
			rgba(0, 0, 0, 0.28) 14%,
			rgba(0, 0, 0, 0.82) 38%,
			#000 62%
		);
	}
	/* just enough shade at the top right to hold the stamp */
	.bd-cta-shot::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(200deg, rgba(4, 6, 13, 0.5), transparent 42%);
	}
	.bd-cta-stamp {
		position: absolute;
		top: clamp(1.1rem, 2.6vw, 2.2rem);
		right: clamp(1.1rem, 2.6vw, 2.2rem);
		z-index: 1;
		text-align: right;
		font-size: 0.66rem;
		font-weight: 600;
		letter-spacing: 0.24em;
		text-transform: uppercase;
		line-height: 1.9;
		color: rgba(245, 245, 247, 0.62);
	}
	.bd-cta-stamp strong { display: block; color: #fff; font-weight: 700; }
	.bd-cta-stamp::after {
		content: '';
		display: block;
		width: 2.4rem;
		height: 1px;
		margin: 0.6rem 0 0 auto;
		background: rgba(255, 255, 255, 0.4);
	}

	@media (max-width: 860px) {
		.bd-tile--cta { grid-template-columns: 1fr; }
		/* on a phone the desk goes on top, where a photograph belongs */
		.bd-cta-shot { order: -1; min-height: clamp(12rem, 46vw, 17rem); }
		/* stacked, the photograph dissolves downward instead of sideways */
		.bd-cta-shot img {
			mask-image: linear-gradient(180deg, #000 34%, rgba(0, 0, 0, 0.5) 74%, transparent 100%);
			-webkit-mask-image: linear-gradient(180deg, #000 34%, rgba(0, 0, 0, 0.5) 74%, transparent 100%);
		}
