---
// Services hub — the Boardroom world. An "adventure" into everything Swizel
// does: each discipline is a door into its own world (per-service pages come
// next). Reuses the boardroom engine (initBoardroomBody → reveals/counters)
// and the themed cursor; locked to boardroom blue. Self-contained .bd-* styles.
import { Icon } from 'astro-icon/components';
import { disciplines } from '../../data/disciplines';
import FilmPlayer from '../FilmPlayer.astro';
import DoWall from './DoWall.astro';
import CardShuffle from '../CardShuffle.astro';

// Three figures for the floor of the opening panel.
const glance = [
	{ k: 'Disciplines', s: 'Fields', v: '6' },
	{ k: 'Products shipped', s: 'Shipped', v: '65+' },
	{ k: 'On time', s: 'On time', v: '98%' },
];
// Each discipline links to its own detail page (/services/<slug>).

const process = [
	{ n: '01', title: 'Discover', desc: 'We research, define and lock the goal together, so we build the right thing.' },
	{ n: '02', title: 'Design & build', desc: 'Design, engineer and test in tight, visible loops you can follow every week.' },
	{ n: '03', title: 'Launch & scale', desc: 'Ship it, market it, then maintain and grow what we shipped.' },
];

const stack = [
	{ group: 'Design', icon: 'mdi:palette-outline', tools: ['Figma', 'Illustrator', 'Photoshop', 'After Effects', 'Framer', 'Sketch'] },
	{ group: 'Web', icon: 'mdi:language-html5', tools: ['React', 'Next.js', 'Vue', 'Nuxt', 'Astro', 'Svelte', 'Tailwind', 'TypeScript'] },
	{ group: 'Mobile', icon: 'mdi:cellphone', tools: ['Flutter', 'React Native', 'Swift', 'Kotlin', 'Expo'] },
	{ group: 'Backend', icon: 'mdi:server-network', tools: ['Node', 'Python', 'PHP', 'Laravel', 'Django', 'Go', 'Express'] },
	{ group: 'Cloud & DevOps', icon: 'mdi:cloud-outline', tools: ['AWS', 'Vercel', 'Docker', 'Kubernetes', 'Cloudflare', 'GitHub Actions'] },
	{ group: 'Data & AI', icon: 'mdi:database-outline', tools: ['PostgreSQL', 'MongoDB', 'Redis', 'Supabase', 'OpenAI', 'Prisma'] },
	{ group: 'Commerce', icon: 'mdi:cart-outline', tools: ['Stripe', 'Shopify', 'WooCommerce', 'Paystack', 'PayPal'] },
	{ group: 'CMS & content', icon: 'mdi:file-document-edit-outline', tools: ['WordPress', 'Sanity', 'Contentful', 'Strapi', 'Webflow'] },
	{ group: 'Quality & tooling', icon: 'mdi:check-decagram-outline', tools: ['Git', 'Jest', 'Playwright', 'Storybook', 'Sentry'] },
];

// The same band the home page and /about carry: an icon, the figure, its
// label, and under it the shape that figure actually made.
const stats = [
	{ to: 65, suffix: '+', label: 'Products shipped', short: 'Shipped', icon: 'mdi:cube-outline',
	  spark: 'M0 6.4 L17 5.6 L33 4.9 L50 3.7 L67 2.7 L83 1.4 L100 0.6' },
	{ to: 98, suffix: '%', label: 'On-time delivery', short: 'On time', icon: 'mdi:clock-check-outline',
	  spark: 'M0 5.8 L17 5.2 L33 5.4 L50 3.6 L67 3 L83 1.8 L100 1.2' },
	{ to: 7, suffix: '+', label: 'Years building', short: 'Years', icon: 'mdi:calendar-blank-outline',
	  spark: 'M0 6.4 L17 5.6 L33 4.7 L50 3.9 L67 3.1 L83 2.3 L100 1.4' },
	{ to: 5, decimals: 1, suffix: '', label: 'Average rating', short: 'Rating', icon: 'mdi:star-outline',
	  spark: 'M0 1.4 L17 1.2 L33 1.4 L50 1 L67 1.4 L83 1.2 L100 1.2' },
];

const sectors = [
	'Fintech', 'Real estate', 'Sports', 'E-commerce', 'Education', 'Logistics',
	'Healthcare', 'Beauty', 'Energy', 'Agritech', 'Hospitality', 'Media',
	'Retail', 'Travel', 'Gaming', 'Legal',
];
---

<div class="bdbody bd-services view-body view-body-boardroom">
	<!-- ── Hero — split: copy + an animated disciplines panel ── -->
	<!-- ── the opening: two panels, the words beside the film ──
	     The same shape the home page and /about open on: one pale panel
	     carrying the words with the figures on its floor, one deep panel
	     carrying the film with its own words on it. The animated tile
	     panel it replaces was six links dressed as a product shot.
	     ────────────────────────────────────────────────────── -->
	<div class="ab-open">
		<article class="ab-open-panel is-pale bd-reveal">
			<div class="ab-open-copy">
				<span class="ab-kick">What we do</span>
				<h1 class="ab-h1">
					One team for the
					<em>whole journey.</em>
				</h1>
				<p class="ab-lede">
					Design, build, market and maintain. Every discipline you need to
					launch and grow, under one roof and on one contract.
				</p>
				<p class="ab-lede ab-lede--sm">
					Design, build, market and maintain. One roof, one contract.
				</p>
				<div class="ab-acts">
					<a href="/contact" class="ab-pill">Start a project</a>
					<a href="#bd-do" class="ab-more">
						Explore what we do
						<Icon width={14} name="mdi:chevron-right" />
					</a>
				</div>
			</div>
			<ul class="ab-glance" aria-label="Swizel at a glance">
				{
					glance.map((g) => (
						<li>
							<strong>{g.v}</strong>
							<span>{g.k}</span>
							<span class="ab-glance-s">{g.s}</span>
						</li>
					))
				}
			</ul>
		</article>

		<article class="ab-open-panel is-deep bd-reveal" data-cursor="video">
			<div class="ab-open-copy">
				<span class="ab-kick">Behind the code</span>
				<h2 class="ab-h2 ab-h2--panel">
					How a Swizel product
					<span>gets built.</span>
				</h2>
				<p class="ab-lede">
					Designed, engineered and shipped in tight, visible loops.
				</p>
			</div>
			<figure class="ab-screen" data-film-expand>
				<FilmPlayer
					videoId="R2jdjZwv-ZE"
					label="Behind the code: how Swizel builds digital products"
					fallback="/images/builder/at-the-keys.jpg"
					cover
				/>
				<button class="ab-screen-open" type="button" data-film-expand-btn>
					<span class="ab-screen-open-in">
						<Icon width={15} name="mdi:arrow-expand-all" />
						<span>Tap to expand</span>
					</span>
				</button>
				<figcaption class="ab-screen-badge">
					<Icon width={15} name="mdi:play-circle-outline" />
					<span>Swizel</span>
					<em>behind the code</em>
				</figcaption>
			</figure>
		</article>
	</div>

	<!-- Six disciplines — the same wall the home page and /about carry,
	     each panel a door into its own /services page -->
	<DoWall />

	<!-- ── The stack — a static, grouped capability grid ────── -->
	<section class="svc-stack bd-reveal" data-cursor="layers">
		<div class="bd-head">
			<h2 class="bd-h bd-h--center">The tools in our hands.</h2>
			<p class="bd-p bd-p--center">A modern, proven toolkit, picked for the job, not for the hype.</p>
		</div>
		{/* Nine boxes of pills is a wall of reading. The same hand of
		    playing cards the disciplines are dealt as, one card a group,
		    bigger here because a card holding eight tool names needs the
		    room. */}
		<div class="svc-deck bd-reveal">
			<CardShuffle
				variant="deck"
				label="The stack"
				every={6}
				items={stack.map((cat) => ({
					icon: cat.icon,
					title: cat.group,
					desc: cat.tools.join(' · '),
				}))}
			/>
		</div>
		<p class="svc-stack-note">…and whatever else the job calls for. We pick tools to fit your product, not our comfort zone.</p>
	</section>

	<!-- ── How we work — the journey ───────────────────────── -->
	<section class="svc-journey bd-reveal" data-cursor="branch">
		<span class="svc-journey-aurora" aria-hidden="true"></span>
		<div class="bd-head">
			<h2 class="bd-h bd-h--center">How the adventure goes.</h2>
			<p class="bd-p bd-p--center">
				The same three moves on every project, visible, predictable, yours
				to follow.
			</p>
		</div>
		<ol class="svc-steps">
			<span class="svc-steps-line" aria-hidden="true"></span>
			{
				process.map((p) => (
					<li class="svc-step">
						<span class="svc-step-n">{p.n}</span>
						<h3 class="svc-step-t">{p.title}</h3>
						<p class="svc-step-d">{p.desc}</p>
					</li>
				))
			}
		</ol>
	</section>

	<!-- ── Showreel — copy paired with the video placeholder ── -->
	<!-- ── the build reel ── -->
	<section class="svc-reel bd-reveal" data-cursor="play">
		<div class="svc-reel-grid">
			<div class="svc-reel-copy">
				<span class="bd-kicker">Inside the studio</span>
				<h2 class="bd-h">See how we build.</h2>
				<p class="bd-p">
					From first sketch to launch day, the messy, honest middle
					included.
				</p>
				<ol class="svc-reel-chapters">
					<li><span>01</span> Discovery &amp; sketches</li>
					<li><span>02</span> Design &amp; build loops</li>
					<li><span>03</span> Launch day</li>
				</ol>
			</div>
			<figure class="svc-reel-stage">
				<FilmPlayer
					src="/videos/how-we-build.mp4"
					poster="/images/how-we-build-poster.jpg"
					label="See how we build"
					tag="the build reel"
				/>
			</figure>
		</div>
	</section>

	<!-- ── Numbers — the band both other pages carry ───────── -->
	<section
		class="bd-tile bd-tile--full bd-tile--inverse bd-band bd-reveal"
		id="bd-numbers"
		data-cursor="chart"
	>
		<div class="bd-tile-copy">
			<h2 class="bd-h">
				Measured the only way that <em>matters.</em>
			</h2>
			<p class="bd-p">Seven years of shipping for ambitious businesses.</p>
		</div>
		<ul class="bd-numbers">
			{
				stats.map((n, i) => (
					<li class="bd-number" style={`--n:${i}`}>
						<span class="bd-number-ic" aria-hidden="true">
							<Icon width={20} name={n.icon} />
						</span>
						<strong data-count={n.to} data-suffix={n.suffix} data-decimals={n.decimals || 0}>
							0{n.suffix}
						</strong>
						<span class="bd-number-l">{n.label}</span>
						<span class="bd-number-s">{n.short}</span>
						<svg class="bd-trend" viewBox="0 0 100 7" preserveAspectRatio="none" aria-hidden="true">
							<path class="bd-trend-line" d={n.spark} />
						</svg>
					</li>
				))
			}
		</ul>
	</section>

	<!-- ── Sectors ─────────────────────────────────────────── -->
	<!-- Sectors — endless drift -->
	<section class="bd-sectors bd-reveal">
		<h3 class="bd-h bd-h--center">At home in your industry.</h3>
		{/* two rails, drifting against each other: one line of industries
		    reads as a list, two read as a place with traffic in it */}
		<div class="bd-marquee bd-marquee--a" aria-hidden="true">
			<div class="bd-marquee-track bd-marquee-track--sectors">
				{
					[0, 1].map(() =>
						sectors.map((s, i) => (
							<span class:list={['bd-sector', { 'is-hot': i % 3 === 1 }]}>
								<i class="bd-sector-dot" />
								{s}
							</span>
						))
					)
				}
			</div>
		</div>
		<div class="bd-marquee bd-marquee--b" aria-hidden="true">
			<div class="bd-marquee-track bd-marquee-track--sectors bd-marquee-track--back">
				{
					[0, 1].map(() =>
						[...sectors].reverse().map((s, i) => (
							<span class:list={['bd-sector', 'bd-sector--sm', { 'is-hot': i % 4 === 2 }]}>
								<i class="bd-sector-dot" />
								{s}
							</span>
						))
					)
				}
			</div>
		</div>
	</section>

	<!-- Final CTA — the desk on the right, the ask on the left.
	     The type is set live rather than baked into the picture, so it
	     reflows, it is readable to a crawler, and it can be changed
	     without opening an image editor. -->
	<section class="bd-grid">
		<div class="bd-tile bd-tile--full bd-tile--cta bd-reveal" data-cursor="phone">
			<div class="bd-cta-copy">
				<span class="bd-cta-kick"><i aria-hidden="true" />Let's connect</span>
				<h3 class="bd-display bd-display--cta">
					Tell us what you need.
					<em>We'll build it.</em>
				</h3>
				<div class="bd-cta-act">
					<a href="/contact" class="bd-cta-go">
						<Icon width={18} name="mdi:arrow-right" />
						<span class="bd-cta-go-l">Start your project</span>
						<span class="bd-cta-go-s">Start a project</span>
					</a>
					<a href="tel:+2348100204570" class="bd-call">
						<span class="bd-call-hint">or call us now</span>
						<span class="bd-call-num">
							<Icon width={22} name="mdi:phone" />
							+234 810 020 4570
						</span>
					</a>
				</div>
			</div>
			<figure class="bd-cta-shot">
				<img
					src="/images/cta/talk-business.jpg"
					alt="A Swizel desk at the end of the day"
					loading="lazy"
					decoding="async"
				/>
				<figcaption class="bd-cta-stamp">
					Bigger ideas.
					<strong>Real results.</strong>
				</figcaption>
			</figure>
		</div>
	</section>

</div>

<style>
	/* ════ Boardroom base (self-contained, mirrors AboutBoardroom) ════ */
	.bdbody {
		--bd-accent: #28a6ec;
		--bd-ink: #f4f6fb;
		--bd-muted: rgba(244, 246, 251, 0.62);
		--bd-glass: linear-gradient(160deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.02) 55%);
		--bd-glass-border: rgba(255, 255, 255, 0.1);
		--bd-shadow: 0 34px 80px -34px rgba(0, 0, 0, 0.8);
		font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
		position: relative;
		isolation: isolate;
		background:
			radial-gradient(1100px 540px at 78% -6%, color-mix(in srgb, var(--bd-accent) 13%, transparent), transparent 62%),
			radial-gradient(900px 520px at 8% 38%, rgba(58, 90, 200, 0.1), transparent 60%),
			linear-gradient(180deg, #070910 0%, #0a0d1c 45%, #05060d 100%);
		color: var(--bd-ink);
		padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1rem, 3vw, 2rem) clamp(2.5rem, 5vw, 4rem);
		transition: background 0.4s ease, color 0.4s ease;
	}
	:global(html:not(.dark)) .bdbody {
		--bd-ink: #14162a;
		--bd-muted: rgba(20, 22, 40, 0.64);
		--bd-glass: linear-gradient(160deg, rgba(255, 255, 255, 0.82), rgba(255, 255, 255, 0.55) 55%);
		--bd-glass-border: rgba(20, 22, 40, 0.1);
		--bd-shadow: 0 30px 70px -34px rgba(20, 22, 40, 0.25);
		background:
			radial-gradient(1100px 540px at 78% -6%, color-mix(in srgb, var(--bd-accent) 10%, transparent), transparent 62%),
			linear-gradient(180deg, #eef2f7 0%, #e7edf6 50%, #eef2f7 100%);
	}

	.bd-kicker { display: inline-block; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--bd-accent); margin-bottom: 1rem; }
	.bd-display { font-size: clamp(2.6rem, 6vw, 4.6rem); font-weight: 700; letter-spacing: -0.025em; line-height: 1.04; margin: 0 0 1.1rem; }
	.bd-grad {
		background: linear-gradient(110deg, #9bd8ff 0%, var(--bd-accent) 38%, #7ef0d2 64%, #9bd8ff 100%);
		background-size: 220% 100%;
		-webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
		animation: svc-grad 7s ease infinite;
	}
	@keyframes svc-grad { 0%,100%{ background-position:0% 50%; } 50%{ background-position:100% 50%; } }
	.bd-sub { font-size: clamp(1.05rem, 2vw, 1.35rem); line-height: 1.5; color: var(--bd-muted); max-width: 40rem; margin: 0 auto 1.6rem; }
	.bd-h { font-size: clamp(1.7rem, 3.4vw, 2.5rem); font-weight: 700; letter-spacing: -0.02em; line-height: 1.1; margin: 0 0 0.7rem; }
	.bd-h--center { text-align: center; }
	.bd-p { font-size: 1.02rem; line-height: 1.6; color: var(--bd-muted); max-width: 30rem; margin: 0 auto 1.2rem; }
	.bd-p--center { margin-inline: auto; text-align: center; }
	.bd-head { max-width: 56rem; margin: clamp(2.5rem, 6vw, 4rem) auto clamp(1.5rem, 3vw, 2rem); text-align: center; }

	.bd-links { display: flex; align-items: center; justify-content: center; gap: 1.4rem; flex-wrap: wrap; }
	.bd-links--center { justify-content: center; }
	.bd-pill {
		position: relative; display: inline-flex; align-items: center; padding: 0.78rem 1.5rem; border-radius: 9999px;
		background: linear-gradient(180deg, color-mix(in srgb, var(--bd-accent) 88%, #fff), var(--bd-accent) 45%, color-mix(in srgb, var(--bd-accent) 72%, #03244a));
		border: 1px solid color-mix(in srgb, var(--bd-accent) 60%, rgba(255, 255, 255, 0.4));
		color: #fff; font-size: 0.95rem; font-weight: 600; text-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35), 0 12px 28px -12px color-mix(in srgb, var(--bd-accent) 65%, transparent);
		transition: transform 0.25s ease, box-shadow 0.25s ease;
	}
	.bd-pill:hover { transform: translateY(-2px); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.4), 0 18px 38px -12px color-mix(in srgb, var(--bd-accent) 80%, transparent); }
	.bd-pill--light { background: linear-gradient(180deg, #ffffff, #dfe6f2); border-color: rgba(255, 255, 255, 0.8); color: #0b0d18; text-shadow: none; }
	.bd-link { display: inline-flex; align-items: center; gap: 0.15rem; font-size: 0.98rem; font-weight: 600; color: var(--bd-accent); transition: gap 0.25s ease; }
	.bd-link:hover { gap: 0.4rem; }
	.bd-link--invert { color: #9bd8ff; }

	.bd-grid { display: grid; gap: clamp(0.9rem, 2vw, 1.4rem); max-width: 88rem; margin: 0 auto clamp(0.9rem, 2vw, 1.4rem); }
	.bd-tile {
		position: relative; display: flex; flex-direction: column; gap: 1.4rem; text-align: center;
		padding: clamp(2rem, 4vw, 3rem) clamp(1.25rem, 3vw, 2.25rem) clamp(1.4rem, 3vw, 2rem);
		border-radius: 1.75rem; background: var(--bd-glass); border: 1px solid var(--bd-glass-border); box-shadow: var(--bd-shadow);
		backdrop-filter: blur(22px) saturate(130%); -webkit-backdrop-filter: blur(22px) saturate(130%); overflow: hidden;
	}
	.bd-tile--full { grid-column: 1 / -1; }
	.bd-tile-copy { max-width: 40rem; margin: 0 auto; }
	.bd-tile--inverse {
		background: radial-gradient(720px 320px at 50% -10%, color-mix(in srgb, var(--bd-accent) 34%, transparent), transparent 70%), linear-gradient(180deg, rgba(21, 26, 48, 0.9), rgba(5, 6, 13, 0.95));
		color: #f5f5f7; border-color: color-mix(in srgb, var(--bd-accent) 30%, rgba(255, 255, 255, 0.1));
	}
	.bd-tile--inverse .bd-p { color: rgba(245, 245, 247, 0.62); }
	/* the figures are the shared band now; see the end of this sheet */
	.bd-number strong {
		display: block; font-size: clamp(2.4rem, 5vw, 3.6rem); font-weight: 700; letter-spacing: -0.03em;
		background: linear-gradient(135deg, #9bd8ff, var(--bd-accent)); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
	}
	.bd-number span { font-size: 0.85rem; color: rgba(245, 245, 247, 0.6); }

	/* ── Hero — full-bleed bg, elegant split content ── */
	.svc-hero {
		position: relative;
		overflow: hidden;
		margin: calc(-1 * clamp(2.5rem, 6vw, 4.5rem)) calc(-1 * clamp(1rem, 3vw, 2rem)) clamp(2.5rem, 6vw, 4rem);
		padding: clamp(3.5rem, 8vw, 6rem) clamp(1rem, 3vw, 2rem) clamp(3rem, 6vw, 4.5rem);
	}
	.svc-hero-grid { position: relative; z-index: 1; max-width: 78rem; margin-inline: auto; display: grid; gap: clamp(2.5rem, 5vw, 4rem); align-items: center; }
	@media (min-width: 940px) { .svc-hero-grid { grid-template-columns: 1.05fr 0.95fr; } }
	.svc-hero-grid > * { min-width: 0; }
	.svc-hero-copy { text-align: left; min-width: 0; }
	.svc-h1 { max-width: 14ch; margin: 0 0 1.1rem; }
	.svc-hero-sub { margin: 0 0 1.6rem; }
	.svc-hero-links { justify-content: flex-start; }
	.svc-hero-aurora {
		position: absolute; inset: -30% -10%; z-index: 0; pointer-events: none;
		background:
			radial-gradient(560px 420px at 18% 26%, rgba(34, 211, 238, 0.24), transparent 60%),
			radial-gradient(620px 460px at 82% 30%, rgba(139, 92, 246, 0.22), transparent 62%),
			radial-gradient(520px 380px at 50% 100%, color-mix(in srgb, var(--bd-accent) 26%, transparent), transparent 60%);
		filter: blur(54px); opacity: 0.6; animation: svc-aurora 17s ease-in-out infinite;
	}
	:global(html:not(.dark)) .svc-hero-aurora { opacity: 0.4; }
	@keyframes svc-aurora { 0%,100%{ transform: translate3d(0,0,0) scale(1); } 50%{ transform: translate3d(2%,-2%,0) scale(1.08); } }

	/* hero disciplines panel */
	.svc-hero-panel {
		position: relative; padding: clamp(1.2rem, 2.5vw, 1.7rem); border-radius: 1.75rem;
		background: var(--bd-glass); border: 1px solid var(--bd-glass-border); box-shadow: var(--bd-shadow);
		backdrop-filter: blur(22px) saturate(130%); -webkit-backdrop-filter: blur(22px) saturate(130%);
	}
	.svc-hero-panel-top { display: flex; align-items: center; gap: 0.5rem; font-size: 0.74rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: var(--bd-muted); margin-bottom: 1rem; padding-inline: 0.2rem; }
	.svc-hero-panel-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--bd-accent); box-shadow: 0 0 0 0 color-mix(in srgb, var(--bd-accent) 55%, transparent); animation: svc-dot 2.4s ease-out infinite; }
	@keyframes svc-dot { 0%{ box-shadow: 0 0 0 0 color-mix(in srgb, var(--bd-accent) 50%, transparent); } 70%,100%{ box-shadow: 0 0 0 8px transparent; } }
	.svc-hero-tiles { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; }
	@media (max-width: 600px) { .svc-hero-tiles { grid-template-columns: 1fr; } }
	.svc-hero-tile { min-width: 0; }
	.svc-hero-tile {
		position: relative; display: flex; align-items: center; gap: 0.6rem; padding: 0.75rem 0.85rem; border-radius: 1rem;
		background: color-mix(in srgb, var(--c) 8%, transparent); border: 1px solid color-mix(in srgb, var(--c) 22%, var(--bd-glass-border));
		transition: transform 0.3s cubic-bezier(0.22,1,0.36,1), border-color 0.3s ease, background 0.3s ease;
		animation: svc-tile-float 5s ease-in-out infinite; animation-delay: calc(var(--i) * 0.4s);
	}
	.svc-hero-tile:hover { transform: translateY(-3px); background: color-mix(in srgb, var(--c) 16%, transparent); border-color: color-mix(in srgb, var(--c) 45%, transparent); }
	@keyframes svc-tile-float { 0%,100%{ transform: translateY(0); } 50%{ transform: translateY(-4px); } }
	.svc-hero-tile-ic { display: grid; place-items: center; width: 34px; height: 34px; flex-shrink: 0; border-radius: 0.65rem; color: var(--c); background: color-mix(in srgb, var(--c) 16%, transparent); border: 1px solid color-mix(in srgb, var(--c) 30%, transparent); }
	.svc-hero-tile-name { flex: 1; font-size: 0.92rem; font-weight: 700; letter-spacing: -0.01em; color: var(--bd-ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
	.svc-hero-tile-go { color: var(--c); flex-shrink: 0; opacity: 0; transform: translateX(-4px); transition: opacity 0.25s ease, transform 0.25s ease; }
	.svc-hero-tile:hover .svc-hero-tile-go { opacity: 1; transform: translateX(0); }

	/* ── Discipline doors ── */
	.svc-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1rem, 2vw, 1.5rem); max-width: 84rem; margin: 0 auto; }
	@media (max-width: 940px) { .svc-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
	@media (max-width: 600px) { .svc-grid { grid-template-columns: 1fr; } }
	.svc-card {
		position: relative; display: flex; flex-direction: column; align-items: flex-start; overflow: hidden;
		padding: clamp(1.75rem, 3vw, 2.4rem); border-radius: 1.5rem; background: var(--bd-glass);
		border: 1px solid var(--bd-glass-border); box-shadow: var(--bd-shadow);
		backdrop-filter: blur(20px) saturate(130%); -webkit-backdrop-filter: blur(20px) saturate(130%);
		transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.4s ease, box-shadow 0.4s ease;
	}
	.svc-card:hover { transform: translateY(-8px); border-color: color-mix(in srgb, var(--c) 55%, var(--bd-glass-border)); box-shadow: 0 44px 90px -34px color-mix(in srgb, var(--c) 40%, rgba(0,0,0,0.85)); }
	.svc-card-glow { position: absolute; inset: -40% 30% auto -20%; height: 70%; z-index: -1; background: radial-gradient(closest-side, color-mix(in srgb, var(--c) 38%, transparent), transparent); filter: blur(30px); opacity: 0; transition: opacity 0.45s ease; pointer-events: none; }
	.svc-card:hover .svc-card-glow { opacity: 0.9; }
	.svc-card-n { position: absolute; top: 1.1rem; right: 1.3rem; font-size: 0.95rem; font-weight: 800; letter-spacing: 0.1em; color: color-mix(in srgb, var(--c) 70%, transparent); }
	.svc-card-ic {
		display: grid; place-items: center; width: 60px; height: 60px; border-radius: 1.1rem; margin-bottom: 1.2rem;
		background: linear-gradient(135deg, color-mix(in srgb, var(--c) 30%, transparent), color-mix(in srgb, var(--c) 8%, transparent));
		border: 1px solid color-mix(in srgb, var(--c) 40%, transparent); color: var(--c); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2);
	}
	.svc-card-title { font-size: 1.5rem; font-weight: 700; letter-spacing: -0.015em; margin: 0 0 0.3rem; }
	.svc-card-tag { font-size: 0.98rem; font-weight: 600; color: color-mix(in srgb, var(--c) 75%, var(--bd-ink)); margin: 0 0 0.7rem; }
	.svc-card-desc { font-size: 0.95rem; line-height: 1.55; color: var(--bd-muted); margin: 0 0 1.1rem; }
	.svc-card-items { list-style: none; padding: 0; margin: 0 0 1.4rem; display: flex; flex-wrap: wrap; gap: 0.4rem 0.9rem; }
	.svc-card-items li { display: inline-flex; align-items: center; gap: 0.3rem; font-size: 0.82rem; font-weight: 600; color: color-mix(in srgb, var(--bd-ink) 70%, transparent); }
	.svc-card-items :global(svg) { color: var(--c); }
	.svc-card-go {
		margin-top: auto;
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.62rem 1.25rem;
		border-radius: 9999px;
		font-size: 0.95rem;
		font-weight: 700;
		color: var(--c);
		border: 1.5px solid color-mix(in srgb, var(--c) 55%, transparent);
		background: color-mix(in srgb, var(--c) 12%, transparent);
		transition: background 0.3s ease, color 0.3s ease, border-color 0.3s ease, gap 0.25s ease, transform 0.25s ease;
	}
	.svc-card-go :global(svg) { transition: transform 0.25s ease; }
	.svc-card:hover .svc-card-go {
		gap: 0.65rem;
		background: var(--c);
		color: #06121a;
		border-color: var(--c);
		box-shadow: 0 14px 30px -10px color-mix(in srgb, var(--c) 70%, transparent);
	}
	.svc-card:hover .svc-card-go :global(svg) { transform: translateX(2px); }

	/* ── Journey / process ── */
	.svc-journey { position: relative; overflow: hidden; max-width: 72rem; margin: clamp(2.5rem, 6vw, 4rem) auto; padding: clamp(2rem, 5vw, 3.5rem) clamp(1rem, 3vw, 2rem); border-radius: 2rem; isolation: isolate; }
	.svc-journey-aurora {
		position: absolute; inset: 0; z-index: -1; pointer-events: none;
		background: radial-gradient(600px 300px at 20% 0%, rgba(225, 29, 72, 0.14), transparent 60%), radial-gradient(600px 320px at 90% 100%, color-mix(in srgb, var(--bd-accent) 16%, transparent), transparent 62%);
		filter: blur(30px); opacity: 0.7; animation: svc-aurora 20s ease-in-out infinite;
	}
	.svc-steps { position: relative; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1rem, 2.5vw, 1.75rem); }
	.svc-steps-line { position: absolute; top: 38px; left: 12%; right: 12%; height: 2px; background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--bd-accent) 55%, transparent), transparent); z-index: 0; }
	@media (max-width: 720px) { .svc-steps { grid-template-columns: 1fr; } .svc-steps-line { display: none; } }
	.svc-step { position: relative; z-index: 1; padding: 1.6rem 1.4rem; border-radius: 1.25rem; background: var(--bd-glass); border: 1px solid var(--bd-glass-border); box-shadow: var(--bd-shadow); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); text-align: center; transition: transform 0.35s ease, border-color 0.35s ease; }
	.svc-step:hover { transform: translateY(-4px); border-color: color-mix(in srgb, var(--bd-accent) 40%, var(--bd-glass-border)); }
	.svc-step-n { display: grid; place-items: center; width: 46px; height: 46px; margin: 0 auto 0.9rem; border-radius: 9999px; font-weight: 800; font-size: 1.05rem; color: #fff; background: linear-gradient(135deg, color-mix(in srgb, var(--bd-accent) 90%, #fff), var(--bd-accent)); box-shadow: 0 10px 24px -10px color-mix(in srgb, var(--bd-accent) 70%, transparent); }
	.svc-step-t { font-size: 1.15rem; font-weight: 700; margin: 0 0 0.35rem; }
	.svc-step-d { font-size: 0.9rem; line-height: 1.55; color: var(--bd-muted); margin: 0; }

	/* ── Showreel — copy paired with the video placeholder ── */
	.svc-reel { max-width: 78rem; margin: clamp(2.5rem, 6vw, 4rem) auto; }
	.svc-reel-grid { display: grid; gap: clamp(1.5rem, 3vw, 2.75rem); align-items: center; }
	@media (min-width: 860px) { .svc-reel-grid { grid-template-columns: 0.78fr 1.22fr; } }
	.svc-reel-copy { text-align: left; }
	.svc-reel-copy .bd-h { margin: 0.3rem 0 0.6rem; }
	.svc-reel-copy .bd-p { margin: 0 0 1.3rem; max-width: 26rem; }
	.svc-reel-chapters { list-style: none; margin: 0 0 1.2rem; padding: 0; display: grid; gap: 0.55rem; }
	.svc-reel-chapters li { display: flex; align-items: center; gap: 0.7rem; font-size: 0.92rem; font-weight: 600; color: var(--bd-ink); }
	.svc-reel-chapters span { display: inline-grid; place-items: center; width: 26px; height: 26px; flex-shrink: 0; border-radius: 0.55rem; font-size: 0.72rem; font-weight: 800; color: var(--bd-accent); background: color-mix(in srgb, var(--bd-accent) 14%, transparent); border: 1px solid color-mix(in srgb, var(--bd-accent) 28%, transparent); }
	.svc-reel-meta { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.82rem; font-weight: 600; color: var(--bd-muted); }
	.svc-reel-meta :global(svg) { color: var(--bd-accent); }
	.svc-reel-frame {
		position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.5rem;
		aspect-ratio: 16 / 9; border-radius: 1.75rem; overflow: hidden; cursor: pointer;
		border: 1.5px dashed color-mix(in srgb, var(--bd-accent) 38%, transparent);
		background:
			radial-gradient(700px 320px at 50% 0%, color-mix(in srgb, var(--bd-accent) 18%, transparent), transparent 65%),
			linear-gradient(180deg, rgba(18, 22, 42, 0.7), rgba(5, 6, 13, 0.85));
		color: var(--bd-muted);
		box-shadow: var(--bd-shadow);
	}
	:global(html:not(.dark)) .svc-reel-frame { background: radial-gradient(700px 320px at 50% 0%, color-mix(in srgb, var(--bd-accent) 14%, transparent), transparent 65%), linear-gradient(180deg, rgba(255, 255, 255, 0.72), rgba(255, 255, 255, 0.44)); }
	.svc-reel-gridlines { position: absolute; inset: 0; pointer-events: none; opacity: 0.5; background-image: linear-gradient(color-mix(in srgb, var(--bd-accent) 12%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--bd-accent) 12%, transparent) 1px, transparent 1px); background-size: 42px 42px; -webkit-mask-image: radial-gradient(closest-side at 50% 45%, #000, transparent); mask-image: radial-gradient(closest-side at 50% 45%, #000, transparent); }
	.svc-reel-sheen { position: absolute; inset: 0; background: linear-gradient(115deg, transparent 35%, rgba(255, 255, 255, 0.06) 50%, transparent 64%); transform: translateX(-100%); animation: svc-sheen 6s ease-in-out infinite; pointer-events: none; }
	@keyframes svc-sheen { 0%, 55% { transform: translateX(-100%); } 85%, 100% { transform: translateX(100%); } }
	.svc-reel-play {
		position: relative; display: grid; place-items: center; width: 78px; height: 78px; border-radius: 9999px; cursor: pointer; color: #fff;
		background: linear-gradient(180deg, color-mix(in srgb, var(--bd-accent) 90%, #fff), var(--bd-accent));
		border: 1px solid color-mix(in srgb, var(--bd-accent) 60%, rgba(255, 255, 255, 0.4));
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35), 0 20px 44px -14px color-mix(in srgb, var(--bd-accent) 70%, transparent);
		transition: transform 0.25s ease; margin-bottom: 0.3rem;
	}
	.svc-reel-play::after { content: ''; position: absolute; inset: -10px; border-radius: 9999px; border: 1.5px solid color-mix(in srgb, var(--bd-accent) 45%, transparent); animation: svc-ping 2.6s ease-out infinite; }
	@keyframes svc-ping { 0%{ transform: scale(0.85); opacity: 0.8; } 100%{ transform: scale(1.5); opacity: 0; } }
	.svc-reel-frame:hover .svc-reel-play { transform: scale(1.08); }
	.svc-reel-label { position: relative; font-size: 0.76rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; }

	/* ── Stack + sectors marquees ── */
	.bd-marquee { overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
	.bd-marquee-track { display: flex; align-items: center; width: max-content; }
	.bd-marquee-track--stack { animation: svc-drift 34s linear infinite; }
	.bd-marquee-track--sectors { animation: svc-drift 40s linear infinite; }
	.bd-marquee:hover .bd-marquee-track { animation-play-state: paused; }
	@keyframes svc-drift { to { transform: translateX(-50%); } }
	.svc-stack { max-width: 78rem; margin: clamp(4rem, 9vw, 7rem) auto 0; text-align: center; }
	.svc-stack-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(0.9rem, 2vw, 1.4rem); text-align: left; }
	@media (max-width: 820px) { .svc-stack-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
	@media (max-width: 520px) { .svc-stack-grid { grid-template-columns: 1fr; } }
	.svc-stack-cat { padding: clamp(1.2rem, 2.5vw, 1.6rem); border-radius: 1.2rem; background: var(--bd-glass); border: 1px solid var(--bd-glass-border); box-shadow: var(--bd-shadow); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); transition: transform 0.3s ease, border-color 0.3s ease; }
	.svc-stack-cat:hover { transform: translateY(-3px); border-color: color-mix(in srgb, var(--bd-accent) 38%, var(--bd-glass-border)); }
	.svc-stack-head { display: flex; align-items: center; gap: 0.55rem; margin-bottom: 1rem; }
	.svc-stack-ic { display: grid; place-items: center; width: 32px; height: 32px; flex-shrink: 0; border-radius: 0.65rem; color: var(--bd-accent); background: color-mix(in srgb, var(--bd-accent) 14%, transparent); border: 1px solid color-mix(in srgb, var(--bd-accent) 28%, transparent); }
	.svc-stack-label { font-size: 0.72rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--bd-ink); }
	.svc-stack-count { margin-left: auto; font-size: 0.72rem; font-weight: 800; color: color-mix(in srgb, var(--bd-accent) 90%, var(--bd-ink)); background: color-mix(in srgb, var(--bd-accent) 12%, transparent); border-radius: 9999px; padding: 0.1rem 0.5rem; }
	.svc-stack-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
	.svc-chip { padding: 0.4rem 0.85rem; border-radius: 9999px; border: 1px solid color-mix(in srgb, var(--bd-ink) 14%, transparent); background: color-mix(in srgb, var(--bd-ink) 4%, transparent); font-size: 0.86rem; font-weight: 600; color: color-mix(in srgb, var(--bd-ink) 82%, transparent); transition: border-color 0.25s ease, color 0.25s ease, transform 0.2s ease, background 0.25s ease; }
	.svc-chip:hover { transform: translateY(-2px); border-color: color-mix(in srgb, var(--bd-accent) 45%, transparent); background: color-mix(in srgb, var(--bd-accent) 10%, transparent); color: var(--bd-ink); }
	.svc-stack-cat:hover .svc-chip { border-color: color-mix(in srgb, var(--bd-accent) 26%, transparent); }
	.svc-stack-note { max-width: 40rem; margin: clamp(1.5rem, 3vw, 2rem) auto 0; text-align: center; font-size: 0.92rem; font-style: italic; color: var(--bd-muted); }
	.bd-sectors { max-width: 88rem; margin: clamp(4rem, 9vw, 7rem) auto clamp(2.5rem, 6vw, 4rem); text-align: center; }
	.bd-sectors .bd-h { margin-bottom: 1.4rem; }
	.bd-sector { flex-shrink: 0; margin-right: clamp(1.6rem, 3vw, 2.8rem); font-size: clamp(1.2rem, 2.4vw, 1.7rem); font-weight: 700; letter-spacing: -0.01em; color: color-mix(in srgb, var(--bd-ink) 34%, transparent); transition: color 0.3s ease; cursor: default; }
	.bd-sector:hover { color: var(--bd-accent); }

	/* ── CTA ── */
	.bd-tile--cta {
		background: radial-gradient(820px 380px at 50% 130%, color-mix(in srgb, var(--bd-accent) 38%, transparent), transparent 72%), linear-gradient(180deg, rgba(18, 22, 42, 0.92), rgba(5, 6, 13, 0.96));
		color: #f5f5f7; border-color: color-mix(in srgb, var(--bd-accent) 26%, rgba(255, 255, 255, 0.1)); padding-block: clamp(3rem, 6vw, 5rem);
	}
	.bd-display--cta { font-size: clamp(2.2rem, 5vw, 3.8rem); }
	.bd-tile--cta .bd-sub { color: rgba(245, 245, 247, 0.62); }
	.bd-call { display: flex; flex-direction: column; align-items: center; gap: 0.2rem; margin-top: 1.6rem; }
	.bd-call-hint { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(245, 245, 247, 0.5); }
	.bd-call-num {
		display: inline-flex; align-items: center; gap: 0.7rem; font-size: clamp(1.8rem, 4.5vw, 3.2rem); font-weight: 700; letter-spacing: -0.02em;
		background: linear-gradient(135deg, #ffffff, #9bd8ff 60%, var(--bd-accent)); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
	}
	.bd-call-num :global(svg) { color: var(--bd-accent); -webkit-text-fill-color: initial; }

	/* ── Reveal ── */
	.bd-reveal { opacity: 0; transform: translateY(26px); transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.22, 1, 0.36, 1); }
	.bd-reveal.is-on { opacity: 1; transform: translateY(0); }
	@media (prefers-reduced-motion: reduce) {
		.bd-reveal { opacity: 1; transform: none; transition: none; }
		.svc-hero-aurora, .svc-journey-aurora, .bd-marquee-track, .bd-grad, .svc-reel-sheen,
		.svc-hero-tile, .svc-hero-panel-dot, .svc-reel-play::after { animation: none; }
		.bd-marquee { overflow-x: auto; }
		.svc-card:hover, .svc-step:hover, .svc-hero-tile:hover { transform: none; }
	}

	/* ═══ shared with the home page and /about ═════════════════════════
	   The opening two-up, the numbers band, the sectors rails and the
	   closing tile are the same objects on all three pages. Lifted rather
	   than re-written, and kept at the end of the sheet where source order
	   settles them against the older .svc- rules above.
	   ══════════════════════════════════════════════════════════════════ */
	/* ── the numbers band ──────────────────────────────────────────────
	   It spans the page rather than sitting inside the 88rem grid: five
	   figures deserve the width, and the band is what separates the story
	   above it from the proof below. The body's own side padding is given
	   back with a negative margin, which is exact and, unlike 100vw,
	   cannot open a scrollbar of its own. */
	.bd-band {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		max-width: none;
		width: auto;
		margin-inline: calc(-1 * clamp(1rem, 3vw, 2rem));
		margin-block: clamp(1.2rem, 2.6vw, 2rem) clamp(0.9rem, 2vw, 1.4rem);
		border-radius: clamp(1rem, 2vw, 1.6rem);
		padding-inline: clamp(1.2rem, 4vw, 3.4rem);
		padding-block: clamp(1.6rem, 3vw, 2.5rem);
		/* deeper than the rest of the body on purpose: this band is the
		   quiet beat between the story above it and the proof below */
		background:
			radial-gradient(900px 320px at 50% -24%, color-mix(in srgb, var(--bd-accent) 13%, transparent), transparent 70%),
			linear-gradient(180deg, #05070f 0%, #02030a 100%);
		border-color: rgba(155, 216, 255, 0.1);
	}
	/* the heading is a label here, not a headline: the figures are the
	   thing being looked at */
	.bd-band .bd-h {
		font-size: clamp(1.35rem, 2.5vw, 2rem);
		letter-spacing: -0.03em;
		margin: 0;
	}
	.bd-band .bd-p {
		margin: 0.45rem auto 0;
		max-width: 40rem;
		font-size: clamp(0.82rem, 1vw, 0.92rem);
		line-height: 1.55;
	}
	/* the accent falls on one word, which is the only ornament the
	   heading needs */
	.bd-band .bd-h em {
		font-style: normal;
		background: linear-gradient(120deg, #cfeaff 5%, var(--bd-accent) 75%);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}
	.bd-numbers {
		display: grid;
		/* however many figures there are, not always five: with four the
		   fixed five-column grid left an empty column and the row sat
		   off-centre in its own band */
		grid-auto-flow: column;
		grid-auto-columns: minmax(0, 1fr);
		gap: clamp(0.5rem, 1.1vw, 0.85rem);
		list-style: none;
		margin: clamp(1.1rem, 2.4vw, 1.6rem) 0 0;
		padding: 0;
	}
	/* Five cards, each one hairline, icon, figure, label and the shape it
	   made. Nothing is filled, nothing glows: the only movement is the
	   figure counting and the line drawing itself. */
	.bd-number {
		min-width: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		padding: clamp(0.85rem, 1.7vw, 1.15rem) clamp(0.55rem, 1.2vw, 0.9rem)
			clamp(0.6rem, 1.3vw, 0.85rem);
		border-radius: clamp(0.65rem, 1.1vw, 0.85rem);
		border: 1px solid rgba(155, 216, 255, 0.095);
		background: rgba(255, 255, 255, 0.014);
		transition: border-color 0.35s ease, background 0.35s ease,
			transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.bd-number:hover {
		border-color: color-mix(in srgb, var(--bd-accent) 38%, transparent);
