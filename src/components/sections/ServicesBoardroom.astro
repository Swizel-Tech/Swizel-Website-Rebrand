		   back its outer padding, the label shortens, and the arrow goes */
		.bd-cta-copy { padding-inline: 1rem; }
		.bd-cta-act {
			flex-wrap: nowrap;
			/* the number is the loudest thing on this row now, so it gets
			   air between it and the button rather than sitting against it */
			gap: 1rem;
			margin-top: 1.2rem;
		}
		.bd-cta-go {
			min-height: 2.9rem;
			padding: 0 0.95rem;
			font-size: 0.86rem;
			gap: 0;
			flex: 0 1 auto;
			min-width: 0;
		}
		.bd-cta-go :global(svg) { display: none; }
		/* scoped to the button, because the plain-class default for these
		   two is written further down the sheet and would otherwise win */
		.bd-cta-go .bd-cta-go-l { display: none; }
		.bd-cta-go .bd-cta-go-s { display: inline; }
		/* the stamp sits off the edge of a one-column tile, and the tile
		   clips it; the promise is already in the headline */
		.bd-cta-stamp { display: none; }
		.bd-call { flex: 0 1 auto; min-width: 0; }
		.bd-call-hint { display: none; }
		.bd-call-num {
			font-size: 1.22rem;
			font-weight: 900;
			letter-spacing: -0.01em;
			gap: 0.35rem;
			white-space: nowrap;
		}
		.bd-call-num :global(svg) { width: 16px; height: 16px; }
	}
	/* On the narrowest phones the pair still ran past the edge of the
	   tile, which quietly clipped the last four digits. The handset icon
	   goes — beside a button that says "start a project", a number needs
	   no explaining — and both come down one more step. Measured to clear
	   the tile by 30px at 360 rather than sitting on the edge. */
	@media (max-width: 460px) {
		.bd-cta-go { font-size: 0.78rem; padding: 0 0.8rem; min-height: 2.7rem; }
		.bd-call-num { font-size: 1.1rem; }
		.bd-call-num :global(svg) { display: none; }
	}

	/* ── the opening two-up ──
