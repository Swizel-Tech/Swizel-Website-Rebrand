---
// Case study · Campus world — the launch as a gold-star project write-up.
// Same data as every other case study telling (story, challenge, approach,
// highlights, results, gallery, quote, press, next), tinted by the
// project's colour and dressed as school: an assignment header, the brief
// on the whiteboard, a marked lesson plan, sticker highlights, a scoreboard,
// the class scrapbook and the teacher's comment. Root carries `cbody`
// (campus engine: .cp-rev + [data-count]) and `ccs` (motion engine: tilt /
// glare / magnetic / .fa-journey draw).
import { Icon } from 'astro-icon/components';
import type { Project } from '../../data/projects';

interface Props {
	project: Project;
	others: Project[];
}
const { project: p, others } = Astro.props;
const cs = p.caseStudy!;

// only real media makes the scrapbook; an empty slot is simply not shown
const shots = cs.gallery.filter((g) => g.src);
const galVideo = shots.find((g) => g.kind === 'video');
const galImages = shots.filter((g) => g.kind !== 'video');
// three across when the count divides by three, two otherwise
const hlCols = cs.highlights.length % 3 === 0 ? 3 : 2;
const heroBadges = cs.results.slice(0, 2);
---

<div class="ccs cbody view-body view-body-campus" style={`--c:${p.color}`}>
	<!-- ── A · the assignment header ───────────────────────── -->
	<section class="cc-sec" data-cursor="book">
		<div class="cc-wrap cc-open">
			<div class="cc-copy cp-rev">
				<div class="cc-backrow">
					<button class="cc-back" type="button" data-go-back>
						<Icon width={15} name="mdi:arrow-left" />
						Back
					</button>
					<a class="cc-back cc-back--alt" href="/portfolio">
						<Icon width={15} name="mdi:trophy-outline" />
						View the cabinet
					</a>
				</div>
				<span class="cc-badge">⭐ Gold-star project · {cs.meta.year}</span>
				<h2 class="cc-h cc-h--xl">{p.name}<em>.</em></h2>
				<p class="cc-tagline">{p.tagline}</p>
				<p class="cc-p">{cs.intro}</p>
				<div class="cc-label cp-rev">
					<i><b>Client</b>{cs.meta.client}</i>
					<i><b>Subject</b>{cs.meta.sector}</i>
					<i><b>Scope</b>{cs.meta.scope}</i>
				</div>
				<div class="cc-row">
					{
						cs.liveUrl && (
							<a
								href={cs.liveUrl}
								target="_blank"
								rel="noopener noreferrer"
								data-leaving=""
								data-leaving-name={p.name}
								class="cc-cta fa-cta"
							>
								<Icon width={16} name="mdi:open-in-new" />
								See it live
							</a>
						)
					}
					<a href="/contact" class="cc-link">
						Start your own
						<Icon width={15} name="mdi:arrow-right" />
					</a>
				</div>
			</div>

			<!-- the project, pinned up with its grade -->
			<figure class="cc-piece cp-rev" data-fa-tilt="4">
				<span class="cc-pin" aria-hidden="true"></span>
				<span class="cc-glare" aria-hidden="true"></span>
				<a
					class="cc-frame"
					href={cs.liveUrl ?? undefined}
					target={cs.liveUrl ? '_blank' : undefined}
					rel={cs.liveUrl ? 'noopener noreferrer' : undefined}
					data-leaving={cs.liveUrl ? '' : undefined}
					data-leaving-name={cs.liveUrl ? p.name : undefined}
					aria-label={p.name}
				>
					<img src={p.img} alt={p.name} loading="eager" />
				</a>
				<span class="cc-grade-stamp" aria-hidden="true">A+</span>
				{
					heroBadges.map((r, i) => (
						<span class:list={['cc-float', `cc-float--${i}`]}>
							<strong>{r.stat}</strong>
							<em>{r.label}</em>
						</span>
					))
				}
				<figcaption class="cc-tape">
					<strong>{p.name} · {cs.meta.year}</strong>
					<em>{cs.meta.sector}</em>
				</figcaption>
			</figure>
		</div>
	</section>

	<!-- ── B · the brief (on the whiteboard) ───────────────── -->
	<section class="cc-sec" data-cursor="pen">
		<div class="cc-wrap">
			<div class="cc-head cp-rev">
				<span class="cc-kick">📋 The assignment</span>
				<h2 class="cc-h">What the client <em>asked for.</em></h2>
			</div>
			<div class="cc-board cp-rev" data-fa-tilt="3">
				<p class="cc-board-title">the brief <span class="cc-board-swish" aria-hidden="true"></span></p>
				<p class="cc-board-text">{cs.challenge}</p>
			</div>
		</div>
	</section>

	<!-- ── C · how we solved it (lesson plan) ──────────────── -->
	<section class="cc-sec" data-cursor="pen">
		<div class="cc-wrap">
			<div class="cc-head cp-rev">
				<span class="cc-kick">✏️ Our working</span>
				<h2 class="cc-h">Show your <em>work.</em></h2>
			</div>
			<div class="cc-steps fa-journey">
				<span class="cc-spine" aria-hidden="true"></span>
				{
					cs.approach.map((a, i) => (
						<article class="cc-step cp-rev" style={`--i:${i}`}>
							<span class="cc-step-node" aria-hidden="true" />
							<span class="cc-step-n">{i + 1}.</span>
							<div>
								<h3 class="cc-step-t">{a.title}</h3>
								<p class="cc-step-d">{a.desc}</p>
							</div>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<!-- ── D · the best bits (highlights) ──────────────────── -->
	<section class="cc-sec" data-cursor="layers">
		<div class="cc-wrap">
			<div class="cc-head cp-rev">
				<span class="cc-kick">🌟 The best bits</span>
				<h2 class="cc-h">Extra credit, <em>earned.</em></h2>
			</div>
			<div class="cc-hl" style={`--cols:${hlCols}`}>
				{
					cs.highlights.map((h, i) => (
						<article class="cc-hl-card cp-rev" style={`--i:${i % 2}`} data-fa-tilt="7">
							<span class="cc-glare" aria-hidden="true" />
							<span class="cc-hl-star" aria-hidden="true">⭐</span>
							<h3>{h.title}</h3>
							<p>{h.desc}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<!-- ── E · the scoreboard (results) ────────────────────── -->
	<section class="cc-sec" data-cursor="repo">
		<div class="cc-wrap">
			<div class="cc-head cp-rev">
				<span class="cc-kick">🏅 The scoreboard</span>
				<h2 class="cc-h">What it did <em>in the world.</em></h2>
			</div>
			<ul class="cc-results cp-rev">
				{
					cs.results.map((r) => (
						<li>
							<strong>{r.stat}</strong>
							<span>{r.label}</span>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<!-- ── F · the class scrapbook (gallery) ───────────────── -->
	{
		shots.length > 0 && (
			<section class="cc-sec" data-cursor="play">
				<div class="cc-wrap">
					<div class="cc-head cp-rev">
						<span class="cc-kick">📸 The scrapbook</span>
						<h2 class="cc-h">Pics or it didn't <em>happen.</em></h2>
					</div>
					<div class="cc-media cp-rev" style={`--n:${Math.min(galImages.length + (galVideo ? 1 : 0), 3)}`}>
						{galVideo && (
							<figure class="cc-mframe cc-mframe--wide">
								<video src={galVideo.src} muted loop playsinline autoplay />
								<figcaption>{galVideo.label}</figcaption>
							</figure>
						)}
						{galImages.map((g) => (
							<figure class="cc-mframe">
								<img src={g.src} alt={g.caption || g.label} loading="lazy" />
								<figcaption>{g.caption || g.label}</figcaption>
							</figure>
						))}
					</div>
				</div>
			</section>
		)
	}

	<!-- ── G · the teacher's comment (quote) ───────────────── -->
	{
		cs.quote && (
			<section class="cc-sec" data-cursor="quote">
				<div class="cc-wrap">
					<figure class="cc-note cp-rev" data-fa-tilt="4">
						<span class="cc-note-pin" aria-hidden="true" />
						<span class="cc-note-k">Client's comment ✍️</span>
						<blockquote>
							<p>“{cs.quote.text}”</p>
							<footer>— {cs.quote.who}</footer>
						</blockquote>
					</figure>
				</div>
			</section>
		)
	}

	<!-- ── H · in the school paper (press) ─────────────────── -->
	{
		cs.press && cs.press.items.length > 0 && (
			<section class="cc-sec" data-cursor="repo">
				<div class="cc-wrap">
					<div class="cc-head cp-rev">
						<span class="cc-kick">📰 In the paper</span>
						<h2 class="cc-h">{cs.press.intro || 'Word got around.'}</h2>
					</div>
					<ul class="cc-press">
						{cs.press.items.map((it, i) => {
							const Tag = it.url ? 'a' : 'div';
							return (
								<li class="cp-rev" style={`--i:${i}`}>
									<Tag
										class="cc-press-row"
										href={it.url || undefined}
										target={it.url ? '_blank' : undefined}
										rel={it.url ? 'noopener noreferrer' : undefined}
									>
										<span class="cc-press-outlet">{it.outlet}</span>
										<span class="cc-press-title">{it.title}</span>
										<span class="cc-press-date">{it.date || 'coming'}</span>
										{it.url && <Icon width={15} name="mdi:arrow-top-right" />}
									</Tag>
								</li>
							);
						})}
					</ul>
				</div>
			</section>
		)
	}

	<!-- ── I · more gold stars + the bell ──────────────────── -->
	<section class="cc-sec cc-sec--last" data-cursor="phone">
		<div class="cc-wrap">
			<div class="cc-others cp-rev">
				<span class="cc-others-h">⭐ More gold-star projects</span>
				<div class="cc-others-grid">
					{
						others.slice(0, 3).map((o) => (
							<a href={`/work/${o.slug}`} class="cc-other" style={`--oc:${o.color}`}>
								<span class="cc-other-frame">
									<img src={o.img} alt={o.name} loading="lazy" />
								</span>
								<span class="cc-other-tape">
									<strong>{o.name}</strong>
									<em>{o.caseStudy?.meta.sector} · {o.year}</em>
								</span>
							</a>
						))
					}
				</div>
			</div>
			<div class="cc-ctabox cp-rev">
				<span class="cc-badge">🔔 The bell rang</span>
				<h2 class="cc-h cc-h--cta">Your project could <em>earn the star.</em></h2>
				<p class="cc-p cc-p--center">
					Every write-up here started as somebody's rough idea. Bring
					yours — we design it, build it, ship it, and grow it.
				</p>
				<div class="cc-row cc-row--center">
					<a href="/contact" class="cc-cta fa-cta">
						Start your project
						<Icon width={17} name="mdi:arrow-right" />
					</a>
					<a href="tel:+2348100204570" class="cc-call">
						or call <strong>+234 810 020 4570</strong>
					</a>
				</div>
			</div>
		</div>
	</section>
</div>

<style>
	/* ── Campus case study — school dress, tinted by the project. ── */
	.ccs {
		--cp-ink: #fdf6ea;
		--cp-muted: rgba(253, 246, 234, 0.62);
		--cp-faint: rgba(253, 246, 234, 0.4);
		--cp-line: rgba(255, 255, 255, 0.09);
		--cp-card: rgba(255, 255, 255, 0.035);
		--cp-marker: 'Bradley Hand', 'Segoe Print', 'Comic Sans MS', cursive;
		font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
		position: relative;
		isolation: isolate;
		overflow: hidden;
		background:
			radial-gradient(1000px 540px at 82% -6%, color-mix(in srgb, var(--c) 13%, transparent), transparent 62%),
			radial-gradient(820px 480px at 6% 44%, rgba(251, 113, 133, 0.06), transparent 60%),
			linear-gradient(180deg, #120c04 0%, #160f08 50%, #0e0903 100%);
		color: var(--cp-ink);
		padding: clamp(2rem, 4vw, 3rem) clamp(1rem, 3vw, 2rem) clamp(2.5rem, 5vw, 4rem);
		transition: background 0.4s ease, color 0.4s ease;
	}
	:global(html:not(.dark)) .ccs {
		--cp-ink: #2b1c08;
		--cp-muted: rgba(43, 28, 8, 0.68);
		--cp-faint: rgba(43, 28, 8, 0.46);
		--cp-line: rgba(43, 28, 8, 0.1);
		--cp-card: rgba(43, 28, 8, 0.045);
		background:
			radial-gradient(1000px 540px at 82% -6%, color-mix(in srgb, var(--c) 10%, transparent), transparent 62%),
			linear-gradient(180deg, #fdf4e3 0%, #faecd4 55%, #fdf4e3 100%);
	}

	.cc-sec { padding-block: clamp(2rem, 4.5vw, 3.5rem); }
	.cc-sec--last { padding-bottom: clamp(1.5rem, 3vw, 2.5rem); }
	.cc-wrap { max-width: 76rem; margin: 0 auto; }

	/* the way back, said plainly: one step back, or straight to the wall */
	.cc-backrow { display: flex; flex-wrap: wrap; gap: 0.55rem; margin-bottom: 0.9rem; }
	.cc-back {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		align-self: start;
		cursor: pointer;
		padding: 0.5rem 1rem 0.5rem 0.85rem;
		border-radius: 9999px;
		border: 1px solid var(--cp-line);
		background: var(--cp-card);
		font-family: var(--cp-marker);
		font-size: 0.92rem;
		font-weight: 700;
		color: var(--cp-ink);
		transition: border-color 0.25s ease, background 0.25s ease, gap 0.25s ease;
	}
	.cc-back:hover {
		gap: 0.7rem;
		border-color: color-mix(in srgb, var(--c) 55%, transparent);
		background: color-mix(in srgb, var(--c) 12%, transparent);
	}
	.cc-back :global(svg) { color: var(--c); }
	.cc-back--alt {
		background: transparent;
		border-style: dashed;
		color: var(--cp-muted);
	}
	.cc-back--alt:hover { color: var(--cp-ink); }

	.cc-crumb {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-family: ui-monospace, monospace;
		font-size: 0.78rem;
		font-weight: 700;
		color: var(--cp-faint);
		margin-bottom: 1rem;
	}
	.cc-crumb a { color: var(--cp-faint); transition: color 0.2s ease; }
	.cc-crumb a:hover { color: var(--c); }
	.cc-crumb-here { color: var(--c); }
	.cc-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-family: ui-monospace, monospace;
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--c);
		border: 1px solid color-mix(in srgb, var(--c) 40%, transparent);
		background: color-mix(in srgb, var(--c) 9%, transparent);
		padding: 0.4rem 0.9rem;
		border-radius: 9999px;
		margin-bottom: 1.1rem;
	}
	.cc-kick {
		display: block;
		font-family: ui-monospace, monospace;
		font-size: 0.74rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--c);
		margin-bottom: 0.6rem;
	}
	.cc-h {
		font-size: clamp(1.9rem, 4vw, 3rem);
		font-weight: 850;
		letter-spacing: -0.02em;
		line-height: 1.05;
		margin: 0 0 0.9rem;
	}
	.cc-h--xl { font-size: clamp(2.3rem, 5.2vw, 4.2rem); line-height: 1; }
	.cc-h--cta { font-size: clamp(1.9rem, 4.4vw, 3.2rem); }
	.cc-h em {
		font-style: normal;
		background: linear-gradient(95deg, var(--c), color-mix(in srgb, var(--c) 45%, #fb7185));
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}
	.cc-tagline {
		margin: 0 0 0.9rem;
		font-family: var(--cp-marker);
		font-size: clamp(1.05rem, 2vw, 1.35rem);
		color: var(--c);
	}
	.cc-p {
		font-size: clamp(0.96rem, 1.5vw, 1.08rem);
		line-height: 1.7;
		color: var(--cp-muted);
		max-width: 34rem;
		margin: 0 0 1.2rem;
	}
	.cc-p--center { text-align: center; margin-inline: auto; max-width: 36rem; }
	.cc-head { text-align: center; margin-bottom: clamp(1.5rem, 3vw, 2.25rem); }
	.cc-link {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font-weight: 800;
		font-size: 0.92rem;
		color: var(--c);
		border-bottom: 2px solid color-mix(in srgb, var(--c) 45%, transparent);
		padding-bottom: 0.15rem;
		transition: border-color 0.25s ease, gap 0.25s ease;
	}
	.cc-link:hover { gap: 0.7rem; border-color: var(--c); }
	.cc-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.9rem 1.7rem;
		border-radius: 9999px;
		font-weight: 800;
		font-size: 0.92rem;
		color: #fff;
		background: linear-gradient(95deg, var(--c), color-mix(in srgb, var(--c) 55%, #f59e0b));
		box-shadow: 0 18px 44px -16px color-mix(in srgb, var(--c) 75%, transparent);
		transition: box-shadow 0.25s ease, filter 0.25s ease;
		will-change: transform;
	}
	.cc-cta:hover { filter: brightness(1.07); }
	.cc-row { display: flex; align-items: center; gap: 1.2rem; flex-wrap: wrap; }
	.cc-row--center { justify-content: center; }
	.cc-call { font-size: 0.95rem; color: var(--cp-muted); }
	.cc-call strong { font-weight: 850; color: var(--cp-ink); transition: color 0.25s ease; }
	.cc-call:hover strong { color: var(--c); }

	.cc-glare {
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background: radial-gradient(320px 200px at var(--gx, 50%) var(--gy, 20%), color-mix(in srgb, var(--c) 12%, transparent), transparent 70%);
		opacity: 0;
		transition: opacity 0.3s ease;
		pointer-events: none;
		z-index: 2;
	}
	[data-fa-tilt]:hover .cc-glare { opacity: 1; }

	/* ── A · assignment header ── */
	.cc-open {
		display: grid;
		gap: clamp(1.75rem, 4vw, 3.5rem);
		align-items: center;
	}
	@media (min-width: 960px) {
		.cc-open { grid-template-columns: 1.02fr 0.98fr; }
	}
	.cc-label {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 1.4rem;
	}
	.cc-label i {
		display: grid;
		gap: 0.1rem;
		font-style: normal;
		font-size: 0.85rem;
		font-weight: 700;
		padding: 0.5rem 0.9rem;
		border-radius: 0.7rem;
		border: 1px solid var(--cp-line);
		background: var(--cp-card);
		color: var(--cp-ink);
	}
	.cc-label i b {
		font-family: ui-monospace, monospace;
		font-size: 0.6rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--cp-faint);
	}

	/* the pinned-up project */
	.cc-piece {
		position: relative;
		margin: 0;
		transform: rotate(1deg);
	}
	@media (max-width: 959px) {
		.cc-piece { transform: none; margin-top: 1.4rem; }
	}
	.cc-pin {
		position: absolute;
		top: -8px;
		left: 50%;
		transform: translateX(-50%);
		width: 15px;
		height: 15px;
		border-radius: 50%;
		background: radial-gradient(circle at 35% 30%, #fda4af, #e11d48 65%);
		box-shadow: 0 3px 6px rgba(0, 0, 0, 0.45);
		z-index: 3;
	}
	.cc-frame {
		position: relative;
		display: block;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		border-radius: 0.8rem;
		border: 8px solid #fbfaf7;
		background: #fbfaf7;
		box-shadow:
			0 0 55px -14px color-mix(in srgb, var(--c) 40%, transparent),
			0 40px 90px -36px rgba(0, 0, 0, 0.8);
	}
	.cc-frame img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
		border-radius: 0.35rem;
		transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.cc-piece:hover .cc-frame img { transform: scale(1.04); }
	.cc-grade-stamp {
		position: absolute;
		top: 0.6rem;
		right: 0.9rem;
		font-family: var(--cp-marker);
		font-size: 2.1rem;
		font-weight: 700;
		color: #dc2626;
		transform: rotate(8deg);
		text-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
		z-index: 2;
	}
	.cc-float {
		position: absolute;
		display: grid;
		gap: 0.05rem;
		padding: 0.55rem 0.9rem;
		border-radius: 0.6rem;
		background: rgba(20, 13, 4, 0.82);
		-webkit-backdrop-filter: blur(10px);
		backdrop-filter: blur(10px);
		border: 1px solid color-mix(in srgb, var(--c) 40%, rgba(255, 255, 255, 0.14));
		box-shadow: 0 16px 34px -16px rgba(0, 0, 0, 0.7);
