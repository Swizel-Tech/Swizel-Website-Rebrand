---
// Founder hero — the film is the hero.
//
// The launch console used to sit here and it was a lot of instrument to
// read before anyone knew who we were; it lives further down the page now,
// where a founder is already listening. What stands here instead is a
// minute of the founder talking, shot portrait, framed like a studio
// monitor: the one thing on the page that argues for us without a word of
// copy. Everything else — the welcome, the promise, the two ways in, the
// numbers — is arranged around it and kept short.
import { Icon } from 'astro-icon/components';
import CustomButton from '../CustomButton.astro';
import Section from '../HTML/Section.astro';
import RotatingHeadline from '../RotatingHeadline.astro';
import BuildTeam from '../BuildTeam.astro';
import FounderReel from '../FounderReel.astro';

const REEL_ID = 'zdy4TEld6x4';

const stats = [
	{ to: 6, suffix: ' wks', label: 'Idea to MVP' },
	{ to: 65, suffix: '+', label: 'Products' },
	{ to: 7, suffix: '+', label: 'Years' },
	{ to: 10, suffix: '+', label: 'Countries' },
];
---

<Section
	sectionClass="hero--stage hero-view hero-founder founder--stage relative overflow-hidden"
	divClass="relative z-10 pb-16 sm:pb-24"
>
	<div class="founder--bg" aria-hidden="true">
		<span class="founder--glow"></span>
		<span class="founder--grid"></span>
		{Array.from({ length: 7 }).map((_, i) => <span class="founder--rise" style={`--i:${i}`} />)}
	</div>

	<div class="founder--layout">
		<div class="founder--copy">
			<span class="founder--welcome">
				<span class="founder--wrule" aria-hidden="true"></span>
				Welcome to Swizel
			</span>

			<span class="founder--eyebrow">
				<Icon width={15} name="mdi:rocket-launch-outline" />
				Founder mode · Zero to MVP
			</span>

			<div class="founder--headwrap">
				<RotatingHeadline class="founder--head" />
			</div>

			<p class="founder--sub">
				From a blank page to a launched product in six weeks. We plan, build and ship with you, then stay to scale what works.
			</p>

			<div class="founder--cta">
				<CustomButton
					variant="accent"
					elementType="a"
					href="/contact"
					class="flex items-center justify-center gap-2"
				>
					Start project
					<Icon width={18} name="mdi:rocket-launch-outline" />
				</CustomButton>
				<button class="founder--tour" type="button" data-tour-start="founder">
					<Icon width={16} name="mdi:compass-outline" />
					Take the 20s tour
				</button>
			</div>

			<ul class="founder--stats" data-tour="stats">
				{
					stats.map((s) => (
						<li class="founder--stat">
							<span
								class="founder--statnum"
								data-count-to={s.to}
								data-suffix={s.suffix}
							>
								{s.to}
								{s.suffix}
							</span>
							<span class="founder--statlabel">{s.label}</span>
						</li>
					))
				}
			</ul>

			<div class="founder--team">
				<BuildTeam />
			</div>
		</div>

		<div class="founder--film" data-tour="reel">
			<!-- the phone rig keeps its own vertical still: a 16:9 YouTube
			     thumbnail cropped into a 9:16 handset loses the subject -->
			<FounderReel
				videoId={REEL_ID}
				kicker="Founder’s cut"
				still="/images/founder/reel-still.jpg"
			/>
		</div>
	</div>
</Section>

<style>
	.founder--stage {
		background:
			radial-gradient(900px 520px at 80% -10%, rgba(139, 92, 246, 0.2), transparent 60%),
			linear-gradient(180deg, #161229 0%, #120f22 55%, #0d0b1a 100%);
		color: #ede9fb;
		isolation: isolate;
	}
	.founder--bg {
		position: absolute; top: 0; left: 50%; transform: translateX(-50%);
		width: 100vw; height: 100%; z-index: 0; overflow: hidden; pointer-events: none;
		background:
			radial-gradient(900px 520px at 80% -10%, rgba(139, 92, 246, 0.2), transparent 60%),
			linear-gradient(180deg, #161229 0%, #120f22 55%, #0d0b1a 100%);
	}
	.founder--glow {
		position: absolute;
		top: -20%;
		left: 50%;
		transform: translateX(-50%);
		width: 70vw;
		max-width: 820px;
		height: 460px;
		background: radial-gradient(ellipse at center, rgba(139, 92, 246, 0.28), transparent 70%);
		filter: blur(50px);
	}
	/* a faint plotting grid under everything — a founder's whiteboard, not a void */
	.founder--grid {
		position: absolute;
		inset: 0;
		opacity: 0.5;
		background-image:
			linear-gradient(rgba(196, 181, 253, 0.06) 1px, transparent 1px),
			linear-gradient(90deg, rgba(196, 181, 253, 0.06) 1px, transparent 1px);
		background-size: 62px 62px;
		-webkit-mask-image: radial-gradient(80% 65% at 50% 30%, #000 20%, transparent 78%);
		mask-image: radial-gradient(80% 65% at 50% 30%, #000 20%, transparent 78%);
	}
	.founder--rise {
		position: absolute;
		bottom: -10%;
		left: calc((var(--i) + 1) * 12%);
		width: 5px;
		height: 5px;
		border-radius: 9999px;
		background: rgba(167, 139, 250, 0.7);
		box-shadow: 0 0 10px 2px rgba(139, 92, 246, 0.5);
		animation: rise 9s linear infinite;
		animation-delay: calc(var(--i) * -1.3s);
	}
	@keyframes rise {
		0% { transform: translateY(0); opacity: 0; }
		15% { opacity: 1; }
		85% { opacity: 1; }
		100% { transform: translateY(-92vh); opacity: 0; }
	}

	.founder--layout {
		position: relative;
		z-index: 1;
		display: grid;
		gap: 2.25rem;
		align-items: center;
		min-height: calc(100vh - 90px);
		padding-top: 1.5rem;
	}
	@media (min-width: 1024px) {
		/* the film is a tall object, so the copy takes the wider half and the
		   monitor sits beside it at its own natural size */
		.founder--layout { grid-template-columns: 1.02fr 0.98fr; gap: 2rem; }
		.founder--film { justify-self: center; }
	}

	/* the welcome line: a hairline, then the words, in small caps */
	.founder--welcome {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin-bottom: 0.9rem;
		font-size: 0.7rem;
		font-weight: 800;
		letter-spacing: 0.3em;
		text-transform: uppercase;
		color: rgba(237, 233, 251, 0.6);
	}
	.founder--wrule {
		width: clamp(20px, 5vw, 44px);
		height: 1px;
		flex: none;
		background: linear-gradient(90deg, transparent, currentColor);
		opacity: 0.7;
	}

	.founder--eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.74rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: #c4b5fd;
		border: 1.5px dashed rgba(196, 181, 253, 0.5);
		padding: 0.35rem 0.85rem;
		border-radius: 0.5rem;
		transform: rotate(-2deg);
		margin-bottom: 1.1rem;
	}
	/* founder world CTA runs violet → pink, like the body */
	:global(.hero-founder .btn--accent) {
		background-image: linear-gradient(95deg, #8b5cf6, #ec4899) !important;
		color: #fff !important;
		-webkit-text-fill-color: #fff;
		box-shadow: 0 14px 34px -12px rgba(139, 92, 246, 0.6) !important;
	}
	.founder--head { font-size: clamp(2.5rem, 5.4vw, 4.6rem); margin-bottom: 1.2rem; }
	.founder--sub {
		max-width: 34rem;
		color: rgba(237, 233, 251, 0.66);
		font-size: 1.05rem;
		line-height: 1.6;
		margin-bottom: 1.6rem;
	}
	.founder--cta { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.8rem; }
	.founder--tour {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.82rem;
		font-weight: 600;
		color: #ede9fb;
		padding: 0.85rem 1.2rem;
		border-radius: 9999px;
		border: 1px dashed rgba(196, 181, 253, 0.45);
		transition: border-color 0.25s ease, color 0.25s ease, background 0.25s ease;
	}
	.founder--tour:hover {
		border-color: var(--view-accent, #8b5cf6);
		color: #c4b5fd;
		background: rgba(139, 92, 246, 0.1);
	}

	.founder--stats {
		display: flex;
		justify-content: space-between;
		gap: clamp(0.5rem, 2vw, 1.6rem);
		/* four numbers, one line, at every width — they read as a set */
		flex-wrap: nowrap;
		padding-top: 1.4rem;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
	}
	.founder--stat { flex: 1 1 0; min-width: 0; }
	.founder--statnum {
		font-family: 'Bebas Neue', sans-serif;
		font-size: clamp(1.6rem, 2.4vw, 2.2rem);
		line-height: 1;
		background: linear-gradient(135deg, #c4b5fd, var(--view-accent, #8b5cf6));
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
		color: transparent;
	}
	.founder--statlabel { display: block; font-size: 0.72rem; white-space: nowrap; text-transform: uppercase; letter-spacing: 0.06em; color: rgba(237, 233, 251, 0.5); margin-top: 0.3rem; }

	.founder--film { position: relative; display: flex; justify-content: center; width: 100%; min-width: 0; }

	/* ── phones: the film comes second, right under the promise, and the
	   numbers stay on one clean line ─────────────────────────────────── */
	@media (max-width: 1023px) {
		/* One column, and the film is lifted to third place — a founder should
		   meet the person before the pitch. `display: contents` dissolves the
		   copy column so the film can be ordered in among its lines. */
		.founder--layout {
			display: flex;
			flex-direction: column;
			align-items: stretch;
			min-height: auto;
		}
		.founder--copy { display: contents; }
		.founder--welcome { order: 1; }
		.founder--eyebrow { order: 2; align-self: flex-start; }
		.founder--headwrap { order: 3; }
		.founder--film { order: 4; margin: 0 0 1.2rem; }
		.founder--sub { order: 5; }
		.founder--cta { order: 6; }
		.founder--stats { order: 7; }
		.founder--team { order: 8; margin-top: 1.4rem; }
	}
	@media (max-width: 768px) {
		.founder--layout { gap: 0; padding-top: 0.5rem; }
		.founder--head { font-size: clamp(2.1rem, 9vw, 3rem); margin-bottom: 0.7rem; }
		.founder--sub { font-size: 0.97rem; line-height: 1.6; margin-bottom: 1.2rem; }
		.founder--cta { gap: 0.6rem; margin-bottom: 1.4rem; }
		.founder--cta > * { flex: 1 1 auto; }
		.founder--tour { padding: 0.8rem 1rem; font-size: 0.78rem; }
		.founder--stats {
			flex-wrap: nowrap;
			gap: 0.4rem;
			padding-top: 1.1rem;
		}
		.founder--stat { flex: 1 1 0; min-width: 0; text-align: center; }
		.founder--statnum { font-size: clamp(1.15rem, 5.4vw, 1.7rem); }
		.founder--statlabel {
			font-size: clamp(0.7rem, 2.5vw, 0.7rem);
			letter-spacing: 0.03em;
			margin-top: 0.2rem;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.founder--rise { animation: none !important; }
	}

	/* ══ Light mode: the founder stage goes bright — lavender paper, ink type ══ */
	:global(html:not(.dark)) .founder--stage,
	:global(html:not(.dark)) .founder--bg {
		background:
			radial-gradient(900px 520px at 80% -10%, rgba(139, 92, 246, 0.24), transparent 60%),
			linear-gradient(180deg, #ece7f9 0%, #e2daf3 55%, #d9d0ee 100%);
		color: #171331;
	}
	:global(html:not(.dark)) .founder--glow { opacity: 0.5; }
	:global(html:not(.dark)) .founder--grid {
		background-image:
			linear-gradient(rgba(109, 40, 217, 0.07) 1px, transparent 1px),
			linear-gradient(90deg, rgba(109, 40, 217, 0.07) 1px, transparent 1px);
	}
	:global(html:not(.dark)) .founder--welcome { color: rgba(23, 19, 49, 0.55); }
	:global(html:not(.dark)) .founder--eyebrow {
		color: #6d28d9;
		border-color: rgba(109, 40, 217, 0.45);
	}
	:global(html:not(.dark)) .founder--sub { color: rgba(23, 19, 49, 0.74); }
	:global(html:not(.dark)) .founder--tour {
		color: #171331;
		border-color: rgba(109, 40, 217, 0.4);
	}
	:global(html:not(.dark)) .founder--tour:hover { color: #6d28d9; }
	:global(html:not(.dark)) .founder--stats { border-top-color: rgba(23, 19, 49, 0.1); }
	:global(html:not(.dark)) .founder--statnum {
		background: linear-gradient(135deg, #7c3aed, #6d28d9);
		-webkit-background-clip: text;
		background-clip: text;
	}
	:global(html:not(.dark)) .founder--statlabel { color: rgba(23, 19, 49, 0.55); }
</style>
