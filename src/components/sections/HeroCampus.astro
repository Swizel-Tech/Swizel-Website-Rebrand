---
import { Icon } from 'astro-icon/components';
import CustomButton from '../CustomButton.astro';
import Section from '../HTML/Section.astro';
import RotatingHeadline from '../RotatingHeadline.astro';
import MentorsBand from '../MentorsBand.astro';
import WhiteboardVideo from '../WhiteboardVideo.astro';
import CampusWall from '../CampusWall.astro';

// No counters here: two of these are ranges, not numbers.
const stats = [
	{ n: '3\u20136 mo', label: 'IT internship' },
	{ n: '12 mo', label: 'NYSC placement' },
	{ n: '7 yrs+', label: 'Mentoring' },
	{ n: '65+', label: 'Live products' },
];

---

<Section
	sectionClass="hero--stage hero-view hero-campus campus--stage relative overflow-hidden"
	divClass="relative z-10 pb-10 sm:pb-16"
>
	<div class="campus--bg" aria-hidden="true">
		<span class="campus--glow"></span>
		{Array.from({ length: 10 }).map((_, i) => <span class="campus--dot" style={`--i:${i}`} />)}
	</div>

	<div class="campus--layout">
		<div class="campus--copy">
			<!-- Campus-only. RotatingHeadline is the signature shared by all
			     four hero worlds, so the greeting is added beside it rather
			     than inside it. -->
			<h2 class="campus--welcome font-bebas">
				<span class="campus--welcome-k">Welcome to</span>
				<em>Swizel.</em>
			</h2>

			<RotatingHeadline class="campus--head" />

			<p class="campus--sub">
				Do your IT or your service year on a live product with the team
				that ships it. Learn by building products people actually use.
			</p>

			<div class="campus--cta">
				<CustomButton
					variant="accent"
					elementType="a"
					href="/programs#internship"
					class="flex items-center justify-center gap-2"
				>
					Internship Path
					<Icon width={17} name="mdi:arrow-right" />
				</CustomButton>
				<a class="campus--alt" href="/programs#nysc">
					<Icon width={15} name="mdi:flag-outline" />
					NYSC Path
				</a>
				<button class="campus--tour" type="button" data-tour-start="campus">
					<Icon width={15} name="mdi:compass-outline" />
					<span>Take a Tour</span>
				</button>
			</div>

			<ul class="campus--stats" data-tour="stats">
				{
					stats.map((s) => (
						<li class="campus--stat">
							<span class="campus--statnum">{s.n}</span>
							<span class="campus--statlabel">{s.label}</span>
						</li>
					))
				}
			</ul>

			<MentorsBand />
		</div>

		<!-- The class, projected on the board -->
		<div class="campus--boardwrap" data-tour="class">
			<span class="campus--tape" aria-hidden="true"></span>
			<WhiteboardVideo
				videoId="noEhs-8ywag"
				title="today: build something real"
				kicker="Inside the internship"
				stickyA="ship > perfect"
				stickyB="demo friday!"
				ctaHref="/programs#internship"
				ctaLabel="Start your application"
			/>
			<p class="campus--boardnote">
				<Icon width={14} name="mdi:cursor-default-click-outline" />
				Press play. Speed it up, scrub it, take it full screen. Every
				control lives on the board.
			</p>
		</div>

		<!-- Its own row across both columns. The board column has to end on
		     the note again, level with the mentors band, so the prints
		     cannot live inside it. -->
		<CampusWall />

	</div>
</Section>

<style>
	.campus--stage {
		background:
			radial-gradient(900px 520px at 78% -10%, rgba(245, 158, 11, 0.22), transparent 60%),
			linear-gradient(180deg, #1d1606 0%, #16110a 55%, #100c08 100%);
		color: #fdf3e3;
		isolation: isolate;
	}
	.campus--bg {
		position: absolute; top: 0; left: 50%; transform: translateX(-50%);
		width: 100vw; height: 100%; z-index: 0; overflow: hidden; pointer-events: none;
		background:
			/* faint exercise-book ruling — school in the bones */
			repeating-linear-gradient(180deg, transparent 0 38px, rgba(252, 211, 77, 0.05) 38px 39px),
			linear-gradient(90deg, transparent 0 64px, rgba(251, 113, 133, 0.07) 64px 65px, transparent 65px 100%),
			radial-gradient(900px 520px at 78% -10%, rgba(245, 158, 11, 0.22), transparent 60%),
			linear-gradient(180deg, #1d1606 0%, #16110a 55%, #100c08 100%);
	}
	/* campus world CTA: chunky amber, pressable like the body's */
	:global(.hero-campus .btn--accent) {
		background-image: linear-gradient(180deg, #fcd34d, #f59e0b) !important;
		color: #2b1c08 !important;
		-webkit-text-fill-color: #2b1c08;
		border-radius: 0.8rem !important;
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.5),
			0 6px 0 rgba(120, 67, 5, 0.9),
			0 18px 38px -14px rgba(245, 158, 11, 0.7) !important;
	}
	:global(.hero-campus .btn--accent:hover) {
		transform: translateY(2px);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.5),
			0 4px 0 rgba(120, 67, 5, 0.9),
			0 14px 30px -14px rgba(245, 158, 11, 0.7) !important;
	}
	.campus--glow {
		position: absolute; top: -18%; left: 50%; transform: translateX(-50%);
		width: 70vw; max-width: 820px; height: 460px;
		background: radial-gradient(ellipse at center, rgba(245, 158, 11, 0.26), transparent 70%);
		filter: blur(50px);
	}
	.campus--dot {
		position: absolute;
		top: -8%;
		left: calc((var(--i) + 1) * 9%);
		width: 8px; height: 8px; border-radius: 2px;
		background: hsl(calc(20 + var(--i) * 28) 90% 60%);
		opacity: 0.7;
		animation: cdrop 11s linear infinite;
		animation-delay: calc(var(--i) * -1.1s);
	}
	@keyframes cdrop {
		0% { transform: translateY(0) rotate(0); opacity: 0; }
		12% { opacity: 0.8; }
		100% { transform: translateY(112vh) rotate(360deg); opacity: 0; }
	}

	.campus--layout { position: relative; z-index: 1; display: grid; gap: 2.5rem; align-items: start; min-height: calc(100vh - 260px); padding-top: 2rem; padding-bottom: 1rem; }
	@media (min-width: 1024px) {
		/* The board is the tallest thing in the row, so let it set the
		   row height. A min-height here would make the row taller than
		   both columns and leave the board floating above the floor. */
		.campus--layout { grid-template-columns: 0.86fr 1.14fr; gap: 2.25rem; align-items: stretch; min-height: 0; }
		/* the column stretches to the height of the board beside it and the
		   auto margin drops the mentors band onto its floor, so the two
		   columns finish on the same line */
		/* A flex column stretches its children by default, which is what
		   blew the eyebrow pill out to the full column width. Everything
		   sizes to its own content now; only the two full-bleed rows are
		   asked to fill. space-between then spreads the leftover height
		   evenly and lands the mentors band on the column's floor, level
		   with the note under the board. */
		.campus--copy {
			display: flex;
			flex-direction: column;
			align-items: flex-start;
			justify-content: space-between;
		}
		.campus--copy > * { flex: none; }
		.campus--copy .campus--stats,
		.campus--copy > :global(.mband) { width: 100%; }
		.campus--copy > :global(.mband) { margin-top: 0; margin-bottom: 0; }
		/* the gaps come from space-between now, not from stacked margins */
		.campus--copy .campus--sub,
		.campus--copy .campus--cta { margin-bottom: 0; }
		/* the prints get their own row, matching the column rhythm above so
		   the arrow sits under the copy and the fan under the board */
		.campus--layout > :global(.cwall) { grid-column: 1 / -1; }
		/* End-aligned, not centred: when the board is the taller column this
		   is an exact fit, and when the copy runs longer (narrow desktops,
		   where the three buttons wrap) the board stays pinned to the floor
		   so its note still lines up with the mentors band. */
		.campus--boardwrap { align-self: end; }
	}

	.campus--welcome {
		margin: 0 0 0.35rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 1px;
		line-height: 0.92;
		font-size: clamp(1.55rem, 2.4vw, 2.1rem);
		color: rgba(253, 243, 227, 0.72);
	}
	.campus--welcome em {
		font-style: normal;
		background: linear-gradient(135deg, #fde68a, #f59e0b);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
		color: transparent;
	}

	:global(.campus--head) { font-size: clamp(2.3rem, 5vw, 4.2rem) !important; margin-bottom: 0.8rem !important; }
	.campus--sub { max-width: 34rem; color: rgba(253, 243, 227, 0.7); font-size: 0.95rem; line-height: 1.58; margin-bottom: 0.9rem; }
	.campus--cta { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; margin-bottom: 1.1rem; }
	/* second track: NYSC. Quieter than the primary, still a real button. */
	.campus--alt { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.86rem; font-weight: 700; white-space: nowrap; color: #fdf3e3; padding: 0.8rem 1.05rem; border-radius: 0.8rem; border: 1px solid rgba(252, 211, 77, 0.45); background: rgba(245, 158, 11, 0.08); transition: 0.25s ease; }
	.campus--alt:hover { border-color: #f59e0b; color: #fcd34d; background: rgba(245, 158, 11, 0.16); transform: translateY(-1px); }

	.campus--tour { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.86rem; font-weight: 700; white-space: nowrap; color: #fdf3e3; padding: 0.8rem 1.05rem; border-radius: 0.8rem; border: 1px dashed rgba(252, 211, 77, 0.45); transition: 0.25s ease; }
	.campus--tour:hover { border-color: #f59e0b; color: #fcd34d; background: rgba(245, 158, 11, 0.1); }
	.campus--stats { display: flex; justify-content: space-between; gap: clamp(0.8rem, 2vw, 1.6rem); flex-wrap: wrap; padding-top: 0.9rem; border-top: 1px solid rgba(255, 255, 255, 0.08); }
	@media (max-width: 600px) { .campus--stats { display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem 1rem; } .campus--stat { min-width: 0; } }
	.campus--statnum { font-family: 'Bebas Neue', sans-serif; font-size: clamp(1.4rem, 2vw, 1.9rem); line-height: 1; background: linear-gradient(135deg, #fde68a, #f59e0b); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: transparent; }
	.campus--statlabel { display: block; font-size: 0.74rem; white-space: nowrap; text-transform: uppercase; letter-spacing: 0.08em; color: rgba(253, 243, 227, 0.5); margin-top: 0.2rem; max-width: 9rem; }

	/* ===== the board in the hero ===== */
	.campus--boardwrap {
		position: relative;
		min-width: 0;
	}
	/* a strip of masking tape holding the board to the wall */
	.campus--tape {
		position: absolute;
		top: -18px;
		left: 50%;
		width: 132px;
		height: 30px;
		margin-left: -66px;
		z-index: 7;
		background: linear-gradient(180deg, rgba(253, 230, 138, 0.92), rgba(252, 211, 77, 0.82));
		box-shadow: 0 6px 14px -8px rgba(0, 0, 0, 0.55);
		transform: rotate(-2.2deg);
		clip-path: polygon(3% 0, 97% 4%, 100% 96%, 2% 100%);
		pointer-events: none;
	}

	.campus--boardnote {
		display: flex;
		align-items: flex-start;
		gap: 0.45rem;
		margin-top: 1.1rem;
		font-size: 0.8rem;
		line-height: 1.5;
		color: rgba(253, 243, 227, 0.55);
	}
	.campus--boardnote :global(svg) { flex: none; margin-top: 0.15rem; color: #fcd34d; }

	/* Between 1024 and 1280 the copy column is narrow enough that three
	   buttons wrap, which pushes the mentors band below the board's floor.
	   Tighten the chrome so the row survives on one line. */
	@media (min-width: 1024px) and (max-width: 1279px) {
		.campus--cta { gap: 0.45rem; }
		/* the copy column is narrow here and the four numbers were dropping
		   "65+ / live products" onto a second row on its own */
		.campus--stats { flex-wrap: nowrap; gap: 0.7rem; }
		.campus--stat { min-width: 0; }
		.campus--statnum { font-size: 1.25rem; }
		.campus--statlabel { font-size: 0.62rem; letter-spacing: 0.05em; white-space: normal; max-width: none; }
		.campus--alt,
		.campus--tour { font-size: 0.78rem; padding: 0.7rem 0.8rem; gap: 0.3rem; }
		.campus--cta :global(.btn--accent) {
			padding-left: 1.1rem;
			padding-right: 1.1rem;
			font-size: 0.78rem;
		}
	}

	/* On a phone the board should not be a scroll away: the copy hands
	   straight over to it, and the numbers close the section underneath. */
	/* ══ The phone hero ══════════════════════════════════════════════
	   Centred, one thing at a time, generous air. The old version squeezed
	   three buttons onto one row at 0.68rem with their icons hidden, which
	   is where it stopped feeling like a designed page and started feeling
	   like a list of controls. */
	@media (max-width: 1023px) {
		.campus--layout {
			min-height: auto;
			display: flex;
			flex-direction: column;
			align-items: center;
			text-align: center;
			gap: 1.5rem;
		}
		.campus--copy { display: contents; }

		/* THE HIERARCHY WAS UPSIDE DOWN. A giant "SWIZEL." sat on top and
		   the actual brand line — YOU IMAGINE / WE BUILD — was shrunk to a
		   faded 1rem tagline you could not read, let alone enjoy. The
		   greeting is a small label now; the signature is the hero. */
		.campus--welcome {
			order: 1;
			margin: 0;
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
			font-size: 0.66rem;
			font-weight: 800;
			letter-spacing: 0.34em;
			line-height: 1;
			text-transform: uppercase;
			color: var(--cw-kick, rgba(253, 243, 227, 0.72));
		}
		/* a hairline either side, like a title card */
		.campus--welcome::before,
		.campus--welcome::after {
			content: '';
			width: clamp(14px, 6vw, 34px);
			height: 1px;
			background: currentColor;
			opacity: 0.45;
		}
		.campus--welcome-k { display: inline; font-size: 1em; letter-spacing: inherit; margin: 0; opacity: 1; }
		.campus--welcome em {
			font-style: normal;
			-webkit-text-fill-color: currentColor;
			background: none;
			color: inherit;
		}

		/* the signature, at last legible */
		.campus--layout :global(.campus--head) {
			order: 2;
			margin: 0 !important;
			font-size: clamp(2.9rem, 13.6vw, 4.2rem) !important;
			line-height: 0.86 !important;
			letter-spacing: 0.005em;
			opacity: 1;
		}
		.campus--layout :global(.rhead__l1),
		.campus--layout :global(.rhead__l2) { justify-content: center; }
		/* the rotating word gets room to breathe under "YOU IMAGINE." */
		.campus--layout :global(.rhead__l2) { margin-top: 0.06em; }

		/* A marker stroke under the word that changes — the same red the
		   whiteboard uses. Deliberately static: the headline's own rotation
		   timing lives in a shared component, and an underline that drifts
		   out of sync with it looks broken rather than designed. */
		.campus--layout :global(.rhead__rot) { position: relative; }
		.campus--layout :global(.rhead__rot)::after {
			content: '';
			position: absolute;
			left: 1%;
			right: 1%;
			bottom: -0.04em;
			height: 0.07em;
			border-radius: 999px;
			background: linear-gradient(90deg, transparent, #f43f5e 14%, #f59e0b 86%, transparent);
			opacity: 0.9;
		}

		/* one gentle rise on arrival, staggered — the hero used to just
		   appear */
		.campus--welcome { animation: campus-rise 0.7s cubic-bezier(0.2, 0.9, 0.25, 1) both; }
		.campus--layout :global(.campus--head) { animation: campus-rise 0.7s cubic-bezier(0.2, 0.9, 0.25, 1) 0.08s both; }
		.campus--sub { animation: campus-rise 0.7s cubic-bezier(0.2, 0.9, 0.25, 1) 0.16s both; }
		.campus--cta { animation: campus-rise 0.7s cubic-bezier(0.2, 0.9, 0.25, 1) 0.24s both; }
		@keyframes campus-rise {
			from { opacity: 0; transform: translateY(14px); }
			to { opacity: 1; transform: none; }
		}

		/* the amber pool sits behind the headline on a phone, not off to
		   the right where the board is on desktop */
		.campus--glow {
			top: 2%;
			width: 130vw;
			max-width: none;
			height: 340px;
			opacity: 0.85;
		}

		.campus--sub {
			order: 3;
			margin: 0 auto;
			max-width: 30rem;
			font-size: 1rem;
			line-height: 1.6;
		}

		/* One row, three equal segments — stacking them cost three button
		   heights and pushed the board off the first screen. The earlier
		   one-line attempt failed because it squeezed full-size buttons to
		   0.68rem and hid their icons; this is designed as a strip: equal
		   widths, one filled primary, generous height, no icons at all. */
		.campus--cta {
			order: 4;
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 0.4rem;
			width: 100%;
			max-width: 24rem;
			margin: 0.25rem auto 0;
			flex-wrap: nowrap;
		}
		.campus--cta > * {
			width: 100%;
			min-width: 0;
			justify-content: center;
			text-align: center;
			white-space: nowrap;
			border-radius: 0.85rem;
		}
		.campus--cta :global(.btn--accent) {
			padding: 0.9rem 0.35rem !important;
			font-size: 0.7rem !important;
			letter-spacing: 0.02em;
			border-radius: 0.85rem !important;
		}
		.campus--alt,
		.campus--tour {
			display: inline-flex;
			align-items: center;
			padding: 0.9rem 0.35rem;
			font-size: 0.7rem;
			letter-spacing: 0.02em;
			gap: 0;
		}
		.campus--tour { border-style: solid; opacity: 1; }
		/* the labels carry the row; the icons are what will not fit */
		.campus--cta :global(svg) { display: none; }

		.campus--boardwrap { order: 5; width: 100%; }
		/* same slot as the board: DOM order keeps it directly underneath */
		.campus--layout > :global(.cwall) { order: 5; width: 100%; }

		/* one straight horizontal line, four across */
		.campus--stats {
			order: 6;
			width: 100%;
			display: flex;
			flex-wrap: nowrap;
			justify-content: space-between;
			align-items: flex-start;
			gap: 0.35rem;
			padding-top: 1rem;
		}
		.campus--stat {
			flex: 1 1 0;
			min-width: 0;
			text-align: center;
		}
		.campus--statnum { font-size: clamp(0.95rem, 4.4vw, 1.35rem); }
		.campus--statlabel {
			max-width: none;
			white-space: normal;
			font-size: clamp(0.53rem, 2.4vw, 0.66rem);
			letter-spacing: 0.05em;
			line-height: 1.25;
		}

		/* the band has its own left-aligned composition around the photo;
		   the hero's centring must not reach inside it */
		.campus--layout :global(.mband) { order: 7; width: 100%; text-align: left; }
	}
	@media (max-width: 768px) {
		.campus--layout { gap: 1.4rem; padding-top: 1.4rem; }
	}
	@media (prefers-reduced-motion: reduce) {
		.campus--dot { animation: none !important; }
		.campus--welcome,
		.campus--sub,
		.campus--cta,
		.campus--layout :global(.campus--head) { animation: none !important; }
	}

	/* ══ Light mode: sunny paper stage, ink type, frosted widget. ══ */
	:global(html:not(.dark)) .campus--stage,
	:global(html:not(.dark)) .campus--bg {
		background:
			repeating-linear-gradient(180deg, transparent 0 38px, rgba(180, 83, 9, 0.06) 38px 39px),
			linear-gradient(90deg, transparent 0 64px, rgba(225, 29, 72, 0.06) 64px 65px, transparent 65px 100%),
			radial-gradient(900px 520px at 78% -10%, rgba(245, 158, 11, 0.18), transparent 60%),
			linear-gradient(180deg, #fdf7ea 0%, #faf1e0 55%, #f7ecd8 100%);
		color: #241703;
	}
	:global(html:not(.dark)) .campus--glow { opacity: 0.5; }
	:global(html:not(.dark)) .campus--welcome { color: rgba(36, 23, 3, 0.75); --cw-ink: #241703; --cw-kick: rgba(120, 60, 8, 0.75); }
	:global(html:not(.dark)) .campus--sub { color: rgba(36, 23, 3, 0.68); }
	:global(html:not(.dark)) .campus--tour {
		color: #241703;
		border-color: rgba(180, 83, 9, 0.45);
	}
	:global(html:not(.dark)) .campus--tour:hover { color: #b45309; }
	:global(html:not(.dark)) .campus--alt {
		color: #241703;
		border-color: rgba(180, 83, 9, 0.45);
		background: rgba(245, 158, 11, 0.14);
	}
	:global(html:not(.dark)) .campus--alt:hover {
		color: #7c2d12;
		border-color: #b45309;
		background: rgba(245, 158, 11, 0.24);
	}
	:global(html:not(.dark)) .campus--stats { border-top-color: rgba(36, 23, 3, 0.12); }
	:global(html:not(.dark)) .campus--statnum {
		background: linear-gradient(135deg, #d97706, #b45309);
		-webkit-background-clip: text;
		background-clip: text;
	}
	:global(html:not(.dark)) .campus--statlabel { color: rgba(36, 23, 3, 0.55); }
	:global(html:not(.dark)) .campus--boardnote { color: rgba(36, 23, 3, 0.6); }
	:global(html:not(.dark)) .campus--boardnote :global(svg) { color: #b45309; }
	:global(html:not(.dark)) .campus--tape {
		background: linear-gradient(180deg, rgba(214, 211, 209, 0.85), rgba(190, 187, 184, 0.8));
	}
</style>
