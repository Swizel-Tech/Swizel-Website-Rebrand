---
import { Icon } from 'astro-icon/components';
import CustomButton from '../CustomButton.astro';
import Section from '../HTML/Section.astro';

const stats = [
	{ to: 7, suffix: '+', label: 'Years shipping' },
	{ to: 25, suffix: '+', label: 'Specialists' },
	{ to: 65, suffix: '+', label: 'Products built' },
];

const sectors = [
	'Fintech',
	'Healthtech',
	'Agritech',
	'Sports',
	'Real Estate',
	'E-commerce',
	'Education',
	'Logistics',
];
---

<Section
	sectionClass="hero--stage hero-view hero-boardroom relative overflow-hidden"
	divClass="relative z-10 pb-16 sm:pb-24"
>
	<div class="hero--bgfill" aria-hidden="true"></div>
	<div class="hero--glow" aria-hidden="true"></div>

	<!-- ── the room: fine panelling, a slow sweep of light, a light that
	     follows the pointer, and one gold hairline. Quiet on purpose. ── -->
	<div class="hero--panels" aria-hidden="true"></div>
	<div class="hero--sweep" aria-hidden="true"></div>
	<div class="hero--spotlight" aria-hidden="true"></div>
	<span class="hero--goldline" aria-hidden="true">
		{Array.from({ length: 9 }).map((_, i) => <i style={`--i:${i}`} />)}
	</span>

	<div class="hero--top">
		<span class="hero--eyebrow">
			
			7+ years of shipping digital products
		</span>

		<h1 class="hero--display font-bebas">
			<span class="hero--imagine">You Imagine.</span>
			<span class="hero--weline">
				<span>We</span>
				<span class="hero--rotator" aria-hidden="true">
					<span class="hero--rot gradient-text" style="--i:0">Build.</span>
					<span class="hero--rot gradient-text" style="--i:1">Design.</span>
					<span class="hero--rot gradient-text" style="--i:2">Scale.</span>
					<span class="hero--rot gradient-text" style="--i:3">Launch.</span>
				</span>
				<span class="sr-only">We build, design, scale and launch.</span>
			</span>
		</h1>

		<span class="hero--rule" aria-hidden="true"></span>

		<p class="hero--sub">
			Web &amp; mobile products for ambitious businesses.
			Bold ideas, turned into software people love.
		</p>

		<div class="hero--cta">
			<CustomButton
				variant="accent"
				elementType="a"
				href="/contact"
				class="flex items-center justify-center gap-2"
			>
				Start your project
				<Icon width={18} name="mdi:arrow-right" />
			</CustomButton>
			<a href="/portfolio" class="hero--textlink">
				See our work
				<Icon width={16} name="mdi:arrow-right" />
			</a>
			<button class="hero--tour" type="button" data-tour-start="boardroom">
				<Icon width={16} name="mdi:compass-outline" />
				Take the tour
			</button>
		</div>
	</div>

	<!-- Big team photo — the focal point -->
	<div class="hero--showcase">
		<span class="hero--brackets" aria-hidden="true">
			<i></i><i></i><i></i><i></i>
		</span>
		<div class="hero--photo-card" id="hero-tilt">
			<div class="hero--photo-inner">
				<img
					class="hero--photo"
					src="/images/hero-team.jpg"
					alt="The Swizel team — designers and engineers who build your product with you"
					width="856"
					height="580"
				/>
				<span class="hero--photo-spot" aria-hidden="true"></span>
				<span class="hero--photo-ring" aria-hidden="true"></span>
			</div>

			<!-- floating proof, kept minimal & intentional -->
			<div class="hero--badge hero--badge-rating">
				<span class="hero--badge-stars">★★★★★</span>
				<span>5.0 average client rating</span>
			</div>

			<!-- uptime ring widget -->
			<div class="hero--impact" id="boardroom-impact" data-tour="impact">
				<div class="hero--impact-head">
					<span class="hero--impact-title">Uptime · 12 months</span>
				</div>
				<div class="hero--impact-ringrow">
					<span class="hero--impact-ring" aria-hidden="true">
						<svg viewBox="0 0 64 64">
							<circle class="ring-track" cx="32" cy="32" r="26" />
							<circle class="ring-arc" cx="32" cy="32" r="26" />
						</svg>
						<span class="ring-spark"></span>
					</span>
					<span class="hero--impact-meta">
						<span class="hero--impact-num">99.9%</span>
						<span class="hero--impact-label">across 65+ products</span>
					</span>
				</div>
				<span class="hero--impact-foot">monitored around the clock</span>
			</div>
		</div>

		<!-- Stats rail -->
		<ul class="hero--stats">
			{
				stats.map((s) => (
					<li class="hero--stat">
						<span
							class="hero--stat-num"
							data-count-to={s.to}
							data-suffix={s.suffix}
						>
							{s.to}{s.suffix}
						</span>
						<span class="hero--stat-label">{s.label}</span>
					</li>
				))
			}
		</ul>
	</div>

	<!-- Industries showcase -->
	<div class="hero--industries">
		<span class="hero--industries-label">Industries we build for</span>
		<ul class="hero--sectors" id="hero-sectors">
			{
				sectors.map((s, i) => (
					<li class="hero--sector" style={`--si:${i}`}>
						{s}
					</li>
				))
			}
			<li class="hero--sector hero--sector-more">+ more</li>
		</ul>
	</div>

	<!-- the promise, on a loop, in gold -->
	<div class="hero--ticker" aria-hidden="true">
		<div class="hero--ticker-track">
			{
				[0, 1].map(() => (
					<>
						{['Design', 'Build', 'Market', 'Manage', 'From launch to legacy'].map((w) => (
							<span class="hero--ticker-word">
								{w}
								<i class="hero--ticker-star">✦</i>
							</span>
						))}
					</>
				))
			}
		</div>
	</div>

	<a href="#about" class="hero--scroll" aria-label="Scroll to learn more">
		<span></span>
	</a>
</Section>

<style>
	/* ══════════════════════════════════════════════════════════════════
	   THE HOUSE — gold pinstripes, velvet edges, a following light.
	   Everything is transform/opacity, sits behind the content, and
	   stands still under html.perf-lite.
	   ══════════════════════════════════════════════════════════════════ */
	/* GOTCHA: .hero--stage lives on the <Section> wrapper, which this
	   component's scoped styles cannot reach — so a variable declared there
	   never lands, and every color-mix() using it silently drops the whole
	   declaration. Declare it on our own elements instead. */
	.hero--panels,
	.hero--sweep,
	.hero--spotlight,
	.hero--goldline,
	.hero--goldline i,
	.hero--rule,
	.hero--brackets i,
	.hero--ticker,
	.hero--ticker-star { --gold: #f7c66b; }

	/* Fine vertical panelling. Barely there, but it gives the stage a
	   surface instead of a void. Reads in both themes. */
	.hero--panels {
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		opacity: 0.55;
		background-image: repeating-linear-gradient(
			90deg,
			transparent 0 118px,
			rgba(255, 255, 255, 0.055) 118px 119px
		);
		mask-image: linear-gradient(180deg, #000 0%, #000 55%, transparent 92%);
		-webkit-mask-image: linear-gradient(180deg, #000 0%, #000 55%, transparent 92%);
	}

	/* one wide, soft sweep of light crossing the room, slowly */
	.hero--sweep {
		position: absolute;
		top: 0;
		bottom: 0;
		left: -35%;
		width: 30%;
		z-index: 0;
		pointer-events: none;
		background: linear-gradient(
			100deg,
			transparent,
			rgba(255, 255, 255, 0.055),
			transparent
		);
		transform: skewX(-14deg);
		animation: hero-sweep 15s ease-in-out infinite;
	}
	@keyframes hero-sweep {
		0% { transform: translateX(0) skewX(-14deg); opacity: 0; }
		12% { opacity: 1; }
		70% { opacity: 1; }
		100% { transform: translateX(460%) skewX(-14deg); opacity: 0; }
	}

	/* the gold hairline across the very top of the stage */
	.hero--goldline {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 1px;
		z-index: 2;
		background: linear-gradient(90deg, transparent, var(--gold), transparent);
		opacity: 0.5;
		transform: scaleX(0);
		animation: hero-goldline 1.6s cubic-bezier(0.22, 1, 0.36, 1) 0.3s both;
	}
	/* index marks along it, like the edge of a stage */
	.hero--goldline i {
		position: absolute;
		top: 0;
		left: calc(10% + var(--i) * 10%);
		width: 1px;
		height: 7px;
		background: var(--gold);
		opacity: 0;
		animation: hero-tick 0.5s ease-out forwards;
		animation-delay: calc(1s + var(--i) * 0.06s);
	}
	@keyframes hero-tick { to { opacity: 0.45; } }
	@keyframes hero-goldline { to { transform: scaleX(1); } }

	/* the type arrives in sequence rather than all at once */
	.hero--eyebrow,
	.hero--imagine,
	.hero--weline,
	.hero--rule,
	.hero--sub,
	.hero--cta { animation: hero-rise 0.8s cubic-bezier(0.22, 1, 0.36, 1) both; }
	.hero--eyebrow { animation-delay: 0.25s; }
	.hero--imagine { animation-delay: 0.4s; }
	.hero--weline { animation-delay: 0.55s; }
	.hero--rule { animation-delay: 0.7s; }
	.hero--sub { animation-delay: 0.85s; }
	.hero--cta { animation-delay: 1s; }
	@keyframes hero-rise {
		from { opacity: 0; transform: translateY(1.1rem); filter: blur(6px); }
		to { opacity: 1; transform: none; filter: blur(0); }
	}

	/* a gold rule that draws itself under the headline */
	.hero--rule {
		display: block;
		width: clamp(5rem, 14vw, 11rem);
		height: 2px;
		margin: 1.5rem auto 0.4rem;
		background: linear-gradient(90deg, transparent, var(--gold), transparent);
		box-shadow: 0 0 18px color-mix(in srgb, var(--gold) 55%, transparent);
		position: relative;
		z-index: 2;
	}

	/* gold brackets framing the photo, drawn in on arrival */
	.hero--showcase { position: relative; }
	.hero--brackets { position: absolute; inset: -0.9rem; z-index: 1; pointer-events: none; }
	.hero--brackets i {
		position: absolute;
		width: 26px;
		height: 26px;
		border: 2px solid var(--gold);
		opacity: 0;
		animation: hero-bracket 0.7s cubic-bezier(0.22, 1, 0.36, 1) 1.1s both;
	}
	.hero--brackets i:nth-child(1) { top: 0; left: 0; border-right: 0; border-bottom: 0; }
	.hero--brackets i:nth-child(2) { top: 0; right: 0; border-left: 0; border-bottom: 0; }
	.hero--brackets i:nth-child(3) { bottom: 0; left: 0; border-right: 0; border-top: 0; }
	.hero--brackets i:nth-child(4) { bottom: 0; right: 0; border-left: 0; border-top: 0; }
	@keyframes hero-bracket {
		from { opacity: 0; transform: scale(1.6); }
		to { opacity: 0.75; transform: none; }
	}

	/* the promise, running on a loop in gold */
	.hero--ticker {
		position: relative;
		z-index: 2;
		margin-top: clamp(1.6rem, 4vw, 2.6rem);
		padding: 0.7rem 0;
		border-top: 1px solid color-mix(in srgb, var(--gold) 22%, transparent);
		border-bottom: 1px solid color-mix(in srgb, var(--gold) 22%, transparent);
		overflow: hidden;
		mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
		-webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
	}
	.hero--ticker-track {
		display: flex;
		width: max-content;
		animation: hero-ticker 26s linear infinite;
	}
	.hero--ticker:hover .hero--ticker-track { animation-play-state: paused; }
	@keyframes hero-ticker { to { transform: translateX(-50%); } }
	.hero--ticker-word {
		display: inline-flex;
		align-items: center;
		gap: clamp(1.2rem, 3vw, 2.4rem);
		padding-right: clamp(1.2rem, 3vw, 2.4rem);
		font-family: 'Bebas Neue', Impact, sans-serif;
		font-size: clamp(1.1rem, 2.2vw, 1.55rem);
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.72);
		white-space: nowrap;
	}
	.hero--ticker-star { font-style: normal; color: var(--gold); font-size: 0.7em; }

	html.perf-lite .hero--sweep,
	html.perf-lite .hero--ticker-track { animation: none !important; }
	html.perf-lite .hero--sweep { display: none; }
	html.perf-lite .hero--spotlight { display: none; }
	@media (prefers-reduced-motion: reduce) {
		.hero--sweep,
		.hero--ticker-track,
		.hero--goldline,
		.hero--goldline i,
		.hero--brackets i,
		.hero--eyebrow,
		.hero--imagine,
		.hero--weline,
		.hero--rule,
		.hero--sub,
		.hero--cta { animation: none !important; opacity: 1; transform: none; }
	}
	@media (max-width: 700px) {
		.hero--panels { opacity: 0.3; }
		.hero--brackets { inset: -0.5rem; }
		.hero--brackets i { width: 18px; height: 18px; }
	}

	/* ====== Deep glossy stage (matches the boardroom body) ====== */
	.hero--stage {
		color: #fff;
		isolation: isolate;
		background: #070910;
	}
	.hero--bgfill {
		position: absolute;
		top: 0;
		left: 50%;
		transform: translateX(-50%);
		width: 100vw;
		height: 100%;
		z-index: 0;
		pointer-events: none;
		background: radial-gradient(
				1200px 620px at 50% -8%,
				color-mix(in srgb, var(--view-accent) 22%, transparent),
				transparent 62%
			),
			radial-gradient(
				900px 500px at 12% 92%,
				color-mix(in srgb, var(--view-accent) 9%, transparent),
				transparent 65%
			),
			linear-gradient(180deg, #0a0d1c 0%, #070910 48%, #05060d 100%);
	}
	.hero--glow {
		position: absolute;
		top: -18%;
		left: 50%;
		transform: translateX(-50%);
		width: 70vw;
		max-width: 900px;
		height: 520px;
		background: radial-gradient(
			ellipse at center,
			color-mix(in srgb, var(--view-accent) 22%, transparent),
			transparent 70%
		);
		filter: blur(40px);
		z-index: 0;
		pointer-events: none;
		animation: hero-glow 16s ease-in-out infinite;
	}
	@keyframes hero-glow {
		0%, 100% { transform: translateX(-50%) translateY(0) scale(1); opacity: 1; }
		50% { transform: translateX(-50%) translateY(4%) scale(1.1); opacity: 0.82; }
	}
	/* a second, slow-drifting aurora orb for depth */
	.hero--bgfill::after {
		content: '';
		position: absolute;
		bottom: -10%;
		right: 4%;
		width: 46vw;
		max-width: 620px;
		height: 420px;
		border-radius: 50%;
		background: radial-gradient(ellipse at center, color-mix(in srgb, var(--view-accent) 14%, transparent), transparent 68%);
		filter: blur(60px);
		pointer-events: none;
		animation: hero-orb 22s ease-in-out infinite;
	}
	@keyframes hero-orb {
		0%, 100% { transform: translate(0, 0) scale(1); }
		50% { transform: translate(-6%, -5%) scale(1.14); }
	}

	/* lift content above glow */
	.hero--top,
	.hero--showcase,
	.hero--industries,
	.hero--scroll {
		position: relative;
		z-index: 2;
	}

	/* ====== Top copy ====== */
	.hero--top {
		text-align: center;
		max-width: 880px;
		margin: 0 auto;
		padding-top: clamp(2.5rem, 6vw, 5rem);
		display: grid;
		gap: 1.6rem;
		justify-items: center;
	}
	/* staggered entrance — the hero introduces itself */
	.hero--top > * { animation: hero-up 0.85s cubic-bezier(0.22, 1, 0.36, 1) both; }
	.hero--top > *:nth-child(1) { animation-delay: 0.06s; }
	.hero--top > *:nth-child(2) { animation-delay: 0.16s; }
	.hero--top > *:nth-child(3) { animation-delay: 0.28s; }
	.hero--top > *:nth-child(4) { animation-delay: 0.4s; }
	.hero--showcase { animation: hero-up 1s cubic-bezier(0.22, 1, 0.36, 1) 0.42s both; }
	@keyframes hero-up {
		from { opacity: 0; transform: translateY(24px); }
		to { opacity: 1; transform: translateY(0); }
	}
	.hero--eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.5rem 1.1rem;
		border-radius: 9999px;
		border: 1px solid rgba(255, 255, 255, 0.16);
		background: rgba(255, 255, 255, 0.05);
		backdrop-filter: blur(8px);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.78);
	}
	.hero--eyebrow-dot {
		width: 7px;
		height: 7px;
		border-radius: 9999px;
		background: var(--view-accent);
		box-shadow: 0 0 0 0 rgba(24, 222, 190, 0.55);
		animation: dot 2.4s infinite;
	}
	@keyframes dot {
		0% {
			box-shadow: 0 0 0 0 rgba(24, 222, 190, 0.5);
		}
		70% {
			box-shadow: 0 0 0 9px rgba(24, 222, 190, 0);
		}
		100% {
			box-shadow: 0 0 0 0 rgba(24, 222, 190, 0);
		}
	}

	.hero--display {
		font-weight: 800;
		text-transform: uppercase;
		line-height: 0.92;
		letter-spacing: 1px;
		font-size: clamp(3.2rem, 9vw, 7.5rem);
		margin: 0;
		color: #fff;
		-webkit-text-fill-color: #fff;
	}
	.hero--imagine {
		display: block;
	}
	.hero--weline {
		display: flex;
		gap: 0.3em;
		align-items: baseline;
		justify-content: center;
	}
	.hero--rotator {
		display: inline-grid;
	}
	.hero--rot {
		grid-area: 1 / 1;
		opacity: 0;
		transform: translateY(0.4em) rotateX(-50deg);
		animation: rotword 9.2s infinite;
		animation-delay: calc(var(--i) * 2.3s);
		will-change: opacity, transform;
		text-align: left;
		white-space: nowrap;
	}
	@keyframes rotword {
		0% {
			opacity: 0;
			transform: translateY(0.42em) rotateX(-55deg);
		}
		4%,
		21% {
			opacity: 1;
			transform: translateY(0) rotateX(0);
		}
		26%,
		100% {
			opacity: 0;
			transform: translateY(-0.42em) rotateX(55deg);
		}
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
	@media (prefers-reduced-motion: reduce) {
		.hero--rot {
			animation: none !important;
		}
		.hero--rot:first-child {
			opacity: 1;
			transform: none;
		}
	}
	.hero--sub {
		max-width: 640px;
		font-size: clamp(1.05rem, 1.5vw, 1.3rem);
		line-height: 1.7;
		color: rgba(255, 255, 255, 0.72);
	}
	.hero--cta {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		flex-wrap: wrap;
		justify-content: center;
		margin-top: 0.4rem;
	}
	.hero--textlink {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-weight: 600;
		color: #86e2ef;
		transition: gap 0.3s ease, color 0.3s ease;
	}
	.hero--textlink:hover {
		gap: 0.7rem;
		color: #fff;
	}
	.hero--tour {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.82rem;
		font-weight: 600;
		color: rgba(255, 255, 255, 0.8);
		padding: 0.7rem 1.1rem;
		border-radius: 9999px;
		border: 1px dashed rgba(255, 255, 255, 0.28);
		transition: border-color 0.25s ease, color 0.25s ease, background 0.25s ease;
	}
	.hero--tour:hover {
		border-color: var(--view-accent, #28a6ec);
		color: var(--view-accent, #28a6ec);
		background: color-mix(in srgb, var(--view-accent, #28a6ec) 10%, transparent);
	}

	/* business impact widget */
	.hero--impact {
		position: absolute;
		top: 14px;
		right: -22px;
		width: 188px;
		padding: 0.85rem 1rem;
		border-radius: 1rem;
		background: rgba(20, 21, 32, 0.72);
		border: 1px solid rgba(255, 255, 255, 0.12);
		backdrop-filter: blur(12px);
		box-shadow: 0 20px 40px -18px rgba(0, 0, 0, 0.7);
		z-index: 3;
	}
	.hero--impact-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 0.5rem;
	}
	.hero--impact-title {
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: rgba(255, 255, 255, 0.55);
	}
	.hero--impact-ringrow {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		margin: 0.55rem 0 0.45rem;
	}
	.hero--impact-ring {
		position: relative;
		width: 56px;
		height: 56px;
		flex-shrink: 0;
	}
	.hero--impact-ring svg {
		width: 100%;
		height: 100%;
		transform: rotate(-90deg);
	}
	.hero--impact-ring .ring-track {
		fill: none;
		stroke: rgba(255, 255, 255, 0.1);
		stroke-width: 5;
	}
