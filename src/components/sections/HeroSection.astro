---
// ══════════════════════════════════════════════════════════════════════
// Boardroom hero — the cinematic cover.
//
// Built to the reference the brief pointed at: Apple TV+. The media is
// not a card inside a column, it IS the stage — edge to edge, corner to
// corner, one screen tall. Over it: a short line and two pill buttons,
// bottom left. Under it: dots, arrows and a pause, the way a cover reel
// is steered. Nothing else.
//
// The frames are real work and real rooms, not stock. Frame three is the
// film itself, which only downloads once it comes up.
//
// Script contract kept (handleHero in MainLayout, tour.ts,
// boardroomView.ts): .hero--stage, [data-count-to], #hero-sectors +
// .hero--sector, .hero--photo-card, #boardroom-impact, .rhead, and
// [data-tour-start]. The tilt hooks (#hero-tilt, .hero--photo-spot) are
// deliberately gone — a full-bleed frame should not wobble under the
// pointer — and handleHero guards every one of its lookups, so their
// absence is a no-op rather than a break.
// ══════════════════════════════════════════════════════════════════════
import { Icon } from 'astro-icon/components';

const slides = [
	{
		id: 'promise',
		kind: 'photo' as const,
		src: '/images/hero-team.jpg',
		alt: 'The Swizel team — the designers and engineers who build your product with you',
		pos: '50% 30%',
		kicker: 'Swizel Technologies · building since 2019',
		title: 'You imagine it.<em>We build it.</em>',
		// the verb scrolls on this frame only — see .hero--rot
		rotate: ['build', 'design', 'ship', 'scale', 'grow'],
		cta: { href: '/contact', label: 'Start a project' },
		alt2: { href: '/portfolio', label: 'See the work' },
		eager: true,
	},
	{
		id: 'work',
		kind: 'photo' as const,
		src: '/images/founder/studio.jpg',
		alt: 'The Swizel studio floor in Abuja, mid build',
		pos: '50% 46%',
		kicker: 'The collection',
		title: 'Sixty-five products,<em>live in the market.</em>',
		cta: { href: '/portfolio', label: 'See the work' },
		alt2: { href: '/about', label: 'Meet the team' },
	},
	{
		id: 'build',
		// A film slot is ready here: give this frame `kind: 'film'`, a
		// `video:` path and a `src:` poster and it plays itself. It is a
		// photograph for now because the only footage on hand was a soft,
		// dim frame that let the whole cover down.
		kind: 'photo' as const,
		src: '/images/builder/the-table.jpg',
		alt: 'Four Swizel engineers around the table in Abuja, mid build',
		pos: '50% 38%',
		kicker: 'Inside the build',
		title: 'Two minutes,<em>sketch to launch.</em>',
		cta: { href: '/services', label: 'How we work' },
		alt2: { href: '/contact', label: 'Talk to us' },
	},
];

const proof = [
	{ to: 65, suffix: '+', label: 'products shipped' },
	{ to: 7, suffix: '+', label: 'years in business' },
	{ to: 10, suffix: '+', label: 'countries served' },
];

const sectors = [
	'Fintech', 'Healthtech', 'Agritech', 'Sports',
	'Real Estate', 'E-commerce', 'Education', 'Logistics',
	'Energy', 'Media', 'Hospitality', 'Government',
	'Travel', 'Manufacturing', 'Nonprofit',
];
---

<section
	class="hero--stage hero-view hero-boardroom hero--reel"
	data-bh
	aria-roledescription="carousel"
	aria-label="Swizel — what we build"
	tabindex="-1"
>
	<!-- Everything above the strip. The frames are absolute inside this,
	     not inside the section, so they stop at the strip's top edge
	     instead of running behind it. -->
	<div class="hero--cover">

	<!-- ── the frames ──────────────────────────────────────────── -->
	<div class="hero--frames hero--photo-card">
		{
			slides.map((s, i) => (
				<article
					class:list={['hero--slide', { 'is-on': i === 0 }]}
					data-bh-slide={s.id}
					aria-hidden={i !== 0}
					aria-roledescription="slide"
					aria-label={`${i + 1} of ${slides.length}`}
				>
					<div class="hero--media">
						{s.kind === 'film' ? (
							<video
								class="hero--film"
								data-bh-film
								data-src={s.video}
								poster={s.src}
								muted
								loop
								playsinline
								preload="none"
								aria-label={s.alt}
							/>
						) : (
							<img
								class="hero--img"
								src={s.src}
								alt={s.alt}
								style={`object-position:${s.pos}`}
								loading={s.eager ? 'eager' : 'lazy'}
								fetchpriority={s.eager ? 'high' : undefined}
								decoding="async"
							/>
						)}
						{s.kind === 'film' && (
							<img class="hero--img" src={s.src} alt="" style={`object-position:${s.pos}`} loading="lazy" decoding="async" />
						)}
					</div>

					<!-- the scrim: enough to read type on, never enough to
					     flatten the photograph -->
					<span class="hero--scrim" aria-hidden="true" />
					<span class="hero--vignette" aria-hidden="true" />

					<div class="hero--plate">
						<span class="hero--kicker">{s.kicker}</span>

						{s.rotate ? (
							<h1 class="hero--display rhead">
								<span class="hero--l1">You imagine it.</span>
								<span class="hero--l2">
									We{' '}
									<span class="hero--rot" aria-hidden="true">
										<span class="hero--rot-track">
											{s.rotate.map((wd) => <i>{wd}</i>)}
											<i>{s.rotate[0]}</i>
										</span>
									</span>{' '}
									it.
								</span>
								<span class="sr-only">We build, design, ship, scale and grow it.</span>
							</h1>
						) : (
							<p class="hero--display" set:html={s.title.replace('<em>', '<span class="hero--l2">').replace('</em>', '</span>')} />
						)}

						<div class="hero--cta">
							<a href={s.cta.href} class="hero--primary">
								{s.cta.label}
								<Icon width={16} name="mdi:arrow-right" />
							</a>
							<a href={s.alt2.href} class="hero--secondary">{s.alt2.label}</a>
							<button class="hero--tour" type="button" data-tour-start="boardroom">
								<Icon width={15} name="mdi:compass-outline" />
								Take the tour
							</button>
						</div>
					</div>
				</article>
			))
		}
	</div>

	<!-- ── the fixed furniture: proof, steering, and the way down ── -->
	<div class="hero--deck">
		<ul class="hero--proof">
			{
				proof.map((s) => (
					<li class="hero--proof-item">
						<span class="hero--proof-num" data-count-to={s.to} data-suffix={s.suffix}>
							{s.to}{s.suffix}
						</span>
						<span class="hero--proof-label">{s.label}</span>
					</li>
				))
			}
			<li class="hero--proof-item hero--proof-item--live" id="boardroom-impact" data-tour="impact">
				<span class="hero--proof-num">99.9%</span>
				<span class="hero--proof-label">uptime, 12 months</span>
			</li>
		</ul>

		<div class="hero--steer" role="tablist" aria-label="Choose a frame">
			<button class="hero--arrow" type="button" data-bh-prev aria-label="Previous frame">
				<Icon width={14} name="mdi:chevron-left" />
			</button>
			<span class="hero--dots">
				{
					slides.map((s, i) => (
						<button
							class:list={['hero--dot', { 'is-on': i === 0 }]}
							type="button"
							role="tab"
							data-bh-dot={i}
							aria-selected={i === 0}
							aria-label={`Frame ${i + 1}: ${s.kicker}`}
						>
							<i aria-hidden="true" />
						</button>
					))
				}
			</span>
			<button class="hero--arrow" type="button" data-bh-next aria-label="Next frame">
				<Icon width={14} name="mdi:chevron-right" />
			</button>
			<button class="hero--pause" type="button" data-bh-toggle aria-pressed="false" aria-label="Pause the reel">
				<Icon width={12} name="mdi:pause" class="hero--pause-a" />
				<Icon width={12} name="mdi:play" class="hero--pause-b" />
			</button>
		</div>
	</div>
	</div>

	<!-- ── the strip on the cover's floor: who we build for ────────
	     It lives inside the section on purpose. Outside it, none of
	     global.css's `html[data-view="x"] .hero-boardroom { display:none }`
	     rules reached it and it showed in all five worlds — and
	     handleHero, which scopes its lookups to .hero--stage, could not
	     find #hero-sectors to cycle. -->
	<div class="hero--rail">
		<span class="hero--rail-label">Built for</span>
		<ul class="hero--sectors" id="hero-sectors">
			{sectors.map((s, i) => <li class="hero--sector" style={`--si:${i}`}>{s}</li>)}
			<li class="hero--sector hero--sector-more">+ more</li>
		</ul>
		<a href="#about" class="hero--down" aria-label="Scroll to learn more">
			<Icon width={16} name="mdi:arrow-down" />
		</a>
	</div>
</section>

<style>
	/* ══════════════════════════════════════════════════════════════════
	   THE STAGE
	   Full bleed. The global rule
	   `body:has(.hero-view) .hero-view { margin-top:-nav-h; padding-top:nav-h }`
	   already slides this under the header and outranks anything set
	   here, so the top offset is left to it; the reel simply fills what
	   is left. The section is NOT wrapped in the site container — the
	   whole point is that the frame reaches the edges of the screen.
	   ══════════════════════════════════════════════════════════════════ */
	.hero--reel {
		--gold: #f7c66b;
		--acc: var(--view-accent, #28a6ec);
		--pad: clamp(1.25rem, 5vw, 4.5rem);
		position: relative;
		isolation: isolate;
		overflow: hidden;
		min-height: min(100svh, 1000px);
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		color: #ffffff;
		background: #04060e;
	}
	.hero--reel:focus { outline: none; }

	/* the cover: everything above the strip, and the box the frames are
	   absolute inside */
	.hero--cover {
		position: relative;
		flex: 1 1 auto;
		min-height: 0;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
	}

	/* ── the frames ── */
	/* The cover starts BELOW the section's top padding — global.css pads
	   .hero-view by the nav height so the bar has somewhere to sit. That
	   left the section's own near-black filling the strip behind the nav,
	   so the photograph appeared to stop dead under a black bar. The
	   frames reach up through that padding instead, and the picture runs
	   from the very first pixel of the screen. */
	.hero--frames {
		position: absolute;
		inset: calc(-1 * var(--nav-h, 92px)) 0 0 0;
		z-index: 0;
	}
	.hero--slide {
		position: absolute;
		inset: 0;
		opacity: 0;
		visibility: hidden;
		transition: opacity 1.05s cubic-bezier(0.4, 0, 0.2, 1), visibility 0s linear 1.05s;
	}
	.hero--slide.is-on {
		opacity: 1;
		visibility: visible;
		transition: opacity 1.05s cubic-bezier(0.4, 0, 0.2, 1), visibility 0s;
		z-index: 1;
	}

	.hero--media { position: absolute; inset: 0; overflow: hidden; }
	.hero--img,
	.hero--film {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	/* the still sits under the film and shows through until it plays */
	.hero--film { z-index: 1; background: #04060e; }
	/* a very slow push in, so the frame is alive without moving anything
	   the eye has to track */
	.hero--slide.is-on .hero--img,
	.hero--slide.is-on .hero--film {
		animation: hero-push 13s ease-out both;
	}
	@keyframes hero-push {
		from { transform: scale(1.005); }
		to { transform: scale(1.055); }
	}

	/* ── the scrim ──
	   Two layers: a strong foot the type sits on, and a corner wash that
	   keeps the top-left readable when the photograph is bright there. */
	.hero--scrim {
		position: absolute;
		inset: 0;
		z-index: 2;
		pointer-events: none;
		background:
			/* The top shade. It is not a bar and must never look like one:
			   the picture runs underneath it to the very first pixel of the
			   screen, and this is a long, smooth fall-off over roughly a
			   quarter of the stage — the way a room darkens toward a
			   ceiling. It exists because white nav ink on a bright frame
			   measures 1.4:1 without it, which is unreadable; with it, and
			   with the shade the nav carries on its own ink, every frame
			   clears AA. */
			linear-gradient(180deg, rgba(4, 6, 14, 0.82) 0%, rgba(4, 6, 14, 0.64) 8%, rgba(4, 6, 14, 0.2) 17%, rgba(4, 6, 14, 0) 28%),
			linear-gradient(0deg, rgba(4, 6, 14, 0.95) 0%, rgba(4, 6, 14, 0.82) 26%, rgba(4, 6, 14, 0.3) 54%, rgba(4, 6, 14, 0) 78%),
			/* the type lives at the left: this is what it has to stay
			   legible against, measured off the rendered pixels rather
			   than guessed at */
			linear-gradient(100deg, rgba(4, 6, 14, 0.86) 0%, rgba(4, 6, 14, 0.52) 30%, rgba(4, 6, 14, 0.12) 54%, rgba(4, 6, 14, 0) 70%);
	}
	.hero--vignette {
		position: absolute;
		inset: 0;
		z-index: 2;
		pointer-events: none;
		background: radial-gradient(130% 100% at 50% 46%, transparent 48%, rgba(4, 6, 14, 0.45) 100%);
	}

	/* ══════════════════════════════════════════════════════════════════
	   THE PLATE
	   Bottom left, the way a cover reel titles a frame. Sentence case,
	   tight tracking, one line of support, two pills.
	   ══════════════════════════════════════════════════════════════════ */
	.hero--plate {
		position: absolute;
		z-index: 3;
		left: var(--pad);
		right: var(--pad);
		bottom: clamp(7rem, 15vh, 10rem);
		max-width: 46rem;
	}
	.hero--kicker {
		display: block;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.62);
	}
	/* ── glass ──────────────────────────────────────────────────
	   The letterforms are a pane, not paint: a thin translucent body you
	   read the photograph through, a lit rim where the edge catches the
	   light, and a soft drop beneath so the pane sits above the picture
	   rather than in it. `paint-order` puts the rim behind the body, so
	   the counters stay open and the type keeps its shape at size.

	   It is a real trade: translucent type cannot measure the way solid
	   white does. The rim carries the legibility, the kicker and the
	   buttons stay solid, and nothing the page has to say depends on
	   reading this through the glass alone. */
	.hero--display {
		margin: clamp(0.7rem, 1.6vh, 1.1rem) 0 0;
		font-size: clamp(2.5rem, 6vw, 5.2rem);
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 0.96;
		color: rgba(255, 255, 255, 0.11);
		/* the rim never drops below a hair, however small the type gets */
		-webkit-text-stroke: max(1px, 0.021em) rgba(255, 255, 255, 0.97);
		paint-order: stroke fill;
		text-wrap: balance;
		text-shadow:
			/* the bloom a lit edge throws onto what is behind it */
			0 0 0.55em rgba(255, 255, 255, 0.14),
			0 0.13em 0.42em rgba(4, 6, 14, 0.6),
			0 0.02em 0.1em rgba(4, 6, 14, 0.55);
	}
	/* never more than two lines: past that the cover stops being a cover */
	.hero--display :global(.hero--l1),
	.hero--display :global(.hero--l2),
	.hero--l1,
	.hero--l2 {
		display: block;
		overflow: hidden;
		white-space: nowrap;
		text-overflow: clip;
	}
	/* the answering line is the same glass, its rim one step softer */
	.hero--display :global(.hero--l2),
	.hero--l2 { -webkit-text-stroke-color: rgba(255, 255, 255, 0.78); }

	/* ── the verb, on a reel of its own ──
	   A fixed window with the words stacked behind it; the track steps
	   through them and lands back where it started, so the loop never
	   jumps. The window sizes itself to the longest word, so "it." never
	   moves while the verb changes. */
	.hero--rot {
		display: inline-block;
		overflow: hidden;
		height: 1.16em;
		line-height: 1.16em;
		vertical-align: -0.2em;
		/* the script sets the width to the live word; this is the closing
		   up of the sentence behind it */
		transition: width 0.62s cubic-bezier(0.76, 0, 0.24, 1);
	}
	.hero--rot-track {
		display: block;
		transition: transform 0.62s cubic-bezier(0.76, 0, 0.24, 1);
	}
	.hero--rot i {
		display: block;
		width: max-content;
		height: 1.16em;
		line-height: 1.16em;
		font-style: normal;
		/* The jewel keeps its gold and keeps its body: solid where the
		   rest is glass, so the word that changes is the one thing your
		   eye lands on. */
		-webkit-text-stroke: 0;
		text-shadow: 0 0.14em 0.4em rgba(4, 6, 14, 0.5);
		background: linear-gradient(100deg, #ffffff 6%, #f0e0bd 28%, var(--gold) 56%, #ffe9bd 78%, #ffffff 96%);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		-webkit-text-fill-color: transparent;
	}


	/* each frame brings its own title in, a beat after the image */
	.hero--slide.is-on .hero--kicker { animation: hero-rise 0.85s cubic-bezier(0.22, 1, 0.36, 1) 0.14s both; }
	.hero--slide.is-on .hero--display { animation: hero-rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.24s both; }
	.hero--slide.is-on .hero--cta { animation: hero-rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.46s both; }
	@keyframes hero-rise {
		from { opacity: 0; transform: translateY(16px); }
		to { opacity: 1; transform: none; }
	}

	/* ── the pills ── */
	.hero--cta {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		flex-wrap: wrap;
		margin-top: clamp(1.1rem, 2.4vh, 1.7rem);
	}
	.hero--primary,
	.hero--secondary {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.82rem 1.55rem;
		border-radius: 9999px;
		font-size: 0.94rem;
		font-weight: 650;
		letter-spacing: 0.005em;
		white-space: nowrap;
		transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1), background 0.25s ease,
			border-color 0.25s ease, box-shadow 0.25s ease;
	}
	.hero--primary {
		color: #06111c;
		background: #ffffff;
		box-shadow: 0 10px 30px -12px rgba(0, 0, 0, 0.6);
	}
	.hero--primary:hover { transform: translateY(-1px); background: #ffffff; box-shadow: 0 16px 38px -12px rgba(0, 0, 0, 0.7); }
	.hero--secondary {
		color: #ffffff;
		border: 1px solid rgba(255, 255, 255, 0.34);
		background: rgba(255, 255, 255, 0.08);
		backdrop-filter: blur(14px) saturate(140%);
		-webkit-backdrop-filter: blur(14px) saturate(140%);
	}
	.hero--secondary:hover {
		transform: translateY(-1px);
		border-color: rgba(255, 255, 255, 0.6);
		background: rgba(255, 255, 255, 0.16);
	}

	/* ══════════════════════════════════════════════════════════════════
	   THE DECK
	   Proof on the left, steering on the right, both on the floor of the
	   frame — one row, out of the photograph's way.
	   ══════════════════════════════════════════════════════════════════ */
	/* Three columns: proof, steering, and a deliberately empty third —
	   the floating chat button lives in that bottom-right corner, and a
	   control parked under it cannot be pressed. */
	.hero--deck {
		position: relative;
		z-index: 4;
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: clamp(1.5rem, 4vw, 3rem);
		/* the floating chat button owns the bottom-right corner: the deck
		   stops short of it, so no control is ever parked underneath */
		padding: 0 calc(var(--pad) + 4.25rem) clamp(1.5rem, 3.5vh, 2.4rem) var(--pad);
	}
	.hero--steer { flex: none; }

	.hero--proof {
		display: flex;
		align-items: flex-start;
		gap: clamp(1rem, 2.4vw, 2rem);
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.hero--proof-item { display: grid; gap: 0.1rem; min-width: 0; }
	.hero--proof-item + .hero--proof-item {
		padding-left: clamp(1rem, 2.4vw, 2rem);
		border-left: 1px solid rgba(255, 255, 255, 0.16);
	}
	.hero--proof-num {
		font-size: clamp(0.98rem, 1.25vw, 1.18rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.1;
		color: #ffffff;
	}
	.hero--proof-label {
		font-size: 0.68rem;
		color: rgba(255, 255, 255, 0.6);
		white-space: nowrap;
	}
	/* the uptime figure keeps a live dot, because it is a live number */
	.hero--proof-item--live .hero--proof-num::after {
		content: '';
		display: inline-block;
		width: 6px;
		height: 6px;
		margin-left: 0.4rem;
		vertical-align: 0.34em;
		border-radius: 50%;
		background: #3ddc97;
		box-shadow: 0 0 0 0 rgba(61, 220, 151, 0.6);
		animation: hero-ping 2.6s ease-out infinite;
	}
	@keyframes hero-ping {
		0% { box-shadow: 0 0 0 0 rgba(61, 220, 151, 0.5); }
		70% { box-shadow: 0 0 0 7px rgba(61, 220, 151, 0); }
		100% { box-shadow: 0 0 0 0 rgba(61, 220, 151, 0); }
	}

	/* ── steering ── */
	.hero--steer {
		display: flex;
		align-items: center;
		gap: 0.34rem;
		padding: 0.26rem 0.32rem;
		border-radius: 9999px;
		border: 1px solid rgba(255, 255, 255, 0.16);
		background: rgba(10, 14, 26, 0.5);
		backdrop-filter: blur(18px) saturate(150%);
		-webkit-backdrop-filter: blur(18px) saturate(150%);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.16);
	}
	.hero--arrow,
	.hero--pause {
		display: grid;
		place-items: center;
		width: 1.75rem;
		height: 1.75rem;
		border-radius: 50%;
		color: rgba(255, 255, 255, 0.8);
		cursor: pointer;
