---
// ══════════════════════════════════════════════════════════════════════
// Boardroom hero — the cover of the whole site.
//
// This is the view most people land in, so it has one job: in the first
// screen, without a scroll, say who we are and make the room feel
// expensive. The rules it is built on, taken from the pages that do this
// best (Apple, Linear, Stripe):
//
//   · One idea, in sentence case, at size, with tight negative tracking.
//     Confidence comes from restraint, not from shouting in condensed
//     caps or rotating a verb every two seconds.
//   · One primary action. Everything else steps back a weight.
//   · One hero object, properly lit and given room.
//   · One light gesture in the background. Not four.
//   · The empty space is the point.
//
// The previous hero ran 2.4 screens tall and stacked seven competing
// elements down the middle: rotating headline, badge, uptime ring,
// brackets, stat rail, industry chips, gold ticker, scroll cue. It now
// resolves to a single screen, asymmetric, with the proof gathered into
// one quiet line and the industries pinned along the foot.
//
// Script contract kept intact (see handleHero in MainLayout, tour.ts,
// boardroomView.ts): .hero--stage, [data-count-to], #hero-tilt +
// .hero--photo-inner + .hero--photo-spot, .hero--spotlight, #hero-sectors
// + .hero--sector, .hero--photo-card, #boardroom-impact, .rhead, and
// [data-tour-start].
// ══════════════════════════════════════════════════════════════════════
import { Icon } from 'astro-icon/components';
import Section from '../HTML/Section.astro';

// The proof, gathered into one line instead of scattered across badges.
const proof = [
	{ to: 65, suffix: '+', label: 'products shipped' },
	{ to: 7, suffix: '+', label: 'years in business' },
	{ to: 10, suffix: '+', label: 'countries served' },
];

const sectors = [
	'Fintech',
	'Healthtech',
	'Agritech',
	'Sports',
	'Real Estate',
	'E-commerce',
	'Education',
	'Logistics',
];
---

<Section
	sectionClass="hero--stage hero-view hero-boardroom relative overflow-hidden"
	divClass="relative z-10"
>
	<!-- ── the room ──────────────────────────────────────────────
	     A deep field, one soft light behind the headline, fine
	     panelling for surface, a horizon rule for architecture, and
	     the pointer light the layout script drives. -->
	<div class="hero--bgfill" aria-hidden="true"></div>
	<div class="hero--glow" aria-hidden="true"></div>
	<div class="hero--panels" aria-hidden="true"></div>
	<div class="hero--horizon" aria-hidden="true"></div>
	<div class="hero--spotlight" aria-hidden="true"></div>
	<span class="hero--goldline" aria-hidden="true">
		{Array.from({ length: 9 }).map((_, i) => <i style={`--i:${i}`} />)}
	</span>

	<div class="hero--room">
		<!-- ── the statement ──────────────────────────────────── -->
		<div class="hero--copy">
			<span class="hero--status">
				<i class="hero--status-dot" aria-hidden="true"></i>
				Building since 2019 · Abuja, shipping to 10 countries
			</span>

			<h1 class="hero--display rhead">
				<span class="hero--l1">You imagine it.</span>
				<span class="hero--l2">We build it.</span>
			</h1>

			<p class="hero--sub">
				One senior team for design, engineering, marketing and the
				years after launch. Web and mobile products that businesses
				actually run on.
			</p>

			<div class="hero--cta">
				<a href="/contact" class="hero--primary">
					<span class="hero--primary-sheen" aria-hidden="true"></span>
					Start a project
					<Icon width={17} name="mdi:arrow-right" />
				</a>
				<a href="/portfolio" class="hero--secondary">
					See the work
					<Icon width={16} name="mdi:arrow-right" />
				</a>
			</div>

			<button class="hero--tour" type="button" data-tour-start="boardroom">
				<Icon width={15} name="mdi:compass-outline" />
				Take the two-minute tour
			</button>

			<ul class="hero--proof">
				{
					proof.map((s, i) => (
						<li class="hero--proof-item" style={`--i:${i}`}>
							<span class="hero--proof-num" data-count-to={s.to} data-suffix={s.suffix}>
								{s.to}{s.suffix}
							</span>
							<span class="hero--proof-label">{s.label}</span>
						</li>
					))
				}
			</ul>
		</div>

		<!-- ── the object ─────────────────────────────────────────
		     One card, lit like a product shot: a glass rim, a
		     specular that follows the pointer, and a single piece of
		     proof frosted over the corner. -->
		<div class="hero--object">
			<div class="hero--photo-card" id="hero-tilt">
				<div class="hero--photo-inner">
					<img
						class="hero--photo"
						src="/images/hero-team.jpg"
						alt="The Swizel team — the designers and engineers who build your product with you"
						width="856"
						height="580"
						fetchpriority="high"
						decoding="async"
					/>
					<span class="hero--photo-grade" aria-hidden="true"></span>
					<span class="hero--photo-spot" aria-hidden="true"></span>
					<span class="hero--photo-sheen" aria-hidden="true"></span>
					<span class="hero--photo-ring" aria-hidden="true"></span>
				</div>

				<div class="hero--impact" id="boardroom-impact" data-tour="impact">
					<span class="hero--impact-ring" aria-hidden="true">
						<svg viewBox="0 0 64 64">
							<circle class="ring-track" cx="32" cy="32" r="26" />
							<circle class="ring-arc" cx="32" cy="32" r="26" />
						</svg>
					</span>
					<span class="hero--impact-meta">
						<span class="hero--impact-num">99.9%</span>
						<span class="hero--impact-label">uptime, 12 months</span>
					</span>
				</div>

			</div>

			<span class="hero--caption">
				<span class="hero--caption-stars" aria-hidden="true">★★★★★</span>
				5.0 average client rating
			</span>
		</div>
	</div>

	<!-- ── the foot: who we build for, along the bottom edge ── -->
	<div class="hero--rail">
		<span class="hero--rail-label">Built for</span>
		<ul class="hero--sectors" id="hero-sectors">
			{sectors.map((s, i) => <li class="hero--sector" style={`--si:${i}`}>{s}</li>)}
			<li class="hero--sector hero--sector-more">+ more</li>
		</ul>
		<a href="#about" class="hero--scroll" aria-label="Scroll to learn more">
			<span></span>
		</a>
	</div>
</Section>

<style>
	/* ══════════════════════════════════════════════════════════════════
	   THE ROOM
	   Every background layer is transform/opacity only, sits behind the
	   content, and stands still under html.perf-lite.

	   GOTCHA kept from the old file: `.hero--stage` lives on the <Section>
	   wrapper, which this component's scoped styles cannot reach — a
	   variable declared there never lands, and every color-mix() using it
	   silently drops the whole declaration. Stage-level rules go through
	   :global(.hero-boardroom), which is unique to this hero.
	   ══════════════════════════════════════════════════════════════════ */
	.hero--bgfill,
	.hero--glow,
	.hero--panels,
	.hero--horizon,
	.hero--spotlight,
	.hero--goldline,
	.hero--goldline i,
	.hero--room,
	.hero--rail {
		--gold: #f7c66b;
		--acc: var(--view-accent, #28a6ec);
	}

	:global(.hero-boardroom) {
		/* one screen, never more — but never so tall on a short laptop
		   that the foot rail is pushed under the fold */
		/* One screen, never more — but never so tall on a short laptop that
		   the foot rail is pushed under the fold.

		   The top offset is not ours to set: global.css runs
		   `body:has(.hero-view) .hero-view { margin-top: -nav-h;
		   padding-top: nav-h }` so the stage slides under the header and
		   its background runs behind the nav. That selector outranks ours,
		   so a padding-top here would be silently dropped. Breathing room
		   above the content goes on .hero--room instead. */
		min-height: min(100svh, 980px);
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding-bottom: 0;
		color: #f4f6fb;
		background: #060913;
	}
	:global(html:not(.dark)) :global(.hero-boardroom) {
		color: #14162a;
		background: #f5f8fc;
	}

	.hero--bgfill {
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		background:
			radial-gradient(1100px 620px at 22% 8%, rgba(40, 166, 236, 0.13), transparent 62%),
			radial-gradient(900px 560px at 88% 78%, rgba(40, 166, 236, 0.08), transparent 64%),
			linear-gradient(180deg, #080c18 0%, #060913 52%, #04060e 100%);
	}

	/* the one light gesture: a soft ellipse sitting behind the headline */
	.hero--glow {
		position: absolute;
		z-index: 0;
		top: 12%;
		left: -6%;
		width: 62%;
		height: 62%;
		pointer-events: none;
		background: radial-gradient(
			closest-side,
			color-mix(in srgb, var(--acc) 26%, transparent),
			transparent 72%
		);
		filter: blur(64px);
		opacity: 0.75;
		animation: hero-breathe 13s ease-in-out infinite;
	}
	@keyframes hero-breathe {
		0%, 100% { transform: scale(1) translate3d(0, 0, 0); opacity: 0.7; }
		50% { transform: scale(1.09) translate3d(1.5%, -1.5%, 0); opacity: 0.9; }
	}

	/* fine vertical panelling: surface, not decoration */
	.hero--panels {
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		opacity: 0.5;
		background-image: repeating-linear-gradient(
			90deg,
			transparent 0 132px,
			rgba(255, 255, 255, 0.045) 132px 133px
		);
		mask-image: linear-gradient(180deg, #000 0%, #000 58%, transparent 94%);
		-webkit-mask-image: linear-gradient(180deg, #000 0%, #000 58%, transparent 94%);
	}

	/* a single horizon rule — the architecture of a room, drawn once */
	.hero--horizon {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 26%;
		height: 1px;
		z-index: 0;
		pointer-events: none;
		background: linear-gradient(
			90deg,
			transparent,
			rgba(255, 255, 255, 0.09) 18%,
			rgba(255, 255, 255, 0.09) 82%,
			transparent
		);
	}

	/* the house light, driven by the layout's pointer handler */
	.hero--spotlight {
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		background: radial-gradient(
			460px 460px at var(--hx, 50%) var(--hy, 30%),
			rgba(255, 255, 255, 0.05),
			transparent 70%
		);
		transition: background 0.2s linear;
	}

	/* the gold hairline across the very top of the stage */
	.hero--goldline {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 1px;
		z-index: 2;
		background: linear-gradient(90deg, transparent, var(--gold), transparent);
		opacity: 0.45;
		transform: scaleX(0);
		animation: hero-goldline 1.6s cubic-bezier(0.22, 1, 0.36, 1) 0.25s both;
	}
	.hero--goldline i {
		position: absolute;
		top: 0;
		left: calc(var(--i) * 12.5%);
		width: 1px;
		height: 7px;
		background: linear-gradient(180deg, var(--gold), transparent);
		opacity: 0.5;
	}
	@keyframes hero-goldline {
		to { transform: scaleX(1); }
	}

	/* ══════════════════════════════════════════════════════════════════
	   THE COMPOSITION
	   Asymmetric, not centred. A centred stack of eyebrow, headline, sub
	   and buttons is the template look; weight on the left with the
	   object to the right reads considered, and gives the type a margin
	   to align to.
	   ══════════════════════════════════════════════════════════════════ */
	.hero--room {
		position: relative;
		z-index: 1;
		display: grid;
		gap: clamp(2rem, 5vw, 4.5rem);
		align-items: center;
	}
	@media (min-width: 1000px) {
		.hero--room { grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr); }
	}

	.hero--copy { max-width: 36rem; }

	/* the status line: a fact, told quietly, with a light that says we
	   are open — not a pill that shouts a statistic */
	.hero--status {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: rgba(244, 246, 251, 0.52);
		animation: hero-rise 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.1s both;
	}
	.hero--status-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		flex: none;
		background: #3ddc97;
		box-shadow: 0 0 0 0 rgba(61, 220, 151, 0.55);
		animation: hero-ping 2.6s ease-out infinite;
	}
	@keyframes hero-ping {
		0% { box-shadow: 0 0 0 0 rgba(61, 220, 151, 0.5); }
		70% { box-shadow: 0 0 0 8px rgba(61, 220, 151, 0); }
		100% { box-shadow: 0 0 0 0 rgba(61, 220, 151, 0); }
	}

	/* ── the statement ──
	   Sentence case, not condensed caps. Tight negative tracking is what
	   makes large type read as deliberate rather than merely big. */
	.hero--display {
		margin: clamp(1rem, 2vh, 1.6rem) 0 0;
		font-size: clamp(2.6rem, 5.6vw, 4.6rem);
		font-weight: 800;
		letter-spacing: -0.038em;
		line-height: 0.98;
		text-wrap: balance;
	}
	.hero--l1,
	.hero--l2 { display: block; }
	.hero--l1 {
		color: #ffffff;
		animation: hero-rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.18s both;
	}
	/* the answering line, in polished metal: white through platinum
	   through the room's own gold, drifting slowly. One accent, not a
	   rainbow — a cyan-to-teal gradient reads startup, not boardroom. */
	.hero--l2 {
		background: linear-gradient(
			100deg,
			#ffffff 4%,
			#cfe4f5 26%,
			color-mix(in srgb, var(--acc) 72%, #ffffff) 46%,
			var(--gold) 68%,
			#ffffff 94%
		);
		background-size: 220% 100%;
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		-webkit-text-fill-color: transparent;
		animation:
			hero-rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.3s both,
			hero-sheen 11s ease-in-out 1.2s infinite;
	}
	@keyframes hero-sheen {
		0%, 100% { background-position: 0% 50%; }
		50% { background-position: 100% 50%; }
	}
	@keyframes hero-rise {
		from { opacity: 0; transform: translateY(18px); }
		to { opacity: 1; transform: none; }
	}

	.hero--sub {
		margin: clamp(1rem, 2.2vh, 1.5rem) 0 0;
		max-width: 33rem;
		font-size: clamp(1rem, 1.15vw, 1.12rem);
		line-height: 1.62;
		color: rgba(244, 246, 251, 0.66);
		animation: hero-rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.42s both;
	}

	/* ── the actions ──
	   One primary. The second steps back a full weight, and the tour
	   sits below them both as a quiet third. */
	.hero--cta {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		flex-wrap: wrap;
		margin-top: clamp(1.3rem, 2.8vh, 2rem);
		animation: hero-rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.54s both;
	}
	.hero--primary {
		position: relative;
		overflow: hidden;
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.95rem 1.7rem;
		border-radius: 9999px;
		font-size: 0.95rem;
		font-weight: 700;
		letter-spacing: 0.01em;
		color: #05121c;
		background: linear-gradient(180deg, #7fd3ff 0%, var(--acc) 48%, #1585c9 100%);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.55),
			0 1px 0 rgba(255, 255, 255, 0.12),
			0 18px 40px -16px color-mix(in srgb, var(--acc) 75%, transparent);
		transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.28s ease;
	}
	.hero--primary:hover {
		transform: translateY(-2px);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.6),
			0 24px 52px -16px color-mix(in srgb, var(--acc) 90%, transparent);
	}
	.hero--primary:active { transform: translateY(0); }
	/* a highlight that travels the button once you reach for it */
	.hero--primary-sheen {
		position: absolute;
		top: 0;
		bottom: 0;
		left: -60%;
		width: 45%;
		pointer-events: none;
		background: linear-gradient(100deg, transparent, rgba(255, 255, 255, 0.5), transparent);
		transform: skewX(-18deg);
		transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.hero--primary:hover .hero--primary-sheen { transform: translateX(360%) skewX(-18deg); }

	.hero--secondary {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.95rem 1.4rem;
		border-radius: 9999px;
		font-size: 0.95rem;
		font-weight: 650;
		color: rgba(244, 246, 251, 0.9);
		border: 1px solid rgba(255, 255, 255, 0.16);
		background: rgba(255, 255, 255, 0.03);
		backdrop-filter: blur(10px);
		transition: border-color 0.28s ease, background 0.28s ease, gap 0.28s ease;
	}
	.hero--secondary:hover {
		gap: 0.7rem;
		border-color: rgba(255, 255, 255, 0.34);
		background: rgba(255, 255, 255, 0.07);
	}

	.hero--tour {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		margin-top: 1rem;
		font-size: 0.83rem;
		font-weight: 600;
		color: rgba(244, 246, 251, 0.5);
		cursor: pointer;
		transition: color 0.25s ease, gap 0.25s ease;
		animation: hero-rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.62s both;
	}
	.hero--tour:hover { color: rgba(244, 246, 251, 0.92); gap: 0.62rem; }

	/* ── the proof ──
	   Three figures on one line with hairlines between them. The badges
	   and the stat rail that used to carry this are gone. */
	.hero--proof {
		display: flex;
		align-items: flex-start;
		gap: clamp(1.1rem, 2.6vw, 2.2rem);
		list-style: none;
		margin: clamp(1.5rem, 3.2vh, 2.4rem) 0 0;
		padding: clamp(1.1rem, 2.4vh, 1.6rem) 0 0;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
		animation: hero-rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.7s both;
	}
	.hero--proof-item {
		display: grid;
		gap: 0.12rem;
		min-width: 0;
	}
	.hero--proof-item + .hero--proof-item {
		padding-left: clamp(1.1rem, 2.6vw, 2.2rem);
		border-left: 1px solid rgba(255, 255, 255, 0.1);
	}
	.hero--proof-num {
		font-size: clamp(1.35rem, 2.1vw, 1.75rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.1;
		color: #ffffff;
	}
	.hero--proof-label {
		font-size: 0.76rem;
		letter-spacing: 0.01em;
		color: rgba(244, 246, 251, 0.5);
		white-space: nowrap;
	}

	/* ══════════════════════════════════════════════════════════════════
	   THE OBJECT
	   Lit like a product shot: a glass rim catching light at the top, a
	   specular that follows the pointer, one frosted proof chip, and a
	   long soft shadow so it sits above the room rather than on it.
	   ══════════════════════════════════════════════════════════════════ */
	.hero--object {
		position: relative;
		animation: hero-rise 1s cubic-bezier(0.22, 1, 0.36, 1) 0.34s both;
	}
	.hero--photo-card {
		position: relative;
		border-radius: clamp(1.1rem, 1.8vw, 1.6rem);
		padding: 8px;
		background: linear-gradient(
			150deg,
			rgba(255, 255, 255, 0.16),
			rgba(255, 255, 255, 0.04) 42%,
			color-mix(in srgb, var(--acc) 22%, transparent)
		);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.28),
			0 60px 110px -46px rgba(0, 0, 0, 0.92),
			0 24px 60px -34px color-mix(in srgb, var(--acc) 50%, transparent);
		transform: perspective(1100px);
		transform-style: preserve-3d;
		transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
		will-change: transform;
	}
	.hero--photo-inner {
		position: relative;
		overflow: hidden;
		border-radius: calc(clamp(1.1rem, 1.8vw, 1.6rem) - 6px);
		aspect-ratio: 16 / 11;
	}
	.hero--photo {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 32%;
	}
	/* a cinema grade: lift the blacks toward the room's blue so the
	   photograph belongs to the page rather than sitting on it */
	.hero--photo-grade {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background:
			linear-gradient(180deg, rgba(4, 8, 18, 0) 38%, rgba(4, 8, 18, 0.62) 100%),
			linear-gradient(120deg, color-mix(in srgb, var(--acc) 20%, transparent), transparent 60%);
		mix-blend-mode: multiply;
		opacity: 0.85;
	}
	/* the pointer specular, positioned by the layout script */
	.hero--photo-spot {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: radial-gradient(
			280px 280px at var(--mx, 50%) var(--my, 40%),
			rgba(255, 255, 255, 0.16),
			transparent 68%
		);
	}
	/* the glass: one bright edge along the top, the way real glass
	   catches a ceiling light */
	.hero--photo-sheen {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: linear-gradient(
			168deg,
			rgba(255, 255, 255, 0.22) 0%,
			rgba(255, 255, 255, 0.05) 14%,
			transparent 34%
		);
	}
	.hero--photo-ring {
		position: absolute;
		inset: 0;
		pointer-events: none;
		border-radius: inherit;
		box-shadow:
			inset 0 0 0 1px rgba(255, 255, 255, 0.14),
