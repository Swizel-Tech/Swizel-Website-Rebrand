---
// ══════════════════════════════════════════════════════════════════════
// Boardroom hero — the cinematic cover.
//
// Built to the reference the brief pointed at: Apple TV+. The media is
// not a card inside a column, it IS the stage — edge to edge, corner to
// corner, one screen tall. Over it: a short line and two pill buttons,
// bottom left. Under it: dots, arrows and a pause, the way a cover reel
// is steered. Nothing else.
//
// The frames are real work and real rooms, not stock. Frame three is the
// film itself, which only downloads once it comes up.
//
// Script contract kept (handleHero in MainLayout, tour.ts,
// boardroomView.ts): .hero--stage, [data-count-to], #hero-sectors +
// .hero--sector, .hero--photo-card, #boardroom-impact, .rhead, and
// [data-tour-start]. The tilt hooks (#hero-tilt, .hero--photo-spot) are
// deliberately gone — a full-bleed frame should not wobble under the
// pointer — and handleHero guards every one of its lookups, so their
// absence is a no-op rather than a break.
// ══════════════════════════════════════════════════════════════════════
import { Icon } from 'astro-icon/components';

// The frames are pictures, nothing more. The cover says one thing and
// keeps saying it; what changes behind it is the room. A film slot is
// still here: give a frame `kind: 'film'`, a `video:` path and a `src:`
// poster and it plays itself.
// One backdrop, and it is the film. A YouTube id, mounted through the
// IFrame API — which is also what lets the transport below actually drive
// it rather than just decorate it.
const FILM = {
	ytId: 'R2jdjZwv-ZE',
	poster: '/images/builder/at-the-keys.jpg',
	alt: 'Inside a Swizel build — the engineers, the stack and the ship',
	pos: '50% 42%',
};

// the one thing the cover says, and the verb that turns inside it
const VERBS = ['build', 'design', 'ship', 'scale', 'grow'];

const proof = [
	{ to: 65, suffix: '+', label: 'products shipped' },
	{ to: 7, suffix: '+', label: 'years in business' },
	{ to: 10, suffix: '+', label: 'countries served' },
];

const sectors = [
	'Fintech', 'Healthtech', 'Agritech', 'Sports',
	'Real Estate', 'E-commerce', 'Education', 'Logistics',
	'Energy', 'Media', 'Hospitality', 'Government',
	'Travel', 'Manufacturing', 'Nonprofit',
];
---

<section
	class="hero--stage hero-view hero-boardroom hero--reel"
	data-bh
	aria-roledescription="carousel"
	aria-label="Swizel — what we build"
	tabindex="-1"
>
	<!-- Everything above the strip. The frames are absolute inside this,
	     not inside the section, so they stop at the strip's top edge
	     instead of running behind it. -->
	<div class="hero--cover">

	<!-- ── the backdrop ── -->
	<div class="hero--frames hero--photo-card">
		<div class="hero--media">
			<img
				class="hero--img"
				src={FILM.poster}
				alt={FILM.alt}
				style={`object-position:${FILM.pos}`}
				fetchpriority="high"
				decoding="async"
			/>
			<div class="hero--yt" data-bh-yt={FILM.ytId} aria-hidden="true"></div>
		</div>
		<span class="hero--scrim" aria-hidden="true" />
		<span class="hero--vignette" aria-hidden="true" />
	</div>

	<!-- ── the plate: said once, and left alone ── -->
	<div class="hero--plate">
		<span class="hero--kicker">Swizel Tech Ltd · Est. 2019</span>

		<h1 class="hero--display rhead">
			<span class="hero--l1">You imagine.</span>
			<span class="hero--l2">
				We{' '}
				<span class="hero--rot" aria-hidden="true">
					<span class="hero--rot-track">
						{VERBS.map((wd) => <i>{wd}</i>)}
						<i>{VERBS[0]}</i>
					</span>
				</span>
			</span>
			<span class="sr-only">We build, design, ship, scale and grow.</span>
		</h1>

		<div class="hero--cta">
			<a href="/contact" class="hero--primary">
				Start a project
				<Icon width={16} name="mdi:arrow-right" />
			</a>
			<a href="/portfolio" class="hero--secondary">See the work</a>
			<button class="hero--tour" type="button" data-tour-start="boardroom" aria-label="Take the tour">
				<Icon width={14} name="mdi:map-marker-path" />
				Tour
			</button>
		</div>
	</div>

	<!-- ── the fixed furniture: proof, steering, and the way down ── -->
	<div class="hero--deck">
		<ul class="hero--proof">
			{
				proof.map((s) => (
					<li class="hero--proof-item">
						<span class="hero--proof-num" data-count-to={s.to} data-suffix={s.suffix}>
							{s.to}{s.suffix}
						</span>
						<span class="hero--proof-label">{s.label}</span>
					</li>
				))
			}
			<li class="hero--proof-item hero--proof-item--live" id="boardroom-impact" data-tour="impact">
				<span class="hero--proof-num">99.9%</span>
				<span class="hero--proof-label">uptime, 12 months</span>
			</li>
		</ul>

		<!-- The film's transport. Four marks, no shell, no labels: back
		     ten, play, on ten, sound. It is the only furniture the
		     backdrop needs now that there is nothing to steer between. -->
		<div class="hero--transport" data-bh-transport>
			<button class="hero--tbtn" type="button" data-bh-back aria-label="Back ten seconds">
				<Icon width={15} name="mdi:rewind-10" />
			</button>
			<button class="hero--tbtn hero--tbtn--play" type="button" data-bh-play aria-label="Pause the film">
				<Icon width={14} name="mdi:pause" class="hero--t-a" />
				<Icon width={14} name="mdi:play" class="hero--t-b" />
			</button>
			<button class="hero--tbtn" type="button" data-bh-fwd aria-label="Forward ten seconds">
				<Icon width={15} name="mdi:fast-forward-10" />
			</button>
			<button class="hero--tbtn hero--tbtn--sound" type="button" data-bh-mute aria-pressed="true" aria-label="Unmute the film">
				<Icon width={15} name="mdi:volume-off" class="hero--t-a" />
				<Icon width={15} name="mdi:volume-high" class="hero--t-b" />
			</button>
		</div>
	</div>
	</div>

	<!-- ── the strip on the cover's floor: who we build for ────────
	     It lives inside the section on purpose. Outside it, none of
	     global.css's `html[data-view="x"] .hero-boardroom { display:none }`
	     rules reached it and it showed in all five worlds — and
	     handleHero, which scopes its lookups to .hero--stage, could not
	     find #hero-sectors to cycle. -->
	<div class="hero--rail">
		<span class="hero--rail-label">Built for</span>
		<ul class="hero--sectors" id="hero-sectors">
			{sectors.map((s, i) => <li class="hero--sector" style={`--si:${i}`}>{s}</li>)}
			<li class="hero--sector hero--sector-more">+ more</li>
		</ul>
		<a href="#about" class="hero--down" aria-label="Scroll to learn more">
			<Icon width={16} name="mdi:arrow-down" />
		</a>
	</div>
</section>

<style>
	/* ══════════════════════════════════════════════════════════════════
	   THE STAGE
	   Full bleed. The global rule
	   `body:has(.hero-view) .hero-view { margin-top:-nav-h; padding-top:nav-h }`
	   already slides this under the header and outranks anything set
	   here, so the top offset is left to it; the reel simply fills what
	   is left. The section is NOT wrapped in the site container — the
	   whole point is that the frame reaches the edges of the screen.
	   ══════════════════════════════════════════════════════════════════ */
	.hero--reel {
		--gold: #f7c66b;
		--acc: var(--view-accent, #28a6ec);
		--pad: clamp(1.25rem, 5vw, 4.5rem);
		position: relative;
		isolation: isolate;
		overflow: hidden;
		min-height: min(100svh, 1000px);
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		color: #ffffff;
		background: #04060e;
	}
	.hero--reel:focus { outline: none; }

	/* the cover: everything above the strip, and the box the frames are
	   absolute inside */
	.hero--cover {
		position: relative;
		flex: 1 1 auto;
		min-height: 0;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
	}

	/* ── the frames ── */
	/* The cover starts BELOW the section's top padding — global.css pads
	   .hero-view by the nav height so the bar has somewhere to sit. That
	   left the section's own near-black filling the strip behind the nav,
	   so the photograph appeared to stop dead under a black bar. The
	   frames reach up through that padding instead, and the picture runs
	   from the very first pixel of the screen. */
	.hero--frames {
		position: absolute;
		inset: calc(-1 * var(--nav-h, 92px)) 0 0 0;
		z-index: 0;
	}
	.hero--media { position: absolute; inset: 0; overflow: hidden; }
	.hero--img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	/* the still shows through until the film is up and running */
	/* A YouTube backdrop. The iframe cannot be object-fit, so it is given
	   the smallest 16/9 box that still covers the frame and centred, with
	   the overflow clipped by .hero--media. It never takes a click:
	   everything here is scenery. */
	.hero--yt {
		position: absolute;
		inset: 0;
		z-index: 1;
		overflow: hidden;
		opacity: 0;
		transition: opacity 0.8s ease;
	}
	.hero--yt.is-live { opacity: 1; }
	/* Once it is up it stays up. Fading the film out on a state change
	   would show the still underneath as a flash — the backdrop is meant
	   to be continuous. */
	.hero--yt :global(iframe) {
		position: absolute;
		top: 50%;
		left: 50%;
		width: max(100%, 177.78vh);
		height: max(100%, 56.25vw);
		min-width: 100%;
		min-height: 100%;
		max-width: none;
		transform: translate(-50%, -50%);
		border: 0;
		pointer-events: none;
	}
	/* a very slow push in on the still, so the cover is alive even before
	   the film has arrived */
	.hero--img { animation: hero-push 16s ease-out both; }
	@keyframes hero-push {
		from { transform: scale(1.005); }
		to { transform: scale(1.055); }
	}

	/* ── the scrim ──
	   Two layers: a strong foot the type sits on, and a corner wash that
	   keeps the top-left readable when the photograph is bright there. */
	.hero--scrim {
		position: absolute;
		inset: 0;
		z-index: 3;
		pointer-events: none;
		background:
			/* The top shade. It is not a bar and must never look like one:
			   the picture runs underneath it to the very first pixel of the
			   screen, and this is a long, smooth fall-off over roughly a
			   quarter of the stage — the way a room darkens toward a
			   ceiling. It exists because white nav ink on a bright frame
			   measures 1.4:1 without it, which is unreadable; with it, and
			   with the shade the nav carries on its own ink, every frame
			   clears AA. */
			linear-gradient(180deg, rgba(4, 6, 14, 0.82) 0%, rgba(4, 6, 14, 0.64) 8%, rgba(4, 6, 14, 0.2) 17%, rgba(4, 6, 14, 0) 28%),
			linear-gradient(0deg, rgba(4, 6, 14, 0.95) 0%, rgba(4, 6, 14, 0.82) 26%, rgba(4, 6, 14, 0.3) 54%, rgba(4, 6, 14, 0) 78%),
			/* the type lives at the left: this is what it has to stay
			   legible against, measured off the rendered pixels rather
			   than guessed at */
			linear-gradient(100deg, rgba(4, 6, 14, 0.86) 0%, rgba(4, 6, 14, 0.52) 30%, rgba(4, 6, 14, 0.12) 54%, rgba(4, 6, 14, 0) 70%);
	}
	.hero--vignette {
		position: absolute;
		inset: 0;
		z-index: 3;
		pointer-events: none;
		background: radial-gradient(130% 100% at 50% 46%, transparent 48%, rgba(4, 6, 14, 0.45) 100%);
	}

	/* ══════════════════════════════════════════════════════════════════
	   THE PLATE
	   Bottom left, the way a cover reel titles a frame. Sentence case,
	   tight tracking, one line of support, two pills.
	   ══════════════════════════════════════════════════════════════════ */
	.hero--plate {
		position: absolute;
		z-index: 3;
		/* it belongs to the cover, not to any one frame — the pictures
		   change behind it and it never moves or re-animates */
		left: var(--pad);
		right: var(--pad);
		bottom: clamp(7rem, 15vh, 10rem);
		max-width: 46rem;
	}
	.hero--kicker {
		display: block;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.62);
	}
	/* Solid again. The pane was handsome up close and too faint at a
	   glance — a cover has to land from across the room. */
	.hero--display {
		margin: clamp(0.7rem, 1.6vh, 1.1rem) 0 0;
		font-size: clamp(2.5rem, 6vw, 5.2rem);
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 0.96;
		color: #ffffff;
		text-wrap: balance;
		text-shadow: 0 0.04em 0.5em rgba(4, 6, 14, 0.55), 0 0.01em 0.08em rgba(4, 6, 14, 0.45);
	}
	/* never more than two lines: past that the cover stops being a cover */
	.hero--display :global(.hero--l1),
	.hero--display :global(.hero--l2),
	.hero--l1,
	.hero--l2 {
		display: block;
		overflow: hidden;
		white-space: nowrap;
		text-overflow: clip;
	}
	/* the answering line, one step back from the first */
	.hero--display :global(.hero--l2),
	.hero--l2 { color: rgba(255, 255, 255, 0.82); }

	/* ── the verb, on a reel of its own ──
	   A fixed window with the words stacked behind it; the track steps
	   through them and lands back where it started, so the loop never
	   jumps. The window sizes itself to the longest word, so "it." never
	   moves while the verb changes. */
	.hero--rot {
		display: inline-block;
		overflow: hidden;
		height: 1.16em;
		line-height: 1.16em;
		vertical-align: -0.2em;
		/* the script sets the width to the live word; this is the closing
		   up of the sentence behind it */
		transition: width 0.62s cubic-bezier(0.76, 0, 0.24, 1);
	}
	.hero--rot-track {
		display: block;
		transition: transform 0.62s cubic-bezier(0.76, 0, 0.24, 1);
	}
	.hero--rot i {
		display: block;
		width: max-content;
		height: 1.16em;
		line-height: 1.16em;
		font-style: normal;
		/* The word that changes is the one thing the eye lands on, and it
		   wears the house colour: Swizel's sky blue, lit through white. */
		text-shadow: 0 0.04em 0.5em rgba(4, 6, 14, 0.5);
		background: linear-gradient(100deg, #ffffff 4%, #cfeaff 24%, var(--acc) 54%, #8fd4ff 76%, #ffffff 96%);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		-webkit-text-fill-color: transparent;
	}


	/* the cover introduces itself once, then stays put */
	.hero--kicker { animation: hero-rise 0.85s cubic-bezier(0.22, 1, 0.36, 1) 0.14s both; }
	.hero--display { animation: hero-rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.24s both; }
	.hero--cta { animation: hero-rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.46s both; }
	@keyframes hero-rise {
		from { opacity: 0; transform: translateY(16px); }
		to { opacity: 1; transform: none; }
	}

	/* ── the pills ── */
	.hero--cta {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		flex-wrap: wrap;
		margin-top: clamp(1.1rem, 2.4vh, 1.7rem);
	}
	.hero--primary,
	.hero--secondary {
		display: inline-flex;
		align-items: center;
		gap: 0.42rem;
		padding: 0.66rem 1.3rem;
		border-radius: 9999px;
		font-size: 0.86rem;
		font-weight: 650;
		letter-spacing: 0.005em;
		white-space: nowrap;
		transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1), background 0.25s ease,
			border-color 0.25s ease, box-shadow 0.25s ease;
	}
	.hero--primary {
		color: #06111c;
		background: #ffffff;
		box-shadow: 0 10px 30px -12px rgba(0, 0, 0, 0.6);
	}
	.hero--primary:hover { transform: translateY(-1px); background: #ffffff; box-shadow: 0 16px 38px -12px rgba(0, 0, 0, 0.7); }
	.hero--secondary {
		color: #ffffff;
		border: 1px solid rgba(255, 255, 255, 0.34);
		background: rgba(255, 255, 255, 0.08);
		backdrop-filter: blur(14px) saturate(140%);
		-webkit-backdrop-filter: blur(14px) saturate(140%);
	}
	.hero--secondary:hover {
		transform: translateY(-1px);
		border-color: rgba(255, 255, 255, 0.6);
		background: rgba(255, 255, 255, 0.16);
	}

	/* ══════════════════════════════════════════════════════════════════
	   THE DECK
	   Proof on the left, steering on the right, both on the floor of the
	   frame — one row, out of the photograph's way.
	   ══════════════════════════════════════════════════════════════════ */
	/* Three columns: proof, steering, and a deliberately empty third —
	   the floating chat button lives in that bottom-right corner, and a
	   control parked under it cannot be pressed. */
	.hero--deck {
		position: relative;
		z-index: 4;
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: clamp(1.5rem, 4vw, 3rem);
		/* the floating chat button owns the bottom-right corner: the deck
		   stops short of it, so no control is ever parked underneath */
		padding: 0 calc(var(--pad) + 4.25rem) clamp(1.5rem, 3.5vh, 2.4rem) var(--pad);
	}
	/* ── the proof ──
	   Three figures and the live one, on a single line with hairlines
	   between them. */
	.hero--proof {
		display: flex;
		align-items: flex-start;
		gap: clamp(1rem, 2.4vw, 2rem);
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.hero--proof-item { display: grid; gap: 0.1rem; min-width: 0; }
	.hero--proof-item + .hero--proof-item {
		padding-left: clamp(1rem, 2.4vw, 2rem);
		border-left: 1px solid rgba(255, 255, 255, 0.16);
	}
	.hero--proof-num {
		font-size: clamp(0.98rem, 1.25vw, 1.18rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.1;
		color: #ffffff;
	}
	.hero--proof-label {
		font-size: 0.68rem;
		color: rgba(255, 255, 255, 0.6);
		white-space: nowrap;
	}
	/* the uptime figure keeps a live dot, because it is a live number */
	.hero--proof-item--live .hero--proof-num::after {
		content: '';
		display: inline-block;
		width: 6px;
		height: 6px;
		margin-left: 0.4rem;
		vertical-align: 0.34em;
		border-radius: 50%;
		background: #3ddc97;
		box-shadow: 0 0 0 0 rgba(61, 220, 151, 0.6);
		animation: hero-ping 2.6s ease-out infinite;
	}
	@keyframes hero-ping {
		0% { box-shadow: 0 0 0 0 rgba(61, 220, 151, 0.5); }
		70% { box-shadow: 0 0 0 7px rgba(61, 220, 151, 0); }
		100% { box-shadow: 0 0 0 0 rgba(61, 220, 151, 0); }
	}

	/* ── the transport ─────────────────────────────────────────
	   Four marks on the floor of the cover. No shell, no labels, no
	   fill — the film is the thing; this is only how you hold it. */
	.hero--transport {
		display: flex;
		align-items: center;
		gap: 0.15rem;
		flex: none;
	}
	.hero--tbtn {
		position: relative;
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		border: 0;
		border-radius: 50%;
		background: transparent;
		color: rgba(255, 255, 255, 0.62);
		cursor: pointer;
		transition: color 0.22s ease, background 0.22s ease;
	}
	.hero--tbtn:hover { color: #ffffff; background: rgba(255, 255, 255, 0.1); }
	/* small to look at, still big enough for a thumb */
	.hero--tbtn::before {
		content: '';
		position: absolute;
		top: 50%;
		left: 50%;
		width: 44px;
		height: 44px;
		transform: translate(-50%, -50%);
	}
	/* One mark at a time, and each button reads its OWN state. These used
	   to be written unscoped, so the play rule reached into the sound
	   button too: with the film not running it hid that button's first
	   mark, the sound rule hid its second, and the control rendered as an
	   empty circle. */
	.hero--tbtn--play .hero--t-b { display: none; }
	:global(.hero--reel:not(.is-filmplaying)) .hero--tbtn--play .hero--t-a { display: none; }
	:global(.hero--reel:not(.is-filmplaying)) .hero--tbtn--play .hero--t-b { display: block; }

	.hero--tbtn--sound .hero--t-b { display: none; }
	:global(.hero--reel:not(.is-filmmuted)) .hero--tbtn--sound .hero--t-a { display: none; }
	:global(.hero--reel:not(.is-filmmuted)) .hero--tbtn--sound .hero--t-b { display: block; }
	:global(.hero--reel:not(.is-filmmuted)) .hero--tbtn--sound { color: #ffffff; }

	/* ── the tour ──
	   The third choice: same pill shape as the other two, none of their
	   weight — no ring, no fill, just the word and its mark. */
	.hero--tour {
		display: inline-flex;
		align-items: center;
		gap: 0.42rem;
		padding: 0.55rem 0.9rem;
		border-radius: 9999px;
		font-size: 0.8rem;
		font-weight: 550;
		letter-spacing: 0.05em;
		color: rgba(255, 255, 255, 0.72);
		border: 0;
		background: transparent;
		white-space: nowrap;
		cursor: pointer;
		transition: color 0.25s ease, gap 0.25s ease;
	}
	.hero--tour:hover { color: #ffffff; gap: 0.56rem; }

	/* ══════════════════════════════════════════════════════════════════
	   THE STRIP
	   Directly under the cover, the way a cover reel is followed by a row
	   of tiles. Dark in both themes so the cover runs into it.
	   ══════════════════════════════════════════════════════════════════ */
	.hero--rail {
		--acc: var(--view-accent, #28a6ec);
		position: relative;
		/* shown only in this world — see the class it carries */
		z-index: 1;
		display: flex;
		align-items: center;
		gap: 0.85rem;
		padding: 0.62rem clamp(1.25rem, 5vw, 4.5rem);
		color: #ffffff;
		background: #04060e;
		border-top: 1px solid rgba(255, 255, 255, 0.07);
	}
	.hero--rail-label {
		flex: none;
		font-size: 0.6rem;
		font-weight: 700;
		letter-spacing: 0.2em;
