---
// Services hub · Campus world — the course catalogue. Same disciplines data
// as every other view, told as departments you can enrol with (or hire).
// Root carries `cbody` (campus engine: .cp-rev reveals) and `csvc` (motion
// engine: tilt / glare / magnetic / .fa-journey draw).
import { Icon } from 'astro-icon/components';
import { disciplines } from '../../data/disciplines';

const semester = [
	{ n: 'Wk 1', title: 'Research', room: 'Studio 1', desc: 'We learn the market, the user and the goal before anything is sketched.' },
	{ n: 'Wk 2', title: 'Plan', room: 'The board room', desc: 'Directions explored boldly, so you see the thinking and not just the result.' },
	{ n: 'Wk 3+', title: 'Build', room: 'The lab', desc: 'Design and engineering in the same room, refined until it works beautifully.' },
	{ n: 'Demo', title: 'Ship & grow', room: 'Lecture hall', desc: 'Launched, polished and alive, then marketed and maintained by the same team.' },
];

const sectors = ['Fintech', 'Real estate', 'Sports', 'E-commerce', 'Education', 'Healthcare', 'Logistics', 'Beauty', 'Energy', 'Media'];
---

<div class="csvc cbody view-body view-body-campus">
	<!-- ── A · registration desk ───────────────────────────── -->
	<section class="cv-sec">
		<div class="cv-wrap cv-open">
			<div class="cv-copy cp-rev">
				<span class="cv-badge">🗂️ Course registration · Always open</span>
				<h2 class="cv-h cv-h--xl">
					Strategy, design, code, and growth, <em>all under one roof.</em>
				</h2>
				<p class="cv-p">
					See how our team builds, launches, and scales digital
					products, and learn the exact skills driving each stage.
				</p>
				<div class="cv-row">
					<a href="/contact" class="cv-cta fa-cta">
						Hire a Department
						<Icon width={16} name="mdi:arrow-right" />
					</a>
					<a href="/programs" class="cv-link">
						<Icon width={17} name="mdi:school-outline" />
						Apply for a place
					</a>
				</div>
			</div>

			<!-- the pinboard: today's notices, on cork with real tacks -->
			<div class="cv-pinboard cp-rev" data-cursor="pen" data-fa-tilt="3">
				<span class="cv-pb-head">
					<i aria-hidden="true"></i>
					Notice board
					<em>today</em>
				</span>
				<span class="cv-note cv-note--y" style="--r:-2.4deg">
					<i class="cv-tack" aria-hidden="true"></i>
					65+ products shipped by this faculty
				</span>
				<span class="cv-note cv-note--b" style="--r:1.8deg">
					<i class="cv-tack" aria-hidden="true"></i>
					all six departments take commissions
				</span>
				<span class="cv-note cv-note--p" style="--r:-1.2deg">
					<i class="cv-tack" aria-hidden="true"></i>
					demo friday, every friday
				</span>
			</div>
		</div>
	</section>

	<!-- ── B · the course catalogue ────────────────────────── -->
	<section class="cv-sec" data-cursor="book">
		<div class="cv-wrap">
			<div class="cv-head cp-rev">
				<span class="cv-kick">📚 The catalogue</span>
				<h2 class="cv-h">Pick a <em>department.</em></h2>
			</div>
			<div class="cv-depts">
				{
					disciplines.map((d, i) => (
						<a
							href={`/services/${d.slug}`}
							class="cv-dept cp-rev"
							style={`--c:${d.color}; --i:${i % 3}; --tilt:${((i % 3) - 1) * 0.5}deg`}
							data-cursor={d.cursor}
						>
							{/* the wire binding, sitting over the top edge */}
							<span class="cv-rings" aria-hidden="true">
								{Array.from({ length: 7 }).map(() => <i />)}
							</span>
							<span class="cv-page">
								<span class="cv-glare" aria-hidden="true" />
								<span class="cv-dept-top">
									<span class="cv-dept-ic"><Icon width={22} name={d.icon} /></span>
									<span class="cv-dept-code">SWZ {Number(d.n)}01</span>
								</span>
								<h3 class="cv-dept-t">{d.title}</h3>
								<p class="cv-dept-tag">{d.tagline}</p>
								<p class="cv-dept-d">{d.desc}</p>
								<span class="cv-dept-chips">
									{d.items.slice(0, 4).map((it) => <i>{it}</i>)}
								</span>
								<span class="cv-dept-enter">
									View the department
									<Icon width={14} name="mdi:arrow-right" />
								</span>
								<span class="cv-curl" aria-hidden="true" />
							</span>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<!-- ── C · how a term runs ─────────────────────────────── -->
	<section class="cv-sec" data-cursor="pen">
		<div class="cv-wrap">
			<div class="cv-head cp-rev">
				<span class="cv-kick">🗓️ The term plan</span>
				<h2 class="cv-h">How a project <em>gets built.</em></h2>
			</div>
			<!-- the term, written up as a timetable rather than a list -->
			<div class="cv-tt cp-rev" data-cv-tt>
				<div class="cv-tt-head">
					<span class="cv-tt-title">Term timetable</span>
					<span class="cv-tt-meta">Four periods · one product</span>
				</div>
				<div class="cv-tt-grid">
					{
						semester.map((w, i) => (
							<article class="cv-tt-cell" style={`--i:${i}`}>
								<span class="cv-tt-period">
									<i>Period {i + 1}</i>
									<b>{w.n}</b>
								</span>
								<h3 class="cv-tt-t">{w.title}</h3>
								<p class="cv-tt-d">{w.desc}</p>
								<span class="cv-tt-room">
									<Icon width={12} name="mdi:map-marker-outline" />
									{w.room}
								</span>
								<span class="cv-tt-underline" aria-hidden="true"></span>
							</article>
						))
					}
				</div>
				<span class="cv-tt-foot" aria-hidden="true">bell rings when it ships</span>
			</div>
		</div>
	</section>

	<!-- ── D · field-work belt ─────────────────────────────── -->
	<section class="cv-sec cv-sec--belt">
		<div class="cv-wrap">
			<div class="cv-head cp-rev">
				<span class="cv-kick">🧭 Field work</span>
				<h2 class="cv-h">Sectors we've <em>worked in.</em></h2>
			</div>
		</div>
		<div class="cv-belt" aria-hidden="true">
			<div class="cv-belt-track">
				{
					[0, 1].map(() =>
						sectors.map((x) => <span class="cv-bword">{x}&nbsp;✏️&nbsp;</span>)
					)
				}
			</div>
		</div>
	</section>

	<!-- ── E · the final bell ──────────────────────────────── -->
	<section class="cv-sec cv-sec--cta" data-cursor="phone">
		<div class="cv-wrap cv-cta-box cp-rev">
			<span class="cv-badge">🔔 Office hours · always</span>
			<h2 class="cv-h cv-h--cta">Which department does <em>your idea</em> need?</h2>
			<p class="cv-p cv-p--center">
				Not sure? Bring the brief and we will walk the halls together.
				Most projects end up visiting more than one department anyway.
			</p>
			<div class="cv-cta-row">
				<a href="/contact" class="cv-cta fa-cta">
					Talk to a project manager
					<Icon width={17} name="mdi:arrow-right" />
				</a>
				<a href="/portfolio" class="cv-call">
					<span class="cv-call-or">or</span>
					See what we've shipped
					<Icon width={16} name="mdi:arrow-right" />
				</a>
			</div>
		</div>
	</section>
</div>

<style>
	/* ── Campus Services — the school dress. ── */
	.csvc {
		--cp-ink: #fdf6ea;
		--cp-muted: rgba(253, 246, 234, 0.62);
		--cp-faint: rgba(253, 246, 234, 0.4);
		--cp-acc: var(--view-accent, #f59e0b);
		--cp-acc2: #fb7185;
		--cp-line: rgba(255, 255, 255, 0.09);
		--cp-card: rgba(255, 255, 255, 0.035);
		--cp-marker: 'Bradley Hand', 'Segoe Print', 'Comic Sans MS', cursive;
		font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
		position: relative;
		isolation: isolate;
		overflow: hidden;
		background:
			radial-gradient(1000px 540px at 82% -6%, rgba(245, 158, 11, 0.13), transparent 62%),
			radial-gradient(820px 480px at 6% 44%, rgba(251, 113, 133, 0.07), transparent 60%),
			linear-gradient(180deg, #120c04 0%, #160f08 50%, #0e0903 100%);
		color: var(--cp-ink);
		padding: clamp(2rem, 4vw, 3rem) clamp(1rem, 3vw, 2rem) clamp(2.5rem, 5vw, 4rem);
		transition: background 0.4s ease, color 0.4s ease;
	}
	:global(html:not(.dark)) .csvc {
		--cp-ink: #2b1c08;
		--cp-muted: rgba(43, 28, 8, 0.68);
		--cp-faint: rgba(43, 28, 8, 0.46);
		--cp-acc: #b45309;
		--cp-line: rgba(43, 28, 8, 0.1);
		--cp-card: rgba(43, 28, 8, 0.045);
		background:
			radial-gradient(1000px 540px at 82% -6%, rgba(245, 158, 11, 0.14), transparent 62%),
			linear-gradient(180deg, #fdf4e3 0%, #faecd4 55%, #fdf4e3 100%);
	}

	/* Each band gets its own ground, cycling so the page has a rhythm, and
	   drawn twice: warm amber on the dark, ink on cream in daylight. */
	.cv-sec {
		position: relative;
		isolation: isolate;
		padding-block: clamp(2rem, 4.5vw, 3.5rem);
	}
	.cv-sec::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		-webkit-mask-image: linear-gradient(180deg, transparent, #000 8%, #000 92%, transparent);
		mask-image: linear-gradient(180deg, transparent, #000 8%, #000 92%, transparent);
	}
	.cv-sec:nth-of-type(3n + 1)::before {
		background:
			radial-gradient(2px 2px at 20% 24%, color-mix(in srgb, var(--cp-acc) 45%, transparent), transparent 60%),
			radial-gradient(2px 2px at 72% 70%, color-mix(in srgb, var(--cp-acc2) 40%, transparent), transparent 60%),
			radial-gradient(56% 44% at 14% 2%, color-mix(in srgb, var(--cp-acc) 17%, transparent), transparent 66%);
	}
	.cv-sec:nth-of-type(3n + 2)::before {
		background:
			repeating-linear-gradient(180deg, transparent 0 40px, color-mix(in srgb, var(--cp-acc) 10%, transparent) 40px 41px),
			linear-gradient(90deg, transparent 6.5%, rgba(239, 68, 68, 0.16) 6.5%, rgba(239, 68, 68, 0.16) calc(6.5% + 1px), transparent calc(6.5% + 1px));
	}
	.cv-sec:nth-of-type(3n)::before {
		background:
			repeating-linear-gradient(90deg, transparent 0 23px, color-mix(in srgb, var(--cp-acc) 5%, transparent) 23px 24px),
			repeating-linear-gradient(180deg, transparent 0 23px, color-mix(in srgb, var(--cp-acc) 4%, transparent) 23px 24px),
			repeating-linear-gradient(90deg, transparent 0 119px, color-mix(in srgb, var(--cp-acc) 12%, transparent) 119px 120px),
			repeating-linear-gradient(180deg, transparent 0 119px, color-mix(in srgb, var(--cp-acc) 10%, transparent) 119px 120px);
	}
	:global(html:not(.dark)) .csvc .cv-sec:nth-of-type(3n + 1)::before {
		background:
			radial-gradient(2px 2px at 20% 24%, rgba(146, 64, 14, 0.32), transparent 60%),
			radial-gradient(2px 2px at 72% 70%, rgba(190, 24, 93, 0.26), transparent 60%),
			radial-gradient(56% 44% at 14% 2%, rgba(245, 158, 11, 0.18), transparent 66%);
	}
	:global(html:not(.dark)) .csvc .cv-sec:nth-of-type(3n + 2)::before {
		background:
			repeating-linear-gradient(180deg, transparent 0 40px, rgba(59, 130, 246, 0.15) 40px 41px),
			linear-gradient(90deg, transparent 6.5%, rgba(220, 38, 38, 0.28) 6.5%, rgba(220, 38, 38, 0.28) calc(6.5% + 1px), transparent calc(6.5% + 1px));
	}
	:global(html:not(.dark)) .csvc .cv-sec:nth-of-type(3n)::before {
		background:
			repeating-linear-gradient(90deg, transparent 0 23px, rgba(37, 99, 235, 0.07) 23px 24px),
			repeating-linear-gradient(180deg, transparent 0 23px, rgba(37, 99, 235, 0.06) 23px 24px),
			repeating-linear-gradient(90deg, transparent 0 119px, rgba(37, 99, 235, 0.16) 119px 120px),
			repeating-linear-gradient(180deg, transparent 0 119px, rgba(37, 99, 235, 0.13) 119px 120px);
	}
	.cv-sec--cta { padding-bottom: clamp(1.5rem, 3vw, 2.5rem); }
	.cv-wrap { max-width: 76rem; margin: 0 auto; }

	.cv-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-family: ui-monospace, monospace;
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		line-height: 1.6; /* tight when the label wraps on phones */
		text-transform: uppercase;
		color: var(--cp-acc);
		border: 1px solid color-mix(in srgb, var(--cp-acc) 40%, transparent);
		background: color-mix(in srgb, var(--cp-acc) 9%, transparent);
		padding: 0.4rem 0.9rem;
		border-radius: 9999px;
		margin-bottom: 1.1rem;
	}
	.cv-kick {
		display: block;
		font-family: ui-monospace, monospace;
		font-size: 0.74rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--cp-acc);
		margin-bottom: 0.6rem;
	}
	.cv-h {
		font-size: clamp(1.9rem, 4vw, 3rem);
		font-weight: 850;
		letter-spacing: -0.02em;
		line-height: 1.05;
		margin: 0 0 0.9rem;
	}
	.cv-h--xl { font-size: clamp(2.4rem, 5.5vw, 4.2rem); line-height: 1; }
	.cv-h--cta { font-size: clamp(2rem, 4.6vw, 3.4rem); }
	.cv-h em {
		font-style: normal;
		background: linear-gradient(95deg, var(--cp-acc), var(--cp-acc2));
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}
	.cv-p {
		font-size: clamp(0.98rem, 1.5vw, 1.12rem);
		line-height: 1.7;
		color: var(--cp-muted);
		max-width: 34rem;
		margin: 0 0 1.4rem;
	}
	.cv-p--center { text-align: center; margin-inline: auto; max-width: 38rem; }
	.cv-head { text-align: center; margin-bottom: clamp(1.5rem, 3vw, 2.25rem); }
	/* An underlined phrase beside a solid button reads as a footnote. Same
	   height and shape as its neighbour, outlined rather than filled. */
	.cv-link {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.95rem 1.7rem;
		border-radius: 9999px;
		font-weight: 800;
		font-size: 0.95rem;
		color: var(--cp-ink);
		border: 1.5px solid color-mix(in srgb, var(--cp-acc) 55%, transparent);
		background: color-mix(in srgb, var(--cp-acc) 8%, transparent);
		transition: background 0.28s ease, border-color 0.28s ease,
			transform 0.28s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.28s ease;
	}
	.cv-link :global(svg) { color: var(--cp-acc); transition: transform 0.28s ease; }
	.cv-link:hover {
		transform: translateY(-2px);
		border-color: var(--cp-acc);
		background: color-mix(in srgb, var(--cp-acc) 16%, transparent);
		box-shadow: 0 16px 32px -18px color-mix(in srgb, var(--cp-acc) 70%, transparent);
	}
	.cv-link:hover :global(svg) { transform: scale(1.12); }
	.cv-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.95rem 1.8rem;
		border-radius: 9999px;
		font-weight: 800;
		font-size: 0.95rem;
		color: #2b1500;
		background: linear-gradient(95deg, #fbbf24, var(--cp-acc));
		box-shadow: 0 18px 44px -16px color-mix(in srgb, var(--cp-acc) 80%, transparent);
		transition: box-shadow 0.25s ease, filter 0.25s ease;
		will-change: transform;
	}
	.cv-cta:hover { filter: brightness(1.06); }
	.cv-row { display: flex; align-items: center; gap: 1.2rem; flex-wrap: wrap; }
	.cv-call {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.95rem 1.6rem;
		border-radius: 9999px;
		font-size: 0.92rem;
		font-weight: 800;
		color: var(--cp-ink);
		border: 1.5px solid color-mix(in srgb, var(--cp-acc) 55%, transparent);
		background: color-mix(in srgb, var(--cp-acc) 8%, transparent);
		transition: background 0.28s ease, border-color 0.28s ease,
			transform 0.28s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.28s ease;
	}
	.cv-call-or { font-weight: 500; font-size: 0.82rem; color: var(--cp-faint); }
	.cv-call :global(svg) { color: var(--cp-acc); transition: transform 0.28s ease; }
	.cv-call:hover {
		transform: translateY(-2px);
		border-color: var(--cp-acc);
		background: color-mix(in srgb, var(--cp-acc) 16%, transparent);
		box-shadow: 0 16px 32px -18px color-mix(in srgb, var(--cp-acc) 70%, transparent);
	}
	.cv-call:hover :global(svg) { transform: translateX(3px); }
	@media (max-width: 480px) {
		.cv-row, .cv-cta-row { flex-direction: column; align-items: stretch; }
		.cv-row > *, .cv-cta-row > * { width: 100%; justify-content: center; }
	}

	.cv-glare {
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background: radial-gradient(320px 200px at var(--gx, 50%) var(--gy, 20%), color-mix(in srgb, var(--c, var(--cp-acc)) 12%, transparent), transparent 70%);
		opacity: 0;
		transition: opacity 0.3s ease;
		pointer-events: none;
	}
	[data-fa-tilt]:hover .cv-glare { opacity: 1; }

	/* ── A · registration ── */
	.cv-open {
		display: grid;
		gap: clamp(1.75rem, 4vw, 3.5rem);
		align-items: center;
	}
	@media (min-width: 960px) {
		.cv-open { grid-template-columns: 1.1fr 0.9fr; }
	}

	/* ── the notice board ──
	   Real cork rather than a brown gradient: a speckled grain, a thinner
	   frame with a shadow inside it, a proper header rule, and notes that
	   straighten and lift when you point at them. */
	.cv-pinboard {
		position: relative;
		display: grid;
		gap: 1rem;
		justify-items: stretch;
		padding: 1.3rem 1.25rem 1.5rem;
		border-radius: 1rem;
		background:
			radial-gradient(5px 5px at 12% 18%, rgba(60, 35, 12, 0.16), transparent 60%),
			radial-gradient(4px 4px at 68% 32%, rgba(60, 35, 12, 0.14), transparent 60%),
			radial-gradient(6px 6px at 34% 72%, rgba(60, 35, 12, 0.12), transparent 60%),
			radial-gradient(4px 4px at 84% 82%, rgba(60, 35, 12, 0.15), transparent 60%),
			radial-gradient(120% 90% at 50% 0%, rgba(255, 214, 150, 0.14), transparent 62%),
			linear-gradient(160deg, #c49a68, #a97c4a);
		border: 7px solid #6d4f27;
		box-shadow:
			inset 0 0 46px rgba(60, 35, 12, 0.38),
			inset 0 2px 0 rgba(255, 255, 255, 0.12),
			0 34px 76px -32px rgba(0, 0, 0, 0.6);
		transform: rotate(0.7deg);
	}
	@media (max-width: 959px) { .cv-pinboard { transform: none; } }
	.cv-pb-head {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding-bottom: 0.55rem;
		border-bottom: 2px solid rgba(60, 35, 12, 0.28);
		font-family: var(--cp-marker);
		font-size: 1.08rem;
		font-weight: 700;
		color: #fdf6ea;
		text-shadow: 0 1px 2px rgba(0, 0, 0, 0.45);
	}
	.cv-pb-head i {
		width: 8px;
		height: 8px;
		border-radius: 9999px;
		background: #f87171;
		box-shadow: 0 0 0 3px rgba(248, 113, 113, 0.25);
	}
	.cv-pb-head em {
		margin-left: auto;
		font-style: normal;
		font-family: ui-monospace, monospace;
		font-size: 0.6rem;
		font-weight: 800;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: rgba(253, 246, 234, 0.6);
	}
	.cv-note {
		position: relative;
		font-family: var(--cp-marker);
		font-size: 1rem;
		font-weight: 700;
		line-height: 1.4;
		color: #44403c;
		padding: 0.9rem 1rem 1.05rem;
		border-radius: 2px 2px 5px 5px;
		box-shadow: 0 12px 24px -10px rgba(0, 0, 0, 0.5);
		transform: rotate(var(--r, 0deg));
		transition: transform 0.32s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.32s ease;
	}
	.cv-note:hover {
		transform: rotate(0deg) translateY(-3px) scale(1.02);
		box-shadow: 0 20px 34px -12px rgba(0, 0, 0, 0.55);
		z-index: 2;
	}
	/* the curl at the bottom corner, so it reads as paper not a rectangle */
	.cv-note::after {
		content: '';
		position: absolute;
		right: 0;
		bottom: 0;
		width: 20px;
		height: 20px;
		background: linear-gradient(135deg, transparent 50%, rgba(0, 0, 0, 0.12) 50%);
	}
	.cv-tack {
		position: absolute;
		top: -7px;
		left: 50%;
		transform: translateX(-50%);
		width: 13px;
		height: 13px;
		border-radius: 50%;
		background: radial-gradient(circle at 34% 28%, #fecdd3, #e11d48 68%);
		box-shadow: 0 3px 6px rgba(0, 0, 0, 0.5), inset 0 -1px 2px rgba(0, 0, 0, 0.3);
