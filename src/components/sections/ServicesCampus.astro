---
// Services hub · Campus world — the course catalogue. Same disciplines data
// as every other view, told as departments you can enrol with (or hire).
// Root carries `cbody` (campus engine: .cp-rev reveals) and `csvc` (motion
// engine: tilt / glare / magnetic / .fa-journey draw).
import { Icon } from 'astro-icon/components';
import { disciplines } from '../../data/disciplines';

const semester = [
	{ n: 'Wk 1', title: 'Research', desc: 'We learn the market, the user and the goal before anything is sketched.' },
	{ n: 'Wk 2', title: 'Plan', desc: 'Directions explored boldly — you see the thinking, not just the result.' },
	{ n: 'Wk 3+', title: 'Build', desc: 'Design and engineering in the same room, refined until it works beautifully.' },
	{ n: 'Demo', title: 'Ship & grow', desc: 'Launched, polished, alive — then marketed and maintained by the same team.' },
];

const sectors = ['Fintech', 'Real estate', 'Sports', 'E-commerce', 'Education', 'Healthcare', 'Logistics', 'Beauty', 'Energy', 'Media'];
---

<div class="csvc cbody view-body view-body-campus">
	<!-- ── A · registration desk ───────────────────────────── -->
	<section class="cv-sec">
		<div class="cv-wrap cv-open">
			<div class="cv-copy cp-rev">
				<span class="cv-badge">🗂️ Course registration · Always open</span>
				<h2 class="cv-h cv-h--xl">Six departments. <em>One campus.</em></h2>
				<p class="cv-p">
					Design, development, marketing, strategy, maintenance and
					education — every skill your product needs, taught and
					practised by the same team. Pick a department to look inside.
				</p>
				<div class="cv-row">
					<a href="/contact" class="cv-cta fa-cta">
						Hire the departments
						<Icon width={16} name="mdi:arrow-right" />
					</a>
					<a href="/programs" class="cv-link">
						Or apply for a place
						<Icon width={15} name="mdi:school-outline" />
					</a>
				</div>
			</div>

			<!-- the pinboard: today's notices -->
			<div class="cv-pinboard cp-rev" data-cursor="pen" data-fa-tilt="3">
				<span class="cv-pb-head">📌 Notice board</span>
				<span class="cv-note cv-note--y" style="--r:-3deg">65+ products shipped by this faculty</span>
				<span class="cv-note cv-note--b" style="--r:2deg">all 6 departments take commissions</span>
				<span class="cv-note cv-note--p" style="--r:-1.5deg">demo friday — every friday!</span>
			</div>
		</div>
	</section>

	<!-- ── B · the course catalogue ────────────────────────── -->
	<section class="cv-sec" data-cursor="book">
		<div class="cv-wrap">
			<div class="cv-head cp-rev">
				<span class="cv-kick">📚 The catalogue</span>
				<h2 class="cv-h">Pick a <em>department.</em></h2>
			</div>
			<div class="cv-depts">
				{
					disciplines.map((d, i) => (
						<a
							href={`/services/${d.slug}`}
							class="cv-dept cp-rev"
							style={`--c:${d.color}; --i:${i % 3}`}
							data-cursor={d.cursor}
							data-fa-tilt="6"
						>
							<span class="cv-glare" aria-hidden="true" />
							<span class="cv-dept-top">
								<span class="cv-dept-ic"><Icon width={24} name={d.icon} /></span>
								<span class="cv-dept-code">SWZ {Number(d.n)}01</span>
							</span>
							<h3 class="cv-dept-t">{d.title}</h3>
							<p class="cv-dept-tag">{d.tagline}</p>
							<p class="cv-dept-d">{d.desc}</p>
							<span class="cv-dept-chips">
								{d.items.slice(0, 4).map((it) => <i>{it}</i>)}
							</span>
							<span class="cv-dept-enter">
								View the department
								<Icon width={14} name="mdi:arrow-right" />
							</span>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<!-- ── C · how a term runs ─────────────────────────────── -->
	<section class="cv-sec" data-cursor="pen">
		<div class="cv-wrap">
			<div class="cv-head cp-rev">
				<span class="cv-kick">🗓️ The term plan</span>
				<h2 class="cv-h">How a project <em>gets built.</em></h2>
			</div>
			<div class="cv-term fa-journey">
				<span class="cv-spine" aria-hidden="true"></span>
				{
					semester.map((s, i) => (
						<article class="cv-week cp-rev" style={`--i:${i}`}>
							<span class="cv-week-node" aria-hidden="true" />
							<span class="cv-week-n">{s.n}</span>
							<div>
								<h3 class="cv-week-t">{s.title}</h3>
								<p class="cv-week-d">{s.desc}</p>
							</div>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<!-- ── D · field-work belt ─────────────────────────────── -->
	<section class="cv-sec cv-sec--belt">
		<div class="cv-wrap">
			<div class="cv-head cp-rev">
				<span class="cv-kick">🧭 Field work</span>
				<h2 class="cv-h">Sectors we've <em>worked in.</em></h2>
			</div>
		</div>
		<div class="cv-belt" aria-hidden="true">
			<div class="cv-belt-track">
				{
					[0, 1].map(() =>
						sectors.map((x) => <span class="cv-bword">{x}&nbsp;✏️&nbsp;</span>)
					)
				}
			</div>
		</div>
	</section>

	<!-- ── E · the final bell ──────────────────────────────── -->
	<section class="cv-sec cv-sec--cta" data-cursor="phone">
		<div class="cv-wrap cv-cta-box cp-rev">
			<span class="cv-badge">🔔 Office hours — always</span>
			<h2 class="cv-h cv-h--cta">Which department does <em>your idea</em> need?</h2>
			<p class="cv-p cv-p--center">
				Not sure? Bring the brief and we'll walk the halls together —
				most projects end up visiting more than one department anyway.
			</p>
			<div class="cv-cta-row">
				<a href="/contact" class="cv-cta fa-cta">
					Talk to a project manager
					<Icon width={17} name="mdi:arrow-right" />
				</a>
				<a href="/portfolio" class="cv-call">
					or <strong>see what we've shipped</strong>
				</a>
			</div>
		</div>
	</section>
</div>

<style>
	/* ── Campus Services — the school dress. ── */
	.csvc {
		--cp-ink: #fdf6ea;
		--cp-muted: rgba(253, 246, 234, 0.62);
		--cp-faint: rgba(253, 246, 234, 0.4);
		--cp-acc: var(--view-accent, #f59e0b);
		--cp-acc2: #fb7185;
		--cp-line: rgba(255, 255, 255, 0.09);
		--cp-card: rgba(255, 255, 255, 0.035);
		--cp-marker: 'Bradley Hand', 'Segoe Print', 'Comic Sans MS', cursive;
		font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
		position: relative;
		isolation: isolate;
		overflow: hidden;
		background:
			radial-gradient(1000px 540px at 82% -6%, rgba(245, 158, 11, 0.13), transparent 62%),
			radial-gradient(820px 480px at 6% 44%, rgba(251, 113, 133, 0.07), transparent 60%),
			linear-gradient(180deg, #120c04 0%, #160f08 50%, #0e0903 100%);
		color: var(--cp-ink);
		padding: clamp(2rem, 4vw, 3rem) clamp(1rem, 3vw, 2rem) clamp(2.5rem, 5vw, 4rem);
		transition: background 0.4s ease, color 0.4s ease;
	}
	:global(html:not(.dark)) .csvc {
		--cp-ink: #2b1c08;
		--cp-muted: rgba(43, 28, 8, 0.68);
		--cp-faint: rgba(43, 28, 8, 0.46);
		--cp-acc: #b45309;
		--cp-line: rgba(43, 28, 8, 0.1);
		--cp-card: rgba(43, 28, 8, 0.045);
		background:
			radial-gradient(1000px 540px at 82% -6%, rgba(245, 158, 11, 0.14), transparent 62%),
			linear-gradient(180deg, #fdf4e3 0%, #faecd4 55%, #fdf4e3 100%);
	}

	.cv-sec { padding-block: clamp(2rem, 4.5vw, 3.5rem); }
	.cv-sec--cta { padding-bottom: clamp(1.5rem, 3vw, 2.5rem); }
	.cv-wrap { max-width: 76rem; margin: 0 auto; }

	.cv-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-family: ui-monospace, monospace;
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		line-height: 1.6; /* tight when the label wraps on phones */
		text-transform: uppercase;
		color: var(--cp-acc);
		border: 1px solid color-mix(in srgb, var(--cp-acc) 40%, transparent);
		background: color-mix(in srgb, var(--cp-acc) 9%, transparent);
		padding: 0.4rem 0.9rem;
		border-radius: 9999px;
		margin-bottom: 1.1rem;
	}
	.cv-kick {
		display: block;
		font-family: ui-monospace, monospace;
		font-size: 0.74rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--cp-acc);
		margin-bottom: 0.6rem;
	}
	.cv-h {
		font-size: clamp(1.9rem, 4vw, 3rem);
		font-weight: 850;
		letter-spacing: -0.02em;
		line-height: 1.05;
		margin: 0 0 0.9rem;
	}
	.cv-h--xl { font-size: clamp(2.4rem, 5.5vw, 4.2rem); line-height: 1; }
	.cv-h--cta { font-size: clamp(2rem, 4.6vw, 3.4rem); }
	.cv-h em {
		font-style: normal;
		background: linear-gradient(95deg, var(--cp-acc), var(--cp-acc2));
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}
	.cv-p {
		font-size: clamp(0.98rem, 1.5vw, 1.12rem);
		line-height: 1.7;
		color: var(--cp-muted);
		max-width: 34rem;
		margin: 0 0 1.4rem;
	}
	.cv-p--center { text-align: center; margin-inline: auto; max-width: 38rem; }
	.cv-head { text-align: center; margin-bottom: clamp(1.5rem, 3vw, 2.25rem); }
	.cv-link {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font-weight: 800;
		font-size: 0.92rem;
		color: var(--cp-acc);
		border-bottom: 2px solid color-mix(in srgb, var(--cp-acc) 45%, transparent);
		padding-bottom: 0.15rem;
		transition: border-color 0.25s ease, gap 0.25s ease;
	}
	.cv-link:hover { gap: 0.7rem; border-color: var(--cp-acc); }
	.cv-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.95rem 1.8rem;
		border-radius: 9999px;
		font-weight: 800;
		font-size: 0.95rem;
		color: #2b1500;
		background: linear-gradient(95deg, #fbbf24, var(--cp-acc));
		box-shadow: 0 18px 44px -16px color-mix(in srgb, var(--cp-acc) 80%, transparent);
		transition: box-shadow 0.25s ease, filter 0.25s ease;
		will-change: transform;
	}
	.cv-cta:hover { filter: brightness(1.06); }
	.cv-row { display: flex; align-items: center; gap: 1.2rem; flex-wrap: wrap; }
	.cv-call { font-size: 0.95rem; color: var(--cp-muted); }
	.cv-call strong { font-weight: 850; color: var(--cp-ink); transition: color 0.25s ease; }
	.cv-call:hover strong { color: var(--cp-acc); }

	.cv-glare {
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background: radial-gradient(320px 200px at var(--gx, 50%) var(--gy, 20%), color-mix(in srgb, var(--c, var(--cp-acc)) 12%, transparent), transparent 70%);
		opacity: 0;
		transition: opacity 0.3s ease;
		pointer-events: none;
	}
	[data-fa-tilt]:hover .cv-glare { opacity: 1; }

	/* ── A · registration ── */
	.cv-open {
		display: grid;
		gap: clamp(1.75rem, 4vw, 3.5rem);
		align-items: center;
	}
	@media (min-width: 960px) {
		.cv-open { grid-template-columns: 1.1fr 0.9fr; }
	}

	/* the notice board: cork w/ pinned notes */
	.cv-pinboard {
		position: relative;
		display: grid;
		gap: 0.9rem;
		justify-items: start;
		padding: 1.5rem 1.4rem 1.7rem;
		border-radius: 0.9rem;
		background: linear-gradient(160deg, #8a6a44, #74562f);
		border: 10px solid #5c431f;
		box-shadow: inset 0 0 40px rgba(0, 0, 0, 0.25), 0 34px 80px -30px rgba(0, 0, 0, 0.55);
		transform: rotate(0.8deg);
	}
	@media (max-width: 959px) { .cv-pinboard { transform: none; } }
	.cv-pb-head {
		font-family: var(--cp-marker);
		font-size: 1.05rem;
		font-weight: 700;
		color: #fdf6ea;
		text-shadow: 0 1px 2px rgba(0, 0, 0, 0.4);
	}
	.cv-note {
		position: relative;
		font-family: var(--cp-marker);
		font-size: 0.98rem;
		font-weight: 700;
		color: #44403c;
		padding: 0.85rem 1rem 1rem;
		box-shadow: 0 10px 22px -8px rgba(0, 0, 0, 0.45);
		transform: rotate(var(--r, 0deg));
		max-width: 24rem;
	}
	.cv-note::before {
		content: '';
		position: absolute;
		top: -6px;
		left: 50%;
		transform: translateX(-50%);
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: radial-gradient(circle at 35% 30%, #fda4af, #e11d48 65%);
		box-shadow: 0 3px 6px rgba(0, 0, 0, 0.45);
	}
	.cv-note--y { background: #fef08a; }
	.cv-note--b { background: #bfdbfe; }
	.cv-note--p { background: #fbcfe8; }

	/* ── B · the catalogue ── */
	.cv-depts {
		display: grid;
		gap: 1.1rem;
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}
	@media (max-width: 980px) {
		.cv-depts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}
	@media (max-width: 560px) {
		.cv-depts { grid-template-columns: 1fr; }
	}
	.cv-dept {
		position: relative;
		display: flex;
		flex-direction: column;
		padding: 1.35rem 1.35rem 1.45rem;
		border-radius: 0.9rem;
		border: 1px solid var(--cp-line);
		background: var(--cp-card);
		color: var(--cp-ink);
		transition: border-color 0.25s ease, box-shadow 0.3s ease;
	}
	.cv-dept:hover {
		border-color: color-mix(in srgb, var(--c) 55%, transparent);
		box-shadow: 0 30px 70px -30px color-mix(in srgb, var(--c) 40%, transparent);
	}
	.cv-dept-top {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 1rem;
	}
	.cv-dept-ic {
		display: grid;
		place-items: center;
		width: 46px;
		height: 46px;
		border-radius: 0.7rem;
		color: var(--c);
		background: color-mix(in srgb, var(--c) 13%, transparent);
		border: 1px solid color-mix(in srgb, var(--c) 30%, transparent);
	}
	.cv-dept-code {
		font-family: ui-monospace, monospace;
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.1em;
		color: var(--cp-faint);
	}
	.cv-dept-t { margin: 0 0 0.2rem; font-size: 1.3rem; font-weight: 850; }
	.cv-dept-tag {
		margin: 0 0 0.55rem;
		font-family: var(--cp-marker);
		font-size: 0.95rem;
		color: var(--c);
	}
	.cv-dept-d { margin: 0 0 0.9rem; font-size: 0.9rem; line-height: 1.6; color: var(--cp-muted); }
	.cv-dept-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-bottom: 1.1rem;
	}
	.cv-dept-chips i {
		font-style: normal;
		font-size: 0.72rem;
		font-weight: 700;
		padding: 0.25rem 0.6rem;
		border-radius: 9999px;
		border: 1px solid var(--cp-line);
		color: var(--cp-muted);
	}
	.cv-dept-enter {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin-top: auto;
		font-size: 0.82rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--c);
		transition: gap 0.25s ease;
	}
	.cv-dept:hover .cv-dept-enter { gap: 0.75rem; }

	/* ── C · the term ── */
	.cv-term {
		position: relative;
		display: grid;
		gap: clamp(1.4rem, 3vw, 2rem);
		padding-left: clamp(1.6rem, 4vw, 2.6rem);
		max-width: 56rem;
		margin: 0 auto;
	}
	.cv-spine {
		position: absolute;
		top: 0.4rem;
		bottom: 0.4rem;
		left: 8px;
		width: 2px;
		background: linear-gradient(180deg, var(--cp-acc), color-mix(in srgb, var(--cp-acc) 25%, transparent));
		transform: scaleY(0);
		transform-origin: top;
		transition: transform 1.6s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.cv-term.is-drawing .cv-spine { transform: scaleY(1); }
	.cv-week { position: relative; display: grid; grid-template-columns: auto 1fr; gap: 1rem; align-items: start; }
	.cv-week-node {
		position: absolute;
		left: calc(-1 * clamp(1.6rem, 4vw, 2.6rem) + 3px);
		top: 0.45rem;
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: var(--cp-acc);
		box-shadow: 0 0 0 4px color-mix(in srgb, var(--cp-acc) 22%, transparent);
	}
	.cv-week-n {
		font-family: var(--cp-marker);
		font-size: clamp(1.1rem, 2.2vw, 1.5rem);
		line-height: 1.15;
		color: var(--cp-acc);
		min-width: 3.2rem;
	}
	.cv-week-t { margin: 0.1rem 0 0.25rem; font-size: clamp(1.1rem, 2vw, 1.35rem); font-weight: 800; }
	.cv-week-d { margin: 0; max-width: 42rem; font-size: 0.94rem; line-height: 1.6; color: var(--cp-muted); }

	/* ── D · the belt ── */
	.cv-sec--belt { padding-bottom: clamp(1.5rem, 3vw, 2.5rem); }
	.cv-belt {
		overflow: hidden;
		border-block: 1px solid var(--cp-line);
		padding-block: 0.55rem;
	}
	.cv-belt-track {
		display: flex;
		width: max-content;
		animation: cv-belt 28s linear infinite;
	}
	.cv-bword {
		font-family: var(--cp-marker);
		font-size: clamp(1.4rem, 3.2vw, 2.3rem);
		white-space: nowrap;
		color: color-mix(in srgb, var(--cp-ink) 30%, transparent);
	}
	@keyframes cv-belt {
		from { transform: translateX(0); }
		to { transform: translateX(-50%); }
	}

	/* ── E · final bell ── */
	.cv-cta-box { text-align: center; }
	.cv-cta-row {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1.4rem;
		flex-wrap: wrap;
	}

	/* ── reveals ── */
	.cp-rev {
		opacity: 0;
		transform: translateY(22px);
		transition: opacity 0.65s ease, transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
		transition-delay: calc(var(--i, 0) * 0.08s);
	}
	.cp-rev.is-on { opacity: 1; transform: translateY(0); }

	@media (prefers-reduced-motion: reduce) {
		.cp-rev { opacity: 1; transform: none; transition: none; }
		.cv-belt-track { animation: none; }
		.cv-spine { transform: none; transition: none; }
	}
</style>
