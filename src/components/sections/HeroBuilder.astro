---
import { Icon } from 'astro-icon/components';
import FilmPlayer from '../FilmPlayer.astro';
import CustomButton from '../CustomButton.astro';
import Section from '../HTML/Section.astro';
import RotatingHeadline from '../RotatingHeadline.astro';
import { projects } from '../../data/projects';
import MentorsBand from '../MentorsBand.astro';

// the repos under shipped/ are the real live sites, with their real shots
const shippedNames = [
	'AnchorStep Physiotherapy',
	'Binas Residence',
	'The Presidential Diary',
	'JobbLander',
	'Hemam Synergy',
	'African Energy Advocacy Initiative',
];
const shipped = shippedNames
	.map((n) => projects.find((p) => p.name === n))
	.filter((p): p is (typeof projects)[number] => !!p && !!p.url)
	.map((p) => ({
		slug: p.slug,
		name: p.name,
		tagline: p.tagline,
		img: p.img,
		url: p.url as string,
		host: p.host,
	}));

const stats = [
	{ to: 7, suffix: '+', label: 'Years' },
	{ to: 25, suffix: '+', label: 'Engineers' },
	{ to: 65, suffix: '+', label: 'Products' },
	{ to: 10, suffix: '+', label: 'Countries' },
];

const tokens = ['React', 'Flutter', 'Node', 'TypeScript', 'Python', 'Swift', 'Go', 'Figma'];

// Kept as a string so Astro does not parse the braces as expressions.
const builderCode = `// what we ship, across every sector
const shipped = [
  ['BuyGas',        'Gas delivery'],
  ['Brixmarket',    'Real estate'],
  ['TellaTrust',    'Fintech'],
];

shipped.forEach(([name, sector]) => ship(name, sector));
done('65+ products live in 10+ countries');`;

// the file tree down the side of the machine: real repos, real work
// the reel leads: it is the first thing the machine shows you
const tree = [
	{ kind: 'dir', name: 'swizel', open: true, depth: 0 },
	{ kind: 'file', name: 'the-reel.mp4', depth: 1, tab: 'watch', icon: 'mdi:play-box-outline' },
	{ kind: 'file', name: 'editor.js', depth: 1, tab: 'run', icon: 'mdi:language-javascript', dirty: true },
	{ kind: 'file', name: 'deploy.log', depth: 1, tab: 'term', icon: 'mdi:console' },
	{ kind: 'file', name: 'README.md', depth: 1, tab: 'read', icon: 'mdi:language-markdown' },
];

// the deploy log that types itself in the terminal pane
const deployLog = [
	{ t: '$ git push origin main', cls: 'cmd' },
	{ t: 'Enumerating objects: 148, done.', cls: 'dim' },
	{ t: 'To github.com:swizel/brixmarket.git', cls: 'dim' },
	{ t: '   a91f2c4..7d3e8b1  main -> main', cls: 'dim' },
	{ t: '$ swizel deploy --prod', cls: 'cmd' },
	{ t: '✓ install      1.8s', cls: 'ok' },
	{ t: '✓ typecheck    0.9s', cls: 'ok' },
	{ t: '✓ build        6.2s', cls: 'ok' },
	{ t: '✓ tests 214/214', cls: 'ok' },
	{ t: '▲ live in 10+ countries · 0 errors', cls: 'live' },
];

// what the palette offers on ⌘K
const palette = [
	{ label: 'Start your build', hint: 'contact', href: '/contact', icon: 'mdi:rocket-launch-outline' },
	{ label: 'See what we have shipped', hint: 'portfolio', href: '/portfolio', icon: 'mdi:package-variant-closed' },
	{ label: 'Read the stack', hint: 'services', href: '/services', icon: 'mdi:layers-outline' },
	{ label: 'Meet the engineers', hint: 'about', href: '/about', icon: 'mdi:account-group-outline' },
	{ label: 'Join the crew', hint: 'programs', href: '/programs', icon: 'mdi:school-outline' },
];

const buildTypes = [
	'iOS apps',
	'Android apps',
	'Websites',
	'Web apps',
	'PWAs',
	'POCs',
	'ERPs',
	'Software',
];
---

<Section
	sectionClass="hero--stage hero-view hero-builder builder--stage relative overflow-hidden"
	divClass="relative z-10 pb-16 sm:pb-24"
>
	<div class="builder--bg" aria-hidden="true">
		<span class="builder--grid"></span>
		<span class="builder--scan"></span>
		{
			tokens.map((t, i) => (
				<span class="builder--token" style={`--i:${i}`}>
					{t}
				</span>
			))
		}
	</div>

	<div class="builder--layout">
		<div class="builder--copy">
			<span class="builder--eyebrow">
				<span class="builder--blink"></span>// builder view
			</span>

			<RotatingHeadline class="builder--head" />

			<p class="builder--sub">
				If you can imagine it, we build it. Hit run and see what we have
				already shipped, live in 10+ countries.
			</p>


			<div class="builder--caps" aria-label="What we build">
				<span class="builder--caps-k">we build:</span>
				<div class="builder--caps-track">
					<div class="builder--caps-row">
						{buildTypes.map((t) => <span class="builder--cap">{t}</span>)}
						{buildTypes.map((t) => <span class="builder--cap" aria-hidden="true">{t}</span>)}
					</div>
				</div>
			</div>

			<div class="builder--cta">
				<CustomButton
					variant="accent"
					elementType="a"
					href="/contact"
					class="flex items-center justify-center gap-2"
				>
					Start your build
					<Icon width={18} name="mdi:arrow-right" />
				</CustomButton>
				<button class="builder--tour" type="button" data-tour-start="builder">
					<Icon width={16} name="mdi:compass-outline" />
					Take the 20s tour
				</button>
			</div>

			<div class="builder--consts" data-tour="stats">
				<span class="builder--consts-k">{'const swizel = {'}</span>
				<ul class="builder--stats">
					{
						stats.map((s) => (
							<li class="builder--stat">
								<span
									class="builder--statnum"
									data-count-to={s.to}
									data-suffix={s.suffix}
								>
									{s.to}
									{s.suffix}
								</span>
								<span class="builder--statlabel">{s.label}</span>
							</li>
						))
					}
				</ul>
				<span class="builder--consts-k">{'};'}</span>
			</div>

			<MentorsBand
				href="/about"
				kicker="// the humans behind the code"
				label="The engineers you'll work with"
				blurb="Not a pool of freelancers. Senior engineers who ship for paying clients, review every pull request, and stay on the product after launch."
				photo="/images/hero-team.jpg"
			/>
		</div>

		<!-- ══ the workstation ══════════════════════════════════════════
		     Not a panel with a video in it: a developer's machine. Tree down
		     the side, tabs across the top, a status bar underneath, and ⌘K
		     for the palette. The live editor is one of the files. -->
		<div class="wkst" data-bstack data-wkst>
			<div class="wkst__chrome">
				<span class="wkst__dots" aria-hidden="true">
					<i></i><i></i><i></i>
				</span>
				<span class="wkst__title">swizel — ~/builds</span>
				<!-- phones have no room for a tree beside the code, so it
				     arrives as a drawer from this button instead -->
				<button
					class="wkst__files"
					type="button"
					data-wkst-drawer
					aria-label="Show the file tree"
				>
					<Icon width={14} name="mdi:file-tree-outline" />
					<span>Files</span>
				</button>
				<button class="wkst__k" type="button" data-wkst-open aria-label="Open the command palette">
					<Icon width={13} name="mdi:magnify" />
					<span>Jump to…</span>
					<kbd>⌘K</kbd>
				</button>
			</div>

			<div class="wkst__body">
				<button
					class="wkst__rail"
					type="button"
					data-wkst-tree
					aria-label="Show the file tree"
					title="Show the file tree"
				>
					<Icon width={16} name="mdi:file-tree-outline" />
				</button>
				<aside class="wkst__tree" aria-label="Files">
					<button
						class="wkst__collapse"
						type="button"
						data-wkst-tree
						data-wkst-drawer
						aria-label="Hide the file tree"
						title="Hide the file tree"
					>
						<Icon width={15} name="mdi:chevron-double-left" />
					</button>
					{
						tree.map((n) =>
							n.kind === 'dir' ? (
								<button
									class="wkst__dir"
									type="button"
									style={`--d:${n.depth}`}
									data-wkst-fold="swizel"
									aria-expanded="true"
								>
									<Icon class="wkst__caretx" width={12} name="mdi:chevron-down" />
									<Icon width={13} name="mdi:folder-outline" />
									{n.name}
								</button>
							) : n.tab ? (
								<button
									class:list={['wkst__file', { 'is-on': n.tab === 'watch' }]}
									type="button"
									style={`--d:${n.depth}`}
									data-bstack-tab={n.tab}
									data-wkst-in="swizel"
								>
									<Icon width={13} name={n.icon} />
									{n.name}
									{n.dirty && <i class="wkst__dirty" aria-hidden="true" />}
								</button>
							) : (
								<span class:list={['wkst__file', 'is-muted']} style={`--d:${n.depth}`}>
									<Icon width={13} name={n.icon} />
									{n.name}
								</span>
							)
						)
					}

					<button
						class="wkst__dir"
						type="button"
						style="--d:0"
						data-wkst-fold="shipped"
						aria-expanded="true"
					>
						<Icon class="wkst__caretx" width={12} name="mdi:chevron-down" />
						<Icon width={13} name="mdi:folder-outline" />
						shipped
					</button>
					{
						shipped.map((s) => (
							<button
								class="wkst__file"
								type="button"
								style="--d:1"
								data-bstack-tab="site"
								data-wkst-site={s.slug}
								data-wkst-in="shipped"
							>
								<Icon width={13} name="mdi:web" />
								{s.slug}
								<i class="wkst__live" aria-hidden="true" />
							</button>
						))
					}
					<a class="wkst__file wkst__file--more" href="/portfolio" style="--d:1" data-wkst-in="shipped">
						<Icon width={13} name="mdi:plus" />
						more
					</a>
				</aside>

				<div class="wkst__main">
					<div class="wkst__tabs" role="tablist" aria-label="Open files">
						<button class="wkst__tab is-on" type="button" role="tab" aria-selected="true" data-bstack-tab="watch">
							<Icon width={13} name="mdi:play-box-outline" />the-reel.mp4
						</button>
						<button class="wkst__tab" type="button" role="tab" aria-selected="false" data-bstack-tab="run">
							<Icon width={13} name="mdi:language-javascript" />editor.js
							<span class="wkst__dot" aria-hidden="true" />
						</button>
						<button class="wkst__tab" type="button" role="tab" aria-selected="false" data-bstack-tab="term">
							<Icon width={13} name="mdi:console" />deploy.log
						</button>
						<button class="wkst__tab" type="button" role="tab" aria-selected="false" data-bstack-tab="read">
							<Icon width={13} name="mdi:language-markdown" />README.md
						</button>
						<button
							class="wkst__tab wkst__tab--site"
							type="button"
							role="tab"
							aria-selected="false"
							data-bstack-tab="site"
							hidden
						>
							<Icon width={13} name="mdi:web" />
							<span data-wkst-tabname>site</span>
						</button>
					</div>

					<div class="wkst__panes">
						<!-- the reel: the first thing the machine shows you -->
						<div class="wkst__pane is-on" role="tabpanel" data-bstack-pane="watch">
							<FilmPlayer
								videoId="R2jdjZwv-ZE"
								label="Inside a Swizel build: the engineers, the stack and the ship"
								tag="git log --the-team"
								cover
								class="wkst__film"
							/>
						</div>

						<!-- the editor that actually runs -->
						<div class="wkst__pane" role="tabpanel" data-bstack-pane="run" hidden>
							<div class="builder--ide" id="builder-ide" data-tour="ide">
								<div class="ide2--bar">
									<span class="ide2--dot"></span>
									<span class="ide2--dot"></span>
									<span class="ide2--dot"></span>
									<span class="ide2--file">swizel.dev</span>
									<span class="ide2--live"><span class="ide2--livedot"></span>live</span>
									<button class="ide2--run ide2--run--pulse" type="button" data-tour="run">
										<svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
										Run
									</button>
								</div>
								<div class="ide2--body">
									<div class="ide2--editor">
										<pre class="ide2--gutter" aria-hidden="true"></pre>
										<textarea class="ide2--code" spellcheck="false" aria-label="Live code editor">{builderCode}</textarea>
									</div>
									<div class="ide2--console" data-tour="out">
										<div class="ide2--consolebar">
											<span>console</span>
											<span class="ide2--cue" id="builder-ide-cue">
												<Icon width={13} name="mdi:gesture-tap" />
												live · editable<span class="ide2--cue-long"> · ⌘/Ctrl + Enter</span>
											</span>
										</div>
										<div class="ide2--out" id="builder-out"></div>
									</div>
								</div>
							</div>
						</div>

						<!-- the deploy that already happened -->
						<div class="wkst__pane" role="tabpanel" data-bstack-pane="term" hidden>
							<div class="wkst__term" data-wkst-term>
								{
									deployLog.map((l, i) => (
										<p class:list={['wkst__tline', `is-${l.cls}`]} style={`--i:${i}`}>
											{l.t}
										</p>
									))
								}
								<p class="wkst__tline is-caret"><span class="wkst__caret" aria-hidden="true" /></p>
							</div>
						</div>

						<!-- the readme, because every repo has one -->
						<div class="wkst__pane" role="tabpanel" data-bstack-pane="read" hidden>
							<div class="wkst__read">
								<h3># Swizel</h3>
								<p>A senior team you can plug into your idea — designed, built, shipped and kept running.</p>
								<h4>## What we ship</h4>
								<ul>
									<li>Web, iOS and Android, and the APIs behind them</li>
									<li>ERPs, dashboards, marketplaces, fintech rails</li>
								</ul>
								<h4>## Getting started</h4>
								<pre><code>$ swizel ship</code></pre>
								<p class="wkst__read-note">→ or press <kbd>⌘K</kbd> and jump straight to it.</p>
							</div>
						</div>

						<!-- a shipped site, in a browser -->
						<div class="wkst__pane" role="tabpanel" data-bstack-pane="site" hidden>
							<div class="wkst__www">
								<div class="wkst__www-bar">
									<span class="wkst__www-dots" aria-hidden="true"><i></i><i></i><i></i></span>
									<span class="wkst__www-url">
										<Icon width={12} name="mdi:lock" />
										<span data-wkst-host>—</span>
									</span>
									<a class="wkst__www-go" href="/portfolio" target="_blank" rel="noopener" data-wkst-visit>
										Visit
										<Icon width={12} name="mdi:arrow-top-right" />
									</a>
								</div>
								<div class="wkst__www-glass">
									<img src="" alt="" data-wkst-shot />
								</div>
								<p class="wkst__www-cap">
									<b data-wkst-name>—</b>
									<span data-wkst-tag>—</span>
								</p>
							</div>
						</div>
					</div>
				</div>
			</div>
			<!-- the status bar every editor wears -->
			<div class="wkst__status">
				<span class="wkst__st wkst__st--branch">
					<Icon width={12} name="mdi:source-branch" />main
				</span>
				<span class="wkst__st"><i class="wkst__pulse" aria-hidden="true" />deployed</span>
				<span class="wkst__st wkst__st--dim">0 errors</span>
				<span class="wkst__st wkst__st--dim">65+ products</span>
				<span class="wkst__spacer" aria-hidden="true" />
				<span class="wkst__st wkst__st--dim">UTF-8</span>
				<span class="wkst__st wkst__st--dim">Ln 1, Col 1</span>
			</div>

			<script type="application/json" data-wkst-sites set:html={JSON.stringify(shipped)} />

			<!-- ⌘K -->
			<div class="wkst__palette" data-wkst-palette hidden>
				<div class="wkst__palette-card" role="dialog" aria-label="Command palette">
					<div class="wkst__palette-in">
						<Icon width={15} name="mdi:chevron-right" />
						<input
							type="text"
							placeholder="Type a command…"
							aria-label="Command"
							data-wkst-q
						/>
						<kbd>esc</kbd>
					</div>
					<ul class="wkst__palette-list" data-wkst-list>
						{
							palette.map((c, i) => (
								<li>
									<a class:list={['wkst__cmd', { 'is-on': i === 0 }]} href={c.href} data-wkst-cmd>
										<Icon width={15} name={c.icon} />
										<span>{c.label}</span>
										<em>{c.hint}</em>
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</div>
	</div>
</Section>

<style>
	.builder--stage {
		background:
			radial-gradient(900px 500px at 78% -10%, rgba(24, 222, 190, 0.12), transparent 60%),
			linear-gradient(180deg, #0b0f17 0%, #080a11 100%);
		color: #e8f0f4;
		isolation: isolate;
	}

	/* moving background — full bleed so it spans the whole page width */
	.builder--bg {
		position: absolute;
		top: 0;
		left: 50%;
		transform: translateX(-50%);
		width: 100vw;
		height: 100%;
		z-index: 0;
		overflow: hidden;
		pointer-events: none;
		background:
			radial-gradient(900px 500px at 78% -10%, rgba(24, 222, 190, 0.12), transparent 60%),
			linear-gradient(180deg, #0b0f17 0%, #080a11 100%);
	}
	/* glassy / glossy sheen */
	.builder--bg::before {
		content: '';
		position: absolute;
		inset: 0;
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.07), transparent 20%),
			radial-gradient(130% 60% at 50% -12%, rgba(255, 255, 255, 0.09), transparent 55%),
			linear-gradient(115deg, transparent 38%, rgba(255, 255, 255, 0.05) 48%, transparent 58%);
		pointer-events: none;
	}
	.builder--bg::after {
		content: '';
		position: absolute;
		inset: 0;
		backdrop-filter: saturate(120%);
		-webkit-backdrop-filter: saturate(120%);
		pointer-events: none;
	}
	.builder--grid {
		position: absolute;
		inset: 0;
		background-image: linear-gradient(rgba(24, 222, 190, 0.06) 1px, transparent 1px),
			linear-gradient(90deg, rgba(24, 222, 190, 0.06) 1px, transparent 1px);
		background-size: 40px 40px;
		mask-image: radial-gradient(ellipse 90% 70% at 60% 30%, #000 30%, transparent 100%);
		-webkit-mask-image: radial-gradient(ellipse 90% 70% at 60% 30%, #000 30%, transparent 100%);
	}
	.builder--scan {
		position: absolute;
		left: 0;
		right: 0;
		height: 180px;
		background: linear-gradient(180deg, transparent, rgba(24, 222, 190, 0.05), transparent);
		animation: scan 7s linear infinite;
	}
	@keyframes scan {
		0% { top: -20%; }
		100% { top: 120%; }
	}
	.builder--token {
		position: absolute;
		font-family: ui-monospace, monospace;
		font-size: 0.8rem;
		color: rgba(134, 226, 239, 0.18);
		left: calc((var(--i) + 1) * 11%);
		top: -10%;
		animation: tokenfall 14s linear infinite;
		animation-delay: calc(var(--i) * -1.7s);
		white-space: nowrap;
	}
	@keyframes tokenfall {
		0% { transform: translateY(-10vh); opacity: 0; }
		10% { opacity: 1; }
		90% { opacity: 1; }
		100% { transform: translateY(115vh); opacity: 0; }
	}

	.builder--layout {
		position: relative;
		z-index: 1;
		display: grid;
		gap: 2.5rem;
		align-items: start;
		min-height: calc(100vh - 90px);
		padding-top: 2rem;
	}
	/* let grid columns shrink below their content's intrinsic width so the
	   IDE panel (nowrap code) scrolls internally instead of forcing the whole
	   hero wider than the phone viewport */
	.builder--layout > * { min-width: 0; }
	@media (min-width: 1024px) {
		.builder--layout {
			/* the machine leads: it is the thing people came to touch */
			grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
			gap: 2.4rem;
		}
		/* start the panel at the headline, not the eyebrow line above it */
		.wkst { margin-top: 2.8rem; }
	}

	.builder--eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-family: ui-monospace, monospace;
		font-size: 0.8rem;
		letter-spacing: 0.1em;
		color: var(--view-accent, #18debe);
		margin-bottom: 1.2rem;
	}
	.builder--blink {
		width: 8px;
		height: 16px;
		background: var(--view-accent, #18debe);
		display: inline-block;
		animation: blink 1.1s steps(2) infinite;
	}
	@keyframes blink { 50% { opacity: 0; } }

	.builder--head {
		font-size: clamp(2.6rem, 6vw, 5.2rem);
		margin-bottom: 1.4rem;
	}
	.builder--sub {
		max-width: 30rem;
		color: rgba(232, 240, 244, 0.66);
		font-size: 1.08rem;
		line-height: 1.65;
		margin-bottom: 1.4rem;
	}
	/* capabilities marquee */
	.builder--caps {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		max-width: 30rem;
		margin-bottom: 1.6rem;
	}
	.builder--caps-k {
		font-family: ui-monospace, monospace;
		font-size: 0.78rem;
		color: var(--view-accent, #18debe);
		flex-shrink: 0;
	}
	.builder--caps-track {
		position: relative;
		overflow: hidden;
		flex: 1;
		-webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
		mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
	}
	.builder--caps-row {
		display: flex;
		gap: 0.5rem;
		width: max-content;
		animation: capscroll 16s linear infinite;
	}
	.builder--caps-track:hover .builder--caps-row { animation-play-state: paused; }
	@keyframes capscroll { to { transform: translateX(-50%); } }
	.builder--cap {
		font-size: 0.75rem;
		font-weight: 600;
		white-space: nowrap;
		padding: 0.3rem 0.7rem;
		border-radius: 9999px;
		border: 1px solid rgba(134, 226, 239, 0.2);
		background: rgba(255, 255, 255, 0.03);
		color: rgba(232, 240, 244, 0.8);
	}
	.builder--cta {
		display: flex;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
		margin-bottom: 2rem;
	}
	.builder--tour {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-family: ui-monospace, monospace;
		font-size: 0.82rem;
		font-weight: 600;
		color: #e8f0f4;
		padding: 0.85rem 1.2rem;
		border-radius: 9999px;
		border: 1px dashed rgba(134, 226, 239, 0.4);
		transition: border-color 0.25s ease, color 0.25s ease, background 0.25s ease;
	}
	.builder--tour:hover {
		border-color: var(--view-accent, #18debe);
		color: var(--view-accent, #18debe);
		background: rgba(24, 222, 190, 0.08);
	}

	/* the same set of four the Campus and Founder heroes carry: the number
	   large, its label beneath, one line at every width */
	.builder--stats {
		display: flex;
		justify-content: space-between;
		gap: clamp(0.5rem, 2vw, 1.6rem);
		flex-wrap: nowrap;
		padding-top: 1.5rem;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
	}
	.builder--stat { flex: 1 1 0; min-width: 0; }
	.builder--statnum {
		font-family: 'Bebas Neue', sans-serif;
		font-size: clamp(1.6rem, 2.4vw, 2.2rem);
		line-height: 1;
		background: linear-gradient(135deg, #8dfeea, var(--view-accent, #18debe));
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
		color: transparent;
	}
	.builder--statlabel {
		display: block;
		font-size: 0.74rem;
		white-space: nowrap;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: rgba(232, 240, 244, 0.5);
		margin-top: 0.3rem;
	}

	/* small team photo — the humans behind the code */
	.builder--team {
		display: inline-flex;
		align-items: center;
		gap: 0.85rem;
		margin-top: 1.5rem;
		padding: 0.5rem 0.9rem 0.5rem 0.5rem;
		border-radius: 9999px;
		border: 1px solid rgba(255, 255, 255, 0.1);
		background: rgba(255, 255, 255, 0.03);
		width: fit-content;
		transition: border-color 0.3s ease, background 0.3s ease,
			transform 0.3s ease;
	}
	.builder--team:hover {
		border-color: var(--view-accent, #18debe);
		background: rgba(24, 222, 190, 0.07);
		transform: translateY(-2px);
	}
	.builder--team-pic {
		position: relative;
		flex-shrink: 0;
		width: 86px;
		height: 52px;
		border-radius: 9999px;
		overflow: hidden;
		border: 1px solid rgba(134, 226, 239, 0.3);
	}
	.builder--team-pic img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 28%;
	}
	.builder--team-live {
		position: absolute;
		right: 5px;
		bottom: 5px;
		width: 8px;
		height: 8px;
		border-radius: 9999px;
		background: #28c840;
		border: 2px solid #0b0f17;
	}
	.builder--team-txt {
		display: flex;
		flex-direction: column;
		gap: 1px;
		min-width: 0;
	}
	.builder--team-k {
		font-family: ui-monospace, monospace;
		font-size: 0.7rem;
		color: rgba(232, 240, 244, 0.45);
	}
	.builder--team-l {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.92rem;
		font-weight: 700;
		line-height: 1.3; /* tight when the label wraps on phones */
		color: #e8f0f4;
	}
	.builder--team-k {
		line-height: 1.4;
	}
	@media (max-width: 600px) {
		.builder--team-k { font-size: 0.7rem; }
		.builder--team-l { font-size: 0.84rem; }
		.builder--team-pic { width: 70px; height: 44px; }
	}

	/* ===== IDE ===== */
	/* the shared mentors band, wearing Builder's clothes: monospace label,
	   a teal edge, and enough contrast to hold on the pale stage */
	.builder--copy :global(.mband) {
		border-color: color-mix(in srgb, var(--view-accent, #18debe) 34%, transparent);
	}
	.builder--copy :global(.mband:hover) {
		border-color: color-mix(in srgb, var(--view-accent, #18debe) 65%, transparent);
	}
	.builder--copy :global(.mband__k) {
		font-family: ui-monospace, 'SF Mono', Menlo, monospace;
		letter-spacing: 0;
	}
	:global(html:not(.dark)) .builder--copy :global(.mband) {
		background:
			linear-gradient(115deg, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0.62) 55%),
			color-mix(in srgb, var(--view-accent, #18debe) 8%, transparent);
	}

	/* ── the copy side: a line you can copy, numbers as a const ── */
	.builder--npm {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		width: fit-content;
		max-width: 100%;
		margin-bottom: 1.2rem;
		padding: 0.5rem 0.55rem 0.5rem 0.8rem;
		border-radius: 0.55rem;
		border: 1px solid rgba(24, 222, 190, 0.24);
		background: rgba(8, 12, 18, 0.72);
		font-family: ui-monospace, 'SF Mono', Menlo, monospace;
	}
	.builder--npm code {
		font-size: 0.8rem;
		color: #dff3f7;
		white-space: nowrap;
		overflow-x: auto;
		scrollbar-width: none;
	}
	.builder--npm code::-webkit-scrollbar { display: none; }
	.builder--npm-p { color: var(--view-accent, #18debe); }
	.builder--npm-a { color: rgba(223, 243, 247, 0.5); }
	.builder--npm-c {
		display: grid;
		place-items: center;
		flex: none;
		width: 1.8rem;
		height: 1.8rem;
		border: 0;
		border-radius: 0.4rem;
		background: rgba(255, 255, 255, 0.06);
		color: rgba(223, 243, 247, 0.7);
		cursor: pointer;
		transition: background 0.2s ease, color 0.2s ease;
	}
	.builder--npm-c:hover { background: rgba(24, 222, 190, 0.18); color: #fff; }
	.builder--npm-i { grid-area: 1 / 1; }
	.builder--npm-i--done { display: none; color: #28c840; }
	.builder--npm.is-copied .builder--npm-i--copy { display: none; }
	.builder--npm.is-copied .builder--npm-i--done { display: block; }

	/* The numbers are the Campus and Founder set, wrapped in braces so they
	   still read as a declaration. The rule that sits above the numbers in
	   those views moves up here, so it stays above the opening brace. */
	.builder--consts {
		font-family: ui-monospace, 'SF Mono', Menlo, monospace;
		margin-top: 0.2rem;
		padding-top: 1.5rem;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
	}
	.builder--consts-k {
		display: block;
		font-size: 0.72rem;
		color: rgba(223, 243, 247, 0.38);
	}
	.builder--consts .builder--stats {
		list-style: none;
		margin: 0.5rem 0 0.6rem;
		padding: 0 0 0 1.1rem;
		border: 0;
	}
	.builder--consts .builder--statlabel { text-transform: uppercase; }
	/* the tightest two-column band — the copy column is at its narrowest
	   here, so the labels tuck in a little to hold the single line */
	@media (min-width: 1024px) and (max-width: 1179px) {
		.builder--statlabel { font-size: 0.66rem; letter-spacing: 0.03em; }
		.builder--stats { gap: 0.4rem; }
	}
	@media (max-width: 600px) {
		.builder--consts .builder--stats { padding-left: 0.7rem; }
		.builder--npm code { font-size: 0.72rem; }
	}

	/* ══ the workstation ══════════════════════════════════════════════
	   A machine, not a card. Chrome on top, tree down the side, tabs over
	   the panes, status bar underneath. Everything is monospace and every
	   surface is a shade of the same near-black. */
	.wkst {
		--w-tree: 11.5rem;
		--w-line: rgba(255, 255, 255, 0.07);
		--w-dim: rgba(214, 232, 238, 0.45);
		--w-ink: #dff3f7;
		position: relative;
		border-radius: 0.9rem;
		overflow: hidden;
		border: 1px solid rgba(24, 222, 190, 0.2);
		background: #0a0e14;
		box-shadow:
			0 50px 110px -50px rgba(0, 0, 0, 0.96),
			0 0 0 1px rgba(255, 255, 255, 0.03) inset,
			0 0 90px -40px color-mix(in srgb, var(--view-accent, #18debe) 60%, transparent);
		font-family: ui-monospace, 'SF Mono', Menlo, monospace;
	}

	/* title bar */
	.wkst__chrome {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		padding: 0.5rem 0.7rem;
		border-bottom: 1px solid var(--w-line);
		background: rgba(255, 255, 255, 0.025);
	}
	.wkst__dots { display: inline-flex; gap: 0.35rem; }
	.wkst__dots i {
		width: 10px; height: 10px; border-radius: 9999px; display: block;
		background: #2b3440;
	}
	.wkst__dots i:nth-child(1) { background: #ff5f57; }
	.wkst__dots i:nth-child(2) { background: #febc2e; }
	.wkst__dots i:nth-child(3) { background: #28c840; }
	.wkst__title { font-size: 0.72rem; color: var(--w-dim); }
	.wkst__k {
		margin-left: auto;
		display: inline-flex;
		align-items: center;
		gap: 0.38rem;
		padding: 0.24rem 0.5rem;
		border: 1px solid var(--w-line);
		border-radius: 0.45rem;
		background: rgba(255, 255, 255, 0.03);
		color: var(--w-dim);
		font-family: inherit;
		font-size: 0.68rem;
		cursor: pointer;
		transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
	}
	.wkst__k:hover {
		color: var(--w-ink);
		border-color: rgba(24, 222, 190, 0.4);
		background: rgba(24, 222, 190, 0.08);
	}
	.wkst__k kbd {
		padding: 0 0.25rem;
		border-radius: 0.25rem;
		background: rgba(255, 255, 255, 0.08);
		font-family: inherit;
		font-size: 0.64rem;
	}

	/* The tree is taken out of flow so its length can never decide how tall
	   the machine is — the open file does that, and the tree scrolls if it
	   runs past. The column it used to occupy is still reserved by the grid,
	   so the fold animation is unchanged. */
	.wkst__body {
		position: relative;
		display: grid;
		grid-template-columns: var(--w-tree) minmax(0, 1fr);
		transition: grid-template-columns 0.32s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.wkst__rail { grid-column: 1; }
	.wkst__main { grid-column: 2; }
	/* collapsed: the tree folds away to a rail you can tap to bring back */
	.wkst.is-folded .wkst__body { grid-template-columns: 2.2rem minmax(0, 1fr); }
	.wkst.is-folded .wkst__tree { display: none; }
	.wkst__rail {
		display: none;
		place-items: center;
		align-content: start;
		padding-top: 0.6rem;
		border: 0;
		border-right: 1px solid var(--w-line);
		background: rgba(255, 255, 255, 0.012);
		color: var(--w-dim);
		cursor: pointer;
		transition: color 0.2s ease, background 0.2s ease;
	}
	.wkst__rail:hover { color: var(--w-ink); background: rgba(255, 255, 255, 0.05); }
	.wkst.is-folded .wkst__rail { display: grid; }
	.wkst__collapse {
		align-self: flex-end;
		display: grid;
		place-items: center;
		width: 1.5rem;
		height: 1.5rem;
		margin: -0.15rem 0 0.15rem auto;
		border: 0;
		border-radius: 0.35rem;
		background: transparent;
		color: var(--w-dim);
		cursor: pointer;
		transition: color 0.2s ease, background 0.2s ease;
	}
	.wkst__collapse:hover { color: var(--w-ink); background: rgba(255, 255, 255, 0.06); }
	.wkst__dir { cursor: pointer; width: 100%; }
	.wkst__dir:hover { color: var(--w-ink); }
	.wkst__caretx { transition: transform 0.22s ease; }
	.wkst__dir[aria-expanded='false'] .wkst__caretx { transform: rotate(-90deg); }
	.wkst__file[hidden], .wkst__dir[hidden] { display: none; }
	.wkst__file--more {
		text-decoration: none;
		color: color-mix(in srgb, var(--view-accent, #18debe) 75%, #fff);
	}
	.wkst__file--more:hover { color: #eafcff; }
	.wkst__live {
		width: 5px; height: 5px; border-radius: 9999px; margin-left: auto;
		background: #28c840; box-shadow: 0 0 6px #28c840;
	}

	/* the tree */
	.wkst__tree {
		position: absolute;
		inset: 0 auto 0 0;
		width: var(--w-tree);
		display: flex;
		flex-direction: column;
		gap: 0.04rem;
		padding: 0.45rem 0.35rem;
		border-right: 1px solid var(--w-line);
		background: rgba(255, 255, 255, 0.012);
		overflow-x: hidden;
		overflow-y: auto;
		scrollbar-width: thin;
		scrollbar-color: rgba(255, 255, 255, 0.16) transparent;
	}
	.wkst__tree::-webkit-scrollbar { width: 6px; }
	.wkst__tree::-webkit-scrollbar-thumb {
		border-radius: 9999px;
		background: rgba(255, 255, 255, 0.16);
	}
	.wkst__dir,
	.wkst__file {
		display: flex;
		align-items: center;
		gap: 0.34rem;
		flex: none;
		line-height: 1.5;
		padding: 0.17rem 0.4rem 0.17rem calc(0.4rem + var(--d, 0) * 0.65rem);
		border: 0;
		border-radius: 0.35rem;
		background: transparent;
		color: var(--w-dim);
		font-family: inherit;
		font-size: 0.7rem;
		text-align: left;
		white-space: nowrap;
	}
	.wkst__dir { color: rgba(214, 232, 238, 0.62); font-weight: 600; }
	.wkst__file { cursor: pointer; transition: background 0.18s ease, color 0.18s ease; }
	.wkst__file:hover { background: rgba(255, 255, 255, 0.05); color: var(--w-ink); }
	.wkst__file.is-on {
		background: color-mix(in srgb, var(--view-accent, #18debe) 14%, transparent);
		color: #eafcff;
	}
	.wkst__file.is-muted { cursor: default; opacity: 0.45; }
	.wkst__dirty {
		width: 5px; height: 5px; border-radius: 9999px; margin-left: auto;
		background: var(--view-accent, #18debe);
	}

	.wkst__main { display: flex; flex-direction: column; min-width: 0; }

	/* tabs */
	.wkst__tabs {
		display: flex;
		border-bottom: 1px solid var(--w-line);
		overflow-x: auto;
		scrollbar-width: none;
	}
	.wkst__tabs::-webkit-scrollbar { display: none; }
	.wkst__tab {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 0.36rem;
		flex: none;
		padding: 0.58rem 0.8rem;
		border: 0;
		border-right: 1px solid var(--w-line);
		background: transparent;
		color: var(--w-dim);
		font-family: inherit;
		font-size: 0.72rem;
		cursor: pointer;
		white-space: nowrap;
		transition: color 0.2s ease, background 0.2s ease;
	}
	.wkst__tab:hover { color: var(--w-ink); background: rgba(255, 255, 255, 0.03); }
	.wkst__tab.is-on { color: #eafcff; background: rgba(24, 222, 190, 0.07); }
	.wkst__tab.is-on::after {
		content: '';
		position: absolute;
		inset: auto 0 -1px 0;
		height: 2px;
		background: var(--view-accent, #18debe);
		box-shadow: 0 0 12px color-mix(in srgb, var(--view-accent, #18debe) 70%, transparent);
	}
	.wkst__dot {
		width: 6px; height: 6px; border-radius: 9999px;
		background: var(--view-accent, #18debe);
		animation: wkst-pulse 2.4s ease-in-out infinite;
	}
	@keyframes wkst-pulse {
		0%, 100% { opacity: 0.4; transform: scale(0.85); }
		50% { opacity: 1; transform: scale(1); }
	}

	/* ── one window, one height ──────────────────────────────────────
	   Every file opens into the same box, so no tab is ever longer than
	   the last. The box is the generous, near-square one the machine has
	   always had — the film is stretched to cover it rather than the box
	   being shrunk down to the film. */
	.wkst__panes {
		position: relative;
		flex: none;
		height: clamp(20rem, 34vw, 29rem);
	}
	.wkst__pane {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		min-height: 0;
		overflow: hidden;
	}
	/* [hidden] must win over any display a pane sets for itself: a display
	   further down the sheet quietly un-hides it, which is how the reel
	   ended up sitting on top of the editor. */
	.wkst__pane[hidden] { display: none !important; }
	.wkst__pane.is-on { animation: wkst-in 0.3s cubic-bezier(0.22, 1, 0.36, 1) both; }
	@keyframes wkst-in { from { opacity: 0; transform: translateY(6px); } }

	/* the editor loses its own frame inside the machine, and splits the
	   window between code and console instead of running off the bottom */
	.wkst .builder--ide {
		border: 0;
		border-radius: 0;
		box-shadow: none;
		margin: 0;
		flex: 1 1 auto;
		min-height: 0;
		display: flex;
		flex-direction: column;
	}
	.wkst .ide2--bar { flex: none; border-radius: 0; }
	.wkst .ide2--body { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; }
	.wkst .ide2--editor { flex: 1 1 auto; min-height: 0; }
	.wkst .ide2--code { height: 100%; min-height: 0; overflow: auto; }
	/* the gutter is scrolled to match by hand — a <pre> beside a textarea
	   has no way of following it otherwise */
	.wkst .ide2--gutter { overflow: hidden; }
	/* neither half is allowed to eat the other: the console takes what its
	   output needs up to half the window, and both scroll past that */
	.wkst .ide2--console {
		flex: none;
		max-height: 50%;
		display: flex;
		flex-direction: column;
		min-height: 0;
	}
	.wkst .ide2--consolebar { flex: none; }
	.wkst .ide2--out {
		flex: 1 1 auto;
		min-height: 0;
		overflow-y: auto;
		gap: 0.3rem;
		padding: 0.55rem 0.9rem 0.7rem;
		font-size: 0.75rem;
	}
	.wkst .ide2--pill { font-size: 0.66rem; padding: 0.08rem 0.42rem; }
	/* The cue was a bobbing lozenge over the code, then a chip that landed
	   on the LIVE badge. It is a line of the console bar now: always in
	   view, never on top of anything. */
	.wkst .ide2--cue {
		position: static;
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0;
		font-size: 0.66rem;
		font-weight: 600;
		letter-spacing: 0;
		text-transform: none;
		border: 0;
		border-radius: 0;
		background: none;
		color: color-mix(in srgb, var(--view-accent, #18debe) 72%, #fff);
		box-shadow: none;
		animation: none;
	}
	.wkst .ide2--cue.is-hidden { opacity: 0.45; transform: none; }
	@media (max-width: 480px) {
		.wkst .ide2--cue-long { display: none; }
	}
	.wkst .ide2--cue :global(svg) { width: 12px; height: 12px; }

	/* the film, in the machine's own language: edge to edge in its window,
	   no frame of our own. The covering itself lives in FilmPlayer. */
	.wkst :global(.wkst__film) {
		flex: 1 1 auto;
		min-height: 0;
		gap: 0;
		grid-template-rows: minmax(0, 1fr);
	}
	.wkst :global(.wkst__film .flm__screen) {
		height: 100%;
		aspect-ratio: auto;
		border: 0;
		border-radius: 0;
		box-shadow: none;
	}
	.wkst :global(.flm__tag) { font-family: ui-monospace, monospace; }

	/* the terminal */
	.wkst__term {
		flex: 1 1 auto;
		min-height: 0;
		overflow-y: auto;
		padding: 0.9rem 1rem 1.1rem;
		font-size: 0.74rem;
		line-height: 1.75;
	}
	.wkst__tline {
		margin: 0;
		color: var(--w-dim);
		opacity: 0;
		animation: wkst-line 0.3s ease forwards;
		animation-delay: calc(var(--i) * 0.14s + 0.1s);
	}
	@keyframes wkst-line { to { opacity: 1; } }
	.wkst__tline.is-cmd { color: #eafcff; }
	.wkst__tline.is-ok { color: #6ee7b7; }
	.wkst__tline.is-live { color: var(--view-accent, #18debe); font-weight: 700; }
	.wkst__caret {
		display: inline-block;
		width: 8px; height: 15px;
		background: var(--view-accent, #18debe);
		animation: wkst-blink 1s steps(2) infinite;
	}
	@keyframes wkst-blink { 50% { opacity: 0; } }

	/* the readme */
	.wkst__read {
		flex: 1 1 auto;
		min-height: 0;
		overflow-y: auto;
		padding: 1rem 1.15rem 1.2rem;
		font-size: 0.78rem;
		line-height: 1.7;
		color: rgba(214, 232, 238, 0.72);
	}
	.wkst__read h3 { font-size: 0.95rem; color: #eafcff; margin: 0 0 0.5rem; }
	.wkst__read h4 { font-size: 0.78rem; color: var(--view-accent, #18debe); margin: 0.9rem 0 0.35rem; }
	.wkst__read ul { list-style: none; margin: 0; padding: 0; }
	.wkst__read li { padding-left: 1rem; position: relative; }
	.wkst__read li::before { content: '-'; position: absolute; left: 0; color: var(--w-dim); }
	.wkst__read pre {
		margin: 0.4rem 0 0;
		padding: 0.6rem 0.7rem;
		border-radius: 0.4rem;
		background: rgba(255, 255, 255, 0.04);
		color: #eafcff;
		font-size: 0.74rem;
		overflow-x: auto;
	}
	.wkst__read-note { margin-top: 0.8rem; color: var(--w-dim); }
	.wkst__read kbd {
		padding: 0 0.28rem;
		border-radius: 0.25rem;
		background: rgba(255, 255, 255, 0.09);
		font-family: inherit;
	}

	/* a shipped site, in a browser */
	.wkst__www {
		flex: 1 1 auto;
		min-height: 0;
		padding: 0.6rem;
		display: grid;
		gap: 0.5rem;
		grid-template-rows: auto minmax(0, 1fr) auto;
	}
	.wkst__www-bar {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.34rem 0.45rem;
		border: 1px solid var(--w-line);
		border-radius: 0.45rem 0.45rem 0 0;
		background: rgba(255, 255, 255, 0.04);
	}
	.wkst__www-dots { display: inline-flex; gap: 0.25rem; }
	.wkst__www-dots i { width: 7px; height: 7px; border-radius: 9999px; background: rgba(255,255,255,0.18); }
	.wkst__www-url {
		flex: 1 1 auto;
		min-width: 0;
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0.14rem 0.5rem;
		border-radius: 9999px;
		background: rgba(0, 0, 0, 0.35);
		color: var(--w-dim);
		font-size: 0.66rem;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.wkst__www-go {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		flex: none;
		padding: 0.2rem 0.5rem;
		border-radius: 0.35rem;
		background: var(--view-accent, #18debe);
		color: #06231c;
		font-size: 0.66rem;
		font-weight: 800;
		text-decoration: none;
	}
	.wkst__www-go:hover { filter: brightness(1.1); }
	.wkst__www-glass {
		position: relative;
		overflow: hidden;
		border: 1px solid var(--w-line);
		border-top: 0;
		border-radius: 0 0 0.45rem 0.45rem;
		background: #05070b;
		min-height: 0;
	}
	.wkst__www-glass img {
		display: block;
		width: 100%;
		height: auto;
		min-height: 100%;
		object-fit: cover;
		object-position: 50% 0;
		transition: object-position 3.5s ease-in-out;
	}
	/* hovering scrolls the page, the way looking at a site does */
	.wkst__www-glass:hover img { object-position: 50% 100%; }
	.wkst__www-cap {
		display: flex;
		align-items: baseline;
		gap: 0.45rem;
		margin: 0;
		font-size: 0.72rem;
		color: var(--w-dim);
		flex-wrap: wrap;
	}
	.wkst__www-cap b { color: var(--w-ink); }
	.wkst__tab--site[hidden] { display: none; }

	/* status bar */
	.wkst__status {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.34rem 0.7rem;
		border-top: 1px solid var(--w-line);
		background: rgba(24, 222, 190, 0.05);
		font-size: 0.66rem;
		color: var(--w-dim);
	}
	.wkst__st { display: inline-flex; align-items: center; gap: 0.28rem; white-space: nowrap; }
	.wkst__st--branch { color: var(--view-accent, #18debe); }
	.wkst__st--dim { opacity: 0.6; }
	.wkst__spacer { flex: 1 1 auto; }
	.wkst__pulse {
		width: 6px; height: 6px; border-radius: 9999px;
		background: #28c840;
		box-shadow: 0 0 8px #28c840;
		animation: wkst-pulse 2s ease-in-out infinite;
	}

	/* ⌘K */
	.wkst__palette {
		position: absolute;
		inset: 0;
		z-index: 20;
		display: grid;
		place-items: start center;
		padding-top: 3.4rem;
		background: rgba(4, 6, 10, 0.72);
		-webkit-backdrop-filter: blur(4px);
		backdrop-filter: blur(4px);
	}
	.wkst__palette[hidden] { display: none; }
	.wkst__palette-card {
		width: min(26rem, calc(100% - 2rem));
		border-radius: 0.6rem;
		overflow: hidden;
		border: 1px solid rgba(24, 222, 190, 0.3);
		background: #0d131a;
		box-shadow: 0 30px 70px -30px rgba(0, 0, 0, 0.9);
		animation: wkst-in 0.2s ease both;
	}
	.wkst__palette-in {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.6rem 0.7rem;
		border-bottom: 1px solid var(--w-line);
		color: var(--view-accent, #18debe);
	}
	.wkst__palette-in input {
		flex: 1 1 auto;
		min-width: 0;
		border: 0;
		background: transparent;
		color: var(--w-ink);
		font-family: inherit;
		font-size: 0.8rem;
		outline: none;
	}
	.wkst__palette-in kbd {
		padding: 0 0.28rem;
		border-radius: 0.25rem;
		background: rgba(255, 255, 255, 0.08);
		color: var(--w-dim);
		font-family: inherit;
		font-size: 0.62rem;
	}
	.wkst__palette-list { list-style: none; margin: 0; padding: 0.3rem; max-height: 14rem; overflow-y: auto; }
	.wkst__cmd {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.44rem 0.5rem;
		border-radius: 0.4rem;
		color: rgba(214, 232, 238, 0.8);
		font-size: 0.76rem;
		text-decoration: none;
	}
	.wkst__cmd em { margin-left: auto; font-style: normal; font-size: 0.66rem; color: var(--w-dim); }
	.wkst__cmd.is-on,
	.wkst__cmd:hover {
		background: color-mix(in srgb, var(--view-accent, #18debe) 16%, transparent);
		color: #eafcff;
	}
	.wkst__cmd[hidden] { display: none; }

	/* the Files button belongs to phones only */
	.wkst__files {
		display: none;
		align-items: center;
		gap: 0.3rem;
		margin-left: auto;
		padding: 0.24rem 0.5rem;
		border: 1px solid var(--w-line);
		border-radius: 0.45rem;
		background: rgba(255, 255, 255, 0.03);
		color: var(--w-dim);
		font-family: inherit;
		font-size: 0.68rem;
		cursor: pointer;
	}
	.wkst.is-drawer .wkst__files {
		color: #eafcff;
		border-color: color-mix(in srgb, var(--view-accent, #18debe) 45%, transparent);
		background: color-mix(in srgb, var(--view-accent, #18debe) 12%, transparent);
	}

	@media (max-width: 900px) {
		.wkst__body { grid-template-columns: minmax(0, 1fr); }
		.wkst__main { grid-column: 1; }
		.wkst__files { display: inline-flex; }
		.wkst__k { margin-left: 0.4rem; }
		/* the tree slides in over the code rather than beside it — it is how
		   every editor behaves once the window gets narrow */
		.wkst__tree,
		.wkst.is-folded .wkst__tree {
			display: flex;
			z-index: 12;
			width: min(15rem, 74%);
			transform: translateX(-102%);
			box-shadow: 10px 0 34px -14px rgba(0, 0, 0, 0.85);
			background: #0c1118;
			transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
		}
		.wkst.is-drawer .wkst__tree { transform: none; }
		/* the rail has no column of its own here */
		.wkst .wkst__rail { display: none; }
	}
	@media (max-width: 900px) and (prefers-reduced-motion: reduce) {
		.wkst__tree { transition: none; }
	}
	@media (max-width: 640px) {
		.wkst__title { display: none; }
		.wkst__k { margin-left: auto; }
		.wkst__term, .wkst__read { font-size: 0.7rem; }
		.wkst .ide2--out { max-height: 6rem; }
		.wkst__status { gap: 0.5rem; overflow-x: auto; scrollbar-width: none; }
	}
	@media (prefers-reduced-motion: reduce) {
		.wkst__tline { opacity: 1; animation: none; }
		.wkst__caret, .wkst__dot, .wkst__pulse { animation: none; }
	}

	.builder--ide {
		position: relative;
		border-radius: 1rem;
		overflow: visible;
		background: #0d111a;
		border: 1px solid rgba(134, 226, 239, 0.18);
		box-shadow: 0 40px 90px -40px rgba(0, 0, 0, 0.9),
			0 0 0 1px rgba(255, 255, 255, 0.02);
	}
	.builder--ide .ide2--bar { border-radius: 1rem 1rem 0 0; }
	/* "this is real" cue badge */
	.ide2--cue {
		position: absolute;
		top: -16px;
		left: 18px;
		z-index: 5;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.74rem;
		font-weight: 700;
		color: #06231c;
		background: linear-gradient(95deg, #8dfeea, #18debe);
		padding: 0.35rem 0.75rem;
		border-radius: 9999px;
		box-shadow: 0 10px 22px -8px rgba(24, 222, 190, 0.7);
		animation: cuebob 2.4s ease-in-out infinite;
		transition: opacity 0.4s ease, transform 0.4s ease;
	}
	.ide2--cue.is-hidden { opacity: 0; transform: translateY(-6px); pointer-events: none; }
	@keyframes cuebob {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(-4px); }
	}
	.ide2--run--pulse { position: relative; }
	.ide2--run--pulse::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: 7px;
		box-shadow: 0 0 0 0 rgba(24, 222, 190, 0.6);
		animation: runpulse 2s ease-out infinite;
	}
	.ide2--run--pulse.is-done::after { animation: none; }
	@keyframes runpulse {
		0% { box-shadow: 0 0 0 0 rgba(24, 222, 190, 0.55); }
		70% { box-shadow: 0 0 0 12px rgba(24, 222, 190, 0); }
		100% { box-shadow: 0 0 0 0 rgba(24, 222, 190, 0); }
	}
	.ide2--bar {
		display: flex;
		align-items: center;
		gap: 7px;
		padding: 0.7rem 0.9rem;
		background: #11161f;
		border-bottom: 1px solid rgba(255, 255, 255, 0.06);
	}
	.ide2--dot {
		width: 11px;
		height: 11px;
		border-radius: 9999px;
		background: #2a3340;
	}
	.ide2--dot:first-child { background: #ff5f57; }
	.ide2--dot:nth-child(2) { background: #febc2e; }
	.ide2--dot:nth-child(3) { background: #28c840; }
	.ide2--file {
		margin-left: 6px;
		font-family: ui-monospace, monospace;
		font-size: 0.8rem;
		color: rgba(232, 240, 244, 0.6);
	}
	.ide2--live {
		margin-left: auto;
		display: inline-flex;
		align-items: center;
		gap: 5px;
		font-family: ui-monospace, monospace;
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: #28c840;
	}
	.ide2--livedot {
		width: 7px;
		height: 7px;
		border-radius: 9999px;
		background: #28c840;
		box-shadow: 0 0 0 0 rgba(40, 200, 64, 0.5);
		animation: pulse 1.8s infinite;
	}
	@keyframes pulse {
		0% { box-shadow: 0 0 0 0 rgba(40, 200, 64, 0.5); }
		70% { box-shadow: 0 0 0 7px rgba(40, 200, 64, 0); }
		100% { box-shadow: 0 0 0 0 rgba(40, 200, 64, 0); }
	}
	.ide2--run {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		margin-left: 0.75rem;
		font-size: 0.74rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: #06231c;
		background: linear-gradient(95deg, #8dfeea, #18debe);
		padding: 0.35rem 0.75rem;
		border-radius: 7px;
		cursor: pointer;
		transition: transform 0.2s ease, filter 0.2s ease;
	}
	.ide2--run:hover { transform: translateY(-1px); filter: brightness(1.05); }

	.ide2--editor {
		position: relative;
		display: grid;
		grid-template-columns: 2.4rem 1fr;
		background: #0d111a;
	}
	.ide2--gutter {
		margin: 0;
		padding: 0.9rem 0;
		text-align: right;
		font-family: ui-monospace, monospace;
		font-size: 0.78rem;
		line-height: 1.55;
		color: rgba(232, 240, 244, 0.25);
		user-select: none;
		border-right: 1px solid rgba(255, 255, 255, 0.05);
	}
	.ide2--code {
		display: block;
		width: 100%;
		min-height: 220px;
		resize: none;
		border: 0;
		outline: none;
		background: transparent;
		color: #cfe9e3;
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.78rem;
		line-height: 1.55;
		padding: 0.9rem 1rem;
		white-space: pre;
		tab-size: 2;
	}
	.ide2--console {
		border-top: 1px solid rgba(255, 255, 255, 0.06);
		background: #090c12;
	}
	.ide2--consolebar {
		display: flex;
		justify-content: space-between;
		padding: 0.5rem 0.9rem;
		font-family: ui-monospace, monospace;
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: rgba(232, 240, 244, 0.4);
		border-bottom: 1px solid rgba(255, 255, 255, 0.04);
	}
	.ide2--out {
		padding: 0.7rem 0.9rem 1rem;
		min-height: 120px;
		font-family: ui-monospace, monospace;
		font-size: 0.8rem;
		display: grid;
		gap: 0.4rem;
		align-content: start;
	}
	.ide2--row {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		opacity: 0;
		transform: translateX(-8px);
		animation: rowin 0.4s ease forwards;
		animation-delay: var(--d, 0s);
	}
	@keyframes rowin {
		to { opacity: 1; transform: translateX(0); }
	}
	.ide2--rocket { filter: saturate(1.2); }
	.ide2--name { color: #e8f0f4; font-weight: 600; }
	.ide2--pill {
		font-size: 0.7rem;
		padding: 0.12rem 0.5rem;
		border-radius: 9999px;
		background: rgba(24, 222, 190, 0.14);
		color: #8dfeea;
		border: 1px solid rgba(24, 222, 190, 0.25);
	}
	.ide2--ok { margin-left: auto; color: #28c840; font-size: 0.72rem; }
	.ide2--done {
		margin-top: 0.4rem;
		padding-top: 0.5rem;
		border-top: 1px dashed rgba(255, 255, 255, 0.1);
		color: #8dfeea;
		opacity: 0;
		animation: rowin 0.4s ease forwards;
	}
	.ide2--err { color: #ff7a7a; }

	@media (max-width: 1023px) {
		.builder--layout { min-height: auto; }
		.builder--token:nth-child(n + 6) { display: none; }
	}
	/* Compact, well proportioned IDE on phones — scrolls inside, not down the page */
	@media (max-width: 768px) {
		/* the same proportions the Founder and Campus heroes use on a phone:
		   a tighter stack, a headline that fits the thumb, buttons that
		   share the row, and the numbers kept on one line */
		.builder--layout {
			gap: 1.5rem;
			padding-top: 0.5rem;
		}
		.builder--head {
			font-size: clamp(2.1rem, 9vw, 3rem);
			margin-bottom: 0.7rem;
		}
		.builder--sub {
			font-size: 0.97rem;
			line-height: 1.6;
			margin-bottom: 1.2rem;
		}
		.builder--caps { margin-bottom: 1.2rem; }
		.builder--cta { gap: 0.6rem; margin-bottom: 1.4rem; }
		.builder--cta > * { flex: 1 1 auto; }
		.builder--tour { padding: 0.8rem 1rem; font-size: 0.78rem; justify-content: center; }
		/* the Founder hero's phone sizing, so the four still share one line */
		.builder--stats { gap: 0.4rem; padding-top: 1.2rem; }
		.builder--statnum { font-size: clamp(1.15rem, 5.4vw, 1.7rem); }
		.builder--statlabel {
			font-size: clamp(0.62rem, 2.5vw, 0.72rem);
			letter-spacing: 0.03em;
			margin-top: 0.2rem;
		}
		.builder--consts { padding-top: 1.2rem; }
		/* the gutter can't scroll with the code pane on phones — drop it
		   so the numbers never drift out of line with the code */
		.ide2--editor {
			grid-template-columns: 1fr;
		}
		.ide2--gutter {
			display: none;
		}
		.ide2--code {
			min-height: 0;
			height: 100%;
			font-size: 0.74rem;
			overflow: auto;
		}
		.ide2--out {
			min-height: 0;
			overflow-y: auto;
			padding: 0.5rem 0.9rem 0.6rem;
		}
		.ide2--row,
		.ide2--out .ide2--row {
			font-size: 0.76rem;
			gap: 0.45rem;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.builder--scan, .builder--token, .builder--blink, .ide2--livedot { animation: none !important; }
	}

	/* ══ Light mode: the cover goes light too. The stage becomes bright
	   paper with a soft teal wash; ink flips dark; the IDE stays a dark
	   "object" on the light stage (code should look like code). ══ */
	/* Daylight here is a desk lamp, not a lightbox. The Builder view is an
	   editor, and an editor in daylight is still a slate surface. */
	:global(html:not(.dark) .builder--stage) {
		background:
			radial-gradient(900px 520px at 78% -10%, rgba(13, 148, 136, 0.14), transparent 62%),
			linear-gradient(180deg, #dde7e6 0%, #cfdcda 100%);
		color: #10201f;
	}
	/* the moving backdrop sits over the stage full-bleed, so it has to come
	   down with it or it just repaints the old paper */
	:global(html:not(.dark)) .builder--bg {
		background:
			radial-gradient(900px 500px at 78% -10%, rgba(13, 148, 136, 0.16), transparent 60%),
			linear-gradient(180deg, #dbe6e4 0%, #c9d8d6 100%);
	}
	:global(html:not(.dark)) .builder--bg::before {
		background:
			radial-gradient(130% 60% at 50% -12%, rgba(255, 255, 255, 0.28), transparent 55%);
	}
	:global(html:not(.dark)) .builder--grid {
		background-image: linear-gradient(rgba(13, 148, 136, 0.13) 1px, transparent 1px),
			linear-gradient(90deg, rgba(13, 148, 136, 0.13) 1px, transparent 1px);
	}
	:global(html:not(.dark)) .builder--scan {
		background: linear-gradient(180deg, transparent, rgba(13, 148, 136, 0.06), transparent);
	}
	:global(html:not(.dark)) .builder--token { color: rgba(15, 118, 110, 0.26); }
	:global(html:not(.dark)) .builder--eyebrow { color: #0f766e; }
	:global(html:not(.dark)) .builder--blink { background: #0f766e; }
	:global(html:not(.dark)) .builder--sub { color: rgba(16, 32, 31, 0.76); }
	/* two lines: the copy is cut to the measure rather than the measure
	   squeezed to the copy, which only ever makes more lines */
	.builder--sub { max-width: 46ch; }
	:global(html:not(.dark)) .builder--caps-k { color: #0f766e; }
	:global(html:not(.dark)) .builder--cap {
		border-color: rgba(13, 148, 136, 0.3);
		background: rgba(255, 255, 255, 0.66);
		color: rgba(16, 32, 31, 0.82);
	}
	:global(html:not(.dark)) .builder--tour {
		color: #14162a;
		border-color: rgba(13, 148, 136, 0.5);
	}
	:global(html:not(.dark)) .builder--tour:hover {
		color: #0f766e;
		background: rgba(13, 148, 136, 0.08);
	}
	:global(html:not(.dark)) .builder--consts { border-top-color: rgba(20, 22, 42, 0.1); }
	:global(html:not(.dark)) .builder--statnum {
		background: linear-gradient(135deg, #0d9488, #0e7490);
		-webkit-background-clip: text;
		background-clip: text;
	}
	:global(html:not(.dark)) .builder--statlabel { color: rgba(16, 32, 31, 0.62); }
	/* the machine keeps its own dark surface in daylight: an editor does */
	:global(html:not(.dark)) .wkst {
		border-color: rgba(13, 148, 136, 0.3);
		box-shadow:
			0 50px 110px -46px rgba(12, 28, 27, 0.55),
			0 0 0 1px rgba(255, 255, 255, 0.05) inset;
	}
	:global(html:not(.dark)) .builder--npm {
		background: rgba(9, 22, 21, 0.92);
		border-color: rgba(13, 148, 136, 0.28);
	}
