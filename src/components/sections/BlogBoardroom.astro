---
// Blog index — the Boardroom world.
//
// Rebuilt in the same grammar as About, Services and Portfolio: the
// opening two-up, then the thing the visitor came for, then the shared
// closing tile. What stood here before was a hero, then a featured
// article, then a heading, then the grid — four separate introductions
// before a single post could be reached, on a journal that has four
// posts in it.
//
// So the featured piece IS the opening now: it sits in the deep panel
// where the film sits on every other page, which is the right place for
// the one thing we most want read. The filter and the grid follow
// immediately, the way the searchable shelf follows the headliner on
// the portfolio page.
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';

interface Props {
	posts: CollectionEntry<'blog'>[];
}
const { posts } = Astro.props;

const featured = posts.find((p) => p.data.featured) ?? posts[0];
// the rest, in date order — the featured piece is already the opening
const rest = posts.filter((p) => p.slug !== featured?.slug);

const cats = [...new Set(posts.map((p) => p.data.category))];
const catSlug = (c: string) => c.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const catCount = (c: string) => posts.filter((p) => p.data.category === c).length;

const words = (body: string) => body?.trim().split(/\s+/).length || 0;
const readTime = (body: string) => Math.max(1, Math.round(words(body) / 200));
const fmtDate = (d: Date) =>
	new Date(d).toLocaleDateString('en-GB', { month: 'short', day: 'numeric', year: 'numeric' });

// a small accent per category, so a page of cards is not one colour
const catColor: Record<string, string> = {
	EdTech: '#2bb3c0',
	Fintech: '#6366f1',
	Marketing: '#ec4899',
	Technology: '#28a6ec',
	Insights: '#28a6ec',
};
const col = (c: string) => catColor[c] ?? '#28a6ec';

// what each topic actually covers, in our own words rather than a bare
// category name — a chip that says "EdTech" tells a reader nothing
const catBlurb: Record<string, string> = {
	EdTech: 'Schools, students and the software that reaches them.',
	Fintech: 'Payments, regulation and who actually gets banked.',
	Marketing: 'What earns attention, and what only rents it.',
	Technology: 'The tools, and the arguments about how to use them.',
	Insights: 'What we are seeing from where we build.',
};
const catIcon: Record<string, string> = {
	EdTech: 'mdi:school-outline',
	Fintech: 'mdi:bank-outline',
	Marketing: 'mdi:bullhorn-outline',
	Technology: 'mdi:chip',
	Insights: 'mdi:lightbulb-on-outline',
};

// the opening's three figures — measured from the journal itself, so
// they cannot drift out of step with what is actually published
const totalMinutes = posts.reduce((n, p) => n + readTime(p.body), 0);
const glance = [
	{ v: `${posts.length}`, k: 'Articles published', s: 'Articles' },
	{ v: `${cats.length}`, k: 'Topics covered', s: 'Topics' },
	{ v: `${totalMinutes}`, k: 'Minutes of reading', s: 'Minutes' },
];

// Categories are data-driven, so the CSS-only filter rules are written
// at build time: a checked radio hides the cards that are not in that
// category and lights its chip in the category's own colour.
const filterCss = cats
	.map((c) => {
		const s = catSlug(c);
		const cc = col(c);
		return [
			`#bl-${s}:checked ~ .bl-grid .bl-card:not(.c-${s}){display:none}`,
			`#bl-${s}:checked ~ .bl-chips label[for="bl-${s}"]{color:#fff;background:${cc};border-color:transparent;box-shadow:0 12px 26px -12px ${cc}}`,
			`#bl-${s}:checked ~ .bl-chips label[for="bl-${s}"] span{color:#fff;background:rgba(255,255,255,.28)}`,
		].join('');
	})
	.join('');
---

<div class="bdbody bd-services bd-blog view-body view-body-boardroom" data-cursor="pen">
	<!-- ── the opening: the words beside the piece we want read ──
	     The same two-up the rest of the site opens on. Where the other
	     pages put a film in the deep panel, the journal puts its lead
	     article: the one thing on a blog worth showing at that size.
	     ────────────────────────────────────────────────────── -->
	<div class="ab-open">
		<article class="ab-open-panel is-pale bd-reveal">
			<div class="ab-open-copy">
				<span class="ab-kick">The Swizel journal</span>
				<h1 class="ab-h1">
					Ideas,
					<em>in the open.</em>
				</h1>
				<p class="ab-lede">
					Field notes from the people building it — technology, fintech,
					education and growth, as they actually look from Lagos, Abuja
					and everywhere else we ship.
				</p>
				<p class="ab-lede ab-lede--sm">
					Field notes from the people building it.
				</p>
				<div class="ab-acts">
					<a href="#bl-journal" class="ab-pill">Read the journal</a>
					<a href="#bl-topics" class="ab-more">
						What we write about
						<Icon width={14} name="mdi:chevron-right" />
					</a>
				</div>
			</div>
			<ul class="ab-glance" aria-label="The journal at a glance">
				{
					glance.map((g) => (
						<li>
							<strong>{g.v}</strong>
							<span>{g.k}</span>
							<span class="ab-glance-s">{g.s}</span>
						</li>
					))
				}
			</ul>
		</article>

		{
			featured && (
				<article class="ab-open-panel is-deep bd-reveal" style={`--c:${col(featured.data.category)}`}>
					<div class="ab-open-copy">
						<span class="ab-kick">Read this first</span>
						<h2 class="ab-h2 ab-h2--panel">
							The one
							<span>we'd start with.</span>
						</h2>
					</div>
					<a class="bl-lead" href={`/blog/${featured.slug}`} data-cursor="book">
						<span class="bl-lead-shot">
							<img
								src={featured.data.heroImage}
								alt={featured.data.title}
								loading="eager"
								decoding="async"
							/>
							<span class="bl-lead-veil" aria-hidden="true" />
						</span>
						<span class="bl-lead-copy">
							<span class="bl-lead-cat">{featured.data.category}</span>
							<strong class="bl-lead-title">{featured.data.title}</strong>
							<span class="bl-lead-meta">
								{fmtDate(featured.data.pubDate)}
								<i aria-hidden="true">·</i>
								{readTime(featured.body)} min read
							</span>
							<span class="bl-lead-go">
								Read the article
								<Icon width={15} name="mdi:arrow-right" />
							</span>
						</span>
					</a>
				</article>
			)
		}
	</div>

	<!-- ── the journal itself ───────────────────────────────
	     Second on the page on purpose. On the portfolio page the search
	     sat nine screens down and nobody was going to reach it; the same
	     mistake on a journal with four articles in it would be worse.
	     ────────────────────────────────────────────────────── -->
	<section class="bd-head bd-reveal" id="bl-journal">
		<span class="bd-kicker">Latest writing</span>
		<h2 class="bd-h bd-h--center">Everything we've published.</h2>
		<p class="bd-p bd-p--center">
			{posts.length} {posts.length === 1 ? 'article' : 'articles'}, {totalMinutes} minutes
			of reading. Pick a topic, or read the lot.
		</p>
	</section>

	<form class="bl-filter" autocomplete="off">
		<input class="bl-radio" type="radio" name="bl" id="bl-all-r" checked />
		{cats.map((c) => <input class="bl-radio" type="radio" name="bl" id={`bl-${catSlug(c)}`} />)}
		<div class="bl-chips bd-reveal">
			<label class="bl-chip" for="bl-all-r">All <span>{posts.length}</span></label>
			{
				cats.map((c) => (
					<label class="bl-chip" for={`bl-${catSlug(c)}`}>
						{c} <span>{catCount(c)}</span>
					</label>
				))
			}
		</div>
		<div class:list={['bl-grid', { 'bl-grid--two': posts.length <= 4 }]}>
			{
				posts.map((p) => (
					<article
						class:list={['bl-card', 'bd-reveal', `c-${catSlug(p.data.category)}`]}
						style={`--c:${col(p.data.category)}`}
						data-cursor="book"
					>
						<a href={`/blog/${p.slug}`} class="bl-card-link">
							<span class="bl-card-media">
								<img src={p.data.heroImage} alt={p.data.title} loading="lazy" decoding="async" />
								<span class="bl-card-cat">{p.data.category}</span>
							</span>
							<span class="bl-card-body">
								<strong class="bl-card-title">{p.data.title}</strong>
								<span class="bl-card-desc">{p.data.description}</span>
							</span>
							<span class="bl-card-foot">
								<span class="bl-card-meta">
									{fmtDate(p.data.pubDate)}
									<i aria-hidden="true">·</i>
									{readTime(p.body)} min
								</span>
								<span class="bl-card-go">
									Read
									<Icon width={14} name="mdi:arrow-right" />
								</span>
							</span>
						</a>
					</article>
				))
			}
		</div>
	</form>

	<!-- ── what we write about ──────────────────────────────
	     A chip that says "EdTech" tells a reader nothing. These say what
	     the topic actually covers, and each one is the filter above it.
	     ────────────────────────────────────────────────────── -->
	<section class="bd-head bd-reveal" id="bl-topics">
		<span class="bd-kicker">The beats</span>
		<h2 class="bd-h bd-h--center">What we write about.</h2>
		<p class="bd-p bd-p--center">
			We only write about the work we do, which is why there is no advice here
			we have not had to take ourselves. Press one to filter the journal.
		</p>
	</section>
	<ul class="bl-topics bd-reveal">
		{
			cats.map((c) => (
				<li class="bl-topic" style={`--c:${col(c)}`}>
					<label class="bl-topic-in" for={`bl-${catSlug(c)}`} data-bl-beat>
						<span class="bl-topic-ic" aria-hidden="true">
							<Icon width={19} name={catIcon[c] ?? 'mdi:lightbulb-on-outline'} />
						</span>
						<strong>{c}</strong>
						<span class="bl-topic-d">{catBlurb[c] ?? 'Notes from the work.'}</span>
						<span class="bl-topic-n">
							{catCount(c)} {catCount(c) === 1 ? 'article' : 'articles'}
						</span>
					</label>
				</li>
			))
		}
	</ul>

	<!-- ── the newsletter ───────────────────────────────────
	     Quieter than it was. It used to be a dark billboard with its own
	     glow, two screens tall, and it carried a note to ourselves about
	     wiring up a provider — which every visitor could read.
	     ────────────────────────────────────────────────────── -->
	<section class="bl-signal bd-reveal" id="bl-signal">
		<span class="bl-signal-edge" aria-hidden="true"></span>
		<div class="bl-signal-copy">
			<span class="bl-signal-h">
				<Icon width={15} name="mdi:email-outline" />
				Stay in the loop
			</span>
			<p>One short note when we publish. No noise, no selling.</p>
		</div>
		<form
			class="bl-signal-form"
			name="newsletter"
			method="post"
			data-netlify="true"
			netlify-honeypot="bot-field"
		>
			<input type="hidden" name="form-name" value="newsletter" />
			<p class="bl-hp"><label>Don't fill this out: <input name="bot-field" /></label></p>
			<span class="bl-signal-field">
				<Icon width={16} name="mdi:email-outline" />
				<input type="email" name="email" required placeholder="you@company.com" aria-label="Email address" />
			</span>
			<button type="submit">
				<span>Join</span>
				<Icon width={16} name="mdi:send" />
			</button>
		</form>
	</section>

	<!-- ── the magazine ─────────────────────────────────────
	     The long-form version of the same instinct, in print.
	     ────────────────────────────────────────────────────── -->
	<a class="bl-mag bd-reveal" href="/brevarium/the-brevarium-latest.pdf" download data-cursor="book">
		<span class="bl-mag-cover">
			<img src="/images/portfolio/mag-latest-cover.jpg" alt="The Brevarium magazine" loading="lazy" />
		</span>
		<span class="bl-mag-meta">
			<span class="bd-kicker">Long-form, in print</span>
			<strong>Prefer the magazine? Read The Brevarium.</strong>
			<em>
				Our featured projects, the team and the thinking behind the work —
				cover to cover.
			</em>
			<span class="bl-mag-dl">
				<Icon width={16} name="mdi:download" />
				Download the latest edition
			</span>
		</span>
	</a>

	<!-- Final CTA — the same desk that closes every other page. -->
	<section class="bd-grid">
		<div class="bd-tile bd-tile--full bd-tile--cta bd-reveal" data-cursor="phone">
			<div class="bd-cta-copy">
				<span class="bd-cta-kick"><i aria-hidden="true" />Let's connect</span>
				<h3 class="bd-display bd-display--cta">
					Read enough.
					<em>Let's build yours.</em>
				</h3>
				<div class="bd-cta-act">
					<a href="/contact" class="bd-cta-go">
						<Icon width={18} name="mdi:arrow-right" />
						<span class="bd-cta-go-l">Start your project</span>
						<span class="bd-cta-go-s">Start a project</span>
					</a>
					<a href="tel:+2348100204570" class="bd-call">
						<span class="bd-call-hint">or call us now</span>
						<span class="bd-call-num">
							<Icon width={22} name="mdi:phone" />
							+234 810 020 4570
						</span>
					</a>
				</div>
			</div>
			<figure class="bd-cta-shot">
				<img
					src="/images/cta/talk-business.jpg"
					alt="A Swizel desk at the end of the day"
					loading="lazy"
					decoding="async"
				/>
				<figcaption class="bd-cta-stamp">
					Bigger ideas.
					<strong>Real results.</strong>
				</figcaption>
			</figure>
		</div>
	</section>
</div>

<style>
	/* ════ Boardroom base (self-contained), boardroom blue ════ */
	.bdbody {
		--bd-accent: #28a6ec;
		--bd-ink: #f4f6fb;
		--bd-muted: rgba(244, 246, 251, 0.62);
		--bd-glass: linear-gradient(160deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.02) 55%);
		--bd-glass-border: rgba(255, 255, 255, 0.1);
		--bd-shadow: 0 34px 80px -34px rgba(0, 0, 0, 0.8);
		font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
		position: relative; isolation: isolate; overflow: hidden;
		background:
			radial-gradient(1100px 540px at 78% -6%, color-mix(in srgb, var(--bd-accent) 13%, transparent), transparent 62%),
			radial-gradient(900px 520px at 8% 38%, rgba(58, 90, 200, 0.1), transparent 60%),
			linear-gradient(180deg, #070910 0%, #0a0d1c 45%, #05060d 100%);
		color: var(--bd-ink);
		padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1rem, 3vw, 2rem) clamp(2.5rem, 5vw, 4rem);
		transition: background 0.4s ease, color 0.4s ease;
	}
	:global(html:not(.dark)) .bdbody {
		--bd-ink: #0f1120;
		--bd-muted: rgba(28, 32, 52, 0.82);
		--bd-glass: linear-gradient(160deg, #ffffff, #f3f6fb 60%);
		--bd-glass-border: rgba(18, 22, 45, 0.16);
		--bd-shadow: 0 26px 60px -32px rgba(20, 28, 60, 0.4);
		background:
			radial-gradient(1100px 540px at 78% -6%, color-mix(in srgb, var(--bd-accent) 12%, transparent), transparent 62%),
			linear-gradient(180deg, #e4eaf2 0%, #dbe3ee 50%, #e4eaf2 100%);
	}
	/* living background */
	.bdbody::before { content: ''; position: absolute; inset: -12%; z-index: -2; pointer-events: none; background: radial-gradient(440px 440px at 14% 16%, color-mix(in srgb, var(--bd-accent) 22%, transparent), transparent 60%), radial-gradient(400px 400px at 86% 26%, rgba(139, 92, 246, 0.18), transparent 60%), radial-gradient(480px 480px at 60% 90%, rgba(34, 211, 238, 0.16), transparent 62%); filter: blur(60px); opacity: 0.65; animation: bl-bg 26s ease-in-out infinite; }
	:global(html:not(.dark)) .bdbody::before { opacity: 0.42; }
	@keyframes bl-bg { 0%,100%{ transform: translate3d(0,0,0) scale(1); } 33%{ transform: translate3d(3%,-2%,0) scale(1.08); } 66%{ transform: translate3d(-2%,2%,0) scale(1.04); } }
	.bdbody::after { content: ''; position: absolute; inset: 0; z-index: -2; pointer-events: none; opacity: 0.45; background-image: radial-gradient(circle, color-mix(in srgb, var(--bd-accent) 30%, transparent) 1px, transparent 1px); background-size: 36px 36px; -webkit-mask-image: radial-gradient(1300px 760px at 50% 2%, #000, transparent 72%); mask-image: radial-gradient(1300px 760px at 50% 2%, #000, transparent 72%); animation: bl-pan 46s linear infinite; }
	:global(html:not(.dark)) .bdbody::after { opacity: 0.28; }
	@keyframes bl-pan { to { background-position: 360px 220px; } }

	.bd-kicker { display: inline-block; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--bd-accent); margin-bottom: 1rem; }
	:global(html:not(.dark)) .bd-kicker { color: #1577b8; }
	.bd-display { font-size: clamp(2.6rem, 6vw, 4.6rem); font-weight: 700; letter-spacing: -0.025em; line-height: 1.04; margin: 0 0 1.1rem; }
	.bd-sub { font-size: clamp(1.05rem, 2vw, 1.35rem); line-height: 1.5; color: var(--bd-muted); max-width: 42rem; margin: 0 auto 1.6rem; }
	.bd-h { font-size: clamp(1.7rem, 3.4vw, 2.5rem); font-weight: 700; letter-spacing: -0.02em; line-height: 1.1; margin: 0 0 0.7rem; }
	.bd-h--center { text-align: center; }
	.bd-p { font-size: 1.02rem; line-height: 1.6; color: var(--bd-muted); max-width: 36rem; margin: 0 auto 1.2rem; }
	.bd-p--center { margin-inline: auto; text-align: center; }
	.bd-head { max-width: 56rem; margin: clamp(2.5rem, 7vw, 4.5rem) auto clamp(1.5rem, 3vw, 2rem); text-align: center; }

	/* ── the lead article, in the deep panel ──
	   Where the film sits on every other page. It is a picture with the
	   title on it rather than beside it, because the panel is tall and
	   narrow and a headline in a column beside a photograph at this width
	   ends up two words to a line. */
	.bl-lead {
		position: relative;
		display: block;
		flex: 1;
		min-height: 0;
		margin: clamp(1.2rem, 3vw, 2rem) clamp(1rem, 2.2vw, 1.8rem) clamp(1rem, 2.2vw, 1.8rem);
		border-radius: clamp(0.8rem, 1.4vw, 1.15rem);
		overflow: hidden;
		background: #05070f;
		border: 1px solid color-mix(in srgb, var(--c, #28a6ec) 34%, rgba(255, 255, 255, 0.12));
		box-shadow: 0 40px 80px -38px rgba(0, 0, 0, 0.8);
		transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.4s ease;
	}
	.bl-lead:hover { transform: translateY(-4px); border-color: color-mix(in srgb, var(--c, #28a6ec) 62%, transparent); }
	.bl-lead-shot { position: absolute; inset: 0; display: block; }
	.bl-lead-shot img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1); }
	.bl-lead:hover .bl-lead-shot img { transform: scale(1.05); }
	/* the picture has to carry type, so it is darkened from the bottom
	   rather than dimmed all over — the photograph still reads */
	.bl-lead-veil {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			180deg,
			rgba(4, 6, 12, 0.08) 0%,
			rgba(4, 6, 12, 0.55) 46%,
			rgba(4, 6, 12, 0.92) 100%
		);
	}
	.bl-lead-copy {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: flex-end;
		height: 100%;
		min-height: clamp(14rem, 34vw, 21rem);
		padding: clamp(1rem, 2.4vw, 1.5rem);
		color: #fff;
	}
	.bl-lead-cat {
		align-self: flex-start;
		margin-bottom: auto;
		padding: 0.28rem 0.65rem;
		border-radius: 9999px;
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #fff;
		background: color-mix(in srgb, var(--c, #28a6ec) 88%, transparent);
		box-shadow: 0 8px 20px -8px color-mix(in srgb, var(--c, #28a6ec) 80%, transparent);
	}
	.bl-lead-title {
		font-size: clamp(1.15rem, 2.4vw, 1.6rem);
		font-weight: 700;
		line-height: 1.2;
		letter-spacing: -0.02em;
		margin: 0.9rem 0 0.4rem;
		text-wrap: balance;
	}
	.bl-lead-meta {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.78rem;
		color: rgba(255, 255, 255, 0.72);
	}
	.bl-lead-meta i { font-style: normal; opacity: 0.55; }
	.bl-lead-go {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin-top: 0.85rem;
		font-size: 0.85rem;
		font-weight: 750;
		color: #fff;
		transition: gap 0.25s ease;
	}
	.bl-lead:hover .bl-lead-go { gap: 0.62rem; }

	/* ── the filter ── */
	.bl-filter { max-width: 84rem; margin: 0 auto; }
	.bl-radio { position: absolute; opacity: 0; pointer-events: none; width: 0; height: 0; }
	.bl-chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.55rem; margin: 0 auto clamp(1.4rem, 3vw, 2rem); padding: clamp(0.8rem, 1.8vw, 1.05rem); border-radius: 1.4rem; background: color-mix(in srgb, var(--bd-accent) 6%, var(--bd-glass)); border: 1px solid color-mix(in srgb, var(--bd-accent) 18%, var(--bd-glass-border)); box-shadow: var(--bd-shadow); max-width: 52rem; }
	.bl-chip { display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.52rem 1rem; border-radius: 9999px; font-size: 0.9rem; font-weight: 700; color: var(--bd-ink); background: var(--bd-glass); border: 1.5px solid color-mix(in srgb, var(--bd-ink) 16%, var(--bd-glass-border)); cursor: pointer; transition: transform 0.2s ease, border-color 0.25s ease, background 0.25s ease, color 0.25s ease, box-shadow 0.25s ease; }
	.bl-chip span { font-size: 0.72rem; font-weight: 800; padding: 0.06rem 0.46rem; border-radius: 9999px; color: var(--bd-accent); background: color-mix(in srgb, var(--bd-accent) 16%, transparent); }
	:global(html:not(.dark)) .bl-chip span { color: #1577b8; background: color-mix(in srgb, #1577b8 16%, transparent); }
	.bl-chip:hover { transform: translateY(-2px); border-color: color-mix(in srgb, var(--bd-accent) 55%, var(--bd-glass-border)); }
	#bl-all-r:checked ~ .bl-chips label[for='bl-all-r'] { color: #06121a; background: linear-gradient(95deg, #8dfeea, #18debe, #28a6ec); border-color: transparent; box-shadow: 0 12px 26px -12px rgba(24, 222, 190, 0.5); }
	#bl-all-r:checked ~ .bl-chips label[for='bl-all-r'] span { color: #06121a; background: rgba(0,0,0,0.14); }

	/* ── the grid ──
	   Three across, and the cards keep the same shape whatever length of
	   title or standfirst they are given: the picture is a fixed ratio,
	   the text block is clamped, and the date and the link are the card's
	   own last row so they sit on the floor of every card in the line. */
	.bl-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1rem, 2.2vw, 1.55rem); }
	/* Four articles in a three-column grid is a row of three and then one
	   card sitting on its own, which reads as a page that has lost
	   something. While the journal is this small it runs two across and
	   squares up; the class comes off by itself once there are more than
	   four posts to lay out. */
	.bl-grid--two { grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: 68rem; margin-inline: auto; }
	.bl-card { border-radius: 1.3rem; overflow: hidden; background: var(--bd-glass); border: 1px solid var(--bd-glass-border); box-shadow: var(--bd-shadow); transition: transform 0.4s cubic-bezier(0.22,1,0.36,1), border-color 0.4s ease, box-shadow 0.4s ease; }
	.bl-card:hover { transform: translateY(-6px); border-color: color-mix(in srgb, var(--c) 50%, var(--bd-glass-border)); box-shadow: 0 44px 90px -34px color-mix(in srgb, var(--c) 40%, rgba(0,0,0,0.85)); }
	.bl-card-link { display: grid; grid-template-rows: auto 1fr auto; height: 100%; }
	.bl-card-media { position: relative; display: block; aspect-ratio: 16 / 9; overflow: hidden; }
	.bl-card-media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s cubic-bezier(0.22,1,0.36,1); }
	.bl-card:hover .bl-card-media img { transform: scale(1.06); }
	.bl-card-cat { position: absolute; top: 0.7rem; left: 0.7rem; font-size: 0.68rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; padding: 0.28rem 0.62rem; border-radius: 9999px; color: #fff; background: color-mix(in srgb, var(--c) 85%, transparent); box-shadow: 0 6px 16px -6px color-mix(in srgb, var(--c) 70%, transparent); }
	.bl-card-body { display: block; padding: 1rem 1.15rem 0.4rem; }
	.bl-card-title { display: block; font-size: 1.08rem; font-weight: 700; letter-spacing: -0.012em; line-height: 1.25; margin-bottom: 0.4rem; color: var(--bd-ink); display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
	.bl-card-desc { font-size: 0.88rem; line-height: 1.55; color: var(--bd-muted); display: -webkit-box; -webkit-line-clamp: 3; line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
	.bl-card-foot { display: flex; align-items: center; justify-content: space-between; gap: 0.8rem; padding: 0.7rem 1.15rem 1.05rem; }
	.bl-card-meta { display: flex; align-items: center; gap: 0.35rem; font-size: 0.76rem; color: var(--bd-muted); }
	.bl-card-meta i { font-style: normal; opacity: 0.55; }
	.bl-card-go { display: inline-flex; align-items: center; gap: 0.3rem; font-size: 0.78rem; font-weight: 750; color: var(--c); transition: gap 0.25s ease; }
	.bl-card:hover .bl-card-go { gap: 0.5rem; }

	/* ── the beats ──
	   Each one is a label for the radio above, so pressing a topic filters
	   the grid — the section is not decoration, it is the same control in
	   a form that says what it does. */
	.bl-topics { list-style: none; max-width: 84rem; margin: 0 auto; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(0.8rem, 1.8vw, 1.2rem); }
	.bl-topic { min-width: 0; }
	.bl-topic-in { display: grid; align-content: start; gap: 0.3rem; height: 100%; padding: clamp(0.95rem, 2vw, 1.25rem); border-radius: 1.15rem; background: var(--bd-glass); border: 1px solid var(--bd-glass-border); box-shadow: var(--bd-shadow); cursor: pointer; transition: transform 0.35s cubic-bezier(0.22,1,0.36,1), border-color 0.3s ease; }
	.bl-topic-in:hover { transform: translateY(-4px); border-color: color-mix(in srgb, var(--c) 45%, var(--bd-glass-border)); }
	.bl-topic-ic { display: grid; place-items: center; width: 2.3rem; height: 2.3rem; margin-bottom: 0.35rem; border-radius: 0.8rem; color: var(--c); background: color-mix(in srgb, var(--c) 14%, transparent); border: 1px solid color-mix(in srgb, var(--c) 28%, transparent); }
	.bl-topic-in strong { font-size: 1rem; font-weight: 700; letter-spacing: -0.01em; color: var(--bd-ink); }
	.bl-topic-d { font-size: 0.84rem; line-height: 1.45; color: var(--bd-muted); }
	.bl-topic-n { margin-top: 0.45rem; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: var(--c); }

	/* ── the newsletter, at the volume of the footer's ── */
	.bl-signal { position: relative; overflow: hidden; display: grid; gap: 0.9rem; max-width: 60rem; margin: clamp(2.5rem, 6vw, 4rem) auto; padding: clamp(1.15rem, 2.6vw, 1.6rem) clamp(1.25rem, 3vw, 1.9rem) clamp(1.35rem, 3vw, 1.9rem); border-radius: 1.25rem; background: color-mix(in srgb, var(--bd-accent) 7%, var(--bd-glass)); border: 1px solid color-mix(in srgb, var(--bd-accent) 26%, var(--bd-glass-border)); box-shadow: var(--bd-shadow); }
	.bl-signal-edge { position: absolute; top: 0; left: 0; right: 0; height: 1px; background: linear-gradient(90deg, transparent, var(--bd-accent), transparent); opacity: 0.85; }
	.bl-signal-copy { display: flex; flex-direction: column; gap: 0.2rem; }
	.bl-signal-h { display: inline-flex; align-items: center; gap: 0.42rem; font-size: 0.74rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--bd-accent); }
	:global(html:not(.dark)) .bl-signal-h { color: #1577b8; }
	.bl-signal-copy p { margin: 0; font-size: 0.86rem; line-height: 1.5; color: var(--bd-muted); }
	.bl-signal-form { display: flex; gap: 0.55rem; width: 100%; }
	.bl-signal-field { flex: 1; display: flex; align-items: center; gap: 0.5rem; min-width: 0; padding: 0.15rem 0.9rem; border-radius: 9999px; color: var(--bd-muted); background: color-mix(in srgb, var(--bd-ink) 6%, transparent); border: 1px solid var(--bd-glass-border); transition: border-color 0.25s ease; }
	.bl-signal-field:focus-within { border-color: color-mix(in srgb, var(--bd-accent) 55%, transparent); }
	.bl-signal-field input { flex: 1; min-width: 0; padding-block: 0.68rem; border: 0; background: none; color: var(--bd-ink); font-size: 0.92rem; }
	.bl-signal-field input:focus { outline: none; }
	.bl-signal-field input::placeholder { color: var(--bd-muted); }
	.bl-signal-form button { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.68rem 1.35rem; border-radius: 9999px; border: 0; font-size: 0.9rem; font-weight: 750; color: #06121a; background: linear-gradient(95deg, #8dfeea, #18debe, #28a6ec); cursor: pointer; transition: transform 0.25s ease, filter 0.25s ease; }
	.bl-signal-form button:hover { transform: translateY(-1px); filter: brightness(1.06); }
	.bl-hp { position: absolute; left: -9999px; }

	/* ── the magazine ── */
	.bl-mag { display: flex; gap: clamp(1rem, 2.5vw, 1.6rem); align-items: center; max-width: 60rem; margin: 0 auto; padding: clamp(1.1rem, 2.5vw, 1.6rem); border-radius: 1.4rem; background: var(--bd-glass); border: 1px solid var(--bd-glass-border); box-shadow: var(--bd-shadow); transition: transform 0.35s ease, border-color 0.35s ease; }
	.bl-mag:hover { transform: translateY(-5px); border-color: color-mix(in srgb, var(--bd-accent) 45%, var(--bd-glass-border)); }
	.bl-mag-cover { flex-shrink: 0; width: clamp(80px, 18vw, 118px); border-radius: 0.7rem; overflow: hidden; box-shadow: 0 18px 40px -18px rgba(0,0,0,0.6); }
	.bl-mag-cover img { width: 100%; display: block; }
	.bl-mag-meta { display: flex; flex-direction: column; gap: 0.3rem; min-width: 0; }
	.bl-mag-meta .bd-kicker { margin-bottom: 0.2rem; }
	.bl-mag-meta strong { font-size: clamp(1.05rem, 2.2vw, 1.35rem); font-weight: 700; letter-spacing: -0.01em; }
	.bl-mag-meta em { font-style: normal; font-size: 0.9rem; line-height: 1.5; color: var(--bd-muted); }
	.bl-mag-dl { margin-top: 0.4rem; display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.85rem; font-weight: 750; color: var(--bd-accent); }
	:global(html:not(.dark)) .bl-mag-dl { color: #1577b8; }

	/* ── Reveal ── */
	.bd-reveal { opacity: 0; transform: translateY(26px); transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.22, 1, 0.36, 1); }
	.bd-reveal.is-on { opacity: 1; transform: translateY(0); }
	@media (prefers-reduced-motion: reduce) {
		.bd-reveal { opacity: 1; transform: none; transition: none; }
		.bdbody::before, .bdbody::after { animation: none; }
		.bl-card:hover, .bl-mag:hover, .bl-lead:hover, .bl-topic-in:hover { transform: none; }
	}
	/* ═══ shared with the rest of the site ═════════════════════════════
	   The opening two-up, the numbers band and the closing tile are the
	   same objects everywhere. Lifted rather than re-written, and kept at
	   the end of the sheet where source order settles them against the
	   older page-specific rules above.
	   ══════════════════════════════════════════════════════════════════ */
	/* ── the numbers band ──────────────────────────────────────────────
	   It spans the page rather than sitting inside the 88rem grid: five
	   figures deserve the width, and the band is what separates the story
	   above it from the proof below. The body's own side padding is given
	   back with a negative margin, which is exact and, unlike 100vw,
	   cannot open a scrollbar of its own. */
	.bd-band {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		max-width: none;
		width: auto;
		margin-inline: calc(-1 * clamp(1rem, 3vw, 2rem));
		margin-block: clamp(1.2rem, 2.6vw, 2rem) clamp(0.9rem, 2vw, 1.4rem);
		border-radius: clamp(1rem, 2vw, 1.6rem);
		padding-inline: clamp(1.2rem, 4vw, 3.4rem);
		padding-block: clamp(1.6rem, 3vw, 2.5rem);
		/* deeper than the rest of the body on purpose: this band is the
		   quiet beat between the story above it and the proof below */
		background:
			radial-gradient(900px 320px at 50% -24%, color-mix(in srgb, var(--bd-accent) 13%, transparent), transparent 70%),
			linear-gradient(180deg, #05070f 0%, #02030a 100%);
		border-color: rgba(155, 216, 255, 0.1);
	}
	/* the heading is a label here, not a headline: the figures are the
	   thing being looked at */
	.bd-band .bd-h {
		font-size: clamp(1.35rem, 2.5vw, 2rem);
		letter-spacing: -0.03em;
		margin: 0;
	}
	.bd-band .bd-p {
		margin: 0.45rem auto 0;
		max-width: 40rem;
		font-size: clamp(0.82rem, 1vw, 0.92rem);
		line-height: 1.55;
	}
	/* the accent falls on one word, which is the only ornament the
	   heading needs */
	.bd-band .bd-h em {
		font-style: normal;
		background: linear-gradient(120deg, #cfeaff 5%, var(--bd-accent) 75%);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}
	.bd-numbers {
		display: grid;
		/* however many figures there are, not always five: with four the
		   fixed five-column grid left an empty column and the row sat
		   off-centre in its own band */
		grid-auto-flow: column;
		grid-auto-columns: minmax(0, 1fr);
		gap: clamp(0.5rem, 1.1vw, 0.85rem);
		list-style: none;
		margin: clamp(1.1rem, 2.4vw, 1.6rem) 0 0;
		padding: 0;
	}
	/* Five cards, each one hairline, icon, figure, label and the shape it
	   made. Nothing is filled, nothing glows: the only movement is the
	   figure counting and the line drawing itself. */
	.bd-number {
		min-width: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		padding: clamp(0.85rem, 1.7vw, 1.15rem) clamp(0.55rem, 1.2vw, 0.9rem)
			clamp(0.6rem, 1.3vw, 0.85rem);
		border-radius: clamp(0.65rem, 1.1vw, 0.85rem);
		border: 1px solid rgba(155, 216, 255, 0.095);
		background: rgba(255, 255, 255, 0.014);
		transition: border-color 0.35s ease, background 0.35s ease,
			transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.bd-number:hover {
		border-color: color-mix(in srgb, var(--bd-accent) 38%, transparent);
		background: rgba(255, 255, 255, 0.035);
		transform: translateY(-2px);
	}
	.bd-number-ic {
		display: grid;
		place-items: center;
		width: 1.85rem;
		height: 1.85rem;
		border-radius: 0.55rem;
		border: 1px solid rgba(155, 216, 255, 0.16);
		background: color-mix(in srgb, var(--bd-accent) 9%, transparent);
		color: #7fc7f0;
		margin-bottom: 0.5rem;
	}
	.bd-number-ic :global(svg) { width: 15px; height: 15px; }

	/* ── the line under each figure ──
	   Drawn rather than faded in: the stroke is dashed to its own length
	   and the dash walked to zero, which is a pen moving across the box
	   rather than a picture appearing. */
	/* named "trend", not "spark": global.css stops anything whose class
	   carries spark/glow/aura from animating on weak hardware — right for
	   a particle emitter, wrong for a line that draws itself once. */
	.bd-trend {
		display: block;
		width: 100%;
		height: clamp(13px, 1.5vw, 17px);
		margin-top: clamp(0.5rem, 1.1vw, 0.75rem);
		overflow: hidden;
	}
	.bd-trend-line {
		fill: none;
		stroke: var(--bd-accent);
		stroke-width: 0.75;
		stroke-linecap: round;
		stroke-linejoin: round;
		opacity: 0.62;
		/* the path measures a shade over 100 user units, and the dash is
		   measured in the same units now, so one dash covers one line */
		stroke-dasharray: 104;
		stroke-dashoffset: 104;

	}

	.bd-band.is-on .bd-trend-line {
		animation: bd-draw 1.5s cubic-bezier(0.3, 0.8, 0.3, 1) forwards;
		animation-delay: calc(0.25s + var(--n) * 0.16s);
	}
	@keyframes bd-draw { to { stroke-dashoffset: 0; } }

	.bd-number-l {
		display: block;
		margin-top: 0.22rem;
		font-size: clamp(0.7rem, 0.82vw, 0.78rem);
		line-height: 1.3;
		color: rgba(245, 245, 247, 0.5);
	}

	@media (prefers-reduced-motion: reduce) {
		.bd-band .bd-trend-line { stroke-dashoffset: 0; }
		.bd-band.is-on .bd-trend-line { animation: none; }
		.bd-number,
		.bd-number:hover { transform: none; transition: none; }
	}
	/* The band stays one row of five on every screen — it is a line of
	   figures, and a line of figures wrapped over two rows is a table.
	   What gives instead is the weight: the icon goes, the label shortens
	   to a single word, and the card loses its frame until only the
	   numbers and their lines are left. */
	.bd-number-s { display: none; }
	@media (max-width: 880px) {
		.bd-numbers { gap: clamp(0.25rem, 1.2vw, 0.6rem); }
		.bd-number { padding: 0.75rem 0.3rem 0.5rem; }
		.bd-number-ic { width: 1.5rem; height: 1.5rem; border-radius: 0.45rem; margin-bottom: 0.35rem; }
		.bd-number-ic :global(svg) { width: 12px; height: 12px; }
		.bd-number strong { font-size: clamp(1.05rem, 3.2vw, 1.6rem); }
		.bd-number-l { font-size: 0.62rem; }
	}
	@media (max-width: 620px) {
		.bd-number {
			padding: 0.55rem 0.15rem 0.4rem;
			border-color: transparent;
			background: none;
		}
		.bd-number-ic { display: none; }
		.bd-number strong { font-size: clamp(0.95rem, 4.4vw, 1.35rem); }
		.bd-number-l { display: none; }
		.bd-number-s {
			display: block;
			margin-top: 0.15rem;
			font-size: clamp(0.54rem, 2.1vw, 0.66rem);
			line-height: 1.2;
			letter-spacing: 0.01em;
			color: rgba(245, 245, 247, 0.5);
		}
		.bd-trend { height: 10px; margin-top: 0.4rem; }
		.bd-band { padding-inline: clamp(0.7rem, 3vw, 1.2rem); }
		.bd-band .bd-h { font-size: clamp(1.15rem, 5vw, 1.5rem); }
		.bd-band .bd-p { font-size: 0.76rem; }
	}

	@media (max-width: 880px) {
		.bd-band { padding-inline: clamp(1.2rem, 5vw, 2rem); }
	}
	.bd-number strong {
		display: block;
		font-size: clamp(1.7rem, 3.1vw, 2.4rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		background: linear-gradient(135deg, #9bd8ff, var(--bd-accent));
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}



	/* ── the closing tile ── */
	.bd-tile--cta {
		position: relative;
		overflow: hidden;
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
		align-items: stretch;
		gap: 0;
		padding: 0;
		text-align: left;
		background:
			radial-gradient(760px 420px at 6% 110%, color-mix(in srgb, var(--bd-accent) 26%, transparent), transparent 70%),
			linear-gradient(180deg, rgba(14, 19, 36, 0.96), rgba(4, 6, 13, 0.98));
		color: #f5f5f7;
		border-color: color-mix(in srgb, var(--bd-accent) 26%, rgba(255, 255, 255, 0.1));
	}
	.bd-cta-copy {
		padding: clamp(2.2rem, 5vw, 4.2rem) clamp(1.4rem, 3.4vw, 3.4rem);
		align-self: center;
		/* a grid item's automatic minimum is its content, and a phone
		   number set nowrap is wide content: without this the column grows
		   past the tile and the tile quietly clips it */
		min-width: 0;
	}
	.bd-cta-kick {
		display: inline-flex;
		align-items: center;
		gap: 0.85rem;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.26em;
		text-transform: uppercase;
		color: rgba(245, 245, 247, 0.6);
	}
	.bd-cta-kick i {
		width: clamp(1.6rem, 3vw, 2.6rem);
		height: 2px;
		border-radius: 999px;
		background: var(--bd-accent);
	}
	.bd-display--cta {
		margin: clamp(0.9rem, 2vw, 1.3rem) 0 0;
		font-size: clamp(2.1rem, 4.4vw, 3.6rem);
		line-height: 1.02;
		letter-spacing: -0.04em;
	}
	.bd-display--cta em {
		display: block;
		font-style: normal;
		font-weight: 800;
		background: linear-gradient(100deg, #e9f6ff 10%, var(--bd-accent) 85%);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}
	.bd-tile--cta .bd-sub {
		margin: clamp(0.9rem, 2vw, 1.25rem) 0 0;
		max-width: 27rem;
		margin-inline: 0;
	}
	.bd-cta-act {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: clamp(1rem, 2.4vw, 2rem);
		margin-top: clamp(1.5rem, 3.2vw, 2.4rem);
	}
	/* the one thing on this tile we want pressed: it breathes until it is */
	.bd-cta-go {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		min-height: 3.35rem;
		padding: 0 1.8rem;
		border-radius: 999px;
		background: linear-gradient(120deg, var(--bd-accent), #3b7dfd);
		color: #04101a;
		font-size: 1rem;
		font-weight: 700;
		white-space: nowrap;
		transition: transform 0.25s ease, filter 0.25s ease;
	}
	.bd-cta-go::after {
		content: '';
		position: absolute;
		inset: -3px;
		border-radius: inherit;
		border: 2px solid var(--bd-accent);
		opacity: 0;
		pointer-events: none;
