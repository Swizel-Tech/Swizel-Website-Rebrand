		.ab-screen :global(.flm__big) { transform: scale(0.52); }
	}
	@media (prefers-reduced-motion: reduce) { .ab-pill:hover { transform: none; } }

	/* ── tap to expand ──
	   On a phone the film in this panel is about a third of the screen
	   wide: fine as a picture, poor as a film. This says so, and presses
	   the player's own full-screen and play controls in order, so
	   expanding here behaves exactly as it does anywhere else. */
	.ab-screen-open {
		position: absolute;
		top: clamp(0.5rem, 1.4vw, 0.9rem);
		right: clamp(0.5rem, 1.4vw, 0.9rem);
		z-index: 5;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.34rem 0.7rem 0.34rem 0.55rem;
		border-radius: 999px;
		border: 1px solid rgba(255, 255, 255, 0.28);
		background: rgba(6, 9, 16, 0.6);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		color: #fff;
		font-size: 0.68rem;
		font-weight: 650;
		white-space: nowrap;
		cursor: pointer;
		transition: background 0.25s ease, transform 0.25s ease;
	}
	.ab-screen-open:hover { background: rgba(6, 9, 16, 0.85); transform: translateY(-1px); }
	/* it breathes on a touch screen, where it is most needed and there is
	   no hover to discover it with */
	@media (hover: none) {
		.ab-screen-open { animation: ab-open-beat 2.8s ease-in-out infinite; }
	}
	@keyframes ab-open-beat {
		0%, 100% { box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.35); }
		60% { box-shadow: 0 0 0 8px rgba(255, 255, 255, 0); }
	}
	@media (prefers-reduced-motion: reduce) {
		.ab-screen-open { animation: none; }
	}

	/* ── the case-study shelf on a phone ──
	   Last in the sheet on purpose: a media query carries no extra weight
	   of its own, so it only beats the plain-class rules above by coming
	   after them.

	   Narrower cards, never a stacked column — about a card and a half in
	   view, so the next one is always showing past the right edge and the
	   row reads as a row. The arrows go, because a finger does not need
	   them, and a line of text says so instead. */

	/* ── the expand control, on a phone ──
	   Last in the sheet on purpose: a media query carries no weight of its
	   own and only beats the plain rules above by coming after them.

	   A small dark pill in the corner of a film was the wrong answer at
	   this size. It sat on top of whatever the film happened to be showing
	   — often white type — so half the time it could not be read, and the
	   player's own transport underneath it was a row of three-millimetre
	   buttons that nobody can hit anyway.

	   So at this width the frame stops pretending to be a player and goes
	   back to being a poster: the whole picture is the button, it carries
	   one unmissable label, and everything else happens in cinema mode
	   where the controls are full size. */
	@media (max-width: 720px) {
		.ab-screen-open {
			position: absolute;
			inset: 0;
			top: 0;
			right: 0;
			z-index: 6;
			display: grid;
			place-items: center;
			width: 100%;
			height: 100%;
			padding: 0;
			border: 0;
			border-radius: 0;
			background: linear-gradient(180deg, rgba(3, 5, 12, 0.18), rgba(3, 5, 12, 0.58));
			backdrop-filter: none;
			-webkit-backdrop-filter: none;
			font-size: inherit;
			animation: none;
		}
		.ab-screen-open-in {
			display: inline-flex;
			align-items: center;
			gap: 0.4rem;
			padding: 0.5rem 0.9rem;
			border-radius: 9999px;
			background: #28a6ec;
			color: #fff;
			font-size: 0.78rem;
			font-weight: 750;
			letter-spacing: 0.01em;
			white-space: nowrap;
			box-shadow: 0 10px 26px -10px rgba(40, 166, 236, 0.85);
			animation: ab-open-beat 2.8s ease-in-out infinite;
		}
		.ab-screen-open:active .ab-screen-open-in { transform: scale(0.96); }
		/* the cramped transport and the small play ring both belong to the
		   full-size player now, not to this poster */
		.ab-screen :global(.flm:not(.is-cinema) .flm__bar),
		.ab-screen :global(.flm:not(.is-cinema) .flm__big) { display: none; }
	}
	/* while a film is filling the screen, the poster's button is not
	   wanted anywhere underneath it */
	:global(html.flm-cinema) .ab-screen-open { display: none; }
	/* a narrow phone: the label still has to sit inside the frame with
	   room to breathe rather than touching both bezels */
	@media (max-width: 420px) {
		.ab-screen-open-in { padding: 0.44rem 0.72rem; font-size: 0.72rem; gap: 0.32rem; }
	}
	@media (prefers-reduced-motion: reduce) {
		.ab-screen-open-in { animation: none; }
	}

	/* ── the journal on smaller screens ──
	   Last in the sheet on purpose: a media query carries no weight of
	   its own and only beats the plain rules above by coming after them.

	   The grid narrows rather than unstacking: two across on a tablet,
	   and on a phone the cards go one under the other only because a
	   blog card is a picture plus three lines of standfirst and half of
	   that at 46vw is unreadable — the beats below stay two across,
	   because those are four short labels and there is no reason to make
	   somebody scroll through them one at a time. */
	@media (max-width: 1000px) {
		.bl-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.bl-topics { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}
	@media (max-width: 620px) {
		.bl-grid { grid-template-columns: 1fr; gap: 0.9rem; }
		.bl-card-title { font-size: 1.02rem; }
		.bl-card-desc { -webkit-line-clamp: 2; line-clamp: 2; }
		.bl-topic-in { padding: 0.85rem 0.9rem 1rem; border-radius: 1rem; }
		.bl-topic-ic { width: 2rem; height: 2rem; border-radius: 0.68rem; margin-bottom: 0.25rem; }
		.bl-topic-in strong { font-size: 0.92rem; }
		.bl-topic-d { font-size: 0.76rem; line-height: 1.4; }
		.bl-topic-n { font-size: 0.66rem; margin-top: 0.35rem; }
		/* the chips scroll sideways rather than stacking into a block of
		   buttons that is taller than the first article */
		.bl-chips {
			flex-wrap: nowrap;
			justify-content: flex-start;
			overflow-x: auto;
			scrollbar-width: none;
			border-radius: 1.1rem;
			padding: 0.7rem;
		}
		.bl-chips::-webkit-scrollbar { display: none; }
		.bl-chip { flex: 0 0 auto; font-size: 0.84rem; padding: 0.46rem 0.85rem; }
		/* The lead article keeps its picture and stays beside the copy
		   panel rather than dropping under it, so the column it lives in
		   is about a hundred and fifty pixels of text. A headline set at
		   desktop size in that space comes out two words to a line and
		   six lines tall, and the date and the link wrap as well. Every
		   line here is about making that column readable rather than
		   about making it smaller. */
		.bl-lead { margin: 0.8rem 0.7rem 0.7rem; }
		.bl-lead-copy { min-height: 11.5rem; padding: 0.8rem; }
		.bl-lead-cat { font-size: 0.6rem; padding: 0.22rem 0.5rem; }
		.bl-lead-title {
			font-size: 0.92rem;
			line-height: 1.22;
			letter-spacing: -0.015em;
			margin: 0.7rem 0 0.35rem;
			text-wrap: pretty;
			display: -webkit-box;
			-webkit-line-clamp: 4;
			line-clamp: 4;
			-webkit-box-orient: vertical;
			overflow: hidden;
		}
		/* one line, both halves of it: a date that breaks after "Jun" and
		   a read time that breaks after "8 min" is three lines of noise */
		.bl-lead-meta { flex-wrap: nowrap; white-space: nowrap; font-size: 0.68rem; gap: 0.3rem; }
		.bl-lead-go { margin-top: 0.6rem; font-size: 0.75rem; white-space: nowrap; }
	}
	@media (max-width: 400px) {
		.bl-lead-title { font-size: 0.86rem; -webkit-line-clamp: 3; line-clamp: 3; }
		.bl-lead-meta { font-size: 0.64rem; }
		.bl-lead-copy { min-height: 10.5rem; padding: 0.7rem; }
	}
	@media (max-width: 560px) {
		/* the field and the button, one under the other, both full width */
		.bl-signal-form { flex-wrap: wrap; }
		.bl-signal-form button { width: 100%; justify-content: center; }
		.bl-mag { gap: 0.85rem; padding: 0.95rem; }
		.bl-mag-meta em { font-size: 0.82rem; }
	}
</style>

