---
// Portfolio · Studio world — the Collection Wing of The Swizel Gallery.
// The complete catalogue: featured exhibitions (case studies) as big rooms,
// then every work on the wall behind a CSS-only sector filter styled as
// museum index tabs. Root carries `sbody` (studio engine: .sd-rev reveals)
// and `spf` (motion engine: tilt / glare / magnetic).
import { Icon } from 'astro-icon/components';
import { projects, featuredProjects, sectorLabels, sectorOrder, type ProjectSector } from '../../data/projects';

const sectors = sectorOrder;
const sectorShown: Record<ProjectSector, string> = {
	agri: '12+', health: '6+', property: '14+', media: '9+', commerce: '8+', product: '18+',
};

const stats = [
	{ n: '65+', label: 'works in the collection' },
	{ n: '15+', label: 'sectors curated' },
	{ n: '7+', label: 'years exhibiting' },
	{ n: '10+', label: 'countries on loan to' },
];

// Where a tile goes: the full case study when there is one, the live site
// when there is one, and otherwise the work's own short entry — before
// this, a project with neither simply linked nowhere.
const dest = (p: (typeof projects)[number]) =>
	p.caseStudy ? `/work/${p.slug}` : (p.url ?? `/work/${p.slug}`);
/** true only when the tile really does leave swizel.co */
const leaves = (p: (typeof projects)[number]) => !p.caseStudy && !!p.url;
const roman = ['01', '02', '03', '04', '05', '06'];

// the spotlight cycles these real works (featured first, then more with shots)
const spotWorks = [
	...featuredProjects,
	...projects.filter((p) => p.img && !p.caseStudy),
].filter((p) => p.img).slice(0, 8);
---

<div class="spf sbody view-body view-body-studio">
	<!-- ── A · the wing entrance ───────────────────────────── -->
	<section class="sp-sec sp-entry">
		<div class="sp-wrap">
			<div class="sp-folio sd-rev">
				<span>The Swizel Gallery — Collection Wing</span>
				<span>Every work, on the wall</span>
				<span>Permanent exhibition · Free entry</span>
			</div>
			<div class="sp-open">
				<div class="sp-open-copy">
					<span class="sp-ghost" aria-hidden="true">the collection</span>
					<h2 class="sp-display sd-rev">
						The complete<br />
						<em>collection.</em>
					</h2>
					<p class="sp-lead sd-rev">
						Not a mood board. Receipts: brands you can buy from, apps
						you can download, platforms real businesses run on. The
						spotlight is walking the wall; follow it, or go straight in.
					</p>
					<div class="sp-open-cues sd-rev">
						<a href="#sp-wall" class="sp-link">
							Straight to the wall
							<Icon width={15} name="mdi:arrow-down" />
						</a>
					</div>
				</div>

				<!-- ── the Spotlight Room ───────────────────────────────
				     The lamp, the beam and the dust stay; the stage under
				     them is a carousel now. Works ride a ring: the piece
				     at the front stands square and full size under the
				     light, its neighbours fall back and turn away. -->
				<div class="sp-spot sd-rev" id="sp-spot" data-cursor="play">
					<span class="sp-lamp" aria-hidden="true"></span>
					<span class="sp-beam" aria-hidden="true"></span>
					{Array.from({ length: 7 }).map((_, i) => (
						<i class="sp-dust" style={`--d:${i}`} aria-hidden="true"></i>
					))}

					<div class="sp-ring" data-sp-ring>
						{
							spotWorks.map((p, i) => (
								<article
									class:list={['sp-card', { 'is-live': i === 0 }]}
									data-sp-card={i}
									data-color={p.color}
									data-name={p.name}
									data-meta={`${sectorLabels[p.sector]} · ${p.year}`}
									data-href={dest(p)}
									data-out={leaves(p) ? '1' : undefined}
									style={`--c:${p.color}`}
								>
									<span class="sp-card-mat">
										<img src={p.img} alt={p.name} loading={i < 3 ? 'eager' : 'lazy'} decoding="async" />
										<span class="sp-card-glass" aria-hidden="true"></span>
									</span>
								</article>
							))
						}
					</div>

					<div class="sp-turnrow">
						<button class="sp-turn" type="button" data-sp-prev aria-label="Previous work">
							<Icon width={18} name="mdi:chevron-left" />
						</button>
						<figcaption class="sp-plaque sp-spot-plaque" id="sp-spot-plaque">
							<strong id="sp-spot-name">{spotWorks[0].name}</strong>
							<span id="sp-spot-meta">{sectorLabels[spotWorks[0].sector]} · {spotWorks[0].year}</span>
							<a class="sp-visit" id="sp-spot-visit" href={dest(spotWorks[0])}>
								Visit the work
								<Icon width={13} name="mdi:arrow-top-right" />
							</a>
						</figcaption>
						<button class="sp-turn" type="button" data-sp-next aria-label="Next work">
							<Icon width={18} name="mdi:chevron-right" />
						</button>
					</div>

					<div class="sp-strip">
						{
							spotWorks.map((_, i) => (
								<button
									class:list={['sp-tick', { 'is-on': i === 0 }]}
									type="button"
									data-sp-go={i}
									aria-label={`Work ${i + 1}`}
								>
									<i></i>
								</button>
							))
						}
					</div>
				</div>
			</div>
			<ul class="sp-wings sd-rev">
				{stats.map((s) => (
					<li>
						<strong>{s.n}</strong>
						<span>{s.label}</span>
					</li>
				))}
			</ul>
		</div>
	</section>

	<!-- ── B · featured exhibitions (the big rooms) ────────── -->
	<section class="sp-sec" data-cursor="play">
		<div class="sp-wrap">
			<div class="sp-rule sd-rev">
				<span>Featured exhibitions</span>
				<span>The big rooms · full case studies</span>
			</div>
			{
				featuredProjects.map((p, i) => (
					<div class:list={['sp-ex', 'sd-rev', { 'sp-ex--rev': i % 2 === 1 }]} style={`--c:${p.color}`}>
						<a class="sp-exmedia" href={`/work/${p.slug}`} data-fa-tilt="4" aria-label={`${p.name} case study`}>
							<span class="sa-glare" aria-hidden="true" />
							<img src={p.img} alt={p.name} loading="lazy" />
							<span class="sp-exveil" aria-hidden="true" />
							<span class="sp-exroom">Room {roman[i] || p.year}</span>
						</a>
						<div class="sp-excopy">
							<span class="sp-exkick">Room {roman[i]} · {sectorLabels[p.sector]} · {p.year}</span>
							<h2 class="sp-exname">{p.name}</h2>
							<p class="sp-extag">{p.tagline}</p>
							<p class="sp-exblurb">{p.blurb}</p>
							<span class="sp-extags">
								{p.tags.map((t) => <i>{t}</i>)}
							</span>
							<a href={`/work/${p.slug}`} class="sp-link">
								Walk the exhibition
								<Icon width={15} name="mdi:arrow-right" />
							</a>
						</div>
					</div>
				))
			}
		</div>
	</section>

	<!-- ── C · the full wall (filterable catalogue) ────────── -->
	<section class="sp-sec" id="sp-wall" data-cursor="repo">
		<div class="sp-wrap">
			<div class="sp-rule sd-rev">
				<span>The full wall</span>
				<span>Choose an index tab · hanging now</span>
			</div>
			<form class="sp-filter" autocomplete="off">
				<input class="sp-radio" type="radio" name="spf" id="spf-all" checked />
				{sectors.map((s) => <input class="sp-radio" type="radio" name="spf" id={`spf-${s}`} />)}
				<div class="sp-tabs sd-rev">
					<label class="sp-tab" for="spf-all">All works <em>65+</em></label>
					{
						sectors.map((s) => (
							<label class="sp-tab" for={`spf-${s}`}>
								{sectorLabels[s]} <em>{sectorShown[s]}</em>
							</label>
						))
					}
				</div>
				<div class="sp-wall">
					{
						projects.map((p, i) => {
							const href = dest(p);
							const hasCase = !!p.caseStudy;
							const Tag = href ? 'a' : 'div';
							return (
								<figure class:list={['sp-art', 'sd-rev', `s-${p.sector}`]} style={`--c:${p.color}; --i:${i % 3}`}>
									<Tag
										class="sp-art-link"
										href={href ?? undefined}
										data-leaving={leaves(p) ? p.host : undefined}
										data-leaving-name={leaves(p) ? p.name : undefined}
										rel={leaves(p) ? 'noopener noreferrer' : undefined}
										aria-label={p.name}
									>
										<span class="sp-art-frame" data-fa-tilt="5">
											<span class="sa-glare" aria-hidden="true" />
											<img src={p.img} alt={p.name} loading="lazy" />
											{hasCase && (
												<span class="sp-art-ribbon">Featured exhibition</span>
											)}
											{href && !hasCase && (
												<span class="sp-art-view" aria-hidden="true">
													View live <Icon width={13} name="mdi:arrow-top-right" />
												</span>
											)}
										</span>
										<figcaption class="sp-plaque">
											<strong>{p.name}</strong>
											<span>{sectorLabels[p.sector]} · {p.year}</span>
										</figcaption>
									</Tag>
								</figure>
							);
						})
					}
					<!-- the reserved slot: visible under every tab -->
					<a
						class="sp-art sp-next s-agri s-health s-property s-media s-commerce s-product"
						href="/contact"
						data-cursor="phone"
					>
						<span class="sp-next-frame">
							<Icon width={26} name="mdi:plus" />
							<strong>This spot is reserved.</strong>
							<em>For your brand. Bring the brief and we will frame the result.</em>
						</span>
						<span class="sp-plaque">
							<strong>Untitled, {new Date().getFullYear()}</strong>
							<span>Your sector · Commission open</span>
						</span>
					</a>
				</div>
			</form>
		</div>
	</section>

	<!-- ── D · the commission desk ─────────────────────────── -->
	<section class="sp-sec sp-sec--cta" data-cursor="phone">
		<div class="sp-wrap sp-cta sd-rev">
			<h2 class="sp-display sp-display--cta">
				The wall has<br />
				<em>one space left.</em>
			</h2>
			<p class="sp-lead sp-lead--center">
				Every piece up there started as somebody's rough idea. Bring
				yours. We design it, build it, hang it and keep it alive.
			</p>
			<div class="sp-cta-row">
				<a href="/contact" class="sp-btn fa-cta">
					Reserve the spot
					<Icon width={17} name="mdi:arrow-right" />
				</a>
				<a href="tel:+2348100204570" class="sp-call">
					or call <strong>+234 810 020 4570</strong>
				</a>
			</div>
		</div>
	</section>
</div>

<style>
	/* ── Studio Portfolio — the gallery dress. ── */
	.spf {
		--sa-ink: #f3edf0;
		--sa-muted: rgba(243, 237, 240, 0.64);
		--sa-faint: rgba(243, 237, 240, 0.42);
		--sa-acc: var(--view-accent, #ec4899);
		--sa-line: rgba(243, 237, 240, 0.14);
		--sa-card: rgba(255, 255, 255, 0.04);
		--sa-serif: 'Playfair Display', Georgia, 'Times New Roman', serif;
		font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
		position: relative;
		isolation: isolate;
		overflow: hidden;
		background:
			radial-gradient(1100px 560px at 84% -6%, rgba(236, 72, 153, 0.13), transparent 60%),
			radial-gradient(820px 480px at 8% 50%, rgba(168, 85, 247, 0.07), transparent 60%),
			linear-gradient(180deg, #0f0a0d 0%, #130c11 50%, #0b0709 100%);
		color: var(--sa-ink);
		padding: clamp(1.25rem, 2.5vw, 2rem) clamp(1rem, 3vw, 2rem) clamp(2.5rem, 5vw, 4rem);
		transition: background 0.4s ease, color 0.4s ease;
	}
	:global(html:not(.dark)) .spf {
		--sa-ink: #1c151a;
		--sa-muted: rgba(28, 21, 26, 0.7);
		--sa-faint: rgba(28, 21, 26, 0.48);
		--sa-acc: #cf2570;
		--sa-line: rgba(28, 21, 26, 0.14);
		--sa-card: rgba(28, 21, 26, 0.035);
		background:
			radial-gradient(1100px 560px at 84% -6%, rgba(236, 72, 153, 0.07), transparent 60%),
			linear-gradient(180deg, #f3ece6 0%, #ece2da 55%, #f3ece6 100%);
	}

	.sp-sec { padding-block: clamp(2.25rem, 5vw, 3.75rem); }
	.sp-entry { padding-top: clamp(0.5rem, 1.5vw, 1rem); }
	.sp-wrap { max-width: 80rem; margin: 0 auto; }

	.sp-folio {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
		padding: 0.6rem 0;
		border-top: 2px solid var(--sa-ink);
		border-bottom: 1px solid var(--sa-line);
		font-size: 0.7rem;
		font-weight: 800;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--sa-faint);
		margin-bottom: clamp(1.75rem, 4vw, 3rem);
	}
	.sp-folio span:first-child { color: var(--sa-ink); }
	.sp-rule {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		padding-bottom: 0.5rem;
		border-bottom: 1px solid var(--sa-line);
		margin-bottom: clamp(1.5rem, 3.5vw, 2.5rem);
		font-size: 0.74rem;
		font-weight: 800;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}
	.sp-rule span:first-child { color: var(--sa-acc); }
	.sp-rule span:last-child {
		color: var(--sa-faint);
		font-style: italic;
		font-family: var(--sa-serif);
		letter-spacing: 0.02em;
		text-transform: none;
		font-size: 0.98rem;
		font-weight: 400;
	}

	.sp-display {
		font-size: clamp(2.8rem, 7vw, 5.6rem);
		font-weight: 850;
		letter-spacing: -0.03em;
		line-height: 0.98;
		margin: 0;
	}
	.sp-display em {
		font-family: var(--sa-serif);
		font-style: italic;
		font-weight: 500;
		letter-spacing: -0.01em;
		color: var(--sa-acc);
	}
	.sp-lead {
		font-size: clamp(1.05rem, 1.7vw, 1.25rem);
		line-height: 1.6;
		color: var(--sa-muted);
		margin: 0 0 1.4rem;
	}
	.sp-lead--center { text-align: center; margin-inline: auto; max-width: 38rem; margin-bottom: 1.6rem; }
	.sp-link {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font-weight: 800;
		font-size: 0.95rem;
		color: var(--sa-acc);
		border-bottom: 2px solid color-mix(in srgb, var(--sa-acc) 45%, transparent);
		padding-bottom: 0.15rem;
		transition: border-color 0.25s ease, gap 0.25s ease;
	}
	.sp-link:hover { gap: 0.7rem; border-color: var(--sa-acc); }

	.sa-glare {
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background: radial-gradient(340px 220px at var(--gx, 50%) var(--gy, 20%), color-mix(in srgb, var(--c, var(--sa-acc)) 12%, transparent), transparent 70%);
		opacity: 0;
		transition: opacity 0.3s ease;
		pointer-events: none;
		z-index: 2;
	}
	[data-fa-tilt]:hover .sa-glare { opacity: 1; }

	/* ── A · entrance — copy left, the Spotlight Room right ── */
	.sp-open {
		display: grid;
		/* 4rem between the columns squeezed the copy into a narrow
		   measure and still left the stage too small to carry the wing */
		gap: clamp(1.4rem, 2.8vw, 2.4rem);
		align-items: center;
		margin-bottom: clamp(2rem, 4vw, 3rem);
	}
	@media (min-width: 960px) {
		.sp-open { grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr); }
		/* the stage runs a little past its column on the open side, the
		   way the home wall does */
		.sp-spot { margin-right: -4%; }
	}
	.sp-open-copy { min-width: 0; }
	.sp-lead { max-width: 33rem; }
	.sp-open-copy { position: relative; }
	.sp-ghost {
		position: absolute;
		top: -1.2em;
		left: -0.06em;
		font-family: var(--sa-serif);
		font-style: italic;
		font-weight: 500;
		font-size: clamp(4rem, 9vw, 7.5rem);
		line-height: 1;
		white-space: nowrap;
		color: transparent;
		-webkit-text-stroke: 1px color-mix(in srgb, var(--sa-ink) 14%, transparent);
		pointer-events: none;
		user-select: none;
	}
	/* on phones the ghost collides with the folio — desktop-only drama */
	@media (max-width: 959px) {
		.sp-ghost { display: none; }
	}
	.sp-open-cues { display: flex; align-items: center; gap: 1.2rem; flex-wrap: wrap; }

	/* the room: lamp, beam, dust, the lit frame, plaque, queue */
	.sp-spot {
		position: relative;
		padding-top: 3.2rem;
	}
	.sp-lamp {
		position: absolute;
		top: 0;
		left: 50%;
		transform: translateX(-50%);
		width: 46px;
		height: 12px;
		border-radius: 0 0 10px 10px;
		background: linear-gradient(180deg, color-mix(in srgb, var(--sa-ink) 40%, transparent), color-mix(in srgb, var(--sa-ink) 18%, transparent));
		z-index: 3;
	}
	.sp-lamp::after {
		content: '';
		position: absolute;
		left: 50%;
		bottom: -4px;
		transform: translateX(-50%);
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: #fff7e8;
		box-shadow:
			0 0 10px 3px rgba(255, 247, 232, 0.8),
			0 0 26px 10px color-mix(in srgb, var(--c, var(--sa-acc)) 40%, transparent);
	}
	.sp-beam {
		position: absolute;
		top: 0.4rem;
		left: 50%;
		transform: translateX(-50%);
		width: min(120%, 40rem);
		aspect-ratio: 1 / 0.8;
		background: conic-gradient(
			from 180deg at 50% 0%,
			transparent 41%,
			color-mix(in srgb, var(--c, var(--sa-acc)) 16%, rgba(255, 246, 226, 0.12)) 50%,
			transparent 59%
		);
		filter: blur(2px);
		mix-blend-mode: screen;
		pointer-events: none;
		z-index: 2;
		transform-origin: top center;
		animation: sp-beam-sway 7s ease-in-out infinite alternate;
		transition: opacity 0.4s ease;
	}
	:global(html:not(.dark)) .sp-beam { mix-blend-mode: multiply; opacity: 0.35; }
	@keyframes sp-beam-sway {
		from { transform: translateX(-50%) rotate(-2.2deg); }
		to { transform: translateX(-50%) rotate(2.2deg); }
	}
	.sp-spot.sp-dim .sp-beam { opacity: 0.25; }
	.sp-dust {
		position: absolute;
		top: 20%;
		left: calc(32% + var(--d) * 6%);
		width: 3px;
		height: 3px;
		border-radius: 50%;
		background: rgba(255, 246, 226, 0.65);
		opacity: 0;
		pointer-events: none;
		z-index: 2;
		animation: sp-dust-drift 7s linear infinite;
		animation-delay: calc(var(--d) * -1.1s);
	}
	@keyframes sp-dust-drift {
		0% { transform: translateY(28px) translateX(0); opacity: 0; }
		18% { opacity: 0.8; }
		82% { opacity: 0.5; }
		100% { transform: translateY(-110px) translateX(14px); opacity: 0; }
	}
	.sp-spot-stage {
		position: relative;
		margin: 0;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		border-radius: 0.4rem;
		border: 1px solid color-mix(in srgb, var(--c, var(--sa-acc)) 38%, var(--sa-line));
		box-shadow:
			inset 0 0 0 10px color-mix(in srgb, var(--sa-ink) 5%, transparent),
			0 0 60px -12px color-mix(in srgb, var(--c, var(--sa-acc)) 45%, transparent),
			0 40px 90px -36px rgba(0, 0, 0, 0.8);
		background: var(--sa-card);
		z-index: 1;
		transition: border-color 0.5s ease, box-shadow 0.5s ease;
	}
	.sp-spot-img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
		opacity: 0;
		transform: scale(1.03);
		transition: opacity 0.7s ease, transform 1.2s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.sp-spot-img.is-on { opacity: 1; transform: scale(1); }
	.sp-spot-room {
		position: absolute;
		left: 0.9rem;
		bottom: 0.8rem;
		font-size: 0.7rem;
		font-weight: 800;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: #fff;
		padding: 0.3rem 0.75rem;
		border-radius: 9999px;
		background: color-mix(in srgb, var(--c, var(--sa-acc)) 78%, #000);
		transition: background 0.5s ease;
	}
	.sp-spot-plaque { position: relative; z-index: 1; }
	.sp-spot-plaque strong { transition: color 0.3s ease; }
	.sp-spot-plaque.sp-pop { animation: sp-plaque-pop 0.45s cubic-bezier(0.22, 1, 0.36, 1); }
	@keyframes sp-plaque-pop {
		0% { transform: translateY(7px); opacity: 0.4; }
		100% { transform: translateY(0); opacity: 1; }
	}
	.sp-spot-queue {
		display: flex;
		gap: 0.5rem;
		margin-top: 0.9rem;
		flex-wrap: wrap;
		position: relative;
		z-index: 1;
	}
	.sp-spot-thumb {
		position: relative;
		width: 52px;
		height: 36px;
		padding: 0;
		overflow: hidden;
		border-radius: 0.3rem;
		border: 1.5px solid var(--sa-line);
		background: var(--sa-card);
		cursor: pointer;
		opacity: 0.45;
		filter: saturate(0.4);
		transition: opacity 0.3s ease, filter 0.3s ease, border-color 0.3s ease, transform 0.2s ease;
	}
	.sp-spot-thumb img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }
	.sp-spot-thumb:hover { opacity: 0.85; transform: translateY(-2px); }
	.sp-spot-thumb.is-on {
		opacity: 1;
		filter: saturate(1);
		border-color: var(--c);
		box-shadow: 0 0 14px -3px color-mix(in srgb, var(--c) 65%, transparent);
	}
	.sp-wings {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1rem;
		list-style: none;
		margin: 0;
		padding: 1.4rem 0 0;
		border-top: 1px solid var(--sa-line);
	}
	.sp-wings li {
		display: grid;
		gap: 0.15rem;
		padding-left: 1rem;
		border-left: 1px solid var(--sa-line);
	}
	.sp-wings li strong {
		font-size: clamp(1.6rem, 3vw, 2.3rem);
		font-weight: 850;
		letter-spacing: -0.02em;
		color: var(--sa-acc);
	}
	.sp-wings li span {
		font-family: var(--sa-serif);
		font-style: italic;
		font-size: 0.86rem;
		color: var(--sa-faint);
	}
	@media (max-width: 620px) {
		.sp-wings { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 1.4rem; }
	}

	/* ── B · exhibitions ── */
	.sp-ex {
		display: grid;
		gap: clamp(1.5rem, 3.5vw, 3rem);
		align-items: center;
		padding-block: clamp(1.25rem, 3vw, 2.25rem);
	}
	@media (min-width: 920px) {
		.sp-ex { grid-template-columns: 1.05fr 0.95fr; }
		.sp-ex--rev .sp-exmedia { order: 2; }
		.sp-ex--rev .sp-excopy { order: 1; }
	}
	.sp-exmedia {
		position: relative;
		display: block;
		overflow: hidden;
		border-radius: 0.4rem;
		border: 1px solid var(--sa-line);
		box-shadow:
			inset 0 0 0 10px color-mix(in srgb, var(--sa-ink) 5%, transparent),
			0 36px 80px -34px rgba(0, 0, 0, 0.7);
		aspect-ratio: 16 / 10;
		background: var(--sa-card);
	}
	.sp-exmedia img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
		transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.sp-ex:hover .sp-exmedia img { transform: scale(1.04); }
	.sp-exveil {
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, transparent 55%, rgba(10, 6, 9, 0.55));
		pointer-events: none;
	}
	.sp-exroom {
		position: absolute;
		left: 1rem;
		bottom: 0.9rem;
		font-size: 0.7rem;
		font-weight: 800;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: #fff;
		padding: 0.3rem 0.75rem;
		border-radius: 9999px;
		background: color-mix(in srgb, var(--c, var(--sa-acc)) 78%, #000);
	}
	.sp-exkick {
		display: block;
		font-size: 0.7rem;
		font-weight: 800;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--c, var(--sa-acc));
		margin-bottom: 0.6rem;
	}
	.sp-exname {
		margin: 0 0 0.3rem;
		font-size: clamp(1.7rem, 3.5vw, 2.6rem);
		font-weight: 850;
		letter-spacing: -0.02em;
		line-height: 1;
	}
	.sp-extag {
		margin: 0 0 0.7rem;
		font-family: var(--sa-serif);
		font-style: italic;
		font-size: clamp(1.02rem, 1.8vw, 1.25rem);
		color: var(--c, var(--sa-acc));
	}
	.sp-exblurb {
		margin: 0 0 1rem;
		max-width: 34rem;
		font-size: 0.96rem;
		line-height: 1.65;
		color: var(--sa-muted);
	}
	.sp-extags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-bottom: 1.1rem;
	}
	.sp-extags i {
		font-style: normal;
		font-size: 0.72rem;
		font-weight: 700;
		padding: 0.25rem 0.6rem;
		border-radius: 9999px;
		border: 1px solid var(--sa-line);
		color: var(--sa-muted);
	}

	/* ── C · the wall ── */
	.sp-filter { display: block; }
	.sp-radio { position: absolute; opacity: 0; pointer-events: none; }
	/* Seven tabs wrapped onto a second row with one lonely tab on it.
	   They run on one line now and scroll if the wall is narrow, with a
	   fade at each end so it is clear there is more. */
	.sp-tabs {
		display: flex;
		flex-wrap: nowrap;
		gap: 0.5rem;
		margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
		padding-bottom: 0.3rem;
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scrollbar-width: none;
		scroll-snap-type: x proximity;
		mask-image: linear-gradient(90deg, transparent, #000 2.5%, #000 97.5%, transparent);
		-webkit-mask-image: linear-gradient(90deg, transparent, #000 2.5%, #000 97.5%, transparent);
	}
	.sp-tabs::-webkit-scrollbar { display: none; }
	.sp-tab { flex: none; scroll-snap-align: start; }
	.sp-tab {
		display: inline-flex;
		align-items: baseline;
		gap: 0.38rem;
		padding: 0.48rem 0.85rem;
		font-size: 0.78rem;
		letter-spacing: 0.06em;
		white-space: nowrap;
		border-radius: 9999px;
		border: 1px solid var(--sa-line);
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--sa-muted);
		cursor: pointer;
		transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
	}
	.sp-tab:hover { transform: translateY(-2px); color: var(--sa-ink); }
	.sp-tab em {
		font-family: var(--sa-serif);
		font-style: italic;
		font-size: 0.82rem;
		text-transform: none;
		letter-spacing: 0;
		color: var(--sa-acc);
	}
	#spf-all:checked ~ .sp-tabs [for='spf-all'],
	#spf-agri:checked ~ .sp-tabs [for='spf-agri'],
	#spf-health:checked ~ .sp-tabs [for='spf-health'],
	#spf-property:checked ~ .sp-tabs [for='spf-property'],
	#spf-media:checked ~ .sp-tabs [for='spf-media'],
	#spf-commerce:checked ~ .sp-tabs [for='spf-commerce'],
	#spf-product:checked ~ .sp-tabs [for='spf-product'] {
		color: #fff;
		background: linear-gradient(95deg, var(--sa-acc), #a855f7);
		border-color: transparent;
	}
	#spf-all:checked ~ .sp-tabs [for='spf-all'] em,
	#spf-agri:checked ~ .sp-tabs [for='spf-agri'] em,
	#spf-health:checked ~ .sp-tabs [for='spf-health'] em,
	#spf-property:checked ~ .sp-tabs [for='spf-property'] em,
	#spf-media:checked ~ .sp-tabs [for='spf-media'] em,
	#spf-commerce:checked ~ .sp-tabs [for='spf-commerce'] em,
	#spf-product:checked ~ .sp-tabs [for='spf-product'] em { color: #ffe1f0; }

	.sp-wall {
		display: grid;
		gap: 1.3rem;
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}
	@media (max-width: 980px) {
		.sp-wall { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}
	@media (max-width: 560px) {
		.sp-wall { grid-template-columns: 1fr; }
	}
	.sp-art { display: none; margin: 0; }
	#spf-all:checked ~ .sp-wall .sp-art { display: block; }
	#spf-agri:checked ~ .sp-wall .s-agri,
	#spf-health:checked ~ .sp-wall .s-health,
	#spf-property:checked ~ .sp-wall .s-property,
	#spf-media:checked ~ .sp-wall .s-media,
	#spf-commerce:checked ~ .sp-wall .s-commerce,
	#spf-product:checked ~ .sp-wall .s-product { display: block; }
	.sp-art-link { display: block; color: inherit; }
	.sp-art-frame {
		position: relative;
		display: block;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		border-radius: 0.4rem;
		border: 1px solid var(--sa-line);
		box-shadow: inset 0 0 0 8px color-mix(in srgb, var(--sa-ink) 5%, transparent), 0 26px 60px -30px rgba(0, 0, 0, 0.7);
		background: var(--sa-card);
		transition: border-color 0.3s ease, box-shadow 0.3s ease;
	}
	.sp-art:hover .sp-art-frame {
		border-color: color-mix(in srgb, var(--c, var(--sa-acc)) 55%, transparent);
		box-shadow:
			inset 0 0 0 8px color-mix(in srgb, var(--sa-ink) 5%, transparent),
			0 30px 70px -28px color-mix(in srgb, var(--c, var(--sa-acc)) 45%, transparent);
	}
	.sp-art-frame img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
		transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.sp-art:hover .sp-art-frame img { transform: scale(1.05); }
	.sp-art-ribbon {
		position: absolute;
		left: 0.7rem;
		bottom: 0.7rem;
		font-size: 0.7rem;
		font-weight: 800;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: #fff;
		padding: 0.26rem 0.65rem;
		border-radius: 9999px;
		background: color-mix(in srgb, var(--c, var(--sa-acc)) 80%, #000);
	}
	.sp-art-view {
		position: absolute;
		right: 0.7rem;
		bottom: 0.7rem;
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		font-size: 0.7rem;
		font-weight: 800;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: #fff;
		padding: 0.28rem 0.7rem;
		border-radius: 9999px;
		background: rgba(10, 6, 9, 0.72);
		border: 1px solid rgba(255, 255, 255, 0.25);
		opacity: 0;
		transform: translateY(6px);
		transition: opacity 0.3s ease, transform 0.3s ease;
	}
	.sp-art:hover .sp-art-view { opacity: 1; transform: translateY(0); }

	.sp-plaque {
		display: inline-flex;
		flex-direction: column;
		gap: 0.12rem;
		margin-top: 0.7rem;
		padding: 0.5rem 0.85rem;
		background: rgba(12, 8, 11, 0.66);
		-webkit-backdrop-filter: blur(12px) saturate(130%);
		backdrop-filter: blur(12px) saturate(130%);
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-left: 3px solid var(--c, var(--sa-acc));
		border-radius: 0 0.5rem 0.5rem 0;
		box-shadow: 0 14px 30px -14px rgba(0, 0, 0, 0.6);
		max-width: fit-content;
	}
	.sp-plaque strong {
		font-size: 0.8rem;
		font-weight: 850;
		color: #fff;
	}
	.sp-plaque span {
		font-family: var(--sa-serif);
		font-style: italic;
		font-size: 0.72rem;
		color: rgba(255, 255, 255, 0.62);
	}

	/* the reserved slot */
	.sp-next { display: none; }
	.sp-next-frame {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		aspect-ratio: 16 / 10;
		border-radius: 0.4rem;
		border: 1.5px dashed color-mix(in srgb, var(--sa-acc) 50%, transparent);
		background: color-mix(in srgb, var(--sa-acc) 5%, transparent);
		color: var(--sa-muted);
		text-align: center;
		padding: 1rem;
		transition: background 0.25s ease, border-color 0.25s ease;
	}
	.sp-next:hover .sp-next-frame {
		background: color-mix(in srgb, var(--sa-acc) 10%, transparent);
		border-color: var(--sa-acc);
	}
	.sp-next-frame :global(svg) { color: var(--sa-acc); }
	.sp-next-frame strong { font-size: 0.95rem; font-weight: 800; color: var(--sa-ink); }
	.sp-next-frame em {
		font-family: var(--sa-serif);
		font-style: italic;
		font-size: 0.84rem;
		color: var(--sa-faint);
	}

	/* ── D · commission desk ── */
	.sp-sec--cta { padding-bottom: clamp(1.5rem, 3vw, 2.5rem); }
	.sp-cta { text-align: center; }
	.sp-display--cta { font-size: clamp(2.4rem, 6vw, 4.6rem); margin-bottom: 1.25rem; }
	.sp-cta-row {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1.4rem;
		flex-wrap: wrap;
	}
	.sp-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		padding: 1rem 1.9rem;
		border-radius: 9999px;
		font-weight: 800;
		font-size: 0.95rem;
		color: #fff;
		background: linear-gradient(95deg, var(--sa-acc), #a855f7);
		box-shadow: 0 18px 44px -16px color-mix(in srgb, var(--sa-acc) 80%, transparent);
		transition: box-shadow 0.25s ease, filter 0.25s ease;
		will-change: transform;
	}
	.sp-btn:hover { filter: brightness(1.07); }
	.sp-call { font-size: 0.95rem; color: var(--sa-muted); }
	.sp-call strong {
		font-weight: 850;
		color: var(--sa-ink);
		transition: color 0.25s ease;
	}
	.sp-call:hover strong { color: var(--sa-acc); }

	/* ── reveals ── */
	.sd-rev {
		opacity: 0;
		transform: translateY(22px);
		transition: opacity 0.65s ease, transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
		transition-delay: calc(var(--i, 0) * 0.06s);
	}
	.sd-rev.is-on { opacity: 1; transform: translateY(0); }

	@media (prefers-reduced-motion: reduce) {
		.sd-rev { opacity: 1; transform: none; transition: none; }
		.sp-beam, .sp-dust { animation: none; }
	}
	/* ═══ the carousel under the lamp ════════════════════════════
	   Each card owns one number, --o, its offset from the front. The
	   stylesheet does the rest, so turning the wall is a single integer
	   written to eight elements. */
	.sp-ring {
		position: relative;
		--card: clamp(19rem, 34vw, 38rem);
		height: calc(var(--card) * 0.66 + 1.5rem);
		perspective: 1700px;
		perspective-origin: 50% 44%;
		touch-action: pan-y;
	}
	.sp-card {
		position: absolute;
		top: 0;
		left: 50%;
		width: var(--card);
		margin: 0 0 0 calc(var(--card) / -2);
		cursor: pointer;
		transform:
			translate3d(calc(var(--o, 0) * 46%), calc(abs(var(--o, 0)) * 2%), calc(abs(var(--o, 0)) * -230px))
			rotateY(calc(var(--o, 0) * -26deg))
			scale(calc(1 - abs(var(--o, 0)) * 0.14));
		z-index: calc(10 - abs(var(--o, 0)));
		filter: brightness(calc(1 - abs(var(--o, 0)) * 0.26)) saturate(calc(1 - abs(var(--o, 0)) * 0.3));
		transition:
			transform 0.95s cubic-bezier(0.22, 1, 0.36, 1),
			opacity 0.6s ease,
			filter 0.7s ease;
		will-change: transform;
	}
	.sp-card[data-far] { opacity: 0; pointer-events: none; }
	.sp-card.is-live { cursor: default; filter: brightness(1.04) saturate(1.08); }

	.sp-card-mat {
		position: relative;
		display: block;
		padding: 0.5rem;
		border-radius: 3px;
		background: linear-gradient(150deg, #2c1c26, #160d16 62%);
		border: 1px solid color-mix(in srgb, var(--c) 34%, transparent);
		box-shadow:
			0 50px 100px -44px rgba(0, 0, 0, 0.95),
			0 0 70px -30px color-mix(in srgb, var(--c) 60%, transparent);
		transition: box-shadow 0.6s ease;
	}
	:global(html:not(.dark)) .sp-card-mat {
		background: linear-gradient(150deg, #fffdfe, #f2e5ec 62%);
		box-shadow:
			0 40px 88px -46px rgba(36, 16, 28, 0.45),
			0 0 60px -30px color-mix(in srgb, var(--c) 45%, transparent);
	}
	.sp-card.is-live .sp-card-mat {
		box-shadow:
			0 60px 120px -44px rgba(0, 0, 0, 0.95),
			0 0 110px -26px color-mix(in srgb, var(--c) 85%, transparent);
	}
	.sp-card-mat img {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 10;
		object-fit: cover;
		border-radius: 1px;
	}
	.sp-card-glass {
		position: absolute;
		inset: 0.5rem;
		border-radius: 1px;
		background: linear-gradient(118deg, rgba(255, 255, 255, 0.22) 0%, transparent 32%, transparent 68%, rgba(255, 255, 255, 0.09) 100%);
		opacity: 0.8;
		transition: opacity 0.5s ease, transform 0.7s ease;
		pointer-events: none;
	}
	.sp-card.is-live .sp-card-glass { opacity: 0.22; transform: translateX(14%); }

	/* the label, with the arrows either side of it */
	.sp-turnrow {
		position: relative;
		z-index: 12;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: clamp(0.8rem, 2vw, 1.6rem);
		max-width: 40rem;
		margin: clamp(0.6rem, 1.4vw, 1.1rem) auto 0;
	}
	.sp-turn {
		flex: none;
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 9999px;
		border: 1px solid color-mix(in srgb, var(--sa-acc) 38%, transparent);
		background: color-mix(in srgb, var(--sa-acc) 10%, transparent);
		color: var(--sa-ink);
		cursor: pointer;
		transition: background 0.25s ease, transform 0.25s ease, border-color 0.25s ease;
	}
	.sp-turn:hover {
		background: color-mix(in srgb, var(--sa-acc) 26%, transparent);
		border-color: var(--sa-acc);
		transform: scale(1.08);
	}
	.sp-turn:active { transform: scale(0.96); }
	.sp-spot-plaque { flex: 1 1 auto; min-width: 0; text-align: center; }
	.sp-visit {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		margin-top: 0.4rem;
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		/* the plaque is dark in both themes, so this reads light on it
		   rather than taking the room's ink */
		color: color-mix(in srgb, var(--c) 40%, #ffffff);
		transition: gap 0.25s ease, color 0.25s ease;
	}
	.sp-visit:hover { gap: 0.55rem; color: #fff; }

	/* where you are along the wall */
	.sp-strip { display: flex; justify-content: center; gap: 0.4rem; margin-top: clamp(0.5rem, 1.2vw, 0.9rem); }
	.sp-tick { width: 1.8rem; height: 1.8rem; display: grid; place-items: center; border: 0; background: transparent; padding: 0; cursor: pointer; }
	.sp-tick i {
		display: block;
		width: 1.4rem;
		height: 3px;
		border-radius: 9999px;
		background: color-mix(in srgb, var(--sa-ink) 24%, transparent);
		transition: background 0.4s ease, width 0.4s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.4s ease;
	}
	.sp-tick:hover i { background: color-mix(in srgb, var(--sa-acc) 60%, transparent); }
	.sp-tick.is-on i {
		width: 2.4rem;
		background: var(--sa-acc);
		box-shadow: 0 0 14px 1px color-mix(in srgb, var(--sa-acc) 60%, transparent);
	}

	@media (max-width: 959px) {
		.sp-ring { --card: min(76vw, 32rem); }
	}
	@media (max-width: 620px) {
		.sp-ring { --card: 82vw; }
		.sp-card {
			transform:
				translate3d(calc(var(--o, 0) * 58%), 0, calc(abs(var(--o, 0)) * -260px))
				rotateY(calc(var(--o, 0) * -18deg))
				scale(calc(1 - abs(var(--o, 0)) * 0.18));
		}
		.sp-turn { width: 2.1rem; height: 2.1rem; }
	}
	@media (prefers-reduced-motion: reduce) {
		.sp-card { transition: none; }
	}

	/* ═══ the phone ══════════════════════════════════════════════
	   Three fixes the small screen needed: the folio strip stacked into
	   three shouted lines above the fold, the wing figures broke onto
	   two rows, and the index tabs gave no sign they could be scrolled. */
	@media (max-width: 720px) {
		/* the folio is a masthead for a wide page; on a phone it was three
		   lines of capitals before anything worth reading */
		.sp-folio { display: none; }

		/* the figures hold one row, with the labels cut to a single word */
		.sp-wings {
			display: flex;
			justify-content: space-between;
			gap: 0.5rem;
			padding-top: 1.1rem;
		}
		.sp-wings li { flex: 1 1 0; min-width: 0; text-align: center; }
		.sp-wings strong { font-size: clamp(1.15rem, 5.4vw, 1.6rem); }
		.sp-wings span {
			display: block;
			font-size: 0.58rem;
			letter-spacing: 0.04em;
			line-height: 1.25;
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
