---
// About — rendered in the Boardroom world: deep, glossy, cinematic. Reuses the
// boardroom engine (initBoardroomBody → reveals, counters, rotating quotes) and
// the themed custom cursor. Locked to the boardroom blue accent so the page
// always reads as "Swizel for business", whatever view the visitor last chose.
import { Icon } from 'astro-icon/components';
import { teamDetails, CORE_VALUES, MISSION, MISSION_SUPPORT, VISION } from '../../consts';
import FilmPlayer from '../FilmPlayer.astro';
import CardShuffle from '../CardShuffle.astro';
import DoWall from './DoWall.astro';

// Years in business, computed from the founding year so it self-increments
// every year (build-time value; a tiny runtime script below also corrects it).
const FOUNDED_YEAR = 2019;
const NUMBER_WORDS = [
	'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight',
	'nine', 'ten', 'eleven', 'twelve', 'thirteen', 'fourteen', 'fifteen',
	'sixteen', 'seventeen', 'eighteen', 'nineteen', 'twenty',
];
const yearsInBusiness = Math.max(1, new Date().getFullYear() - FOUNDED_YEAR);
const yearsWordRaw = NUMBER_WORDS[yearsInBusiness] || String(yearsInBusiness);
const yearsWord = yearsWordRaw.charAt(0).toUpperCase() + yearsWordRaw.slice(1);

const glance = [
	{ k: 'Since', s: 'Since', v: '2019' },
	{ k: 'Products shipped', s: 'Shipped', v: '65+' },
	{ k: 'Countries served', s: 'Countries', v: '10+' },
];

// The same band the home page carries, so the two pages count the same
// way: an icon, the figure, its label, and under it the shape that figure
// actually made, drawn stroke by stroke when the band arrives.
const numbers = [
	{ to: 65, suffix: '+', label: 'Products shipped', short: 'Shipped', icon: 'mdi:cube-outline',
	  spark: 'M0 6.4 L17 5.6 L33 4.9 L50 3.7 L67 2.7 L83 1.4 L100 0.6' },
	{ to: yearsInBusiness, suffix: '+', label: 'Years in business', short: 'Years', icon: 'mdi:calendar-blank-outline',
	  spark: 'M0 6.4 L17 5.6 L33 4.7 L50 3.9 L67 3.1 L83 2.3 L100 1.4' },
	{ to: 25, suffix: '+', label: 'Specialists on the team', short: 'Specialists', icon: 'mdi:account-group-outline',
	  spark: 'M0 6.4 L17 6.4 L17 4.9 L42 4.9 L42 3.3 L71 3.3 L71 1.6 L100 1.6' },
	{ to: 98, suffix: '%', label: 'On-time delivery', short: 'On time', icon: 'mdi:clock-check-outline',
	  spark: 'M0 5.8 L17 5.2 L33 5.4 L50 3.6 L67 3 L83 1.8 L100 1.2' },
	{ to: 5, decimals: 1, suffix: '', label: 'Average client rating', short: 'Rating', icon: 'mdi:star-outline',
	  spark: 'M0 1.4 L17 1.2 L33 1.4 L50 1 L67 1.4 L83 1.2 L100 1.2' },
];

// Each promise gets a photograph of it happening and a page to follow.
// On the reference a four-up is never four icons on an empty field; it is
// four cards, each with a picture, a name, a line and a link.
const promiseArt: Record<
	string,
	{ img: string; pos: string; href: string; go: string; line: string; lineSm: string }
> = {
	'We build for the user': {
		img: '/images/builder/over-the-shoulder.jpg', pos: '46% 38%',
		href: '/services/design', go: 'How we design',
		line: 'Zero to market, shaped around whoever actually uses it, not whoever signs for it.',
		lineSm: 'Shaped around whoever actually uses the thing.',
	},
	'We ship when we said': {
		img: '/images/builder/at-the-keys.jpg', pos: '58% 42%',
		href: '/services/development', go: 'How we build',
		line: 'A date is a date. Ninety-eight per cent on time, and we count every one.',
		lineSm: 'A date is a date. 98% on time, and we count.',
	},
	'We stay long after launch': {
		img: '/images/marketing/the-floor.jpg', pos: '50% 50%',
		href: '/services/maintenance', go: 'How we maintain',
		line: 'Launch day is the middle of the job. We market it, maintain it and keep it growing.',
		lineSm: 'Launch day is the middle of the job, not the end.',
	},
	'We give away the playbook': {
		img: '/images/campus/class-in-session.jpg', pos: '50% 42%',
		href: '/programs', go: 'See the programmes',
		line: 'Knowledge should not sit in a silo. Open books and open mentorship, always.',
		lineSm: 'Open books and open mentorship, for everyone.',
	},
};

const values = [
	{
		icon: 'mdi:account-heart-outline',
		title: 'Client-first, always',
		desc: 'Your goals set the brief. We build for the people who use the thing, not for our portfolio.',
	},
	{
		icon: 'mdi:rocket-launch-outline',
		title: 'Ship, then sharpen',
		desc: 'We get a real product into real hands fast, then improve it with what the market tells us.',
		loud: true,
	},
	{
		icon: 'mdi:clock-check-outline',
		title: 'On time, on budget',
		desc: 'No surprises on the invoice or the calendar. You always know what ships next, and when.',
	},
	{
		icon: 'mdi:shield-check-outline',
		title: 'Built to last',
		desc: 'Secure, monitored and maintained for years, long after launch day is forgotten.',
	},
];

const milestones = [
	{
		year: '2019',
		title: 'The first line of code.',
		desc: 'Swizel starts in Nigeria, a small, stubborn team taking on its first builds for local businesses.',
	},
	{
		year: '2020',
		title: 'Products, not projects.',
		desc: 'We stop thinking in deliverables and start thinking in products, software meant to live and grow.',
	},
	{
		year: '2021',
		title: 'The team doubles.',
		desc: 'Designers, engineers and marketers join the bench, and Swizel stops being a handful of people doing everything.',
	},
	{
		year: '2022',
		title: 'Mobile, everywhere.',
		desc: 'Native iOS and Android join the practice. The same team now ships across web and phone.',
	},
	{
		year: '2023',
		title: 'At home in every sector.',
		desc: 'Fintech, real estate, sports, education, logistics, the work spreads across the industries that move Africa.',
	},
	{
		year: '2024',
		title: 'Crossing borders.',
		desc: 'The work goes global. ConvertMyBetCode serves users in 10+ countries, and the first Brevarium is published.',
	},
	{
		year: '2025',
		title: 'Teaching the next ones.',
		desc: 'We open our free training programme, growing new engineers, designers and marketers on real products.',
	},
	{
		year: '2026',
		title: '65+ and counting.',
		desc: 'Seven years in, more than sixty-five products live in the market, and we are only warming up.',
	},
];

// Leads first, then the wider team. Photos live in /teammates/<Name>.jpg
// Bio + experience are pulled from consts (same data as swizel.co's team modal).
const teamOrder = [
	{ name: 'Azoro', role: 'Business Development Lead' },
	{ name: 'Ruke', role: 'Product Manager' },
	{ name: 'Dennis', role: 'UI/UX Designer' },
	{ name: 'Mary', role: 'Software Engineer' },
	{ name: 'Stephen', role: 'Fullstack Developer' },
	{ name: 'Nathaniel', role: 'Frontend Developer' },
	{ name: 'Precious', role: 'Mobile Developer' },
	{ name: 'Linda', role: 'Marketing Lead' },
];
const team = teamOrder.map((m) => {
	const d = (teamDetails as any[]).find((t) => t.name === m.name) || {};
	return {
		...m,
		bio: d.bio || '',
		experience: (d.experience || []) as { company: string; jobDesc: string }[],
		linkedin: d.linkedinURL && d.linkedinURL !== '#' ? d.linkedinURL : '',
	};
});

const quotes = [
	{
		text: '“Warm, responsive and a true extension of our team. They took the worry out of shipping software.”',
		name: 'Chidimma',
		role: 'Client, education sector',
		img: '/testimonial/chidima.jpeg',
	},
	{
		text: '“Geniuses, honestly. Working with them was effortless from the first call to launch day.”',
		name: 'Favour',
		role: 'Client, marketing',
		img: '/testimonial/favour.jpeg',
	},
	{
		text: '“Thorough, polite and always on time. They make hard things feel easy.”',
		name: 'Cheta',
		role: 'Client, e-commerce',
		img: '/testimonial/cheta.jpeg',
	},
	{
		text: '“Friendly and efficient. I have trusted them with my products for years.”',
		name: 'Russell',
		role: 'Client, real estate',
		img: '/testimonial/russell.jpeg',
	},
];

const sectors = [
	'Fintech', 'Real estate', 'Sports', 'E-commerce', 'Education',
	'Logistics', 'Healthcare', 'Beauty', 'Energy', 'Agritech',
	'Hospitality', 'Media', 'Retail', 'Travel', 'Gaming', 'Legal',
];

const logos = [
	'betslipswitch.svg',
	'trueverdict.png',
	'brix market logo.svg',
	'hemamsynergy.png',
	'purple-panda.svg',
	'saros-sgp.svg',
	'my eya homes.svg',
	'the-presidential-diary.png',
	'beauty-hive.png',
	'shuaproperties.svg',
	'ejike-fc.svg',
];

// What we do — the disciplines, American-Eagle-style "expertise" grid → /services
const services = [
	{
		icon: 'mdi:palette-outline',
		title: 'Design',
		short: 'What it looks like, and how it feels.',
		desc: 'Brand identity, graphics and product design, interfaces your customers find effortless.',
		tag: 'Brand · UI/UX · Motion',
	},
	{
		icon: 'mdi:code-tags',
		title: 'Development',
		short: 'Built to scale, shipped fast.',
		desc: 'Web and mobile engineering built to scale. We build, test and ship fast, without breaking things.',
		tag: 'Web · iOS · Android · APIs',
	},
	{
		icon: 'mdi:bullhorn-outline',
		title: 'Marketing',
		short: 'Where your audience already is.',
		desc: 'We grow your audience across every platform that matters, and co-market the products we ship.',
		tag: 'SEO · Ads · Social · Content',
	},
	{
		icon: 'mdi:compass-outline',
		title: 'Strategy',
		short: 'The plan before the first pixel.',
		desc: 'Research, define and lock the goal, a tailored product roadmap before a line of code is written.',
		tag: 'Research · Roadmaps · MVP',
	},
	{
		icon: 'mdi:wrench-outline',
		title: 'Maintenance',
		short: 'Healthy, secure and online, year after year.',
		desc: 'Improving existing products and keeping complex systems healthy, secure and online, year after year.',
		tag: 'Support · DevOps · Uptime',
	},
	{
		icon: 'mdi:school-outline',
		title: 'Education',
		short: 'Skills into the hands of the next builders.',
		desc: 'IT / SIWES internships and NYSC placements, plus The Brevarium, putting real, job-ready skills in the hands of the next builders.',
		tag: 'Training · Brevarium · Mentoring',
	},
];

// The Brevarium — latest plus past editions, all free to download. Swap the
// hrefs as new editions are released; older issues stay available here.
const brevariumEditions = [
	{ vol: 'Vol. 3', date: 'Latest · 2026', latest: true, href: '/brevarium/the-brevarium-latest.pdf' },
	{ vol: 'Vol. 2', date: '2025', latest: false, href: '/The Brevarium by Swizel.pdf' },
	{ vol: 'Vol. 1', date: '2024', latest: false, href: '/The Brevarium by Swizel.pdf' },
];

// Footer — four offices, uncompressed, with live local clocks
const offices = [
	{ flag: '🇳🇬', country: 'Nigeria', city: 'Abuja', lines: ['2155 Peculiar Estate', 'Lokogoma, Abuja'], tz: 'Africa/Lagos' },
	{ flag: '🇮🇪', country: 'Ireland', city: 'Cork', lines: ['Eden Hall, Modern Farm Road', 'Cork, Ireland'], tz: 'Europe/Dublin' },
	{ flag: '🇬🇧', country: 'United Kingdom', city: 'Sheffield', lines: ['1 Sheffield, South Yorkshire', 'S2 3DB, England'], tz: 'Europe/London' },
	{ flag: '🇺🇸', country: 'United States', city: 'New York', lines: ['Tiemann Ave', 'Bronx, New York'], tz: 'America/New_York' },
];

const footerSocials = [
	{ name: 'X', handle: '@swizelhq', icon: 'twitter', href: 'https://twitter.com/swizelhq' },
	{ name: 'Instagram', handle: '@swizelhq', icon: 'instagram', href: 'https://instagram.com/swizelhq' },
	{ name: 'LinkedIn', handle: 'Swizel Technologies Limited', icon: 'linkedin', href: 'https://www.linkedin.com/company/swizel-technologies-limited/' },
	{ name: 'Facebook', handle: 'Swizel Technologies Limited', icon: 'facebook', href: 'https://www.facebook.com/SWIZELTECHNOLOGIESLIMITED/' },
];

const footerPhones = [
	{ num: '+234 810 020 4570', flag: '🇳🇬' },
	{ num: '+1 701 498 1811', flag: '🇺🇸' },
];

const footerNav = ['Home', 'About', 'Services', 'Portfolio', 'Blog', 'Contact'];
const currentYear = new Date().getFullYear();
---

<div class="bdbody bd-about view-body view-body-boardroom">
	<!-- ═══ About, told the way Apple tells a product ══════════════════
	     Studied off apple.com/tv-home rather than guessed at. The rhythm
	     there is always the same four beats: a small label, a short
	     headline with a full stop, one line of support, then a solid pill
	     beside a plain text link — and the picture underneath, carrying
	     the panel. Panels alternate deep and pale. Nothing is decorated
	     that a photograph could say instead.
	     ══════════════════════════════════════════════════════════════ -->

	<!-- ── the opening: two panels, the way HomePod sits beside HomePod
	     mini. One carries the words, the other carries the film with its
	     own words on it. Same four beats in each: label, headline,
	     support, then the pill beside the plain link. ── -->
	<div class="ab-open">
		<article class="ab-open-panel is-pale bd-reveal">
			<div class="ab-open-copy">
				<span class="ab-kick">About Swizel</span>
				<h1 class="ab-h1">
					<span data-years-since={FOUNDED_YEAR}>{yearsWord}</span> years building
					<em>the software Africa runs on.</em>
				</h1>
				<p class="ab-lede">
					One product team. Designers, engineers, analysts and marketers,
					turning ambitious ideas into software that ships, scales and
					keeps earning long after launch.
				</p>
				<p class="ab-lede ab-lede--sm">
					One team. Designers, engineers and marketers, turning ideas into
					software that ships and keeps earning.
				</p>
				<div class="ab-acts">
					<a href="/contact" class="ab-pill">Start a project</a>
					<a href="#bd-team" class="ab-more">
						Meet the team
						<Icon width={14} name="mdi:chevron-right" />
					</a>
				</div>
			</div>
			<ul class="ab-glance" aria-label="Swizel at a glance">
				{
					glance.map((g) => (
						<li>
							<strong>{g.v}</strong>
							<span>{g.k}</span>
							<span class="ab-glance-s">{g.s}</span>
						</li>
					))
				}
			</ul>
		</article>

		<article class="ab-open-panel is-deep bd-reveal" data-cursor="video">
			<div class="ab-open-copy">
				<span class="ab-kick">The film</span>
				<h2 class="ab-h2 ab-h2--panel">
					You have an idea.
					<span>We have the technology.</span>
				</h2>
				<p class="ab-lede">
					Ninety seconds inside the studio that builds it with you.
				</p>
			</div>
			<figure class="ab-screen" data-film-expand>
				<FilmPlayer
					videoId="p563SFG9Nwg"
					label="You have an idea? We have the technology to help you build it"
					fallback="/images/builder/the-table.jpg"
					cover
					class="ab-screen-film"
				/>
				<button class="ab-screen-open" type="button" data-film-expand-btn>
					<span class="ab-screen-open-in">
						<Icon width={15} name="mdi:arrow-expand-all" />
						<span>Tap to expand</span>
					</span>
				</button>
				<figcaption class="ab-screen-badge">
					<Icon width={15} name="mdi:play-circle-outline" />
					<span>Swizel</span>
					<em>the film</em>
				</figcaption>
			</figure>
		</article>
	</div>

	<!-- ── Mantra — shock and awe, full-bleed electric band ──── -->
	<section class="bd-mantra bd-reveal" data-cursor="pulse">
		<span class="bd-mantra-glow" aria-hidden="true"></span>
		<span class="bd-mantra-kicker">The Swizel mantra</span>
		<h2 class="bd-mantra-words">
			<span>You imagine.</span>
			<span class="bd-mantra-build">We build.</span>
		</h2>
		<p class="bd-mantra-sub">
			Three words we have lived by since 2019. You bring the ambition,
			we turn it into something real, shipped and loved.
		</p>
	</section>

	<!-- ── our story: one wide panel, the picture doing the talking ── -->
	<section class="ab-wide is-deep bd-reveal" data-cursor="clock">
		<div class="ab-wide-copy">
			<span class="ab-kick">Our story</span>
			<h2 class="ab-h2">It started with a stubborn belief.</h2>
			<p class="ab-line">
				That businesses across Africa deserved software as good as anything
				built anywhere else. In 2019 a small team set out to prove it, one
				product at a time, and never wanted to be the vendor you hire and
				forget.
			</p>
			<div class="ab-acts">
				<a href="#bd-timeline" class="ab-pill">How we got here</a>
				<a href="/portfolio" class="ab-more">
					See the work
					<Icon width={14} name="mdi:chevron-right" />
				</a>
			</div>
		</div>
		<div class="ab-wide-shot">
			<img
				src="/images/hero-team.jpg"
				alt="The Swizel team"
				loading="lazy"
				decoding="async"
			/>
		</div>
	</section>

	<!-- ── mission and vision, the two-up ── -->
	<div class="ab-pair">
		<article class="ab-panel is-pale bd-reveal">
			<div class="ab-panel-copy">
				<span class="ab-kick">Mission</span>
				<h3 class="ab-h3">From launch to legacy.</h3>
				<p class="ab-line">{MISSION}</p>
				<p class="ab-line ab-line--sm">Bold ideas into products people love.</p>
				<div class="ab-acts">
					<a href="/services" class="ab-pill">What we do</a>
					<a href="/contact" class="ab-more">
						Talk to us
						<Icon width={14} name="mdi:chevron-right" />
					</a>
				</div>
			</div>
			<div class="ab-panel-shot">
				<img src="/images/builder/the-table.jpg" alt="" style="object-position:50% 40%" loading="lazy" decoding="async" />
			</div>
		</article>

		<article class="ab-panel is-deep bd-reveal">
			<div class="ab-panel-copy">
				<span class="ab-kick">Vision</span>
				<h3 class="ab-h3">Great products, from anywhere.</h3>
				<p class="ab-line">{VISION} Six bases, ten countries and counting.</p>
				<p class="ab-line ab-line--sm">Great products can come from anywhere.</p>
				<div class="ab-acts">
					<a href="#bd-numbers" class="ab-pill">The numbers</a>
					<a href="/portfolio" class="ab-more">
						Where we work
						<Icon width={14} name="mdi:chevron-right" />
					</a>
				</div>
			</div>
			<div class="ab-panel-shot">
				<img src="/images/campus/demo-day.jpg" alt="" style="object-position:50% 34%" loading="lazy" decoding="async" />
			</div>
		</article>
	</div>

	<!-- ── the promises, as a row ── -->
	<section class="ab-vals bd-reveal">
		<h2 class="ab-h2">Four promises, and we are held to every one.</h2>
		<p class="ab-vals-sub">{MISSION_SUPPORT}</p>
		<p class="ab-vals-sub ab-vals-sub--sm">
			One team, from the blank page to the product's tenth year.
		</p>
		<ul class="ab-vrow">
			{
				CORE_VALUES.map((v, i) => {
					const art = promiseArt[v.name];
					return (
						<li class="ab-val" style={`--i:${i}`}>
							<a class="ab-val-card" href={art?.href ?? '/services'}>
								<span class="ab-val-shot">
									<img
										src={art?.img ?? '/images/builder/studio-grid.jpg'}
										alt=""
										style={`object-position:${art?.pos ?? '50% 50%'}`}
										loading="lazy"
										decoding="async"
									/>
									<span class="ab-val-ic" aria-hidden="true">
										<Icon width={18} name={v.icon} />
									</span>
								</span>
								<h3 class="ab-val-t">{v.name}</h3>
								<p class="ab-val-d">{art?.line ?? v.desc}</p>
								<p class="ab-val-d ab-val-d--sm">{art?.lineSm ?? v.desc}</p>
								<span class="ab-val-go">
									{art?.go ?? 'Learn more'}
									<Icon width={13} name="mdi:chevron-right" />
								</span>
							</a>
						</li>
					);
				})
			}
		</ul>
	</section>

	<!-- ── What we do — services / expertise grid ──────────── -->
	<section class="bd-head bd-reveal" id="bd-services">
		<h2 class="bd-h bd-h--center">Everything under one roof.</h2>
		<p class="bd-p bd-p--center">
			One team across every discipline you need to launch and grow, no
			hiring, no hand-offs, no finger-pointing.
		</p>
	</section>
	{/* Six disciplines dealt as a hand rather than laid out as a grid of
	    six identical rectangles: one card square in the middle, the rest
	    tilting away either side, and the whole hand shuffles on a click,
	    a swipe, an arrow key or by itself. */}
	<div class="bd-deck bd-reveal" data-cursor="layers">
		<CardShuffle
			variant="deck"
			label="What we do"
			every={7}
			items={services.map((sv) => ({
				icon: sv.icon,
				title: sv.title,
				desc: sv.short ?? sv.desc,
				href: '/services',
				hrefLabel: 'Learn more',
			}))}
		/>
	</div>

	<!-- ── By the numbers ──────────────────────────────────── -->
	<section
		class="bd-tile bd-tile--full bd-tile--inverse bd-band bd-reveal"
		id="bd-numbers"
		data-cursor="chart"
	>
		<div class="bd-tile-copy">
			<h2 class="bd-h">
				The numbers behind the <em>calm.</em>
			</h2>
			<p class="bd-p">
				Seven years of shipping for ambitious businesses, measured the
				only way that matters.
			</p>
		</div>
		<ul class="bd-numbers">
			{
				numbers.map((n, i) => (
					<li class="bd-number" style={`--n:${i}`}>
						<span class="bd-number-ic" aria-hidden="true">
							<Icon width={20} name={n.icon} />
						</span>
						<strong
							data-count={n.to}
							data-suffix={n.suffix}
							data-decimals={n.decimals || 0}
						>
							0{n.suffix}
						</strong>
						<span class="bd-number-l">{n.label}</span>
						<span class="bd-number-s">{n.short}</span>
						<svg class="bd-trend" viewBox="0 0 100 7" preserveAspectRatio="none" aria-hidden="true">
							<path class="bd-trend-line" d={n.spark} />
						</svg>
					</li>
				))
			}
		</ul>
	</section>

	<!-- What we actually do — the same wall the home page carries -->
	<DoWall />

	<!-- ── What we believe ───────────────────────────────────
