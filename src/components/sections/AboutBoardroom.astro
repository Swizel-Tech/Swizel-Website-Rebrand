	/* animated aurora wash behind the hero */
	.bd-hero-aurora {
		position: absolute;
		inset: -12%;
		z-index: 0;
		pointer-events: none;
		background:
			radial-gradient(440px 360px at 72% 22%, rgba(34, 211, 238, 0.30), transparent 60%),
			radial-gradient(440px 400px at 30% 82%, rgba(99, 102, 241, 0.26), transparent 62%),
			radial-gradient(380px 320px at 88% 78%, color-mix(in srgb, var(--bd-accent) 32%, transparent), transparent 60%);
		filter: blur(42px);
		opacity: 0.62;
		animation: bd-aurora 16s ease-in-out infinite;
	}
	:global(html:not(.dark)) .bd-hero-aurora { opacity: 0.42; }
	.bd-hero-grid {
		position: relative;
		z-index: 1;
		display: grid;
		gap: clamp(2rem, 5vw, 3.5rem);
		align-items: center;
		max-width: 84rem;
		margin-inline: auto;
		padding-inline: clamp(0.5rem, 2vw, 1.25rem);
	}
	@media (min-width: 900px) {
		.bd-hero-grid { grid-template-columns: 1.02fr 0.98fr; }
	}
	.bd-hero-text { text-align: center; }
	@media (min-width: 900px) {
		.bd-hero-text { text-align: left; }
		.bd-hero-text .bd-about-h1,
		.bd-hero-text .bd-sub { margin-inline: 0; }
		.bd-hero-text .bd-links { justify-content: flex-start; }
	}
	.bd-hero-overline {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--bd-accent);
		margin-bottom: 1.1rem;
	}
	.bd-hero-overline i { width: 28px; height: 1px; background: linear-gradient(90deg, var(--bd-accent), transparent); }
	@media (max-width: 899px) { .bd-hero-overline i { display: none; } }

	/* the visual stage — floating team card + stat chips */
	.bd-hero-stage {
		position: relative;
		min-height: clamp(360px, 44vw, 480px);
		display: grid;
		place-items: center;
	}
	.bd-hero-team-card {
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.35rem;
		width: min(100%, 30rem);
		padding: clamp(2.2rem, 4vw, 3.2rem) clamp(2.25rem, 5vw, 3.5rem);
		border-radius: 1.8rem;
		background: var(--bd-glass);
		border: 1px solid var(--bd-glass-border);
		box-shadow: var(--bd-shadow);
		backdrop-filter: blur(22px) saturate(140%);
		-webkit-backdrop-filter: blur(22px) saturate(140%);
		animation: bd-float 7s ease-in-out infinite;
	}
	@keyframes bd-float {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(-10px); }
	}
	.bd-hero-faces { display: flex; margin-bottom: 0.8rem; }
	.bd-hero-face {
		width: clamp(54px, 11vw, 70px);
		height: clamp(54px, 11vw, 70px);
		border-radius: 9999px;
		overflow: hidden;
		margin-left: -16px;
		border: 2px solid color-mix(in srgb, var(--bd-ink) 16%, transparent);
		box-shadow: 0 6px 16px -6px rgba(0, 0, 0, 0.6);
		background: var(--bd-glass);
	}
	.bd-hero-face:first-child { margin-left: 0; }
	.bd-hero-face img { width: 100%; height: 100%; object-fit: cover; object-position: center top; }
	.bd-hero-face--more {
		display: grid;
		place-items: center;
		color: #fff;
		background: linear-gradient(135deg, color-mix(in srgb, var(--bd-accent) 92%, #fff), var(--bd-accent));
	}
	.bd-hero-team-n { font-size: clamp(1.25rem, 2.4vw, 1.55rem); font-weight: 700; letter-spacing: -0.015em; text-align: center; }
	.bd-hero-team-s { font-size: 0.9rem; color: var(--bd-muted); }
	.bd-hero-team-go { margin-top: 0.85rem; font-size: 0.9rem; }
	.bd-hero-chip {
		position: absolute;
		z-index: 3;
		display: flex;
		flex-direction: column;
		gap: 0.05rem;
		padding: 0.7rem 1rem;
		border-radius: 1rem;
		background: var(--bd-glass);
		border: 1px solid var(--bd-glass-border);
		box-shadow: var(--bd-shadow);
		backdrop-filter: blur(18px) saturate(130%);
		-webkit-backdrop-filter: blur(18px) saturate(130%);
	}
	.bd-hero-chip strong {
		font-size: 1.3rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		background: linear-gradient(135deg, #9bd8ff, var(--bd-accent));
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}
	.bd-hero-chip span { font-size: 0.7rem; font-weight: 600; color: var(--bd-muted); }
	.bd-hero-chip--tr { top: 4%; right: 0; animation: bd-float 6s ease-in-out infinite; }
	.bd-hero-chip--bl { bottom: 6%; left: 0; animation: bd-float 8.5s ease-in-out infinite 0.8s; }
	@media (max-width: 600px) {
		.bd-hero-stage { min-height: 0; margin-top: 2.25rem; }
		.bd-hero-chip { display: none; }
	}
	/* shimmer on the hero gradient word */
	.bd-hero-text .bd-grad {
		background: linear-gradient(110deg, #9bd8ff 0%, var(--bd-accent) 38%, #7ef0d2 64%, #9bd8ff 100%);
		background-size: 220% 100%;
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
		animation: bd-grad-shift 7s ease infinite;
	}
	@keyframes bd-grad-shift {
		0%, 100% { background-position: 0% 50%; }
		50% { background-position: 100% 50%; }
	}

	/* drifting hero particles */
	.bd-hero-orbs {
		position: absolute;
		inset: -10% 0 0;
		z-index: -1;
		pointer-events: none;
		overflow: hidden;
	}
	.bd-hero-orbs i {
		position: absolute;
		left: var(--x);
		bottom: 0;
		width: calc(7px * var(--s, 1));
		height: calc(7px * var(--s, 1));
		border-radius: 9999px;
		background: radial-gradient(circle, color-mix(in srgb, var(--bd-accent) 90%, #fff), transparent 70%);
		opacity: 0;
		animation: bd-orb-rise 9s linear infinite;
		animation-delay: var(--d, 0s);
	}
	@keyframes bd-orb-rise {
		0% { transform: translateY(40px) scale(0.6); opacity: 0; }
		20% { opacity: 0.8; }
		80% { opacity: 0.5; }
		100% { transform: translateY(-260px) scale(1.1); opacity: 0; }
	}
	.bd-about-h1 {
		max-width: 18ch;
		margin-inline: auto;
	}
	.bd-glance {
		display: flex;
		align-items: stretch;
		justify-content: center;
		gap: clamp(1.4rem, 5vw, 3.5rem);
		list-style: none;
		margin: clamp(2rem, 5vw, 3rem) 0 0;
		padding: 0;
		flex-wrap: wrap;
	}
	.bd-glance-item {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}
	.bd-glance-item strong {
		font-size: clamp(1.5rem, 3vw, 2.1rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		background: linear-gradient(135deg, #9bd8ff, var(--bd-accent));
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}
	.bd-glance-item span {
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		color: var(--bd-muted);
	}
	.bd-scroll-cue {
		display: grid;
		place-items: center;
		width: 38px;
		height: 38px;
		margin: clamp(1.6rem, 4vw, 2.4rem) auto 0;
		border-radius: 9999px;
		border: 1px solid var(--bd-glass-border);
		color: var(--bd-accent);
		animation: bd-bob 2.2s ease-in-out infinite;
	}
	@keyframes bd-bob {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(6px); }
	}

	/* ── Layout grids ── */
	.bd-grid,
	.bd-mosaic {
		display: grid;
		gap: clamp(0.9rem, 2vw, 1.4rem);
		max-width: 88rem;
		margin: 0 auto clamp(0.9rem, 2vw, 1.4rem);
	}
	.bd-mosaic {
		grid-template-columns: repeat(12, minmax(0, 1fr));
	}
	.bd-grid--narrow,
	.bd-mosaic--svc {
		max-width: 72rem;
	}
	.bd-mosaic--svc {
		gap: clamp(1.25rem, 2.5vw, 2rem);
	}
	.bd-w7 { grid-column: span 7; }
	.bd-w6 { grid-column: span 6; }
	.bd-w5 { grid-column: span 5; }
	@media (max-width: 940px) {
		.bd-w7, .bd-w6, .bd-w5 { grid-column: span 12; }
	}
	.bd-tile--full { grid-column: 1 / -1; }

	/* ── Glass tiles ── */
	.bd-tile {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 1.4rem;
		text-align: center;
		padding: clamp(2rem, 4vw, 3rem) clamp(1.25rem, 3vw, 2.25rem)
			clamp(1.4rem, 3vw, 2rem);
		border-radius: 1.75rem;
		background: var(--bd-glass);
		border: 1px solid var(--bd-glass-border);
		box-shadow: var(--bd-shadow);
		backdrop-filter: blur(22px) saturate(130%);
		-webkit-backdrop-filter: blur(22px) saturate(130%);
		overflow: hidden;
		transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
			box-shadow 0.4s ease, border-color 0.4s ease;
	}
	.bd-tile::before {
		content: '';
		position: absolute;
		inset: 0 0 auto 0;
		height: 1px;
		background: linear-gradient(
			90deg,
			transparent 5%,
			rgba(255, 255, 255, 0.5) 50%,
			transparent 95%
		);
		opacity: 0.55;
		pointer-events: none;
	}
	.bd-tile:hover {
		transform: translateY(-5px);
		border-color: color-mix(in srgb, var(--bd-accent) 38%, rgba(255, 255, 255, 0.12));
		box-shadow: 0 40px 90px -36px color-mix(in srgb, var(--bd-accent) 32%, rgba(0, 0, 0, 0.85));
	}
	.bd-tile-copy {
		max-width: 40rem;
		margin: 0 auto;
	}
	.bd-tile--row {
		flex-direction: row;
		align-items: center;
		text-align: left;
		gap: clamp(1.25rem, 3vw, 2.5rem);
	}
	.bd-tile--row .bd-tile-copy { flex: 1 1 46%; margin: 0; }
	.bd-tile--row .bd-p { margin-inline: 0; }
	.bd-tile--row .bd-media { flex: 1 1 54%; }
	.bd-tile--row-rev { flex-direction: row-reverse; }
	@media (max-width: 720px) {
		.bd-tile--row,
		.bd-tile--row-rev {
			flex-direction: column;
			text-align: center;
		}
		.bd-tile--row .bd-p { margin-inline: auto; }
		.bd-tile--row .bd-eyebrow { text-align: center; }
		.bd-tile--row .bd-media { width: 100%; }
	}

	/* ── Media placeholders ── */
	.bd-media {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		width: 100%;
		aspect-ratio: 4 / 3;
		max-height: 320px;
		border-radius: 1.25rem;
		border: 1.5px dashed color-mix(in srgb, var(--bd-ink) 18%, transparent);
		background:
			radial-gradient(420px 200px at 70% 10%, color-mix(in srgb, var(--bd-accent) 10%, transparent), transparent),
			color-mix(in srgb, var(--bd-ink) 3%, transparent);
		color: var(--bd-muted);
		overflow: hidden;
	}
	.bd-media--tall { aspect-ratio: 16 / 11; max-height: 360px; }
	.bd-media-label {
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}
	.bd-media-sub {
		font-size: 0.78rem;
		color: color-mix(in srgb, var(--bd-muted) 70%, transparent);
	}
	.bd-media-sheen {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			115deg,
			transparent 30%,
			color-mix(in srgb, var(--bd-ink) 5%, transparent) 48%,
			transparent 64%
		);
		transform: translateX(-100%);
		animation: bd-sheen 5.5s ease-in-out infinite;
		pointer-events: none;
	}
	@keyframes bd-sheen {
		0%, 55% { transform: translateX(-100%); }
		85%, 100% { transform: translateX(100%); }
	}

	/* ── Mission band ── */
	.bd-tile--mission {
		background:
			radial-gradient(720px 320px at 50% -20%, color-mix(in srgb, var(--bd-accent) 22%, transparent), transparent 70%),
			linear-gradient(160deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.015) 55%);
		padding-block: clamp(2.5rem, 5vw, 4rem);
	}
	.bd-about-mission {
		max-width: 30ch;
		margin: 0.4rem auto 0;
		font-size: clamp(1.5rem, 3.4vw, 2.5rem);
		font-weight: 600;
		line-height: 1.3;
		letter-spacing: -0.015em;
	}

	/* ── Inverse numbers tile ── */
	.bd-tile--inverse {
		background:
			radial-gradient(720px 320px at 50% -10%, color-mix(in srgb, var(--bd-accent) 34%, transparent), transparent 70%),
			linear-gradient(180deg, rgba(21, 26, 48, 0.9), rgba(5, 6, 13, 0.95));
		color: #f5f5f7;
		border-color: color-mix(in srgb, var(--bd-accent) 30%, rgba(255, 255, 255, 0.1));
	}
	.bd-tile--inverse .bd-p { color: rgba(245, 245, 247, 0.62); }
	/* The old two-column figures block is gone with the tile it dressed.
	   One of its rules, .bd-number:last-child { grid-column: 1 / -1 },
	   was what put the fifth figure on a row of its own — the new band
	   sets five columns, and a span of all five overrides that quietly. */

	/* ── Section heads ── */
	.bd-head {
		max-width: 56rem;
		margin: clamp(2.5rem, 6vw, 4rem) auto clamp(1.5rem, 3vw, 2rem);
		text-align: center;
	}

	/* ── Value tiles (svc) ── */
	.bd-tile--svc {
		text-align: left;
		align-items: flex-start;
		gap: 0;
		padding: clamp(2rem, 4vw, 3rem);
	}
	.bd-tile--svc .bd-h--sm { margin: 1.2rem 0 0.5rem; }
	.bd-svc-p { margin: 0; margin-inline: 0; max-width: 34rem; }

	/* ── Core values strip ── */
	.bd-corevals {
		max-width: 74rem;
		margin: 1.2rem auto 0;
		padding: 1.3rem clamp(1.2rem, 3vw, 2rem);
		border: 1px solid var(--bd-line, rgba(255, 255, 255, 0.09));
		border-radius: 1.2rem;
		background: var(--bd-card, rgba(255, 255, 255, 0.03));
		text-align: center;
	}
	.bd-corevals-row {
		/* four values, so a grid rather than a wrapping row: an even 4 across,
		   2x2 on tablets, stacked on phones. A flex row left the fourth value
		   stranded on its own line. */
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		justify-items: center;
		gap: 0.9rem 1.1rem;
		margin-top: 0.9rem;
	}
	@media (max-width: 1080px) {
		.bd-corevals-row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}
	.bd-coreval {
		display: inline-flex;
		align-items: baseline;
		gap: 0.6rem;
		/* sized so all four sit on one line each at desktop widths; if a value
		   does wrap, the second line stays left aligned under the first rather
		   than centring under the number */
		font-size: clamp(0.98rem, 1.35vw, 1.1rem);
		font-weight: 800;
		letter-spacing: -0.01em;
		text-align: left;
		text-wrap: balance;
	}
	.bd-coreval i {
		font-style: normal;
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.1em;
		color: var(--bd-accent, #28a6ec);
	}
	@media (max-width: 700px) {
		.bd-corevals-row { grid-template-columns: 1fr; gap: 0.7rem; }
	}

	.bd-svc-ic {
		display: grid;
		place-items: center;
		width: 58px;
		height: 58px;
		flex-shrink: 0;
		border-radius: 1.1rem;
		background: linear-gradient(
			135deg,
			color-mix(in srgb, var(--bd-accent) 26%, transparent),
			color-mix(in srgb, var(--bd-accent) 8%, transparent)
		);
		border: 1px solid color-mix(in srgb, var(--bd-accent) 35%, transparent);
		color: #9bd8ff;
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2);
	}
	.bd-tile--loud {
		background:
			radial-gradient(480px 260px at 85% -10%, rgba(255, 255, 255, 0.28), transparent 60%),
			linear-gradient(135deg, #0ea5e9 0%, #2563eb 60%, #22d3ee 130%);
		border-color: rgba(255, 255, 255, 0.45);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.45),
			0 40px 90px -30px rgba(14, 165, 233, 0.65);
	}
	.bd-tile--loud:hover {
		border-color: rgba(255, 255, 255, 0.7);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.5),
			0 48px 110px -30px rgba(14, 165, 233, 0.85);
	}
	.bd-tile--loud .bd-h--sm { color: #ffffff; }
	.bd-tile--loud .bd-svc-p { color: rgba(255, 255, 255, 0.88); }
	.bd-tile--loud .bd-svc-ic {
		background: rgba(255, 255, 255, 0.18);
		border-color: rgba(255, 255, 255, 0.5);
		color: #ffffff;
	}
	@media (max-width: 720px) {
		.bd-tile--svc { text-align: center; align-items: center; }
		.bd-svc-p { margin-inline: auto; }
	}

	/* ── Timeline ── */
	/* timeline section — animated aurora backdrop, full-bleed */
	.bd-timeline-wrap {
		position: relative;
		margin: clamp(2rem, 5vw, 3.5rem) calc(-1 * clamp(1rem, 3vw, 2rem)) 0;
		padding: clamp(2.5rem, 6vw, 4rem) clamp(1rem, 3vw, 2rem) clamp(3rem, 6vw, 4.5rem);
		overflow: hidden;
		isolation: isolate;
	}
	.bd-tl-aurora {
		position: absolute;
		inset: -20% -10%;
		z-index: -2;
		pointer-events: none;
		background:
			radial-gradient(540px 380px at 18% 22%, color-mix(in srgb, var(--bd-accent) 30%, transparent), transparent 60%),
			radial-gradient(520px 420px at 82% 38%, rgba(124, 58, 237, 0.26), transparent 62%),
			radial-gradient(460px 400px at 60% 88%, color-mix(in srgb, var(--bd-accent) 22%, transparent), transparent 60%);
		filter: blur(34px);
		opacity: 0.55;
		animation: bd-aurora 18s ease-in-out infinite;
	}
	:global(html:not(.dark)) .bd-tl-aurora { opacity: 0.4; }
	@keyframes bd-aurora {
		0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
		33% { transform: translate3d(3%, -2%, 0) scale(1.08); }
		66% { transform: translate3d(-3%, 2%, 0) scale(1.04); }
	}
	.bd-tl-grid-lines {
		position: absolute;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		background-image:
			linear-gradient(color-mix(in srgb, var(--bd-ink) 6%, transparent) 1px, transparent 1px),
			linear-gradient(90deg, color-mix(in srgb, var(--bd-ink) 6%, transparent) 1px, transparent 1px);
		background-size: 46px 46px;
		-webkit-mask-image: radial-gradient(70% 60% at 50% 40%, #000, transparent 78%);
		mask-image: radial-gradient(70% 60% at 50% 40%, #000, transparent 78%);
		animation: bd-grid-pan 24s linear infinite;
	}
	@keyframes bd-grid-pan {
		to { background-position: 46px 46px; }
	}

	.bd-timeline {
		position: relative;
		list-style: none;
		margin: 0;
		padding: 0;
		width: 100%;
	}
	.bd-timeline::before {
		content: '';
		position: absolute;
		top: 0.5rem;
		bottom: 0.5rem;
		left: 50%;
		width: 2px;
		transform: translateX(-50%);
		background: linear-gradient(
			180deg,
			transparent,
			color-mix(in srgb, var(--bd-accent) 60%, transparent) 12%,
			color-mix(in srgb, var(--bd-accent) 60%, transparent) 88%,
			transparent
		);
	}
	/* a glowing pulse that travels down the line */
	.bd-timeline::after {
		content: '';
		position: absolute;
		left: 50%;
		top: 0;
		width: 6px;
		height: 22%;
		transform: translateX(-50%);
		border-radius: 9999px;
		background: linear-gradient(180deg, transparent, color-mix(in srgb, var(--bd-accent) 95%, #fff), transparent);
		filter: blur(2px);
		opacity: 0.9;
		animation: bd-tl-travel 4.5s ease-in-out infinite;
	}
	@keyframes bd-tl-travel {
		0% { top: -22%; opacity: 0; }
		15% { opacity: 1; }
		85% { opacity: 1; }
		100% { top: 100%; opacity: 0; }
	}
	.bd-tl-item {
		position: relative;
		width: 50%;
		padding: 0 clamp(1.5rem, 3vw, 2.75rem);
		margin-bottom: clamp(1.4rem, 3vw, 2rem);
		box-sizing: border-box;
	}
	/* alternate sides: odd items on the left, even on the right */
	.bd-tl-item:nth-child(odd) { margin-left: 0; text-align: right; }
	.bd-tl-item:nth-child(even) { margin-left: 50%; text-align: left; }
	.bd-tl-node {
		position: absolute;
		top: 1.6rem;
		width: 15px;
		height: 15px;
		border-radius: 9999px;
		background: var(--c, var(--bd-accent));
		border: 3px solid #070910;
		box-shadow: 0 0 0 4px color-mix(in srgb, var(--c, var(--bd-accent)) 25%, transparent);
		z-index: 1;
		animation: bd-node-pulse 2.8s ease-out infinite;
	}
	@keyframes bd-node-pulse {
		0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--c, var(--bd-accent)) 45%, transparent); }
		70% { box-shadow: 0 0 0 11px color-mix(in srgb, var(--c, var(--bd-accent)) 0%, transparent); }
		100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--c, var(--bd-accent)) 0%, transparent); }
	}
	/* each milestone gets its own colour */
	.bd-tl-item:nth-child(1) { --c: #22d3ee; }
	.bd-tl-item:nth-child(2) { --c: #3b82f6; }
	.bd-tl-item:nth-child(3) { --c: #8b5cf6; }
	.bd-tl-item:nth-child(4) { --c: #f59e0b; }
	.bd-tl-item:nth-child(5) { --c: #ec4899; }
	.bd-tl-item:nth-child(6) { --c: #10b981; }
	:global(html:not(.dark)) .bd-tl-node { border-color: #eef2f7; }
	.bd-tl-item:nth-child(odd) .bd-tl-node { right: -7px; }
	.bd-tl-item:nth-child(even) .bd-tl-node { left: -7px; }
	.bd-tl-card {
		position: relative;
		display: inline-block;
		text-align: left;
		padding: clamp(1.25rem, 2.5vw, 1.75rem);
		border-radius: 1.25rem;
		background:
			radial-gradient(340px 180px at 0% 0%, color-mix(in srgb, var(--c, var(--bd-accent)) 16%, transparent), transparent 72%),
			var(--bd-glass);
		border: 1px solid color-mix(in srgb, var(--c, var(--bd-accent)) 30%, var(--bd-glass-border));
		box-shadow: var(--bd-shadow);
		backdrop-filter: blur(18px) saturate(130%);
		-webkit-backdrop-filter: blur(18px) saturate(130%);
		transition: transform 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease;
	}
	.bd-tl-card:hover {
		transform: translateY(-4px);
		border-color: color-mix(in srgb, var(--c, var(--bd-accent)) 60%, var(--bd-glass-border));
		box-shadow: 0 36px 80px -36px color-mix(in srgb, var(--c, var(--bd-accent)) 38%, rgba(0,0,0,0.85));
	}
	.bd-tl-year {
		display: inline-block;
		font-size: clamp(1.6rem, 3.4vw, 2.4rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1;
		background: linear-gradient(135deg, color-mix(in srgb, var(--c, var(--bd-accent)) 55%, #fff), var(--c, var(--bd-accent)));
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
		margin-bottom: 0.5rem;
	}
	.bd-tl-title {
		font-size: 1.1rem;
		font-weight: 700;
		margin: 0 0 0.35rem;
	}
	.bd-tl-desc {
		font-size: 0.92rem;
		line-height: 1.55;
		color: var(--bd-muted);
		margin: 0;
		max-width: 30rem;
	}
	@media (max-width: 720px) {
		.bd-timeline::before { left: 9px; }
		.bd-tl-item,
		.bd-tl-item:nth-child(even),
		.bd-tl-item:nth-child(odd) {
			width: 100%;
			margin-left: 0;
			text-align: left;
			padding-left: 2.4rem;
			padding-right: 0;
		}
		.bd-tl-item:nth-child(even) .bd-tl-node,
		.bd-tl-item:nth-child(odd) .bd-tl-node { left: 2px; right: auto; }
		.bd-tl-card { display: block; }
	}

	/* ── Team grid (Apple-clean) ── */
	.bd-team-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: clamp(0.9rem, 2vw, 1.4rem);
		max-width: 80rem;
		margin: 0 auto;
	}
	@media (max-width: 860px) {
		.bd-team-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
	}
	@media (max-width: 560px) {
		.bd-team-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.8rem; }
	}
	.bd-member {
		/* it's a <button> — reset and make it a card */
		font: inherit;
		color: inherit;
		text-align: left;
		padding: 0;
		cursor: pointer;
		width: 100%;
		/* equal frames: the photo stretches to absorb any height difference
		   (roles that wrap to two lines made neighbouring cards taller) */
		height: 100%;
		display: flex;
		flex-direction: column;
		margin: 0;
		border-radius: 1.4rem;
		overflow: hidden;
		background: var(--bd-glass);
		border: 1px solid var(--bd-glass-border);
		box-shadow: var(--bd-shadow);
		transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
			border-color 0.4s ease, box-shadow 0.4s ease;
	}
	.bd-member:hover {
		transform: translateY(-6px);
		border-color: color-mix(in srgb, var(--bd-accent) 45%, var(--bd-glass-border));
		box-shadow: 0 40px 90px -36px color-mix(in srgb, var(--bd-accent) 36%, rgba(0,0,0,0.85));
	}
	.bd-member-photo {
		position: relative;
		aspect-ratio: 3 / 3.4;
		overflow: hidden;
		flex: 1; /* fill the card so every photo frame matches */
		min-height: 0;
	}
	.bd-member-photo img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center top;
		filter: grayscale(0.25) contrast(1.02);
		transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1), filter 0.5s ease;
	}
	.bd-member:hover .bd-member-photo img {
		transform: scale(1.06);
		filter: grayscale(0) contrast(1.05);
	}
	.bd-member-veil {
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, transparent 45%, rgba(5, 6, 14, 0.55));
		opacity: 0.8;
		transition: opacity 0.4s ease;
	}
	.bd-member:hover .bd-member-veil { opacity: 1; }
	.bd-member-meta {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		padding: 0.85rem 1rem 1rem;
	}
	.bd-member-meta strong {
		font-size: 1.02rem;
		font-weight: 700;
		letter-spacing: -0.01em;
	}
	.bd-member-meta em {
		font-style: normal;
		font-size: 0.8rem;
		color: var(--bd-muted);
	}
	/* "View profile" affordance, revealed on hover/focus */
	.bd-member-view {
		position: absolute;
		left: 0.85rem;
		bottom: 0.85rem;
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0.4rem 0.7rem;
		border-radius: 9999px;
		font-size: 0.74rem;
		font-weight: 700;
		letter-spacing: 0.02em;
		color: #fff;
		background: color-mix(in srgb, var(--bd-accent) 80%, transparent);
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
		opacity: 0;
		transform: translateY(8px);
		transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
		pointer-events: none;
	}
	.bd-member:hover .bd-member-view,
	.bd-member:focus-visible .bd-member-view { opacity: 1; transform: translateY(0); }

	/* ── Team profile modal ── */
	.bd-modal { position: fixed; inset: 0; z-index: 200; display: grid; place-items: center; padding: clamp(0.75rem, 3vw, 2rem); }
	.bd-modal[hidden] { display: none; }
	.bd-modal-overlay {
		position: absolute;
		inset: 0;
		background: rgba(3, 4, 10, 0.72);
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
		opacity: 0;
		transition: opacity 0.3s ease;
	}
	.bd-modal.is-open .bd-modal-overlay { opacity: 1; }
	.bd-modal-card {
		position: relative;
		width: min(720px, 100%);
		max-height: 90vh;
		overflow-y: auto;
		border-radius: 1.5rem;
		padding: clamp(1.5rem, 4vw, 2.5rem);
		background:
			radial-gradient(620px 320px at 90% -10%, color-mix(in srgb, var(--bd-accent) 22%, transparent), transparent 65%),
			linear-gradient(165deg, #12152a, #06070e);
		border: 1px solid color-mix(in srgb, var(--bd-accent) 24%, rgba(255, 255, 255, 0.12));
		box-shadow: 0 50px 120px -40px rgba(0, 0, 0, 0.85);
		color: #f4f6fb;
		transform: translateY(14px) scale(0.97);
		opacity: 0;
		transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.3s ease;
	}
	.bd-modal.is-open .bd-modal-card { transform: translateY(0) scale(1); opacity: 1; }
	.bd-modal-x {
		position: sticky;
		top: 0.4rem;
		margin: -0.4rem -0.4rem -2.6rem auto;
		width: 40px;
		height: 40px;
		display: grid;
		place-items: center;
		border-radius: 9999px;
		border: 1px solid rgba(255, 255, 255, 0.2);
		background: rgba(18, 21, 42, 0.82);
		-webkit-backdrop-filter: blur(8px);
		backdrop-filter: blur(8px);
		color: #f4f6fb;
		cursor: pointer;
		z-index: 5;
		transition: background 0.25s ease, transform 0.25s ease;
	}
	.bd-modal-x:hover { background: rgba(255, 255, 255, 0.14); transform: rotate(90deg); }
	.bd-modal-body { display: grid; gap: clamp(1.25rem, 3vw, 2rem); }
	@media (min-width: 620px) { .bd-modal-body { grid-template-columns: 200px 1fr; align-items: start; } }
	.bd-modal-photo { border-radius: 1.1rem; overflow: hidden; aspect-ratio: 3 / 3.4; box-shadow: 0 20px 44px -18px rgba(0, 0, 0, 0.7); }
	.bd-modal-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center top; }
	.bd-modal-name { font-size: clamp(1.4rem, 3vw, 1.8rem); font-weight: 700; letter-spacing: -0.02em; margin: 0.9rem 0 0.2rem; }
	.bd-modal-role { font-size: 0.9rem; color: var(--bd-accent); font-weight: 600; margin: 0; }
	.bd-modal-linkedin {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin-top: 1rem;
		padding: 0.5rem 0.9rem;
		border-radius: 9999px;
		font-size: 0.82rem;
		font-weight: 600;
		color: #fff;
		background: rgba(255, 255, 255, 0.07);
		border: 1px solid rgba(255, 255, 255, 0.14);
		transition: background 0.25s ease, border-color 0.25s ease;
	}
	.bd-modal-linkedin:hover { background: color-mix(in srgb, var(--bd-accent) 24%, transparent); border-color: var(--bd-accent); }
	.bd-modal-linkedin[hidden] { display: none; }
	.bd-modal-main .bd-eyebrow { margin-bottom: 0.5rem; }
	.bd-modal-bio { font-size: 0.96rem; line-height: 1.65; color: rgba(244, 246, 251, 0.78); margin: 0 0 1.4rem; }
	.bd-modal-exp-h { display: block; margin-bottom: 0.6rem; }
	.bd-modal-exp { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.7rem; }
	/* these <li>/<strong>/<span> are created in JS, so they need :global to be styled */
	.bd-modal-exp :global(li) { padding-left: 0.9rem; border-left: 2px solid color-mix(in srgb, var(--bd-accent) 45%, transparent); }
	.bd-modal-exp :global(strong) { display: block; font-size: 0.92rem; font-weight: 700; margin-bottom: 0.1rem; }
	.bd-modal-exp :global(span) { display: block; font-size: 0.82rem; color: rgba(244, 246, 251, 0.6); }
	#bd-modal-exp-wrap[hidden] { display: none; }

	/* ── Rotating quotes ── */
	.bd-tile--quote {
		height: clamp(15rem, 26vw, 17rem);
		padding: 0;
		justify-content: center;
		width: min(100%, 72rem);
		margin: 0 auto;
		z-index: 2;
	}
	.bd-quote {
		max-width: 44rem;
		margin: 0 auto;
		opacity: 0;
		transform: translateY(14px);
		transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: clamp(1.5rem, 3vw, 2.25rem) clamp(1.25rem, 4vw, 4rem) 2.8rem;
		pointer-events: none;
	}
	.bd-quote.is-live { opacity: 1; transform: translateY(0); pointer-events: auto; }
	.bd-quote.is-leaving { opacity: 0; transform: translateY(-14px); }
	.bd-quote p {
		font-size: clamp(1.3rem, 2.6vw, 1.9rem);
		font-weight: 600;
		letter-spacing: -0.015em;
		line-height: 1.35;
		margin: 0 0 1.4rem;
	}
	.bd-quote footer {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
	}
	.bd-quote img {
		width: 44px;
		height: 44px;
		border-radius: 9999px;
		object-fit: cover;
		border: 2px solid color-mix(in srgb, var(--bd-accent) 50%, transparent);
	}
	.bd-quote footer span {
		display: flex;
		flex-direction: column;
		text-align: left;
		line-height: 1.25;
	}
	.bd-quote footer strong { font-size: 0.92rem; }
	.bd-quote footer em {
		font-style: normal;
		font-size: 0.78rem;
		color: var(--bd-muted);
	}
	.bd-quote-dots {
		position: absolute;
		bottom: 1.4rem;
		left: 50%;
		transform: translateX(-50%);
		display: flex;
		gap: 0.45rem;
	}
	.bd-qdot {
		width: 7px;
		height: 7px;
		border-radius: 9999px;
		background: color-mix(in srgb, var(--bd-ink) 20%, transparent);
		transition: background 0.3s ease, transform 0.3s ease;
	}
	.bd-qdot.is-on { background: var(--bd-accent); transform: scale(1.25); }
	@media (max-width: 640px) {
		.bd-tile--quote { height: 21rem; }
		.bd-quote p { font-size: 1.12rem; }
	}

	/* ── Marquees ── */
	.bd-marquee {
		overflow: hidden;
		-webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
		mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
	}
	.bd-marquee-track {
		display: flex;
		align-items: center;
		width: max-content;
	}
	.bd-marquee-track--sectors { animation: bd-drift 38s linear infinite; }
	.bd-marquee-track--logos { animation: bd-drift 30s linear infinite; }
	.bd-marquee:hover .bd-marquee-track { animation-play-state: paused; }
	@keyframes bd-drift { to { transform: translateX(-50%); } }
	.bd-sectors {
		max-width: 88rem;
		margin: clamp(2.5rem, 6vw, 4rem) auto clamp(2rem, 5vw, 3.5rem);
		text-align: center;
	}
	.bd-sectors .bd-h { margin-bottom: 1.4rem; }
	.bd-sector {
		flex-shrink: 0;
		margin-right: clamp(1.6rem, 3vw, 2.8rem);
		font-size: clamp(1.2rem, 2.4vw, 1.7rem);
		font-weight: 700;
		letter-spacing: -0.01em;
		color: color-mix(in srgb, var(--bd-ink) 34%, transparent);
		transition: color 0.3s ease;
		cursor: default;
	}
	.bd-sector:hover { color: var(--bd-accent); }
	.bd-logos {
		max-width: 88rem;
		margin: clamp(2.5rem, 5vw, 3.5rem) auto 0;
		text-align: center;
	}
	.bd-logos-line {
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--bd-ink) 38%, transparent);
		margin: 0 0 1.3rem;
	}
	.bd-logo {
		flex-shrink: 0;
		display: grid;
		place-items: center;
		margin-right: clamp(2rem, 4vw, 3.5rem);
	}
	.bd-logo img {
		height: 32px;
		width: auto;
		max-width: 132px;
		object-fit: contain;
		opacity: 0.88;
		transition: opacity 0.3s ease, transform 0.3s ease;
	}
	.bd-logo:hover img { filter: none; opacity: 1; transform: scale(1.06); }

	.bd-work-all { text-align: center; margin: 1.6rem 0 0; }

	/* ── CTA ── */
	.bd-tile--cta {
		background:
			radial-gradient(820px 380px at 50% 130%, color-mix(in srgb, var(--bd-accent) 38%, transparent), transparent 72%),
			linear-gradient(180deg, rgba(18, 22, 42, 0.92), rgba(5, 6, 13, 0.96));
		color: #f5f5f7;
		border-color: color-mix(in srgb, var(--bd-accent) 26%, rgba(255, 255, 255, 0.1));
		padding-block: clamp(3rem, 6vw, 5rem);
	}
	.bd-display--cta { font-size: clamp(2.2rem, 5vw, 3.8rem); }
	.bd-tile--cta .bd-sub { color: rgba(245, 245, 247, 0.62); }
	.bd-call {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.2rem;
		margin-top: 1.6rem;
	}
	.bd-call-hint {
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: rgba(245, 245, 247, 0.5);
	}
	.bd-call-num {
		display: inline-flex;
		align-items: center;
		gap: 0.7rem;
		font-size: clamp(1.8rem, 4.5vw, 3.2rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		background: linear-gradient(135deg, #ffffff, #9bd8ff 60%, var(--bd-accent));
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
		transition: transform 0.3s ease, filter 0.3s ease;
	}
	.bd-call-num :global(svg) {
		color: var(--bd-accent);
		-webkit-text-fill-color: initial;
	}
	.bd-call:hover .bd-call-num {
		transform: scale(1.03);
		filter: drop-shadow(0 10px 30px color-mix(in srgb, var(--bd-accent) 55%, transparent));
	}

	/* ── Mission + Vision — deepest black for contrast ── */
	.bd-tile--void {
		background:
			radial-gradient(720px 360px at 50% -12%, color-mix(in srgb, var(--bd-accent) 18%, transparent), transparent 70%),
			linear-gradient(180deg, #000000 0%, #05060c 100%);
		color: #f4f6fb;
		border-color: rgba(255, 255, 255, 0.1);
		padding-block: clamp(2.6rem, 5vw, 4rem);
	}
	:global(html:not(.dark)) .bd-tile--void {
		color: #f4f6fb;
		border-color: rgba(255, 255, 255, 0.12);
	}
	.bd-mv {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		gap: clamp(1.5rem, 4vw, 3.5rem);
		align-items: stretch;
		margin-top: 1.2rem;
		text-align: left;
	}
	.bd-mv-item { display: flex; flex-direction: column; gap: 0.7rem; }
	.bd-mv-tag {
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--bd-accent);
	}
	.bd-mv-text {
		font-size: clamp(1.15rem, 2.2vw, 1.6rem);
		font-weight: 600;
		line-height: 1.4;
		color: #eef1f8;
		margin: 0;
	}
	.bd-mv-divide { width: 1px; background: linear-gradient(180deg, transparent, rgba(255, 255, 255, 0.18), transparent); }
	@media (max-width: 720px) {
		.bd-mv { grid-template-columns: 1fr; text-align: center; }
		.bd-mv-item { align-items: center; }
		.bd-mv-divide { width: auto; height: 1px; background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.18), transparent); }
	}

	/* ── Mantra — shock & awe, full-bleed electric band ── */
	.bd-mantra {
		position: relative;
		margin: clamp(3rem, 7vw, 5rem) calc(-1 * clamp(1rem, 3vw, 2rem));
		padding: clamp(3.5rem, 9vw, 7rem) clamp(1.5rem, 5vw, 3rem);
		text-align: center;
		overflow: hidden;
		color: #fff;
		background:
			radial-gradient(900px 480px at 12% 8%, rgba(255, 255, 255, 0.22), transparent 58%),
			radial-gradient(700px 420px at 92% 100%, rgba(125, 240, 255, 0.18), transparent 60%),
			linear-gradient(118deg, #06e6ff 0%, #1f6bff 48%, #3a25ff 100%);
	}
	.bd-mantra-glow {
		position: absolute;
		top: -30%;
		left: 50%;
		width: 70%;
		height: 90%;
		transform: translateX(-50%);
		background: radial-gradient(closest-side, rgba(255, 255, 255, 0.28), transparent);
		filter: blur(24px);
		pointer-events: none;
		animation: bd-mantra-drift 9s ease-in-out infinite;
	}
	@keyframes bd-mantra-drift {
		0%, 100% { transform: translateX(-50%) translateY(0) scale(1); opacity: 0.9; }
		50% { transform: translateX(-42%) translateY(4%) scale(1.12); opacity: 1; }
	}
	.bd-mantra-kicker {
		position: relative;
		display: inline-block;
		font-size: 0.8rem;
		font-weight: 800;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.88);
		margin-bottom: 1.1rem;
	}
	.bd-mantra-words {
		position: relative;
		margin: 0;
		font-size: clamp(2.8rem, 9vw, 6.5rem);
		font-weight: 800;
		line-height: 0.98;
		letter-spacing: -0.025em;
	}
	.bd-mantra-words span { display: block; }
	.bd-mantra-build { text-shadow: 0 0 48px rgba(255, 255, 255, 0.45); }
	.bd-mantra-sub {
		position: relative;
		max-width: 34rem;
		margin: 1.5rem auto 0;
		font-size: clamp(1rem, 2vw, 1.2rem);
		line-height: 1.55;
		color: rgba(255, 255, 255, 0.92);
	}

	/* ── What we do — services grid ── */
	.bd-svc-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(0.9rem, 2vw, 1.4rem);
		max-width: 80rem;
		margin: 0 auto;
	}
	@media (max-width: 880px) { .bd-svc-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
	@media (max-width: 560px) { .bd-svc-grid { grid-template-columns: 1fr; } }
	.bd-svc-card {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		padding: clamp(1.6rem, 3vw, 2.2rem);
		border-radius: 1.4rem;
		background: var(--bd-glass);
		border: 1px solid var(--bd-glass-border);
		box-shadow: var(--bd-shadow);
		backdrop-filter: blur(18px) saturate(130%);
		-webkit-backdrop-filter: blur(18px) saturate(130%);
		transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.35s ease, box-shadow 0.35s ease;
	}
	.bd-svc-card:hover {
		transform: translateY(-5px);
		border-color: color-mix(in srgb, var(--bd-accent) 42%, var(--bd-glass-border));
		box-shadow: 0 40px 90px -36px color-mix(in srgb, var(--bd-accent) 30%, rgba(0, 0, 0, 0.85));
	}
	.bd-svc-card .bd-svc-ic { margin-bottom: 1.1rem; }
	.bd-svc-title { font-size: 1.3rem; font-weight: 700; letter-spacing: -0.01em; margin: 0 0 0.5rem; }
	.bd-svc-desc { font-size: 0.95rem; line-height: 1.55; color: var(--bd-muted); margin: 0 0 1rem; }
	.bd-svc-tag {
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--bd-ink) 50%, transparent);
		margin-bottom: 1rem;
	}
	.bd-svc-more {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		margin-top: auto;
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--bd-accent);
		transition: gap 0.25s ease;
	}
	.bd-svc-card:hover .bd-svc-more { gap: 0.55rem; }

	/* ── Join the team banner ── */
	.bd-join {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: clamp(1.5rem, 4vw, 3rem);
		max-width: 80rem;
		margin: clamp(2.5rem, 5vw, 4rem) auto clamp(3rem, 6vw, 5rem);
		padding: clamp(2.5rem, 5vw, 4rem) clamp(2rem, 5vw, 4rem);
		border-radius: 1.75rem;
		background:
			radial-gradient(560px 240px at 100% 0%, color-mix(in srgb, var(--bd-accent) 18%, transparent), transparent 70%),
			var(--bd-glass);
		border: 1px solid var(--bd-glass-border);
		box-shadow: var(--bd-shadow);
		backdrop-filter: blur(18px);
		-webkit-backdrop-filter: blur(18px);
	}
	.bd-join-copy { display: flex; flex-direction: column; gap: 0.6rem; text-align: left; max-width: 34rem; }
	.bd-join-copy strong { font-size: clamp(1.4rem, 2.8vw, 2rem); font-weight: 700; letter-spacing: -0.015em; line-height: 1.15; }
	.bd-join-copy span { font-size: clamp(0.98rem, 1.6vw, 1.1rem); line-height: 1.5; color: var(--bd-muted); }
	.bd-join-btn { flex-shrink: 0; padding: 0.95rem 1.9rem; font-size: 1rem; }
	@media (max-width: 640px) {
		.bd-join { flex-direction: column; align-items: flex-start; }
		.bd-join-btn { width: 100%; justify-content: center; }
	}

	/* ── Brevarium showcase ── */
	.bd-brev {
		flex-direction: row;
		align-items: center;
		gap: clamp(1.5rem, 4vw, 3.5rem);
		text-align: left;
		background:
			radial-gradient(700px 400px at 85% -10%, color-mix(in srgb, var(--bd-accent) 22%, transparent), transparent 70%),
			linear-gradient(160deg, rgba(18, 22, 42, 0.92), rgba(5, 6, 13, 0.96));
		color: #f4f6fb;
		border-color: color-mix(in srgb, var(--bd-accent) 26%, rgba(255, 255, 255, 0.1));
	}
	.bd-brev-cover {
		position: relative;
		flex: 0 0 auto;
		width: clamp(170px, 26%, 250px);
		border-radius: 0.9rem;
		overflow: hidden;
		box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.75);
		transform: rotate(-3deg);
		transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.bd-brev:hover .bd-brev-cover { transform: rotate(0deg) scale(1.03); }
	.bd-brev-cover img { display: block; width: 100%; height: auto; }
	.bd-brev-shine {
		position: absolute;
		inset: 0;
		background: linear-gradient(115deg, transparent 35%, rgba(255, 255, 255, 0.28) 50%, transparent 62%);
		transform: translateX(-120%);
		animation: bd-sheen 5s ease-in-out infinite 1s;
		pointer-events: none;
	}
	.bd-brev-copy { flex: 1 1 auto; }
	.bd-brev-copy .bd-p { color: rgba(244, 246, 251, 0.66); margin-inline: 0; }
	.bd-brev-actions { display: flex; align-items: center; gap: 1.2rem; flex-wrap: wrap; margin-top: 0.4rem; }
	.bd-brev-meta { font-size: 0.78rem; letter-spacing: 0.04em; color: rgba(244, 246, 251, 0.5); }
	.bd-brev-back { margin-top: 1.5rem; }
	.bd-brev-back-h { display: block; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(244, 246, 251, 0.5); margin-bottom: 0.7rem; }
	.bd-brev-eds { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; }
	.bd-brev-ed {
		display: flex; align-items: center; gap: 0.7rem; padding: 0.6rem 0.85rem; border-radius: 0.8rem;
		background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); color: #f4f6fb;
		transition: background 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
	}
	.bd-brev-ed:hover { background: color-mix(in srgb, var(--bd-accent) 14%, transparent); border-color: color-mix(in srgb, var(--bd-accent) 40%, transparent); transform: translateY(-1px); }
	.bd-brev-ed > :global(svg):first-child { color: var(--bd-accent); flex-shrink: 0; }
	.bd-brev-ed-meta { display: flex; flex-direction: column; line-height: 1.2; flex: 1; min-width: 0; }
	.bd-brev-ed-meta strong { font-size: 0.9rem; font-weight: 600; }
	.bd-brev-ed-meta em { font-style: normal; font-size: 0.75rem; color: rgba(244, 246, 251, 0.5); }
	.bd-brev-ed-dl { color: rgba(244, 246, 251, 0.5); flex-shrink: 0; }
	.bd-brev-ed:hover .bd-brev-ed-dl { color: var(--bd-accent); }
	:global(html:not(.dark)) .bd-brev-back-h { color: color-mix(in srgb, var(--bd-ink) 45%, transparent); }
	:global(html:not(.dark)) .bd-brev-ed { background: color-mix(in srgb, var(--bd-ink) 4%, transparent); border-color: var(--bd-glass-border); color: var(--bd-ink); }
	:global(html:not(.dark)) .bd-brev-ed-meta em,
	:global(html:not(.dark)) .bd-brev-ed-dl { color: color-mix(in srgb, var(--bd-ink) 50%, transparent); }
	/* Light mode: don't punch a dark hole into the light page — go glassy,
	   keep the cover crisp with a soft frame. */
	:global(html:not(.dark)) .bd-brev {
		background:
			radial-gradient(700px 400px at 85% -10%, color-mix(in srgb, var(--bd-accent) 14%, transparent), transparent 70%),
			var(--bd-glass);
		color: var(--bd-ink);
		border-color: var(--bd-glass-border);
	}
	:global(html:not(.dark)) .bd-brev-copy .bd-p { color: var(--bd-muted); }
	:global(html:not(.dark)) .bd-brev-meta { color: color-mix(in srgb, var(--bd-ink) 45%, transparent); }
	:global(html:not(.dark)) .bd-brev-cover {
		box-shadow: 0 22px 48px -18px rgba(20, 22, 40, 0.45);
		outline: 1px solid rgba(20, 22, 40, 0.08);
	}
	@media (max-width: 720px) {
		.bd-brev { flex-direction: column; text-align: center; padding-top: 2rem; margin-top: 1.25rem; }
		.bd-brev .bd-eyebrow { width: 100%; }
		.bd-brev-copy .bd-p { margin-inline: auto; }
		.bd-brev-actions { justify-content: center; }
		.bd-brev-cover { width: min(220px, 60%); transform: rotate(0deg); }
	}

	/* ════ Custom About footer (deep in both themes) ════ */
	.bd-footer {
		--bd-accent: #28a6ec;
		position: relative;
		overflow: hidden;
		background:
			radial-gradient(1000px 500px at 80% -10%, color-mix(in srgb, var(--bd-accent) 14%, transparent), transparent 60%),
			linear-gradient(180deg, #05060d 0%, #02030a 100%);
		color: #e9eaf2;
		padding: clamp(3rem, 6vw, 5rem) clamp(1.25rem, 5vw, 4rem) 2rem;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
	}
	.bd-ft-top { position: absolute; top: 0; left: 0; right: 0; height: 1px; background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--bd-accent) 70%, transparent), transparent); }
	.bd-ft-inner { display: grid; gap: clamp(2rem, 4vw, 3rem); max-width: 80rem; margin: 0 auto; }
	@media (min-width: 760px) { .bd-ft-inner { grid-template-columns: 1fr 1fr; align-items: start; } }
	@media (min-width: 1080px) { .bd-ft-inner { grid-template-columns: 1.25fr 1.7fr 1fr 0.85fr; align-items: start; } }
	.bd-ft-h { display: block; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(233, 234, 242, 0.5); margin-bottom: 1rem; }
	.bd-ft-logo { display: inline-block; color: #fff; }
	.bd-ft-logo :global(svg path) { fill: #fff; }
	.bd-ft-pitch { color: rgba(233, 234, 242, 0.65); font-size: 0.92rem; line-height: 1.6; margin: 1rem 0 1.5rem; max-width: 24rem; }
	.bd-ft-news-row { display: flex; gap: 0.5rem; max-width: 22rem; }
	.bd-ft-news input { flex: 1; min-width: 0; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 9999px; padding: 0.7rem 1.1rem; color: #fff; font-size: 0.9rem; outline: none; transition: border-color 0.25s ease; }
	.bd-ft-news input:focus { border-color: var(--bd-accent); }
	.bd-ft-news button { flex-shrink: 0; width: 46px; height: 46px; display: grid; place-items: center; border-radius: 9999px; color: #fff; background: linear-gradient(180deg, color-mix(in srgb, var(--bd-accent) 88%, #fff), var(--bd-accent)); cursor: pointer; transition: transform 0.2s ease; }
	.bd-ft-news button:hover { transform: scale(1.07); }
	.bd-ft-news-msg { display: block; font-size: 0.8rem; color: var(--bd-accent); margin-top: 0.6rem; min-height: 1rem; }
	/* offices — roomy, never compressed */
	.bd-ft-office-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.8rem; }
	@media (max-width: 520px) { .bd-ft-office-grid { grid-template-columns: 1fr; } }
	.bd-ft-office { padding: 1rem 1.1rem; border-radius: 1rem; background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.09); transition: border-color 0.3s ease, background 0.3s ease; }
	.bd-ft-office:hover { border-color: color-mix(in srgb, var(--bd-accent) 40%, transparent); background: color-mix(in srgb, var(--bd-accent) 7%, rgba(255, 255, 255, 0.04)); }
	.bd-ft-office-top { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.55rem; }
	.bd-ft-flag { font-size: 1.05rem; }
	.bd-ft-office-country { font-weight: 700; font-size: 0.95rem; color: #fff; }
	.ft-clock.bd-ft-clock { margin-left: auto; display: inline-flex; align-items: center; gap: 0.35rem; font-family: ui-monospace, monospace; font-size: 0.8rem; color: var(--bd-accent); }
	.bd-ft-clock-dot { width: 6px; height: 6px; border-radius: 9999px; background: #28c840; box-shadow: 0 0 0 0 rgba(40, 200, 64, 0.5); animation: bd-ft-pulse 2s infinite; }
	@keyframes bd-ft-pulse { 0% { box-shadow: 0 0 0 0 rgba(40, 200, 64, 0.5); } 70% { box-shadow: 0 0 0 6px rgba(40, 200, 64, 0); } 100% { box-shadow: 0 0 0 0 rgba(40, 200, 64, 0); } }
	.bd-ft-address { font-style: normal; display: flex; flex-direction: column; gap: 0.1rem; font-size: 0.85rem; line-height: 1.5; color: rgba(233, 234, 242, 0.6); }
	/* reach */
	.bd-ft-social-note { margin: 0.9rem 0 0; font-size: 0.8rem; line-height: 1.5; color: rgba(233, 234, 242, 0.45); max-width: 16rem; }
	.bd-ft-contact { list-style: none; padding: 0; margin: 0; }
	.bd-ft-contact li { display: flex; align-items: center; gap: 0.55rem; margin-bottom: 0.75rem; color: rgba(233, 234, 242, 0.7); font-size: 0.92rem; }
	.bd-ft-contact :global(svg) { color: var(--bd-accent); flex-shrink: 0; }
	.bd-ft-flag-sm { font-size: 0.95rem; line-height: 1; }
	.bd-ft-contact a { color: rgba(233, 234, 242, 0.7); transition: color 0.2s ease; }
	.bd-ft-contact a:hover { color: var(--bd-accent); }
	.bd-ft-socials { display: flex; gap: 0.6rem; }
	.bd-ft-social { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 0.9rem; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); color: #e9eaf2; transition: transform 0.25s ease, border-color 0.25s ease, color 0.25s ease, background 0.25s ease; }
	.bd-ft-social:hover { transform: translateY(-3px); color: #fff; border-color: var(--bd-accent); background: color-mix(in srgb, var(--bd-accent) 16%, transparent); }
	.bd-ft-nav { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.3rem; width: fit-content; max-width: 100%; margin: clamp(2.5rem, 5vw, 3.5rem) auto 1.6rem; padding: 0.4rem; border: 1px solid rgba(255, 255, 255, 0.1); background: rgba(255, 255, 255, 0.04); border-radius: 9999px; }
	.bd-ft-nav-item { padding: 0.55rem 1.15rem; border-radius: 9999px; font-size: 0.88rem; font-weight: 600; color: rgba(233, 234, 242, 0.7); transition: color 0.25s ease, background 0.25s ease; }
	.bd-ft-nav-item:hover { color: #fff; background: rgba(255, 255, 255, 0.06); }
	.bd-ft-bottom { display: flex; flex-wrap: wrap; gap: 0.6rem; justify-content: space-between; max-width: 80rem; margin: 0 auto; padding-top: 1.5rem; border-top: 1px solid rgba(255, 255, 255, 0.08); font-size: 0.8rem; color: rgba(233, 234, 242, 0.45); }
	.bd-ft-globe { display: inline-block; animation: bd-ft-spin 6s linear infinite; }
	@keyframes bd-ft-spin { to { transform: rotate(360deg); } }

	/* ── Scroll reveal ── */

	/* ═══════════════════════════════════════════════════════════════
	   THE MANIFESTO — mission, vision, values
	   Everything here animates on reveal and stands still under
	   html.perf-lite. Motion is transform/opacity only, so it composites.
	   ═══════════════════════════════════════════════════════════════ */
	.bd-manifesto {
		position: relative;
		max-width: 1200px;
		margin: clamp(3rem, 8vw, 6rem) auto;
		padding: clamp(2rem, 5vw, 4rem) clamp(1.1rem, 4vw, 2.5rem);
		border-radius: clamp(1.2rem, 2.5vw, 2rem);
		border: 1px solid rgba(255, 255, 255, 0.08);
		background:
			radial-gradient(900px 420px at 50% -10%, color-mix(in srgb, var(--bd-accent) 16%, transparent), transparent 70%),
			linear-gradient(180deg, #070910, #05060c);
		overflow: hidden;
		isolation: isolate;
	}
	.bd-mf-veil {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: radial-gradient(120% 80% at 50% 120%, color-mix(in srgb, var(--bd-accent) 10%, transparent), transparent 65%);
	}
	.bd-mf-head { position: relative; text-align: center; margin-bottom: clamp(1.8rem, 4vw, 3rem); }

	.bd-mf-pair {
		position: relative;
		display: grid;
		gap: clamp(1rem, 2.2vw, 1.6rem);
		grid-template-columns: 1fr;
	}
	@media (min-width: 900px) {
		.bd-mf-pair { grid-template-columns: 1fr 1fr; }
	}
	.bd-mf-panel {
		position: relative;
		display: flex;
		flex-direction: column;
		min-height: clamp(21rem, 34vw, 26rem);
		padding: clamp(1.4rem, 3vw, 2.2rem);
		border-radius: clamp(1rem, 2vw, 1.4rem);
		border: 1px solid rgba(255, 255, 255, 0.1);
		background: linear-gradient(165deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.015) 60%);
		overflow: hidden;
		isolation: isolate;
	}
	.bd-mf-tag {
		position: relative;
		z-index: 2;
		align-self: flex-start;
		padding: 0.3rem 0.8rem;
		border-radius: 9999px;
		border: 1px solid color-mix(in srgb, var(--bd-accent) 45%, transparent);
		background: color-mix(in srgb, var(--bd-accent) 12%, transparent);
		font-size: 0.7rem;
		font-weight: 800;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--bd-accent) 85%, #fff);
	}
	.bd-mf-statement {
		position: relative;
		z-index: 2;
		margin-top: auto;
		padding-top: 1.6rem;
		font-size: clamp(1.45rem, 3vw, 2.15rem);
		font-weight: 800;
		line-height: 1.2;
		letter-spacing: -0.015em;
		color: #f4f7ff;
		text-shadow: 0 2px 18px rgba(3, 5, 12, 0.75);
	}
	/* the statement arrives a word at a time, so it is read, not skimmed */
	.bd-mf-word {
		display: inline-block;
		/* inline-block collapses the space between words, so carry it here */
		padding-right: 0.26em;
		opacity: 0;
		transform: translateY(0.5em);
		filter: blur(5px);
	}
	.bd-reveal.is-on .bd-mf-word {
		animation: bd-word 0.62s cubic-bezier(0.22, 1, 0.36, 1) forwards;
		animation-delay: calc(0.18s + var(--i) * 0.055s);
	}
	@keyframes bd-word {
		to { opacity: 1; transform: none; filter: blur(0); }
	}
	.bd-mf-statement em {
		font-style: normal;
		background: linear-gradient(95deg, #13b6a0, #13a8bf, #1f8fd6);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}
	.bd-mf-support {
		position: relative;
		z-index: 2;
		margin-top: 0.9rem;
		font-size: clamp(0.9rem, 1.6vw, 1rem);
		line-height: 1.6;
		color: rgba(233, 240, 255, 0.6);
		max-width: 46ch;
	}

	/* ── the gravity field behind the mission ── */
	.bd-gravity {
		position: absolute;
		z-index: 0;
		top: -30%;
		right: -26%;
		width: min(24rem, 72%);
		opacity: 0.85;
		aspect-ratio: 1;
		pointer-events: none;
	}
	.bd-gravity-core,
	.bd-gravity-ring,
	.bd-gravity-dot {
		position: absolute;
		top: 50%;
		left: 50%;
		border-radius: 9999px;
	}
	.bd-gravity-core {
		width: 12%;
		aspect-ratio: 1;
		margin: -6% 0 0 -6%;
		background: radial-gradient(circle, #fff, color-mix(in srgb, var(--bd-accent) 80%, transparent) 55%, transparent 72%);
		box-shadow: 0 0 34px color-mix(in srgb, var(--bd-accent) 45%, transparent);
	}
	.bd-reveal.is-on .bd-gravity-core { animation: bd-core 4.5s ease-in-out infinite; }
	@keyframes bd-core {
		0%, 100% { transform: scale(1); opacity: 0.9; }
		50% { transform: scale(1.12); opacity: 1; }
	}
	.bd-gravity-ring {
		border: 1px solid color-mix(in srgb, var(--bd-accent) 30%, transparent);
		opacity: 0.5;
	}
	.bd-gravity-ring--0 { width: 34%; aspect-ratio: 1; margin: -17% 0 0 -17%; }
	.bd-gravity-ring--1 { width: 56%; aspect-ratio: 1; margin: -28% 0 0 -28%; }
	.bd-gravity-ring--2 { width: 78%; aspect-ratio: 1; margin: -39% 0 0 -39%; }
	.bd-gravity-ring--3 { width: 100%; aspect-ratio: 1; margin: -50% 0 0 -50%; }
	.bd-reveal.is-on .bd-gravity-ring {
		animation: bd-ring 9s ease-in-out infinite alternate;
	}
	.bd-gravity-ring--1 { animation-delay: 0.6s !important; }
	.bd-gravity-ring--2 { animation-delay: 1.2s !important; }
	.bd-gravity-ring--3 { animation-delay: 1.8s !important; }
	@keyframes bd-ring {
		from { transform: scale(1) rotate(0); opacity: 0.18; }
		to { transform: scale(1.06) rotate(8deg); opacity: 0.5; }
	}
	/* everything is falling toward the middle */
	.bd-gravity-dot {
		width: 4px;
		height: 4px;
		margin: -2px 0 0 -2px;
		background: color-mix(in srgb, var(--bd-accent) 90%, #fff);
		opacity: 0;
		transform: rotate(var(--a)) translateX(var(--d));
	}
	.bd-reveal.is-on .bd-gravity-dot {
		animation: bd-fall 6s cubic-bezier(0.5, 0, 0.75, 0) infinite;
		animation-delay: calc(var(--i) * 0.42s);
	}
	@keyframes bd-fall {
		0% { opacity: 0; transform: rotate(var(--a)) translateX(var(--d)) scale(1); }
		12% { opacity: 0.9; }
		100% { opacity: 0; transform: rotate(calc(var(--a) + 40deg)) translateX(0) scale(0.3); }
	}

	/* ── the road under the mission: imagine, build, launch, legacy ── */
	.bd-mf-arc {
		position: relative;
		z-index: 2;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.4rem;
		margin-top: 1.6rem;
		padding-top: 1.2rem;
	}
	.bd-mf-arc-line {
		position: absolute;
		top: 1.55rem;
		left: 6%;
		right: 6%;
		height: 1px;
		background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--bd-accent) 55%, transparent), transparent);
		transform: scaleX(0);
		transform-origin: left;
	}
	.bd-reveal.is-on .bd-mf-arc-line { animation: bd-draw 1.4s cubic-bezier(0.22, 1, 0.36, 1) 0.5s forwards; }
	@keyframes bd-draw { to { transform: scaleX(1); } }
	.bd-mf-arc-step {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		font-size: clamp(0.7rem, 1.3vw, 0.72rem);
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: rgba(233, 240, 255, 0.5);
	}
	.bd-mf-arc-step i {
		width: 9px;
		height: 9px;
		border-radius: 9999px;
		background: rgba(255, 255, 255, 0.25);
		box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.04);
	}
	.bd-mf-arc-step--last { color: color-mix(in srgb, var(--bd-accent) 85%, #fff); }
	.bd-mf-arc-step--last i {
		background: var(--bd-accent);
		box-shadow: 0 0 0 5px color-mix(in srgb, var(--bd-accent) 22%, transparent);
	}
	.bd-reveal.is-on .bd-mf-arc-step--last i { animation: bd-core 2.6s ease-in-out infinite; }

	/* ── the horizon behind the vision ── */
	.bd-horizon { position: absolute; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; }
	.bd-horizon-sky {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(120% 70% at 50% 108%, color-mix(in srgb, var(--bd-accent) 30%, transparent), transparent 62%),
			linear-gradient(180deg, transparent 40%, rgba(19, 182, 160, 0.06));
	}
	.bd-horizon-globe {
		position: absolute;
		left: 50%;
		bottom: -58%;
		width: 128%;
		aspect-ratio: 1;
		margin-left: -64%;
		border-radius: 9999px;
		border-top: 1px solid color-mix(in srgb, var(--bd-accent) 55%, transparent);
		background: radial-gradient(closest-side, color-mix(in srgb, var(--bd-accent) 12%, transparent), transparent 72%);
	}
	.bd-reveal.is-on .bd-horizon-globe { animation: bd-rise 1.6s cubic-bezier(0.22, 1, 0.36, 1) both; }
	@keyframes bd-rise {
		from { transform: translateY(14%) scale(0.94); opacity: 0; }
		to { transform: none; opacity: 1; }
	}
	/* the signal going out from it */
	.bd-horizon-pulse {
		position: absolute;
		left: 50%;
		bottom: -58%;
		width: 128%;
		aspect-ratio: 1;
		margin-left: -64%;
		border-radius: 9999px;
		border: 1px solid color-mix(in srgb, var(--bd-accent) 40%, transparent);
		opacity: 0;
	}
	.bd-reveal.is-on .bd-horizon-pulse { animation: bd-pulse 5.5s ease-out infinite; }
	.bd-horizon-pulse--1 { animation-delay: 1.8s !important; }
	.bd-horizon-pulse--2 { animation-delay: 3.6s !important; }
	@keyframes bd-pulse {
		0% { opacity: 0.55; transform: scale(1); }
		100% { opacity: 0; transform: scale(1.45); }
	}
	.bd-horizon-star {
		position: absolute;
		left: var(--x);
		top: var(--y);
		width: 3px;
		height: 3px;
		border-radius: 9999px;
		background: #fff;
		opacity: 0.5;
	}
	.bd-reveal.is-on .bd-horizon-star {
		animation: bd-twinkle 3.4s ease-in-out infinite;
		animation-delay: calc(var(--i) * 0.5s);
	}
	@keyframes bd-twinkle {
		0%, 100% { opacity: 0.18; transform: scale(0.8); }
		50% { opacity: 0.9; transform: scale(1.25); }
	}

	/* ── the four values ── */
	.bd-mf-values { position: relative; margin-top: clamp(2.4rem, 5vw, 4rem); }
	.bd-mf-vhead { text-align: center; margin-bottom: clamp(1.2rem, 3vw, 2rem); }
	.bd-mf-vsub {
		margin: 0.6rem auto 0;
		max-width: 46ch;
		font-size: clamp(0.9rem, 1.6vw, 1rem);
		line-height: 1.6;
		color: rgba(233, 240, 255, 0.55);
	}
	.bd-mf-vgrid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: clamp(0.7rem, 1.6vw, 1.1rem);
	}
	@media (max-width: 1080px) { .bd-mf-vgrid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
	@media (max-width: 620px) { .bd-mf-vgrid { grid-template-columns: 1fr; } }
	.bd-mf-card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: clamp(1.2rem, 2.4vw, 1.7rem);
		border-radius: 1rem;
		border: 1px solid rgba(255, 255, 255, 0.1);
		background: linear-gradient(170deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.02) 65%);
		overflow: hidden;
		transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.4s ease, box-shadow 0.4s ease;
	}
	.bd-reveal.bd-mf-card { transition-delay: calc(var(--i) * 0.09s); }
	.bd-mf-card:hover {
		transform: translateY(-6px);
		border-color: color-mix(in srgb, var(--bd-accent) 55%, transparent);
		box-shadow: 0 26px 50px -28px color-mix(in srgb, var(--bd-accent) 90%, transparent);
	}
	.bd-mf-card-sheen {
		position: absolute;
		top: -60%;
		left: -70%;
		width: 45%;
		height: 220%;
		background: linear-gradient(100deg, transparent, rgba(255, 255, 255, 0.12), transparent);
		transform: skewX(-16deg);
		opacity: 0;
	}
	.bd-mf-card:hover .bd-mf-card-sheen { animation: bd-cardsheen 0.9s ease-out; }
	@keyframes bd-cardsheen {
		0% { opacity: 0; left: -70%; }
		25% { opacity: 1; }
		100% { opacity: 0; left: 130%; }
	}
	.bd-mf-card-no {
		font-size: 0.72rem;
		font-weight: 900;
		letter-spacing: 0.16em;
		color: color-mix(in srgb, var(--bd-accent) 75%, #fff);
	}
	.bd-mf-card-ic {
		display: grid;
		place-items: center;
		width: 3rem;
		height: 3rem;
		border-radius: 0.9rem;
		border: 1px solid color-mix(in srgb, var(--bd-accent) 35%, transparent);
		background:
			radial-gradient(120% 120% at 30% 20%, color-mix(in srgb, var(--bd-accent) 35%, transparent), transparent 70%),
			rgba(255, 255, 255, 0.05);
		color: color-mix(in srgb, var(--bd-accent) 90%, #fff);
		transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.bd-mf-card:hover .bd-mf-card-ic { transform: scale(1.08) rotate(-5deg); }
	.bd-mf-card-t {
		font-size: clamp(1.05rem, 2vw, 1.2rem);
		font-weight: 800;
		line-height: 1.25;
		letter-spacing: -0.01em;
		color: #f2f6ff;
	}
	.bd-mf-card-d {
		font-size: clamp(0.84rem, 1.5vw, 0.92rem);
		line-height: 1.55;
		color: rgba(233, 240, 255, 0.6);
	}
	.bd-mf-card-rule {
		margin-top: auto;
		width: 2.4rem;
		height: 3px;
		border-radius: 9999px;
		background: linear-gradient(90deg, var(--bd-accent), transparent);
		transition: width 0.45s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.bd-mf-card:hover .bd-mf-card-rule { width: 4.5rem; }

	/* ── light mode ──────────────────────────────────────────────────
	   The manifesto was a dark slab on a light page, so the heading sat
	   invisible on it. In daylight the whole block turns to paper: white
	   panels, ink type, and the accent doing the highlighting instead of
	   the background. */
	:global(html:not(.dark)) .bd-manifesto {
		border-color: rgba(20, 22, 42, 0.1);
		background:
			radial-gradient(900px 420px at 50% -10%, color-mix(in srgb, var(--bd-accent) 12%, transparent), transparent 70%),
			linear-gradient(180deg, #ffffff, #f4f7fc);
		box-shadow: 0 30px 70px -50px rgba(20, 22, 42, 0.5);
	}
	:global(html:not(.dark)) .bd-mf-veil {
		background: radial-gradient(120% 80% at 50% 120%, color-mix(in srgb, var(--bd-accent) 8%, transparent), transparent 65%);
	}
	:global(html:not(.dark)) .bd-mf-panel,
	:global(html:not(.dark)) .bd-mf-card {
		border-color: rgba(20, 22, 42, 0.1);
		background: linear-gradient(165deg, #ffffff, #f7fafe 65%);
		box-shadow: 0 18px 40px -30px rgba(20, 22, 42, 0.45);
	}
	:global(html:not(.dark)) .bd-mf-statement {
		color: #14162a;
		text-shadow: none;
	}
	:global(html:not(.dark)) .bd-mf-support,
	:global(html:not(.dark)) .bd-mf-vsub,
	:global(html:not(.dark)) .bd-mf-card-d { color: rgba(20, 22, 42, 0.62); }
	:global(html:not(.dark)) .bd-mf-card-t { color: #14162a; }
	:global(html:not(.dark)) .bd-mf-arc-step { color: rgba(20, 22, 42, 0.5); }
	:global(html:not(.dark)) .bd-mf-arc-step i {
		background: rgba(20, 22, 42, 0.18);
		box-shadow: 0 0 0 4px rgba(20, 22, 42, 0.05);
	}
	:global(html:not(.dark)) .bd-mf-card-ic {
		background:
			radial-gradient(120% 120% at 30% 20%, color-mix(in srgb, var(--bd-accent) 22%, transparent), transparent 70%),
			rgba(20, 22, 42, 0.03);
		color: color-mix(in srgb, var(--bd-accent) 85%, #14162a);
	}
	:global(html:not(.dark)) .bd-mf-card-sheen {
		background: linear-gradient(100deg, transparent, rgba(20, 22, 42, 0.06), transparent);
	}
	/* the gravity field and the horizon read as ink on paper */
	:global(html:not(.dark)) .bd-gravity-ring { border-color: color-mix(in srgb, var(--bd-accent) 40%, transparent); }
	:global(html:not(.dark)) .bd-gravity-dot { background: color-mix(in srgb, var(--bd-accent) 85%, #14162a); }
	:global(html:not(.dark)) .bd-gravity-core {
		background: radial-gradient(circle, #fff, color-mix(in srgb, var(--bd-accent) 85%, transparent) 55%, transparent 72%);
		box-shadow: 0 0 30px color-mix(in srgb, var(--bd-accent) 40%, transparent);
	}
	:global(html:not(.dark)) .bd-horizon-sky {
		background:
			radial-gradient(120% 70% at 50% 108%, color-mix(in srgb, var(--bd-accent) 18%, transparent), transparent 62%),
			linear-gradient(180deg, transparent 40%, rgba(19, 182, 160, 0.04));
	}
	:global(html:not(.dark)) .bd-horizon-star { background: rgba(20, 22, 42, 0.35); }

	/* the calm version */
	html.perf-lite .bd-gravity-dot,
	html.perf-lite .bd-gravity-ring,
	html.perf-lite .bd-gravity-core,
	html.perf-lite .bd-horizon-pulse,
	html.perf-lite .bd-horizon-star { animation: none !important; }
	html.perf-lite .bd-gravity-dot { opacity: 0.5; }
	@media (prefers-reduced-motion: reduce) {
		.bd-mf-word { opacity: 1; transform: none; filter: none; }
		.bd-mf-arc-line { transform: scaleX(1); }
	}

	.bd-reveal {
		opacity: 0;
		transform: translateY(26px);
		transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.bd-reveal.is-on { opacity: 1; transform: translateY(0); }

	@media (prefers-reduced-motion: reduce) {
		.bd-reveal { opacity: 1; transform: none; transition: none; }
		.bd-media-sheen,
		.bd-marquee-track,
		.bd-scroll-cue,
		.bd-brev-shine,
		.bd-ft-clock-dot,
		.bd-ft-globe,
		.bd-mantra-glow,
		.bd-tl-aurora,
		.bd-tl-grid-lines,
		.bd-timeline::after,
		.bd-tl-node,
		.bd-hero-orbs i,
		.bd-hero-aurora,
		.bd-hero-team-card,
		.bd-hero-chip,
		.bd-hero-text .bd-grad { animation: none; }
		.bd-hero-orbs { display: none; }
		.bd-marquee { overflow-x: auto; }
		.bd-tile,
		.bd-tile:hover,
		.bd-member,
		.bd-member:hover { transform: none; }
	}

	/* ═══ About, in the Apple grammar ══════════════════════════════════
	   Four beats per panel, every time: a small label, a short headline
	   with a full stop, one line of support, then a solid pill beside a
	   plain text link. The picture carries the rest. Panels alternate
	   pale and deep; nothing is decorated that a photograph could say.
	   Kept at the end of the sheet so it settles against the .bd- rules
	   above it — a media query carries no extra specificity, and source
	   order is the only thing that does.
	   ══════════════════════════════════════════════════════════════════ */
	.ab-vals {
		max-width: 76rem;
		margin-inline: auto;
		text-align: center;
	}

	/* ── the opening two-up ──
	   Equal panels, stretched to one height, each centred on its own
	   words. One carries the type, the other carries the film. */
	.ab-open {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(0.9rem, 1.8vw, 1.4rem);
		max-width: 88rem;
		margin: clamp(1.2rem, 3vw, 2.2rem) auto clamp(2.5rem, 6vw, 4.5rem);
	}
	.ab-open-panel {
		display: flex;
		flex-direction: column;
		border-radius: clamp(1rem, 2vw, 1.7rem);
		overflow: hidden;
		min-height: clamp(24rem, 40vw, 34rem);
	}
	.ab-open-panel.is-pale { background: #f2f4f9; color: #10121f; }
	.ab-open-panel.is-deep { background: #05070f; color: #f3f6fc; }
	.ab-open-copy {
		padding: clamp(1.8rem, 3.6vw, 3.2rem) clamp(1.2rem, 2.6vw, 2.4rem) 0;
		text-align: center;
	}
	.ab-open-panel .ab-acts { justify-content: center; }
	.ab-kick {
		display: inline-block;
		font-size: 0.74rem;
		font-weight: 700;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--bd-accent);
	}
	.ab-h1 {
		margin: clamp(0.7rem, 1.6vw, 1rem) 0 0;
		font-size: clamp(1.6rem, 3.4vw, 2.9rem);
		font-weight: 800;
		letter-spacing: -0.045em;
		line-height: 1.02;
		text-wrap: balance;
	}
	/* The panels are pale and deep whatever the theme is, so the headline
	   gradient has to key off the panel rather than off html.dark. Keyed
	   off the theme it went pale-on-pale in dark mode and all but
	   disappeared. */
	.ab-h1 em,
	.ab-h2 em {
		display: block;
		font-style: normal;
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}
	.is-pale .ab-h1 em,
	.is-pale .ab-h2 em {
		background-image: linear-gradient(100deg, #1e3a8a 4%, #2f86d6 84%);
	}
	.is-deep .ab-h1 em,
	.is-deep .ab-h2 em {
		background-image: linear-gradient(100deg, #d9edff 6%, var(--bd-accent) 80%);
	}
	.ab-lede {
		margin: clamp(0.8rem, 1.8vw, 1.15rem) auto 0;
		max-width: 34rem;
		font-size: clamp(0.9rem, 1.1vw, 1.02rem);
		line-height: 1.6;
		opacity: 0.74;
	}
	.ab-lede--sm { display: none; }

	/* the pair of ways in: one solid, one plain, always together */
	.ab-acts {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: clamp(0.8rem, 1.8vw, 1.6rem);
		margin-top: clamp(1.3rem, 2.8vw, 2rem);
	}
	.ab-hero .ab-acts,
	.ab-film .ab-acts { justify-content: center; }
	.ab-pill {
		display: inline-flex;
		align-items: center;
		min-height: 2.9rem;
		padding: 0 1.5rem;
		border-radius: 999px;
		background: var(--bd-accent);
		color: #04101a;
		font-size: 0.95rem;
		font-weight: 650;
		white-space: nowrap;
		transition: transform 0.25s ease, filter 0.25s ease;
	}
	.ab-pill:hover { transform: translateY(-2px); filter: brightness(1.08); }
	.ab-more {
		display: inline-flex;
		align-items: center;
		gap: 0.15rem;
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--bd-accent);
		transition: gap 0.25s ease;
	}
	.ab-more:hover { gap: 0.4rem; }

	/* the figures sit on the floor of the panel, where the product
	   photograph sits on the reference */
	/* An even three, ruled off from the copy, so the floor of the panel
	   reads as structure rather than as the hole left by a short column
	   of text. */
	.ab-glance {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		list-style: none;
		margin: auto clamp(1rem, 2.4vw, 2.2rem) 0;
		padding: clamp(1.1rem, 2.4vw, 1.7rem) 0 clamp(1.2rem, 2.6vw, 1.9rem);
		border-top: 1px solid color-mix(in srgb, currentColor 14%, transparent);
		text-align: center;
	}
	.ab-glance li {
		min-width: 0;
		padding-inline: 0.4rem;
		border-left: 1px solid color-mix(in srgb, currentColor 12%, transparent);
	}
	.ab-glance li:first-child { border-left: 0; }
	.ab-glance strong {
		display: block;
		font-size: clamp(1.25rem, 2.3vw, 1.85rem);
		font-weight: 800;
		letter-spacing: -0.03em;
	}
	.ab-glance span {
		font-size: 0.74rem;
		letter-spacing: 0.02em;
		opacity: 0.66;
	}

	.ab-h2 {
		margin: 0;
		font-size: clamp(1.8rem, 4.4vw, 3.4rem);
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 1.04;
		text-wrap: balance;
	}
	.ab-h2 span { display: block; opacity: 0.6; }
	.ab-h2--panel { font-size: clamp(1.4rem, 2.6vw, 2.1rem); }
	/* the screen is the floor of its panel, the way the product photograph
	   is the floor of the panel it sits in */
	.ab-screen {
		position: relative;
		flex: 1;
		display: flex;
		margin: clamp(1.4rem, 3vw, 2.4rem) clamp(1rem, 2.2vw, 1.8rem)
			clamp(1rem, 2.2vw, 1.8rem);
		border-radius: clamp(0.7rem, 1.3vw, 1.05rem);
		overflow: hidden;
		/* the bezel: a dark rim and a long shadow, the way a screen sits in
		   a room rather than on a page */
		border: clamp(6px, 0.9vw, 11px) solid #0b0d15;
		box-shadow:
			0 2px 0 rgba(255, 255, 255, 0.06) inset,
			0 48px 90px -40px rgba(0, 0, 0, 0.75);
		background: #05070f;
	}
	.ab-screen :global(.flm) {
		border-radius: 0;
		width: 100%;
		height: 100%;
	}
	/* The ratio lives on .flm__screen, not on .flm — setting it on the
	   wrapper left the picture at 16/9 with a shelf of dark underneath.
	   Released here, the panel's own height decides, and `cover` crops. */
	.ab-screen :global(.flm__screen) {
		height: 100%;
		aspect-ratio: auto;
		border-radius: 0;
		border: 0;
	}
	.ab-screen-film { flex: 1; display: flex; min-height: 0; }
	.ab-glance-s { display: none; }
	.ab-screen-badge {
		position: absolute;
		left: clamp(0.7rem, 1.6vw, 1.2rem);
		bottom: clamp(0.7rem, 1.6vw, 1.2rem);
		z-index: 4;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.3rem 0.7rem 0.3rem 0.55rem;
		border-radius: 999px;
		background: rgba(6, 9, 16, 0.55);
		border: 1px solid rgba(255, 255, 255, 0.16);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		color: #fff;
		font-size: 0.72rem;
		pointer-events: none;
	}
	.ab-screen-badge span { font-weight: 700; }
	.ab-screen-badge em {
		font-style: normal;
		opacity: 0.7;
		padding-left: 0.4rem;
		border-left: 1px solid rgba(255, 255, 255, 0.28);
	}

	/* ── a wide panel: copy on the left, picture filling the right ── */
	.ab-wide {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
		align-items: stretch;
		max-width: 88rem;
		margin: clamp(2.5rem, 6vw, 4.5rem) auto;
		border-radius: clamp(1rem, 2vw, 1.7rem);
		overflow: hidden;
	}
	.ab-wide.is-deep { background: #05070f; color: #f3f6fc; }
	.ab-wide.is-pale { background: #f2f4f9; color: #10121f; }
	.ab-wide-copy {
		align-self: center;
		padding: clamp(2rem, 4.4vw, 3.6rem) clamp(1.4rem, 3vw, 3rem);
		text-align: left;
	}
	.ab-line {
		margin: clamp(0.8rem, 1.8vw, 1.1rem) 0 0;
		max-width: 42ch;
		/* at a third of a phone one long word was pushing the line four
		   pixels past its own box */
		overflow-wrap: break-word;
		font-size: clamp(0.95rem, 1.2vw, 1.05rem);
		line-height: 1.6;
		opacity: 0.74;
	}
	.ab-wide-shot { position: relative; min-height: clamp(16rem, 28vw, 26rem); }
	.ab-wide-shot img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 26%;
	}

	/* ── the two-up ── */
	.ab-pair {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(0.9rem, 1.8vw, 1.4rem);
		max-width: 88rem;
		margin: 0 auto clamp(2.5rem, 6vw, 4.5rem);
	}
	.ab-panel {
		display: flex;
		flex-direction: column;
		border-radius: clamp(1rem, 2vw, 1.7rem);
		overflow: hidden;
		min-height: clamp(24rem, 40vw, 34rem);
	}
	.ab-panel.is-pale { background: #f2f4f9; color: #10121f; }
	.ab-panel.is-deep { background: #05070f; color: #f3f6fc; }
	.ab-panel-copy {
		padding: clamp(1.6rem, 3.2vw, 2.6rem) clamp(1.3rem, 2.6vw, 2.2rem) 0;
		text-align: center;
	}
	.ab-panel .ab-acts { justify-content: center; }
	.ab-panel .ab-line { margin-inline: auto; max-width: 38ch; }
	.ab-line--sm { display: none; }
	.ab-h3 {
		margin: 0.55rem 0 0;
		font-size: clamp(1.5rem, 2.8vw, 2.2rem);
		font-weight: 800;
		letter-spacing: -0.035em;
		line-height: 1.06;
		text-wrap: balance;
	}
	.ab-panel-shot {
		position: relative;
		flex: 1;
		min-height: clamp(9rem, 15vw, 14rem);
		margin-top: clamp(1.4rem, 2.6vw, 2rem);
	}
	.ab-panel-shot img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* ── the four promises, as a row ── */
	.ab-vals { padding: clamp(1.5rem, 4vw, 3rem) clamp(1rem, 3vw, 2rem) clamp(2.5rem, 6vw, 4rem); max-width: 84rem; }
	.ab-vals-sub {
		margin: clamp(0.8rem, 1.8vw, 1.1rem) auto 0;
		max-width: 44rem;
		font-size: clamp(0.92rem, 1.15vw, 1.02rem);
		line-height: 1.6;
		color: var(--bd-muted);
	}
	.ab-vrow {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: clamp(0.8rem, 1.8vw, 1.5rem);
		list-style: none;
		margin: clamp(1.8rem, 4vw, 3rem) 0 0;
		padding: 0;
	}
	/* Four cards, each with a picture of the promise being kept — the
	   Accessories pattern from the reference, where a four-up is never
	   four icons standing on an empty field. */
	.ab-val { text-align: left; }
	.ab-val-card {
		display: block;
		height: 100%;
		text-decoration: none;
		color: inherit;
	}
	.ab-val-shot {
		position: relative;
		display: block;
		aspect-ratio: 16 / 11;
		border-radius: clamp(0.8rem, 1.4vw, 1.15rem);
		overflow: hidden;
		background: #05070f;
		border: 1px solid var(--bd-glass-border);
	}
	.ab-val-shot img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.ab-val-card:hover .ab-val-shot img { transform: scale(1.05); }
	/* the icon stays, but on the picture where it belongs */
	.ab-val-ic {
		position: absolute;
		left: 0.7rem;
		bottom: 0.7rem;
		display: grid;
		place-items: center;
		width: 2.1rem;
		height: 2.1rem;
		border-radius: 0.65rem;
		border: 1px solid rgba(255, 255, 255, 0.28);
		background: rgba(6, 9, 16, 0.5);
		color: #fff;
	}
	.ab-val-t {
		margin: 0.85rem 0 0;
		font-size: clamp(0.98rem, 1.3vw, 1.12rem);
		font-weight: 700;
		letter-spacing: -0.015em;
		line-height: 1.25;
	}
	.ab-val-d {
		margin: 0.4rem 0 0;
		font-size: 0.86rem;
		line-height: 1.55;
		color: var(--bd-muted);
	}
	.ab-val-d--sm { display: none; }
	.ab-val-go {
		display: inline-flex;
		align-items: center;
		gap: 0.1rem;
		margin-top: 0.6rem;
		font-size: 0.82rem;
		font-weight: 650;
		color: var(--bd-accent);
		transition: gap 0.25s ease;
	}
	.ab-val-card:hover .ab-val-go { gap: 0.35rem; }

	@media (max-width: 860px) {
		.ab-open-panel { min-height: clamp(20rem, 52vw, 28rem); }
		.ab-h1 { font-size: clamp(1.4rem, 3.4vw, 2rem); }
		.ab-h2--panel { font-size: clamp(1.2rem, 3vw, 1.6rem); }
		.ab-wide { grid-template-columns: 1fr; }
		.ab-wide-shot { order: -1; min-height: clamp(12rem, 44vw, 18rem); }
		.ab-wide-copy { text-align: center; }
		.ab-wide-copy .ab-acts { justify-content: center; }
		.ab-wide .ab-line { margin-inline: auto; }
		.ab-vrow { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}
	@media (max-width: 620px) {
		/* the opening stays two across as well: the words on one side,
		   the film on the other, just smaller */
		.ab-open { gap: 0.5rem; }
		.ab-open-panel { min-height: clamp(17rem, 62vw, 23rem); }
		.ab-open-copy { padding: 0.9rem 0.55rem 0; }
		.ab-h1 { font-size: 1.05rem; line-height: 1.12; }
		.ab-h2--panel { font-size: 0.98rem; }
		.ab-open-panel .ab-lede { display: none; }
		.ab-open-panel .ab-lede--sm {
			display: block;
			font-size: 0.66rem;
			margin-top: 0.3rem;
		}
		.ab-open-panel .ab-acts { margin-top: 0.7rem; gap: 0.35rem; }
		.ab-open-panel .ab-pill { min-height: 1.9rem; padding: 0 0.75rem; font-size: 0.68rem; }
		.ab-open-panel .ab-more { display: none; }
		/* three figures, one row: the long labels wrapped it into two and
		   left "10+" stranded on its own line */
		.ab-glance {
			margin-inline: 0.5rem;
			padding: 0.65rem 0 0.8rem;
		}
		.ab-glance li { padding-inline: 0.15rem; }
		.ab-glance strong { font-size: 0.88rem; }
		.ab-glance span { display: none; }
		.ab-glance .ab-glance-s { display: block; font-size: 0.54rem; white-space: nowrap; }
		/* the poster's play button is sized for a panel, not for a third
		   of a phone; it comes down with everything else */
		.ab-screen :global(.flm__big) { transform: scale(0.52); }
		.ab-screen { margin: 0.7rem 0.55rem 0.55rem; border-width: 4px; }
		.ab-screen-badge { display: none; }

		.ab-pair { gap: 0.5rem; }
		.ab-panel { min-height: clamp(15rem, 54vw, 20rem); }
		.ab-panel-copy { padding: 0.9rem 0.6rem 0; }
		.ab-h3 { font-size: 1.05rem; }
		/* the short line takes over rather than the long one being cut:
		   a clamp ends a sentence on an ellipsis, which reads as broken */
		.ab-panel .ab-line { display: none; }
		.ab-panel .ab-line--sm {
			display: block;
			font-size: 0.7rem;
			margin-top: 0.3rem;
		}
		.ab-panel .ab-acts { margin-top: 0.6rem; gap: 0.4rem; }
		.ab-panel .ab-pill { min-height: 1.9rem; padding: 0 0.75rem; font-size: 0.68rem; }
		.ab-panel .ab-more { display: none; }
		.ab-panel-shot { min-height: 5rem; margin-top: 0.8rem; }
		.ab-vrow { gap: 0.5rem; }
		.ab-val-t { font-size: 0.82rem; margin-top: 0.5rem; }
		.ab-val-card .ab-val-d { display: none; }
		.ab-val-card .ab-val-d--sm { display: block; }
		.ab-val-ic { width: 1.6rem; height: 1.6rem; border-radius: 0.5rem; left: 0.4rem; bottom: 0.4rem; }
		.ab-val-ic :global(svg) { width: 13px; height: 13px; }
		.ab-val-go { font-size: 0.68rem; margin-top: 0.4rem; }
	}
	@media (prefers-reduced-motion: reduce) {
		.ab-pill:hover { transform: none; }
	}

	/* ═══ the mantra, and the figures, on a phone ══════════════════════
	   Kept at the end of the sheet: these override plain-class rules
	   written above them, and a media query carries no extra specificity,
	   so source order is the only thing that settles it.
	   ══════════════════════════════════════════════════════════════════ */
	@media (max-width: 620px) {
		/* the three words are the whole section at this size; the sentence
		   under them was a second paragraph nobody reads on a phone */
		.bd-mantra {
			padding: clamp(2.6rem, 11vw, 4rem) 1rem;
		}
		.bd-mantra-words {
			font-size: clamp(2.9rem, 14vw, 4.2rem);
			font-weight: 900;
			letter-spacing: -0.045em;
			line-height: 0.92;
		}
		.bd-mantra-build {
			text-shadow: 0 0 34px rgba(255, 255, 255, 0.6);
		}
		.bd-mantra-sub { display: none; }

		/* 2019 and 65+ were shoulder to shoulder: the figures come down a
		   step and the columns get their own room */
		.ab-glance { margin-inline: 0.35rem; }
		.ab-glance li { padding-inline: 0.28rem; }
		.ab-glance strong { font-size: 0.8rem; letter-spacing: -0.02em; }
		.ab-glance .ab-glance-s { font-size: 0.5rem; letter-spacing: 0.01em; }
	}
	@media (max-width: 380px) {
		.ab-glance strong { font-size: 0.74rem; }
		.ab-glance .ab-glance-s { font-size: 0.46rem; }
	}

	/* ═══ the numbers band ═════════════════════════════════════════════
	   The same band the home page carries, so both pages count the same
	   way. Lifted here rather than re-invented: two versions of one
	   component drift apart the first time either is touched.
	   ══════════════════════════════════════════════════════════════════ */
	/* ── the numbers band ──────────────────────────────────────────────
	   It spans the page rather than sitting inside the 88rem grid: five
	   figures deserve the width, and the band is what separates the story
	   above it from the proof below. The body's own side padding is given
	   back with a negative margin, which is exact and, unlike 100vw,
	   cannot open a scrollbar of its own. */
	.bd-band {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		max-width: none;
		width: auto;
		margin-inline: calc(-1 * clamp(1rem, 3vw, 2rem));
		margin-block: clamp(1.2rem, 2.6vw, 2rem) clamp(0.9rem, 2vw, 1.4rem);
		border-radius: clamp(1rem, 2vw, 1.6rem);
		padding-inline: clamp(1.2rem, 4vw, 3.4rem);
		padding-block: clamp(1.6rem, 3vw, 2.5rem);
		/* deeper than the rest of the body on purpose: this band is the
		   quiet beat between the story above it and the proof below */
		background:
			radial-gradient(900px 320px at 50% -24%, color-mix(in srgb, var(--bd-accent) 13%, transparent), transparent 70%),
			linear-gradient(180deg, #05070f 0%, #02030a 100%);
		border-color: rgba(155, 216, 255, 0.1);
	}
	/* the heading is a label here, not a headline: the figures are the
	   thing being looked at */
	.bd-band .bd-h {
		font-size: clamp(1.35rem, 2.5vw, 2rem);
		letter-spacing: -0.03em;
		margin: 0;
	}
	.bd-band .bd-p {
		margin: 0.45rem auto 0;
		max-width: 40rem;
		font-size: clamp(0.82rem, 1vw, 0.92rem);
		line-height: 1.55;
	}
	/* the accent falls on one word, which is the only ornament the
	   heading needs */
	.bd-band .bd-h em {
		font-style: normal;
		background: linear-gradient(120deg, #cfeaff 5%, var(--bd-accent) 75%);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}
	.bd-numbers {
		display: grid;
		/* however many figures there are, not always five: with four the
		   fixed five-column grid left an empty column and the row sat
		   off-centre in its own band */
		grid-auto-flow: column;
		grid-auto-columns: minmax(0, 1fr);
		gap: clamp(0.5rem, 1.1vw, 0.85rem);
		list-style: none;
		margin: clamp(1.1rem, 2.4vw, 1.6rem) 0 0;
		padding: 0;
	}
	/* Five cards, each one hairline, icon, figure, label and the shape it
	   made. Nothing is filled, nothing glows: the only movement is the
	   figure counting and the line drawing itself. */
	.bd-number {
		min-width: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		padding: clamp(0.85rem, 1.7vw, 1.15rem) clamp(0.55rem, 1.2vw, 0.9rem)
			clamp(0.6rem, 1.3vw, 0.85rem);
		border-radius: clamp(0.65rem, 1.1vw, 0.85rem);
		border: 1px solid rgba(155, 216, 255, 0.095);
		background: rgba(255, 255, 255, 0.014);
		transition: border-color 0.35s ease, background 0.35s ease,
			transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.bd-number:hover {
		border-color: color-mix(in srgb, var(--bd-accent) 38%, transparent);
		background: rgba(255, 255, 255, 0.035);
		transform: translateY(-2px);
	}
	.bd-number-ic {
		display: grid;
		place-items: center;
		width: 1.85rem;
		height: 1.85rem;
		border-radius: 0.55rem;
		border: 1px solid rgba(155, 216, 255, 0.16);
		background: color-mix(in srgb, var(--bd-accent) 9%, transparent);
		color: #7fc7f0;
		margin-bottom: 0.5rem;
	}
	.bd-number-ic :global(svg) { width: 15px; height: 15px; }

	/* ── the line under each figure ──
	   Drawn rather than faded in: the stroke is dashed to its own length
	   and the dash walked to zero, which is a pen moving across the box
	   rather than a picture appearing. */
	/* named "trend", not "spark": global.css stops anything whose class
	   carries spark/glow/aura from animating on weak hardware — right for
	   a particle emitter, wrong for a line that draws itself once. */
	.bd-trend {
		display: block;
		width: 100%;
		height: clamp(13px, 1.5vw, 17px);
		margin-top: clamp(0.5rem, 1.1vw, 0.75rem);
		overflow: hidden;
	}
	.bd-trend-line {
		fill: none;
		stroke: var(--bd-accent);
		stroke-width: 0.75;
		stroke-linecap: round;
		stroke-linejoin: round;
		opacity: 0.62;
		/* the path measures a shade over 100 user units, and the dash is
		   measured in the same units now, so one dash covers one line */
		stroke-dasharray: 104;
		stroke-dashoffset: 104;

	}

	.bd-band.is-on .bd-trend-line {
		animation: bd-draw 1.5s cubic-bezier(0.3, 0.8, 0.3, 1) forwards;
		animation-delay: calc(0.25s + var(--n) * 0.16s);
	}
	@keyframes bd-draw { to { stroke-dashoffset: 0; } }

	.bd-number-l {
		display: block;
		margin-top: 0.22rem;
		font-size: clamp(0.7rem, 0.82vw, 0.78rem);
		line-height: 1.3;
		color: rgba(245, 245, 247, 0.5);
	}

	@media (prefers-reduced-motion: reduce) {
		.bd-band .bd-trend-line { stroke-dashoffset: 0; }
		.bd-band.is-on .bd-trend-line { animation: none; }
		.bd-number,
		.bd-number:hover { transform: none; transition: none; }
	}
	/* The band stays one row of five on every screen — it is a line of
	   figures, and a line of figures wrapped over two rows is a table.
	   What gives instead is the weight: the icon goes, the label shortens
	   to a single word, and the card loses its frame until only the
	   numbers and their lines are left. */
	.bd-number-s { display: none; }
	@media (max-width: 880px) {
		.bd-numbers { gap: clamp(0.25rem, 1.2vw, 0.6rem); }
		.bd-number { padding: 0.75rem 0.3rem 0.5rem; }
		.bd-number-ic { width: 1.5rem; height: 1.5rem; border-radius: 0.45rem; margin-bottom: 0.35rem; }
		.bd-number-ic :global(svg) { width: 12px; height: 12px; }
		.bd-number strong { font-size: clamp(1.05rem, 3.2vw, 1.6rem); }
		.bd-number-l { font-size: 0.62rem; }
	}
	@media (max-width: 620px) {
		.bd-number {
			padding: 0.55rem 0.15rem 0.4rem;
			border-color: transparent;
			background: none;
		}
		.bd-number-ic { display: none; }
		.bd-number strong { font-size: clamp(0.95rem, 4.4vw, 1.35rem); }
		.bd-number-l { display: none; }
		.bd-number-s {
			display: block;
			margin-top: 0.15rem;
			font-size: clamp(0.54rem, 2.1vw, 0.66rem);
			line-height: 1.2;
			letter-spacing: 0.01em;
			color: rgba(245, 245, 247, 0.5);
		}
		.bd-trend { height: 10px; margin-top: 0.4rem; }
		.bd-band { padding-inline: clamp(0.7rem, 3vw, 1.2rem); }
		.bd-band .bd-h { font-size: clamp(1.15rem, 5vw, 1.5rem); }
		.bd-band .bd-p { font-size: 0.76rem; }
	}

	@media (max-width: 880px) {
		.bd-band { padding-inline: clamp(1.2rem, 5vw, 2rem); }
	}
	.bd-number strong {
		display: block;
		font-size: clamp(1.7rem, 3.1vw, 2.4rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		background: linear-gradient(135deg, #9bd8ff, var(--bd-accent));
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}


	/* ═══ two lines under every promise ════════════════════════════════
	   Which line reads in two depends on how wide the card is, and the
	   card width does not fall monotonically with the viewport: four
	   columns narrow to about 185px by 1024, then the layout drops to two
	   columns at 860 and the card jumps back up to 370. So the long line
	   sets in two above 1100 and again between 860 and 620, and the short
	   line covers the two narrow stretches in between and below. Measured
	   across ten widths rather than assumed from three.
	   Kept at the end of the sheet, because a media query carries no extra
	   specificity and only source order settles it.
	   ══════════════════════════════════════════════════════════════════ */
	.ab-vals-sub--sm { display: none; }
	/* The card width does not fall with the viewport: four columns narrow
	   to about 185px by 1024, the grid drops to two at 860 and the card
	   jumps back to 400, then narrows again to 165 by 360. So the short
	   line covers the two narrow stretches and the long line the two wide
	   ones. Measured across ten widths rather than assumed from three. */
	@media (max-width: 1100px) and (min-width: 861px) {
		.ab-val-card .ab-val-d { display: none; }
		.ab-val-card .ab-val-d--sm { display: block; }
	}
	@media (max-width: 620px) {
		/* the supporting line ran to three at this width */
		.ab-vals .ab-vals-sub { display: none; }
		.ab-vals .ab-vals-sub--sm { display: block; }
	}
	/* the type comes down only once the card really is small; at 620 it is
	   still 290px wide and the smaller size turned two lines into one */
	@media (max-width: 520px) {
		.ab-val-card .ab-val-d--sm { font-size: 0.68rem; line-height: 1.4; }
		.ab-val-t { font-size: 0.82rem; margin-top: 0.5rem; }
	}

	/* ═══ the road, as a rail ══════════════════════════════════════════
	   The old version was a column of cards with a node beside each: a
	   timeline you scroll down, which is the one direction a timeline
	   does not run. This is one line with a stop on it for each year, read
	   left to right, scrolling sideways when there is not room. The year
	   is the largest thing on each stop, because the year is the point.
	   ══════════════════════════════════════════════════════════════════ */
	.bd-rail-wrap {
		max-width: 92rem;
		margin: clamp(1.6rem, 3.6vw, 2.6rem) auto 0;
		padding-inline: clamp(1rem, 3vw, 2rem);
		overflow-x: auto;
		overscroll-behavior-x: contain;
		/* no snapping: the rail drifts by a fraction of a pixel a frame,
		   and a proximity snap pulls every one of those steps straight
		   back to the nearest stop, so it never moves at all */
		scrollbar-width: none;
		-webkit-mask-image: linear-gradient(90deg, transparent, #000 3%, #000 97%, transparent);
		mask-image: linear-gradient(90deg, transparent, #000 3%, #000 97%, transparent);
	}
	.bd-rail-wrap::-webkit-scrollbar { display: none; }
	.bd-rail {
		position: relative;
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: minmax(13.5rem, 1fr);
		gap: clamp(1rem, 2.4vw, 2rem);
		list-style: none;
		margin: 0;
		padding: clamp(1.6rem, 3vw, 2.4rem) 0 clamp(1rem, 2vw, 1.6rem);
		min-width: min-content;
	}
	/* the line itself, running through every node */
	.bd-rail::before {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		top: calc(clamp(1.6rem, 3vw, 2.4rem) + 0.5rem);
		height: 2px;
		border-radius: 999px;
		background: linear-gradient(
			90deg,
			transparent,
			color-mix(in srgb, var(--bd-accent) 55%, transparent) 6%,
			color-mix(in srgb, var(--bd-accent) 55%, transparent) 94%,
			transparent
		);
	}
	.bd-rail-stop {
		position: relative;
		padding-right: clamp(0.4rem, 1vw, 0.8rem);
	}
	.bd-rail-node {
		display: grid;
		place-items: center;
		width: 1.05rem;
		height: 1.05rem;
		border-radius: 50%;
		background: var(--bd-bg, #070910);
		border: 2px solid color-mix(in srgb, var(--bd-accent) 70%, transparent);
		margin-bottom: clamp(0.9rem, 2vw, 1.4rem);
	}
	:global(html:not(.dark)) .bdbody .bd-rail-node { background: #eef1f8; }
	.bd-rail-node i {
		width: 0.36rem;
		height: 0.36rem;
		border-radius: 50%;
		background: var(--bd-accent);
		transition: transform 0.3s ease;
	}
	.bd-rail-stop:hover .bd-rail-node i { transform: scale(1.7); }
	.bd-rail-year {
		display: block;
		font-size: clamp(1.7rem, 3.2vw, 2.6rem);
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 1;
		background: linear-gradient(135deg, #9bd8ff, var(--bd-accent));
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}
	:global(html:not(.dark)) .bdbody .bd-rail-year {
		background: linear-gradient(135deg, #1e40af, var(--bd-accent));
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}
	.bd-rail-t {
		margin: 0.5rem 0 0;
		font-size: clamp(0.95rem, 1.25vw, 1.08rem);
		font-weight: 700;
		letter-spacing: -0.015em;
		line-height: 1.25;
	}
	.bd-rail-d {
		margin: 0.35rem 0 0;
		font-size: 0.84rem;
		line-height: 1.5;
		color: var(--bd-muted);
	}
	@media (max-width: 620px) {
		.bd-rail { grid-auto-columns: minmax(11rem, 1fr); gap: 0.9rem; }
		.bd-rail-year { font-size: 1.5rem; }
		.bd-rail-t { font-size: 0.86rem; }
		.bd-rail-d { font-size: 0.72rem; }
	}
	@media (prefers-reduced-motion: reduce) {
		.bd-rail-node i { transition: none; }
	}

	/* ═══ what we believe ══════════════════════════════════════════════
	   Rules, set as rules. Two grids of four cards already sit above this
	   on the page, so a third would have been the same furniture a third
	   time. A numeral, the rule, the reason, and a hairline between each.
	   ══════════════════════════════════════════════════════════════════ */
	.bd-creed {
		max-width: 68rem;
		margin: clamp(2.5rem, 6vw, 4.5rem) auto;
		padding-inline: clamp(1rem, 3vw, 2rem);
	}
	.bd-creed-head { max-width: 44rem; }
	.bd-creed-h {
		margin: 0.6rem 0 0;
		font-size: clamp(1.9rem, 4.4vw, 3.2rem);
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 1.02;
	}
	.bd-creed-p {
		margin: clamp(0.8rem, 1.8vw, 1.1rem) 0 0;
		font-size: clamp(0.95rem, 1.2vw, 1.05rem);
		line-height: 1.6;
		color: var(--bd-muted);
	}
	.bd-creed-list {
		list-style: none;
		margin: clamp(1.8rem, 4vw, 3rem) 0 0;
		padding: 0;
		border-top: 1px solid var(--bd-glass-border);
	}
	.bd-creed-rule {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		align-items: start;
		gap: clamp(1rem, 2.6vw, 2.2rem);
		padding: clamp(1.1rem, 2.6vw, 1.8rem) clamp(0.6rem, 1.6vw, 1.2rem);
		border-bottom: 1px solid var(--bd-glass-border);
		transition: background 0.3s ease;
	}
	.bd-creed-rule:hover { background: color-mix(in srgb, var(--bd-accent) 5%, transparent); }
	.bd-creed-n {
		font-size: clamp(1.5rem, 3vw, 2.3rem);
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 1;
		color: color-mix(in srgb, var(--bd-ink) 16%, transparent);
		font-variant-numeric: tabular-nums;
	}
	/* one rule runs in the accent, so the list has a beat in it */
	.bd-creed-rule.is-loud .bd-creed-n { color: var(--bd-accent); }
	.bd-creed-t {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		margin: 0;
		font-size: clamp(1.05rem, 1.7vw, 1.4rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.2;
	}
	.bd-creed-t :global(svg) { color: var(--bd-accent); flex: none; }
	.bd-creed-d {
		margin: 0.4rem 0 0;
		max-width: 52ch;
		font-size: clamp(0.88rem, 1.1vw, 0.98rem);
		line-height: 1.6;
		color: var(--bd-muted);
	}
	@media (max-width: 620px) {
		.bd-creed-rule {
			gap: 0.7rem;
			padding: 0.9rem 0.2rem;
		}
		.bd-creed-n { font-size: 1.25rem; }
		.bd-creed-t { font-size: 0.95rem; gap: 0.4rem; }
		.bd-creed-d { font-size: 0.8rem; }
	}
	@media (prefers-reduced-motion: reduce) {
		.bd-creed-rule { transition: none; }
	}

	/* ═══ inside Swizel ════════════════════════════════════════════════
	   Both cards carried a dashed box that said "video placeholder" on a
	   live page. They carry the films they were standing in for: the
	   studio's own welcome, and the one about students walking in.
	   ══════════════════════════════════════════════════════════════════ */
	.bd-cult-film {
		margin: 0;
		width: 100%;
		border-radius: clamp(0.8rem, 1.4vw, 1.15rem);
		overflow: hidden;
	}
	.bd-tile--row .bd-cult-film { flex: 1 1 46%; min-width: 0; }
	.bd-cult-film :global(.flm) { border-radius: inherit; }
	.bd-cult-acts {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.8rem 1.2rem;
		margin-top: clamp(0.9rem, 2vw, 1.3rem);
	}
	.bd-cult-pill { font-size: 0.9rem; }

	/* ── the hiring bar, finer ──
	   It was a full-height tile with a raised pill in it, taller than the
	   one line it carries. One rule, one line, one address. */
	.bd-join {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.9rem 1.6rem;
		max-width: 88rem;
		margin: clamp(1.4rem, 3vw, 2.2rem) auto;
		padding: clamp(0.9rem, 2vw, 1.15rem) clamp(1.1rem, 2.6vw, 2rem);
		border-radius: 999px;
		border: 1px solid var(--bd-glass-border);
		background: color-mix(in srgb, var(--bd-ink) 3%, transparent);
	}
	.bd-join-copy {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 0.2rem 0.7rem;
		min-width: 0;
	}
	.bd-join-copy strong {
		font-size: clamp(0.98rem, 1.3vw, 1.12rem);
		font-weight: 700;
		letter-spacing: -0.015em;
	}
	.bd-join-copy span {
		font-size: 0.88rem;
		color: var(--bd-muted);
	}
	.bd-join-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		flex: none;
		padding: 0.45rem 1.05rem;
		border-radius: 999px;
		border: 1px solid color-mix(in srgb, var(--bd-accent) 45%, transparent);
		background: color-mix(in srgb, var(--bd-accent) 10%, transparent);
		color: var(--bd-accent);
		font-size: 0.9rem;
		font-weight: 700;
		white-space: nowrap;
		transition: background 0.25s ease, border-color 0.25s ease;
	}
	.bd-join-btn:hover {
		background: color-mix(in srgb, var(--bd-accent) 18%, transparent);
		border-color: var(--bd-accent);
	}
	@media (max-width: 620px) {
		.bd-join {
			border-radius: 1.1rem;
			padding: 0.85rem 1rem;
		}
		.bd-join-copy span { display: none; }
		.bd-join-btn { font-size: 0.82rem; padding: 0.4rem 0.85rem; }
	}

	/* ═══ brought across from the home page ════════════════════════════
	   The sectors rail, the client marks and the closing tile were all
	   improved on the home page and never came over here, so /about was
	   still running the first version of each. Lifted rather than
	   re-written, and kept at the end of the sheet where source order
	   settles it against the older rules above.
	   ══════════════════════════════════════════════════════════════════ */
	.bd-marquee--b { margin-top: clamp(0.5rem, 1.2vw, 0.9rem); }
	.bd-marquee-track--back {
		animation-duration: 52s;
		animation-direction: reverse;
	}
	.bd-sector {
		flex-shrink: 0;
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		margin-right: clamp(0.7rem, 1.6vw, 1.15rem);
		padding: 0.42em 0.95em;
		border-radius: 999px;
		border: 1px solid color-mix(in srgb, var(--bd-ink) 11%, transparent);
		background: color-mix(in srgb, var(--bd-ink) 3%, transparent);
		font-size: clamp(1.05rem, 2vw, 1.45rem);
		font-weight: 700;
		letter-spacing: -0.015em;
		color: color-mix(in srgb, var(--bd-ink) 46%, transparent);
		transition: color 0.3s ease, border-color 0.3s ease, background 0.3s ease,
			transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
		cursor: default;
	}
	.bd-sector--sm { font-size: clamp(0.88rem, 1.5vw, 1.1rem); }
	.bd-sector-dot {
		width: 0.42em;
		height: 0.42em;
		border-radius: 50%;
		background: currentColor;
		opacity: 0.5;
		flex: none;
	}
	/* a few run in the accent so the rail is never one flat grey line */
	.bd-sector.is-hot {
		color: var(--bd-accent);
		border-color: color-mix(in srgb, var(--bd-accent) 34%, transparent);
		background: color-mix(in srgb, var(--bd-accent) 8%, transparent);
	}
	.bd-sector.is-hot .bd-sector-dot { opacity: 1; }
	.bd-sector:hover {
		color: var(--bd-accent);
		border-color: color-mix(in srgb, var(--bd-accent) 55%, transparent);
		background: color-mix(in srgb, var(--bd-accent) 12%, transparent);
		transform: translateY(-3px);
	}


	/* Our clients' marks, in their own colours. Almost every one of them
	   is dark artwork, so on the boardroom's dark body they need a light
	   card to sit on — flattening them to white would have been easier and
	   would have thrown away the thing that makes a logo a logo. */
	.bd-logo {
		flex-shrink: 0;
		display: grid;
		place-items: center;
		margin-right: clamp(1.1rem, 2.4vw, 2rem);
		padding: 0.7rem clamp(0.9rem, 1.8vw, 1.4rem);
		border-radius: 0.9rem;
		background: rgba(255, 255, 255, 0.94);
		border: 1px solid rgba(255, 255, 255, 0.5);
		box-shadow: 0 12px 30px -18px rgba(0, 0, 0, 0.6);
		transition: transform 0.3s ease, box-shadow 0.3s ease, background 0.3s ease;
	}
	:global(html:not(.dark)) .bdbody .bd-logo {
		background: #fff;
		border-color: color-mix(in srgb, var(--bd-ink) 8%, transparent);
		box-shadow: 0 14px 30px -22px rgba(20, 22, 40, 0.4);
	}
	.bd-logo img {
		height: 32px;
		width: auto;
		max-width: 132px;
		object-fit: contain;
		opacity: 0.88;
		transition: opacity 0.3s ease, transform 0.3s ease;
	}
	.bd-logo:hover {
		background: #fff;
		transform: translateY(-3px);
		box-shadow: 0 20px 44px -20px rgba(0, 0, 0, 0.55);
	}
	.bd-logo:hover img {
		opacity: 1;
		transform: scale(1.04);
	}

	/* ── Final CTA ── */

	/* ── the closing tile ── */
	.bd-tile--cta {
		position: relative;
		overflow: hidden;
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
		align-items: stretch;
		gap: 0;
		padding: 0;
		text-align: left;
		background:
			radial-gradient(760px 420px at 6% 110%, color-mix(in srgb, var(--bd-accent) 26%, transparent), transparent 70%),
			linear-gradient(180deg, rgba(14, 19, 36, 0.96), rgba(4, 6, 13, 0.98));
		color: #f5f5f7;
		border-color: color-mix(in srgb, var(--bd-accent) 26%, rgba(255, 255, 255, 0.1));
	}
	.bd-cta-copy {
		padding: clamp(2.2rem, 5vw, 4.2rem) clamp(1.4rem, 3.4vw, 3.4rem);
		align-self: center;
		/* a grid item's automatic minimum is its content, and a phone
		   number set nowrap is wide content: without this the column grows
		   past the tile and the tile quietly clips it */
		min-width: 0;
	}
	.bd-cta-kick {
		display: inline-flex;
		align-items: center;
		gap: 0.85rem;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.26em;
		text-transform: uppercase;
		color: rgba(245, 245, 247, 0.6);
	}
	.bd-cta-kick i {
		width: clamp(1.6rem, 3vw, 2.6rem);
		height: 2px;
		border-radius: 999px;
		background: var(--bd-accent);
	}
	.bd-display--cta {
		margin: clamp(0.9rem, 2vw, 1.3rem) 0 0;
		font-size: clamp(2.1rem, 4.4vw, 3.6rem);
		line-height: 1.02;
		letter-spacing: -0.04em;
	}
	.bd-display--cta em {
		display: block;
		font-style: normal;
		font-weight: 800;
		background: linear-gradient(100deg, #e9f6ff 10%, var(--bd-accent) 85%);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}
	.bd-tile--cta .bd-sub {
		margin: clamp(0.9rem, 2vw, 1.25rem) 0 0;
		max-width: 27rem;
		margin-inline: 0;
	}
	.bd-cta-act {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: clamp(1rem, 2.4vw, 2rem);
		margin-top: clamp(1.5rem, 3.2vw, 2.4rem);
	}
	/* the one thing on this tile we want pressed: it breathes until it is */
	.bd-cta-go {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		min-height: 3.35rem;
		padding: 0 1.8rem;
		border-radius: 999px;
		background: linear-gradient(120deg, var(--bd-accent), #3b7dfd);
		color: #04101a;
		font-size: 1rem;
		font-weight: 700;
		white-space: nowrap;
		transition: transform 0.25s ease, filter 0.25s ease;
	}
	.bd-cta-go::after {
		content: '';
		position: absolute;
		inset: -3px;
		border-radius: inherit;
		border: 2px solid var(--bd-accent);
		opacity: 0;
		pointer-events: none;
		animation: bd-cta-ring 2.6s cubic-bezier(0.22, 1, 0.36, 1) infinite;
	}
	@keyframes bd-cta-ring {
		0%   { transform: scale(1); opacity: 0.55; }
		70%  { transform: scale(1.16); opacity: 0; }
		100% { transform: scale(1.16); opacity: 0; }
	}
	.bd-cta-go:hover { transform: translateY(-2px); filter: brightness(1.06); }
	.bd-cta-go-s { display: none; }
	.bd-cta-go:hover::after { animation-play-state: paused; opacity: 0; }

	/* the photograph, with the promise stamped in its corner */
	.bd-cta-shot {
		position: relative;
		margin: 0;
		min-height: clamp(18rem, 30vw, 27rem);
	}
	/* The picture is dissolved into the tile rather than laid on top of
	   it: a dark veil over the photograph left a visible seam wherever the
	   veil's black and the tile's own gradient disagreed, which they do
	   everywhere except one row of pixels. Masking the image instead means
	   there is nothing to match — the photograph simply stops. */
	.bd-cta-shot img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 42% 50%;
		mask-image: linear-gradient(
			90deg,
			transparent 0%,
			rgba(0, 0, 0, 0.28) 14%,
			rgba(0, 0, 0, 0.82) 38%,
			#000 62%
		);
		-webkit-mask-image: linear-gradient(
			90deg,
			transparent 0%,
			rgba(0, 0, 0, 0.28) 14%,
			rgba(0, 0, 0, 0.82) 38%,
			#000 62%
		);
	}
	/* just enough shade at the top right to hold the stamp */
	.bd-cta-shot::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(200deg, rgba(4, 6, 13, 0.5), transparent 42%);
	}
	.bd-cta-stamp {
		position: absolute;
		top: clamp(1.1rem, 2.6vw, 2.2rem);
		right: clamp(1.1rem, 2.6vw, 2.2rem);
		z-index: 1;
		text-align: right;
		font-size: 0.66rem;
		font-weight: 600;
		letter-spacing: 0.24em;
		text-transform: uppercase;
		line-height: 1.9;
		color: rgba(245, 245, 247, 0.62);
	}
	.bd-cta-stamp strong { display: block; color: #fff; font-weight: 700; }
	.bd-cta-stamp::after {
		content: '';
		display: block;
		width: 2.4rem;
		height: 1px;
		margin: 0.6rem 0 0 auto;
		background: rgba(255, 255, 255, 0.4);
	}

	@media (max-width: 860px) {
		.bd-tile--cta { grid-template-columns: 1fr; }
		/* on a phone the desk goes on top, where a photograph belongs */
		.bd-cta-shot { order: -1; min-height: clamp(12rem, 46vw, 17rem); }
		/* stacked, the photograph dissolves downward instead of sideways */
		.bd-cta-shot img {
			mask-image: linear-gradient(180deg, #000 34%, rgba(0, 0, 0, 0.5) 74%, transparent 100%);
			-webkit-mask-image: linear-gradient(180deg, #000 34%, rgba(0, 0, 0, 0.5) 74%, transparent 100%);
		}
		.bd-cta-shot::after { background: linear-gradient(180deg, rgba(4, 6, 13, 0.4), transparent 45%); }
	}
	@media (prefers-reduced-motion: reduce) {
		.bd-cta-go::after { animation: none; opacity: 0; }
	}
	.bd-tile--cta .bd-sub {
		color: rgba(245, 245, 247, 0.62);
	}
	.bd-links--center {
		justify-content: center;
	}
	/* the phone number — impossible to miss */
	.bd-call {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.15rem;
	}
	.bd-call-hint {
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: rgba(245, 245, 247, 0.5);
	}
	.bd-call-num {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		font-size: clamp(1.15rem, 2.2vw, 1.6rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		background: linear-gradient(135deg, #ffffff, #9bd8ff 60%, var(--bd-accent));
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
		transition: transform 0.3s ease, filter 0.3s ease;
	}
	.bd-call-num :global(svg) {
		color: var(--bd-accent);
		-webkit-text-fill-color: initial;
	}
	.bd-call:hover .bd-call-num {
		transform: scale(1.03);
		filter: drop-shadow(0 10px 30px color-mix(in srgb, var(--bd-accent) 55%, transparent));
	}


	/* ═══ the closing tile on a phone ═════════════════════════════════
	   Kept at the end of the sheet on purpose: these override plain-class
	   rules written further down, and a media query carries no extra
	   specificity — only source order was ever going to settle it.
	   ══════════════════════════════════════════════════════════════════ */
