---
// Service detail · Campus world — the discipline as a department page in
// the school. Same data as every other view, tinted by the discipline's
// colour. The animated ServiceVisual is projected on the department's
// whiteboard. Root carries `cbody` (campus engine: .cp-rev) and `csd`
// (motion engine: tilt / glare / magnetic / .fa-journey draw).
import { Icon } from 'astro-icon/components';
import ServiceVisual from './ServiceVisual.astro';
import type { Discipline } from '../../data/disciplines';

interface Props {
	discipline: Discipline;
	others: Discipline[];
}
const { discipline: d, others } = Astro.props;

const clarifierChips = d.clarifier
	.replace(/\.$/, '')
	.split(/,\s*|\s+and\s+/)
	.map((c) => c.trim())
	.filter(Boolean);

const incCols = d.included.length % 4 === 0 ? 4 : 3;
---

<div class="csd cbody view-body view-body-campus" style={`--c:${d.color}`}>
	<!-- ── A · the department door ─────────────────────────── -->
	<section class="cd-sec" data-cursor={d.cursor}>
		<div class="cd-wrap cd-open">
			<div class="cd-copy cp-rev">
				<nav class="cd-crumb" aria-label="Breadcrumb">
					<a href="/services">All departments</a>
					<span>→</span>
					<span class="cd-crumb-here">{d.title}</span>
				</nav>
				<span class="cd-badge">🚪 Dept. of {d.title} · SWZ {Number(d.n)}01</span>
				<h2 class="cd-h cd-h--xl">{d.tagline.replace(/\.$/, '')}<em>.</em></h2>
				<p class="cd-p">{d.heroDesc}</p>
				<span class="cd-chips">
					{clarifierChips.map((c) => <i>{c}</i>)}
				</span>
				<div class="cd-row">
					<a href="/contact" class="cd-cta fa-cta">
						Hire this department
						<Icon width={16} name="mdi:arrow-right" />
					</a>
					<a href="#cd-included" class="cd-link">
						What they teach & do
						<Icon width={15} name="mdi:chevron-down" />
					</a>
				</div>
			</div>

			<!-- the department whiteboard, with the living visual projected -->
			<div class="cd-board cp-rev" data-fa-tilt="3">
				<span class="cd-board-date">Dept. of {d.title}</span>
				<p class="cd-board-title">on the board today <span class="cd-board-swish" aria-hidden="true"></span></p>
				<div class="cd-viz">
					<ServiceVisual d={d} />
				</div>
				<span class="cd-sticky" style="--r:2.5deg">
					<Icon width={12} name="mdi:flash" /> {d.outcome}
				</span>
			</div>
		</div>
	</section>

	<!-- ── B · the modules (what's included) ───────────────── -->
	<section class="cd-sec" id="cd-included" data-cursor="book">
		<div class="cd-wrap">
			<div class="cd-head cp-rev">
				<span class="cd-kick">📚 Course modules</span>
				<h2 class="cd-h">Everything this department <em>covers.</em></h2>
			</div>
			<div class="cd-inc" style={`--inc-cols:${incCols}`}>
				{
					d.included.map((s, i) => (
						<article class="cd-inc-card cp-rev" style={`--i:${i % incCols}`} data-fa-tilt="7">
							<span class="cd-glare" aria-hidden="true" />
							<h3>{s.title}</h3>
							<p>{s.desc}</p>
							<span class="cd-inc-items">
								{s.items.map((it) => (
									<i>
										<Icon width={12} name="mdi:check" />
										{it}
									</i>
								))}
							</span>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<!-- ── C · the lesson plan (approach) ──────────────────── -->
	<section class="cd-sec" data-cursor="pen">
		<div class="cd-wrap">
			<div class="cd-head cp-rev">
				<span class="cd-kick">🗓️ The lesson plan</span>
				<h2 class="cd-h">How this department <em>works.</em></h2>
			</div>
			<div class="cd-steps fa-journey">
				<span class="cd-spine" aria-hidden="true"></span>
				{
					d.approach.map((p) => (
						<article class="cd-step cp-rev">
							<span class="cd-step-node" aria-hidden="true" />
							<span class="cd-step-n">{p.n}</span>
							<div>
								<h3 class="cd-step-t">{p.title}</h3>
								<p class="cd-step-d">{p.desc}</p>
							</div>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<!-- ── D · enrolment options (ways) ────────────────────── -->
	<section class="cd-sec" data-cursor="layers">
		<div class="cd-wrap">
			<div class="cd-head cp-rev">
				<span class="cd-kick">🗂️ Enrolment options</span>
				<h2 class="cd-h">Ways to work <em>with us.</em></h2>
			</div>
			<div class="cd-ways">
				{
					d.ways.map((w, i) => (
						<article class="cd-way cp-rev" style={`--i:${i}`} data-fa-tilt="8">
							<span class="cd-glare" aria-hidden="true" />
							<span class="cd-way-ic"><Icon width={20} name={w.icon} /></span>
							<h3>{w.title}</h3>
							<p>{w.desc}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<!-- ── E · homework we've handed in + the grade ────────── -->
	<section class="cd-sec" data-cursor="repo">
		<div class="cd-wrap">
			<div class="cd-head cp-rev">
				<span class="cd-kick">✅ Homework, handed in</span>
				<h2 class="cd-h">Built by this <em>department.</em></h2>
			</div>
			<div class="cd-proof">
				{
					d.projects.map((p, i) => (
						<figure class="cd-proj cp-rev" style={`--i:${i}`} data-fa-tilt="6">
							<span class="cd-proj-frame">
								{p.img ? (
									<img src={p.img} alt={p.name} loading="lazy" />
								) : (
									<span class="cd-proj-ph"><Icon width={22} name="mdi:image-outline" /></span>
								)}
								<span class="cd-proj-tick"><Icon width={13} name="mdi:check-bold" /> graded</span>
							</span>
							<figcaption>
								<strong>{p.name}</strong>
								<em>{p.sector}</em>
							</figcaption>
						</figure>
					))
				}
			</div>
			<figure class="cd-grade cp-rev" data-cursor="quote">
				<span class="cd-grade-mark" aria-hidden="true">A+</span>
				<blockquote>{d.review.quote.replace(/^“|”$/g, '')}</blockquote>
				<figcaption>
					<img src={d.review.img} alt={d.review.name} loading="lazy" width="38" height="38" />
					<span>— {d.review.name}, <em>{d.review.role}</em></span>
				</figcaption>
			</figure>
		</div>
	</section>

	<!-- ── F · questions after class (FAQ) ─────────────────── -->
	{
		d.faqs && d.faqs.length > 0 && (
			<section class="cd-sec" data-cursor="quote">
				<div class="cd-wrap cd-wrap--narrow">
					<div class="cd-head cp-rev">
						<span class="cd-kick">🙋 Questions after class</span>
						<h2 class="cd-h">Hands <em>up.</em></h2>
					</div>
					<div class="cd-faq cp-rev">
						{d.faqs.map((f, i) => (
							<details class="cd-faq-item" open={i === 0}>
								<summary>
									<span>{f.q}</span>
									<Icon class="cd-faq-caret" width={20} name="mdi:chevron-down" />
								</summary>
								<p>{f.a}</p>
							</details>
						))}
					</div>
				</div>
			</section>
		)
	}

	<!-- ── G · other departments + the bell ────────────────── -->
	<section class="cd-sec cd-sec--last" data-cursor="phone">
		<div class="cd-wrap">
			<div class="cd-others cp-rev">
				<span class="cd-others-h">🏫 Other departments down the hall</span>
				<div class="cd-others-row">
					{
						others.map((o) => (
							<a href={`/services/${o.slug}`} class="cd-other" style={`--oc:${o.color}`} data-cursor={o.cursor}>
								<Icon width={15} name={o.icon} />
								{o.title}
							</a>
						))
					}
				</div>
			</div>
			<div class="cd-ctabox cp-rev">
				<span class="cd-badge">🔔 The bell rang</span>
				<h2 class="cd-h cd-h--cta">Bring your project to <em>this department.</em></h2>
				<p class="cd-p cd-p--center">
					Tell us what you're building. A project manager reads every
					message — reply within one business day.
				</p>
				<div class="cd-row cd-row--center">
					<a href="/contact" class="cd-cta fa-cta">
						Talk to a project manager
						<Icon width={17} name="mdi:arrow-right" />
					</a>
					<a href="/portfolio" class="cd-link">
						See the homework
						<Icon width={15} name="mdi:arrow-right" />
					</a>
				</div>
			</div>
		</div>
	</section>
</div>

<style>
	/* ── Campus department page — school dress, tinted by discipline. ── */
	.csd {
		--cp-ink: #fdf6ea;
		--cp-muted: rgba(253, 246, 234, 0.62);
		--cp-faint: rgba(253, 246, 234, 0.4);
		--cp-acc: var(--c, #f59e0b);
		--cp-line: rgba(255, 255, 255, 0.09);
		--cp-card: rgba(255, 255, 255, 0.035);
		--cp-marker: 'Bradley Hand', 'Segoe Print', 'Comic Sans MS', cursive;
		/* the ServiceVisual reads these (same contract as the other worlds) */
		--bd-ink: #2b2115;
		--bd-muted: rgba(43, 33, 21, 0.66);
		--bd-glass: linear-gradient(160deg, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0.72) 55%);
		--bd-glass-border: rgba(43, 33, 21, 0.14);
		--bd-shadow: 0 18px 40px -20px rgba(43, 33, 21, 0.35);
		font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
		position: relative;
		isolation: isolate;
		overflow: hidden;
		background:
			radial-gradient(1000px 540px at 82% -6%, color-mix(in srgb, var(--c) 13%, transparent), transparent 62%),
			radial-gradient(820px 480px at 6% 44%, rgba(251, 113, 133, 0.06), transparent 60%),
			linear-gradient(180deg, #120c04 0%, #160f08 50%, #0e0903 100%);
		color: var(--cp-ink);
		padding: clamp(2rem, 4vw, 3rem) clamp(1rem, 3vw, 2rem) clamp(2.5rem, 5vw, 4rem);
		transition: background 0.4s ease, color 0.4s ease;
	}
	:global(html:not(.dark)) .csd {
		--cp-ink: #2b1c08;
		--cp-muted: rgba(43, 28, 8, 0.68);
		--cp-faint: rgba(43, 28, 8, 0.46);
		--cp-line: rgba(43, 28, 8, 0.1);
		--cp-card: rgba(43, 28, 8, 0.045);
		background:
			radial-gradient(1000px 540px at 82% -6%, color-mix(in srgb, var(--c) 10%, transparent), transparent 62%),
			linear-gradient(180deg, #fdf4e3 0%, #faecd4 55%, #fdf4e3 100%);
	}

	.cd-sec { padding-block: clamp(2rem, 4.5vw, 3.5rem); }
	.cd-sec--last { padding-bottom: clamp(1.5rem, 3vw, 2.5rem); }
	.cd-wrap { max-width: 76rem; margin: 0 auto; }
	.cd-wrap--narrow { max-width: 52rem; }

	.cd-crumb {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-family: ui-monospace, monospace;
		font-size: 0.78rem;
		font-weight: 700;
		color: var(--cp-faint);
		margin-bottom: 1rem;
	}
	.cd-crumb a { color: var(--cp-faint); transition: color 0.2s ease; }
	.cd-crumb a:hover { color: var(--c); }
	.cd-crumb-here { color: var(--c); }
	.cd-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-family: ui-monospace, monospace;
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--c);
		border: 1px solid color-mix(in srgb, var(--c) 40%, transparent);
		background: color-mix(in srgb, var(--c) 9%, transparent);
		padding: 0.4rem 0.9rem;
		border-radius: 9999px;
		margin-bottom: 1.1rem;
	}
	.cd-kick {
		display: block;
		font-family: ui-monospace, monospace;
		font-size: 0.74rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--c);
		margin-bottom: 0.6rem;
	}
	.cd-h {
		font-size: clamp(1.9rem, 4vw, 3rem);
		font-weight: 850;
		letter-spacing: -0.02em;
		line-height: 1.05;
		margin: 0 0 0.9rem;
	}
	.cd-h--xl { font-size: clamp(2.2rem, 5vw, 3.8rem); line-height: 1; }
	.cd-h--cta { font-size: clamp(1.9rem, 4.4vw, 3.2rem); }
	.cd-h em {
		font-style: normal;
		background: linear-gradient(95deg, var(--c), color-mix(in srgb, var(--c) 45%, #fb7185));
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}
	.cd-p {
		font-size: clamp(0.98rem, 1.5vw, 1.1rem);
		line-height: 1.7;
		color: var(--cp-muted);
		max-width: 32rem;
		margin: 0 0 1.2rem;
	}
	.cd-p--center { text-align: center; margin-inline: auto; max-width: 36rem; }
	.cd-head { text-align: center; margin-bottom: clamp(1.5rem, 3vw, 2.25rem); }
	.cd-link {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font-weight: 800;
		font-size: 0.92rem;
		color: var(--c);
		border-bottom: 2px solid color-mix(in srgb, var(--c) 45%, transparent);
		padding-bottom: 0.15rem;
		transition: border-color 0.25s ease, gap 0.25s ease;
	}
	.cd-link:hover { gap: 0.7rem; border-color: var(--c); }
	.cd-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.9rem 1.7rem;
		border-radius: 9999px;
		font-weight: 800;
		font-size: 0.92rem;
		color: #fff;
		background: linear-gradient(95deg, var(--c), color-mix(in srgb, var(--c) 55%, #f59e0b));
		box-shadow: 0 18px 44px -16px color-mix(in srgb, var(--c) 75%, transparent);
		transition: box-shadow 0.25s ease, filter 0.25s ease;
		will-change: transform;
	}
	.cd-cta:hover { filter: brightness(1.07); }
	.cd-row { display: flex; align-items: center; gap: 1.2rem; flex-wrap: wrap; }
	.cd-row--center { justify-content: center; }

	.cd-glare {
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background: radial-gradient(320px 200px at var(--gx, 50%) var(--gy, 20%), color-mix(in srgb, var(--c) 12%, transparent), transparent 70%);
		opacity: 0;
		transition: opacity 0.3s ease;
		pointer-events: none;
	}
	[data-fa-tilt]:hover .cd-glare { opacity: 1; }

	/* ── A · the door ── */
	.cd-open {
		display: grid;
		gap: clamp(1.75rem, 4vw, 3.5rem);
		align-items: center;
	}
	@media (min-width: 960px) {
		.cd-open { grid-template-columns: 1.02fr 0.98fr; }
	}
	.cd-chips { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-bottom: 1.4rem; }
	.cd-chips i {
		font-style: normal;
		font-size: 0.76rem;
		font-weight: 700;
		padding: 0.32rem 0.75rem;
		border-radius: 9999px;
		border: 1px solid color-mix(in srgb, var(--c) 40%, transparent);
		background: color-mix(in srgb, var(--c) 8%, transparent);
		color: var(--cp-ink);
	}

	/* the department whiteboard */
	.cd-board {
		position: relative;
		background: #fdfdfb;
		border-radius: 0.9rem;
		border: 10px solid #e7e2d8;
		box-shadow: 0 34px 80px -30px rgba(0, 0, 0, 0.55);
		padding: 1.2rem 1.2rem 1.5rem;
		color: #44403c;
		transform: rotate(0.8deg);
	}
	@media (max-width: 959px) { .cd-board { transform: none; margin-top: 1rem; } }
	.cd-board-date {
		position: absolute;
		top: 0.8rem;
		right: 1.1rem;
		font-family: var(--cp-marker);
		font-size: 0.88rem;
		color: #78716c;
	}
	.cd-board-title {
		font-family: var(--cp-marker);
		font-size: clamp(1.1rem, 2.2vw, 1.4rem);
		font-weight: 700;
		color: #1c1917;
		margin: 0 0 0.8rem;
		position: relative;
		display: inline-block;
	}
	.cd-board-swish {
		position: absolute;
		left: 0;
		right: -6px;
		bottom: -4px;
		height: 5px;
		border-radius: 999px;
		background: color-mix(in srgb, var(--c) 55%, transparent);
	}
	.cd-viz { position: relative; }
	/* the visual's decorative glow must never poke past small screens */
	@media (max-width: 980px) {
		.cd-viz :global(.det-viz-glow) { left: 0; right: 0; }
	}
	.cd-sticky {
		position: absolute;
		right: -0.7rem;
		bottom: -1rem;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-family: var(--cp-marker);
		font-size: 0.9rem;
		font-weight: 700;
		color: #44403c;
		background: #fef08a;
		padding: 0.7rem 0.85rem 0.85rem;
		box-shadow: 0 10px 22px -8px rgba(0, 0, 0, 0.4);
		transform: rotate(var(--r, 2deg));
		max-width: 16rem;
		z-index: 2;
	}
	.cd-sticky :global(svg) { color: #b45309; flex-shrink: 0; }
	@media (max-width: 560px) {
		.cd-sticky { right: 0.3rem; }
	}

	/* ── B · modules ── */
	.cd-inc {
		display: grid;
		gap: 1.1rem;
		grid-template-columns: repeat(var(--inc-cols, 3), minmax(0, 1fr));
	}
	@media (max-width: 1080px) {
		.cd-inc { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}
	@media (max-width: 560px) {
		.cd-inc { grid-template-columns: 1fr; }
	}
	.cd-inc-card {
		position: relative;
		padding: 1.25rem;
		border-radius: 0.9rem;
		border: 1px solid var(--cp-line);
		background: var(--cp-card);
		transition: border-color 0.25s ease;
	}
	.cd-inc-card:hover { border-color: color-mix(in srgb, var(--c) 50%, transparent); }
	.cd-inc-card h3 { margin: 0 0 0.4rem; font-size: 1.02rem; font-weight: 800; }
	.cd-inc-card p { margin: 0 0 0.8rem; font-size: 0.88rem; line-height: 1.6; color: var(--cp-muted); }
	.cd-inc-items { display: flex; flex-direction: column; gap: 0.35rem; }
	.cd-inc-items i {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-style: normal;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--cp-muted);
	}
	.cd-inc-items i :global(svg) { color: var(--c); flex-shrink: 0; }

	/* ── C · lesson plan ── */
	.cd-steps {
		position: relative;
		display: grid;
		gap: clamp(1.4rem, 3vw, 2rem);
		padding-left: clamp(1.6rem, 4vw, 2.6rem);
		max-width: 56rem;
		margin: 0 auto;
	}
	.cd-spine {
		position: absolute;
		top: 0.4rem;
		bottom: 0.4rem;
		left: 8px;
		width: 2px;
		background: linear-gradient(180deg, var(--c), color-mix(in srgb, var(--c) 25%, transparent));
		transform: scaleY(0);
		transform-origin: top;
		transition: transform 1.6s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.cd-steps.is-drawing .cd-spine { transform: scaleY(1); }
	.cd-step { position: relative; display: grid; grid-template-columns: auto 1fr; gap: 1rem; align-items: start; }
	.cd-step-node {
		position: absolute;
		left: calc(-1 * clamp(1.6rem, 4vw, 2.6rem) + 3px);
		top: 0.45rem;
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: var(--c);
		box-shadow: 0 0 0 4px color-mix(in srgb, var(--c) 22%, transparent);
	}
	.cd-step-n {
		font-family: var(--cp-marker);
		font-size: clamp(1.2rem, 2.4vw, 1.7rem);
		line-height: 1;
		color: var(--c);
		min-width: 2.6rem;
	}
	.cd-step-t { margin: 0.1rem 0 0.25rem; font-size: clamp(1.1rem, 2vw, 1.35rem); font-weight: 800; }
	.cd-step-d { margin: 0; max-width: 42rem; font-size: 0.94rem; line-height: 1.6; color: var(--cp-muted); }

	/* ── D · ways ── */
	.cd-ways {
		display: grid;
		gap: 1.1rem;
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}
	@media (max-width: 980px) {
		.cd-ways { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}
	@media (max-width: 560px) {
		.cd-ways { grid-template-columns: 1fr; }
	}
	.cd-way {
		position: relative;
		padding: 1.25rem;
		border-radius: 0.9rem;
