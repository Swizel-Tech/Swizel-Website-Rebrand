---
// Portfolio · Builder world — the same receipts as every other portfolio
// (marquee wall, numbers, featured case studies, Brevarium, the full
// sector-filtered grid, CTA) told as a deployments dashboard. Signature
// widget: a LIVE DEPLOY CONSOLE that ships real projects on a loop —
// terminal types the deploy, the preview pane swaps to the real product.
import { Icon } from 'astro-icon/components';
import FilmPlayer from '../FilmPlayer.astro';
import { projects, featuredProjects, sectorLabels, sectorOrder, type ProjectSector } from '../../data/projects';

const sectors = sectorOrder;
const sectorShown: Record<ProjectSector, string> = {
	agri: '12+', health: '6+', property: '14+', media: '9+', commerce: '8+', product: '18+',
};
const totalShown = '65+';

const stats = [
	{ to: 65, suffix: '+', label: 'deployments' },
	{ to: 15, suffix: '+', label: 'sectors' },
	{ to: 7, suffix: '+', label: 'years shipping' },
	{ to: 99.9, decimals: 1, suffix: '%', label: 'uptime' },
];

// the console ships these on a loop (real projects with real screenshots)
// The console used to cycle six hand-picked slugs. It runs the whole
// live estate now — anything with a real address and a real screenshot.
const consoleProjects = projects.filter((p) => !!p.url && !!p.img);

const marquee = [...projects, ...projects];
const rot = [...projects.slice(6), ...projects.slice(0, 6)];
const marquee2 = [...rot, ...rot];

// Where a tile goes: the full case study when there is one, the live site
// when there is one, and otherwise the work's own short entry — before
// this, a project with neither simply linked nowhere.
const dest = (p: (typeof projects)[number]) =>
	p.caseStudy ? `/work/${p.slug}` : (p.url ?? `/work/${p.slug}`);
/** true only when the tile really does leave swizel.co */
const leaves = (p: (typeof projects)[number]) => !p.caseStudy && !!p.url;
const sectorCursor: Record<ProjectSector, string> = { agri: 'branch', health: 'pulse', property: 'layers', media: 'book', commerce: 'pkg', product: 'repo' };
---

<div class="bpf bbody view-body view-body-builder">
	<div class="pb-bg" aria-hidden="true">
		<span class="pb-orb pb-orb--a"></span>
		<span class="pb-orb pb-orb--b"></span>
		{Array.from({ length: 7 }).map((_, i) => (
			<i class="pb-spark" style={`--s:${i}`}></i>
		))}
	</div>

	<!-- ── 01 · hero: copy + THE DEPLOY CONSOLE ────────────── -->
	<section class="pb-sec" data-cursor="term">
		<div class="pb-wrap pb-hero">
			<div class="bb-rev">
				<span class="pb-kick">$ swizel deployments --list</span>
				<h2 class="pb-h pb-h--xl">Proof, in <span class="pb-acc">production.</span></h2>
				<p class="pb-p">
					Real products, live on the internet. Watch the console ship
					them, then browse every deployment below.
				</p>
				<ul class="pb-stats">
					{
						stats.map((s) => (
							<li>
								<strong data-count={s.to} data-suffix={s.suffix} data-decimals={s.decimals || 0}>0{s.suffix}</strong>
								<span>{s.label}</span>
							</li>
						))
					}
				</ul>
				<div class="pb-row">
					<a href="#pb-featured" class="pb-merge fs-cta">
						<Icon width={17} name="mdi:rocket-launch-outline" />
						See the headliners
					</a>
					<a href="#pb-work" class="pb-link">
						Browse everything
						<Icon width={15} name="mdi:arrow-down" />
					</a>
				</div>
			</div>

			<!-- the live deploy console -->
			<div class="pb-console bb-rev" id="pb-console" data-fa-tilt="3">
				<span class="bb-glare" aria-hidden="true"></span>
				<div class="pb-winbar">
					<span class="pb-dot pb-dot--r"></span>
					<span class="pb-dot pb-dot--y"></span>
					<span class="pb-dot pb-dot--g"></span>
					<span class="pb-wintitle">swizel — deploy console</span>
					<span class="pb-win-live"><i></i>shipping on loop</span>
				</div>
				<div class="pb-console-grid">
					<aside class="pb-rail" aria-label="Deployments">
						<div class="pb-rail-head">
							<span class="pb-rail-k">{consoleProjects.length} live</span>
							<button
								class="pb-fold"
								type="button"
								data-pb-fold
								aria-label="Hide the deployment list"
								title="Hide the deployment list"
							>
								<Icon width={15} name="mdi:chevron-double-left" />
							</button>
						</div>
						<ul class="pb-rail-list">
							{
								consoleProjects.map((p, i) => (
									<li>
										<button
											class:list={['pb-rail-row', { 'is-on': i === 0 }]}
											type="button"
											data-pb-pick={i}
										>
											<i class="pb-rail-dot" aria-hidden="true" />
											{p.slug}
										</button>
									</li>
								))
							}
						</ul>
					</aside>

					<button
						class="pb-unfold"
						type="button"
						data-pb-fold
						aria-label="Show the deployment list"
						title="Show the deployment list"
					>
						<Icon width={16} name="mdi:file-tree-outline" />
					</button>

					<!-- the site itself is the headline: it takes the room, and
					     the deploy log runs as a strip underneath it -->
					<div class="pb-stage">
						<div class="pb-preview">
							<span class="pb-preview-bar">
								<i></i><i></i><i></i>
								<span class="pb-preview-url" id="pb-url">…</span>
								<b class="pb-preview-name" id="pb-name">{consoleProjects[0]?.name}</b>
								<em class="pb-preview-sector" id="pb-sector">{sectorLabels[consoleProjects[0]?.sector]}</em>
								<span class="pb-status" id="pb-status"><i></i>Ready · Production</span>
							</span>
							<span class="pb-preview-img">
								{
									consoleProjects.map((p, i) => (
										<img
											src={p.img}
											alt={p.name}
											loading={i === 0 ? 'eager' : 'lazy'}
											data-pb-shot={p.slug}
											class:list={[{ 'is-on': i === 0 }]}
										/>
									))
								}
							</span>
						</div>

						<div class="pb-term">
							<p class="pb-tline">
								<span class="pb-prompt">$</span>
								<span id="pb-cmd"></span>
								<span class="pb-caret" aria-hidden="true"></span>
							</p>
							<div class="pb-bar"><span class="pb-fill" id="pb-fill"></span></div>
							<div class="pb-log" id="pb-log"></div>
						</div>
					</div>
				</div>
				{
					consoleProjects.map((p) => (
						<span
							class="pb-data"
							hidden
							data-pb-project
							data-slug={p.slug}
							data-name={p.name}
							data-host={p.host}
							data-sector={sectorLabels[p.sector]}
						/>
					))
				}
			</div>
		</div>

		<!-- full-bleed wall of work -->
		<div class="pb-wallhead bb-rev">// a wall of deployments, on loop</div>
		<div class="pb-marquee bb-rev" aria-hidden="true">
			<div class="pb-marquee-track">
				{
					marquee.map((p) => (
						<a href={dest(p) ?? undefined} data-leaving={leaves(p) ? p.host : undefined} data-leaving-name={leaves(p) ? p.name : undefined} class="pb-thumb" style={`--c:${p.color}`} tabindex="-1">
							<span class="pb-thumb-bar"><i></i><i></i><i></i></span>
							<img src={p.img} alt="" loading="eager" decoding="async" />
						</a>
					))
				}
			</div>
			<div class="pb-marquee-track pb-marquee-track--rev">
				{
					marquee2.map((p) => (
						<a href={dest(p) ?? undefined} data-leaving={leaves(p) ? p.host : undefined} data-leaving-name={leaves(p) ? p.name : undefined} class="pb-thumb" style={`--c:${p.color}`} tabindex="-1">
							<span class="pb-thumb-bar"><i></i><i></i><i></i></span>
							<img src={p.img} alt="" loading="eager" decoding="async" />
						</a>
					))
				}
			</div>
		</div>
	</section>

	<!-- ── 02 · featured case studies ──────────────────────── -->
	<section class="pb-sec" id="pb-featured" data-cursor="repo">
		<div class="pb-wrap">
			<div class="pb-head bb-rev">
				<span class="pb-kick">// featured — the long reads</span>
				<h2 class="pb-h">Post-mortems worth <span class="pb-acc">reading.</span></h2>
			</div>
			<div class="pb-feats">
				{
					featuredProjects.map((p, i) => (
						<article
							class="pb-feat bb-rev"
							style={`--c:${p.color};--i:${i}`}
							data-cursor={sectorCursor[p.sector]}
						>
							<a
								class="pb-shot"
								href={`/work/${p.slug}`}
								aria-label={`${p.name} case study`}
							>
								<span class="pb-bar2" aria-hidden="true">
									<i></i><i></i><i></i>
									<span class="pb-url2">{p.host}</span>
								</span>
								<span class="pb-img">
									<img src={p.img} alt={p.name} loading={i < 3 ? 'eager' : 'lazy'} decoding="async" />
								</span>
								<span class="pb-shot-open" aria-hidden="true">
									<Icon width={15} name="mdi:arrow-top-right" />
								</span>
							</a>

							<div class="pb-feat-body">
								<span class="pb-feat-eyebrow">
									<span class="pb-live-dot" aria-hidden="true" />
									deploy #{String(i + 1).padStart(2, '0')} · {sectorLabels[p.sector]}
								</span>
								<h3>{p.name}</h3>
								<p class="pb-feat-tagline">{p.tagline}</p>
								<span class="pb-tags">
									{p.tags.slice(0, 3).map((t) => <i>{t}</i>)}
								</span>
								<a class="pb-link" href={`/work/${p.slug}`}>
									cat case-study.md
									<Icon width={15} name="mdi:arrow-right" />
								</a>
							</div>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<!-- ── 02b · the showreel ──────────────────────────────── -->
	<section class="pb-sec" data-cursor="term">
		<div class="pb-wrap">
			<div class="pb-head bb-rev">
				<span class="pb-kick">// showreel</span>
				<h2 class="pb-h">Watch the work <span class="pb-acc">move.</span></h2>
				<p class="pb-p pb-p--center">
					The products, the builds and the launches, end to end. Proof
					in motion rather than in a paragraph.
				</p>
			</div>
			<figure class="pb-reel bb-rev">
				<div class="pb-reel-bar">
					<span class="pb-dot pb-dot--r" aria-hidden="true" />
					<span class="pb-dot pb-dot--y" aria-hidden="true" />
					<span class="pb-dot pb-dot--g" aria-hidden="true" />
					<span class="pb-reel-name">the-showreel.mp4</span>
					<span class="pb-reel-live"><i aria-hidden="true" />65+ products, on loop</span>
				</div>
				<FilmPlayer
					videoId="nFbBpQvT5fQ"
					label="The Swizel showreel: the products, the builds and the launches"
					tag="showreel"
					class="pb-reel-film"
				/>
			</figure>
		</div>
	</section>

	<!-- ── 03 · docs/ — the Brevarium ──────────────────────── -->
	<section class="pb-sec" data-cursor="repo">
		<div class="pb-wrap">
			<div class="pb-mags bb-rev">
				<a class="pb-mag" href="/brevarium/the-brevarium-latest.pdf" download data-fa-tilt="7">
					<span class="pb-mag-cover"><img src="/images/portfolio/mag-latest-cover.jpg" alt="The Brevarium — latest edition" loading="lazy" /></span>
					<span class="pb-mag-meta">
						<span class="pb-kick">// docs/the-brevarium — latest</span>
						<strong>The Brevarium</strong>
						<em>Featured projects, the team & how we ship. Free, cover to cover.</em>
						<span class="pb-link"><Icon width={15} name="mdi:download" /> download.pdf</span>
					</span>
				</a>
				<a class="pb-mag" href="/The Brevarium by Swizel.pdf" download data-fa-tilt="7">
					<span class="pb-mag-cover"><img src="/images/portfolio/mag-v1-cover.jpg" alt="The Brevarium — Vol. 1" loading="lazy" /></span>
					<span class="pb-mag-meta">
						<span class="pb-kick">// docs/the-brevarium — v1.0.0</span>
						<strong>The Brevarium · Vol. 1</strong>
						<em>The AppMan story, a full product, start to finish.</em>
						<span class="pb-link"><Icon width={15} name="mdi:download" /> download.pdf</span>
					</span>
				</a>
			</div>
		</div>
	</section>

	<!-- ── 04 · every deployment — sector filter ───────────── -->
	<section class="pb-sec" id="pb-work" data-cursor="repo">
		<div class="pb-wrap">
			<div class="pb-head bb-rev">
				<span class="pb-kick">$ swizel ls --filter=sector</span>
				<h2 class="pb-h">Every <span class="pb-acc">deployment.</span></h2>
				<p class="pb-p pb-p--center">
					We've shipped <strong>{totalShown}</strong> products across
					<strong>15+</strong> sectors. ~{projects.length} favourites
					below, filter away.
				</p>
			</div>

			<form class="pb-filter" autocomplete="off">
				<input class="pb-radio" type="radio" name="pbf" id="pbf-all" checked />
				{sectors.map((s) => <input class="pb-radio" type="radio" name="pbf" id={`pbf-${s}`} />)}
				<div class="pb-chips bb-rev">
					<label class="pb-chip" for="pbf-all">--all <span>{totalShown}</span></label>
					{
						sectors.map((s) => (
							<label class="pb-chip" for={`pbf-${s}`}>
								--{s} <span>{sectorShown[s]}</span>
							</label>
						))
					}
				</div>
				<div class="pb-grid">
					{
						projects.map((p) => {
							const href = dest(p);
							const hasCase = !!p.caseStudy;
							const Tag = href ? 'a' : 'div';
							return (
								<article class:list={['pb-card', 'bb-rev', `s-${p.sector}`]} style={`--c:${p.color}`} data-cursor={sectorCursor[p.sector]}>
									<Tag
										class="pb-card-link"
										href={href ?? undefined}
										data-leaving={leaves(p) ? p.host : undefined}
										data-leaving-name={leaves(p) ? p.name : undefined}
										rel={leaves(p) ? 'noopener noreferrer' : undefined}
										aria-label={p.name}
									>
										<span class:list={['pb-cshot', { 'pb-cshot--app': p.kind === 'app' }]}>
											<span class="pb-cimg"><img src={p.img} alt={p.name} loading="lazy" /></span>
											{hasCase && <span class="pb-badge">case study</span>}
										</span>
										<span class="pb-card-body">
											<span class="pb-card-head">
												<strong>{p.name}</strong>
												<em>{p.year}</em>
											</span>
											<span class="pb-card-status"><i></i>Ready · Production · {sectorLabels[p.sector]}</span>
											<span class="pb-tags">
												{p.tags.map((t) => <i>{t}</i>)}
											</span>
										</span>
									</Tag>
								</article>
							);
						})
					}
					<a class="pb-card pb-next s-agri s-health s-property s-media s-commerce s-product" href="/contact" data-cursor="phone">
						<span class="pb-next-ic"><Icon width={24} name="mdi:rocket-launch-outline" /></span>
						<span class="pb-kick">// slot reserved</span>
						<strong>your-product.com</strong>
						<span class="pb-next-p">We've shipped <b>65+</b> across <b>15+</b> sectors. This deploy slot has your name on it.</span>
						<span class="pb-link">swizel deploy your-idea <Icon width={15} name="mdi:arrow-right" /></span>
					</a>
				</div>
			</form>
		</div>
	</section>

	<!-- ── 05 · CTA ────────────────────────────────────────── -->
	<section class="pb-sec pb-sec--last" data-cursor="phone">
		<div class="pb-cta bb-rev">
			<span class="pb-orbit" aria-hidden="true"><i></i><i></i><i></i></span>
			<p class="pb-cta-cmd">$ swizel deploy <span class="pb-acc">your-product</span> --prod</p>
			<h2 class="pb-h pb-h--xl">Next on this dashboard: yours.</h2>
			<p class="pb-p pb-p--center">
				Tell us what you have in mind. You'll have a reply within one
				business day.
			</p>
			<div class="pb-row pb-row--center">
				<a href="/contact" class="pb-merge fs-cta">
					<Icon width={18} name="mdi:source-merge" />
					Start your project
				</a>
				<a href="/services" class="pb-link">
					See what we do
					<Icon width={15} name="mdi:chevron-right" />
				</a>
			</div>
		</div>
	</section>
</div>

<style>
	.bpf {
		--bu-ink: #e8f0f4;
		--bu-muted: rgba(232, 240, 244, 0.62);
		--bu-faint: rgba(232, 240, 244, 0.4);
		--bu-acc: var(--view-accent, #18debe);
		--bu-line: rgba(255, 255, 255, 0.08);
		--bu-card: rgba(255, 255, 255, 0.03);
		--bu-mono: 'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace;
		font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI',
			Roboto, sans-serif;
		position: relative;
		isolation: isolate;
		background:
			radial-gradient(1000px 520px at 85% -4%, rgba(24, 222, 190, 0.1), transparent 60%),
			radial-gradient(800px 480px at 4% 42%, rgba(40, 166, 236, 0.07), transparent 60%),
			linear-gradient(180deg, #05080c 0%, #070d12 50%, #04070a 100%);
		color: var(--bu-ink);
		padding: clamp(3rem, 7vw, 5rem) clamp(1rem, 3vw, 2rem) clamp(2.5rem, 5vw, 4rem);
	}
	/* the last page still wearing the near-white: the same slate and the
	   same ruled grid as the hero, the home body, About and Services */
	:global(html:not(.dark)) .bpf {
		--bu-ink: #10201f;
		--bu-muted: rgba(16, 32, 31, 0.72);
		--bu-faint: rgba(16, 32, 31, 0.52);
		--bu-line: rgba(16, 32, 31, 0.14);
		--bu-card: rgba(16, 32, 31, 0.055);
		background:
			radial-gradient(1000px 520px at 85% -4%, rgba(13, 148, 136, 0.16), transparent 62%),
			linear-gradient(180deg, #dde7e6 0%, #d3e0de 48%, #cfdcda 100%);
	}
	:global(html:not(.dark)) .bpf::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		background-image:
			linear-gradient(rgba(13, 148, 136, 0.11) 1px, transparent 1px),
			linear-gradient(90deg, rgba(13, 148, 136, 0.11) 1px, transparent 1px);
		background-size: 46px 46px;
		-webkit-mask-image: linear-gradient(180deg, #000, transparent 88%);
		mask-image: linear-gradient(180deg, #000, transparent 88%);
	}
	.pb-sec { position: relative; z-index: 1; padding-block: clamp(1.8rem, 4.5vw, 3.2rem); }
	/* the first section sat a whole section's padding below the header */
	.pb-sec:first-of-type { padding-top: clamp(0.5rem, 1.4vw, 1rem); }
	.pb-sec--last { padding-bottom: clamp(3rem, 6vw, 4.5rem); }
	.pb-wrap { max-width: 74rem; margin: 0 auto; }

	.pb-bg { position: absolute; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
	.pb-orb { position: absolute; border-radius: 50%; filter: blur(70px); opacity: 0.4; animation: pb-orb-drift 17s ease-in-out infinite alternate; }
	.pb-orb--a { width: 440px; height: 440px; left: -150px; top: 5%; background: radial-gradient(circle, rgba(24, 222, 190, 0.28), transparent 70%); }
	.pb-orb--b { width: 500px; height: 500px; right: -170px; top: 44%; background: radial-gradient(circle, rgba(40, 166, 236, 0.18), transparent 70%); animation-delay: -7s; }
	@keyframes pb-orb-drift { to { transform: translate3d(52px, -38px, 0) scale(1.1); } }
	.pb-spark {
		position: absolute; bottom: -12px; left: calc(10% + var(--s) * 12%);
		width: 3.5px; height: 3.5px; border-radius: 50%;
		background: color-mix(in srgb, var(--bu-acc) 85%, #fff);
		box-shadow: 0 0 10px 2px color-mix(in srgb, var(--bu-acc) 55%, transparent);
		opacity: 0;
		animation: pb-rise calc(9s + var(--s) * 1.4s) linear infinite;
		animation-delay: calc(var(--s) * -1.9s);
	}
	@keyframes pb-rise {
		0% { transform: translateY(0); opacity: 0; }
		8% { opacity: 0.75; }
		92% { opacity: 0.2; }
		100% { transform: translateY(-105vh) translateX(24px); opacity: 0; }
	}
	@media (prefers-reduced-motion: reduce) { .pb-orb { animation: none; } .pb-spark { display: none; } }

	.pb-kick { display: block; font-family: var(--bu-mono); font-size: 0.8rem; color: var(--bu-acc); margin-bottom: 0.8rem; }
	:global(html:not(.dark)) .bpf .pb-kick { color: #0b8a76; }
	.pb-h { font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 850; letter-spacing: -0.025em; line-height: 1.08; margin: 0 0 1rem; }
	.pb-h--xl { font-size: clamp(2rem, 4.4vw, 3.2rem); }
	.pb-acc {
		background: linear-gradient(95deg, #8dfeea, var(--bu-acc) 60%, #28a6ec);
		-webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
	}
	:global(html:not(.dark)) .bpf .pb-acc { background: linear-gradient(95deg, #0b8a76, #0d7fb8); -webkit-background-clip: text; background-clip: text; }
	.pb-p { font-size: 1rem; line-height: 1.65; color: var(--bu-muted); max-width: 34rem; margin: 0 0 1.3rem; }
	.pb-p--center { margin-inline: auto; text-align: center; }
	.pb-head { text-align: center; max-width: 46rem; margin: 0 auto clamp(1.4rem, 3vw, 2rem); }
	.pb-head .pb-kick { text-align: center; }
	.pb-link { display: inline-flex; align-items: center; gap: 0.45rem; font-weight: 700; color: var(--bu-acc); transition: gap 0.25s ease; }
	.pb-link:hover { gap: 0.75rem; }
	:global(html:not(.dark)) .bpf .pb-link { color: #0b8a76; }
	.pb-row { display: flex; align-items: center; gap: 1.3rem; flex-wrap: wrap; }
	.pb-row--center { justify-content: center; }
	.pb-merge {
		position: relative; overflow: hidden;
		display: inline-flex; align-items: center; gap: 0.55rem;
		font-weight: 800; font-size: 0.95rem; color: #04211a;
		background: linear-gradient(95deg, #8dfeea, var(--bu-acc) 60%, #28a6ec);
		padding: 0.85rem 1.6rem; border-radius: 9999px;
		box-shadow: 0 16px 38px -14px color-mix(in srgb, var(--bu-acc) 80%, transparent);
		transition: transform 0.22s ease;
	}
	.pb-merge:hover { transform: translateY(-2px); }

	.bb-rev {
		opacity: 0; transform: translateY(20px);
		transition: opacity 0.6s ease calc(var(--i, 0) * 90ms),
			transform 0.6s cubic-bezier(0.22, 1, 0.36, 1) calc(var(--i, 0) * 90ms);
	}
	.bb-rev.is-on { opacity: 1; transform: none; }
	@media (prefers-reduced-motion: reduce) { .bb-rev { opacity: 1; transform: none; transition: none; } }
	.bb-glare {
		position: absolute; inset: 0; border-radius: inherit; z-index: 3;
		background: radial-gradient(360px 230px at var(--gx, 50%) var(--gy, 0%), rgba(255, 255, 255, 0.07), transparent 60%);
		opacity: 0; transition: opacity 0.3s ease; pointer-events: none;
	}
	.pb-console:hover .bb-glare { opacity: 1; }

	/* hero */
	.pb-hero { display: grid; grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr); gap: clamp(1.6rem, 3vw, 2.4rem); align-items: center; }
	.pb-stats { display: flex; align-items: stretch; margin: 1.5rem 0 1.4rem; padding: 0; list-style: none; }
	.pb-stats li { flex: 1; min-width: 0; padding: 0.2rem 0.85rem; border-left: 1px solid color-mix(in srgb, var(--bu-acc) 25%, transparent); transition: transform 0.25s ease; }
	.pb-stats li:first-child { padding-left: 0; border-left: 0; }
	.pb-stats li:hover { transform: translateY(-3px); }
	.pb-stats strong {
		display: block; font-family: var(--bu-mono); font-weight: 700; white-space: nowrap;
		font-size: clamp(1.2rem, 2.1vw, 1.6rem);
		background: linear-gradient(135deg, #8dfeea, var(--bu-acc));
		-webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
	}
	:global(html:not(.dark)) .bpf .pb-stats strong { background: linear-gradient(135deg, #0b8a76, #0d7fb8); -webkit-background-clip: text; background-clip: text; }
	.pb-stats span { display: block; font-size: 0.7rem; line-height: 1.3; color: var(--bu-muted); margin-top: 0.2rem; }

	/* ── THE DEPLOY CONSOLE ── */
	.pb-console {
		position: relative; overflow: hidden;
		border-radius: 1rem; border: 1px solid color-mix(in srgb, var(--bu-acc) 24%, var(--bu-line));
		background: #0a0e15;
		box-shadow: 0 34px 80px -32px rgba(0, 0, 0, 0.8);
		transform-style: preserve-3d; will-change: transform;
	}
	.pb-winbar { display: flex; align-items: center; gap: 6px; padding: 10px 12px; background: rgba(255, 255, 255, 0.05); }
	.pb-dot { width: 10px; height: 10px; border-radius: 50%; }
	.pb-dot--r { background: #ff5f57; } .pb-dot--y { background: #febc2e; } .pb-dot--g { background: #28c840; }
	.pb-wintitle { margin-left: 0.5rem; font-family: var(--bu-mono); font-size: 0.74rem; color: rgba(232, 240, 244, 0.5); }
	.pb-win-live { margin-left: auto; display: inline-flex; align-items: center; gap: 0.35rem; font-family: var(--bu-mono); font-size: 0.7rem; color: #2ee889; }
	.pb-win-live i { width: 7px; height: 7px; border-radius: 50%; background: #2ee889; animation: pb-live 2s ease-in-out infinite; }
	@keyframes pb-live { 0%, 100% { box-shadow: 0 0 0 0 rgba(46, 232, 137, 0.5); } 50% { box-shadow: 0 0 0 4px rgba(46, 232, 137, 0); } }
	/* ── the console: a rail of deployments, a terminal, a preview ──── */
	.pb-console-grid {
		display: grid;
		grid-template-columns: 11rem minmax(0, 1fr);
		transition: grid-template-columns 0.32s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.pb-console.is-folded .pb-console-grid { grid-template-columns: 2.6rem minmax(0, 1fr); }
	.pb-console.is-folded .pb-rail { display: none; }
	.pb-rail {
		grid-column: 1;
		position: relative;
		z-index: 5;
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		padding: 0.6rem 0.4rem;
		border-right: 1px solid rgba(255, 255, 255, 0.06);
		background: rgba(255, 255, 255, 0.015);
		overflow-y: auto;
		scrollbar-width: thin;
		scrollbar-color: rgba(255, 255, 255, 0.16) transparent;
	}
	.pb-rail-head { display: flex; align-items: center; gap: 0.4rem; padding: 0 0.15rem 0.4rem 0.35rem; }
	.pb-rail-k {
		margin-right: auto;
		font-family: var(--bu-mono);
		font-size: 0.64rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: rgba(232, 240, 244, 0.42);
	}
	.pb-rail-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.12rem; }
	.pb-rail-row {
		display: flex;
		align-items: center;
		gap: 0.36rem;
		width: 100%;
		padding: 0.26rem 0.4rem;
		border: 0;
		border-radius: 0.35rem;
		background: transparent;
		color: rgba(232, 240, 244, 0.6);
		font-family: var(--bu-mono);
		font-size: 0.68rem;
		text-align: left;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		cursor: pointer;
		transition: background 0.18s ease, color 0.18s ease;
	}
	.pb-rail-row:hover { background: rgba(255, 255, 255, 0.05); color: #eafcff; }
	.pb-rail-row.is-on { background: color-mix(in srgb, var(--bu-acc) 15%, transparent); color: #eafcff; }
	.pb-rail-dot {
		width: 5px; height: 5px; flex: none; border-radius: 9999px;
		background: #28c840; box-shadow: 0 0 6px #28c840;
	}

	/* the fold, on both faces, breathing until it has been used once */
	.pb-fold,
	.pb-unfold {
		position: relative;
		z-index: 6;
		display: grid;
		place-items: center;
		border: 0;
		border-radius: 0.4rem;
		background: color-mix(in srgb, var(--bu-acc) 14%, transparent);
		color: color-mix(in srgb, var(--bu-acc) 72%, #fff);
		cursor: pointer;
	}
	.pb-fold { width: 1.55rem; height: 1.55rem; }
	.pb-unfold {
		display: none;
		grid-column: 1;
		align-self: start;
		justify-self: center;
		width: 1.9rem;
		height: 1.9rem;
		margin-top: 0.6rem;
		background: transparent;
	}
	.pb-console.is-folded .pb-unfold { display: grid; }
	.pb-fold::after,
	.pb-unfold::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
		box-shadow: 0 0 0 0 color-mix(in srgb, var(--bu-acc) 60%, transparent);
		animation: pb-ask 2.2s cubic-bezier(0.22, 1, 0.36, 1) infinite;
		pointer-events: none;
	}
	.pb-fold :global(svg) { animation: pb-nudge 2.2s cubic-bezier(0.22, 1, 0.36, 1) infinite; }
	.pb-unfold :global(svg) { animation: pb-nudge-r 2.2s cubic-bezier(0.22, 1, 0.36, 1) infinite; }
	.pb-console.is-taught .pb-fold::after,
	.pb-console.is-taught .pb-unfold::after,
	.pb-console.is-taught .pb-fold :global(svg),
	.pb-console.is-taught .pb-unfold :global(svg) { animation: none; }
	.pb-console.is-taught .pb-fold { background: transparent; color: rgba(232, 240, 244, 0.5); }
	@keyframes pb-ask {
		0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--bu-acc) 55%, transparent); }
		60%, 100% { box-shadow: 0 0 0 9px color-mix(in srgb, var(--bu-acc) 0%, transparent); }
	}
	@keyframes pb-nudge {
		0%, 55%, 100% { transform: translateX(0); }
		70% { transform: translateX(-3px); }
		85% { transform: translateX(-1px); }
	}
	@keyframes pb-nudge-r {
		0%, 55%, 100% { transform: translateX(0); }
		70% { transform: translateX(3px); }
		85% { transform: translateX(1px); }
	}
	@media (prefers-reduced-motion: reduce) {
		.pb-fold::after, .pb-unfold::after,
		.pb-fold :global(svg), .pb-unfold :global(svg) { animation: none; }
	}
	/* ── the rail on a phone ──────────────────────────────────────────
	   It used to be hidden outright below 880px, which left no way to
	   pick a deployment — you waited for the rotation or got nothing.
	   It is a drawer now: the console starts folded, the pulsating
	   file-tree button sits over the top-left corner of the stage, and
	   tapping it slides the list in over the preview. Picking a site
	   closes it again. */
	@media (max-width: 880px) {
		.pb-console-grid,
		.pb-console.is-folded .pb-console-grid { grid-template-columns: minmax(0, 1fr); position: relative; }

		.pb-rail {
			position: absolute;
			inset: 0 auto 0 0;
			z-index: 12;
			width: min(15rem, 76%);
			margin: 0;
			padding: 0.6rem 0.5rem;
			overflow-y: auto;
			border-right: 1px solid color-mix(in srgb, var(--bu-acc) 30%, transparent);
			background: #080d13;
			box-shadow: 18px 0 40px -18px rgba(0, 0, 0, 0.85);
			animation: pb-drawer 0.28s cubic-bezier(0.22, 1, 0.36, 1) both;
		}
		@keyframes pb-drawer { from { transform: translateX(-102%); } }
		/* a scrim so the list reads against the live preview behind it.
		   It hangs off the grid, not the rail: the rail makes its own
		   stacking context, so a negative z-index inside it just put the
		   scrim behind the rail's own background. */
		.pb-console-grid::after {
			content: '';
			position: absolute;
			inset: 0;
			z-index: 11;
			background: rgba(2, 6, 10, 0.55);
		}
		.pb-console.is-folded .pb-console-grid::after { display: none; }
		.pb-console.is-folded .pb-rail { display: none; }

		/* the deploy log drops to its own full-width row here. Its left
		   fade is there to soften the oldest line on a wide console; on a
		   phone it was eating the first characters of the newest one
		   ("✓ live at …" arrived as "ive at …"), so it fades right. */
		.pb-console .pb-term { grid-template-columns: minmax(0, 1fr); }
		.pb-console .pb-log {
			grid-column: 1;
			grid-row: 3;
			max-width: none;
			justify-content: flex-start;
			mask-image: linear-gradient(90deg, #000 88%, transparent);
			-webkit-mask-image: linear-gradient(90deg, #000 88%, transparent);
		}

		/* the console title wrapped onto two lines at this width and ran
		   into the live badge */
		.pb-wintitle { font-size: 0.72rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
		.pb-win-live { font-size: 0.68rem; white-space: nowrap; flex: none; }

		.pb-unfold {
			display: none;
			position: absolute;
			top: 3.4rem;
			left: 0.5rem;
			z-index: 13;
			margin: 0;
			width: 2.1rem;
			height: 2.1rem;
			border-radius: 0.5rem;
			background: rgba(8, 13, 19, 0.88);
			border: 1px solid color-mix(in srgb, var(--bu-acc) 42%, transparent);
			backdrop-filter: blur(6px);
			-webkit-backdrop-filter: blur(6px);
		}
		.pb-console.is-folded .pb-unfold { display: grid; }
		/* it keeps breathing on a phone even after one use: it is the only
		   way in, and it is easy to miss over a busy preview */
		.pb-console.is-taught .pb-unfold::after {
			animation: pb-ask 2.2s cubic-bezier(0.22, 1, 0.36, 1) infinite;
		}
		.pb-console.is-taught .pb-unfold :global(svg) {
			animation: pb-nudge-r 2.2s cubic-bezier(0.22, 1, 0.36, 1) infinite;
		}
		.pb-stage { grid-column: 1; }
	}
	@media (max-width: 880px) and (prefers-reduced-motion: reduce) {
		.pb-rail { animation: none; }
	}
	/* the stage: the site is the headline, the log runs underneath it */
	.pb-stage { grid-column: 2; display: flex; flex-direction: column; min-width: 0; }
	.pb-term {
		flex: none;
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		gap: 0.25rem 0.9rem;
		padding: 0.6rem 0.9rem 0.7rem;
		border-top: 1px solid rgba(255, 255, 255, 0.07);
		background: rgba(255, 255, 255, 0.02);
	}
	.pb-tline { grid-column: 1; margin: 0; font-family: var(--bu-mono); font-size: 0.78rem; color: #e8f0f4; min-height: 1.3em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
	.pb-prompt { color: var(--bu-acc); margin-right: 0.35rem; }
	.pb-caret { display: inline-block; width: 7px; height: 0.95em; margin-left: 2px; vertical-align: text-bottom; background: var(--bu-acc); animation: pb-caret 0.9s steps(1) infinite; }
	@keyframes pb-caret { 50% { opacity: 0; } }
	.pb-bar { grid-column: 1 / -1; grid-row: 2; height: 4px; border-radius: 999px; background: rgba(255, 255, 255, 0.08); overflow: hidden; margin: 0; }
	.pb-fill { display: block; height: 100%; width: 0%; border-radius: 999px; background: linear-gradient(90deg, #8dfeea, var(--bu-acc), #28a6ec); transition: width 0.35s ease; }
	.pb-log {
		grid-column: 2;
		grid-row: 1;
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.75rem;
		max-width: min(30rem, 52%);
		overflow: hidden;
		font-family: var(--bu-mono);
		font-size: 0.72rem;
		color: rgba(232, 240, 244, 0.6);
		white-space: nowrap;
		/* the oldest line fades out at the left rather than being chopped */
		-webkit-mask-image: linear-gradient(90deg, transparent, #000 12%);
		mask-image: linear-gradient(90deg, transparent, #000 12%);
	}
	.pb-log :global(p) { margin: 0; animation: pb-login 0.3s ease both; }
	.pb-log :global(.ok) { color: #2ee889; }
	.pb-log :global(.info) { color: rgba(232, 240, 244, 0.6); }
	.pb-log :global(.accent) { color: var(--bu-acc); font-weight: 700; }
	@keyframes pb-login { from { opacity: 0; transform: translateY(4px); } }
	.pb-preview { flex: 1 1 auto; display: flex; flex-direction: column; min-height: 0; }
	.pb-preview-bar { display: flex; align-items: center; gap: 4px; padding: 8px 10px; background: rgba(255, 255, 255, 0.04); }
	.pb-preview-bar i { width: 7px; height: 7px; border-radius: 50%; background: rgba(255, 255, 255, 0.25); }
	.pb-preview-name { margin-left: 0.55rem; font-size: 0.76rem; font-weight: 800; color: #e8f0f4; white-space: nowrap; }
	.pb-preview-sector { margin-left: auto; font-style: normal; font-family: var(--bu-mono); font-size: 0.68rem; color: rgba(232, 240, 244, 0.5); white-space: nowrap; }
	.pb-preview-bar .pb-status { margin-left: 0.7rem; }
	.pb-preview-url { margin-left: 0.4rem; font-family: var(--bu-mono); font-size: 0.7rem; color: var(--bu-acc); transition: opacity 0.3s ease; }
	.pb-preview-img { position: relative; flex: 1 1 auto; display: block; overflow: hidden; min-height: clamp(16rem, 26vw, 23rem); background: #05070b; }
	.pb-preview-img img {
		position: absolute; inset: 0; width: 100%; height: 100%;
		object-fit: cover; object-position: top;
		opacity: 0; transform: scale(1.04);
		transition: opacity 0.5s ease, transform 0.6s ease;
	}
	.pb-preview-img img.is-on { opacity: 1; transform: none; }
	/* The sector label was free to wrap inside a flex row, so a two-word
	   sector broke around the status pill. Name and sector share a column,
	   the status keeps its own. */
	.pb-preview-meta {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		gap: 0.15rem 0.6rem;
		padding: 0.6rem 0.9rem;
		border-top: 1px solid rgba(255, 255, 255, 0.06);
	}
	.pb-preview-meta b {
		grid-column: 1;
		font-size: 0.82rem;
		font-weight: 800;
		color: #e8f0f4;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.pb-preview-meta em {
		grid-column: 1;
		grid-row: 2;
		min-width: 0;
		font-style: normal;
		font-family: var(--bu-mono);
		font-size: 0.7rem;
		color: rgba(232, 240, 244, 0.5);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.pb-status { grid-column: 2; grid-row: 1 / span 2; }
	.pb-status { display: inline-flex; align-items: center; gap: 0.35rem; font-family: var(--bu-mono); font-size: 0.7rem; color: #2ee889; white-space: nowrap; }
	.pb-status i { width: 7px; height: 7px; border-radius: 50%; background: #2ee889; animation: pb-live 2s ease-in-out infinite; }

	/* wall */
	.pb-wallhead { text-align: center; font-family: var(--bu-mono); font-size: 0.76rem; color: var(--bu-faint); margin: clamp(1.8rem, 4vw, 2.6rem) 0 0.9rem; }
	.pb-marquee {
		display: grid; gap: 0.8rem;
		margin-inline: calc(50% - 50vw);
		overflow: hidden;
		-webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
		mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
	}
	.pb-marquee-track { display: flex; gap: 0.8rem; width: max-content; animation: pb-scroll 60s linear infinite; }
	.pb-marquee-track--rev { animation-direction: reverse; }
	.pb-marquee:hover .pb-marquee-track { animation-play-state: paused; }
	@keyframes pb-scroll { to { transform: translateX(-50%); } }
	.pb-thumb {
		flex-shrink: 0; width: 210px; border-radius: 0.7rem; overflow: hidden;
		border: 1px solid color-mix(in srgb, var(--c, #18debe) 40%, rgba(255, 255, 255, 0.12));
		background: #0a0e15;
		transition: transform 0.25s ease, box-shadow 0.25s ease;
	}
	.pb-thumb:hover { transform: translateY(-4px) scale(1.03); box-shadow: 0 18px 36px -16px color-mix(in srgb, var(--c) 70%, transparent); }
	.pb-thumb-bar { display: flex; gap: 3px; padding: 5px 7px; background: rgba(255, 255, 255, 0.05); }
	.pb-thumb-bar i { width: 6px; height: 6px; border-radius: 50%; background: color-mix(in srgb, var(--c) 70%, #fff); opacity: 0.6; }
	.pb-thumb img { width: 100%; height: 108px; object-fit: cover; object-position: top; display: block; }
	@media (prefers-reduced-motion: reduce) { .pb-marquee-track { animation: none; } }

	/* the showreel, in a window of its own */
	.pb-reel {
		margin: 0;
		max-width: 62rem;
		margin-inline: auto;
		border-radius: 1rem;
		overflow: hidden;
		border: 1px solid color-mix(in srgb, var(--bu-acc) 26%, transparent);
		background: #0a0e14;
		box-shadow: 0 44px 92px -48px rgba(0, 0, 0, 0.85);
	}
	.pb-reel-bar {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.6rem 0.85rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.07);
		background: rgba(255, 255, 255, 0.025);
	}
	.pb-reel-name {
		margin-left: 0.45rem;
		font-family: var(--bu-mono);
		font-size: 0.74rem;
		color: rgba(214, 232, 238, 0.55);
	}
	.pb-reel-live {
		margin-left: auto;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-family: var(--bu-mono);
		font-size: 0.68rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--bu-acc) 78%, #fff);
	}
	.pb-reel-live i {
		width: 7px; height: 7px; border-radius: 9999px;
		background: #2ee889; box-shadow: 0 0 8px #2ee889;
		animation: pb-live 2s ease-in-out infinite;
	}
	.pb-reel :global(.pb-reel-film) { gap: 0; }
	.pb-reel :global(.pb-reel-film .flm__screen) {
		border: 0;
		border-radius: 0;
		box-shadow: none;
	}

	/* ── featured ─────────────────────────────────────────────────────
	   Nine case studies as alternating full-width rows is nine screens of
	   scrolling and one shape repeated nine times. They are a set, so they
	   are laid out as one: three across, three down, each a card with the
	   shot in a browser frame above its own write-up. */
	.pb-feats {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: clamp(0.9rem, 2vw, 1.3rem);
	}
	/* Seven does not divide by three, so the last card would sit alone in
	   a row with two empty cells beside it. When it is the odd one out it
	   takes the whole row and turns on its side — shot left, write-up
	   right — which reads as deliberate rather than as a gap. */
	@media (min-width: 720px) {
		.pb-feats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
