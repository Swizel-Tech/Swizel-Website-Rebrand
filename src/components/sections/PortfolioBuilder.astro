---
// Portfolio · Builder world — the same receipts as every other portfolio
// (marquee wall, numbers, featured case studies, Brevarium, the full
// sector-filtered grid, CTA) told as a deployments dashboard. Signature
// widget: a LIVE DEPLOY CONSOLE that ships real projects on a loop —
// terminal types the deploy, the preview pane swaps to the real product.
import { Icon } from 'astro-icon/components';
import { projects, featuredProjects, sectorLabels, sectorOrder, type ProjectSector } from '../../data/projects';

const sectors = sectorOrder;
const sectorShown: Record<ProjectSector, string> = {
	agri: '12+', health: '6+', property: '14+', media: '9+', commerce: '8+', product: '18+',
};
const totalShown = '65+';

const stats = [
	{ to: 65, suffix: '+', label: 'deployments' },
	{ to: 15, suffix: '+', label: 'sectors' },
	{ to: 7, suffix: '+', label: 'years shipping' },
	{ to: 99.9, decimals: 1, suffix: '%', label: 'uptime' },
];

// the console ships these on a loop (real projects with real screenshots)
const consoleProjects = ['hemam-synergy', 'betslipswitch', 'binas-residence', 'jobblander', 'anchorstep', 'trueverdict']
	.map((s) => projects.find((p) => p.slug === s))
	.filter(Boolean) as typeof projects;

const marquee = [...projects, ...projects];
const rot = [...projects.slice(6), ...projects.slice(0, 6)];
const marquee2 = [...rot, ...rot];

const dest = (p: (typeof projects)[number]) => (p.caseStudy ? `/work/${p.slug}` : p.url);
const sectorCursor: Record<ProjectSector, string> = { agri: 'branch', health: 'pulse', property: 'layers', media: 'book', commerce: 'pkg', product: 'repo' };
---

<div class="bpf bbody view-body view-body-builder">
	<div class="pb-bg" aria-hidden="true">
		<span class="pb-orb pb-orb--a"></span>
		<span class="pb-orb pb-orb--b"></span>
		{Array.from({ length: 7 }).map((_, i) => (
			<i class="pb-spark" style={`--s:${i}`}></i>
		))}
	</div>

	<!-- ── 01 · hero: copy + THE DEPLOY CONSOLE ────────────── -->
	<section class="pb-sec" data-cursor="term">
		<div class="pb-wrap pb-hero">
			<div class="bb-rev">
				<span class="pb-kick">$ swizel deployments --list</span>
				<h1 class="pb-h pb-h--xl">Proof, in <span class="pb-acc">production.</span></h1>
				<p class="pb-p">
					Real products, live on the internet. Watch the console ship
					them, then browse every deployment below.
				</p>
				<ul class="pb-stats">
					{
						stats.map((s) => (
							<li>
								<strong data-count={s.to} data-suffix={s.suffix} data-decimals={s.decimals || 0}>0{s.suffix}</strong>
								<span>{s.label}</span>
							</li>
						))
					}
				</ul>
				<div class="pb-row">
					<a href="#pb-featured" class="pb-merge fs-cta">
						<Icon width={17} name="mdi:rocket-launch-outline" />
						See the headliners
					</a>
					<a href="#pb-work" class="pb-link">
						Browse everything
						<Icon width={15} name="mdi:arrow-down" />
					</a>
				</div>
			</div>

			<!-- the live deploy console -->
			<div class="pb-console bb-rev" id="pb-console" data-fa-tilt="3">
				<span class="bb-glare" aria-hidden="true"></span>
				<div class="pb-winbar">
					<span class="pb-dot pb-dot--r"></span>
					<span class="pb-dot pb-dot--y"></span>
					<span class="pb-dot pb-dot--g"></span>
					<span class="pb-wintitle">swizel — deploy console</span>
					<span class="pb-win-live"><i></i>shipping on loop</span>
				</div>
				<div class="pb-console-grid">
					<div class="pb-term">
						<p class="pb-tline"><span class="pb-prompt">$</span> <span id="pb-cmd"></span><span class="pb-caret" aria-hidden="true"></span></p>
						<div class="pb-bar"><span class="pb-fill" id="pb-fill"></span></div>
						<div class="pb-log" id="pb-log"></div>
					</div>
					<div class="pb-preview">
						<span class="pb-preview-bar">
							<i></i><i></i><i></i>
							<span class="pb-preview-url" id="pb-url">…</span>
						</span>
						<span class="pb-preview-img">
							{
								consoleProjects.map((p, i) => (
									<img
										src={p.img}
										alt={p.name}
										loading={i === 0 ? 'eager' : 'lazy'}
										data-pb-shot={p.slug}
										class:list={[{ 'is-on': i === 0 }]}
									/>
								))
							}
						</span>
						<span class="pb-preview-meta">
							<b id="pb-name">{consoleProjects[0]?.name}</b>
							<em id="pb-sector">{sectorLabels[consoleProjects[0]?.sector]}</em>
							<span class="pb-status" id="pb-status"><i></i>Ready · Production</span>
						</span>
					</div>
				</div>
				{
					consoleProjects.map((p) => (
						<span
							class="pb-data"
							hidden
							data-pb-project
							data-slug={p.slug}
							data-name={p.name}
							data-host={p.host}
							data-sector={sectorLabels[p.sector]}
						/>
					))
				}
			</div>
		</div>

		<!-- full-bleed wall of work -->
		<div class="pb-wallhead bb-rev">// a wall of deployments, on loop</div>
		<div class="pb-marquee bb-rev" aria-hidden="true">
			<div class="pb-marquee-track">
				{
					marquee.map((p) => (
						<a href={dest(p) ?? undefined} data-leaving={p.caseStudy ? undefined : p.host} data-leaving-name={p.caseStudy ? undefined : p.name} class="pb-thumb" style={`--c:${p.color}`} tabindex="-1">
							<span class="pb-thumb-bar"><i></i><i></i><i></i></span>
							<img src={p.img} alt="" loading="eager" decoding="async" />
						</a>
					))
				}
			</div>
			<div class="pb-marquee-track pb-marquee-track--rev">
				{
					marquee2.map((p) => (
						<a href={dest(p) ?? undefined} data-leaving={p.caseStudy ? undefined : p.host} data-leaving-name={p.caseStudy ? undefined : p.name} class="pb-thumb" style={`--c:${p.color}`} tabindex="-1">
							<span class="pb-thumb-bar"><i></i><i></i><i></i></span>
							<img src={p.img} alt="" loading="eager" decoding="async" />
						</a>
					))
				}
			</div>
		</div>
	</section>

	<!-- ── 02 · featured case studies ──────────────────────── -->
	<section class="pb-sec" id="pb-featured" data-cursor="repo">
		<div class="pb-wrap">
			<div class="pb-head bb-rev">
				<span class="pb-kick">// featured — the long reads</span>
				<h2 class="pb-h">Post-mortems worth <span class="pb-acc">reading.</span></h2>
			</div>
			<div class="pb-feats">
				{
					featuredProjects.map((p, i) => (
						<article
							class:list={['pb-feat', 'bb-rev', { 'pb-feat--rev': i % 2 === 1 }]}
							style={`--c:${p.color}`}
							data-cursor={sectorCursor[p.sector]}
						>
							<a
								class:list={['pb-shot', { 'pb-shot--app': p.kind === 'app' }]}
								href={`/work/${p.slug}`}
								aria-label={`${p.name} case study`}
								data-fa-tilt="6"
							>
								{p.kind !== 'app' && (
									<span class="pb-bar2" aria-hidden="true">
										<i></i><i></i><i></i>
										<span class="pb-url2">{p.host}</span>
									</span>
								)}
								<span class="pb-img"><img src={p.img} alt={p.name} loading={i === 0 ? 'eager' : 'lazy'} /></span>
							</a>
							<div class="pb-feat-body">
								<span class="pb-feat-eyebrow">
									<span class="pb-live-dot" aria-hidden="true"></span>
									deploy #{String(i + 1).padStart(2, '0')} · {sectorLabels[p.sector]}
								</span>
								<h3>{p.name}</h3>
								<p class="pb-feat-tagline">{p.tagline}</p>
								<p class="pb-feat-blurb">{p.blurb}</p>
								<span class="pb-tags">
									{p.tags.map((t) => <i>{t}</i>)}
								</span>
								<a class="pb-link" href={`/work/${p.slug}`}>
									cat case-study.md
									<Icon width={15} name="mdi:arrow-right" />
								</a>
							</div>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<!-- ── 03 · docs/ — the Brevarium ──────────────────────── -->
	<section class="pb-sec" data-cursor="repo">
		<div class="pb-wrap">
			<div class="pb-mags bb-rev">
				<a class="pb-mag" href="/brevarium/the-brevarium-latest.pdf" download data-fa-tilt="7">
					<span class="pb-mag-cover"><img src="/images/portfolio/mag-latest-cover.jpg" alt="The Brevarium — latest edition" loading="lazy" /></span>
					<span class="pb-mag-meta">
						<span class="pb-kick">// docs/the-brevarium — latest</span>
						<strong>The Brevarium</strong>
						<em>Featured projects, the team & how we ship. Free, cover to cover.</em>
						<span class="pb-link"><Icon width={15} name="mdi:download" /> download.pdf</span>
					</span>
				</a>
				<a class="pb-mag" href="/The Brevarium by Swizel.pdf" download data-fa-tilt="7">
					<span class="pb-mag-cover"><img src="/images/portfolio/mag-v1-cover.jpg" alt="The Brevarium — Vol. 1" loading="lazy" /></span>
					<span class="pb-mag-meta">
						<span class="pb-kick">// docs/the-brevarium — v1.0.0</span>
						<strong>The Brevarium · Vol. 1</strong>
						<em>The AppMan story, a full product, start to finish.</em>
						<span class="pb-link"><Icon width={15} name="mdi:download" /> download.pdf</span>
					</span>
				</a>
			</div>
		</div>
	</section>

	<!-- ── 04 · every deployment — sector filter ───────────── -->
	<section class="pb-sec" id="pb-work" data-cursor="repo">
		<div class="pb-wrap">
			<div class="pb-head bb-rev">
				<span class="pb-kick">$ swizel ls --filter=sector</span>
				<h2 class="pb-h">Every <span class="pb-acc">deployment.</span></h2>
				<p class="pb-p pb-p--center">
					We've shipped <strong>{totalShown}</strong> products across
					<strong>15+</strong> sectors. ~{projects.length} favourites
					below, filter away.
				</p>
			</div>

			<form class="pb-filter" autocomplete="off">
				<input class="pb-radio" type="radio" name="pbf" id="pbf-all" checked />
				{sectors.map((s) => <input class="pb-radio" type="radio" name="pbf" id={`pbf-${s}`} />)}
				<div class="pb-chips bb-rev">
					<label class="pb-chip" for="pbf-all">--all <span>{totalShown}</span></label>
					{
						sectors.map((s) => (
							<label class="pb-chip" for={`pbf-${s}`}>
								--{s} <span>{sectorShown[s]}</span>
							</label>
						))
					}
				</div>
				<div class="pb-grid">
					{
						projects.map((p) => {
							const href = dest(p);
							const hasCase = !!p.caseStudy;
							const Tag = href ? 'a' : 'div';
							return (
								<article class:list={['pb-card', 'bb-rev', `s-${p.sector}`]} style={`--c:${p.color}`} data-cursor={sectorCursor[p.sector]}>
									<Tag
										class="pb-card-link"
										href={href ?? undefined}
										data-leaving={href && !hasCase ? p.host : undefined}
										data-leaving-name={href && !hasCase ? p.name : undefined}
										rel={href && !hasCase ? 'noopener noreferrer' : undefined}
										aria-label={p.name}
									>
										<span class:list={['pb-cshot', { 'pb-cshot--app': p.kind === 'app' }]}>
											<span class="pb-cimg"><img src={p.img} alt={p.name} loading="lazy" /></span>
											{hasCase && <span class="pb-badge">case study</span>}
										</span>
										<span class="pb-card-body">
											<span class="pb-card-head">
												<strong>{p.name}</strong>
												<em>{p.year}</em>
											</span>
											<span class="pb-card-status"><i></i>Ready · Production · {sectorLabels[p.sector]}</span>
											<span class="pb-tags">
												{p.tags.map((t) => <i>{t}</i>)}
											</span>
										</span>
									</Tag>
								</article>
							);
						})
					}
					<a class="pb-card pb-next s-agri s-health s-property s-media s-commerce s-product" href="/contact" data-cursor="phone">
						<span class="pb-next-ic"><Icon width={24} name="mdi:rocket-launch-outline" /></span>
						<span class="pb-kick">// slot reserved</span>
						<strong>your-product.com</strong>
						<span class="pb-next-p">We've shipped <b>65+</b> across <b>15+</b> sectors. This deploy slot has your name on it.</span>
						<span class="pb-link">swizel deploy your-idea <Icon width={15} name="mdi:arrow-right" /></span>
					</a>
				</div>
			</form>
		</div>
	</section>

	<!-- ── 05 · CTA ────────────────────────────────────────── -->
	<section class="pb-sec pb-sec--last" data-cursor="phone">
		<div class="pb-cta bb-rev">
			<span class="pb-orbit" aria-hidden="true"><i></i><i></i><i></i></span>
			<p class="pb-cta-cmd">$ swizel deploy <span class="pb-acc">your-product</span> --prod</p>
			<h2 class="pb-h pb-h--xl">Next on this dashboard: yours.</h2>
			<p class="pb-p pb-p--center">
				Tell us what you have in mind. You'll have a reply within one
				business day.
			</p>
			<div class="pb-row pb-row--center">
				<a href="/contact" class="pb-merge fs-cta">
					<Icon width={18} name="mdi:source-merge" />
					Start your project
				</a>
				<a href="/services" class="pb-link">
					See what we do
					<Icon width={15} name="mdi:chevron-right" />
				</a>
			</div>
		</div>
	</section>
</div>

<style>
	.bpf {
		--bu-ink: #e8f0f4;
		--bu-muted: rgba(232, 240, 244, 0.62);
		--bu-faint: rgba(232, 240, 244, 0.4);
		--bu-acc: var(--view-accent, #18debe);
		--bu-line: rgba(255, 255, 255, 0.08);
		--bu-card: rgba(255, 255, 255, 0.03);
		--bu-mono: 'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace;
		font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI',
			Roboto, sans-serif;
		position: relative;
		isolation: isolate;
		background:
			radial-gradient(1000px 520px at 85% -4%, rgba(24, 222, 190, 0.1), transparent 60%),
			radial-gradient(800px 480px at 4% 42%, rgba(40, 166, 236, 0.07), transparent 60%),
			linear-gradient(180deg, #05080c 0%, #070d12 50%, #04070a 100%);
		color: var(--bu-ink);
		padding: clamp(3rem, 7vw, 5rem) clamp(1rem, 3vw, 2rem) clamp(2.5rem, 5vw, 4rem);
	}
	:global(html:not(.dark)) .bpf {
		--bu-ink: #102420;
		--bu-muted: rgba(16, 36, 32, 0.66);
		--bu-faint: rgba(16, 36, 32, 0.45);
		--bu-line: rgba(16, 36, 32, 0.1);
		--bu-card: rgba(16, 36, 32, 0.04);
		background:
			radial-gradient(1000px 520px at 85% -4%, rgba(24, 222, 190, 0.1), transparent 60%),
			linear-gradient(180deg, #f0faf7 0%, #e6f4ef 55%, #f0faf7 100%);
	}
	.pb-sec { position: relative; z-index: 1; padding-block: clamp(1.8rem, 4.5vw, 3.2rem); }
	.pb-sec--last { padding-bottom: clamp(3rem, 6vw, 4.5rem); }
	.pb-wrap { max-width: 74rem; margin: 0 auto; }

	.pb-bg { position: absolute; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
	.pb-orb { position: absolute; border-radius: 50%; filter: blur(70px); opacity: 0.4; animation: pb-orb-drift 17s ease-in-out infinite alternate; }
	.pb-orb--a { width: 440px; height: 440px; left: -150px; top: 5%; background: radial-gradient(circle, rgba(24, 222, 190, 0.28), transparent 70%); }
	.pb-orb--b { width: 500px; height: 500px; right: -170px; top: 44%; background: radial-gradient(circle, rgba(40, 166, 236, 0.18), transparent 70%); animation-delay: -7s; }
	@keyframes pb-orb-drift { to { transform: translate3d(52px, -38px, 0) scale(1.1); } }
	.pb-spark {
		position: absolute; bottom: -12px; left: calc(10% + var(--s) * 12%);
		width: 3.5px; height: 3.5px; border-radius: 50%;
		background: color-mix(in srgb, var(--bu-acc) 85%, #fff);
		box-shadow: 0 0 10px 2px color-mix(in srgb, var(--bu-acc) 55%, transparent);
		opacity: 0;
		animation: pb-rise calc(9s + var(--s) * 1.4s) linear infinite;
		animation-delay: calc(var(--s) * -1.9s);
	}
	@keyframes pb-rise {
		0% { transform: translateY(0); opacity: 0; }
		8% { opacity: 0.75; }
		92% { opacity: 0.2; }
		100% { transform: translateY(-105vh) translateX(24px); opacity: 0; }
	}
	@media (prefers-reduced-motion: reduce) { .pb-orb { animation: none; } .pb-spark { display: none; } }

	.pb-kick { display: block; font-family: var(--bu-mono); font-size: 0.8rem; color: var(--bu-acc); margin-bottom: 0.8rem; }
	:global(html:not(.dark)) .bpf .pb-kick { color: #0b8a76; }
	.pb-h { font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 850; letter-spacing: -0.025em; line-height: 1.08; margin: 0 0 1rem; }
	.pb-h--xl { font-size: clamp(2rem, 4.4vw, 3.2rem); }
	.pb-acc {
		background: linear-gradient(95deg, #8dfeea, var(--bu-acc) 60%, #28a6ec);
		-webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
	}
	:global(html:not(.dark)) .bpf .pb-acc { background: linear-gradient(95deg, #0b8a76, #0d7fb8); -webkit-background-clip: text; background-clip: text; }
	.pb-p { font-size: 1rem; line-height: 1.65; color: var(--bu-muted); max-width: 34rem; margin: 0 0 1.3rem; }
	.pb-p--center { margin-inline: auto; text-align: center; }
	.pb-head { text-align: center; max-width: 46rem; margin: 0 auto clamp(1.4rem, 3vw, 2rem); }
	.pb-head .pb-kick { text-align: center; }
	.pb-link { display: inline-flex; align-items: center; gap: 0.45rem; font-weight: 700; color: var(--bu-acc); transition: gap 0.25s ease; }
	.pb-link:hover { gap: 0.75rem; }
	:global(html:not(.dark)) .bpf .pb-link { color: #0b8a76; }
	.pb-row { display: flex; align-items: center; gap: 1.3rem; flex-wrap: wrap; }
	.pb-row--center { justify-content: center; }
	.pb-merge {
		position: relative; overflow: hidden;
		display: inline-flex; align-items: center; gap: 0.55rem;
		font-weight: 800; font-size: 0.95rem; color: #04211a;
		background: linear-gradient(95deg, #8dfeea, var(--bu-acc) 60%, #28a6ec);
		padding: 0.85rem 1.6rem; border-radius: 9999px;
		box-shadow: 0 16px 38px -14px color-mix(in srgb, var(--bu-acc) 80%, transparent);
		transition: transform 0.22s ease;
	}
	.pb-merge:hover { transform: translateY(-2px); }

	.bb-rev {
		opacity: 0; transform: translateY(20px);
		transition: opacity 0.6s ease calc(var(--i, 0) * 90ms),
			transform 0.6s cubic-bezier(0.22, 1, 0.36, 1) calc(var(--i, 0) * 90ms);
	}
	.bb-rev.is-on { opacity: 1; transform: none; }
	@media (prefers-reduced-motion: reduce) { .bb-rev { opacity: 1; transform: none; transition: none; } }
	.bb-glare {
		position: absolute; inset: 0; border-radius: inherit; z-index: 3;
		background: radial-gradient(360px 230px at var(--gx, 50%) var(--gy, 0%), rgba(255, 255, 255, 0.07), transparent 60%);
		opacity: 0; transition: opacity 0.3s ease; pointer-events: none;
	}
	.pb-console:hover .bb-glare { opacity: 1; }

	/* hero */
	.pb-hero { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: clamp(2rem, 4vw, 3rem); align-items: center; }
	.pb-stats { display: flex; align-items: stretch; margin: 1.5rem 0 1.4rem; padding: 0; list-style: none; }
	.pb-stats li { flex: 1; min-width: 0; padding: 0.2rem 0.85rem; border-left: 1px solid color-mix(in srgb, var(--bu-acc) 25%, transparent); transition: transform 0.25s ease; }
	.pb-stats li:first-child { padding-left: 0; border-left: 0; }
	.pb-stats li:hover { transform: translateY(-3px); }
	.pb-stats strong {
		display: block; font-family: var(--bu-mono); font-weight: 700; white-space: nowrap;
		font-size: clamp(1.2rem, 2.1vw, 1.6rem);
		background: linear-gradient(135deg, #8dfeea, var(--bu-acc));
		-webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
	}
	:global(html:not(.dark)) .bpf .pb-stats strong { background: linear-gradient(135deg, #0b8a76, #0d7fb8); -webkit-background-clip: text; background-clip: text; }
	.pb-stats span { display: block; font-size: 0.7rem; line-height: 1.3; color: var(--bu-muted); margin-top: 0.2rem; }

	/* ── THE DEPLOY CONSOLE ── */
	.pb-console {
		position: relative; overflow: hidden;
		border-radius: 1rem; border: 1px solid color-mix(in srgb, var(--bu-acc) 24%, var(--bu-line));
		background: #0a0e15;
		box-shadow: 0 34px 80px -32px rgba(0, 0, 0, 0.8);
		transform-style: preserve-3d; will-change: transform;
	}
	.pb-winbar { display: flex; align-items: center; gap: 6px; padding: 10px 12px; background: rgba(255, 255, 255, 0.05); }
	.pb-dot { width: 10px; height: 10px; border-radius: 50%; }
