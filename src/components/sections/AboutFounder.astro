---
// About page · Founder world — the Swizel story told founder to founder.
// Root carries `fbody` so the shared founderBody.ts engine (reveals via
// .fd-rev, counters via [data-count]) animates this page for free.
// Foundational content mirrors AboutBoardroom (same team, same years,
// same client voices) — only the telling changes per view.
import { Icon } from 'astro-icon/components';
import { teamDetails } from '../../consts';

// Same crew as the Boardroom About, founder-style presentation.
const teamOrder = [
	{ name: 'Azoro', role: 'Business Development Lead' },
	{ name: 'Ruke', role: 'Product Manager' },
	{ name: 'Dennis', role: 'UI/UX Designer' },
	{ name: 'Mary', role: 'Software Engineer' },
	{ name: 'Stephen', role: 'Fullstack Developer' },
	{ name: 'Nathaniel', role: 'Frontend Developer' },
	{ name: 'Precious', role: 'Mobile Developer' },
	{ name: 'Linda', role: 'Marketing Lead' },
];
const team = teamOrder.map((m) => {
	const d = (teamDetails as any[]).find((t) => t.name === m.name) || {};
	return {
		...m,
		bio: d.bio || '',
		experience: (d.experience || []) as { company: string; jobDesc: string }[],
		linkedin: d.linkedinURL && d.linkedinURL !== '#' ? d.linkedinURL : '',
	};
});

// The Brevarium — same editions as the Boardroom About, free to download.
const brevariumEditions = [
	{ vol: 'Vol. 3', date: 'Latest · 2026', latest: true, href: '/brevarium/the-brevarium-latest.pdf' },
	{ vol: 'Vol. 2', date: '2025', latest: false, href: '/The Brevarium by Swizel.pdf' },
	{ vol: 'Vol. 1', date: '2024', latest: false, href: '/The Brevarium by Swizel.pdf' },
];

// Same client voices as the Boardroom About.
const quotes = [
	{
		text: 'Warm, responsive and a true extension of our team. They took the worry out of shipping software.',
		name: 'Chidimma',
		role: 'Client, education sector',
		img: '/testimonial/chidima.jpeg',
	},
	{
		text: 'Geniuses, honestly. Working with them was effortless from the first call to launch day.',
		name: 'Favour',
		role: 'Client, marketing',
		img: '/testimonial/favour.jpeg',
	},
	{
		text: 'Thorough, polite and always on time. They make hard things feel easy.',
		name: 'Cheta',
		role: 'Client, e-commerce',
		img: '/testimonial/cheta.jpeg',
	},
];

const stats = [
	{ to: 7, suffix: '+', label: 'years shipping' },
	{ to: 25, suffix: '+', label: 'builders on the crew' },
	{ to: 65, suffix: '+', label: 'products live' },
	{ to: 10, suffix: '+', label: 'countries' },
];

// Same real milestones as the Boardroom timeline, compressed founder-style.
const journey = [
	{
		tag: 'Day 0 · 2019',
		title: 'A conviction, not a company.',
		desc: 'Swizel starts in Nigeria. African businesses deserve world-class software, and a small stubborn crew starts building it.',
	},
	{
		tag: '2020',
		title: 'Products ship. Clients stay.',
		desc: 'We stop thinking in projects and start thinking in products. Early builds turn into long-term partnerships.',
	},
	{
		tag: '2022 – 2023',
		title: 'Every discipline, one roof.',
		desc: 'Mobile joins the practice and the work spreads across fintech, real estate, sports, education and logistics. One senior team, no juggling agencies.',
	},
	{
		tag: '2025',
		title: 'Teaching the next ones.',
		desc: 'We open a free tech bootcamp, training new engineers, designers and marketers on real products.',
	},
	{
		tag: 'Today',
		title: '65+ products, 10+ countries.',
		desc: 'From Abuja to Cork to London to New York, and we are only warming up.',
	},
];

const values = [
	{
		icon: 'mdi:account-star-outline',
		title: 'Senior hands only',
		desc: 'The people in the first call are the people who build your product. No hand-offs to juniors.',
	},
	{
		icon: 'mdi:eye-outline',
		title: 'You see everything',
		desc: 'Weekly demos, shared boards and honest status. No black box between you and your build.',
	},
	{
		icon: 'mdi:file-sign',
		title: 'Honest numbers',
		desc: 'Scope, timeline and price in writing before Week 1. If something changes, you hear it first.',
	},
	{
		icon: 'mdi:lifebuoy',
		title: 'We stay after launch',
		desc: 'Maintenance, growth and a team on call. Launch day is the starting gun, not the goodbye.',
	},
];
---

<div class="fabout fbody view-body view-body-founder">
	<!-- ── ambient stage: drifting orbs + rising sparks + aura ── -->
	<div class="fa-bg" aria-hidden="true">
		<span class="fa-orb fa-orb--a"></span>
		<span class="fa-orb fa-orb--b"></span>
		<span class="fa-orb fa-orb--c"></span>
		<span class="fa-aura"></span>
		{Array.from({ length: 9 }).map((_, i) => (
			<i class="fa-spark" style={`--s:${i}`}></i>
		))}
	</div>

	<!-- ── A · who we are ─────────────────────────────────── -->
	<section class="fa-sec">
		<div class="fa-wrap fa-open">
			<div class="fa-copy fd-rev">
				<span class="fa-stamp">About Swizel · Founder mode</span>
				<h2 class="fa-h fa-h--xl">Built by builders, <em>for builders.</em></h2>
				<p class="fa-p">
					Swizel is the senior product team founders call when the idea
					is bigger than the runway. Design, engineering and growth under
					one roof, shipping for seven years and counting.
				</p>
				<ul class="fa-stats">
					{
						stats.map((s) => (
							<li>
								<strong data-count={s.to} data-suffix={s.suffix}>
									0{s.suffix}
								</strong>
								<span>{s.label}</span>
							</li>
						))
					}
				</ul>
			</div>

			<div class="fa-visual fd-rev">
				<figure class="fa-photo" data-fa-tilt="9">
					<img
						src="/images/hero-team.jpg"
						alt="The Swizel team"
						loading="lazy"
						width="640"
						height="480"
					/>
					<span class="fa-photo-glare" aria-hidden="true"></span>
					<figcaption class="fa-photo-tag">
						The crew behind 65+ launches
					</figcaption>
				</figure>
				<span class="fa-chip fa-chip--a">🚀 6 wks to MVP</span>
				<span class="fa-chip fa-chip--b">🌍 10+ countries</span>
				<span class="fa-chip fa-chip--c">⚡ Weekly demos</span>
			</div>
		</div>

		<!-- kinetic proof marquee -->
		<div class="fa-marquee fd-rev" aria-hidden="true">
			<div class="fa-marquee-track">
				{
					Array.from({ length: 2 }).map(() => (
						<span class="fa-marquee-seq">
							<i>Zero to MVP in 6 weeks</i><b>✦</b>
							<i>65+ products live</i><b>✦</b>
							<i>10+ countries</i><b>✦</b>
							<i>Senior team only</i><b>✦</b>
							<i>You imagine, we build</i><b>✦</b>
							<i>Weekly demos, no black box</i><b>✦</b>
						</span>
					))
				}
			</div>
		</div>
	</section>

	<!-- ── B · mission ────────────────────────────────────── -->
	<section class="fa-sec" data-cursor="chart">
		<div class="fa-mission-ring fd-rev">
			<blockquote class="fa-mission">
				<p>
					We exist to drive the digitalisation of
					<em>African business.</em>
				</p>
			</blockquote>
		</div>
	</section>

	<!-- ── C · the journey ────────────────────────────────── -->
	<section class="fa-sec" data-cursor="clock">
		<div class="fa-wrap">
			<div class="fa-head fd-rev">
				<span class="fa-stamp">The journey</span>
				<h2 class="fa-h">Founder to founder, <em>the short version.</em></h2>
			</div>

			<ol class="fa-journey">
				<span class="fa-journey-line" aria-hidden="true"></span>
				{
					journey.map((j, i) => (
						<li class="fa-stop fd-rev" style={`--i:${i}`}>
							<span class="fa-stop-node" aria-hidden="true" />
							<span class="fa-stop-tag">{j.tag}</span>
							<h3 class="fa-stop-t">{j.title}</h3>
							<p class="fa-stop-d">{j.desc}</p>
						</li>
					))
				}
				<li class="fa-stop fa-stop--next fd-rev" style="--i:5">
					<span class="fa-stop-node" aria-hidden="true"></span>
					<span class="fa-stop-tag">Next stop</span>
					<h3 class="fa-stop-t">Your product.</h3>
					<p class="fa-stop-d">
						This chapter is yours to write. We bring the crew.
					</p>
					<a href="/contact" class="fa-link">
						Start Week 1
						<Icon width={15} name="mdi:arrow-right" />
					</a>
				</li>
			</ol>
		</div>
	</section>

	<!-- ── D · how we work ────────────────────────────────── -->
	<section class="fa-sec">
		<div class="fa-wrap">
			<div class="fa-head fd-rev">
				<span class="fa-stamp">How we work</span>
				<h2 class="fa-h">What founders <em>feel on day one.</em></h2>
			</div>

			<div class="fa-values">
				{
					values.map((v, i) => (
						<article class="fa-val fd-rev" style={`--i:${i}`} data-fa-tilt="12">
							<span class="fa-val-glare" aria-hidden="true" />
							<span class="fa-val-ic">
								<Icon width={22} name={v.icon} />
							</span>
							<h3 class="fa-val-t">{v.title}</h3>
							<p class="fa-val-d">{v.desc}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<!-- ── E · the team (same crew as the Boardroom About) ── -->
	<section class="fa-sec" data-cursor="play">
		<div class="fa-wrap">
			<div class="fa-head fd-rev">
				<span class="fa-stamp">The crew</span>
				<h2 class="fa-h">The people who'll <em>build with you.</em></h2>
				<p class="fa-p fa-p--center">
					No hand-offs, no mystery contractors. These are the builders
					on your product.
				</p>
			</div>

			<ul class="fa-team">
				{
					team.map((t, i) => (
						<li class="fa-mate-cell" style={`--i:${i % 4}`}>
							<button
								type="button"
								class="fa-mate fd-rev"
								style={`--i:${i % 4}`}
								data-fa-tilt="14"
								data-fa-member
								data-name={t.name}
								data-role={t.role}
								data-bio={t.bio}
								data-linkedin={t.linkedin}
								data-exp={JSON.stringify(t.experience)}
								aria-label={`View ${t.name}'s profile`}
							>
								<span class="fa-mate-ring" aria-hidden="true" />
								<span class="fa-mate-photo">
									<img
										src={`/teammates/${t.name}.jpg`}
										alt={t.name}
										loading="lazy"
										width="240"
										height="240"
									/>
								</span>
								<strong class="fa-mate-name">{t.name}</strong>
								<span class="fa-mate-role">{t.role}</span>
								<span class="fa-mate-view">
									View profile
									<Icon width={13} name="mdi:arrow-top-right" />
								</span>
							</button>
						</li>
					))
				}
			</ul>

			<div class="fa-join fd-rev">
				<div>
					<strong>We're always hiring builders.</strong>
					<span>Designers, engineers and marketers, come build real products with us.</span>
				</div>
				<a href="/contact" class="fa-cta fa-cta--sm">
					Join the team
					<Icon width={15} name="mdi:arrow-right" />
				</a>
			</div>
		</div>
	</section>

	<!-- Team profile modal (filled on click) -->
	<div class="fa-modal" id="fa-member-modal" hidden>
		<div class="fa-modal-overlay" data-fa-modal-close></div>
		<div class="fa-modal-card" role="dialog" aria-modal="true" aria-labelledby="fa-modal-name">
			<button type="button" class="fa-modal-x" data-fa-modal-close aria-label="Close">
				<Icon width={20} name="mdi:close" />
			</button>
			<div class="fa-modal-body">
				<div class="fa-modal-side">
					<div class="fa-modal-photo"><img id="fa-modal-photo" src="" alt="" /></div>
					<h3 class="fa-modal-name" id="fa-modal-name"></h3>
					<p class="fa-modal-role" id="fa-modal-role"></p>
					<a class="fa-modal-linkedin" id="fa-modal-linkedin" href="#" target="_blank" rel="noopener noreferrer" hidden>
						<Icon width={18} name="linkedin" />
						Connect on LinkedIn
					</a>
				</div>
				<div class="fa-modal-main">
					<span class="fa-stamp fa-stamp--sm">Bio</span>
					<p class="fa-modal-bio" id="fa-modal-bio"></p>
					<div id="fa-modal-exp-wrap" hidden>
						<span class="fa-stamp fa-stamp--sm">Experience</span>
						<ul class="fa-modal-exp" id="fa-modal-exp"></ul>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- ── E2 · inside Swizel: video + pictures (same as Boardroom) ── -->
	<section class="fa-sec" data-cursor="play">
		<div class="fa-wrap fa-inside">
			<div class="fa-inside-main fd-rev" data-fa-tilt="6">
				<div class="fa-media fa-media--tall">
					<span class="fa-media-sheen" aria-hidden="true"></span>
					<Icon width={36} name="mdi:play-circle-outline" />
					<span class="fa-media-label">Video placeholder</span>
					<span class="fa-media-sub">A day at the studio</span>
				</div>
				<div class="fa-inside-copy">
					<span class="fa-stamp">Inside Swizel</span>
					<h2 class="fa-h">A studio, <em>not a factory.</em></h2>
					<p class="fa-p">
						We share one room, one standard and a lot of coffee.
						Designers sit with engineers, marketers sit with both, so
						the thing we ship is the thing we all believed in.
					</p>
					<a href="/contact" class="fa-link">
						Work with us
						<Icon width={15} name="mdi:chevron-right" />
					</a>
				</div>
			</div>
			<div class="fa-inside-aside fd-rev" style="--i:1" data-fa-tilt="6">
				<div class="fa-media">
					<span class="fa-media-sheen" aria-hidden="true"></span>
					<Icon width={26} name="mdi:image-outline" />
					<span class="fa-media-label">Image placeholder</span>
					<span class="fa-media-sub">Bootcamp, in session</span>
				</div>
				<div class="fa-inside-copy">
					<h3 class="fa-h fa-h--sm">Education <em>at heart.</em></h3>
					<p class="fa-p">
						From our free bootcamp to The Brevarium, we put real skills
						in the hands of the next generation of builders.
					</p>
					<a href="/bootcamp" class="fa-link">
						See the bootcamp
						<Icon width={15} name="mdi:chevron-right" />
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- ── E3 · The Brevarium, our magazine (same as Boardroom) ── -->
	<section class="fa-sec" data-cursor="repo">
		<div class="fa-wrap">
			<div class="fa-brev fd-rev">
				<div class="fa-brev-cover" data-fa-tilt="10">
					<img
						src="/images/brevarium-cover.jpg"
						alt="The Brevarium by Swizel — latest edition"
						loading="lazy"
					/>
					<span class="fa-brev-shine" aria-hidden="true"></span>
				</div>
				<div class="fa-brev-copy">
					<span class="fa-stamp">The Brevarium</span>
					<h2 class="fa-h">Our magazine. <em>On us.</em></h2>
					<p class="fa-p">
						The Brevarium is Swizel's own publication, ideas, builds and
						lessons from the front line of African tech. We release a
						fresh edition at intervals, and every one is free to read.
					</p>
					<div class="fa-brev-actions">
						<a href="/brevarium/the-brevarium-latest.pdf" class="fa-cta fa-cta--sm" download>
							<Icon width={17} name="mdi:download" />
							Download latest edition
						</a>
						<span class="fa-brev-meta">PDF · free · new editions at intervals</span>
					</div>
					<div class="fa-brev-back">
						<span class="fa-brev-back-h">Back issues</span>
						<ul class="fa-brev-eds">
							{
								brevariumEditions.map((ed) => (
									<li>
										<a href={ed.href} download class="fa-brev-ed">
											<Icon width={18} name="mdi:file-document-outline" />
											<span class="fa-brev-ed-meta">
												<strong>The Brevarium · {ed.vol}</strong>
												<em>{ed.date}</em>
											</span>
											<Icon class="fa-brev-ed-dl" width={16} name="mdi:download" />
										</a>
									</li>
								))
							}
						</ul>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- ── F · client voices (same voices as the Boardroom About) ── -->
	<section class="fa-sec" data-cursor="quote">
		<div class="fa-wrap">
			<div class="fa-head fd-rev">
				<span class="fa-stamp">Founder to founder</span>
				<h2 class="fa-h">In their <em>words.</em></h2>
			</div>

			<div class="fa-quotes">
				{
					quotes.map((q, i) => (
						<figure class="fa-quote fd-rev" style={`--i:${i}`} data-fa-tilt="8">
							<span class="fa-quote-mark" aria-hidden="true">“</span>
							<blockquote>“{q.text}”</blockquote>
							<figcaption>
								<img src={q.img} alt={q.name} loading="lazy" width="44" height="44" />
								<span>
									<strong>{q.name}</strong>
									<em>{q.role}</em>
								</span>
							</figcaption>
						</figure>
					))
				}
			</div>
		</div>
	</section>

	<!-- ── G · CTA ────────────────────────────────────────── -->
	<section class="fa-sec fa-sec--last" data-cursor="phone">
		<div class="fa-cta-box fd-rev">
			<span class="fa-cta-orbit" aria-hidden="true">
				<i></i><i></i><i></i>
			</span>
			<h2 class="fa-h">Bring us <em>your Day 0.</em></h2>
			<p class="fa-p fa-p--center">
				Tell us what you imagine. Six weeks later, founders demo their
				product.
			</p>
			<div class="fa-cta-row">
				<a href="/contact" class="fa-cta">
					Start Week 1
					<Icon width={17} name="mdi:rocket-launch-outline" class="fa-cta-rocket" />
				</a>
				<a href="/portfolio" class="fa-link">
					See the launches
					<Icon width={15} name="mdi:arrow-right" />
				</a>
			</div>
		</div>
	</section>
</div>

<style>
	/* ── Founder world tokens (mirrors FounderBody) ── */
	.fabout {
		--fa-ink: #f1edfb;
		--fa-muted: rgba(241, 237, 251, 0.62);
		--fa-acc: var(--view-accent, #8b5cf6);
		--fa-acc2: #ec4899;
		--fa-line: rgba(255, 255, 255, 0.09);
		--fa-card: rgba(255, 255, 255, 0.035);
		font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI',
			Roboto, sans-serif;
		position: relative;
		isolation: isolate;
		background:
			radial-gradient(1000px 540px at 82% -6%, rgba(139, 92, 246, 0.16), transparent 62%),
			radial-gradient(820px 480px at 6% 44%, rgba(236, 72, 153, 0.08), transparent 60%),
			linear-gradient(180deg, #0a0714 0%, #0d0a18 50%, #080610 100%);
		color: var(--fa-ink);
		padding: clamp(3rem, 7vw, 5.5rem) clamp(1rem, 3vw, 2rem)
			clamp(2.5rem, 5vw, 4rem);
		transition: background 0.4s ease, color 0.4s ease;
	}
	:global(html:not(.dark)) .fabout {
		--fa-ink: #1d1430;
		--fa-muted: rgba(29, 20, 48, 0.66);
		--fa-acc: #6d3fe0;
		--fa-line: rgba(29, 20, 48, 0.1);
		--fa-card: rgba(29, 20, 48, 0.04);
		background:
			radial-gradient(1000px 540px at 82% -6%, rgba(139, 92, 246, 0.12), transparent 62%),
			linear-gradient(180deg, #f4f1fb 0%, #ece7f8 55%, #f4f1fb 100%);
	}

	.fa-sec { position: relative; z-index: 1; padding-block: clamp(2rem, 5vw, 3.5rem); }
	.fa-sec--last { padding-bottom: clamp(3rem, 6vw, 5rem); }
	.fa-wrap { max-width: 74rem; margin: 0 auto; }

	/* ── ambient stage: orbs drift, aura breathes, sparks rise ── */
	.fa-bg { position: absolute; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
	.fa-orb {
		position: absolute;
		border-radius: 50%;
		filter: blur(70px);
		opacity: 0.5;
		animation: fa-drift 16s ease-in-out infinite alternate;
	}
	.fa-orb--a { width: 460px; height: 460px; left: -140px; top: 4%; background: radial-gradient(circle, rgba(139, 92, 246, 0.34), transparent 70%); }
	.fa-orb--b { width: 520px; height: 520px; right: -180px; top: 32%; background: radial-gradient(circle, rgba(236, 72, 153, 0.2), transparent 70%); animation-delay: -6s; }
	.fa-orb--c { width: 420px; height: 420px; left: 28%; bottom: -6%; background: radial-gradient(circle, rgba(99, 102, 241, 0.24), transparent 70%); animation-delay: -11s; }
	@keyframes fa-drift {
		to { transform: translate3d(60px, -44px, 0) scale(1.12); }
	}
	.fa-aura {
		position: absolute;
		width: 1200px; height: 1200px;
		left: 50%; top: -420px;
		transform: translateX(-50%);
		background: conic-gradient(from 0deg, transparent, rgba(139, 92, 246, 0.07), transparent 32%, rgba(236, 72, 153, 0.05), transparent 65%);
		border-radius: 50%;
		animation: fa-spin 40s linear infinite;
	}
	@keyframes fa-spin { to { transform: translateX(-50%) rotate(360deg); } }
	.fa-spark {
		position: absolute;
		bottom: -12px;
		left: calc(6% + var(--s) * 10.5%);
		width: 4px; height: 4px;
		border-radius: 50%;
		background: color-mix(in srgb, var(--fa-acc) 85%, #fff);
		box-shadow: 0 0 10px 2px color-mix(in srgb, var(--fa-acc) 55%, transparent);
		opacity: 0;
		animation: fa-rise calc(9s + var(--s) * 1.3s) linear infinite;
