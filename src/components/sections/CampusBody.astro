---
// Campus view body — an actual school. Orientation day, a whiteboard with
// sticky notes, course registration, a roadmap to the job market, clubs &
// societies on a corkboard, a chalkboard that teaches you something, and
// an arcade START button at the end. School spirit, real outcomes.
import { Icon } from 'astro-icon/components';
import CampusJourney from '../CampusJourney.astro';
import CampusLibrary from '../CampusLibrary.astro';

const stats = [
	{ n: '3–6 mo', label: 'IT internship' },
	{ n: '12 mo', label: 'NYSC year' },
	{ n: '100%', label: 'live projects' },
	{ n: '65+', label: 'products shipped' },
];


const roadmap = [
	{ lvl: 'Week 1', xp: '+500 XP', title: 'Onboarding', desc: 'Meet your mentor, get your access, and pick up your first real ticket.' },
	{ lvl: 'Month 1', xp: '+1500 XP', title: 'On the product', desc: 'Live client work, reviewed line by line until it is good enough to merge.' },
	{ lvl: 'Mid-placement', xp: '+3000 XP', title: 'You ship', desc: 'Your work goes live, in front of the client and their actual users.' },
	{ lvl: 'Sign-off', xp: '🏆 HIRED', title: 'Job market', desc: 'A portfolio of shipped work, a reference, and our backing till you land it.' },
];

// the to-do board — school + life, balanced. Tickable, so it is a real
// list rather than a picture of one.
const todos = [
	{ icon: '📖', task: 'Read chapter 4', when: 'before Tuesday', done: true },
	{ icon: '🐍', task: 'Study Python', when: 'lab on Wednesday', done: false },
	{ icon: '⚛️', task: 'Test React build', when: 'push by Thursday', done: false },
	{ icon: '⚽', task: 'Play football', when: 'Saturday 4pm', done: true },
	{ icon: '🎤', task: 'Demo day prep', when: 'end of placement', done: false },
	{ icon: '😴', task: 'Sleep 8 hours', when: 'tonight. seriously', done: false },
];

// the pop quiz pinned next to it — five questions, red pen at the end
const quiz = [
	{
		q: 'What does HTML actually stand for?',
		a: ['HyperText Markup Language', 'How To Make Links', 'Home Tool Markup Language', 'Hyper Transfer Mail Link'],
		c: 0,
		why: 'Markup, not programming. It describes the page; it does not do the thinking.',
	},
	{
		q: 'A software “bug” got its name from…',
		a: ['A real moth taped into a logbook', 'A computer virus', 'A typing mistake', 'A fly on a monitor'],
		c: 0,
		why: 'Harvard, 1947. The moth is still taped to the page, and the page is in a museum.',
	},
	{
		q: 'In Git, what does a commit actually do?',
		a: ['Saves a snapshot of your changes', 'Uploads your work to the internet', 'Deletes your branch', 'Renames the project'],
		c: 0,
		why: 'Committing is local and yours. Push is the one that sends it to everybody else.',
	},
	{
		q: 'Which of these is CSS’s job?',
		a: ['Laying out and styling the page', 'Storing user accounts', 'Routing server requests', 'Running your tests'],
		c: 0,
		why: 'CSS decides how it looks. HTML decides what it is. JavaScript decides what it does.',
	},
	{
		q: 'It is 4pm on Friday and you just broke the build. First move?',
		a: ['Tell the team, then fix it', 'Say nothing and hope', 'Push another commit blindly', 'Log off, it is Friday'],
		c: 0,
		why: 'The one we grade hardest. Breaking things is fine here. Hiding it is not.',
	},
];

const facts = [
	'The first computer "bug" was a real moth, taped into a logbook at Harvard in 1947.',
	'JavaScript was written in just 10 days. It now runs most of the web.',
	'The first website ever made is still online at info.cern.ch. Go and visit it.',
	'Nigeria has more tech startups than any other country in Africa, and Abuja is rising fast.',
	'The first 1GB hard drive (1980) weighed over 250 kg. Your phone holds 256× more.',
];

// Six live client sites, straight from the portfolio data. Every one of
// these is up right now — the cards open the real thing, behind a
// you-are-leaving confirm.
const live = [
	{
		name: 'TrueVerdict',
		host: 'trueverdict.com.ng',
		url: 'https://trueverdict.com.ng/',
		what: 'An independent newsroom, online. Politics, business and investigative reporting, built to stay fast under a heavy content load.',
		img: '/images/portfolio/shot-trueverdict.jpg',
		tags: ['Website', 'CMS', 'Publishing'],
		hue: '#e0556b',
		span: 7,
	},
	{
		name: 'JobbLander',
		host: 'jobblander.com',
		url: 'https://jobblander.com/',
		what: 'A career platform where AI does the pattern-matching and humans do the judgement. A real product, not a landing page.',
		img: '/images/portfolio/shot-jobblander.jpg',
		tags: ['Product', 'AI', 'Web app'],
		hue: '#6366f1',
		span: 5,
	},
	{
		name: 'AnchorStep Physiotherapy',
		host: 'anchorsteppt.com',
		url: 'https://anchorsteppt.com/',
		what: 'A home visit physio practice in Abuja, taken from a blank page to a bookable brand, with the audience grown from zero.',
		img: '/images/portfolio/shot-anchorstep.jpg',
		tags: ['Website', 'Branding', 'Growth'],
		hue: '#2f8f6a',
		span: 5,
	},
	{
		name: 'Hemam Synergy',
		host: 'hemamsynergy.com',
		url: 'https://hemamsynergy.com/',
		what: 'Agritech lifting rural smallholder farmers, with a presence credible enough to help unlock roughly €850,000 in grant funding.',
		img: '/images/portfolio/shot-hemamsynergy.jpg',
		tags: ['Website', 'Branding', 'Hosting'],
		hue: '#2f9e44',
		span: 7,
	},
	{
		name: 'Binas Residence',
		host: 'binasresidence.com',
		url: 'https://binasresidence.com/',
		what: 'A luxury Abuja residence with a calm, upscale brand and a site whose whole job is turning a browser into a reservation.',
		img: '/images/portfolio/shot-binasresidence.jpg',
		tags: ['Website', 'Branding', 'Hospitality'],
		hue: '#c08a3e',
		span: 6,
	},
	{
		name: 'African Energy Advocacy Initiative',
		host: 'africaneai.org',
		url: 'https://africaneai.org/',
		what: 'Clean energy advocacy and consultancy. Solar lighting and efficient cookstoves for the communities that need them most.',
		img: '/images/portfolio/shot-africaneai.jpg',
		tags: ['Website', 'Energy', 'Non-profit'],
		hue: '#10b981',
		span: 6,
	},
];
const programs = [
	{ icon: 'mdi:badge-account-outline', title: 'SIWES / IT Internship', fee: 'apply', hot: true, href: '/programs#internship', desc: 'Do your three or six month industrial training on a live client product, with a mentor on your work every week.' },
	{ icon: 'mdi:flag-outline', title: 'NYSC Placement', fee: 'apply', hot: true, href: '/programs#nysc', desc: 'Serve your year with the team that ships. Real projects, real reviews, and a portfolio at the end of it.' },
];

const sectors = ['Fintech', 'Real estate', 'Sports', 'E-commerce', 'Education', 'Healthcare', 'Logistics', 'Beauty', 'Energy', 'Media', 'Travel'];
const logos = [
	'betslipswitch.svg',
	'trueverdict.png',
	'brix market logo.svg',
	'hemamsynergy.png',
	'purple-panda.svg',
	'saros-sgp.svg',
	'my eya homes.svg',
	'the-presidential-diary.png',
	'beauty-hive.png',
	'shuaproperties.svg',
	'ejike-fc.svg',
];

const achievements = [
	{ icon: 'mdi:shield-star-outline', title: 'Selective Intake', desc: 'A handful of seats each intake, so every place is earned.' },
	{ icon: 'mdi:account-heart-outline', title: 'Mentor Backed', desc: 'Guided by working engineers and designers.' },
	{ icon: 'mdi:rocket-launch-outline', title: 'Live Client Work', desc: 'Real products, real deadlines, real users on the other end.' },
	{ icon: 'mdi:briefcase-check-outline', title: 'Job-Ready Portfolio', desc: 'Finish with real, shipped projects to your name.' },
];

const voices = [
	{ name: 'Chidimma', img: '/testimonial/chidima.jpeg', body: 'The mentors actually care. I built things I am proud of.' },
	{ name: 'Russell', img: '/testimonial/russell.jpeg', body: 'Friendly, efficient and hands-on the whole way.' },
	{ name: 'Cheta', img: '/testimonial/cheta.jpeg', body: 'They made hard concepts click. Best decision I made.' },
];
---

<div class="cbody view-body view-body-campus">
	<!-- ── A · orientation day ─────────────────────────────── -->
	<section class="cp-sec cp-sec--open">
		<div class="cp-wrap cp-open">
			<div class="cp-copy cp-rev">
				<span class="cp-badge">🎓 Orientation · Next intake</span>
				<h2 class="cp-h cp-h--xl">Welcome to class. <em>Leave with a career.</em></h2>
				<p class="cp-p">
					Two ways in: your industrial training, or your service year.
					Both put you on a live client product beside the people who
					build it for a living. Both are applied for.
				</p>
				<ul class="cp-stats">
					{
						stats.map((s) => (
							<li>
								<strong>{s.n}</strong>
								<span>{s.label}</span>
							</li>
						))
					}
				</ul>
				<div class="cp-row">
					<a href="/programs" class="cp-cta">
						Start your application
						<Icon width={17} name="mdi:school-outline" />
					</a>
					<a href="#cp-quest" class="cp-link">
						See the roadmap
						<Icon width={15} name="mdi:chevron-down" />
					</a>
				</div>
			</div>

			<!-- the journey board: the game the hero used to hold, with room -->
			<div class="cp-game cp-rev" data-cursor="pen">
				<CampusJourney />
			</div>
		</div>
	</section>

	<!-- ── B · course registration ─────────────────────────── -->
	<section class="cp-sec cp-sec--courses" data-cursor="book">
		<span class="cp-courses-bg" aria-hidden="true"></span>
		<div class="cp-wrap">
			<div class="cp-head cp-rev">
				<span class="cp-badge">The prospectus</span>
				<h2 class="cp-h">Pick <em>your course.</em></h2>
				<p class="cp-p cp-p--center">
					Nine disciplines, printed and bound. It turns its own pages,
					or you can take the controls. Pull one out to read it properly.
				</p>
			</div>
			<div class="cp-rev">
				<CampusLibrary />
			</div>
		</div>
	</section>

	<!-- ── C · roadmap to the job market ───────────────────── -->
	<section class="cp-sec" id="cp-quest" data-cursor="book">
		<div class="cp-wrap">
			<div class="cp-head cp-rev">
				<span class="cp-badge">The roadmap</span>
				<h2 class="cp-h">First ticket <em>→ job market.</em></h2>
				<p class="cp-p cp-p--center">
					One placement, four checkpoints. XP is earned by shipping, never
					by watching videos.
				</p>
			</div>

			<ol class="cp-questline" id="cp-questline">
				<span class="cp-quest-bar" aria-hidden="true"></span>
				{
					roadmap.map((q, i) => (
						<li class="cp-stage cp-rev" style={`--i:${i}`}>
							<span class="cp-stage-node" aria-hidden="true">{i + 1}</span>
							<span class="cp-stage-lvl">{q.lvl} <em>{q.xp}</em></span>
							<h3 class="cp-stage-t">{q.title}</h3>
							<p class="cp-stage-d">{q.desc}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<!-- ── C2 · programs & admissions ──────────────────────── -->
	<section class="cp-sec" data-cursor="book">
		<div class="cp-wrap">
			<div class="cp-head cp-rev">
				<span class="cp-badge">Programs & admissions</span>
				<h2 class="cp-h">Two roads <em>into tech.</em></h2>
				<p class="cp-p cp-p--center">
					One if you are still in school, one if you are serving. Both
					put you on a live client product with a mentor on your work.
				</p>
			</div>
			<div class="cp-programs">
				{
					programs.map((g, i) => (
						<a href={g.href} class:list={['cp-program', 'cp-rev', { 'cp-program--hot': g.hot }]} style={`--i:${i}`}>
							<span class="cp-program-fee">{g.fee}</span>
							<span class="cp-program-ic">
								<Icon width={26} name={g.icon} />
							</span>
							<h3 class="cp-program-t">{g.title}</h3>
							<p class="cp-program-d">{g.desc}</p>
							<span class="cp-track-go">Apply ▸</span>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<!-- ── C3 · the archives ───────────────────────────────── -->
	<section class="cp-sec" data-cursor="play">
		<div class="cp-wrap">
			<div class="cp-head cp-rev">
				<span class="cp-badge">The archives</span>
				<h2 class="cp-h">Inside <em>the room.</em></h2>
				<p class="cp-p cp-p--center">
					Demo days, classes, late nights in the lab. This is what the
					placement actually looks like from the inside.
				</p>
			</div>
			<div class="cp-gallery cp-rev">
				<figure class="cp-shot cp-shot--wide cp-shot--photo">
					<img
						src="/images/campus/demo-day.jpg"
						alt="Swizel mentors and students reviewing a build together on demo day"
						loading="lazy"
					/>
					<span class="cp-tape" aria-hidden="true"></span>
					<figcaption class="cp-shot-cap">Demo day, the whole room on one build</figcaption>
				</figure>
				<figure class="cp-shot cp-shot--photo">
					<img
						src="/images/campus/class-in-session.jpg"
						alt="A class in session around the studio table at the Swizel campus in Abuja"
						loading="lazy"
					/>
					<span class="cp-tape" aria-hidden="true"></span>
					<figcaption class="cp-shot-cap">Class in session</figcaption>
				</figure>
				<figure class="cp-shot cp-shot--photo">
					<img
						src="/images/campus/the-lab.jpg"
						alt="Two Swizel builders pairing on a live product in the lab"
						loading="lazy"
					/>
					<span class="cp-tape" aria-hidden="true"></span>
					<figcaption class="cp-shot-cap">Pairing in the lab</figcaption>
				</figure>
				<div class="cp-shot">
					<Icon width={26} name="mdi:play-circle-outline" />
					<span class="cp-shot-name">demo-day.mp4 · video</span>
				</div>
				<div class="cp-shot">
					<Icon width={22} name="mdi:image-outline" />
					<span class="cp-shot-name">class-of-25.jpg</span>
				</div>
				<div class="cp-shot">
					<Icon width={22} name="mdi:image-outline" />
					<span class="cp-shot-name">hackathon-night.jpg</span>
				</div>
			</div>
		</div>
	</section>

	<!-- ── D · the board: a real week, and a pop quiz ───────── -->
	<section class="cp-sec" data-cursor="pen">
		<div class="cp-wrap">
			<div class="cp-head cp-rev">
				<span class="cp-badge">Campus life</span>
				<h2 class="cp-h">The board: <em>work, play, repeat.</em></h2>
				<p class="cp-p cp-p--center">
					School isn't only syllabus. Tick your week off, then sit the
					pop quiz. Nobody in this room gets full marks first try.
				</p>
			</div>

			<div class="cp-board cp-rev">
				<!-- left: the week, actually tickable -->
				<div class="cp-board-week">
					<h3 class="cp-board-t">
						This week <span>tap a note to tick it</span>
					</h3>
					<ul class="cp-todos" data-todos>
						{
							todos.map((c, i) => (
								<li>
									<button
										class:list={['cp-pin', { 'is-done': c.done }]}
										type="button"
										style={`--r:${(i % 3) - 1}`}
										data-todo
										aria-pressed={c.done ? 'true' : 'false'}
									>
										<span class="cp-pin-tack" aria-hidden="true">📌</span>
										<span class="cp-pin-icon">{c.icon}</span>
										<strong><i class="cp-check" aria-hidden="true" />{c.task}</strong>
										<em>{c.when}</em>
									</button>
								</li>
							))
						}
					</ul>
					<div class="cp-week">
						<span class="cp-week-bar" aria-hidden="true"><i data-week-fill /></span>
						<span class="cp-week-n" data-week-label>2 of 6 done</span>
						<button class="cp-week-reset" type="button" data-week-reset>
							clear the board
						</button>
					</div>
					<div class="cp-photos">
						<figure class="cp-photo" style="--r:-1">
							<span class="cp-pin-tack" aria-hidden="true">📌</span>
							<img src="/images/illustrations/crew-cheer.png" alt="The Swizel crew celebrating a shipped build" loading="lazy" />
							<figcaption>sports-day.jpg</figcaption>
						</figure>
						<figure class="cp-photo" style="--r:1">
							<span class="cp-pin-tack" aria-hidden="true">📌</span>
							<img src="/images/illustrations/workspace.png" alt="A Swizel workstation mid-build" loading="lazy" />
							<figcaption>late-night.jpg</figcaption>
						</figure>
					</div>
				</div>

				<!-- right: the pop quiz, pinned to the same board -->
				<div class="cp-quiz" data-quiz>
					<span class="cp-pin-tack cp-quiz-tack" aria-hidden="true">📌</span>
					<div class="cp-quiz-head">
						<span class="cp-quiz-ttl">Pop quiz</span>
						<span class="cp-quiz-name">Name: <i>________</i></span>
					</div>
					<div class="cp-quiz-body">
						{
							quiz.map((q, i) => (
								<div class:list={['cp-q', { 'is-live': i === 0 }]} data-q={i}>
									<p class="cp-q-t"><b>{i + 1}.</b> {q.q}</p>
									<ul class="cp-q-opts">
										{q.a.map((opt, oi) => (
											<li>
												<button
													class="cp-opt"
													type="button"
													data-opt={oi}
													data-right={oi === q.c ? '1' : '0'}
												>
													<i>{'ABCD'[oi]}</i>
													<span>{opt}</span>
												</button>
											</li>
										))}
									</ul>
									<p class="cp-q-why" hidden>{q.why}</p>
								</div>
							))
						}
						<div class="cp-q-done" data-result hidden>
							<span class="cp-grade" data-grade>A+</span>
							<p class="cp-grade-note" data-note />
							<button class="cp-retake" type="button" data-retake>
								<Icon width={15} name="mdi:refresh" />
								Sit it again
							</button>
						</div>
					</div>
					<div class="cp-quiz-foot">
						<span class="cp-quiz-dots" aria-hidden="true">
							{quiz.map((_, i) => <i class:list={[{ 'is-on': i === 0 }]} />)}
						</span>
						<span class="cp-quiz-xp" data-score>0 XP</span>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- ── E · the chalkboard teaches you something ────────── -->
	<section class="cp-sec" data-cursor="book">
		<div class="cp-wrap cp-chalkwrap">
			<div class="cp-copy cp-rev">
				<span class="cp-badge">Gen 101</span>
				<h2 class="cp-h">Learn something <em>right now.</em></h2>
				<p class="cp-p">
					Class is always in session. Real tech history, rotating on the
					board. The kind of trivia that wins arguments.
				</p>
			</div>
			<div class="cp-chalk cp-rev" id="cp-chalk">
				<span class="cp-chalk-head">DID YOU KNOW?</span>
				{
					facts.map((f, i) => (
						<p class:list={['cp-fact', { 'is-live': i === 0 }]} data-fact={i}>{f}</p>
					))
				}
				<span class="cp-chalk-count" id="cp-chalk-count">1 / {facts.length}</span>
				<span class="cp-chalk-tray">
					<button class="cp-chalk-btn" type="button" id="cp-chalk-prev" aria-label="Previous fact">
						<span class="cp-chalk-arrow" aria-hidden="true">&#8592;</span>
					</button>
					<button class="cp-chalk-btn cp-chalk-btn--y" type="button" id="cp-chalk-next" aria-label="Next fact">
						<span class="cp-chalk-arrow" aria-hidden="true">&#8594;</span>
						<span class="cp-chalk-hint" aria-hidden="true">next</span>
					</button>
				</span>
			</div>
		</div>
	</section>

	<!-- ── F · practicals: the live work wall ──────────────── -->
	<section class="cp-sec cp-sec--live" data-cursor="repo">
		<span class="cp-live-bg" aria-hidden="true"></span>
		<div class="cp-wrap">
			<div class="cp-head cp-rev">
				<span class="cp-badge">Practicals</span>
				<h2 class="cp-h">You'll build <em>real things.</em></h2>
				<p class="cp-p cp-p--center">
					Real products for real clients. Every platform below is
					currently live and operational, offering a clear preview of
					the production-grade work you will deliver. Explore any link
					to see our standard in action.
				</p>
				<span class="cp-live-note">
					Six live sites · real clients · tap one to visit
				</span>
			</div>

			<div class="cp-wall">
				{
					live.map((s, i) => (
						<a
							class="cp-live cp-rev"
							href={s.url}
							style={`--span:${s.span}; --ar:${s.span === 7 ? '16 / 10' : s.span === 5 ? '8 / 7' : '4 / 3'}; --hue:${s.hue}; --i:${i}`}
							data-live-site
							data-host={s.host}
							data-name={s.name}
							rel="noopener noreferrer"
						>
							<span class="cp-live-frame">
								<span class="cp-live-bar" aria-hidden="true">
									<i /><i /><i />
									<span class="cp-live-url">
										<Icon width={11} name="mdi:lock-outline" />
										{s.host}
									</span>
									<span class="cp-live-dot">live</span>
								</span>
								<span class="cp-live-shot">
									<img src={s.img} alt={`The ${s.name} website`} loading="lazy" />
								</span>
								<span class="cp-live-open" aria-hidden="true">
									Open the live site
									<Icon width={15} name="mdi:arrow-top-right" />
								</span>
							</span>
							<span class="cp-live-meta">
								<strong>{s.name}</strong>
								<em>{s.what}</em>
								<span class="cp-live-tags">
									{s.tags.map((t) => <i>{t}</i>)}
								</span>
							</span>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<!-- ── F2 · subjects & brands, drifting through ────────── -->
	<section class="cp-sec cp-sec--belts">
		<div class="cp-wrap">
			<p class="cp-belt-label cp-rev">Subjects we've shipped in</p>
		</div>
