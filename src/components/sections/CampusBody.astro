	/* Sections used to run into each other with nothing but whitespace
	   between them. Each one now opens on a hairline the width of the
	   content, with a small marker sitting on it, so the page reads as a
	   set of rooms rather than one long scroll. */
	.cp-sec {
		position: relative;
		padding-block: clamp(2.6rem, 6vw, 4.25rem);
	}
	.cp-sec + .cp-sec::before {
		content: '';
