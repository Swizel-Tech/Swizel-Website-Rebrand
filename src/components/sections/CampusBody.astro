		top: 0;
		left: 50%;
		transform: translateX(-50%);
		width: min(74rem, calc(100% - 2rem));
		height: 1px;
		background: linear-gradient(
			90deg,
			transparent,
			color-mix(in srgb, var(--cp-acc) 32%, transparent) 18%,
			color-mix(in srgb, var(--cp-acc) 32%, transparent) 82%,
			transparent
		);
	}
	.cp-sec + .cp-sec::after {
		content: '';
		position: absolute;
