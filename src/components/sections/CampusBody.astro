	}
	.cp-board-t span {
		font-family: 'Inter', sans-serif;
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: rgba(63, 42, 20, 0.55);
	}
	.cp-todos {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.cp-todos > li { display: flex; min-width: 0; }

	.cp-pin {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		text-align: left;
		gap: 0.15rem;
		width: 100%;
		padding: 1.25rem 0.9rem 0.8rem;
		border: 0;
		background: #fffdf5;
		color: #44403c;
		cursor: pointer;
		box-shadow: 0 12px 26px -10px rgba(0, 0, 0, 0.45);
		transform: rotate(calc(var(--r, 0) * 1.6deg));
		transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s ease;
	}
	.cp-pin:hover,
	.cp-pin:focus-visible {
		transform: rotate(0deg) scale(1.04);
		box-shadow: 0 18px 34px -12px rgba(0, 0, 0, 0.5);
		outline: none;
		z-index: 2;
	}
	.cp-pin:active { transform: rotate(0deg) scale(0.98); }
	.cp-pin-tack {
		position: absolute;
		top: -10px;
		left: 50%;
		transform: translateX(-50%) rotate(15deg);
		font-size: 1.15rem;
		filter: drop-shadow(0 3px 3px rgba(0, 0, 0, 0.3));
	}
	.cp-pin-icon { font-size: 1.4rem; line-height: 1; margin-bottom: 0.25rem; }
	.cp-pin strong {
		display: flex;
		align-items: baseline;
		gap: 0.35rem;
		font-family: var(--cp-marker);
		font-size: 1rem;
		text-align: left;
	}
	.cp-pin em { font-style: normal; font-size: 0.72rem; color: #78716c; }

	/* the tick and the strike-through, drawn as if by hand */
	.cp-check {
		flex: none;
		width: 0.85em;
		height: 0.85em;
		border: 2px solid #a8a29e;
		border-radius: 3px;
		position: relative;
	}
	.cp-pin.is-done .cp-check { border-color: #dc2626; }
	.cp-pin.is-done .cp-check::after {
		content: '';
		position: absolute;
		left: 12%;
		top: -30%;
		width: 60%;
		height: 95%;
		border-right: 2px solid #dc2626;
		border-bottom: 2px solid #dc2626;
		transform: rotate(42deg);
	}
	.cp-pin.is-done strong {
		text-decoration: line-through;
		text-decoration-thickness: 2px;
		text-decoration-color: #dc2626;
		opacity: 0.72;
	}

	/* the week meter under the notes */
	.cp-week {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		margin-top: 1rem;
	}
	.cp-week-bar {
		position: relative;
		flex: 1 1 auto;
		height: 9px;
		border-radius: 9999px;
		background: rgba(63, 42, 20, 0.22);
		overflow: hidden;
	}
	.cp-week-bar i {
		position: absolute;
		inset: 0 auto 0 0;
		width: 0%;
		border-radius: 9999px;
		background: linear-gradient(90deg, #f59e0b, #fb7185);
		transition: width 0.45s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.cp-week-n {
		flex: none;
		font-family: var(--cp-marker);
		font-size: 0.9rem;
		color: #3f2a14;
	}
	.cp-week-reset {
		flex: none;
		padding: 0.2rem 0.55rem;
		border-radius: 9999px;
		border: 1px dashed rgba(63, 42, 20, 0.4);
		background: transparent;
		font-size: 0.66rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: rgba(63, 42, 20, 0.7);
		cursor: pointer;
		transition: background 0.2s ease, color 0.2s ease;
	}
	.cp-week-reset:hover { background: rgba(255, 253, 245, 0.6); color: #3f2a14; }

	/* two real photographs, pinned crooked like everything else */
	.cp-photos {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.9rem;
		margin-top: 1.1rem;
	}
	.cp-photo {
		position: relative;
		margin: 0;
		padding: 0.5rem 0.5rem 1.7rem;
		background: #fffdf5;
		box-shadow: 0 12px 26px -10px rgba(0, 0, 0, 0.45);
		transform: rotate(calc(var(--r, 0) * 1.4deg));
		transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
	}
	.cp-photo:hover { transform: rotate(0deg) scale(1.03); z-index: 2; }
	.cp-photo img {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		background: #e7e5e4;
	}
	.cp-photo figcaption {
		position: absolute;
		left: 0.6rem;
		bottom: 0.45rem;
		font-family: var(--cp-marker);
		font-size: 0.78rem;
		color: #78716c;
	}

	/* ── the pop quiz: an exam paper pinned to the same cork ── */
	.cp-quiz {
		position: relative;
		display: flex;
		flex-direction: column;
		min-width: 0;
		padding: 1.5rem 1.2rem 1rem;
		background:
			repeating-linear-gradient(180deg, transparent 0 27px, rgba(59, 130, 246, 0.12) 27px 28px),
			#fffdf5;
		box-shadow: 0 16px 34px -12px rgba(0, 0, 0, 0.5);
		transform: rotate(-0.6deg);
	}
	/* the red margin rule down the left, like every exam paper ever */
	.cp-quiz::before {
		content: '';
		position: absolute;
		top: 0;
		bottom: 0;
		left: 2.1rem;
		width: 1px;
		background: rgba(220, 38, 38, 0.35);
	}
	.cp-quiz-tack { top: -11px; }
	.cp-quiz-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem;
		padding-bottom: 0.6rem;
		margin-bottom: 0.8rem;
		border-bottom: 2px solid rgba(63, 42, 20, 0.25);
	}
	.cp-quiz-ttl {
		font-family: var(--cp-marker);
		font-size: 1.3rem;
		font-weight: 700;
		color: #3f2a14;
	}
	.cp-quiz-name { font-size: 0.72rem; color: #a8a29e; }
	.cp-quiz-name i { font-style: normal; letter-spacing: 0.1em; }
	.cp-quiz-body { position: relative; flex: 1 1 auto; }

	.cp-q { display: none; }
	.cp-q.is-live { display: block; animation: cp-q-in 0.32s ease both; }
	@keyframes cp-q-in {
		from { opacity: 0; transform: translateX(10px); }
		to { opacity: 1; transform: none; }
	}
	.cp-q-t {
		margin: 0 0 0.75rem;
		font-family: var(--cp-marker);
		font-size: 1.02rem;
		line-height: 1.45;
		color: #292524;
	}
	.cp-q-t b { color: #dc2626; margin-right: 0.25rem; }
	.cp-q-opts { display: grid; gap: 0.4rem; margin: 0; padding: 0; list-style: none; }
	.cp-opt {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		width: 100%;
		padding: 0.5rem 0.6rem;
		border: 1px solid rgba(63, 42, 20, 0.2);
		border-radius: 0.45rem;
		background: rgba(255, 255, 255, 0.55);
		font-size: 0.82rem;
		line-height: 1.35;
		text-align: left;
		color: #44403c;
		cursor: pointer;
		transition: background 0.18s ease, border-color 0.18s ease, transform 0.18s ease;
	}
	.cp-opt:hover:not(:disabled) {
		background: #fff;
		border-color: rgba(63, 42, 20, 0.45);
		transform: translateX(2px);
	}
	.cp-opt i {
		flex: none;
		display: grid;
		place-items: center;
		width: 22px;
		height: 22px;
		border-radius: 9999px;
		border: 1.5px solid rgba(63, 42, 20, 0.35);
		font-style: normal;
		font-size: 0.68rem;
		font-weight: 800;
		color: rgba(63, 42, 20, 0.7);
	}
	.cp-opt:disabled { cursor: default; }
	/* marked in red pen */
	.cp-opt.is-right {
		border-color: #16a34a;
		background: rgba(22, 163, 74, 0.12);
		color: #14532d;
	}
	.cp-opt.is-right i { border-color: #16a34a; color: #16a34a; }
	.cp-opt.is-wrong {
		border-color: #dc2626;
		background: rgba(220, 38, 38, 0.1);
		color: #7f1d1d;
		text-decoration: line-through;
		text-decoration-color: rgba(220, 38, 38, 0.7);
	}
	.cp-opt.is-wrong i { border-color: #dc2626; color: #dc2626; }
	.cp-q-why {
		margin: 0.7rem 0 0;
		padding-left: 0.7rem;
		border-left: 3px solid rgba(220, 38, 38, 0.45);
		font-family: var(--cp-marker);
		font-size: 0.86rem;
		line-height: 1.5;
		color: #b91c1c;
		animation: cp-q-in 0.3s ease both;
	}

	/* the grade, stamped at the end */
	.cp-q-done { display: grid; place-items: center; gap: 0.5rem; padding: 0.6rem 0 0.2rem; text-align: center; }
	.cp-q-done[hidden] { display: none; }
	.cp-grade {
		display: grid;
		place-items: center;
		min-width: 5.5rem;
		padding: 0.35rem 0.9rem;
		border: 3px solid #dc2626;
		border-radius: 0.5rem;
		font-family: var(--cp-marker);
		font-size: 2.4rem;
		font-weight: 800;
		line-height: 1.1;
		color: #dc2626;
		transform: rotate(-8deg);
		animation: cp-stamp 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) both;
	}
	@keyframes cp-stamp {
		from { opacity: 0; transform: rotate(-8deg) scale(2.2); }
		to { opacity: 1; transform: rotate(-8deg) scale(1); }
	}
	.cp-grade-note {
		margin: 0.35rem 0 0;
		font-family: var(--cp-marker);
		font-size: 0.95rem;
		line-height: 1.45;
		color: #44403c;
	}
	.cp-retake {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin-top: 0.3rem;
		padding: 0.45rem 0.9rem;
		border-radius: 9999px;
		border: 1px solid rgba(63, 42, 20, 0.35);
		background: #fff;
		font-size: 0.78rem;
		font-weight: 700;
		color: #44403c;
		cursor: pointer;
		transition: background 0.2s ease, transform 0.2s ease;
	}
	.cp-retake:hover { background: #fef3c7; transform: translateY(-1px); }

	.cp-quiz-foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.6rem;
		margin-top: 0.9rem;
		padding-top: 0.6rem;
		border-top: 1px dashed rgba(63, 42, 20, 0.28);
	}
	.cp-quiz-dots { display: flex; gap: 0.3rem; }
	.cp-quiz-dots i {
		width: 7px;
		height: 7px;
		border-radius: 9999px;
		background: rgba(63, 42, 20, 0.22);
		transition: background 0.25s ease, width 0.25s ease;
	}
	.cp-quiz-dots i.is-on { width: 18px; background: #dc2626; }
	.cp-quiz-dots i.is-hit { background: #16a34a; }
	.cp-quiz-xp {
		font-family: var(--cp-marker);
		font-size: 0.92rem;
		font-weight: 700;
		color: #b45309;
	}

	/* ── the pocket board ──
	   Stacked, six notes plus two photos made a board you had to scroll for
	   half a minute. The notes ride a swipe rail instead. */
	@media (max-width: 860px) {
		.cp-board { grid-template-columns: minmax(0, 1fr); }
		.cp-todos {
			display: flex;
			gap: 0.7rem;
			overflow-x: auto;
			scroll-snap-type: x mandatory;
			padding: 0.45rem 0.2rem 0.9rem;
			margin-inline: -0.2rem;
			scrollbar-width: none;
		}
		.cp-todos::-webkit-scrollbar { display: none; }
		.cp-todos > li { flex: 0 0 9.5rem; scroll-snap-align: start; }
		.cp-pin { padding: 1.15rem 0.75rem 0.7rem; }
		.cp-pin strong { font-size: 0.94rem; }
		.cp-photos { grid-template-columns: 1fr 1fr; gap: 0.7rem; margin-top: 0.9rem; }
		.cp-photo { padding: 0.4rem 0.4rem 1.5rem; }
		.cp-week { margin-top: 0.4rem; flex-wrap: wrap; }
		/* the meter takes its own line so the note can breathe instead of
		   pushing the row 15px past the screen */
		.cp-week-bar { flex: 1 0 100%; order: -1; }
		.cp-week-n { flex: 1 1 8rem; min-width: 0; font-size: 0.8rem; line-height: 1.35; }
		.cp-week-reset { margin-left: auto; }
	}
	@media (max-width: 520px) {
		.cp-board { padding: 0.9rem; border-width: 6px; }
		.cp-quiz { padding: 1.3rem 0.9rem 0.9rem; }
		.cp-quiz::before { left: 1.5rem; }
		.cp-opt { font-size: 0.8rem; padding: 0.45rem 0.5rem; }
		.cp-grade { font-size: 2rem; }
	}

	/* ── E · the chalkboard ── */
	.cp-chalkwrap {
		display: grid;
		grid-template-columns: 1fr;
		gap: clamp(1.75rem, 4vw, 3.5rem);
		align-items: center;
	}
	@media (min-width: 880px) {
		.cp-chalkwrap {
			grid-template-columns: 0.85fr 1.15fr;
		}
	}
	.cp-chalk {
		position: relative;
		min-height: 15rem;
		padding: 1.8rem 2rem 4rem;
		border-radius: 0.8rem;
		border: 9px solid #8a5a2b;
		background:
			radial-gradient(500px 240px at 30% 20%, rgba(255, 255, 255, 0.045), transparent),
			linear-gradient(160deg, #1f3d32, #163027);
		box-shadow: inset 0 0 60px rgba(0, 0, 0, 0.35), 0 30px 70px -30px rgba(0, 0, 0, 0.6);
	}
	.cp-chalk-head {
		display: inline-block;
		font-family: var(--cp-marker);
		font-size: 1rem;
		letter-spacing: 0.18em;
		color: #fde68a;
		border-bottom: 2px dashed rgba(253, 230, 138, 0.5);
		padding-bottom: 0.3rem;
		margin-bottom: 1rem;
		transform: rotate(-1deg);
	}
	.cp-fact {
		display: none;
		margin: 0;
		font-family: var(--cp-marker);
		font-size: clamp(1.2rem, 2.4vw, 1.7rem);
		line-height: 1.5;
		color: #f1f5f4;
		text-shadow: 0 0 8px rgba(241, 245, 244, 0.18);
		animation: cp-chalkin 0.5s ease both;
	}
	.cp-fact.is-live {
		display: block;
	}
	@keyframes cp-chalkin {
		from {
			opacity: 0;
			transform: translateY(6px);
		}
	}
	.cp-chalk-count {
		position: absolute;
		right: 1.2rem;
		bottom: 1rem;
		font-family: var(--cp-marker);
		font-size: 0.85rem;
		color: rgba(241, 245, 244, 0.55);
	}
	.cp-chalk-tray {
		position: absolute;
		left: 1.6rem;
		right: auto;
		bottom: 1rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		max-width: calc(100% - 3.2rem);
	}
	.cp-chalk-tray i {
		display: block;
		width: 38px;
		height: 8px;
		border-radius: 9999px;
		background: #e7e5e4;
	}
	.cp-chalk-tray i:last-child {
		width: 26px;
		background: #fde68a;
	}

	/* ── F · the live work wall ──
	   Six real client sites, each behind browser chrome so it reads as a
	   thing that is actually running rather than a picture in a card. The
	   grid is a twelve-column editorial rhythm — 7/5, 5/7, 6/6 — so the
	   wall has movement instead of six identical boxes. */
	.cp-sec--live { position: relative; isolation: isolate; }
	.cp-live-bg {
		position: absolute;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		background:
			radial-gradient(60% 40% at 18% 8%, color-mix(in srgb, var(--cp-acc) 16%, transparent), transparent 62%),
			radial-gradient(52% 38% at 84% 82%, color-mix(in srgb, var(--cp-acc2) 13%, transparent), transparent 60%),
			repeating-linear-gradient(90deg, transparent 0 118px, rgba(253, 224, 150, 0.038) 118px 119px),
			repeating-linear-gradient(180deg, transparent 0 118px, rgba(253, 224, 150, 0.026) 118px 119px),
			linear-gradient(180deg, rgba(255, 255, 255, 0.03), rgba(0, 0, 0, 0.16));
		-webkit-mask-image: linear-gradient(180deg, transparent, #000 7%, #000 93%, transparent);
		mask-image: linear-gradient(180deg, transparent, #000 7%, #000 93%, transparent);
	}
	:global(html:not(.dark)) .cbody .cp-live-bg {
		background:
			radial-gradient(60% 40% at 18% 8%, color-mix(in srgb, var(--cp-acc) 20%, transparent), transparent 62%),
			radial-gradient(52% 38% at 84% 82%, color-mix(in srgb, var(--cp-acc2) 15%, transparent), transparent 60%),
			repeating-linear-gradient(90deg, transparent 0 118px, rgba(120, 72, 24, 0.06) 118px 119px),
			repeating-linear-gradient(180deg, transparent 0 118px, rgba(120, 72, 24, 0.045) 118px 119px),
			linear-gradient(180deg, rgba(255, 255, 255, 0.55), rgba(120, 72, 24, 0.06));
	}

	/* the line under the heading that says these are real */
	.cp-live-note {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-top: 1rem;
		padding: 0.34rem 0.85rem;
		border-radius: 9999px;
		border: 1px solid color-mix(in srgb, var(--cp-acc) 30%, transparent);
		background: color-mix(in srgb, var(--cp-acc) 9%, transparent);
		font-size: 0.74rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		color: var(--cp-ink);
	}
	.cp-live-note i {
		width: 7px;
		height: 7px;
		border-radius: 9999px;
		background: #22c55e;
		box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.6);
		animation: cp-pulse 2.2s ease-out infinite;
	}
	@keyframes cp-pulse {
		0% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.55); }
		70% { box-shadow: 0 0 0 8px rgba(34, 197, 94, 0); }
		100% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0); }
	}

	.cp-wall {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		gap: clamp(1rem, 2.2vw, 1.8rem);
		margin-top: clamp(1.6rem, 3.5vw, 2.6rem);
	}
	.cp-live {
		grid-column: span var(--span, 6);
		display: flex;
		flex-direction: column;
		gap: 0.95rem;
		text-decoration: none;
		color: inherit;
	}

	/* the browser window */
	.cp-live-frame {
		position: relative;
		display: block;
		border-radius: 0.9rem;
		overflow: hidden;
		border: 1px solid color-mix(in srgb, var(--hue, #f59e0b) 26%, var(--cp-line));
		background: #0b0906;
		box-shadow: 0 30px 60px -34px rgba(0, 0, 0, 0.85);
		transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
			box-shadow 0.45s ease, border-color 0.45s ease;
	}
	.cp-live:hover .cp-live-frame,
	.cp-live:focus-visible .cp-live-frame {
		transform: translateY(-6px);
		border-color: color-mix(in srgb, var(--hue, #f59e0b) 62%, transparent);
		box-shadow: 0 44px 80px -34px rgba(0, 0, 0, 0.9),
			0 0 0 1px color-mix(in srgb, var(--hue, #f59e0b) 30%, transparent);
	}
	.cp-live:focus-visible { outline: none; }

	.cp-live-bar {
		position: relative;
		z-index: 2;
		display: flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.55rem 0.7rem;
		background: linear-gradient(180deg, rgba(38, 30, 20, 0.98), rgba(24, 19, 12, 0.98));
		border-bottom: 1px solid rgba(255, 255, 255, 0.07);
	}
	.cp-live-bar > i {
		width: 9px;
		height: 9px;
		border-radius: 9999px;
		background: rgba(255, 255, 255, 0.16);
	}
	.cp-live-bar > i:first-child { background: #f87171; }
	.cp-live-bar > i:nth-child(2) { background: #fbbf24; }
	.cp-live-bar > i:nth-child(3) { background: #4ade80; }
	.cp-live-url {
		flex: 1 1 auto;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.32rem;
		min-width: 0;
		margin-inline: 0.35rem;
		padding: 0.2rem 0.7rem;
		border-radius: 9999px;
		background: rgba(255, 255, 255, 0.07);
		font-family: ui-monospace, monospace;
		font-size: 0.7rem;
		color: rgba(253, 246, 234, 0.72);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.cp-live-dot {
		flex: none;
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0.14rem 0.45rem;
		border-radius: 9999px;
		border: 1px solid rgba(34, 197, 94, 0.45);
		background: rgba(34, 197, 94, 0.14);
		font-size: 0.56rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: #4ade80;
	}

	/* the page itself, which scrolls when you hover it */
	.cp-live-shot {
		position: relative;
		display: block;
		overflow: hidden;
		aspect-ratio: var(--ar, 16 / 10);
		background: color-mix(in srgb, var(--hue, #f59e0b) 12%, #14100a);
	}
	.cp-live-shot img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		/* the top of a page is the part worth showing */
		object-position: top center;
		transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.cp-live:hover .cp-live-shot img,
	.cp-live:focus-visible .cp-live-shot img {
		transform: scale(1.05) translateY(-1.5%);
	}
	/* the glass over the screen, so it reads as a screen */
	.cp-live-shot::after {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: linear-gradient(
			118deg,
			rgba(255, 255, 255, 0.1) 0 18%,
			transparent 34%
		);
	}

	.cp-live-open {
		position: absolute;
		left: 50%;
		bottom: 1rem;
		z-index: 3;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.5rem 1rem;
		border-radius: 9999px;
		background: color-mix(in srgb, var(--hue, #f59e0b) 88%, #120c04);
		border: 1px solid rgba(255, 255, 255, 0.28);
		font-size: 0.78rem;
		font-weight: 700;
		color: #fff;
		white-space: nowrap;
		opacity: 0;
		transform: translate(-50%, 12px);
		transition: opacity 0.32s ease, transform 0.32s cubic-bezier(0.22, 1, 0.36, 1);
		box-shadow: 0 14px 30px -12px rgba(0, 0, 0, 0.8);
	}
	.cp-live:hover .cp-live-open,
	.cp-live:focus-visible .cp-live-open {
		opacity: 1;
		transform: translate(-50%, 0);
	}

	.cp-live-meta { display: flex; flex-direction: column; gap: 0.4rem; }
	.cp-live-meta strong {
		font-size: clamp(1.05rem, 1.5vw, 1.3rem);
		font-weight: 800;
		letter-spacing: -0.015em;
		color: var(--cp-ink);
	}
	.cp-live:hover .cp-live-meta strong { color: var(--hue, #f59e0b); }
	.cp-live-meta em {
		font-style: normal;
		font-size: 0.88rem;
		line-height: 1.6;
		color: var(--cp-muted);
	}
	.cp-live-tags { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.15rem; }
	.cp-live-tags i {
		font-style: normal;
		font-size: 0.63rem;
		font-weight: 700;
		letter-spacing: 0.07em;
		text-transform: uppercase;
		padding: 0.2rem 0.5rem;
		border-radius: 9999px;
		border: 1px solid var(--cp-line);
		color: var(--cp-faint);
	}

	@media (max-width: 1100px) {
		.cp-live { grid-column: span 6; --ar: 4 / 3; }
	}
	/* On a phone the frames were reading as six huge slabs, so the whole
	   wall tightens: shorter crops, smaller chrome, less air between. */
	@media (max-width: 760px) {
		.cp-wall { gap: 1.15rem; }
		.cp-live { grid-column: span 12; gap: 0.65rem; --ar: 16 / 10; }
		.cp-live-frame { border-radius: 0.7rem; }
		.cp-live-bar { padding: 0.4rem 0.5rem; gap: 0.3rem; }
		.cp-live-bar > i { width: 7px; height: 7px; }
		.cp-live-url { font-size: 0.62rem; padding: 0.15rem 0.5rem; }
		.cp-live-dot { font-size: 0.5rem; padding: 0.1rem 0.35rem; }
		.cp-live-meta strong { font-size: 1rem; }
		.cp-live-meta em { font-size: 0.8rem; line-height: 1.5; }
		.cp-live-tags i { font-size: 0.58rem; padding: 0.16rem 0.42rem; }
		/* no hover on a phone, so the button is simply there */
		.cp-live-open { opacity: 1; transform: translate(-50%, 0); font-size: 0.68rem; padding: 0.34rem 0.7rem; bottom: 0.65rem; }
	}
	/* two up as soon as there is room for it, which is most phones in
	   landscape and every small tablet */
	@media (min-width: 560px) and (max-width: 760px) {
		.cp-live { grid-column: span 6; --ar: 4 / 3; }
	}
	/* One up on a phone, but sized so two of them are on screen at once
	   rather than one slab filling the whole display. The tags go: the
	   screenshot and the sentence are what earn the space. */
	@media (max-width: 559px) {
		.cp-live { --ar: 16 / 11; gap: 0.55rem; }
		.cp-live-tags { display: none; }
		.cp-live-meta { gap: 0.28rem; }
		.cp-live-meta strong { font-size: 0.95rem; }
		.cp-live-meta em { font-size: 0.78rem; line-height: 1.45; }
	}

	/* ── leaving Swizel ── */
	.cp-exit {
		position: fixed;
		inset: 0;
		z-index: 1400;
		display: grid;
		place-items: center;
		padding: clamp(1rem, 4vw, 2rem);
	}
	.cp-exit[hidden] { display: none; }
	.cp-exit-scrim {
		position: absolute;
		inset: 0;
		background: rgba(8, 6, 3, 0.66);
		backdrop-filter: blur(6px);
		animation: cp-fade 0.24s ease both;
	}
	@keyframes cp-fade { from { opacity: 0; } to { opacity: 1; } }
	.cp-exit-card {
		position: relative;
		width: min(100%, 25rem);
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.55rem;
		padding: clamp(1.4rem, 3vw, 1.9rem);
		border-radius: 1.1rem;
		border: 1px solid color-mix(in srgb, var(--cp-acc) 28%, transparent);
		background:
			radial-gradient(120% 80% at 0% 0%, color-mix(in srgb, var(--cp-acc) 12%, transparent), transparent 60%),
			#161009;
		box-shadow: 0 40px 90px -34px rgba(0, 0, 0, 0.9);
		animation: cp-exit-in 0.32s cubic-bezier(0.22, 1, 0.36, 1) both;
	}
	@keyframes cp-exit-in {
		from { opacity: 0; transform: translateY(14px) scale(0.97); }
		to { opacity: 1; transform: none; }
	}
	:global(html:not(.dark)) .cbody .cp-exit-card {
		background:
			radial-gradient(120% 80% at 0% 0%, color-mix(in srgb, var(--cp-acc) 16%, transparent), transparent 60%),
			#fffdf7;
	}
	.cp-exit-ic {
		display: grid;
		place-items: center;
		width: 42px;
		height: 42px;
		border-radius: 0.7rem;
		color: var(--cp-acc);
		background: color-mix(in srgb, var(--cp-acc) 14%, transparent);
		border: 1px solid color-mix(in srgb, var(--cp-acc) 30%, transparent);
	}
	.cp-exit-t {
		margin: 0.3rem 0 0;
		font-size: 1.2rem;
		font-weight: 800;
		letter-spacing: -0.02em;
		color: var(--cp-ink);
	}
	.cp-exit-p {
		margin: 0;
		font-size: 0.88rem;
		line-height: 1.6;
		color: var(--cp-muted);
	}
	.cp-exit-p b { color: var(--cp-ink); font-weight: 700; }
	.cp-exit-url {
		display: inline-flex;
		align-items: center;
		max-width: 100%;
		padding: 0.3rem 0.7rem;
		border-radius: 0.5rem;
		border: 1px solid var(--cp-line);
		background: rgba(255, 255, 255, 0.04);
		font-family: ui-monospace, monospace;
		font-size: 0.76rem;
		color: var(--cp-acc);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.cp-exit-row { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 0.7rem; }
	.cp-exit-go {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.6rem 1.1rem;
		border-radius: 9999px;
		border: 0;
		background: var(--cp-acc);
		font-size: 0.85rem;
		font-weight: 800;
		color: #241703;
		cursor: pointer;
		transition: transform 0.2s ease, filter 0.2s ease;
	}
	.cp-exit-go:hover { transform: translateY(-1px); filter: brightness(1.08); }
	.cp-exit-no {
		padding: 0.6rem 1.1rem;
		border-radius: 9999px;
		border: 1px solid var(--cp-line);
		background: transparent;
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--cp-muted);
		cursor: pointer;
		transition: color 0.2s ease, border-color 0.2s ease;
	}
	.cp-exit-no:hover { color: var(--cp-ink); border-color: var(--cp-acc); }

	/* ── G · gallery ── */
	.cp-gallery {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		grid-auto-rows: clamp(150px, 16vw, 200px);
		gap: clamp(0.9rem, 2vw, 1.25rem);
	}
	@media (max-width: 760px) {
		.cp-gallery {
			grid-template-columns: 1fr;
		}
	}
	.cp-shot {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		border-radius: 1.1rem;
		border: 1.5px dashed color-mix(in srgb, var(--cp-ink) 22%, transparent);
		background:
			radial-gradient(420px 200px at 70% 10%, color-mix(in srgb, var(--cp-acc) 10%, transparent), transparent),
			var(--cp-card);
		color: var(--cp-muted);
	}
	.cp-shot--wide {
		grid-column: span 2;
		grid-row: span 2;
	}
	/* real photographs from the Abuja campus: taped-up prints */
	.cp-shot--photo {
		position: relative;
		overflow: hidden;
		margin: 0;
		border-style: solid;
		border-color: color-mix(in srgb, var(--cp-ink) 12%, transparent);
		background: #0d0a05;
		transform: rotate(-0.5deg);
		transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.4s ease;
		box-shadow: 0 14px 34px -20px rgba(0, 0, 0, 0.7);
	}
	.cp-shot--photo:nth-of-type(3) { transform: rotate(0.7deg); }
	.cp-shot--photo:hover { transform: rotate(0deg) translateY(-5px); box-shadow: 0 26px 50px -22px rgba(0, 0, 0, 0.75); }
	.cp-shot--photo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 38%;
		display: block;
		transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.cp-shot--photo:hover img { transform: scale(1.05); }
	.cp-shot--photo::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgba(6, 4, 1, 0.75), rgba(6, 4, 1, 0.04) 58%);
		pointer-events: none;
	}
	.cp-tape {
		position: absolute;
		top: 0.5rem;
		left: 50%;
		width: 4.8rem;
		height: 1.1rem;
		transform: translateX(-50%) rotate(-3deg);
		background: color-mix(in srgb, var(--cp-acc) 32%, #fff8e6);
		opacity: 0.75;
		box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
		z-index: 2;
	}
	.cp-shot-cap {
		position: absolute;
		left: 0.85rem;
		right: 0.85rem;
		bottom: 0.7rem;
		z-index: 2;
		font-family: var(--cp-marker);
		font-size: 0.95rem;
		line-height: 1.25;
		color: #fff6e2;
		text-shadow: 0 2px 8px rgba(0, 0, 0, 0.65);
	}
	.cp-shot--wide .cp-shot-cap { font-size: 1.15rem; }
	@media (max-width: 760px) {
		.cp-shot--wide {
			grid-column: span 1;
		}
	}
	.cp-shot-name {
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.07em;
		text-transform: uppercase;
		text-align: center;
		padding-inline: 0.75rem;
	}
	.cp-shot-sub {
		font-size: 0.76rem;
		color: var(--cp-faint);
	}

	/* ── H · achievements: locked → unlocked ── */
	.cp-achvs {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: clamp(0.9rem, 2vw, 1.25rem);
	}
	@media (max-width: 980px) {
		.cp-achvs {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	/* Stacked, four tall boxes were a screen and a half of scrolling for
	   four short lines. They stay in a line and you swipe them, and the
	   card itself goes fine: a small icon, a hairline, no slab. */
	@media (max-width: 640px) {
		.cp-achvs {
			display: flex;
			grid-template-columns: none;
			gap: 0.7rem;
			overflow-x: auto;
			scroll-snap-type: x mandatory;
			padding: 0.2rem 0.15rem 0.9rem;
			margin-inline: -0.15rem;
			scrollbar-width: none;
		}
		.cp-achvs::-webkit-scrollbar { display: none; }
		.cp-achv {
			flex: 0 0 13.5rem;
			scroll-snap-align: start;
			padding: 0.9rem 0.85rem 0.95rem;
			border-radius: 0.85rem;
		}
		.cp-achv-ic {
			width: 34px;
			height: 34px;
			margin-bottom: 0.55rem;
			border-radius: 0.6rem;
		}
		.cp-achv-ic :global(svg) { width: 17px; height: 17px; }
		.cp-achv-lock { top: 0.7rem; right: 0.7rem; }
		.cp-achv-lock :global(svg) { width: 15px; height: 15px; }
		.cp-achv-t { font-size: 0.92rem; margin-bottom: 0.2rem; }
		.cp-achv-d { font-size: 0.78rem; line-height: 1.45; }
	}
	.cp-achv {
		position: relative;
		padding: 1.4rem 1.25rem 1.2rem;
		border-radius: 1.1rem;
		border: 1px solid var(--cp-line);
		background: var(--cp-card);
		filter: grayscale(1);
		opacity: 0.55;
		transition: filter 0.6s ease, opacity 0.6s ease, border-color 0.5s ease,
			box-shadow 0.5s ease;
		transition-delay: calc(var(--i, 0) * 0.25s);
	}
	.cp-achvs.is-on .cp-achv {
		filter: grayscale(0);
		opacity: 1;
		border-color: color-mix(in srgb, var(--cp-acc) 45%, transparent);
		box-shadow: 0 22px 48px -24px color-mix(in srgb, var(--cp-acc) 45%, transparent);
	}
	.cp-achv-lock {
		position: absolute;
		top: 1rem;
		right: 1rem;
		color: var(--cp-faint);
		transition: opacity 0.4s ease, transform 0.4s ease;
		transition-delay: calc(var(--i, 0) * 0.25s);
	}
	.cp-achvs.is-on .cp-achv-lock {
		opacity: 0;
		transform: scale(0.5) rotate(-20deg);
	}
	.cp-achv-ic {
		display: grid;
		place-items: center;
		width: 52px;
		height: 52px;
		border-radius: 9999px;
		background: linear-gradient(180deg, #fcd34d, var(--cp-acc));
		color: #2b1c08;
		margin-bottom: 0.9rem;
		transform: scale(0.85);
		transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
		transition-delay: calc(var(--i, 0) * 0.25s);
	}
	.cp-achvs.is-on .cp-achv-ic {
		transform: scale(1);
	}
	.cp-achv-t {
		font-size: 1.05rem;
		font-weight: 800;
		margin: 0 0 0.3rem;
	}
	.cp-achv-d {
		margin: 0;
		font-size: 0.85rem;
		line-height: 1.55;
		color: var(--cp-muted);
	}

	/* ── I · alumni ── */
	.cp-voices {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(0.9rem, 2vw, 1.25rem);
		max-width: 64rem;
		margin: 0 auto;
	}
	@media (max-width: 880px) {
		.cp-voices {
			grid-template-columns: 1fr;
		}
	}
	.cp-voice {
		padding: 1.2rem 1.25rem 1.1rem;
		border-radius: 1.1rem;
		border: 1px solid var(--cp-line);
		background: var(--cp-card);
		transition: transform 0.3s ease, border-color 0.3s ease;
	}
	.cp-voice:hover {
		transform: translateY(-4px);
		border-color: color-mix(in srgb, var(--cp-acc) 45%, transparent);
	}
	.cp-voice-top {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		margin-bottom: 0.7rem;
	}
	.cp-voice-top img {
		width: 38px;
		height: 38px;
		border-radius: 9999px;
		object-fit: cover;
		border: 2px solid color-mix(in srgb, var(--cp-acc) 50%, transparent);
	}
	.cp-voice-who {
		display: flex;
		flex-direction: column;
		line-height: 1.25;
	}
	.cp-voice-who strong {
		font-size: 0.92rem;
	}
	.cp-voice-who em {
		font-style: normal;
		font-size: 0.74rem;
		letter-spacing: 0.1em;
		color: var(--cp-acc);
	}
	.cp-voice-body {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.6;
		color: var(--cp-muted);
	}

	/* ── J · enrollment ── */
	.cp-sec--cta {
		padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
	}
	.cp-ctabox {
		text-align: center;
		max-width: 50rem;
		padding: clamp(2.5rem, 5vw, 4rem) clamp(1.25rem, 3vw, 3rem);
		border-radius: 1.5rem;
		border: 1px solid color-mix(in srgb, var(--cp-acc) 30%, var(--cp-line));
		background:
			radial-gradient(640px 300px at 50% 120%, color-mix(in srgb, var(--cp-acc) 18%, transparent), transparent 70%),
			var(--cp-card);
		margin-inline: auto;
	}
	.cp-start {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		padding: 0.8rem 1.8rem;
		border-radius: 0.9rem;
		font-weight: 850;
		font-size: 1rem;
		line-height: 1.3; /* the label may wrap on phones — keep the two lines tight */
		letter-spacing: 0.02em;
		color: #2b1c08;
		background: linear-gradient(180deg, #fcd34d, var(--cp-acc));
		border: 1px solid rgba(255, 255, 255, 0.4);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.5),
			0 7px 0 color-mix(in srgb, var(--cp-acc) 60%, #5b3305),
			0 22px 44px -14px color-mix(in srgb, var(--cp-acc) 70%, transparent);
		animation: cp-throb 2.4s ease-in-out infinite;
		transition: transform 0.15s ease, box-shadow 0.15s ease;
	}
	.cp-start:hover {
		transform: translateY(3px);
		animation-play-state: paused;
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.5),
			0 4px 0 color-mix(in srgb, var(--cp-acc) 60%, #5b3305),
			0 16px 34px -14px color-mix(in srgb, var(--cp-acc) 70%, transparent);
	}
	@keyframes cp-throb {
		0%, 100% { filter: brightness(1); }
		50% { filter: brightness(1.12); }
	}
	.cp-alt {
		margin: 1.4rem 0 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.45rem;
		font-size: 0.92rem;
		color: var(--cp-muted);
	}
	.cp-phone {
		font-family: ui-monospace, monospace;
		font-weight: 800;
		font-size: clamp(1.05rem, 4vw, 1.3rem); /* consistent with the other pages' phone size */
		letter-spacing: -0.01em;
		white-space: nowrap;
		color: var(--cp-ink);
		transition: color 0.25s ease;
	}
	.cp-phone:hover {
		color: var(--cp-acc);
	}



	/* ── chalk prev/next: chalk-drawn arrow buttons on the board ── */
	.cp-chalk-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.3rem 0.75rem;
		border-radius: 9999px;
		border: 2px dashed rgba(241, 245, 244, 0.55);
		background: rgba(241, 245, 244, 0.06);
		color: #f1f5f4;
		cursor: pointer;
		transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
	}
	.cp-chalk-btn--y {
		border-color: rgba(253, 230, 138, 0.7);
		color: #fde68a;
	}
	.cp-chalk-arrow {
		font-size: 1.05rem;
		line-height: 1;
	}
	.cp-chalk-hint {
		font-family: var(--cp-marker);
		font-size: 0.85rem;
		line-height: 1;
	}
	.cp-chalk-btn:hover {
		transform: translateY(-3px);
		background: rgba(241, 245, 244, 0.14);
		box-shadow: 0 6px 12px -4px rgba(0, 0, 0, 0.5);
	}

	/* ── programs & admissions ── */
	.cp-programs {
		display: grid;
