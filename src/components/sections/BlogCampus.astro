---
// Blog index · Campus world — the School Paper. The same journal (featured
// lead, category filter, all posts, newsletter, Brevarium promo) told as
// school: a front-page story, articles pinned to the notice board behind
// subject tabs, a permission-slip newsletter and the free textbook. Root
// carries `cbody` (campus engine: .cp-rev reveals) and `cbl` (motion
// engine: tilt / glare / magnetic).
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';

interface Props { posts: CollectionEntry<'blog'>[]; }
const { posts } = Astro.props;

const featured = posts.find((p) => p.data.featured) ?? posts[0];
const cats = [...new Set(posts.map((p) => p.data.category))];
const catSlug = (c: string) => c.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const catCount = (c: string) => posts.filter((p) => p.data.category === c).length;
const readTime = (body: string) => Math.max(1, Math.round((body?.trim().split(/\s+/).length || 0) / 200));
const fmtDate = (d: Date) => new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
// The wall is a three-across grid. When the article count does not divide
// by three the row is finished with pinned notes that are actually useful,
// so the board never reads as a page with holes in it.
const fillers = [
	{
		ic: '✏️',
		kick: 'Open request',
		title: 'What should we write about?',
		desc: 'Something you keep googling and never finding a straight answer to? Tell us and we will take it on.',
		cta: 'Suggest a topic',
		href: '/contact',
		c: '#f59e0b',
	},
	{
		ic: '📬',
		kick: 'Permission slip',
		title: 'Get the next issue sent home.',
		desc: 'One email when a new piece lands. No spam, no fluff, and you can hand the slip back any time.',
		cta: 'Put me on the list',
		href: '#cb-slip',
		c: '#fb7185',
	},
];

const catColor: Record<string, string> = { EdTech: '#2bb3c0', Fintech: '#6366f1', Marketing: '#ec4899', Technology: '#18debe', Insights: '#f59e0b' };
const col = (c: string) => catColor[c] ?? '#f59e0b';

const filterCss = cats
	.map((c) => {
		const s = catSlug(c);
		const cc = col(c);
		return [
			`#cbl-${s}:checked ~ .cb-wall .cb-note:not(.c-${s}){display:none}`,
			`#cbl-${s}:checked ~ .cb-tabs label[for="cbl-${s}"]{color:#fff;background:${cc};border-color:transparent}`,
			`#cbl-${s}:checked ~ .cb-tabs label[for="cbl-${s}"] span{color:rgba(255,255,255,0.85)}`,
		].join('');
	})
	.join('');
---

<div class="cbl cbody view-body view-body-campus">
	<!-- ── A · the easel ───────────────────────────────────────
	     The journal opens on a flip chart standing at the front of the
	     room: used sheets folded back over the top, today's page still
	     clipped on, the marker resting in the tray. -->
	<section class="cb-sec cb-sec--easel">
		<div class="cb-wrap">
			<div class="cb-easel cp-rev">
				<span class="cb-easel-sheet cb-easel-sheet--3" aria-hidden="true"></span>
				<span class="cb-easel-sheet cb-easel-sheet--2" aria-hidden="true"></span>
				<div class="cb-easel-page">
					<span class="cb-easel-clips" aria-hidden="true"><i></i><i></i><i></i></span>
					<span class="cb-badge">🗞️ The school paper · Fresh off the press</span>
					<h2 class="cb-h cb-h--xl">
						Read all <em>about it.</em>
						<svg class="cb-easel-swipe" viewBox="0 0 240 22" aria-hidden="true">
							<path d="M6 15c40-11 92-13 150-7 22 2 46 5 80 2" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" />
						</svg>
					</h2>
					<p class="cb-p">
						Field notes on technology, design, fintech, edtech and growth:
						what the school is building, learning and seeing across the
						African digital landscape.
					</p>
					<span class="cb-easel-corner" aria-hidden="true"></span>
				</div>
				<span class="cb-easel-tray" aria-hidden="true">
					<span class="cb-easel-marker"></span>
				</span>
			</div>
		</div>
	</section>

	<!-- ── B · the front page (featured) ───────────────────── -->
	{
		featured && (
			<section class="cb-sec" data-cursor="book">
				<div class="cb-wrap">
					<div class="cb-head cp-rev">
						<span class="cb-kick">📌 Front-page story</span>
					</div>
					<a
						href={`/blog/${featured.slug}`}
						class="cb-front cp-rev"
						style={`--c:${col(featured.data.category)}`}
						data-fa-tilt="4"
					>
						<span class="cb-pin" aria-hidden="true" />
						<span class="cb-glare" aria-hidden="true" />
						<span class="cb-front-media">
							<img src={featured.data.heroImage} alt={featured.data.title} loading="eager" />
							<span class="cb-front-cat">{featured.data.category}</span>
						</span>
						<span class="cb-front-body">
							<span class="cb-front-kick">Front page · {fmtDate(featured.data.pubDate)}</span>
							<strong class="cb-front-title">{featured.data.title}</strong>
							<span class="cb-front-desc">{featured.data.description}</span>
							<span class="cb-meta">By {featured.data.author} · {readTime(featured.body)} min read</span>
							<span class="cb-link">
								Read the story
								<Icon width={15} name="mdi:arrow-right" />
							</span>
						</span>
					</a>
				</div>
			</section>
		)
	}

	<!-- ── C · the notice board (all posts) ────────────────── -->
	<section class="cb-sec" data-cursor="book">
		<div class="cb-wrap">
			<div class="cb-head cp-rev">
				<span class="cb-kick">📎 The notice board</span>
				<h2 class="cb-h">Every article, <em>pinned up.</em></h2>
				<p class="cb-p cb-p--center">
					{posts.length} {posts.length === 1 ? 'article' : 'articles'} so
					far, with more being written between classes.
				</p>
			</div>
			<form class="cb-filter" autocomplete="off">
				<input class="cb-radio" type="radio" name="cbl" id="cbl-all" checked />
				{cats.map((c) => <input class="cb-radio" type="radio" name="cbl" id={`cbl-${catSlug(c)}`} />)}
				<div class="cb-tabs cp-rev">
					<label class="cb-tab" for="cbl-all">All subjects <span>{posts.length}</span></label>
					{
						cats.map((c) => (
							<label class="cb-tab" for={`cbl-${catSlug(c)}`}>
								{c} <span>{catCount(c)}</span>
							</label>
						))
					}
				</div>
				<div class="cb-wall">
					{
						posts.map((p, i) => (
							<figure
								class:list={['cb-note', 'cp-rev', `c-${catSlug(p.data.category)}`]}
								style={`--c:${col(p.data.category)}; --i:${i % 3}; --r:${i % 2 === 0 ? -0.9 : 1.1}deg`}
							>
								<a href={`/blog/${p.slug}`} class="cb-note-link" data-fa-tilt="6">
									<span class="cb-note-pin" aria-hidden="true" />
									<span class="cb-glare" aria-hidden="true" />
									<span class="cb-note-media">
										<img src={p.data.heroImage} alt={p.data.title} loading="lazy" />
										<span class="cb-note-cat">{p.data.category}</span>
									</span>
									<figcaption class="cb-note-body">
										<strong>{p.data.title}</strong>
										<span class="cb-note-desc">{p.data.description}</span>
										<em>{fmtDate(p.data.pubDate)} · {readTime(p.body)} min read</em>
									</figcaption>
								</a>
							</figure>
						))
					}
					{
						fillers
							.slice(0, (3 - (posts.length % 3)) % 3)
							.map((f, i) => (
								<figure
									class="cb-note cb-note--ask cp-rev"
									style={`--c:${f.c}; --i:${(posts.length + i) % 3}; --r:${(posts.length + i) % 2 === 0 ? -0.9 : 1.1}deg`}
								>
									<a href={f.href} class="cb-note-link cb-ask" data-fa-tilt="6">
										<span class="cb-note-pin" aria-hidden="true" />
										<span class="cb-ask-ic" aria-hidden="true">{f.ic}</span>
										<span class="cb-ask-kick">{f.kick}</span>
										<strong class="cb-ask-title">{f.title}</strong>
										<span class="cb-ask-desc">{f.desc}</span>
										<span class="cb-ask-cta">
											{f.cta}
											<Icon width={15} name="mdi:arrow-right" />
										</span>
									</a>
								</figure>
							))
					}
				</div>
			</form>
		</div>
	</section>

	<!-- ── D · the permission slip (newsletter) ────────────── -->
	<section class="cb-sec" data-cursor="phone">
		<div class="cb-wrap">
			<div class="cb-slip cp-rev" id="cb-slip" data-fa-tilt="3">
				<span class="cb-slip-clip" aria-hidden="true"></span>
				<span class="cb-kick">✂️ The permission slip</span>
				<h2 class="cb-h">Get the next issue <em>sent home.</em></h2>
				<p class="cb-p cb-p--center">
					No spam, no fluff. Just our sharpest thinking on building for
					the African market, sent only when it is worth your time.
				</p>
				<form class="cb-slip-form" id="cb-slip-form" name="newsletter" novalidate>
					<p class="cb-hp"><label>Don't fill this out: <input name="bot-field" /></label></p>
					<input class="cb-slip-input" type="email" name="email" placeholder="you@company.com" required aria-label="Email address" />
					<button class="cb-slip-btn fa-cta" type="submit" id="cb-slip-btn">
						Sign me up
						<Icon width={16} name="mdi:arrow-right" />
					</button>
				</form>
				<p class="cb-slip-note" id="cb-slip-note" role="status" aria-live="polite"></p>
				<!-- the little stamp that says the slip reached the office -->
				<div class="cb-stamp" id="cb-stamp" hidden>
					<div class="cb-stamp-card">
						<span class="cb-stamp-mark" aria-hidden="true"><Icon width={22} name="mdi:check-bold" /></span>
						<strong>Slip received</strong>
						<em>You are on the list. The next issue comes to you.</em>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- ── E · the free textbook (Brevarium promo) ─────────── -->
	<section class="cb-sec cb-sec--last" data-cursor="book">
		<div class="cb-wrap">
			<a class="cb-mag cp-rev" href="/brevarium/the-brevarium-latest.pdf" download data-fa-tilt="5">
				<span class="cb-glare" aria-hidden="true"></span>
				<span class="cb-mag-cover">
					<img src="/images/portfolio/mag-latest-cover.jpg" alt="The Brevarium magazine" loading="lazy" />
				</span>
				<span class="cb-mag-meta">
					<span class="cb-kick">📖 The set text, free</span>
					<strong>Prefer the magazine? Read The Brevarium.</strong>
					<em>Our featured projects, the team and the thinking behind the work, cover to cover.</em>
					<span class="cb-link"><Icon width={15} name="mdi:download" /> Download the latest edition</span>
				</span>
			</a>
		</div>
	</section>
</div>

<style is:global set:html={filterCss}></style>

<style>
	/* ── Campus Blog — the school dress. ── */
	.cbl {
		--cp-ink: #fdf6ea;
		--cp-muted: rgba(253, 246, 234, 0.62);
		--cp-faint: rgba(253, 246, 234, 0.4);
		--cp-acc: var(--view-accent, #f59e0b);
		--cp-acc2: #fb7185;
		--cp-line: rgba(255, 255, 255, 0.09);
		--cp-card: rgba(255, 255, 255, 0.035);
		--cp-marker: 'Bradley Hand', 'Segoe Print', 'Comic Sans MS', cursive;
		font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
		position: relative;
		isolation: isolate;
		overflow: hidden;
		background:
			radial-gradient(1000px 540px at 82% -6%, rgba(245, 158, 11, 0.13), transparent 62%),
			radial-gradient(820px 480px at 6% 44%, rgba(251, 113, 133, 0.07), transparent 60%),
			linear-gradient(180deg, #120c04 0%, #160f08 50%, #0e0903 100%);
		color: var(--cp-ink);
		padding: clamp(2rem, 4vw, 3rem) clamp(1rem, 3vw, 2rem) clamp(2.5rem, 5vw, 4rem);
		transition: background 0.4s ease, color 0.4s ease;
	}
	:global(html:not(.dark)) .cbl {
		--cp-ink: #2b1c08;
		--cp-muted: rgba(43, 28, 8, 0.68);
		--cp-faint: rgba(43, 28, 8, 0.46);
		--cp-acc: #b45309;
		--cp-line: rgba(43, 28, 8, 0.1);
		--cp-card: rgba(43, 28, 8, 0.045);
		background:
			radial-gradient(1000px 540px at 82% -6%, rgba(245, 158, 11, 0.14), transparent 62%),
			linear-gradient(180deg, #fdf4e3 0%, #faecd4 55%, #fdf4e3 100%);
	}

	.cb-sec { padding-block: clamp(1.8rem, 4vw, 3rem); }
	.cb-sec--last { padding-bottom: clamp(1.5rem, 3vw, 2.5rem); }
	.cb-wrap { max-width: 76rem; margin: 0 auto; }

	.cb-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-family: ui-monospace, monospace;
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--cp-acc);
		border: 1px solid color-mix(in srgb, var(--cp-acc) 40%, transparent);
		background: color-mix(in srgb, var(--cp-acc) 9%, transparent);
		padding: 0.4rem 0.9rem;
		border-radius: 9999px;
		margin-bottom: 1.1rem;
	}
	.cb-kick {
		display: block;
		font-family: ui-monospace, monospace;
		font-size: 0.74rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--cp-acc);
		margin-bottom: 0.6rem;
	}
	.cb-h {
		font-size: clamp(1.9rem, 4vw, 3rem);
		font-weight: 850;
		letter-spacing: -0.02em;
		line-height: 1.05;
		margin: 0 0 0.9rem;
	}
	.cb-h--xl { font-size: clamp(2.3rem, 5.2vw, 4rem); line-height: 1.08; }
	.cb-h em {
		font-style: normal;
		background: linear-gradient(95deg, var(--cp-acc), var(--cp-acc2));
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}
	.cb-p {
		font-size: clamp(0.98rem, 1.5vw, 1.1rem);
		line-height: 1.7;
		color: var(--cp-muted);
		max-width: 36rem;
		margin: 0 0 1.2rem;
	}
	.cb-p--center { text-align: center; margin-inline: auto; }
	.cb-head { text-align: center; margin-bottom: clamp(1.4rem, 3vw, 2rem); }
	.cb-open { text-align: center; }
	.cb-meta {
		display: block;
		font-family: var(--cp-marker);
		font-size: 0.88rem;
		color: var(--cp-faint);
	}
	.cb-link {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font-weight: 800;
		font-size: 0.92rem;
		color: var(--c, var(--cp-acc));
		border-bottom: 2px solid color-mix(in srgb, var(--c, var(--cp-acc)) 45%, transparent);
		padding-bottom: 0.15rem;
		transition: border-color 0.25s ease, gap 0.25s ease;
		max-width: fit-content;
	}
	.cb-link:hover { gap: 0.7rem; border-color: var(--c, var(--cp-acc)); }

	.cb-glare {
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background: radial-gradient(320px 200px at var(--gx, 50%) var(--gy, 20%), color-mix(in srgb, var(--c, var(--cp-acc)) 12%, transparent), transparent 70%);
		opacity: 0;
		transition: opacity 0.3s ease;
		pointer-events: none;
		z-index: 2;
	}
	[data-fa-tilt]:hover .cb-glare { opacity: 1; }

	.cb-pin,
	.cb-note-pin {
		position: absolute;
		top: -7px;
		left: 50%;
		transform: translateX(-50%);
		width: 14px;
		height: 14px;
		border-radius: 50%;
		background: radial-gradient(circle at 35% 30%, #fda4af, #e11d48 65%);
		box-shadow: 0 3px 6px rgba(0, 0, 0, 0.45);
		z-index: 3;
	}

	/* ── B · the front page ── */
	.cb-front {
		position: relative;
		display: grid;
		gap: clamp(1.25rem, 3vw, 2.5rem);
		align-items: center;
		padding: clamp(1.1rem, 2.5vw, 1.8rem);
		border-radius: 0.9rem;
		border: 1px solid color-mix(in srgb, var(--c) 32%, var(--cp-line));
		background: var(--cp-card);
		box-shadow: 0 36px 80px -34px rgba(0, 0, 0, 0.65);
		color: var(--cp-ink);
		transform: rotate(-0.5deg);
		transition: border-color 0.3s ease, box-shadow 0.3s ease;
	}
	.cb-front:hover {
		border-color: color-mix(in srgb, var(--c) 60%, transparent);
		box-shadow: 0 40px 90px -32px color-mix(in srgb, var(--c) 40%, transparent);
	}
	@media (min-width: 880px) {
		.cb-front { grid-template-columns: 1fr 1.05fr; }
	}
	@media (max-width: 879px) {
		.cb-front { transform: none; }
	}
	.cb-front-media {
		position: relative;
		display: block;
		overflow: hidden;
		border-radius: 0.6rem;
		aspect-ratio: 16 / 10;
		border: 1px solid var(--cp-line);
	}
	.cb-front-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.cb-front:hover .cb-front-media img { transform: scale(1.05); }
	.cb-front-cat,
	.cb-note-cat {
		position: absolute;
		left: 0.7rem;
		bottom: 0.7rem;
		font-family: var(--cp-marker);
		font-size: 0.8rem;
		font-weight: 700;
		color: #fff;
		padding: 0.24rem 0.7rem;
		border-radius: 9999px;
		background: color-mix(in srgb, var(--c) 80%, #000);
	}
	.cb-front-body { display: grid; gap: 0.55rem; align-content: center; }
	.cb-front-kick {
		font-family: ui-monospace, monospace;
		font-size: 0.7rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--c);
	}
	.cb-front-title {
		font-size: clamp(1.4rem, 2.8vw, 2.1rem);
		font-weight: 850;
		letter-spacing: -0.02em;
		line-height: 1.15;
	}
	.cb-front-desc {
		font-size: 0.95rem;
		line-height: 1.65;
		color: var(--cp-muted);
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	/* ── C · the notice board ── */
	.cb-filter { display: block; }
	.cb-radio { position: absolute; opacity: 0; pointer-events: none; }
	.cb-tabs {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.55rem;
		margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
	}
	.cb-tab {
		display: inline-flex;
		align-items: baseline;
		gap: 0.45rem;
		padding: 0.5rem 1rem;
		border-radius: 9999px;
		border: 1px solid var(--cp-line);
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--cp-muted);
		cursor: pointer;
		transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
	}
	.cb-tab:hover { transform: translateY(-2px); color: var(--cp-ink); }
	.cb-tab span { font-family: var(--cp-marker); font-size: 0.85rem; color: var(--cp-acc); }
	#cbl-all:checked ~ .cb-tabs [for='cbl-all'] {
		color: #2b1500;
		background: linear-gradient(95deg, #fbbf24, var(--cp-acc));
		border-color: transparent;
	}
	#cbl-all:checked ~ .cb-tabs [for='cbl-all'] span { color: #2b1500; }

	/* ── A · the easel ── */
	.cb-sec--easel { padding-bottom: clamp(1rem, 2.5vw, 1.6rem); }
	.cb-easel { position: relative; max-width: 54rem; margin: 0 auto; padding-bottom: 1.6rem; }
	.cb-easel-sheet {
		position: absolute;
		left: 50%;
		border-radius: 0.4rem;
		background: linear-gradient(180deg, #f6efdd, #efe4cb);
		box-shadow: 0 10px 24px -18px rgba(0, 0, 0, 0.7);
	}
	.cb-easel-sheet--2 { top: -10px; width: 96%; height: 60px; transform: translateX(-50%) rotate(-0.5deg); }
	.cb-easel-sheet--3 { top: -19px; width: 92%; height: 60px; transform: translateX(-50%) rotate(0.7deg); opacity: 0.75; }
	.cb-easel-sheet--2 { background: linear-gradient(180deg, #f2e9d4, #e7dbc0); }
	.cb-easel-sheet--3 { background: linear-gradient(180deg, #ece2ca, #ded1b3); }
	.cb-easel-page {
		position: relative;
		z-index: 2;
		padding: clamp(2.1rem, 4.5vw, 3rem) clamp(1.4rem, 4vw, 3rem) clamp(1.8rem, 4vw, 2.6rem);
		border-radius: 0.5rem;
		color: #2b1c08;
		text-align: center;
		background:
			repeating-linear-gradient(90deg, transparent 0 31px, rgba(43, 28, 8, 0.045) 31px 32px),
			repeating-linear-gradient(180deg, transparent 0 31px, rgba(43, 28, 8, 0.045) 31px 32px),
