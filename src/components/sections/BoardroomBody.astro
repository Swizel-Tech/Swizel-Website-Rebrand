		margin-top: 0.22rem;
		font-size: clamp(0.7rem, 0.82vw, 0.78rem);
		line-height: 1.3;
		color: rgba(245, 245, 247, 0.5);
	}

	@media (prefers-reduced-motion: reduce) {
		.bd-band .bd-trend-line { stroke-dashoffset: 0; }
		.bd-band.is-on .bd-trend-line { animation: none; }
		.bd-number,
		.bd-number:hover { transform: none; transition: none; }
	}
	/* The band stays one row of five on every screen — it is a line of
	   figures, and a line of figures wrapped over two rows is a table.
	   What gives instead is the weight: the icon goes, the label shortens
	   to a single word, and the card loses its frame until only the
	   numbers and their lines are left. */
	.bd-number-s { display: none; }
	@media (max-width: 880px) {
		.bd-numbers { gap: clamp(0.25rem, 1.2vw, 0.6rem); }
		.bd-number { padding: 0.75rem 0.3rem 0.5rem; }
		.bd-number-ic { width: 1.5rem; height: 1.5rem; border-radius: 0.45rem; margin-bottom: 0.35rem; }
		.bd-number-ic :global(svg) { width: 12px; height: 12px; }
		.bd-number strong { font-size: clamp(1.05rem, 3.2vw, 1.6rem); }
		.bd-number-l { font-size: 0.62rem; }
	}
	@media (max-width: 620px) {
		.bd-number {
			padding: 0.55rem 0.15rem 0.4rem;
			border-color: transparent;
			background: none;
		}
		.bd-number-ic { display: none; }
		.bd-number strong { font-size: clamp(0.95rem, 4.4vw, 1.35rem); }
		.bd-number-l { display: none; }
		.bd-number-s {
			display: block;
			margin-top: 0.15rem;
			font-size: clamp(0.54rem, 2.1vw, 0.66rem);
			line-height: 1.2;
			letter-spacing: 0.01em;
			color: rgba(245, 245, 247, 0.5);
		}
		.bd-trend { height: 10px; margin-top: 0.4rem; }
		.bd-band { padding-inline: clamp(0.7rem, 3vw, 1.2rem); }
		.bd-band .bd-h { font-size: clamp(1.15rem, 5vw, 1.5rem); }
		.bd-band .bd-p { font-size: 0.76rem; }
	}

	@media (max-width: 880px) {
		.bd-band { padding-inline: clamp(1.2rem, 5vw, 2rem); }
	}
	.bd-number strong {
		display: block;
		font-size: clamp(1.7rem, 3.1vw, 2.4rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		background: linear-gradient(135deg, #9bd8ff, var(--bd-accent));
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}


	/* ── Rotating quotes — fixed height so the page never shifts,
	   stylishly overlapping the numbers tile above ── */
	.bd-tile--quote {
		height: clamp(15rem, 26vw, 17rem);
		padding: 0;
		justify-content: center;
		width: min(100%, 72rem);
		margin: calc(-1 * clamp(2.2rem, 5vw, 3.6rem)) auto 0;
		z-index: 2;
		box-shadow: 0 30px 70px -28px rgba(0, 0, 0, 0.85);
	}
	.bd-quote {
		max-width: 44rem;
		margin: 0 auto;
		opacity: 0;
		transform: translateY(14px);
		transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: clamp(1.5rem, 3vw, 2.25rem) clamp(1.25rem, 4vw, 4rem) 2.8rem;
		pointer-events: none;
	}
	.bd-quote.is-live {
		opacity: 1;
		transform: translateY(0);
		pointer-events: auto;
	}
	.bd-quote.is-leaving {
		opacity: 0;
		transform: translateY(-14px);
	}
	@media (max-width: 640px) {
		.bd-tile--quote {
			height: 21rem;
			/* phones: no stylish overlap — clear breathing room between cards */
			margin-top: 1.25rem;
		}
		.bd-quote p {
			font-size: 1.12rem;
		}
	}

	/* ── Section headers + centered copy ── */
	.bd-head {
		max-width: 56rem;
		margin: clamp(2.5rem, 6vw, 4rem) auto clamp(1.5rem, 3vw, 2rem);
		text-align: center;
	}
	.bd-p--center {
		margin-inline: auto;
		text-align: center;
	}
	.bd-h--sm {
		font-size: clamp(1.35rem, 2.6vw, 1.9rem);
	}

	/* ── Discipline tiles — airy, icon-led, one loud ── */
	/* narrower than the cinematic tiles: room to breathe on both sides */
	.bd-mosaic--svc,
	.bd-grid--narrow {
		max-width: 72rem;
	}
	.bd-mosaic--svc {
		gap: clamp(1.25rem, 2.5vw, 2rem);
	}
	/* ── the four disciplines ──
	   Each card is a photograph of that discipline happening, with the
	   words set on it. The picture is the card; the padding just keeps
	   the type off the edge. Because every tile now sits on a dark frame,
	   the type is white in both themes rather than following the body. */
	.bd-tile--svc {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		text-align: left;
		align-items: flex-start;
		gap: 0;
		min-height: clamp(18rem, 25vw, 23rem);
		padding: clamp(1.6rem, 3.2vw, 2.4rem);
		background: #05070d;
	}
	/* one rule for all three kinds of media — a still, a running reel,
	   or a stack of stills changing over */
	.bd-svc-media {
		position: absolute;
		pointer-events: none;
		inset: 0;
		z-index: -2;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.bd-tile--svc:hover .bd-svc-media { transform: scale(1.04); }
	.bd-svc-scrim {
		position: absolute;
		inset: 0;
		z-index: -1;
		background: linear-gradient(
			to top,
			rgba(4, 6, 12, 0.94) 0%,
			rgba(4, 6, 12, 0.78) 38%,
			rgba(4, 6, 12, 0.42) 68%,
			rgba(4, 6, 12, 0.3) 100%
		);
	}

	.bd-svc-body { display: block; width: 100%; }
	/* one line of copy at a time: the long pair above 620, the short pair
	   below it, so a card a third narrower still reads in two lines */
	.bd-svc-p--sm { display: none; }
	@media (max-width: 620px) {
		.bd-tile--svc .bd-svc-p { display: none; }
		.bd-tile--svc .bd-svc-p--sm { display: block; }
	}
	/* every card is a dark frame now, so the type is white in both themes
	   rather than following the body's ink */
	.bd-tile--svc .bd-h--sm { color: #fff; }
	.bd-tile--svc .bd-svc-p { color: rgba(255, 255, 255, 0.82); }
	.bd-tile--svc .bd-chip {
		border-color: rgba(255, 255, 255, 0.34);
		color: rgba(255, 255, 255, 0.9);
	}
	.bd-tile--svc .bd-svc-ic {
		background: rgba(255, 255, 255, 0.14);
		border-color: rgba(255, 255, 255, 0.36);
		color: #fff;
	}
	.bd-tile--svc .bd-h--sm {
		margin: 1rem 0 0.45rem;
	}
	.bd-tile--svc .bd-svc-p {
		margin-bottom: 0.9rem;
		font-size: clamp(0.82rem, 1.05vw, 0.95rem);
		line-height: 1.48;
	}

	.bd-svc-p {
		margin: 0 0 1.4rem;
		margin-inline: 0;
		max-width: 34rem;
	}
	.bd-svc-ic {
		display: grid;
		place-items: center;
		width: 58px;
		height: 58px;
		flex-shrink: 0;
		border-radius: 1.1rem;
		background: linear-gradient(
			135deg,
			color-mix(in srgb, var(--bd-accent) 26%, transparent),
			color-mix(in srgb, var(--bd-accent) 8%, transparent)
		);
		border: 1px solid color-mix(in srgb, var(--bd-accent) 35%, transparent);
		color: #9bd8ff;
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2);
	}
	.bd-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.bd-chip {
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		padding: 0.3rem 0.7rem;
		border-radius: 9999px;
		border: 1px solid color-mix(in srgb, var(--bd-ink) 16%, transparent);
		color: color-mix(in srgb, var(--bd-ink) 55%, transparent);
	}

	/* the loud one — shock and awe */
	/* the featured card still runs blue — the colour sits on the picture
	   now instead of replacing it, so it leads the row without going flat */
	.bd-tile--loud .bd-svc-scrim {
		background:
			radial-gradient(480px 260px at 85% -10%, rgba(255, 255, 255, 0.24), transparent 60%),
			linear-gradient(135deg, rgba(3, 105, 161, 0.44) 0%, rgba(30, 64, 175, 0.5) 60%, rgba(13, 148, 179, 0.36) 130%),
			linear-gradient(to top, rgba(3, 5, 11, 0.72), rgba(3, 5, 11, 0.18) 62%);
	}
	.bd-tile--loud {
		border-color: rgba(255, 255, 255, 0.45);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.45),
			0 40px 90px -30px rgba(14, 165, 233, 0.65);
	}
	.bd-tile--loud:hover {
		border-color: rgba(255, 255, 255, 0.7);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.5),
			0 48px 110px -30px rgba(14, 165, 233, 0.85);
	}
	.bd-tile--loud .bd-h--sm,
	.bd-tile--loud .bd-svc-p {
		color: #ffffff;
	}
	.bd-tile--loud .bd-svc-p {
		color: rgba(255, 255, 255, 0.85);
	}
	.bd-tile--loud .bd-svc-ic {
		background: rgba(255, 255, 255, 0.18);
		border-color: rgba(255, 255, 255, 0.5);
		color: #ffffff;
	}
	.bd-tile--loud .bd-chip {
		border-color: rgba(255, 255, 255, 0.45);
		color: rgba(255, 255, 255, 0.9);
	}
	/* Two across means half the room for the words, so the whole card
	   comes down a size rather than the text spilling out of it. The
	   min-height goes as well: a card that is as tall as it was at full
	   width, at half the width, is a tower. */
	@media (max-width: 940px) {
		.bd-tile--svc {
			/* the two in a row share a height, so the 7/5 difference is
			   read as width — the shape of the composition, not a ragged
			   bottom edge */
			min-height: 0;
			aspect-ratio: auto;
			height: 100%;
			padding: clamp(0.9rem, 2.6vw, 1.3rem);
		}
		.bd-mosaic--svc { grid-auto-rows: clamp(11rem, 30vw, 15rem); }
		.bd-tile--svc .bd-h--sm { font-size: 1.02rem; margin: 0.55rem 0 0.25rem; }
		.bd-tile--svc .bd-svc-p { font-size: 0.76rem; margin-bottom: 0.6rem; }
		.bd-tile--svc .bd-svc-ic { width: 34px; height: 34px; border-radius: 0.6rem; }
		.bd-tile--svc .bd-svc-ic :global(svg) { width: 17px; height: 17px; }
		.bd-tile--svc .bd-chip { font-size: 0.6rem; padding: 0.22rem 0.5rem; }
		.bd-tile--svc .bd-chips { gap: 0.28rem; }
	}
	/* Two across on a phone as well. What gives is weight, not layout:
	   the type comes down again and the chips fall away, because four
	   photographs in a single column is the shape this was trying to
	   avoid in the first place. */
	@media (max-width: 620px) {
		.bd-mosaic--svc { gap: 0.5rem; grid-auto-rows: clamp(9.5rem, 40vw, 13rem); }
		.bd-tile--svc { padding: 0.7rem 0.6rem 0.75rem; }
		.bd-tile--svc .bd-h--sm { font-size: 0.92rem; margin: 0.4rem 0 0.2rem; }
		.bd-tile--svc .bd-svc-p { font-size: 0.66rem; line-height: 1.35; margin-bottom: 0; }
		.bd-tile--svc .bd-svc-ic { width: 28px; height: 28px; border-radius: 0.5rem; }
		.bd-tile--svc .bd-svc-ic :global(svg) { width: 14px; height: 14px; }
		/* the chips are the first thing to go: at this width they are four
		   grey pills and no information */
		.bd-tile--svc .bd-chips { display: none; }
		.bd-svc-p {
			margin-inline: auto;
		}
		.bd-chips {
			justify-content: center;
		}
	}

	/* ── Process section — the whole tile runs warm crimson, subtle ── */
	.bd-tile--heat {
		background:
			radial-gradient(760px 340px at 50% -12%, rgba(225, 29, 72, 0.2), transparent 70%),
			radial-gradient(620px 320px at 88% 110%, rgba(225, 29, 72, 0.1), transparent 65%),
			linear-gradient(160deg, rgba(225, 29, 72, 0.07), rgba(255, 255, 255, 0.02) 55%);
		border-color: rgba(225, 29, 72, 0.3);
	}
	.bd-tile--heat:hover {
		border-color: rgba(225, 29, 72, 0.5);
		box-shadow: 0 40px 90px -36px rgba(225, 29, 72, 0.4);
	}
	.bd-tile--heat .bd-h {
		background: linear-gradient(110deg, currentColor 55%, #fda4af);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	/* ═══ Bring your project to life ═══════════════════════════════════
	   One sequence, one clock. Everything below is timed off --t, the
	   length of the pull, so the letters cannot start before the bulb
	   catches and the card cannot wake before the line is read.

	     0     → 0.38t   the hand comes up and takes the ring
	     0.46t → 0.58t   it pulls, and the bulb catches
	     0.64t → out     the hand lets go and leaves
	     t     → +1.6s   the headline lights, a letter at a time
	     then            the headline breathes, and the card wakes
	   ══════════════════════════════════════════════════════════════════ */
	.bd-life {
		--t: 2.1s;          /* the pull */
		--lag: 0.055s;      /* one letter to the next */
		position: relative;
		overflow: hidden;
	}

	/* ── the lamp, in the corner of the card ── */
	.bd-lamp {
		position: absolute;
		top: 0;
		right: clamp(0.75rem, 3vw, 2.6rem);
		width: clamp(96px, 11vw, 148px);
		pointer-events: none;
		z-index: 1;
	}
	.bd-lamp-svg { display: block; width: 100%; height: auto; overflow: visible; }

	/* off: everything is cold, and the flare is not there at all */
	.lamp-wire,
	.lamp-cord { stroke: color-mix(in srgb, var(--bd-ink) 34%, transparent); }
	.lamp-cap { fill: color-mix(in srgb, var(--bd-ink) 30%, transparent); }
	.lamp-ring { stroke: color-mix(in srgb, var(--bd-ink) 40%, transparent); }
	.lamp-bulb {
		fill: color-mix(in srgb, var(--bd-ink) 9%, transparent);
		stroke: color-mix(in srgb, var(--bd-ink) 26%, transparent);
		stroke-width: 2;
		transition: fill 0.25s ease, stroke 0.25s ease;
	}
	.lamp-filament { stroke: color-mix(in srgb, var(--bd-ink) 34%, transparent); }
	.lamp-rays { stroke: #7cd4ff; opacity: 0; }
	.lamp-flare { opacity: 0; }
	.lamp-cuff { fill: #e11d48; }
	.lamp-fist,
	.lamp-thumb { fill: #fda4af; }
	/* The fist is 32 wide and sits at 0,14 in its own group, so its centre
	   is (16, 27); the ring's centre is (96, 157). Putting one on the other
	   is therefore a translate of (80, 130) — worked out rather than
	   nudged, which is why it lands on the ring instead of beside it. */
	.lamp-hand { opacity: 0; transform: translate(104px, 214px); }
	.lamp-cord { transform-origin: 96px 104px; }

	/* on */
	.bd-life.is-lit .lamp-hand { animation: bd-hand var(--t) cubic-bezier(0.4, 0, 0.2, 1) forwards; }
	.bd-life.is-lit .lamp-cord { animation: bd-cord var(--t) cubic-bezier(0.34, 1.4, 0.5, 1) forwards; }
	.bd-life.is-lit .lamp-ring { animation: bd-ring var(--t) cubic-bezier(0.34, 1.4, 0.5, 1) forwards; }
	.bd-life.is-lit .lamp-flare { animation: bd-catch var(--t) linear forwards; }
	.bd-life.is-lit .lamp-rays { animation: bd-rays var(--t) linear forwards; }
	.bd-life.is-lit .lamp-bulb {
		animation: bd-bulb var(--t) linear forwards;
	}
	.bd-life.is-lit .lamp-filament { animation: bd-filament var(--t) linear forwards; }

	@keyframes bd-hand {
		0%   { transform: translate(104px, 214px); opacity: 0; }
		12%  { opacity: 1; }
		38%  { transform: translate(80px, 130px); opacity: 1; }  /* on the ring */
		46%  { transform: translate(80px, 130px); opacity: 1; }
		58%  { transform: translate(80px, 164px); opacity: 1; }  /* pulled down */
		68%  { transform: translate(80px, 126px); opacity: 1; }  /* let go */
		82%  { opacity: 0.7; }
		100% { transform: translate(110px, 210px); opacity: 0; }
	}
	/* the cord stretches from the socket rather than sliding away from it */
	@keyframes bd-cord {
		0%, 46%  { transform: scaleY(1); }
		58%      { transform: scaleY(1.74); }
		68%      { transform: scaleY(0.93); }
		76%      { transform: scaleY(1.04); }
		100%     { transform: scaleY(1); }
	}
	@keyframes bd-ring {
		0%, 46%  { transform: translateY(0); }
		58%      { transform: translateY(34px); }
		68%      { transform: translateY(-4px); }
		76%      { transform: translateY(2px); }
		100%     { transform: translateY(0); }
	}
	/* the catch is not clean — it stutters once before it holds */
	@keyframes bd-catch {
		0%, 55%  { opacity: 0; transform: scale(0.5); }
		58%      { opacity: 1; transform: scale(1.35); }
		61%      { opacity: 0.3; transform: scale(1.05); }
		64%      { opacity: 1; transform: scale(1.18); }
		78%      { opacity: 1; transform: scale(1); }
		100%     { opacity: 1; transform: scale(1); }
	}
	@keyframes bd-rays {
		0%, 55%  { opacity: 0; transform: scale(0.82); }
		60%      { opacity: 1; transform: scale(1.12); }
		70%      { opacity: 0.7; transform: scale(1); }
		100%     { opacity: 0.7; transform: scale(1); }
	}
	@keyframes bd-bulb {
		0%, 55%  { fill: color-mix(in srgb, var(--bd-ink) 9%, transparent); stroke: color-mix(in srgb, var(--bd-ink) 26%, transparent); }
		58%, 100% { fill: #e6f6ff; stroke: #28a6ec; }
	}
	@keyframes bd-filament {
		0%, 55%  { stroke: color-mix(in srgb, var(--bd-ink) 34%, transparent); }
		58%, 100% { stroke: #0b6fa4; }
	}

	/* ── the room, before the light ──
	   The card dims as the hand takes the cord and clears the moment the
	   bulb catches, so the light reads as the thing that brought it into
	   focus rather than a lamp drawn on an already-lit card. It is a
	   little deeper in the light theme, which has further to fall. */
	.bd-life-dusk {
		position: absolute;
		inset: 0;
		z-index: 2;
		pointer-events: none;
		opacity: 0;
		background: radial-gradient(
			130% 130% at 82% 4%,
			rgba(4, 10, 20, 0.08),
			rgba(4, 10, 20, 0.62) 72%
		);
		backdrop-filter: saturate(0.72) brightness(0.88);
		-webkit-backdrop-filter: saturate(0.72) brightness(0.88);
	}
	:global(html.dark) .bd-life-dusk {
		background: radial-gradient(
			130% 130% at 82% 4%,
			rgba(0, 3, 9, 0.1),
			rgba(0, 3, 9, 0.5) 72%
		);
	}
	.bd-life.is-lit .bd-life-dusk { animation: bd-dusk var(--t) ease-out forwards; }
	@keyframes bd-dusk {
		0%   { opacity: 0; }
		30%  { opacity: 0.55; }
		52%  { opacity: 1; }
		58%  { opacity: 0.18; }   /* the catch */
		61%  { opacity: 0.6; }    /* the stutter */
		66%  { opacity: 0; }
		100% { opacity: 0; }
	}
	.lamp-rays,
	.lamp-flare { transform-origin: 66px 126px; }

	/* ── the headline, lit a letter at a time ── */
	.bd-life-h {
		/* the gradient the heat tile paints on every heading would fight
		   the per-letter light, so this one keeps its own colour */
		background: none !important;
		-webkit-text-fill-color: currentColor !important;
		color: var(--bd-ink);
	}
	/* an empty box of exactly one word space: a real space character
	   between inline-block letters came out at nearly double width */
	.bd-life-sp { display: inline-block; width: 0.26em; }
	.bd-life-l {
		display: inline-block;
		color: color-mix(in srgb, var(--bd-ink) 34%, transparent);
		text-shadow: none;
	}
	.bd-life.is-lit .bd-life-l {
		animation: bd-letter 0.5s ease forwards;
		animation-delay: calc(var(--t) + var(--i) * var(--lag));
	}
	@keyframes bd-letter {
		0%   { color: color-mix(in srgb, var(--bd-ink) 34%, transparent); text-shadow: none; }
		55%  { color: #eaf7ff; text-shadow: 0 0 24px rgba(40, 166, 236, 0.95), 0 0 52px rgba(154, 220, 255, 0.55); }
		100% { color: var(--bd-ink); text-shadow: 0 0 18px rgba(40, 166, 236, 0.45); }
	}
	/* and then it breathes, three times, and settles */
	.bd-life.is-lit .bd-life-h {
		animation: bd-breathe 1.15s ease-in-out 3;
		/* every letter's delay plus the last letter's own run */
		animation-delay: calc(var(--t) + 27 * var(--lag) + 0.5s);
	}
	@keyframes bd-breathe {
		0%, 100% { filter: drop-shadow(0 0 0 rgba(40, 166, 236, 0)); }
		50%      { filter: drop-shadow(0 0 18px rgba(40, 166, 236, 0.6)); }
	}

	/* ── then the rest of the card comes up behind it ── */
	.bd-wake { opacity: 0; transform: translateY(14px); }
	.bd-life.is-lit .bd-wake {
		animation: bd-wake 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
		animation-delay: calc(var(--t) + 27 * var(--lag) + 0.35s + var(--w) * 0.12s);
	}
	@keyframes bd-wake {
		to { opacity: 1; transform: none; }
	}

	/* ── the three boxes get a slow light of their own ── */
	/* named "weather", not "aura": global.css stops anything whose class
	   carries glow/aura/shimmer from animating on weak hardware, which is
	   right for decoration that never stops and wrong for a card's own
	   background coming up once. The perpetual drift is still dropped for
	   those machines, just below. */
	.bd-step-weather {
		position: absolute;
		inset: 0;
		border-radius: inherit;
		opacity: 0;
		pointer-events: none;
		background:
			radial-gradient(120px 90px at 18% 12%, rgba(253, 164, 175, 0.5), transparent 68%),
			radial-gradient(150px 110px at 86% 84%, rgba(251, 191, 36, 0.34), transparent 70%),
			radial-gradient(130px 100px at 62% 18%, rgba(225, 29, 72, 0.4), transparent 72%);
		background-size: 220% 220%;
		background-position: 0% 50%;
		filter: blur(6px);
	}
	.bd-life.is-lit .bd-step-weather {
		animation:
			bd-weather-in 1s ease forwards,
			bd-weather 16s linear infinite;
		animation-delay:
			calc(var(--t) + 27 * var(--lag) + 0.45s + var(--w) * 0.12s),
			calc(var(--t) + 27 * var(--lag) + 0.45s + var(--w) * 1.9s);
	}
	@keyframes bd-weather-in { to { opacity: 0.5; } }
	@keyframes bd-weather {
		0%   { background-position: 0% 50%; }
		50%  { background-position: 100% 50%; }
		100% { background-position: 0% 50%; }
	}
	/* the words sit above their own weather */
	.bd-step > *:not(.bd-step-weather) { position: relative; z-index: 1; }
	.bd-step { overflow: hidden; }

	/* Nothing here is load-bearing: a visitor who asks for less motion, or
	   a machine that cannot spare the frames, gets the lit card at once. */
	@media (prefers-reduced-motion: reduce) {
		.bd-life .lamp-hand { display: none; }
		.bd-life .lamp-flare { opacity: 1; }
		.bd-life .lamp-rays { opacity: 0.7; }
		.bd-life .lamp-bulb { fill: #e6f6ff; stroke: #28a6ec; }
		.bd-life .lamp-filament { stroke: #0b6fa4; }
		.bd-life .bd-life-dusk { display: none; }
		.bd-life .bd-life-l { color: var(--bd-ink); }
		.bd-life .bd-wake { opacity: 1; transform: none; }
		.bd-life .bd-step-weather { opacity: 0.4; animation: none; }
		.bd-life.is-lit .bd-life-l,
		.bd-life.is-lit .bd-life-h,
		.bd-life.is-lit .bd-wake,
		.bd-life.is-lit .bd-step-weather { animation: none; }
	}
	:global(html.perf-lite) .bd-life .bd-step-weather { filter: none; animation-name: bd-weather-in !important; }

	@media (max-width: 720px) {
		.bd-lamp { right: 0.4rem; width: 82px; }
	}

	/* ── Process steps ── */
	.bd-steps {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.25rem;
		list-style: none;
		margin: 0.75rem 0 0.5rem;
		padding: 0;
	}
	@media (max-width: 720px) {
		.bd-steps { gap: 0.6rem; }
		.bd-step { padding: 1rem 0.6rem 0.85rem; border-radius: 0.9rem; }
		.bd-step-n { font-size: 1.7rem; }
		.bd-step-t { font-size: 0.86rem; }
		.bd-step-d { font-size: 0.74rem; }
	}
	/* three across on a phone as well: stacked, one short sentence each,
	   they turned a three-beat process into a page of scrolling */
	@media (max-width: 480px) {
		.bd-steps { gap: 0.4rem; }
		.bd-step { padding: 0.8rem 0.35rem 0.85rem; border-radius: 0.7rem; }
		.bd-step-n { font-size: 1.25rem; margin-bottom: 0.25rem; }
		.bd-step-t { font-size: 0.78rem; margin-bottom: 0; }
		.bd-step .bd-step-t:not(.bd-step-t--sm) { display: none; }
		.bd-step .bd-step-t--sm { display: block; }
		/* the sentence goes: at a third of a phone it wraps six lines deep
		   and turns a three-beat process back into the column this was
		   meant to fix. The number and the name carry it. */
		.bd-step-d { display: none; }
		.bd-life {
			padding-inline: clamp(0.8rem, 3.5vw, 1.4rem);
			padding-block: clamp(1.2rem, 5vw, 1.8rem);
		}
		.bd-life .bd-h { font-size: clamp(1.2rem, 5.2vw, 1.55rem); }
		.bd-life .bd-p { font-size: 0.74rem; margin-top: 0.4rem; }
		.bd-life .bd-steps { margin-top: 0.9rem; }
		.bd-lamp { width: 54px; }
	}
	.bd-step {
		position: relative;
		padding: 1.4rem 1.2rem 1.2rem;
		border-radius: 1.25rem;
		border: 1px solid var(--bd-glass-border);
		background: color-mix(in srgb, var(--bd-ink) 3%, transparent);
		text-align: center;
		transition: border-color 0.3s ease, box-shadow 0.3s ease;
	}
	/* inside the heat tile every step runs warm; the middle burns brightest */
	.bd-tile--heat .bd-step {
		border-color: rgba(225, 29, 72, 0.18);
		background: color-mix(in srgb, #e11d48 3%, transparent);
	}
	.bd-tile--heat .bd-step:hover {
		border-color: rgba(225, 29, 72, 0.45);
		box-shadow: 0 24px 50px -24px rgba(225, 29, 72, 0.35);
	}
	.bd-tile--heat .bd-step-n {
		background: linear-gradient(135deg, #fda4af, #e11d48);
		-webkit-background-clip: text;
		background-clip: text;
	}
	.bd-tile--heat .bd-step:nth-child(2) {
		background:
			radial-gradient(340px 160px at 50% -20%, rgba(225, 29, 72, 0.18), transparent 70%),
			color-mix(in srgb, #e11d48 6%, transparent);
		border-color: rgba(225, 29, 72, 0.38);
	}
	.bd-step-n {
		display: block;
		font-size: clamp(2rem, 4vw, 2.8rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1;
		background: linear-gradient(135deg, #9bd8ff, var(--bd-accent));
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
		margin-bottom: 0.5rem;
	}
	.bd-step-t--sm { display: none; }
	.bd-step-t {
		font-size: 1.08rem;
		font-weight: 700;
		margin: 0 0 0.3rem;
	}
	.bd-step-d {
		font-size: 0.88rem;
		line-height: 1.5;
		color: var(--bd-muted);
		margin: 0;
	}

	/* ── Latest work — asymmetric proof grid ── */
	.bd-work {
		max-width: 88rem;
		margin: 0 auto;
	}
	.bd-work-grid {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		grid-auto-rows: clamp(130px, 16vw, 215px);
		gap: clamp(0.9rem, 2vw, 1.4rem);
	}
	.bd-work-card {
		position: relative;
		display: block;
		border-radius: 1.4rem;
		overflow: hidden;
		border: 1px solid var(--bd-glass-border);
		box-shadow: var(--bd-shadow);
	}
	.bd-work--feature {
		grid-column: span 7;
		grid-row: span 2;
	}
	.bd-work--side {
		grid-column: span 5;
	}
	.bd-work--third {
		grid-column: span 4;
	}
	@media (max-width: 880px) {
		.bd-work--feature {
			grid-column: span 12;
			grid-row: span 2;
		}
		.bd-work--side {
			grid-column: span 6;
		}
		.bd-work--third {
			grid-column: span 12;
		}
	}
	.bd-work-card img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.bd-work-card:hover img {
		transform: scale(1.05);
	}
	.bd-work-veil {
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, transparent 38%, rgba(5, 6, 14, 0.88));
		transition: background 0.4s ease;
	}
	.bd-work-meta {
		position: absolute;
		left: 1.1rem;
		right: 1.1rem;
		bottom: 0.95rem;
		display: flex;
		flex-direction: column;
		color: #fff;
	}
	.bd-work-meta strong {
		font-size: 1.05rem;
		font-weight: 700;
		letter-spacing: -0.01em;
	}
	.bd-work-meta em {
		font-style: normal;
		font-size: 0.76rem;
		color: rgba(255, 255, 255, 0.62);
	}
	.bd-work-go {
		position: absolute;
		top: 0.9rem;
		right: 0.9rem;
		display: grid;
		place-items: center;
		width: 34px;
		height: 34px;
		border-radius: 9999px;
		background: rgba(255, 255, 255, 0.12);
		backdrop-filter: blur(6px);
		color: #fff;
		opacity: 0;
		transform: translate(4px, -4px);
		transition: opacity 0.3s ease, transform 0.3s ease;
	}
	.bd-work-card:hover .bd-work-go {
		opacity: 1;
		transform: translate(0, 0);
	}
	.bd-work-all {
		text-align: center;
		margin: 1.4rem 0 0;
	}
	.bd-quote p {
		font-size: clamp(1.3rem, 2.6vw, 1.9rem);
		font-weight: 600;
		letter-spacing: -0.015em;
		line-height: 1.35;
		margin: 0 0 1.4rem;
	}
	.bd-quote footer {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
	}
	.bd-quote img {
		width: 44px;
		height: 44px;
		border-radius: 9999px;
		object-fit: cover;
		border: 2px solid color-mix(in srgb, var(--bd-accent) 50%, transparent);
	}
	.bd-quote footer span {
		display: flex;
		flex-direction: column;
		text-align: left;
		line-height: 1.25;
	}
	.bd-quote footer strong {
		font-size: 0.92rem;
	}
	.bd-quote footer em {
		font-style: normal;
		font-size: 0.78rem;
		color: var(--bd-muted);
	}
	.bd-quote-dots {
		position: absolute;
		bottom: 1.4rem;
		left: 50%;
		transform: translateX(-50%);
		display: flex;
		gap: 0.45rem;
	}
	.bd-qdot {
		width: 7px;
		height: 7px;
		padding: 0;
		border: 0;
		cursor: pointer;
		border-radius: 9999px;
		background: color-mix(in srgb, var(--bd-ink) 20%, transparent);
		transition: background 0.3s ease, transform 0.3s ease;
	}
	.bd-qdot.is-on {
		background: var(--bd-accent);
		transform: scale(1.25);
	}

	/* ── Marquees (sectors + logos) ── */
	.bd-marquee {
		overflow: hidden;
		-webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
		mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
	}
	.bd-marquee-track {
		display: flex;
		align-items: center;
		width: max-content;
	}
	.bd-marquee-track--sectors {
		animation: bd-drift 38s linear infinite;
	}
	.bd-marquee-track--logos {
		animation: bd-drift 30s linear infinite;
	}
	.bd-marquee:hover .bd-marquee-track {
		animation-play-state: paused;
	}
	@keyframes bd-drift {
		to {
			transform: translateX(-50%);
		}
	}

	.bd-sectors {
		max-width: 88rem;
		margin: clamp(2.5rem, 6vw, 4rem) auto clamp(2rem, 5vw, 3.5rem);
		text-align: center;
	}
	.bd-sectors .bd-h {
		margin-bottom: 1.4rem;
	}
	.bd-marquee--b { margin-top: clamp(0.5rem, 1.2vw, 0.9rem); }
	.bd-marquee-track--back {
		animation-duration: 52s;
		animation-direction: reverse;
	}
	.bd-sector {
		flex-shrink: 0;
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		margin-right: clamp(0.7rem, 1.6vw, 1.15rem);
		padding: 0.42em 0.95em;
		border-radius: 999px;
		border: 1px solid color-mix(in srgb, var(--bd-ink) 11%, transparent);
		background: color-mix(in srgb, var(--bd-ink) 3%, transparent);
		font-size: clamp(1.05rem, 2vw, 1.45rem);
		font-weight: 700;
		letter-spacing: -0.015em;
		color: color-mix(in srgb, var(--bd-ink) 46%, transparent);
		transition: color 0.3s ease, border-color 0.3s ease, background 0.3s ease,
			transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
		cursor: default;
	}
	.bd-sector--sm { font-size: clamp(0.88rem, 1.5vw, 1.1rem); }
	.bd-sector-dot {
		width: 0.42em;
		height: 0.42em;
		border-radius: 50%;
		background: currentColor;
		opacity: 0.5;
		flex: none;
	}
	/* a few run in the accent so the rail is never one flat grey line */
	.bd-sector.is-hot {
		color: var(--bd-accent);
		border-color: color-mix(in srgb, var(--bd-accent) 34%, transparent);
		background: color-mix(in srgb, var(--bd-accent) 8%, transparent);
	}
	.bd-sector.is-hot .bd-sector-dot { opacity: 1; }
	.bd-sector:hover {
		color: var(--bd-accent);
		border-color: color-mix(in srgb, var(--bd-accent) 55%, transparent);
		background: color-mix(in srgb, var(--bd-accent) 12%, transparent);
		transform: translateY(-3px);
	}

	.bd-logos {
		max-width: 88rem;
		margin: clamp(2.5rem, 5vw, 3.5rem) auto 0;
		text-align: center;
	}
	.bd-logos-line {
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--bd-ink) 38%, transparent);
		margin: 0 0 1.3rem;
	}
	/* Our clients' marks, in their own colours. Almost every one of them
	   is dark artwork, so on the boardroom's dark body they need a light
	   card to sit on — flattening them to white would have been easier and
	   would have thrown away the thing that makes a logo a logo. */
	.bd-logo {
		flex-shrink: 0;
		display: grid;
		place-items: center;
		margin-right: clamp(1.1rem, 2.4vw, 2rem);
		padding: 0.7rem clamp(0.9rem, 1.8vw, 1.4rem);
		border-radius: 0.9rem;
		background: rgba(255, 255, 255, 0.94);
		border: 1px solid rgba(255, 255, 255, 0.5);
		box-shadow: 0 12px 30px -18px rgba(0, 0, 0, 0.6);
		transition: transform 0.3s ease, box-shadow 0.3s ease, background 0.3s ease;
	}
	:global(html:not(.dark)) .bdbody .bd-logo {
		background: #fff;
		border-color: color-mix(in srgb, var(--bd-ink) 8%, transparent);
		box-shadow: 0 14px 30px -22px rgba(20, 22, 40, 0.4);
	}
	.bd-logo img {
		height: 32px;
		width: auto;
		max-width: 132px;
		object-fit: contain;
		opacity: 0.88;
		transition: opacity 0.3s ease, transform 0.3s ease;
	}
	.bd-logo:hover {
		background: #fff;
		transform: translateY(-3px);
		box-shadow: 0 20px 44px -20px rgba(0, 0, 0, 0.55);
	}
	.bd-logo:hover img {
		opacity: 1;
		transform: scale(1.04);
	}

	/* ── Final CTA ── */
	/* ── the closing tile ── */
	.bd-tile--cta {
		position: relative;
		overflow: hidden;
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
		align-items: stretch;
		gap: 0;
		padding: 0;
		text-align: left;
		background:
			radial-gradient(760px 420px at 6% 110%, color-mix(in srgb, var(--bd-accent) 26%, transparent), transparent 70%),
			linear-gradient(180deg, rgba(14, 19, 36, 0.96), rgba(4, 6, 13, 0.98));
		color: #f5f5f7;
		border-color: color-mix(in srgb, var(--bd-accent) 26%, rgba(255, 255, 255, 0.1));
	}
	.bd-cta-copy {
		padding: clamp(2.2rem, 5vw, 4.2rem) clamp(1.4rem, 3.4vw, 3.4rem);
		align-self: center;
		/* a grid item's automatic minimum is its content, and a phone
		   number set nowrap is wide content: without this the column grows
		   past the tile and the tile quietly clips it */
		min-width: 0;
	}
	.bd-cta-kick {
		display: inline-flex;
		align-items: center;
		gap: 0.85rem;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.26em;
		text-transform: uppercase;
		color: rgba(245, 245, 247, 0.6);
	}
	.bd-cta-kick i {
		width: clamp(1.6rem, 3vw, 2.6rem);
		height: 2px;
		border-radius: 999px;
		background: var(--bd-accent);
	}
	.bd-display--cta {
		margin: clamp(0.9rem, 2vw, 1.3rem) 0 0;
		font-size: clamp(2.1rem, 4.4vw, 3.6rem);
		line-height: 1.02;
		letter-spacing: -0.04em;
	}
	.bd-display--cta em {
		display: block;
		font-style: normal;
		font-weight: 800;
		background: linear-gradient(100deg, #e9f6ff 10%, var(--bd-accent) 85%);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}
	.bd-tile--cta .bd-sub {
		margin: clamp(0.9rem, 2vw, 1.25rem) 0 0;
		max-width: 27rem;
		margin-inline: 0;
	}
	.bd-cta-act {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: clamp(1rem, 2.4vw, 2rem);
		margin-top: clamp(1.5rem, 3.2vw, 2.4rem);
	}
	/* the one thing on this tile we want pressed: it breathes until it is */
	.bd-cta-go {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		min-height: 3.35rem;
		padding: 0 1.8rem;
		border-radius: 999px;
		background: linear-gradient(120deg, var(--bd-accent), #3b7dfd);
		color: #04101a;
		font-size: 1rem;
		font-weight: 700;
		white-space: nowrap;
		transition: transform 0.25s ease, filter 0.25s ease;
	}
	.bd-cta-go::after {
		content: '';
		position: absolute;
		inset: -3px;
		border-radius: inherit;
		border: 2px solid var(--bd-accent);
		opacity: 0;
		pointer-events: none;
		animation: bd-cta-ring 2.6s cubic-bezier(0.22, 1, 0.36, 1) infinite;
	}
	@keyframes bd-cta-ring {
		0%   { transform: scale(1); opacity: 0.55; }
		70%  { transform: scale(1.16); opacity: 0; }
		100% { transform: scale(1.16); opacity: 0; }
	}
	.bd-cta-go:hover { transform: translateY(-2px); filter: brightness(1.06); }
	.bd-cta-go-s { display: none; }
	.bd-cta-go:hover::after { animation-play-state: paused; opacity: 0; }

	/* the photograph, with the promise stamped in its corner */
	.bd-cta-shot {
		position: relative;
		margin: 0;
		min-height: clamp(18rem, 30vw, 27rem);
	}
	/* The picture is dissolved into the tile rather than laid on top of
	   it: a dark veil over the photograph left a visible seam wherever the
	   veil's black and the tile's own gradient disagreed, which they do
	   everywhere except one row of pixels. Masking the image instead means
	   there is nothing to match — the photograph simply stops. */
	.bd-cta-shot img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 42% 50%;
		mask-image: linear-gradient(
			90deg,
			transparent 0%,
			rgba(0, 0, 0, 0.28) 14%,
			rgba(0, 0, 0, 0.82) 38%,
			#000 62%
		);
		-webkit-mask-image: linear-gradient(
			90deg,
			transparent 0%,
			rgba(0, 0, 0, 0.28) 14%,
			rgba(0, 0, 0, 0.82) 38%,
			#000 62%
		);
	}
	/* just enough shade at the top right to hold the stamp */
	.bd-cta-shot::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(200deg, rgba(4, 6, 13, 0.5), transparent 42%);
	}
	.bd-cta-stamp {
		position: absolute;
		top: clamp(1.1rem, 2.6vw, 2.2rem);
		right: clamp(1.1rem, 2.6vw, 2.2rem);
		z-index: 1;
		text-align: right;
		font-size: 0.66rem;
		font-weight: 600;
		letter-spacing: 0.24em;
		text-transform: uppercase;
		line-height: 1.9;
		color: rgba(245, 245, 247, 0.62);
	}
	.bd-cta-stamp strong { display: block; color: #fff; font-weight: 700; }
	.bd-cta-stamp::after {
		content: '';
