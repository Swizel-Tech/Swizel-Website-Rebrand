---
// Boardroom view body — deep, glossy, glassy. Asymmetric mosaic tiles,
// scrolling sectors + client logos, rotating client words, cinematic CTA.
import { Icon } from 'astro-icon/components';
import { projects, sectorLabels } from '../../data/projects';
import FilmPlayer from '../FilmPlayer.astro';

// Each figure gets a shape as well as a number: a seven-point line drawn
// on a 100×34 box, which the browser draws in stroke by stroke once the
// band arrives. The shapes are the honest ones — work compounding, a
// team growing in steps, a rating that has simply held.
// Five cards, and under each figure the shape it actually made: a
// seven-point line on a 100×34 box, drawn in stroke by stroke once the
// band arrives. The shapes are the honest ones — work compounding, a
// team growing in steps, a rating that has simply held.
const numbers = [
	{ to: 65, suffix: '+', label: 'Products shipped', short: 'Shipped', icon: 'mdi:cube-outline',
	  spark: 'M0 6.4 L17 5.6 L33 4.9 L50 3.7 L67 2.7 L83 1.4 L100 0.6' },
	{ to: 7, suffix: '+', label: 'Years in business', short: 'Years', icon: 'mdi:calendar-blank-outline',
	  spark: 'M0 6.4 L17 5.6 L33 4.7 L50 3.9 L67 3.1 L83 2.3 L100 1.4' },
	{ to: 25, suffix: '+', label: 'Specialists on the team', short: 'Specialists', icon: 'mdi:account-group-outline',
	  spark: 'M0 6.4 L17 6.4 L17 4.9 L42 4.9 L42 3.3 L71 3.3 L71 1.6 L100 1.6' },
	{ to: 10, suffix: '+', label: 'Countries served', short: 'Countries', icon: 'mdi:web',
	  spark: 'M0 6.2 L17 5.8 L33 6 L50 4.3 L67 3.7 L83 2.1 L100 1.2' },
	{ to: 5, decimals: 1, suffix: '', label: 'Average client rating', short: 'Rating', icon: 'mdi:star-outline',
	  spark: 'M0 1.4 L17 1.2 L33 1.4 L50 1 L67 1.4 L83 1.2 L100 1.2' },
];

// The four disciplines. Each card is a piece of the studio actually
// working rather than an icon on an empty box: the build reel for
// engineering, the table mid-review for design, the channels we run for
// marketing, and one engineer reading another's screen for the work that
// never ends. Copy is held to two lines on every card.
const disciplines = [
	{
		icon: 'mdi:palette-outline',
		cur: 'palette',
		title: 'Design',
		desc: ['Brand, interface and product design', 'your customers never have to think about.'],
		short: ['Brand and product', 'design that works.'],
		tag: 'brand · UI/UX · motion',
		span: 'bd-w5',
		img: 'https://i.ytimg.com/vi/EHi0Z2yqAr8/maxresdefault.jpg',
		fallback: '/images/film/room.jpg',
		pos: '50% 50%',
		alt: 'A frame from the Swizel Studio film',
	},
	{
		icon: 'mdi:code-tags',
		cur: 'term',
		title: 'Development',
		desc: ['Web and mobile engineering,', 'built to scale, shipped fast and kept standing.'],
		short: ['Web and mobile,', 'built to scale.'],
		tag: 'web · iOS · Android · APIs',
		span: 'bd-w7',
		loud: true,
		video: '/videos/how-we-build.mp4',
		poster: '/images/how-we-build-poster.jpg',
	},
	{
		icon: 'mdi:bullhorn-outline',
		cur: 'pulse',
		title: 'Marketing',
		desc: ['Search, paid, social and content,', 'run as one campaign instead of four.'],
		short: ['Search, social,', 'content, as one.'],
		tag: 'SEO · ads · social · content',
		span: 'bd-w7',
		img: '/images/marketing/the-floor.jpg',
		pos: '50% 50%',
		alt: 'The marketing team at work on the Swizel floor',
	},
	{
		icon: 'mdi:wrench-outline',
		cur: 'shield',
		title: 'Maintenance',
		desc: ['Products already live, kept healthy', 'year after year, long after launch day.'],
		short: ['Kept healthy,', 'long after launch.'],
		tag: 'support · DevOps · uptime',
		span: 'bd-w5',
		img: '/images/builder/over-the-shoulder.jpg',
		pos: '46% 40%',
		alt: "One engineer reading another's screen",
	},
];// ── Swizel for business ───────────────────────────────────────────────
// Two rows. The top one is films: the middle one plays, its neighbours
// wait either side, and the row walks on by itself. The bottom one is the
// work itself, a band of client screens running edge to edge without
// stopping. Titles are the real YouTube titles, shortened to fit a card.
const businessFilms = [
	{
		id: 'IPFBUQ-pZRY',
		kicker: 'Where it starts',
		title: 'You have an idea. We build it.',
	},
	{
		id: 'R2jdjZwv-ZE',
		kicker: 'How we work',
		title: 'Behind the code',
	},
	{
		id: 'nFbBpQvT5fQ',
		kicker: 'The proof',
		title: 'Live websites built by Swizel',
	},
	{
		id: 'noEhs-8ywag',
		kicker: 'The bench',
		title: 'When students step into Swizel',
	},
	{
		id: 'EHi0Z2yqAr8',
		kicker: 'The studio',
		title: 'Where ideas become digital experiences',
	},
];
// The reel opens on the second film, not the first.
const FIRST = 1;

// The list is laid three times and the scroll is kept in the middle copy,
// jumping back by exactly one copy whenever it leaves. That is what makes
// the row endless: there is no first card and no last one, so a neighbour
// is always showing at both edges. Only the middle copy is real — the
// outer two are scenery and carry no player, no button and no label for a
// screen reader.
const reelRun = [0, 1, 2].flatMap((copy) =>
	businessFilms.map((f, real) => ({ ...f, real, copy, ghost: copy !== 1 }))
);

// The belt below is the portfolio itself — every project that has a
// picture, in the order the portfolio lists them, so the band stays true
// as the work grows rather than being a hand-kept copy of it.
const beltWork = projects
	.filter((pr) => pr.img)
	.map((pr) => ({
		name: pr.name,
		img: pr.img,
		sector: sectorLabels[pr.sector],
		href: pr.caseStudy ? `/work/${pr.slug}` : '/portfolio',
	}));

// The headline on the process card is lit a letter at a time once the
// lamp above it is switched on, so it is split here rather than in the
// browser: the markup ships ready, and the whole line still reads as one
// sentence to a screen reader through the aria-label on the heading.
const lifeLine = 'Bring your project to life.';
const lifeLetters = [...lifeLine];

// Short names for the narrow row: at a third of a phone "Design & build"
// breaks across two lines and the three beats stop reading as three.
const processShort = ['Discover', 'Design', 'Launch'];

const process = [
	{ n: '01', title: 'Discover', desc: 'Research, define and lock the goal, together.' },
	{ n: '02', title: 'Design & build', desc: 'Design, engineer and test in tight, visible loops.' },
	{ n: '03', title: 'Launch & scale', desc: 'Market, manage and grow what we shipped.' },
];

// Read off projects.ts so a card is never a dead <div>: a piece with a live
// site goes there (behind the leaving notice), and the rest open their own
// write-up. Nothing in this grid is unclickable.
const workSlugs: [string, string, string][] = [
	['brixmarket', 'Real estate marketplace', 'bd-work--feature'],
	['betslipswitch', 'Sports', 'bd-work--side'],
	['saros', 'Education', 'bd-work--side'],
	['purple-panda', 'Marketing', 'bd-work--third'],
	['beauty-hive', 'Beauty', 'bd-work--third'],
	['my-eya-estate', 'Real estate', 'bd-work--third'],
];

const work = workSlugs
	.map(([slug, sector, cls]) => {
		const p = projects.find((pr) => pr.slug === slug);
		if (!p) return null;
		const out = !p.caseStudy && !!p.url;
		return {
			name: p.name,
			sector,
			img: p.img,
			cls,
			url: p.caseStudy ? `/work/${p.slug}` : p.url || '',
			out,
			host: p.host,
		};
	})
	.filter((w): w is NonNullable<typeof w> => !!w);

const sectors = [
	'Fintech',
	'Real estate',
	'Sports',
	'E-commerce',
	'Education',
	'Logistics',
	'Healthcare',
	'Beauty',
	'Energy',
	'Agritech',
	'Hospitality',
	'Media',
	'Retail',
	'Travel',
	'Gaming',
	'Legal',
];

const quotes = [
	{
		text: '“Warm, responsive and a true extension of our team. They took the worry out of shipping software.”',
		name: 'Chidimma',
		role: 'Client, education sector',
		img: '/testimonial/chidima.jpeg',
	},
	{
		text: '“Geniuses, honestly. Working with them was effortless from the first call to launch day.”',
		name: 'Favour',
		role: 'Client, marketing',
		img: '/testimonial/favour.jpeg',
	},
	{
		text: '“Thorough, polite and always on time. They make hard things feel easy.”',
		name: 'Cheta',
		role: 'Client, e-commerce',
		img: '/testimonial/cheta.jpeg',
	},
	{
		text: '“Friendly and efficient. I have trusted them with my products for years.”',
		name: 'Russell',
		role: 'Client, real estate',
		img: '/testimonial/russell.jpeg',
	},
];

const logos = [
	'betslipswitch.svg',
	'trueverdict.png',
	'brix market logo.svg',
	'hemamsynergy.png',
	'purple-panda.svg',
	'saros-sgp.svg',
	'my eya homes.svg',
	'the-presidential-diary.png',
	'beauty-hive.png',
	'shuaproperties.svg',
	'ejike-fc.svg',
];
---

<div class="bdbody view-body view-body-boardroom">
	<!-- ═══ Swizel for business ═══════════════════════════════════════
	     A title, then two rows that move.

	     The reel is a real scroller with centre snapping, so a phone gets
	     native momentum and a mouse gets the same geometry: one film in
	     the middle, its neighbours held back at either edge. It walks on
	     by itself; rest a pointer on any card and it stops there and
	     plays that one instead.

	     The belt underneath runs edge to edge and never stops — the work
	     itself, labelled, sliding past the whole width of the screen.
	     ══════════════════════════════════════════════════════════════ -->
	<section class="bd-biz" id="bd-business" data-cursor="video">
		<header class="bd-biz-top bd-reveal">
			<span class="bd-kicker">Swizel for business</span>
			<h2 class="bd-biz-title">See how the work gets done.</h2>
		</header>

		<!-- ── the reel ── -->
		<div class="bz-reel bd-reveal" data-bz-reel>
			<ul class="bz-track" data-bz-track>
				{
					reelRun.map((f, dom) => (
						<li
							class:list={[
								'bz-slide',
								{ 'is-live': f.real === FIRST, 'bz-ghost': f.ghost },
							]}
							data-bz-dom={dom}
							data-bz-real={f.real}
							aria-hidden={f.ghost ? 'true' : undefined}
						>
							<div class="bz-frame">
								<img
									class="bz-poster"
									src={`https://i.ytimg.com/vi/${f.id}/maxresdefault.jpg`}
									data-bz-fallback={`https://i.ytimg.com/vi/${f.id}/hqdefault.jpg`}
									alt=""
									loading="lazy"
									decoding="async"
								/>
								{!f.ghost && <span class="bz-yt" data-bz-yt={f.id} />}
								<span class="bz-veil" aria-hidden="true" />
								{!f.ghost && (
									<button
										class="bz-hit"
										type="button"
										data-bz-pick={f.real}
										aria-label={`Watch now: ${f.title}`}
									/>
								)}
								<span class="bz-meta">
									<span class="bz-pill">Watch now</span>
									<span class="bz-line">
										<strong>{f.kicker}</strong>
										<span class="bz-sep" aria-hidden="true">•</span>
										{f.title}
									</span>
								</span>
								{!f.ghost && (
									<button
										class="bz-sound"
										type="button"
										data-bz-sound={f.real}
										aria-pressed="true"
										aria-label={`Unmute: ${f.title}`}
									>
										<Icon name="mdi:volume-off" class="bz-s-a" />
										<Icon name="mdi:volume-high" class="bz-s-b" />
									</button>
								)}
							</div>
						</li>
					))
				}
			</ul>
		</div>

		<!-- ── the belt ── -->
		<div class="bz-belt" data-cursor="repo" data-bz-belt aria-label="Work we have shipped">
			<div class="bz-belt-track" data-bz-belt-track>
				{
					[0, 1].map((pass) => (
						<Fragment>
							{beltWork.map((w) => (
								<a
									class="bz-tile"
									href={w.href}
									aria-hidden={pass === 1 ? 'true' : undefined}
									tabindex={pass === 1 ? -1 : undefined}
								>
									<img
										class="bz-tile-img"
										src={w.img}
										alt={pass === 1 ? '' : `${w.name} — ${w.sector}`}
										loading="lazy"
										decoding="async"
									/>
									<span class="bz-tile-veil" aria-hidden="true" />
									<span class="bz-tile-cap">
										<strong>{w.name}</strong>
										<em>{w.sector}</em>
									</span>
								</a>
							))}
						</Fragment>
					))
				}
			</div>
		</div>

		<div class="bz-dots" role="tablist" aria-label="Choose a film">
			{
				businessFilms.map((f, i) => (
					<button
						class:list={['bz-dot', { 'is-on': i === FIRST }]}
						type="button"
						role="tab"
						data-bz-dot={i}
						aria-selected={i === FIRST}
						aria-label={f.title}
					/>
				))
			}
		</div>
	</section>

	<!-- What we do — the four disciplines -->
	<section class="bd-head bd-reveal" id="bd-services">
		<h3 class="bd-h bd-h--center">Everything under one roof.</h3>
		<p class="bd-p bd-p--center">
			Employ a world-class team of engineers, designers, analysts, and
			marketers without hiring one.
		</p>
	</section>
	<div class="bd-mosaic bd-mosaic--svc">
		{
			disciplines.map((d) => (
				<section
					class:list={['bd-tile', 'bd-tile--svc', d.span, 'bd-reveal', { 'bd-tile--loud': d.loud }]}
					data-cursor={d.cur}
				>
					{
						d.video ? (
							<video
								class="bd-svc-media"
								src={d.video}
								poster={d.poster}
								autoplay
								muted
								loop
								playsinline
								preload="metadata"
								aria-hidden="true"
								tabindex="-1"
							/>
						) : (
							<img
								class="bd-svc-media"
								src={d.img}
								data-fallback={d.fallback}
								alt={d.alt}
								style={`object-position:${d.pos}`}
								loading="lazy"
								decoding="async"
							/>
						)
					}
					<span class="bd-svc-scrim" aria-hidden="true" />
					<span class="bd-svc-body">
						<span class="bd-svc-ic">
							<Icon width={28} name={d.icon} />
						</span>
						<h4 class="bd-h bd-h--sm">{d.title}</h4>
						<p class="bd-p bd-svc-p">
							{d.desc[0]}
							<br />
							{d.desc[1]}
						</p>
						<p class="bd-p bd-svc-p bd-svc-p--sm">
							{d.short[0]}
							<br />
							{d.short[1]}
						</p>
						<span class="bd-chips">
							{d.tag.split('·').map((t) => (
								<span class="bd-chip">{t.trim()}</span>
							))}
						</span>
					</span>
				</section>
			))
		}
	</div>

	<!-- How we work — three steps, carried by a quiet crimson heat.
	     The lamp in the corner is switched on when the card arrives; the
	     headline then lights a letter at a time, breathes, and the rest of
	     the card wakes behind it. -->
	<div class="bd-grid bd-grid--narrow">
		<section
			class="bd-tile bd-tile--full bd-tile--heat bd-life bd-reveal"
			data-cursor="branch"
			data-bd-life
		>
			<span class="bd-life-dusk" aria-hidden="true" />
			<div class="bd-lamp" aria-hidden="true">
				<svg class="bd-lamp-svg" viewBox="0 0 150 210" fill="none">
					<defs>
						<radialGradient id="bdLampFlare" cx="50%" cy="50%" r="50%">
							<stop offset="0%" stop-color="#ffffff" stop-opacity="1" />
							<stop offset="22%" stop-color="#9adcff" stop-opacity="0.9" />
							<stop offset="55%" stop-color="#28a6ec" stop-opacity="0.38" />
							<stop offset="100%" stop-color="#28a6ec" stop-opacity="0" />
						</radialGradient>
					</defs>

					<!-- the flare the bulb throws once it catches -->
					<circle class="lamp-flare" cx="66" cy="126" r="82" fill="url(#bdLampFlare)" />

					<!-- flex and ceiling rose -->
					<path class="lamp-wire" d="M66 0 V 88" stroke-width="2.4" />
					<rect class="lamp-cap" x="56" y="86" width="20" height="18" rx="5" />

					<!-- the bulb -->
					<circle class="lamp-bulb" cx="66" cy="126" r="21" />
					<path class="lamp-filament" d="M58 127 q4 -9 8 0 q4 9 8 0" stroke-width="2.2" fill="none" />
					<g class="lamp-rays" stroke-width="2.4" stroke-linecap="round">
						<path d="M66 92 V 82" /><path d="M66 160 V 170" />
						<path d="M32 126 H 22" /><path d="M100 126 H 110" />
						<path d="M42 102 L 35 95" /><path d="M90 150 L 97 157" />
						<path d="M90 102 L 97 95" /><path d="M42 150 L 35 157" />
					</g>

					<!-- the pull cord, and the ring you take hold of -->
					<path class="lamp-cord" d="M96 104 V 150" stroke-width="2.2" stroke-dasharray="3 4" />
					<circle class="lamp-ring" cx="96" cy="157" r="7.5" stroke-width="2.4" fill="none" />

					<!-- and the hand that takes it -->
					<g class="lamp-hand">
						<rect class="lamp-cuff" x="26" y="20" width="13" height="19" rx="5" />
						<rect class="lamp-fist" x="0" y="14" width="32" height="27" rx="13" />
						<rect class="lamp-thumb" x="19" y="6" width="13" height="17" rx="6.5" />
					</g>
				</svg>
			</div>

			<div class="bd-tile-copy">
				<h3 class="bd-h bd-life-h" aria-label={lifeLine}>
					{
						lifeLetters.map((ch, i) =>
							ch === ' ' ? (
								<span class="bd-life-sp" aria-hidden="true" />
							) : (
								<span class="bd-life-l" aria-hidden="true" style={`--i:${i}`}>
									{ch}
								</span>
							)
						)
					}
				</h3>
				<p class="bd-p bd-wake" style="--w:0">
					Cost-effective, innovative and quick to MVP, here's how we
					take you from idea to the next level.
				</p>
			</div>
			<ol class="bd-steps">
				{
					process.map((p, i) => (
						<li class="bd-step bd-wake" style={`--w:${i + 1}`}>
							<span class="bd-step-weather" aria-hidden="true" />
							<span class="bd-step-n">{p.n}</span>
							<h4 class="bd-step-t">{p.title}</h4>
							<h4 class="bd-step-t bd-step-t--sm">{processShort[i]}</h4>
							<p class="bd-step-d">{p.desc}</p>
						</li>
					))
				}
			</ol>
		</section>
	</div>

	<!-- Numbers — a full-width band, with each figure drawing its own line -->
	<section
		class="bd-tile bd-tile--full bd-tile--inverse bd-band bd-reveal"
		id="bd-numbers"
		data-cursor="chart"
	>
		<div class="bd-tile-copy">
			<h3 class="bd-h">
				The numbers behind the <em>calm.</em>
			</h3>
			<p class="bd-p">
				Seven years of shipping for ambitious businesses, measured the
				only way that matters.
			</p>
		</div>
		<ul class="bd-numbers">
			{
				numbers.map((n, i) => (
					<li class="bd-number" style={`--n:${i}`}>
						<span class="bd-number-ic" aria-hidden="true">
							<Icon width={20} name={n.icon} />
						</span>
						<strong
							data-count={n.to}
							data-suffix={n.suffix}
							data-decimals={n.decimals || 0}
						>
							0{n.suffix}
						</strong>
						<span class="bd-number-l">{n.label}</span>
						<span class="bd-number-s">{n.short}</span>
						<svg class="bd-trend" viewBox="0 0 100 7" preserveAspectRatio="none" aria-hidden="true">
							<path class="bd-trend-line" d={n.spark} />
						</svg>
					</li>
				))
			}
		</ul>
	</section>

	<div class="bd-grid">
		<!-- Rotating client words -->
		<section class="bd-tile bd-tile--full bd-tile--quote bd-reveal" data-cursor="quote" id="bd-quotes">
			{
				quotes.map((q, i) => (
					<blockquote class:list={['bd-quote', { 'is-live': i === 0 }]} data-q={i}>
						<p>{q.text}</p>
						<footer>
							<img src={q.img} alt="" loading="lazy" />
							<span>
								<strong>{q.name}</strong>
								<em>{q.role}</em>
							</span>
						</footer>
					</blockquote>
				))
			}
			{/* the dots were decoration; they are the control now, so the
			    visitor can pick a client rather than wait for one */}
			<div class="bd-quote-dots" role="tablist" aria-label="Choose a client">
				{
					quotes.map((q, i) => (
						<button
							class:list={['bd-qdot', { 'is-on': i === 0 }]}
							type="button"
							role="tab"
							data-qdot={i}
							aria-selected={i === 0}
							aria-label={`What ${q.name} said`}
						/>
					))
				}
			</div>
		</section>
	</div>

	<!-- The proof — latest work -->
	<section class="bd-work" id="bd-work" data-cursor="repo">
		<div class="bd-head bd-reveal">
			<h3 class="bd-h bd-h--center">The proof, shipped.</h3>
			<p class="bd-p bd-p--center">
				Real products, live in the market, carrying real businesses.
			</p>
		</div>
		<div class="bd-work-grid bd-reveal">
			{
				work.map((w) => {
					const Tag = w.url ? 'a' : 'div';
					return (
						<Tag
							class:list={['bd-work-card', w.cls]}
