	}
	#pf-all:checked ~ .pf-chips label[for='pf-all'] span,
	#pf-agri:checked ~ .pf-chips label[for='pf-agri'] span,
	#pf-health:checked ~ .pf-chips label[for='pf-health'] span,
	#pf-property:checked ~ .pf-chips label[for='pf-property'] span,
	#pf-media:checked ~ .pf-chips label[for='pf-media'] span,
	#pf-commerce:checked ~ .pf-chips label[for='pf-commerce'] span,
	#pf-product:checked ~ .pf-chips label[for='pf-product'] span { color: #06121a; background: rgba(0, 0, 0, 0.14); }

	#pf-agri:checked ~ .pf-grid .pf-card:not(.s-agri),
	#pf-health:checked ~ .pf-grid .pf-card:not(.s-health),
	#pf-property:checked ~ .pf-grid .pf-card:not(.s-property),
	#pf-media:checked ~ .pf-grid .pf-card:not(.s-media),
	#pf-commerce:checked ~ .pf-grid .pf-card:not(.s-commerce),
