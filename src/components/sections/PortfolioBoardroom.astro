	/* ── Project grid ── */
	.pf-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1rem, 2.2vw, 1.6rem); }
	@media (max-width: 900px) { .pf-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
	@media (max-width: 580px) { .pf-grid { grid-template-columns: 1fr; } }
	.pf-card { border-radius: 1.3rem; background: var(--bd-glass); border: 1px solid var(--bd-glass-border); box-shadow: var(--bd-shadow); backdrop-filter: blur(18px) saturate(130%); -webkit-backdrop-filter: blur(18px) saturate(130%); overflow: hidden; transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.4s ease, box-shadow 0.4s ease; }
	.pf-card:hover { transform: translateY(-7px); border-color: color-mix(in srgb, var(--c) 50%, var(--bd-glass-border)); box-shadow: 0 44px 90px -34px color-mix(in srgb, var(--c) 40%, rgba(0,0,0,0.85)); }
	.pf-card-link { display: block; }
	.pf-card .pf-shot { border: none; border-radius: 0; box-shadow: none; }
	.pf-card:hover .pf-img img { transform: scale(1.05); }
	.pf-card:hover .pf-open { opacity: 1; transform: translate(0, 0); }
	.pf-card-body { padding: 1.1rem 1.25rem 1.35rem; }
	.pf-card-head { display: flex; align-items: baseline; justify-content: space-between; gap: 0.6rem; }
	.pf-card-name { font-size: 1.05rem; font-weight: 700; letter-spacing: -0.01em; margin: 0; }
	.pf-card-year { font-size: 0.74rem; font-weight: 700; color: color-mix(in srgb, var(--c) 70%, transparent); flex-shrink: 0; }
	.pf-card-tagline { font-size: 0.86rem; line-height: 1.5; color: var(--bd-muted); margin: 0.3rem 0 0.85rem; }
	.pf-card .pf-tags { margin-bottom: 0; }

	/* ── "Yours could be next" card (fills the last grid cell) ── */
	.pf-next { --c: #28a6ec; position: relative; overflow: hidden; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; gap: 0.5rem; padding: clamp(1.6rem, 3vw, 2.3rem); text-align: left; color: #fff; background: radial-gradient(600px 320px at 120% -20%, rgba(255, 255, 255, 0.2), transparent 60%), linear-gradient(150deg, #18b6d8 0%, #2a7de0 52%, #6a4ff0 100%); border: 1px solid rgba(255, 255, 255, 0.28); box-shadow: 0 34px 80px -34px rgba(40, 120, 224, 0.7); }
	.pf-next > :not(.pf-next-glow) { position: relative; z-index: 1; }
	.pf-next:hover { transform: translateY(-7px); border-color: rgba(255, 255, 255, 0.45); box-shadow: 0 48px 100px -34px rgba(40, 120, 224, 0.8); }
	.pf-next-glow { position: absolute; inset: -35%; background: radial-gradient(closest-side, rgba(255, 255, 255, 0.28), transparent 70%); opacity: 0.6; pointer-events: none; animation: pf-next-pulse 7s ease-in-out infinite; }
	@keyframes pf-next-pulse { 0%,100%{ transform: translate(0,0) scale(1); opacity: 0.45; } 50%{ transform: translate(10%, 8%) scale(1.18); opacity: 0.8; } }
	.pf-next-ic { display: grid; place-items: center; width: 56px; height: 56px; border-radius: 1rem; color: #fff; background: rgba(255, 255, 255, 0.18); border: 1px solid rgba(255, 255, 255, 0.32); margin-bottom: 0.5rem; }
	.pf-next-kicker { font-size: 0.72rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255, 255, 255, 0.85); }
	.pf-next-h { font-size: clamp(1.5rem, 2.6vw, 2rem); font-weight: 800; letter-spacing: -0.02em; line-height: 1.08; }
	.pf-next-p { font-size: 0.95rem; line-height: 1.55; color: rgba(255, 255, 255, 0.92); max-width: 24rem; }
	.pf-next-p b { font-weight: 800; }
	.pf-next-cta { margin-top: 0.7rem; display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.65rem 1.25rem; border-radius: 9999px; font-size: 0.93rem; font-weight: 700; color: #103a5c; background: #fff; box-shadow: 0 12px 26px -10px rgba(0, 0, 0, 0.45); transition: gap 0.25s ease; }
	.pf-next:hover .pf-next-cta { gap: 0.7rem; }

	/* ── CTA ── */
	.bd-tile--cta { background: radial-gradient(820px 380px at 50% 130%, color-mix(in srgb, var(--bd-accent) 38%, transparent), transparent 72%), linear-gradient(180deg, rgba(18, 22, 42, 0.92), rgba(5, 6, 13, 0.96)); color: #f5f5f7; border-color: color-mix(in srgb, var(--bd-accent) 26%, rgba(255, 255, 255, 0.1)); padding-block: clamp(3rem, 6vw, 5rem); margin-top: clamp(2.5rem, 6vw, 4rem); }
	.bd-display--cta { font-size: clamp(2rem, 5vw, 3.6rem); max-width: 18ch; margin-inline: auto; }
	.bd-tile--cta .bd-sub { color: rgba(245, 245, 247, 0.62); }
	/* one sentence, one line — the 42rem cap was breaking it in two */
	.bd-sub--one { max-width: none; }
	@media (max-width: 720px) { .bd-sub--one { max-width: 30rem; } }

	/* ── Reveal ── */
	.bd-reveal { opacity: 0; transform: translateY(26px); transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.22, 1, 0.36, 1); }
	.bd-reveal.is-on { opacity: 1; transform: translateY(0); }
	@media (prefers-reduced-motion: reduce) {
		.bd-reveal { opacity: 1; transform: none; transition: none; }
		.pf-hero-aurora, .bd-grad, .pf-reel-sheen, .pf-reel-play::after,
		.pf-marquee-track, .bdbody::before, .bdbody::after, .pf-feats::before, .pf-next-glow { animation: none; }
		.pf-deck-card { animation: none; transform: translate(calc(var(--i) * 16px), calc(var(--i) * 16px)) rotate(calc(var(--i) * 3deg)) scale(calc(1 - var(--i) * 0.03)); z-index: calc(50 - var(--i) * 10); }
		.pf-marquee { -webkit-mask-image: none; mask-image: none; overflow-x: auto; }
		.pf-card:hover, .pf-shot--lg:hover, .pf-mag:hover, .pf-thumb:hover, .pf-next:hover { transform: none; }
	}

	/* ═══ shared with the rest of the site ═════════════════════════════
	   The opening two-up, the numbers band and the closing tile are the
	   same objects everywhere. Lifted rather than re-written, and kept at
	   the end of the sheet where source order settles them against the
	   older .pf- rules above.
	   ══════════════════════════════════════════════════════════════════ */
	/* ── the numbers band ──────────────────────────────────────────────
	   It spans the page rather than sitting inside the 88rem grid: five
	   figures deserve the width, and the band is what separates the story
	   above it from the proof below. The body's own side padding is given
	   back with a negative margin, which is exact and, unlike 100vw,
	   cannot open a scrollbar of its own. */
	.bd-band {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		max-width: none;
		width: auto;
		margin-inline: calc(-1 * clamp(1rem, 3vw, 2rem));
		margin-block: clamp(1.2rem, 2.6vw, 2rem) clamp(0.9rem, 2vw, 1.4rem);
		border-radius: clamp(1rem, 2vw, 1.6rem);
		padding-inline: clamp(1.2rem, 4vw, 3.4rem);
		padding-block: clamp(1.6rem, 3vw, 2.5rem);
		/* deeper than the rest of the body on purpose: this band is the
		   quiet beat between the story above it and the proof below */
		background:
			radial-gradient(900px 320px at 50% -24%, color-mix(in srgb, var(--bd-accent) 13%, transparent), transparent 70%),
			linear-gradient(180deg, #05070f 0%, #02030a 100%);
		border-color: rgba(155, 216, 255, 0.1);
	}
	/* the heading is a label here, not a headline: the figures are the
	   thing being looked at */
	.bd-band .bd-h {
		font-size: clamp(1.35rem, 2.5vw, 2rem);
		letter-spacing: -0.03em;
		margin: 0;
	}
	.bd-band .bd-p {
		margin: 0.45rem auto 0;
		max-width: 40rem;
		font-size: clamp(0.82rem, 1vw, 0.92rem);
		line-height: 1.55;
	}
	/* the accent falls on one word, which is the only ornament the
	   heading needs */
	.bd-band .bd-h em {
		font-style: normal;
		background: linear-gradient(120deg, #cfeaff 5%, var(--bd-accent) 75%);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}
	.bd-numbers {
		display: grid;
		/* however many figures there are, not always five: with four the
		   fixed five-column grid left an empty column and the row sat
		   off-centre in its own band */
		grid-auto-flow: column;
		grid-auto-columns: minmax(0, 1fr);
		gap: clamp(0.5rem, 1.1vw, 0.85rem);
		list-style: none;
		margin: clamp(1.1rem, 2.4vw, 1.6rem) 0 0;
		padding: 0;
	}
	/* Five cards, each one hairline, icon, figure, label and the shape it
	   made. Nothing is filled, nothing glows: the only movement is the
	   figure counting and the line drawing itself. */
	.bd-number {
		min-width: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		padding: clamp(0.85rem, 1.7vw, 1.15rem) clamp(0.55rem, 1.2vw, 0.9rem)
			clamp(0.6rem, 1.3vw, 0.85rem);
		border-radius: clamp(0.65rem, 1.1vw, 0.85rem);
		border: 1px solid rgba(155, 216, 255, 0.095);
		background: rgba(255, 255, 255, 0.014);
		transition: border-color 0.35s ease, background 0.35s ease,
			transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.bd-number:hover {
		border-color: color-mix(in srgb, var(--bd-accent) 38%, transparent);
		background: rgba(255, 255, 255, 0.035);
		transform: translateY(-2px);
	}
	.bd-number-ic {
		display: grid;
		place-items: center;
		width: 1.85rem;
		height: 1.85rem;
		border-radius: 0.55rem;
		border: 1px solid rgba(155, 216, 255, 0.16);
		background: color-mix(in srgb, var(--bd-accent) 9%, transparent);
		color: #7fc7f0;
		margin-bottom: 0.5rem;
	}
	.bd-number-ic :global(svg) { width: 15px; height: 15px; }

	/* ── the line under each figure ──
	   Drawn rather than faded in: the stroke is dashed to its own length
	   and the dash walked to zero, which is a pen moving across the box
	   rather than a picture appearing. */
	/* named "trend", not "spark": global.css stops anything whose class
	   carries spark/glow/aura from animating on weak hardware — right for
	   a particle emitter, wrong for a line that draws itself once. */
	.bd-trend {
		display: block;
		width: 100%;
		height: clamp(13px, 1.5vw, 17px);
		margin-top: clamp(0.5rem, 1.1vw, 0.75rem);
		overflow: hidden;
	}
	.bd-trend-line {
		fill: none;
		stroke: var(--bd-accent);
		stroke-width: 0.75;
		stroke-linecap: round;
		stroke-linejoin: round;
		opacity: 0.62;
		/* the path measures a shade over 100 user units, and the dash is
		   measured in the same units now, so one dash covers one line */
		stroke-dasharray: 104;
		stroke-dashoffset: 104;

	}

	.bd-band.is-on .bd-trend-line {
		animation: bd-draw 1.5s cubic-bezier(0.3, 0.8, 0.3, 1) forwards;
		animation-delay: calc(0.25s + var(--n) * 0.16s);
	}
	@keyframes bd-draw { to { stroke-dashoffset: 0; } }

	.bd-number-l {
		display: block;
		margin-top: 0.22rem;
		font-size: clamp(0.7rem, 0.82vw, 0.78rem);
		line-height: 1.3;
		color: rgba(245, 245, 247, 0.5);
	}

	@media (prefers-reduced-motion: reduce) {
		.bd-band .bd-trend-line { stroke-dashoffset: 0; }
		.bd-band.is-on .bd-trend-line { animation: none; }
		.bd-number,
		.bd-number:hover { transform: none; transition: none; }
	}
	/* The band stays one row of five on every screen — it is a line of
	   figures, and a line of figures wrapped over two rows is a table.
	   What gives instead is the weight: the icon goes, the label shortens
	   to a single word, and the card loses its frame until only the
	   numbers and their lines are left. */
	.bd-number-s { display: none; }
	@media (max-width: 880px) {
		.bd-numbers { gap: clamp(0.25rem, 1.2vw, 0.6rem); }
		.bd-number { padding: 0.75rem 0.3rem 0.5rem; }
		.bd-number-ic { width: 1.5rem; height: 1.5rem; border-radius: 0.45rem; margin-bottom: 0.35rem; }
		.bd-number-ic :global(svg) { width: 12px; height: 12px; }
		.bd-number strong { font-size: clamp(1.05rem, 3.2vw, 1.6rem); }
		.bd-number-l { font-size: 0.62rem; }
	}
	@media (max-width: 620px) {
		.bd-number {
			padding: 0.55rem 0.15rem 0.4rem;
			border-color: transparent;
			background: none;
		}
		.bd-number-ic { display: none; }
		.bd-number strong { font-size: clamp(0.95rem, 4.4vw, 1.35rem); }
		.bd-number-l { display: none; }
		.bd-number-s {
			display: block;
			margin-top: 0.15rem;
			font-size: clamp(0.54rem, 2.1vw, 0.66rem);
			line-height: 1.2;
			letter-spacing: 0.01em;
			color: rgba(245, 245, 247, 0.5);
		}
		.bd-trend { height: 10px; margin-top: 0.4rem; }
		.bd-band { padding-inline: clamp(0.7rem, 3vw, 1.2rem); }
		.bd-band .bd-h { font-size: clamp(1.15rem, 5vw, 1.5rem); }
		.bd-band .bd-p { font-size: 0.76rem; }
	}

	@media (max-width: 880px) {
		.bd-band { padding-inline: clamp(1.2rem, 5vw, 2rem); }
	}
	.bd-number strong {
		display: block;
		font-size: clamp(1.7rem, 3.1vw, 2.4rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		background: linear-gradient(135deg, #9bd8ff, var(--bd-accent));
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}



	/* ── the closing tile ── */
	.bd-tile--cta {
		position: relative;
		overflow: hidden;
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
		align-items: stretch;
		gap: 0;
		padding: 0;
		text-align: left;
		background:
			radial-gradient(760px 420px at 6% 110%, color-mix(in srgb, var(--bd-accent) 26%, transparent), transparent 70%),
			linear-gradient(180deg, rgba(14, 19, 36, 0.96), rgba(4, 6, 13, 0.98));
		color: #f5f5f7;
		border-color: color-mix(in srgb, var(--bd-accent) 26%, rgba(255, 255, 255, 0.1));
	}
	.bd-cta-copy {
		padding: clamp(2.2rem, 5vw, 4.2rem) clamp(1.4rem, 3.4vw, 3.4rem);
		align-self: center;
		/* a grid item's automatic minimum is its content, and a phone
		   number set nowrap is wide content: without this the column grows
		   past the tile and the tile quietly clips it */
		min-width: 0;
	}
	.bd-cta-kick {
		display: inline-flex;
		align-items: center;
		gap: 0.85rem;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.26em;
		text-transform: uppercase;
		color: rgba(245, 245, 247, 0.6);
	}
	.bd-cta-kick i {
		width: clamp(1.6rem, 3vw, 2.6rem);
		height: 2px;
		border-radius: 999px;
		background: var(--bd-accent);
	}
	.bd-display--cta {
		margin: clamp(0.9rem, 2vw, 1.3rem) 0 0;
		font-size: clamp(2.1rem, 4.4vw, 3.6rem);
		line-height: 1.02;
		letter-spacing: -0.04em;
	}
	.bd-display--cta em {
		display: block;
		font-style: normal;
		font-weight: 800;
		background: linear-gradient(100deg, #e9f6ff 10%, var(--bd-accent) 85%);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}
	.bd-tile--cta .bd-sub {
		margin: clamp(0.9rem, 2vw, 1.25rem) 0 0;
		max-width: 27rem;
		margin-inline: 0;
	}
	.bd-cta-act {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: clamp(1rem, 2.4vw, 2rem);
		margin-top: clamp(1.5rem, 3.2vw, 2.4rem);
	}
	/* the one thing on this tile we want pressed: it breathes until it is */
	.bd-cta-go {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		min-height: 3.35rem;
		padding: 0 1.8rem;
		border-radius: 999px;
		background: linear-gradient(120deg, var(--bd-accent), #3b7dfd);
		color: #04101a;
		font-size: 1rem;
		font-weight: 700;
		white-space: nowrap;
		transition: transform 0.25s ease, filter 0.25s ease;
	}
	.bd-cta-go::after {
		content: '';
		position: absolute;
