---
// About page · Campus world — Open Day at the school that ships. Same
// foundational content as every other About (story, mission / vision /
// core values, what we do, real timeline incl 2024, clickable team, media,
// Brevarium, client words) told as a school: whiteboard, syllabus, charter
// posters, school history, the faculty, class photos, the free textbook
// and a report card. Root carries `cbody` so the campus engine (.cp-rev
// reveals + [data-count] counters) binds, and `cabout` so the motion
// engine (tilt / glare / team modal / magnetic / journey draw) binds too.
import { Icon } from 'astro-icon/components';
import WhiteboardVideo from '../WhiteboardVideo.astro';
import { teamDetails, MISSION, VISION, CORE_VALUES } from '../../consts';

const stats = [
	{ to: 65, suffix: '+', label: 'products shipped' },
	{ to: 25, suffix: '+', label: 'mentors & makers' },
	{ to: 7, suffix: '+', label: 'years of teaching' },
	{ to: 10, suffix: '+', label: 'countries reached' },
];

// six disciplines as the course catalogue — same content as every view
const courses = [
	{ code: 'SWZ 101', icon: 'mdi:palette-outline', title: 'Design', desc: 'Brand identity, graphics and product design. Interfaces your customers find effortless.' },
	{ code: 'SWZ 102', icon: 'mdi:code-tags', title: 'Development', desc: 'Web and mobile engineering built to scale. We build, test and ship fast, without breaking things.' },
	{ code: 'SWZ 103', icon: 'mdi:bullhorn-outline', title: 'Marketing', desc: 'We grow your audience across every platform that matters, and co-market the products we ship.' },
	{ code: 'SWZ 104', icon: 'mdi:compass-outline', title: 'Strategy', desc: 'Research, define and lock the goal, so there is a tailored roadmap before a line of code is written.' },
	{ code: 'SWZ 105', icon: 'mdi:wrench-outline', title: 'Maintenance', desc: 'Improving existing products and keeping complex systems healthy, secure and online, year after year.' },
	{ code: 'SWZ 106', icon: 'mdi:school-outline', title: 'Education', desc: 'Internships, NYSC placements and The Brevarium, putting real, job-ready skills in the hands of the next class.' },
];

// the real road — same milestones as every About world, as school years
const history = [
	{ year: '2019', term: 'Founding class', title: 'The school opens.', desc: 'Swizel starts in Nigeria as a small, stubborn team taking on its first builds for local businesses.' },
	{ year: '2020', term: 'Second session', title: 'Products, not projects.', desc: 'We stop thinking in deliverables and start thinking in products, software meant to live and grow.' },
	{ year: '2021', term: 'Third session', title: 'The practice grows up.', desc: 'Process arrives: design systems, code review and proper handover, so the work holds up after launch.' },
	{ year: '2022', term: 'New department', title: 'Mobile joins the timetable.', desc: 'Native iOS and Android join the practice. The same team now ships across web and phone.' },
	{ year: '2023', term: 'Field work', title: 'At home in every sector.', desc: 'Fintech, real estate, sports, education and logistics. The work spreads across the industries that move Africa.' },
	{ year: '2024', term: 'Exchange year', title: 'Crossing borders.', desc: 'The work goes global. ConvertMyBetCode serves users in 10+ countries, and the first Brevarium is published.' },
	{ year: '2025', term: 'Open enrolment', title: 'We open the doors.', desc: 'We start training the next intake in house, on real products, alongside the people who ship them.' },
	{ year: '2026', term: 'Present day', title: '65+ and counting.', desc: 'Seven years in, more than sixty-five products live in the market, and we are only warming up.' },
];

// same crew, same order, same modal data as the other About worlds
const teamOrder = [
	{ name: 'Azoro', role: 'Business Development Lead' },
	{ name: 'Ruke', role: 'Product Manager' },
	{ name: 'Dennis', role: 'UI/UX Designer' },
	{ name: 'Mary', role: 'Software Engineer' },
	{ name: 'Stephen', role: 'Fullstack Developer' },
	{ name: 'Nathaniel', role: 'Frontend Developer' },
	{ name: 'Precious', role: 'Mobile Developer' },
	{ name: 'Linda', role: 'Marketing Lead' },
];
const team = teamOrder.map((m) => {
	const d = (teamDetails as any[]).find((t) => t.name === m.name) || {};
	return {
		...m,
		bio: d.bio || '',
		experience: (d.experience || []) as { company: string; jobDesc: string }[],
		linkedin: d.linkedinURL && d.linkedinURL !== '#' ? d.linkedinURL : '',
	};
});

const brevariumEditions = [
	{ vol: 'Third edition', date: 'Latest · 2026', href: '/brevarium/the-brevarium-latest.pdf' },
	{ vol: 'Second edition', date: '2025', href: '/The Brevarium by Swizel.pdf' },
	{ vol: 'First edition', date: '2024', href: '/The Brevarium by Swizel.pdf' },
];

// the clients grade us — same voices as the other About worlds
const reportCard = [
	{ name: 'Chidimma', img: '/testimonial/chidima.jpeg', grade: 'A+', body: 'Warm, responsive and a true extension of our team. They took the worry out of shipping software.' },
	{ name: 'Favour', img: '/testimonial/favour.jpeg', grade: 'A+', body: 'Geniuses, honestly. Working with them was effortless from the first call to launch day.' },
	{ name: 'Cheta', img: '/testimonial/cheta.jpeg', grade: 'A+', body: 'Thorough, polite and always on time. They make hard things feel easy.' },
];

// real photographs from the Abuja studio — placeholders only where footage is
// still to come
const classPhotos = [
	{
		wide: true,
		img: '/images/campus/demo-day.jpg',
		alt: 'The Swizel team reviewing a build together on demo day',
		name: 'demo-day.jpg',
		sub: 'Review day, the whole class on one build',
	},
	{
		img: '/images/campus/class-in-session.jpg',
		alt: 'A full class in session around the studio table in Abuja',
		name: 'class-in-session.jpg',
		sub: 'A full house, mid term',
	},
	{
		img: '/images/campus/the-lab.jpg',
		alt: 'Two Swizel builders pairing on a live product in the lab',
		name: 'the-lab.jpg',
		sub: 'Pairing in the lab',
	},
	{ video: true, name: 'launch-night.mp4 · video' },
	{ video: false, name: 'field-trip.jpg' },
];
---

<div class="cabout cbody view-body view-body-campus">
	<!-- ── A · open day ────────────────────────────────────── -->
	<section class="ca-sec">
		<div class="ca-wrap ca-open">
			<div class="ca-copy cp-rev">
				<span class="ca-badge">🏫 Open day · Est. 2019</span>
				<h2 class="ca-h ca-h--xl">Skip the theory. <em>Learn from builders.</em></h2>
				<p class="ca-p">
					At Swizel, you're not taught by instructors; you're mentored by
					the core team behind 65+ live digital products. Come see what
					we're building.
				</p>
				<ul class="ca-stats">
					{
						stats.map((s) => (
							<li>
								<strong data-count={s.to} data-suffix={s.suffix}>0{s.suffix}</strong>
								<span>{s.label}</span>
							</li>
						))
					}
				</ul>
				<div class="ca-row">
					<a href="/programs" class="ca-cta fa-cta">
						Apply for a place
						<Icon width={17} name="mdi:school-outline" />
					</a>
					<a href="/contact" class="ca-link">
						Or hire the team
						<Icon width={15} name="mdi:arrow-right" />
					</a>
				</div>
			</div>

			<!-- the same board the home page uses, so every control lives on
			     the furniture: seek, speed, volume, full screen, replay -->
			<div class="ca-boardwrap cp-rev">
				<WhiteboardVideo
					videoId="p563SFG9Nwg"
					title="who is swizel, really?"
					kicker="Meet the team"
					stickyA="est. 2019 ✏️"
					stickyB="we ship!"
					ctaHref="/programs"
					ctaLabel="Apply for a place"
				/>
				<p class="ca-boardnote">
					<Icon width={14} name="mdi:cursor-default-click-outline" />
					Press play. Speed it up, scrub it, take it full screen. Every
					control lives on the board.
				</p>
			</div>
		</div>
	</section>

	<!-- ── B · the syllabus (what we do) ───────────────────── -->
	<section class="ca-sec" data-cursor="book">
		<div class="ca-wrap">
			<div class="ca-head cp-rev">
				<span class="ca-kick">📚 The syllabus</span>
				<h2 class="ca-h">Everything under <em>one roof.</em></h2>
				<p class="ca-p ca-p--center">
					Six departments, one campus. Every skill your product needs,
					and every skill we teach, practised in house.
				</p>
			</div>
			<div class="ca-reg cp-rev" data-ca-reg>
				<span class="ca-reg-rings" aria-hidden="true">
					{Array.from({ length: 9 }).map(() => <i />)}
				</span>
				<div class="ca-reg-sheet">
					<span class="ca-reg-margin" aria-hidden="true"></span>
					<div class="ca-reg-head">
						<span class="ca-reg-title">Class register</span>
						<span class="ca-reg-meta">Session 2026 · all present</span>
					</div>
					<ul class="ca-reg-rows">
						{
							courses.map((c, i) => (
								<li class="ca-reg-row" style={`--i:${i}`}>
									<span class="ca-reg-tick" aria-hidden="true">
										<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round">
											<path d="M4 12.5 9.5 18 20 6" />
										</svg>
									</span>
									<span class="ca-reg-code">{c.code}</span>
									<span class="ca-reg-ic"><Icon width={17} name={c.icon} /></span>
									<span class="ca-reg-body">
										<strong>{c.title}</strong>
										<em>{c.desc}</em>
									</span>
									<span class="ca-reg-mark" aria-hidden="true">✓</span>
								</li>
							))
						}
					</ul>
					<span class="ca-reg-sign" aria-hidden="true">signed, the faculty</span>
				</div>
			</div>
		</div>
	</section>

	<!-- ── C · the school charter (MVV) ────────────────────── -->
	<section class="ca-sec" data-cursor="layers">
		<div class="ca-wrap">
			<div class="ca-head cp-rev">
				<span class="ca-kick">📌 The school charter</span>
				<h2 class="ca-h">Pinned to <em>every wall.</em></h2>
			</div>
			<div class="ca-charter">
				<article class="ca-poster cp-rev" data-fa-tilt="6" style="--r:-1.2deg">
					<span class="ca-pin" aria-hidden="true"></span>
					<span class="ca-poster-k">Our mission</span>
					<p class="ca-poster-t">{MISSION}</p>
				</article>
				<article class="ca-poster cp-rev" data-fa-tilt="6" style="--i:1; --r:1.4deg">
					<span class="ca-pin" aria-hidden="true"></span>
					<span class="ca-poster-k">Our vision</span>
					<p class="ca-poster-t">{VISION}</p>
				</article>
			</div>
			<div class="ca-values cp-rev">
				<span class="ca-values-label">Core values · school rules</span>
				<ul class="ca-values-row">
					{
						CORE_VALUES.map((v) => (
							<li>
								<Icon width={16} name={v.icon} /> {v.name}
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</section>

	<!-- ── D · school history (the journey, incl 2024) ─────── -->
	<section class="ca-sec" data-cursor="repo">
		<div class="ca-wrap">
			<div class="ca-head cp-rev">
				<span class="ca-kick">🗓️ School history</span>
				<h2 class="ca-h">From first bell <em>to today.</em></h2>
			</div>
			<div class="ca-history fa-journey">
				<span class="ca-spine" aria-hidden="true"></span>
				{
					history.map((h, i) => (
						<article
							class:list={['ca-year', 'cp-rev', i % 2 ? 'ca-year--r' : 'ca-year--l']}
							style={`--i:${i}`}
						>
							<span class="ca-year-node" aria-hidden="true"></span>
							<span class="ca-year-n">{h.year}</span>
							<div class="ca-year-body">
								<span class="ca-year-k">{h.term}</span>
								<h3 class="ca-year-t">{h.title}</h3>
								<p class="ca-year-d">{h.desc}</p>
							</div>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<!-- ── E · meet the faculty (clickable team) ───────────── -->
	<section class="ca-sec" data-cursor="book">
		<div class="ca-wrap">
			<div class="ca-head cp-rev">
				<span class="ca-kick">🧑‍🏫 Meet the faculty</span>
				<h2 class="ca-h">Your mentors <em>ship for a living.</em></h2>
				<p class="ca-p ca-p--center">Tap any staff card for the full profile.</p>
			</div>
			<div class="ca-staff">
				{
					team.map((m, i) => (
						<button
							type="button"
							class="ca-card cp-rev"
							style={`--i:${i % 4}`}
							data-fa-member
							data-name={m.name}
							data-role={m.role}
							data-bio={m.bio}
							data-linkedin={m.linkedin}
							data-exp={JSON.stringify(m.experience)}
						>
							<span class="ca-card-clip" aria-hidden="true"></span>
							<span class="ca-card-photo">
								<img src={`/teammates/${m.name}.jpg`} alt={m.name} loading="lazy" />
							</span>
							<span class="ca-card-body">
								<strong>{m.name}</strong>
								<em>{m.role}</em>
								<span class="ca-card-open">View staff profile <Icon width={13} name="mdi:arrow-right" /></span>
							</span>
						</button>
					))
				}
			</div>
		</div>
	</section>

	<!-- ── F · class photos (media) ────────────────────────── -->
	<section class="ca-sec" data-cursor="play">
		<div class="ca-wrap">
			<div class="ca-head cp-rev">
				<span class="ca-kick">📸 Class photos & field trips</span>
				<h2 class="ca-h">Life on <em>campus.</em></h2>
			</div>
			<div class="ca-media cp-rev">
				{
					classPhotos.map((f) => (
						<div class:list={['ca-frame', { 'ca-frame--wide': f.wide, 'ca-frame--photo': f.img }]}>
							{f.img ? (
								<>
									<img src={f.img} alt={f.alt} loading="lazy" />
									<span class="ca-tape" aria-hidden="true" />
									<span class="ca-frame-cap">
										{f.sub ?? f.name}
									</span>
								</>
							) : (
								<>
									<Icon width={f.wide ? 34 : 24} name={f.video ? 'mdi:play-circle-outline' : 'mdi:image-outline'} />
									<span class="ca-frame-name">{f.name}</span>
									{f.sub && <span class="ca-frame-sub">{f.sub}</span>}
								</>
							)}
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- ── G · the free textbook (Brevarium) ───────────────── -->
	<section class="ca-sec" data-cursor="book">
		<div class="ca-wrap">
			<div class="ca-book">
				<a
					class="ca-book-cover cp-rev"
					href="/brevarium/the-brevarium-latest.pdf"
					download="The Brevarium by Swizel"
					aria-label="Download The Brevarium"
					data-fa-tilt="5"
				>
					<span class="ca-glare" aria-hidden="true"></span>
					<img src="/images/brevarium-cover.jpg" alt="The Brevarium by Swizel, latest edition" loading="lazy" />
				</a>
				<div class="ca-book-copy cp-rev">
					<span class="ca-kick">📖 The set text, free</span>
					<h2 class="ca-h">The Brevarium is <em>your textbook.</em></h2>
					<p class="ca-p">
						Everything the studio learns on the floor: design, code,
						growth and the business of shipping, written down and given
						away. Education has never been easier, or smarter.
					</p>
					<ul class="ca-book-eds">
						{
							brevariumEditions.map((e) => (
								<li>
									<a href={e.href} download="The Brevarium by Swizel">
										<Icon width={16} name="mdi:book-open-page-variant-outline" />
										<strong>{e.vol}</strong>
										<span>{e.date}</span>
										<Icon width={15} name="mdi:download-outline" />
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</div>
	</section>

	<!-- ── H · the report card (client words) ──────────────── -->
	<section class="ca-sec" data-cursor="quote">
		<div class="ca-wrap">
			<div class="ca-head cp-rev">
				<span class="ca-kick">📝 The report card</span>
				<h2 class="ca-h">Clients grade <em>the school.</em></h2>
			</div>
			<div class="ca-grades">
				{
					reportCard.map((r, i) => (
						<figure class="ca-grade cp-rev" style={`--i:${i}`} data-fa-tilt="7">
							<span class="ca-glare" aria-hidden="true" />
							<span class="ca-grade-mark" aria-hidden="true">{r.grade}</span>
							<blockquote>“{r.body}”</blockquote>
							<figcaption>
								<img src={r.img} alt={r.name} loading="lazy" width="36" height="36" />
								<span>— {r.name}</span>
							</figcaption>
						</figure>
					))
				}
			</div>
		</div>
	</section>

	<!-- ── I · the final bell ──────────────────────────────── -->
	<section class="ca-sec ca-sec--cta" data-cursor="phone">
		<div class="ca-wrap ca-cta-box cp-rev">
			<span class="ca-badge">🔔 The final bell</span>
			<h2 class="ca-h ca-h--cta">Join the next <em>cohort.</em></h2>
			<p class="ca-p ca-p--center">
				Apply to train with the team that ships, or bring us your
				project and watch the faculty build it.
			</p>
			<div class="ca-cta-row">
				<a href="/programs" class="ca-cta fa-cta">
					Apply for a place
					<Icon width={17} name="mdi:school-outline" />
				</a>
				<a href="/contact" class="ca-call">
					<span class="ca-call-or">or</span>
					Start a project
					<Icon width={16} name="mdi:arrow-right" />
				</a>
			</div>
		</div>
	</section>

	<!-- ── the staff profile modal (shared engine contract) ── -->
	<div class="fa-member-modal ca-modal" hidden>
		<div class="ca-modal-overlay" data-fa-modal-close></div>
		<div class="ca-modal-card" role="dialog" aria-modal="true">
			<button type="button" class="ca-modal-x" data-fa-modal-close aria-label="Close">
				<Icon width={20} name="mdi:close" />
			</button>
			<div class="ca-modal-body">
				<div class="ca-modal-side">
					<div class="ca-modal-photo"><img id="fa-modal-photo" alt="" /></div>
					<h3 class="ca-modal-name" id="fa-modal-name"></h3>
					<p class="ca-modal-role" id="fa-modal-role"></p>
					<a class="ca-modal-linkedin" id="fa-modal-linkedin" href="#" target="_blank" rel="noopener noreferrer" hidden>
						<Icon width={18} name="linkedin" />
						Connect on LinkedIn
					</a>
				</div>
				<div class="ca-modal-main">
					<span class="ca-modal-k">Staff profile</span>
					<p class="ca-modal-bio" id="fa-modal-bio"></p>
					<div id="fa-modal-exp-wrap" hidden>
						<span class="ca-modal-k">Previous schools</span>
						<ul class="ca-modal-exp" id="fa-modal-exp"></ul>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<style>
	/* ── Campus About — the school dress (amber, warm, playful). ── */
	.cabout {
		--cp-ink: #fdf6ea;
		--cp-muted: rgba(253, 246, 234, 0.62);
		--cp-faint: rgba(253, 246, 234, 0.4);
		--cp-acc: var(--view-accent, #f59e0b);
		--cp-acc2: #fb7185;
		--cp-line: rgba(255, 255, 255, 0.09);
		--cp-card: rgba(255, 255, 255, 0.035);
		--cp-marker: 'Bradley Hand', 'Segoe Print', 'Comic Sans MS', cursive;
		font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
		position: relative;
		isolation: isolate;
		overflow: hidden;
		background:
			radial-gradient(1000px 540px at 82% -6%, rgba(245, 158, 11, 0.13), transparent 62%),
			radial-gradient(820px 480px at 6% 44%, rgba(251, 113, 133, 0.07), transparent 60%),
			linear-gradient(180deg, #120c04 0%, #160f08 50%, #0e0903 100%);
		color: var(--cp-ink);
		padding: clamp(2rem, 4vw, 3rem) clamp(1rem, 3vw, 2rem) clamp(2.5rem, 5vw, 4rem);
		transition: background 0.4s ease, color 0.4s ease;
	}
	:global(html:not(.dark)) .cabout {
		--cp-ink: #2b1c08;
		--cp-muted: rgba(43, 28, 8, 0.68);
		--cp-faint: rgba(43, 28, 8, 0.46);
		--cp-acc: #b45309;
		--cp-line: rgba(43, 28, 8, 0.1);
		--cp-card: rgba(43, 28, 8, 0.045);
		background:
			radial-gradient(1000px 540px at 82% -6%, rgba(245, 158, 11, 0.14), transparent 62%),
			linear-gradient(180deg, #fdf4e3 0%, #faecd4 55%, #fdf4e3 100%);
	}

	/* ── the grounds ──
	   Every section used to sit on the same flat black. Each one now has a
	   ground of its own, cycling through four so the page has a rhythm as
	   you scroll, and each one is drawn twice: warm amber on the dark, and
	   ink on cream in daylight, because a wash tuned for black turns to
	   grey mud on white. */
	.ca-sec {
		position: relative;
		isolation: isolate;
		padding-block: clamp(2rem, 4.5vw, 3.5rem);
	}
	.ca-sec::before,
	.ca-sec::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		-webkit-mask-image: linear-gradient(180deg, transparent, #000 8%, #000 92%, transparent);
		mask-image: linear-gradient(180deg, transparent, #000 8%, #000 92%, transparent);
	}
	/* ::after carries the light: a low, warm glow that anchors each band */
	.ca-sec::after {
		background: radial-gradient(78% 52% at 50% 100%, color-mix(in srgb, var(--cp-acc) 10%, transparent), transparent 70%);
	}

	/* 1 · the spotlight — two lamps and a fine dust of chalk */
	.ca-sec:nth-of-type(4n + 1)::before {
		background:
			radial-gradient(2px 2px at 18% 22%, color-mix(in srgb, var(--cp-acc) 45%, transparent), transparent 60%),
			radial-gradient(2px 2px at 74% 68%, color-mix(in srgb, var(--cp-acc2) 40%, transparent), transparent 60%),
			radial-gradient(2px 2px at 46% 86%, color-mix(in srgb, var(--cp-acc) 35%, transparent), transparent 60%),
			radial-gradient(58% 44% at 16% 2%, color-mix(in srgb, var(--cp-acc) 20%, transparent), transparent 66%),
			radial-gradient(48% 38% at 88% 96%, color-mix(in srgb, var(--cp-acc2) 14%, transparent), transparent 62%);
	}
	/* 2 · exercise paper — ruling, a red margin, and a torn top edge */
	.ca-sec:nth-of-type(4n + 2)::before {
		background:
			repeating-linear-gradient(180deg, transparent 0 41px, color-mix(in srgb, var(--cp-acc) 11%, transparent) 41px 42px),
			linear-gradient(90deg, transparent 6.5%, rgba(239, 68, 68, 0.18) 6.5%, rgba(239, 68, 68, 0.18) calc(6.5% + 1px), transparent calc(6.5% + 1px)),
			radial-gradient(66% 46% at 50% 0%, color-mix(in srgb, var(--cp-acc) 12%, transparent), transparent 70%);
	}
	/* 3 · graph paper — a fine grid with a heavier line every fifth */
	.ca-sec:nth-of-type(4n + 3)::before {
		background:
			repeating-linear-gradient(90deg, transparent 0 23px, color-mix(in srgb, var(--cp-acc) 5%, transparent) 23px 24px),
			repeating-linear-gradient(180deg, transparent 0 23px, color-mix(in srgb, var(--cp-acc) 4%, transparent) 23px 24px),
			repeating-linear-gradient(90deg, transparent 0 119px, color-mix(in srgb, var(--cp-acc) 13%, transparent) 119px 120px),
			repeating-linear-gradient(180deg, transparent 0 119px, color-mix(in srgb, var(--cp-acc) 10%, transparent) 119px 120px),
			radial-gradient(56% 42% at 82% 6%, color-mix(in srgb, var(--cp-acc) 14%, transparent), transparent 66%);
	}
	/* 4 · the drafting wash — a long diagonal hatch */
	.ca-sec:nth-of-type(4n)::before {
		background:
			repeating-linear-gradient(56deg, transparent 0 12px, color-mix(in srgb, var(--cp-acc) 4%, transparent) 12px 13px),
			repeating-linear-gradient(56deg, transparent 0 96px, color-mix(in srgb, var(--cp-acc) 12%, transparent) 96px 97px),
			radial-gradient(54% 40% at 10% 90%, color-mix(in srgb, var(--cp-acc2) 15%, transparent), transparent 64%);
	}

	/* ── daylight ──
	   On cream the same washes go muddy, so the grounds are redrawn in ink:
	   stronger rules, cooler blues for the paper, and the glow pulled right
	   back so text keeps its contrast. */
	:global(html:not(.dark)) .cabout .ca-sec::after {
		background: radial-gradient(78% 52% at 50% 100%, color-mix(in srgb, var(--cp-acc) 13%, transparent), transparent 72%);
	}
	:global(html:not(.dark)) .cabout .ca-sec:nth-of-type(4n + 1)::before {
		background:
			radial-gradient(2px 2px at 18% 22%, rgba(146, 64, 14, 0.35), transparent 60%),
			radial-gradient(2px 2px at 74% 68%, rgba(190, 24, 93, 0.28), transparent 60%),
			radial-gradient(2px 2px at 46% 86%, rgba(146, 64, 14, 0.3), transparent 60%),
			radial-gradient(58% 44% at 16% 2%, rgba(245, 158, 11, 0.2), transparent 66%),
			radial-gradient(48% 38% at 88% 96%, rgba(251, 113, 133, 0.16), transparent 62%);
	}
	:global(html:not(.dark)) .cabout .ca-sec:nth-of-type(4n + 2)::before {
		background:
			repeating-linear-gradient(180deg, transparent 0 41px, rgba(59, 130, 246, 0.16) 41px 42px),
			linear-gradient(90deg, transparent 6.5%, rgba(220, 38, 38, 0.3) 6.5%, rgba(220, 38, 38, 0.3) calc(6.5% + 1px), transparent calc(6.5% + 1px)),
			radial-gradient(66% 46% at 50% 0%, rgba(245, 158, 11, 0.14), transparent 70%);
	}
	:global(html:not(.dark)) .cabout .ca-sec:nth-of-type(4n + 3)::before {
		background:
			repeating-linear-gradient(90deg, transparent 0 23px, rgba(37, 99, 235, 0.07) 23px 24px),
			repeating-linear-gradient(180deg, transparent 0 23px, rgba(37, 99, 235, 0.06) 23px 24px),
			repeating-linear-gradient(90deg, transparent 0 119px, rgba(37, 99, 235, 0.17) 119px 120px),
			repeating-linear-gradient(180deg, transparent 0 119px, rgba(37, 99, 235, 0.14) 119px 120px),
			radial-gradient(56% 42% at 82% 6%, rgba(245, 158, 11, 0.15), transparent 66%);
	}
	:global(html:not(.dark)) .cabout .ca-sec:nth-of-type(4n)::before {
		background:
			repeating-linear-gradient(56deg, transparent 0 12px, rgba(146, 64, 14, 0.05) 12px 13px),
			repeating-linear-gradient(56deg, transparent 0 96px, rgba(146, 64, 14, 0.16) 96px 97px),
			radial-gradient(54% 40% at 10% 90%, rgba(251, 113, 133, 0.18), transparent 64%);
	}
	.ca-sec--cta { padding-bottom: clamp(1.5rem, 3vw, 2.5rem); }
	.ca-wrap { max-width: 76rem; margin: 0 auto; }

	.ca-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-family: ui-monospace, monospace;
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--cp-acc);
		border: 1px solid color-mix(in srgb, var(--cp-acc) 40%, transparent);
		background: color-mix(in srgb, var(--cp-acc) 9%, transparent);
		padding: 0.4rem 0.9rem;
		border-radius: 9999px;
		margin-bottom: 1.1rem;
	}
	.ca-kick {
		display: block;
		font-family: ui-monospace, monospace;
		font-size: 0.74rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--cp-acc);
		margin-bottom: 0.6rem;
	}
	.ca-h {
		font-size: clamp(1.9rem, 4vw, 3rem);
		font-weight: 850;
		letter-spacing: -0.02em;
		line-height: 1.05;
		margin: 0 0 0.9rem;
	}
	.ca-h--xl { font-size: clamp(2.4rem, 5.5vw, 4.2rem); line-height: 1; }
	.ca-h--cta { font-size: clamp(2.2rem, 5vw, 3.8rem); }
	.ca-h em {
		font-style: normal;
		background: linear-gradient(95deg, var(--cp-acc), var(--cp-acc2));
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}
	.ca-p {
		font-size: clamp(0.98rem, 1.5vw, 1.12rem);
		line-height: 1.7;
		color: var(--cp-muted);
		max-width: 34rem;
		margin: 0 0 1.4rem;
	}
	.ca-p--center { text-align: center; margin-inline: auto; max-width: 38rem; }
	.ca-head { text-align: center; margin-bottom: clamp(1.5rem, 3vw, 2.25rem); }
	.ca-head .ca-kick { text-align: center; }

	/* An underlined word next to a solid amber button read as an
	   afterthought. It is an outlined button now: the same height and shape
	   as its neighbour, clearly the second of two real choices. */
	.ca-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.95rem 1.6rem;
		border-radius: 9999px;
		font-weight: 800;
		font-size: 0.92rem;
		color: var(--cp-ink);
		border: 1.5px solid color-mix(in srgb, var(--cp-acc) 55%, transparent);
		background: color-mix(in srgb, var(--cp-acc) 8%, transparent);
		transition: background 0.28s ease, border-color 0.28s ease, color 0.28s ease,
			transform 0.28s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.28s ease;
	}
	.ca-link :global(svg) { color: var(--cp-acc); transition: transform 0.28s ease; }
	.ca-link:hover {
		transform: translateY(-2px);
		border-color: var(--cp-acc);
		background: color-mix(in srgb, var(--cp-acc) 16%, transparent);
		box-shadow: 0 16px 32px -18px color-mix(in srgb, var(--cp-acc) 70%, transparent);
	}
	.ca-link:hover :global(svg) { transform: translateX(3px); }
	.ca-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.95rem 1.8rem;
		border-radius: 9999px;
		font-weight: 800;
		font-size: 0.95rem;
		color: #2b1500;
		background: linear-gradient(95deg, #fbbf24, var(--cp-acc));
		box-shadow: 0 18px 44px -16px color-mix(in srgb, var(--cp-acc) 80%, transparent);
		transition: box-shadow 0.25s ease, filter 0.25s ease;
		will-change: transform;
	}
	.ca-cta:hover { filter: brightness(1.06); }
	.ca-row { display: flex; align-items: center; gap: 1.2rem; flex-wrap: wrap; }
	/* Next to a solid amber button, a grey sentence reads as a footnote
	   rather than the second half of a real choice. Same height, same
	   shape, outlined instead of filled. */
	.ca-call {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.95rem 1.6rem;
		border-radius: 9999px;
		font-size: 0.92rem;
		font-weight: 800;
		color: var(--cp-ink);
		border: 1.5px solid color-mix(in srgb, var(--cp-acc) 55%, transparent);
		background: color-mix(in srgb, var(--cp-acc) 8%, transparent);
		transition: background 0.28s ease, border-color 0.28s ease,
			transform 0.28s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.28s ease;
	}
	.ca-call-or {
		font-weight: 500;
		font-size: 0.82rem;
		color: var(--cp-faint);
	}
	.ca-call :global(svg) { color: var(--cp-acc); transition: transform 0.28s ease; }
	.ca-call:hover {
		transform: translateY(-2px);
		border-color: var(--cp-acc);
		background: color-mix(in srgb, var(--cp-acc) 16%, transparent);
		box-shadow: 0 16px 32px -18px color-mix(in srgb, var(--cp-acc) 70%, transparent);
	}
	.ca-call:hover :global(svg) { transform: translateX(3px); }
	@media (max-width: 480px) {
		.ca-cta-row { flex-direction: column; gap: 0.7rem; }
		.ca-cta-row .ca-cta,
		.ca-cta-row .ca-call { width: 100%; justify-content: center; }
	}

	.ca-glare {
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background: radial-gradient(320px 200px at var(--gx, 50%) var(--gy, 20%), color-mix(in srgb, var(--cp-acc) 12%, transparent), transparent 70%);
		opacity: 0;
		transition: opacity 0.3s ease;
		pointer-events: none;
	}
	[data-fa-tilt]:hover .ca-glare { opacity: 1; }

	/* ── A · open day ── */
	.ca-open {
		display: grid;
		gap: clamp(1.75rem, 4vw, 3.5rem);
		align-items: center;
	}
	@media (min-width: 960px) {
		.ca-open { grid-template-columns: 0.85fr 1.15fr; align-items: center; }
	}
	.ca-stats {
		display: flex;
		gap: 0;
		list-style: none;
		margin: 0 0 1.5rem;
		padding: 0;
	}
	.ca-stats li {
		display: grid;
		gap: 0.1rem;
		flex: 1;
		padding-inline: 0.9rem;
		border-left: 1px solid var(--cp-line);
	}
	.ca-stats li:first-child { padding-left: 0; border-left: 0; }
	.ca-stats strong {
		font-size: clamp(1.4rem, 2.6vw, 2rem);
		font-weight: 850;
		letter-spacing: -0.02em;
		background: linear-gradient(135deg, #fbbf24, var(--cp-acc));
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}
	.ca-stats span { font-size: 0.76rem; color: var(--cp-faint); line-height: 1.35; }
	@media (max-width: 560px) {
		.ca-stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 1rem; }
		.ca-stats li { padding-inline: 0; border-left: 0; }
	}

	/* the whiteboard */
	/* the board is the shared WhiteboardVideo now, so it only needs room */
	.ca-boardwrap { display: flex; flex-direction: column; gap: 0.7rem; min-width: 0; }
	.ca-boardnote {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		margin: 0;
		font-size: 0.78rem;
		line-height: 1.5;
		color: var(--cp-faint);
	}

	/* ── B · the class register ──
	   Six boxes in a grid said nothing about a school. This is a ring-bound
	   register: ruled paper, a red margin, one line per department, and each
	   line ticks itself off in turn as the sheet comes into view. */
	.ca-reg {
		position: relative;
		display: grid;
		grid-template-columns: 34px minmax(0, 1fr);
		max-width: 62rem;
		margin-inline: auto;
		filter: drop-shadow(0 34px 60px rgba(0, 0, 0, 0.5));
	}
	.ca-reg-rings {
		display: grid;
		align-content: space-evenly;
		justify-items: center;
		padding-block: 1.4rem;
		border-radius: 0.9rem 0 0 0.9rem;
		background: linear-gradient(180deg, #3c2b16, #241809);
		border: 1px solid rgba(255, 255, 255, 0.07);
		border-right: 0;
	}
	.ca-reg-rings i {
		width: 15px;
		height: 15px;
		border-radius: 9999px;
		border: 2.5px solid #b9b3a8;
		border-bottom-color: #6b665e;
		background: transparent;
	}
	.ca-reg-sheet {
		position: relative;
		overflow: hidden;
		padding: clamp(1.1rem, 2.4vw, 1.6rem) clamp(1rem, 2.6vw, 2rem) 2.6rem;
		border-radius: 0 0.9rem 0.9rem 0;
		color: #2b2119;
		background:
			repeating-linear-gradient(180deg, transparent 0 43px, rgba(59, 130, 246, 0.16) 43px 44px),
			linear-gradient(180deg, #f7f2e6, #efe6d3);
	}
	.ca-reg-margin {
		position: absolute;
		top: 0;
		bottom: 0;
		left: clamp(2.1rem, 4vw, 3.2rem);
		width: 1px;
		background: rgba(220, 38, 38, 0.35);
	}
	.ca-reg-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem;
		padding-bottom: 0.5rem;
		margin-bottom: 0.7rem;
		border-bottom: 2px solid rgba(63, 42, 20, 0.28);
	}
	.ca-reg-title {
		font-family: var(--cp-marker);
		font-size: clamp(1.15rem, 2.4vw, 1.5rem);
		font-weight: 700;
		color: #3f2a14;
	}
	.ca-reg-meta {
		font-family: ui-monospace, monospace;
		font-size: 0.66rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: rgba(63, 42, 20, 0.55);
	}
	.ca-reg-rows { list-style: none; margin: 0; padding: 0; display: grid; }
	.ca-reg-row {
		display: grid;
		grid-template-columns: 26px 62px 30px minmax(0, 1fr) 26px;
		align-items: center;
		gap: 0.55rem;
		padding: 0.62rem 0;
		border-bottom: 1px dashed rgba(63, 42, 20, 0.18);
		opacity: 0;
		transform: translateX(-10px);
		transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
		transition-delay: calc(var(--i, 0) * 0.11s);
	}
	.ca-reg.is-marked .ca-reg-row { opacity: 1; transform: none; }
	.ca-reg-row:last-child { border-bottom: 0; }
	.ca-reg-tick {
		display: grid;
		place-items: center;
		width: 22px;
		height: 22px;
		border-radius: 0.35rem;
		border: 1.6px solid rgba(63, 42, 20, 0.4);
		color: #16a34a;
	}
	.ca-reg-tick svg { opacity: 0; transform: scale(0.4) rotate(-18deg); transition: opacity 0.32s ease, transform 0.42s cubic-bezier(0.34, 1.56, 0.64, 1); transition-delay: calc(var(--i, 0) * 0.11s + 0.28s); }
	.ca-reg.is-marked .ca-reg-tick svg { opacity: 1; transform: none; }
	.ca-reg.is-marked .ca-reg-tick { border-color: #16a34a; }
	.ca-reg-code {
		font-family: ui-monospace, monospace;
		font-size: 0.66rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		color: rgba(63, 42, 20, 0.6);
	}
	.ca-reg-ic {
		display: grid;
		place-items: center;
		width: 28px;
		height: 28px;
		border-radius: 0.45rem;
		color: #92400e;
		background: rgba(245, 158, 11, 0.16);
		border: 1px solid rgba(146, 64, 14, 0.22);
	}
	.ca-reg-body { display: flex; flex-direction: column; min-width: 0; }
	.ca-reg-body strong { font-size: 0.98rem; font-weight: 800; line-height: 1.25; }
	.ca-reg-body em {
		font-style: normal;
		font-size: 0.84rem;
		line-height: 1.5;
		color: rgba(43, 33, 25, 0.66);
	}
	/* the teacher's tick in the margin, drawn in red pen */
	.ca-reg-mark {
		justify-self: end;
		font-family: var(--cp-marker);
		font-size: 1.15rem;
		font-weight: 700;
		color: #dc2626;
		opacity: 0;
		transform: rotate(-14deg) scale(0.5);
		transition: opacity 0.3s ease, transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
		transition-delay: calc(var(--i, 0) * 0.11s + 0.4s);
	}
	.ca-reg.is-marked .ca-reg-mark { opacity: 1; transform: rotate(-14deg); }
	.ca-reg-sign {
		position: absolute;
		right: clamp(1rem, 2.6vw, 2rem);
		bottom: 0.75rem;
		font-family: var(--cp-marker);
		font-size: 0.92rem;
		color: rgba(43, 33, 25, 0.45);
	}
	@media (max-width: 720px) {
		.ca-reg { grid-template-columns: 26px minmax(0, 1fr); }
		.ca-reg-rings i { width: 12px; height: 12px; }
		.ca-reg-row {
			grid-template-columns: 22px 26px minmax(0, 1fr);
			row-gap: 0.15rem;
			padding: 0.55rem 0;
		}
		.ca-reg-code { display: none; }
		.ca-reg-mark { display: none; }
		.ca-reg-body strong { font-size: 0.92rem; }
		.ca-reg-body em { font-size: 0.78rem; }
		.ca-reg-sheet { padding-bottom: 2.2rem; }
	}
	@media (prefers-reduced-motion: reduce) {
		.ca-reg-row,
		.ca-reg-tick svg,
		.ca-reg-mark { transition: none; opacity: 1; transform: none; }
	}

	/* ── C · the charter ── */
	.ca-charter {
		display: grid;
		gap: 1.2rem;
		margin-bottom: 1.4rem;
	}
	@media (min-width: 760px) {
		.ca-charter { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}
	/* The posters used to simply appear. They swing down from the pin now,
	   the way paper does when you push a tack through the top of it, and
	   settle with a little weight. */
	.ca-poster {
		position: relative;
		padding: clamp(1.4rem, 3vw, 2rem);
		border-radius: 0.6rem;
		background:
			radial-gradient(120% 90% at 50% 0%, color-mix(in srgb, var(--cp-acc) 9%, transparent), transparent 62%),
			var(--cp-card);
		border: 1px solid var(--cp-line);
		box-shadow: 0 24px 55px -28px rgba(0, 0, 0, 0.55);
		transform-origin: 50% -6px;
		transform: rotate(var(--r, 0deg));
		transition: box-shadow 0.4s ease, border-color 0.4s ease;
	}
	.ca-poster:hover {
		border-color: color-mix(in srgb, var(--cp-acc) 42%, transparent);
		box-shadow: 0 30px 62px -26px color-mix(in srgb, var(--cp-acc) 45%, transparent);
	}
	/* the swing itself, staggered so the second one follows the first */
	.ca-poster.cp-rev {
		opacity: 0;
		transform: rotate(calc(var(--r, 0deg) - 9deg)) translateY(-26px);
	}
	.ca-poster.cp-rev.is-on {
		opacity: 1;
		transform: rotate(var(--r, 0deg));
		animation: ca-pin 1.35s cubic-bezier(0.28, 1.4, 0.4, 1) both;
		animation-delay: calc(var(--i, 0) * 0.18s);
	}
	@keyframes ca-pin {
		0% { opacity: 0; transform: rotate(calc(var(--r, 0deg) - 9deg)) translateY(-26px); }
		45% { opacity: 1; transform: rotate(calc(var(--r, 0deg) + 2.5deg)) translateY(0); }
		70% { transform: rotate(calc(var(--r, 0deg) - 1.4deg)); }
		86% { transform: rotate(calc(var(--r, 0deg) + 0.6deg)); }
		100% { opacity: 1; transform: rotate(var(--r, 0deg)); }
	}
	/* the tack pushes in just before the paper drops */
	.ca-poster .ca-pin { transform-origin: 50% 50%; }
	.ca-poster.cp-rev.is-on .ca-pin {
		animation: ca-tack 0.5s cubic-bezier(0.34, 1.7, 0.5, 1) both;
		animation-delay: calc(var(--i, 0) * 0.18s);
	}
	@keyframes ca-tack {
		from { transform: scale(2.1) translateY(-10px); opacity: 0; }
		to { transform: none; opacity: 1; }
	}
	@media (prefers-reduced-motion: reduce) {
		.ca-poster.cp-rev,
		.ca-poster.cp-rev.is-on,
		.ca-poster.cp-rev.is-on .ca-pin { animation: none; opacity: 1; transform: rotate(var(--r, 0deg)); }
	}
	.ca-pin {
		position: absolute;
		top: -7px;
		left: 50%;
		transform: translateX(-50%);
		width: 14px;
		height: 14px;
		border-radius: 50%;
		background: radial-gradient(circle at 35% 30%, #fda4af, #e11d48 65%);
		box-shadow: 0 3px 6px rgba(0, 0, 0, 0.45);
	}
	.ca-poster-k {
		display: inline-block;
		font-family: ui-monospace, monospace;
		font-size: 0.7rem;
