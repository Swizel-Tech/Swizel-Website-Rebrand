---
// Case study · Founder world — the whole launch story: hero with the live
// product in a browser frame + floating result badges, the story & the
// challenge, the approach that draws itself, highlight cards, big gradient
// results, the gallery, the client's words, press, next stories and a CTA.
// Root carries `fbody` (founder engine) and `fcs` (motion bindings).
import { Icon } from 'astro-icon/components';
import type { Project } from '../../data/projects';

interface Props {
	project: Project;
	others: Project[];
}
const { project: p, others } = Astro.props;
const cs = p.caseStudy!;

const galVideo = cs.gallery.find((g) => g.kind === 'video');
const galImages = cs.gallery.filter((g) => g.kind !== 'video');
// two headline results float over the hero shot
const heroBadges = cs.results.slice(0, 2);
---

<div class="fcs fbody view-body view-body-founder" style={`--c:${p.color}`}>
	<div class="fc-bg" aria-hidden="true">
		<span class="fc-orb fc-orb--a"></span>
		<span class="fc-orb fc-orb--b"></span>
	</div>

	<!-- ── hero ── -->
	<section class="fc-sec">
		<div class="fc-wrap fc-hero">
			<div class="fd-rev">
				<nav class="fc-crumb" aria-label="Breadcrumb">
					<a href="/portfolio">Our work</a>
					<Icon width={14} name="mdi:chevron-right" />
					<span>{p.name}</span>
				</nav>
				<span class="fc-stamp">{cs.meta.sector} · Founder mode</span>
				<h1 class="fc-h fc-h--xl">{p.name}<em>.</em></h1>
				<p class="fc-tagline">{p.tagline}</p>
				<span class="fc-chips">
					<i><b>Client</b> {cs.meta.client}</i>
					<i><b>Year</b> {cs.meta.year}</i>
					<i><b>Scope</b> {cs.meta.scope}</i>
				</span>
				<div class="fc-row">
					{
						cs.liveUrl && (
							<a
								href={cs.liveUrl}
								target="_blank"
								rel="noopener noreferrer"
								data-leaving=""
								data-leaving-name={p.name}
								class="fc-cta fs-cta"
							>
								Visit live site
								<Icon width={16} name="mdi:open-in-new" />
							</a>
						)
					}
					<a href="/contact" class="fc-link">
						Start yours
						<Icon width={15} name="mdi:arrow-right" />
					</a>
				</div>
			</div>

			<div class="fc-visual fd-rev">
				<a
					class:list={['fc-shot', { 'fc-shot--app': p.kind === 'app' }]}
					href={cs.liveUrl ?? undefined}
					target={cs.liveUrl ? '_blank' : undefined}
					rel={cs.liveUrl ? 'noopener noreferrer' : undefined}
					data-leaving={cs.liveUrl ? '' : undefined}
					data-leaving-name={cs.liveUrl ? p.name : undefined}
					data-fa-tilt="7"
				>
					{
						p.kind !== 'app' && (
							<span class="fc-bar" aria-hidden="true">
								<i></i><i></i><i></i>
								<span class="fc-url">{p.host}</span>
							</span>
						)
					}
					<span class="fc-img"><img src={p.img} alt={p.name} loading="eager" /></span>
				</a>
				{
					heroBadges.map((r, i) => (
						<span class:list={['fc-float', `fc-float--${i}`]}>
							<strong>{r.stat}</strong>
							<em>{r.label}</em>
						</span>
					))
				}
			</div>
		</div>

		<!-- services marquee strip -->
		<div class="fc-marquee fd-rev" aria-hidden="true">
			<div class="fc-marquee-track">
				{
					Array.from({ length: 2 }).map(() => (
						<span class="fc-marquee-seq">
							{cs.services.map((s) => (
								<><i>{s}</i><b>✦</b></>
							))}
							<i>{cs.meta.year}</i><b>✦</b>
						</span>
					))
				}
			</div>
		</div>
	</section>

	<!-- ── the story + the challenge ── -->
	<section class="fc-sec">
		<div class="fc-wrap fc-story">
			<article class="fc-panel fd-rev" data-fa-tilt="5">
				<span class="fa-val-glare" aria-hidden="true"></span>
				<span class="fc-stamp fc-stamp--sm">The story</span>
				<p>{cs.intro}</p>
			</article>
			<article class="fc-panel fc-panel--challenge fd-rev" style="--i:1" data-fa-tilt="5">
				<span class="fa-val-glare" aria-hidden="true"></span>
				<span class="fc-stamp fc-stamp--sm">The challenge</span>
				<p>{cs.challenge}</p>
			</article>
		</div>
	</section>

	<!-- ── the approach — draws itself ── -->
	<section class="fc-sec" data-cursor="clock">
		<div class="fc-wrap">
			<div class="fc-head fd-rev">
				<span class="fc-stamp">What we did</span>
				<h2 class="fc-h">The <em>approach.</em></h2>
			</div>
			<ol class="fc-approach fd-rev">
				<span class="fc-approach-line" aria-hidden="true"></span>
				{
					cs.approach.map((a, i) => (
						<li class="fc-appstep" style={`--i:${i}`}>
							<span class="fc-appstep-n">{String(i + 1).padStart(2, '0')}</span>
							<div>
								<h3>{a.title}</h3>
								<p>{a.desc}</p>
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<!-- ── highlights ── -->
	<section class="fc-sec" data-cursor="repo">
		<div class="fc-wrap">
			<div class="fc-head fd-rev">
				<span class="fc-stamp">Inside the build</span>
				<h2 class="fc-h">What <em>shipped.</em></h2>
			</div>
			<div class="fc-highlights">
				{
					cs.highlights.map((h, i) => (
						<article class="fc-hl fd-rev" style={`--i:${i % 3}`} data-fa-tilt="9">
							<span class="fa-val-glare" aria-hidden="true" />
							<span class="fc-hl-n">{String(i + 1).padStart(2, '0')}</span>
							<h3>{h.title}</h3>
							<p>{h.desc}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<!-- ── results ── -->
	<section class="fc-sec" data-cursor="chart">
		<div class="fc-wrap">
			<div class="fc-results fd-rev">
				<span class="fc-stamp">The scoreboard</span>
				<h2 class="fc-h">Results that <em>talk.</em></h2>
				<ul class="fc-results-grid">
					{
						cs.results.map((r, i) => (
							<li style={`--i:${i}`}>
								<strong>{r.stat}</strong>
								<span>{r.label}</span>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</section>

	<!-- ── gallery ── -->
	<section class="fc-sec" data-cursor="play">
		<div class="fc-wrap">
			<div class="fc-head fd-rev">
				<span class="fc-stamp">Up close</span>
				<h2 class="fc-h">The product, <em>in frames.</em></h2>
			</div>
			<div class="fc-gallery">
				{
					galVideo && (
						<div class="fc-gal-video fd-rev">
							<span class="fa-media-sheen fc-media-sheen" aria-hidden="true" />
							<Icon width={36} name="mdi:play-circle-outline" />
							<span class="fc-media-label">{galVideo.label}</span>
							{galVideo.caption && <span class="fc-media-sub">{galVideo.caption}</span>}
						</div>
					)
				}
				<div class="fc-gal-grid">
					{
						galImages.map((g, i) =>
							g.src ? (
								<figure class="fc-gal-item fd-rev" style={`--i:${i % 4}`}>
									<img src={g.src} alt={g.label} loading="lazy" />
									{g.caption && <figcaption>{g.caption}</figcaption>}
								</figure>
							) : (
								<div class="fc-gal-item fc-gal-item--ph fd-rev" style={`--i:${i % 4}`}>
									<span class="fa-val-glare" aria-hidden="true" />
									<Icon width={22} name="mdi:image-outline" />
									<span class="fc-media-label">{g.label}</span>
									{g.caption && <span class="fc-media-sub">{g.caption}</span>}
								</div>
							)
						)
					}
				</div>
			</div>
		</div>
	</section>

	<!-- ── quote ── -->
	{
		cs.quote && (
			<section class="fc-sec" data-cursor="quote">
				<div class="fc-wrap">
					<figure class="fc-quote fd-rev" data-fa-tilt="5">
						<span class="fc-quote-mark" aria-hidden="true">“</span>
						<blockquote>“{cs.quote.text}”</blockquote>
						<figcaption>{cs.quote.who}</figcaption>
					</figure>
				</div>
			</section>
		)
	}

	<!-- ── press ── -->
	{
		cs.press && cs.press.items.length > 0 && (
			<section class="fc-sec" data-cursor="repo">
				<div class="fc-wrap fc-wrap--narrow">
					<div class="fc-head fd-rev">
						<span class="fc-stamp">In the news</span>
						<h2 class="fc-h">The world <em>noticed.</em></h2>
						{cs.press.intro && <p class="fc-p fc-p--center">{cs.press.intro}</p>}
					</div>
					<ul class="fc-press fd-rev">
						{cs.press.items.map((it) => {
							const Tag = it.url ? 'a' : 'span';
							return (
								<li>
									<Tag
										href={it.url ?? undefined}
										target={it.url ? '_blank' : undefined}
										rel={it.url ? 'noopener noreferrer' : undefined}
										class="fc-press-item"
									>
										<Icon width={17} name="mdi:newspaper-variant-outline" />
										<span>
											<strong>{it.title}</strong>
											<em>{it.outlet}{it.date ? ` · ${it.date}` : ''}</em>
										</span>
										{it.url && <Icon width={14} name="mdi:arrow-top-right" />}
									</Tag>
								</li>
							);
						})}
					</ul>
				</div>
			</section>
		)
	}

	<!-- ── next stories + CTA ── -->
	<section class="fc-sec fc-sec--last" data-cursor="phone">
		<div class="fc-wrap">
			<div class="fc-next fd-rev">
				<span class="fc-next-h">More stories worth the read</span>
				<div class="fc-next-row">
					{
						others.slice(0, 3).map((o) => (
							<a href={`/work/${o.slug}`} class="fc-next-card" style={`--oc:${o.color}`}>
								<img src={o.img} alt={o.name} loading="lazy" />
								<span>
									<strong>{o.name}</strong>
									<em>{o.tagline}</em>
								</span>
								<Icon width={15} name="mdi:arrow-right" />
							</a>
						))
					}
				</div>
			</div>

			<div class="fc-ctabox fd-rev">
				<span class="fa-cta-orbit fc-orbit" aria-hidden="true">
					<i></i><i></i><i></i>
				</span>
				<h2 class="fc-h">Your story, <em>next.</em></h2>
				<p class="fc-p fc-p--center">
					Tell us what you imagine. You'll have a reply within one
					business day.
				</p>
				<div class="fc-row fc-row--center">
					<a href="/contact" class="fc-cta fs-cta">
						Start your project
						<Icon width={17} name="mdi:rocket-launch-outline" />
					</a>
					<a href="/portfolio" class="fc-link">
						Back to the work
						<Icon width={15} name="mdi:arrow-left" />
					</a>
				</div>
			</div>
		</div>
	</section>
</div>

<style>
	.fcs {
		--fa-ink: #f1edfb;
		--fa-muted: rgba(241, 237, 251, 0.62);
		--fa-acc: var(--c, #8b5cf6);
		--fa-acc2: #ec4899;
		--fa-line: rgba(255, 255, 255, 0.09);
		--fa-card: rgba(255, 255, 255, 0.035);
		font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI',
			Roboto, sans-serif;
		position: relative;
		isolation: isolate;
		background:
			radial-gradient(900px 500px at 85% -8%, color-mix(in srgb, var(--c, #8b5cf6) 14%, transparent), transparent 62%),
			radial-gradient(760px 440px at 4% 46%, rgba(236, 72, 153, 0.07), transparent 60%),
			linear-gradient(180deg, #0a0714 0%, #0d0a18 50%, #080610 100%);
		color: var(--fa-ink);
		padding: clamp(3rem, 7vw, 5rem) clamp(1rem, 3vw, 2rem) clamp(2.5rem, 5vw, 4rem);
	}
	:global(html:not(.dark)) .fcs {
		--fa-ink: #1d1430;
		--fa-muted: rgba(29, 20, 48, 0.66);
		--fa-line: rgba(29, 20, 48, 0.1);
		--fa-card: rgba(29, 20, 48, 0.04);
		background:
			radial-gradient(900px 500px at 85% -8%, color-mix(in srgb, var(--c, #8b5cf6) 10%, transparent), transparent 62%),
			linear-gradient(180deg, #f4f1fb 0%, #ece7f8 55%, #f4f1fb 100%);
	}
	.fc-sec { position: relative; z-index: 1; padding-block: clamp(1.8rem, 4.5vw, 3.2rem); }
	.fc-sec--last { padding-bottom: clamp(3rem, 6vw, 4.5rem); }
	.fc-wrap { max-width: 74rem; margin: 0 auto; }
	.fc-wrap--narrow { max-width: 52rem; }

	.fc-bg { position: absolute; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
	.fc-orb { position: absolute; border-radius: 50%; filter: blur(70px); opacity: 0.45; animation: fc-drift 15s ease-in-out infinite alternate; }
	.fc-orb--a { width: 440px; height: 440px; left: -140px; top: 4%; background: radial-gradient(circle, color-mix(in srgb, var(--c, #8b5cf6) 38%, transparent), transparent 70%); }
	.fc-orb--b { width: 500px; height: 500px; right: -170px; top: 42%; background: radial-gradient(circle, rgba(236, 72, 153, 0.16), transparent 70%); animation-delay: -7s; }
	@keyframes fc-drift { to { transform: translate3d(50px, -36px, 0) scale(1.1); } }
	@media (prefers-reduced-motion: reduce) { .fc-orb { animation: none; } }

	.fc-stamp {
		display: inline-block; font-size: 0.72rem; font-weight: 800;
		letter-spacing: 0.14em; text-transform: uppercase; color: var(--c);
		border: 1.5px dashed color-mix(in srgb, var(--c) 55%, transparent);
		padding: 0.35rem 0.8rem; border-radius: 0.5rem; transform: rotate(-2deg);
		margin-bottom: 1rem;
	}
	.fc-stamp--sm { font-size: 0.64rem; padding: 0.28rem 0.65rem; margin-bottom: 0.7rem; }
	.fc-h { font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 850; letter-spacing: -0.025em; line-height: 1.06; margin: 0 0 1rem; }
	.fc-h--xl { font-size: clamp(2.2rem, 4.6vw, 3.5rem); }
	.fc-h em {
		font-style: italic;
		background: linear-gradient(95deg, var(--c), var(--fa-acc2));
		-webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
		padding-right: 0.06em;
	}
	.fc-p { font-size: 1rem; line-height: 1.65; color: var(--fa-muted); max-width: 34rem; margin: 0 0 1.2rem; }
	.fc-p--center { margin-inline: auto; text-align: center; }
	.fc-head { text-align: center; max-width: 46rem; margin: 0 auto clamp(1.4rem, 3vw, 2rem); }
	.fc-link { display: inline-flex; align-items: center; gap: 0.45rem; font-weight: 700; color: var(--c); transition: gap 0.25s ease; }
	.fc-link:hover { gap: 0.75rem; }
	.fc-row { display: flex; align-items: center; gap: 1.3rem; flex-wrap: wrap; }
	.fc-row--center { justify-content: center; }
	.fc-cta {
		display: inline-flex; align-items: center; gap: 0.55rem;
		font-weight: 800; font-size: 0.96rem; color: #fff;
		background: linear-gradient(95deg, var(--c), var(--fa-acc2));
		padding: 0.85rem 1.6rem; border-radius: 9999px;
		box-shadow: 0 16px 38px -14px color-mix(in srgb, var(--c) 80%, transparent);
		transition: transform 0.22s ease;
	}
	.fc-cta:hover { transform: translateY(-2px); }

	.fd-rev {
		opacity: 0; transform: translateY(22px);
		transition: opacity 0.6s ease calc(var(--i, 0) * 90ms),
			transform 0.6s cubic-bezier(0.22, 1, 0.36, 1) calc(var(--i, 0) * 90ms);
	}
	.fd-rev.is-on { opacity: 1; transform: none; }
	@media (prefers-reduced-motion: reduce) { .fd-rev { opacity: 1; transform: none; transition: none; } }
	.fa-val-glare {
		position: absolute; inset: 0;
		background: radial-gradient(340px 220px at var(--gx, 50%) var(--gy, 0%), rgba(255, 255, 255, 0.09), transparent 60%);
		opacity: 0; transition: opacity 0.3s ease; pointer-events: none;
	}
	:is(.fc-panel, .fc-hl):hover .fa-val-glare { opacity: 1; }
	.fa-cta-orbit { position: absolute; inset: 0; pointer-events: none; }

	/* hero */
	.fc-hero { display: grid; grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr); gap: clamp(2rem, 4vw, 3.2rem); align-items: center; }
	.fc-crumb { display: flex; align-items: center; gap: 0.4rem; font-size: 0.82rem; font-weight: 600; color: var(--fa-muted); margin-bottom: 1rem; }
	.fc-crumb a { color: var(--c); }
	.fc-tagline { font-size: 1.1rem; font-weight: 700; color: var(--c); margin: 0 0 1rem; }
	.fc-chips { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-bottom: 1.4rem; }
	.fc-chips i {
		font-style: normal; font-size: 0.78rem; font-weight: 600;
		padding: 0.4rem 0.8rem; border-radius: 999px;
		border: 1px solid color-mix(in srgb, var(--c) 40%, transparent);
		background: color-mix(in srgb, var(--c) 9%, transparent);
		color: var(--fa-ink);
	}
	.fc-chips b { font-weight: 800; color: var(--c); margin-right: 0.3rem; text-transform: uppercase; font-size: 0.66rem; letter-spacing: 0.06em; }
	.fc-visual { position: relative; }
	.fc-shot {
		position: relative; display: block; border-radius: 1rem; overflow: hidden;
		border: 1px solid color-mix(in srgb, var(--c) 42%, rgba(255, 255, 255, 0.12));
		background: #14101f;
		box-shadow: 0 36px 72px -28px rgba(0, 0, 0, 0.7);
		transform-style: preserve-3d; will-change: transform;
	}
	.fc-bar { display: flex; align-items: center; gap: 4px; padding: 8px 10px; background: rgba(255, 255, 255, 0.05); }
	.fc-bar i { width: 8px; height: 8px; border-radius: 50%; background: color-mix(in srgb, var(--c) 70%, #fff); opacity: 0.65; }
	.fc-url { margin-left: 0.5rem; font-size: 0.68rem; font-weight: 700; color: var(--fa-muted); }
	.fc-img { display: block; height: 340px; overflow: hidden; }
	.fc-img img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; transition: transform 0.5s ease; }
	.fc-shot:hover .fc-img img { transform: scale(1.04); }
	.fc-shot--app .fc-img { height: 360px; }
	.fc-shot--app .fc-img img { object-fit: contain; background: color-mix(in srgb, var(--c) 8%, transparent); }
	/* floating result badges */
	.fc-float {
		position: absolute; display: grid; gap: 0.05rem;
		padding: 0.6rem 1rem; border-radius: 0.9rem;
		border: 1px solid color-mix(in srgb, var(--c) 45%, transparent);
		background: color-mix(in srgb, var(--c) 16%, rgba(10, 7, 20, 0.82));
		backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
		box-shadow: 0 18px 38px -16px color-mix(in srgb, var(--c) 70%, transparent);
		animation: fc-bob 5s ease-in-out infinite;
		pointer-events: none;
	}
	:global(html:not(.dark)) .fcs .fc-float { background: color-mix(in srgb, var(--c) 12%, rgba(255, 255, 255, 0.9)); }
	.fc-float strong {
		font-size: 1.25rem; font-weight: 850;
		background: linear-gradient(95deg, var(--c), var(--fa-acc2));
		-webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
	}
	.fc-float em { font-style: normal; font-size: 0.68rem; font-weight: 700; color: var(--fa-muted); }
	.fc-float--0 { top: -1.2rem; right: -0.9rem; animation-delay: -1.4s; }
	.fc-float--1 { bottom: -1.2rem; left: -0.9rem; animation-delay: -3.2s; }
	@keyframes fc-bob { 0%, 100% { margin-top: 0; } 50% { margin-top: -8px; } }
	@media (prefers-reduced-motion: reduce) { .fc-float { animation: none; } }

	/* services marquee */
	.fc-marquee {
		margin-top: clamp(1.8rem, 4vw, 2.6rem); overflow: hidden;
		border-block: 1px solid color-mix(in srgb, var(--c) 24%, transparent);
		padding-block: 0.75rem;
		-webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
		mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
	}
	.fc-marquee-track { display: flex; width: max-content; animation: fc-marquee 22s linear infinite; }
	@keyframes fc-marquee { to { transform: translateX(-50%); } }
	.fc-marquee-seq { display: flex; align-items: center; }
	.fc-marquee-seq i {
		font-style: normal; font-size: 0.9rem; font-weight: 700;
		letter-spacing: 0.06em; text-transform: uppercase;
		color: var(--fa-muted); white-space: nowrap; padding: 0 1.3rem;
	}
	.fc-marquee-seq b { color: var(--c); font-weight: 400; }
	@media (prefers-reduced-motion: reduce) { .fc-marquee-track { animation: none; } }

	/* story + challenge */
	.fc-story { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.2rem; }
	.fc-panel {
		position: relative; overflow: hidden;
		border: 1px solid var(--fa-line); border-radius: 1.3rem;
		background:
