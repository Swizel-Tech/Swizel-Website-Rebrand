	}
	@keyframes ba-bob { 0%, 100% { margin-top: 0; } 50% { margin-top: -5px; } }
	@media (prefers-reduced-motion: reduce) { .ba-pkg-ic { animation: none; } }
	.ba-pkg p { font-size: 0.88rem; line-height: 1.6; color: var(--bu-muted); margin: 0 0 0.8rem; flex: 1; }
