	.ba-mvv-vals i { font-style: normal; display: block; color: var(--bu-acc); }
	:global(html:not(.dark)) .babout .ba-mvv-vals i { color: #0b8a76; }

	/* ── 03 · packages ── */
	.ba-pkgs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
	.ba-pkg {
		position: relative; overflow: hidden; display: flex; flex-direction: column;
		border: 1px solid var(--bu-line); border-radius: 1rem;
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.04), transparent 55%), var(--bu-card);
		padding: 1.2rem; color: var(--bu-ink);
		transform-style: preserve-3d; will-change: transform;
		transition: border-color 0.3s ease, box-shadow 0.3s ease;
	}
	.ba-pkg:hover { border-color: color-mix(in srgb, var(--bu-acc) 55%, transparent); box-shadow: 0 22px 46px -22px color-mix(in srgb, var(--bu-acc) 55%, transparent); }
	.ba-pkg-top { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.55rem; }
	.ba-pkg-top strong { font-family: var(--bu-mono); font-size: 0.9rem; font-weight: 700; }
	.ba-pkg-ic {
		display: grid; place-items: center; width: 36px; height: 36px; border-radius: 0.6rem;
		color: var(--bu-acc); background: color-mix(in srgb, var(--bu-acc) 14%, transparent);
