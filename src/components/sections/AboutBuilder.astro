	.ba-dot { width: 10px; height: 10px; border-radius: 50%; }
	.ba-dot--r { background: #ff5f57; } .ba-dot--y { background: #febc2e; } .ba-dot--g { background: #28c840; }
	.ba-wintitle { margin-left: 0.5rem; font-family: var(--bu-mono); font-size: 0.74rem; color: rgba(232, 240, 244, 0.5); }
	.ba-md { padding: 1.1rem 1.3rem 1.2rem; font-family: var(--bu-mono); font-size: 0.86rem; line-height: 1.75; color: rgba(232, 240, 244, 0.78); }
