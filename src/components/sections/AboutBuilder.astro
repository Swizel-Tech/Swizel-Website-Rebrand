---
// About page · Builder world — the company as a repository. Same foundational
// content as the Boardroom/Founder About (story, mission/vision/core values,
// what we do, real timeline incl 2024, clickable team, media, Brevarium,
// client words) told as README, config, modules, git tags and CONTRIBUTORS.
// Root carries `bbody` so the shared builder engine (.bb-rev reveals,
// [data-count] counters, #bb-git draw) and the motion engine (tilt/glare/
// magnetic via .bbody) both bind for free.
import { Icon } from 'astro-icon/components';
import { teamDetails, MISSION, VISION, CORE_VALUES } from '../../consts';

const stats = [
	{ to: 65, suffix: '+', label: 'products shipped' },
	{ to: 25, suffix: '+', label: 'contributors' },
	{ to: 7, suffix: '+', label: 'years in production' },
	{ to: 10, suffix: '+', label: 'countries' },
];

// six disciplines as installable packages — same content as every view
const pkgs = [
	{ name: '@swizel/design', icon: 'mdi:palette-outline', desc: 'Brand identity, graphics and product design, interfaces your customers find effortless.', tags: ['brand', 'ui/ux', 'motion'] },
	{ name: '@swizel/development', icon: 'mdi:code-tags', desc: 'Web and mobile engineering built to scale. We build, test and ship fast, without breaking things.', tags: ['web', 'ios', 'android', 'apis'] },
	{ name: '@swizel/marketing', icon: 'mdi:bullhorn-outline', desc: 'We grow your audience across every platform that matters, and co-market the products we ship.', tags: ['seo', 'ads', 'content'] },
	{ name: '@swizel/strategy', icon: 'mdi:compass-outline', desc: 'Research, define and lock the goal, a tailored product roadmap before a line of code is written.', tags: ['research', 'roadmaps', 'mvp'] },
	{ name: '@swizel/maintenance', icon: 'mdi:wrench-outline', desc: 'Improving existing products and keeping complex systems healthy, secure and online, year after year.', tags: ['support', 'devops', 'uptime'] },
	{ name: '@swizel/education', icon: 'mdi:school-outline', desc: 'Free training and The Brevarium, putting real, job-ready skills in the hands of the next builders.', tags: ['training', 'brevarium', 'mentoring'] },
];

// the real road — same milestones as Boardroom/Founder, as release tags
const releases = [
	{ tag: 'v2019.0', hash: 'a1f2019', title: 'The first line of code.', desc: 'Swizel starts in Nigeria, a small, stubborn team taking on its first builds for local businesses.' },
	{ tag: 'v2020.0', hash: 'b3d2020', title: 'Products, not projects.', desc: 'We stop thinking in deliverables and start thinking in products, software meant to live and grow.' },
	{ tag: 'v2022.0', hash: 'c5e2022', title: 'Mobile, everywhere.', desc: 'Native iOS and Android join the practice. The same team now ships across web and phone.' },
	{ tag: 'v2023.0', hash: 'd7a2023', title: 'At home in every sector.', desc: 'Fintech, real estate, sports, education, logistics, the work spreads across the industries that move Africa.' },
	{ tag: 'v2024.0', hash: 'e9c2024', title: 'Crossing borders.', desc: 'The work goes global. ConvertMyBetCode serves users in 10+ countries, and the first Brevarium is published.' },
	{ tag: 'v2025.0', hash: 'f1b2025', title: 'Teaching the next ones.', desc: 'We open our free training programme, growing new engineers, designers and marketers on real products.' },
	{ tag: 'v2026.0', hash: 'a2d2026', title: '65+ and counting.', desc: 'Seven years in, more than sixty-five products live in the market, and we are only warming up.' },
];

// same crew, same order, same modal data as the other About worlds
const teamOrder = [
	{ name: 'Azoro', role: 'Business Development Lead' },
	{ name: 'Ruke', role: 'Product Manager' },
	{ name: 'Dennis', role: 'UI/UX Designer' },
	{ name: 'Mary', role: 'Software Engineer' },
	{ name: 'Stephen', role: 'Fullstack Developer' },
	{ name: 'Nathaniel', role: 'Frontend Developer' },
	{ name: 'Precious', role: 'Mobile Developer' },
	{ name: 'Linda', role: 'Marketing Lead' },
];
const team = teamOrder.map((m) => {
	const d = (teamDetails as any[]).find((t) => t.name === m.name) || {};
	return {
		...m,
		bio: d.bio || '',
		experience: (d.experience || []) as { company: string; jobDesc: string }[],
		linkedin: d.linkedinURL && d.linkedinURL !== '#' ? d.linkedinURL : '',
	};
});

const brevariumEditions = [
	{ vol: 'v3.0.0', date: 'Latest · 2026', href: '/brevarium/the-brevarium-latest.pdf' },
	{ vol: 'v2.0.0', date: '2025', href: '/The Brevarium by Swizel.pdf' },
	{ vol: 'v1.0.0', date: '2024', href: '/The Brevarium by Swizel.pdf' },
];

const quotes = [
	{ name: 'Chidimma', img: '/testimonial/chidima.jpeg', body: 'Warm, responsive and a true extension of our team. They took the worry out of shipping software.', files: '+1 platform · −100 worries' },
	{ name: 'Favour', img: '/testimonial/favour.jpeg', body: 'Geniuses, honestly. Working with them was effortless from the first call to launch day.', files: '+1 product · −0 regrets' },
	{ name: 'Cheta', img: '/testimonial/cheta.jpeg', body: 'Thorough, polite and always on time. They make hard things feel easy.', files: '+1 store · −0 missed dates' },
];
---

<div class="babout bbody view-body view-body-builder">
	<!-- ambient stage -->
	<div class="ba-bg" aria-hidden="true">
		<span class="ba-orb ba-orb--a"></span>
		<span class="ba-orb ba-orb--b"></span>
		{Array.from({ length: 7 }).map((_, i) => (
			<i class="ba-spark" style={`--s:${i}`}></i>
		))}
	</div>

	<!-- ── 01 · README ─────────────────────────────────────── -->
	<section class="ba-sec" data-cursor="term">
		<div class="ba-wrap ba-open">
			<div class="ba-copy bb-rev">
				<span class="ba-kick">// git blame swizel</span>
				<h2 class="ba-h ba-h--xl">The repo behind <span class="ba-acc">the products.</span></h2>
				<p class="ba-p">
					Swizel is one team of designers, engineers and growth marketers,
					shipping since 2019. Everything you need to launch and grow, in
					a single repository.
				</p>
				<ul class="ba-stats">
					{
						stats.map((s) => (
							<li>
								<strong data-count={s.to} data-suffix={s.suffix}>0{s.suffix}</strong>
								<span>{s.label}</span>
							</li>
						))
					}
				</ul>
				<a href="/portfolio" class="ba-link">
					See what we've deployed
					<Icon width={16} name="mdi:arrow-right" />
				</a>
			</div>

			<div class="ba-win bb-rev" data-fa-tilt="4">
				<span class="bb-glare" aria-hidden="true"></span>
				<div class="ba-winbar">
					<span class="ba-dot ba-dot--r"></span>
					<span class="ba-dot ba-dot--y"></span>
					<span class="ba-dot ba-dot--g"></span>
					<span class="ba-wintitle">README.md</span>
				</div>
				<div class="ba-md">
					<p class="ba-md-h1"># Swizel</p>
					<p class="ba-md-quote">&gt; You imagine. We build.</p>
					<p class="ba-md-p">Founded <b>2019</b> in Nigeria on a stubborn belief: African businesses deserve software as good as anything built anywhere.</p>
					<p class="ba-md-p"><b>65+</b> products later, we design the idea, build it, take it to market, and stay to grow it.</p>
					<p class="ba-md-li"><i>-</i> one team, every discipline</p>
					<p class="ba-md-li"><i>-</i> weeks, not quarters</p>
					<p class="ba-md-li"><i>-</i> we stay after launch</p>
				</div>
				<div class="ba-winfoot">
					<span class="ba-live" aria-hidden="true"></span>
					main · 7 years of commits · build passing
				</div>
			</div>
		</div>
	</section>

	<!-- ── 02 · company.config — mission / vision / values ─── -->
	<section class="ba-sec" data-cursor="pkg">
		<div class="ba-wrap">
			<div class="ba-head bb-rev">
				<span class="ba-kick">// company.config</span>
				<h2 class="ba-h">Constants. <span class="ba-acc">Never reassigned.</span></h2>
			</div>
			<div class="ba-mvv">
				<article class="ba-mvv-card bb-rev" data-fa-tilt="8">
					<span class="bb-glare" aria-hidden="true"></span>
					<span class="ba-mvv-key"><i>const</i> mission =</span>
					<p>"{MISSION}"</p>
				</article>
				<article class="ba-mvv-card bb-rev" style="--i:1" data-fa-tilt="8">
					<span class="bb-glare" aria-hidden="true"></span>
					<span class="ba-mvv-key"><i>const</i> vision =</span>
					<p>"{VISION}"</p>
				</article>
				<article class="ba-mvv-card bb-rev" style="--i:2" data-fa-tilt="8">
					<span class="bb-glare" aria-hidden="true"></span>
					<span class="ba-mvv-key"><i>const</i> coreValues = [</span>
					<span class="ba-mvv-vals">
						{
							CORE_VALUES.map((v, i) => (
								<>
									<i>'{v.name.toLowerCase().replace(/ /g, '-')}'</i>
									{i < CORE_VALUES.length - 1 ? ',' : ''}
								</>
							))
						}
					</span>
					<span class="ba-mvv-key">]</span>
				</article>
			</div>
		</div>
	</section>

	<!-- ── 03 · modules — what we do ───────────────────────── -->
	<section class="ba-sec" data-cursor="pkg">
		<div class="ba-wrap">
			<div class="ba-head bb-rev">
				<span class="ba-kick">$ npm i @swizel/*</span>
				<h2 class="ba-h">Everything under <span class="ba-acc">one install.</span></h2>
			</div>
			<div class="ba-pkgs">
				{
					pkgs.map((p, i) => (
						<a href="/services" class="ba-pkg bb-rev" style={`--i:${i % 3}`} data-fa-tilt="9">
							<span class="bb-glare" aria-hidden="true" />
							<span class="ba-pkg-top">
								<span class="ba-pkg-ic"><Icon width={19} name={p.icon} /></span>
								<strong>{p.name}</strong>
							</span>
							<p>{p.desc}</p>
							<span class="ba-pkg-tags">
								{p.tags.map((t) => <i>{t}</i>)}
							</span>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<!-- ── 04 · git log — the road, as release tags ────────── -->
	<section class="ba-sec" data-cursor="branch">
		<div class="ba-wrap">
			<div class="ba-head bb-rev">
				<span class="ba-kick">$ git log --tags</span>
				<h2 class="ba-h">Seven years, <span class="ba-acc">tagged.</span></h2>
			</div>
			<ol class="bb-git ba-git" id="bb-git">
				<span class="bb-git-line" aria-hidden="true"></span>
				{
					releases.map((r) => (
						<li class="ba-rel bb-rev">
							<span class="bb-node ba-node" aria-hidden="true" />
							<div class="ba-rel-card">
								<div class="ba-rel-top">
									<span class="ba-hash">{r.hash}</span>
									<span class="ba-tag">{r.tag}</span>
									<strong>{r.title}</strong>
								</div>
								<p>{r.desc}</p>
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<!-- ── 05 · CONTRIBUTORS — clickable crew ──────────────── -->
	<section class="ba-sec" data-cursor="repo">
		<div class="ba-wrap">
			<div class="ba-head bb-rev">
				<span class="ba-kick">// CONTRIBUTORS.md</span>
				<h2 class="ba-h">The humans behind <span class="ba-acc">the commits.</span></h2>
				<p class="ba-p ba-p--center">
					Twenty-five specialists strong. Tap any contributor for the
					full profile.
				</p>
			</div>
			<ul class="ba-team">
				{
					team.map((t, i) => (
						<li>
							<button
								type="button"
								class="ba-mate bb-rev"
								style={`--i:${i % 4}`}
								data-fa-tilt="12"
								data-fa-member
								data-name={t.name}
								data-role={t.role}
								data-bio={t.bio}
								data-linkedin={t.linkedin}
								data-exp={JSON.stringify(t.experience)}
								aria-label={`View ${t.name}'s profile`}
							>
								<span class="bb-glare" aria-hidden="true" />
								<span class="ba-mate-photo">
									<img src={`/teammates/${t.name}.jpg`} alt={t.name} loading="lazy" width="200" height="200" />
								</span>
								<strong>{t.name}</strong>
								<em>{t.role}</em>
								<span class="ba-mate-view">
									view profile
									<Icon width={12} name="mdi:arrow-top-right" />
								</span>
							</button>
						</li>
					))
				}
			</ul>
			<div class="ba-join bb-rev">
				<span><b>We're always hiring builders.</b> Designers, engineers and marketers, come build real products with us.</span>
				<a href="/contact" class="ba-link">
					Open a PR on the team
					<Icon width={15} name="mdi:arrow-right" />
				</a>
			</div>
		</div>
	</section>

	<!-- Team profile modal (same contract as the founder About) -->
	<div class="fa-member-modal ba-modal" hidden>
		<div class="ba-modal-overlay" data-fa-modal-close></div>
		<div class="ba-modal-card" role="dialog" aria-modal="true">
			<button type="button" class="ba-modal-x" data-fa-modal-close aria-label="Close">
				<Icon width={20} name="mdi:close" />
			</button>
			<div class="ba-modal-body">
				<div class="ba-modal-side">
					<div class="ba-modal-photo"><img id="fa-modal-photo" alt="" /></div>
					<h3 class="ba-modal-name" id="fa-modal-name"></h3>
					<p class="ba-modal-role" id="fa-modal-role"></p>
					<a class="ba-modal-linkedin" id="fa-modal-linkedin" href="#" target="_blank" rel="noopener noreferrer" hidden>
						<Icon width={18} name="linkedin" />
						Connect on LinkedIn
					</a>
				</div>
				<div class="ba-modal-main">
					<span class="ba-kick">// bio</span>
					<p class="ba-modal-bio" id="fa-modal-bio"></p>
					<div id="fa-modal-exp-wrap" hidden>
						<span class="ba-kick">// experience</span>
						<ul class="ba-modal-exp" id="fa-modal-exp"></ul>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- ── 06 · assets/ — the studio in frames ─────────────── -->
	<section class="ba-sec" data-cursor="repo">
		<div class="ba-wrap ba-assets">
			<div class="ba-asset ba-asset--video bb-rev" data-fa-tilt="5">
				<span class="bb-glare" aria-hidden="true"></span>
				<span class="ba-sheen" aria-hidden="true"></span>
				<Icon width={32} name="mdi:play-circle-outline" />
				<span class="ba-asset-name">assets/a-day-at-the-studio.webm</span>
				<span class="ba-asset-sub">Video placeholder — one room, one standard, a lot of coffee</span>
			</div>
			<div class="ba-asset bb-rev" style="--i:1" data-fa-tilt="5">
				<span class="bb-glare" aria-hidden="true"></span>
				<span class="ba-sheen" aria-hidden="true"></span>
				<Icon width={24} name="mdi:image-outline" />
				<span class="ba-asset-name">assets/training-in-session.jpg</span>
				<span class="ba-asset-sub">Education at heart — free training + The Brevarium</span>
				<a href="#ba-brevarium" class="ba-link">Read The Brevarium <Icon width={14} name="mdi:chevron-right" /></a>
			</div>
		</div>
	</section>

	<!-- ── 07 · docs/ — The Brevarium ──────────────────────── -->
	<section class="ba-sec" data-cursor="repo" id="ba-brevarium">
		<div class="ba-wrap">
			<div class="ba-brev bb-rev" data-fa-tilt="4">
				<span class="bb-glare" aria-hidden="true"></span>
				<div class="ba-brev-cover">
					<img src="/images/brevarium-cover.jpg" alt="The Brevarium by Swizel — latest edition" loading="lazy" />
				</div>
				<div class="ba-brev-copy">
					<span class="ba-kick">// docs/the-brevarium</span>
					<h2 class="ba-h">Our magazine. <span class="ba-acc">Open source.</span></h2>
					<p class="ba-p">
						Ideas, builds and lessons from the front line of African tech.
						Every edition free to read, cover to cover.
					</p>
					<ul class="ba-brev-eds">
						{
							brevariumEditions.map((ed) => (
								<li>
									<a href={ed.href} download class="ba-brev-ed">
										<Icon width={16} name="mdi:file-document-outline" />
										<strong>the-brevarium&nbsp;<i>{ed.vol}</i></strong>
										<em>{ed.date}</em>
										<Icon width={15} name="mdi:download" />
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</div>
	</section>

	<!-- ── 08 · reviews as approvals ───────────────────────── -->
	<section class="ba-sec" data-cursor="quote">
		<div class="ba-wrap">
			<div class="ba-head bb-rev">
				<span class="ba-kick">// code_review</span>
				<h2 class="ba-h">Approved by <span class="ba-acc">the people who matter.</span></h2>
			</div>
			<div class="ba-prs">
				{
					quotes.map((r, i) => (
						<article class="ba-pr bb-rev" style={`--i:${i}`} data-fa-tilt="8">
							<span class="bb-glare" aria-hidden="true" />
							<div class="ba-pr-top">
								<img src={r.img} alt="" loading="lazy" />
								<span class="ba-pr-who">
									<strong>{r.name}</strong>
									<em>approved these changes</em>
								</span>
								<span class="ba-pr-badge">
									<Icon width={13} name="mdi:check-bold" />
									Approved
								</span>
							</div>
							<p>“{r.body}”</p>
							<span class="ba-pr-files">{r.files}</span>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<!-- ── 09 · CTA ────────────────────────────────────────── -->
	<section class="ba-sec ba-sec--last" data-cursor="phone">
		<div class="ba-cta bb-rev">
			<span class="ba-orbit" aria-hidden="true"><i></i><i></i><i></i></span>
			<p class="ba-cta-cmd">$ git clone swizel/<span class="ba-acc">your-story</span></p>
			<h2 class="ba-h ba-h--xl">Write the next chapter with us.</h2>
			<p class="ba-p ba-p--center">
				Tell us what you're building. A senior engineer reads every
				message, reply within one business day.
			</p>
			<div class="ba-cta-row">
				<a href="/contact" class="ba-merge fs-cta">
					<Icon width={18} name="mdi:source-merge" />
					Start your build
				</a>
				<a href="/portfolio" class="ba-link">
					See the deployments
					<Icon width={15} name="mdi:arrow-right" />
				</a>
			</div>
		</div>
	</section>
</div>

<style>
	/* ── builder tokens (mirrors .bbody) ── */
	.babout {
		--bu-ink: #e8f0f4;
		--bu-muted: rgba(232, 240, 244, 0.62);
		--bu-faint: rgba(232, 240, 244, 0.4);
		--bu-acc: var(--view-accent, #18debe);
		--bu-line: rgba(255, 255, 255, 0.08);
		--bu-card: rgba(255, 255, 255, 0.03);
		--bu-mono: 'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace;
		font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI',
			Roboto, sans-serif;
		position: relative;
		isolation: isolate;
		background:
			radial-gradient(1000px 520px at 85% -4%, rgba(24, 222, 190, 0.1), transparent 60%),
			radial-gradient(800px 480px at 4% 42%, rgba(40, 166, 236, 0.07), transparent 60%),
			linear-gradient(180deg, #05080c 0%, #070d12 50%, #04070a 100%);
		color: var(--bu-ink);
		padding: clamp(3rem, 7vw, 5rem) clamp(1rem, 3vw, 2rem) clamp(2.5rem, 5vw, 4rem);
	}
	:global(html:not(.dark)) .babout {
		--bu-ink: #102420;
		--bu-muted: rgba(16, 36, 32, 0.66);
		--bu-faint: rgba(16, 36, 32, 0.45);
		--bu-line: rgba(16, 36, 32, 0.1);
		--bu-card: rgba(16, 36, 32, 0.04);
		background:
			radial-gradient(1000px 520px at 85% -4%, rgba(24, 222, 190, 0.1), transparent 60%),
			linear-gradient(180deg, #f0faf7 0%, #e6f4ef 55%, #f0faf7 100%);
	}
	.ba-sec { position: relative; z-index: 1; padding-block: clamp(1.8rem, 4.5vw, 3.2rem); }
	.ba-sec--last { padding-bottom: clamp(3rem, 6vw, 4.5rem); }
	.ba-wrap { max-width: 74rem; margin: 0 auto; }

	/* ambient */
	.ba-bg { position: absolute; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
	.ba-orb { position: absolute; border-radius: 50%; filter: blur(70px); opacity: 0.4; animation: ba-orb-drift 17s ease-in-out infinite alternate; }
	.ba-orb--a { width: 440px; height: 440px; left: -150px; top: 6%; background: radial-gradient(circle, rgba(24, 222, 190, 0.28), transparent 70%); }
	.ba-orb--b { width: 500px; height: 500px; right: -170px; top: 46%; background: radial-gradient(circle, rgba(40, 166, 236, 0.18), transparent 70%); animation-delay: -7s; }
	@keyframes ba-orb-drift { to { transform: translate3d(52px, -38px, 0) scale(1.1); } }
	.ba-spark {
		position: absolute; bottom: -12px; left: calc(10% + var(--s) * 12%);
		width: 3.5px; height: 3.5px; border-radius: 50%;
		background: color-mix(in srgb, var(--bu-acc) 85%, #fff);
		box-shadow: 0 0 10px 2px color-mix(in srgb, var(--bu-acc) 55%, transparent);
		opacity: 0;
		animation: ba-rise calc(9s + var(--s) * 1.4s) linear infinite;
		animation-delay: calc(var(--s) * -1.9s);
	}
	@keyframes ba-rise {
		0% { transform: translateY(0); opacity: 0; }
		8% { opacity: 0.75; }
		92% { opacity: 0.2; }
		100% { transform: translateY(-105vh) translateX(24px); opacity: 0; }
	}
	@media (prefers-reduced-motion: reduce) { .ba-orb { animation: none; } .ba-spark { display: none; } }

	/* type */
	.ba-kick { display: block; font-family: var(--bu-mono); font-size: 0.8rem; color: var(--bu-acc); margin-bottom: 0.8rem; }
	:global(html:not(.dark)) .babout .ba-kick { color: #0b8a76; }
