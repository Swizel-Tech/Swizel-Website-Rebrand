	.ba-mvv-key { display: block; font-family: var(--bu-mono); font-size: 0.82rem; color: var(--bu-ink); margin-bottom: 0.4rem; }
	.ba-mvv-key i { font-style: normal; color: #c792ea; margin-right: 0.4rem; }
