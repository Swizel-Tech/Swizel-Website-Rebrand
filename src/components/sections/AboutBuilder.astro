	.ba-brev-ed strong { flex: 1; min-width: 0; font-weight: 700; }
	.ba-brev-ed strong i { font-style: normal; color: var(--bu-acc); }
	.ba-brev-ed em { font-style: normal; font-size: 0.72rem; color: var(--bu-muted); }
	.ba-brev-ed > :global(svg:last-child) { color: var(--bu-acc); }

	/* ── 08 · PRs ── */
	.ba-prs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
	.ba-pr {
		position: relative; overflow: hidden;
		border: 1px solid var(--bu-line); border-radius: 1rem;
		background: var(--bu-card); padding: 1.1rem 1.1rem 1rem;
		transform-style: preserve-3d; will-change: transform;
		transition: border-color 0.3s ease;
	}
	.ba-pr:hover { border-color: color-mix(in srgb, var(--bu-acc) 50%, transparent); }
	.ba-pr-top { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.6rem; }
	.ba-pr-top img { width: 36px; height: 36px; border-radius: 50%; object-fit: cover; }
	.ba-pr-who { flex: 1; min-width: 0; }
	.ba-pr-who strong { display: block; font-size: 0.9rem; font-weight: 800; }
	.ba-pr-who em { display: block; font-style: normal; font-size: 0.72rem; color: var(--bu-muted); }
	.ba-pr-badge {
		display: inline-flex; align-items: center; gap: 0.3rem;
		font-size: 0.68rem; font-weight: 800; letter-spacing: 0.04em;
		color: #2ee889; border: 1px solid rgba(46, 232, 137, 0.4);
