	@keyframes ba-stamp { 0% { transform: scale(2.2) rotate(-14deg); opacity: 0; } 100% { transform: none; opacity: 1; } }
	.ba-pr p { font-size: 0.9rem; line-height: 1.6; color: var(--bu-muted); margin: 0 0 0.6rem; }
	.ba-pr-files { font-family: var(--bu-mono); font-size: 0.72rem; color: var(--bu-faint); }

	/* ── 09 · CTA ── */
	.ba-cta { position: relative; text-align: center; max-width: 46rem; margin: 0 auto; }
	.ba-cta-cmd { font-family: var(--bu-mono); font-size: 0.9rem; color: var(--bu-muted); margin: 0 0 0.8rem; }
	.ba-cta-row { display: flex; align-items: center; justify-content: center; gap: 1.3rem; flex-wrap: wrap; }
	.ba-merge {
