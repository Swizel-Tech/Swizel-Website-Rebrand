	@media (prefers-reduced-motion: reduce) { .ba-sheen { animation: none; } }

	/* ── 07 · brevarium ── */
	.ba-brev {
		position: relative; overflow: hidden;
		display: grid; grid-template-columns: 170px minmax(0, 1fr); gap: clamp(1.2rem, 3vw, 2rem); align-items: center;
		border: 1px solid var(--bu-line); border-radius: 1.1rem;
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.04), transparent 55%), var(--bu-card);
		padding: clamp(1.2rem, 2.6vw, 1.8rem);
		transform-style: preserve-3d; will-change: transform;
	}
	.ba-brev-cover { border-radius: 0.7rem; overflow: hidden; transform: rotate(-2deg); box-shadow: 0 20px 44px -18px rgba(0, 0, 0, 0.65); }
	.ba-brev-cover img { display: block; width: 100%; height: auto; }
	.ba-brev-eds { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
	.ba-brev-ed {
		display: flex; align-items: center; gap: 0.6rem;
		font-family: var(--bu-mono); font-size: 0.82rem;
		padding: 0.55rem 0.8rem; border-radius: 0.7rem;
