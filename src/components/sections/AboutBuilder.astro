	.ba-stats li { flex: 1; min-width: 0; padding: 0.2rem 0.9rem; border-left: 1px solid color-mix(in srgb, var(--bu-acc) 25%, transparent); transition: transform 0.25s ease; }
	.ba-stats li:first-child { padding-left: 0; border-left: 0; }
	.ba-stats li:hover { transform: translateY(-3px); }
	.ba-stats strong {
		display: block; font-family: var(--bu-mono); font-weight: 700; white-space: nowrap;
		font-size: clamp(1.25rem, 2.2vw, 1.7rem);
		background: linear-gradient(135deg, #8dfeea, var(--bu-acc));
		-webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
	}
	:global(html:not(.dark)) .babout .ba-stats strong { background: linear-gradient(135deg, #0b8a76, #0d7fb8); -webkit-background-clip: text; background-clip: text; }
	.ba-stats span { display: block; font-size: 0.72rem; line-height: 1.3; color: var(--bu-muted); margin-top: 0.2rem; }

	/* windows */
	.ba-win {
