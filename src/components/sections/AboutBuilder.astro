	.ba-pkg-tags i {
		font-style: normal; font-family: var(--bu-mono); font-size: 0.68rem;
		padding: 0.22rem 0.55rem; border-radius: 999px;
		border: 1px solid color-mix(in srgb, var(--bu-acc) 35%, transparent);
		color: var(--bu-acc);
	}
	:global(html:not(.dark)) .babout .ba-pkg-tags i { color: #0b8a76; }

	/* ── 04 · git tags (reuses the builder draw engine) ── */
	.bb-git { position: relative; }
	.ba-git { list-style: none; margin: 0 auto; padding: 0 0 0 2.2rem; max-width: 46rem; }
	.bb-git-line {
		position: absolute; left: 7px; top: 0.6rem; bottom: 0.6rem; width: 2.5px; border-radius: 2px;
		background: linear-gradient(180deg, #8dfeea, var(--bu-acc), #28a6ec);
		box-shadow: 0 0 12px color-mix(in srgb, var(--bu-acc) 55%, transparent);
		transform: scaleY(0); transform-origin: top;
		transition: transform 2.2s cubic-bezier(0.22, 1, 0.36, 1) 0.2s;
	}
	.bb-git.is-drawn .bb-git-line { transform: scaleY(1); }
	.ba-node {
		position: absolute; left: -2.2rem; top: 0.55rem;
		width: 0.95rem; height: 0.95rem; border-radius: 50%;
		background: linear-gradient(135deg, #8dfeea, var(--bu-acc));
		box-shadow: 0 0 0 4px color-mix(in srgb, var(--bu-acc) 20%, transparent);
	}
	.ba-node::after {
		content: '';
		position: absolute; inset: -5px; border-radius: 9999px;
		border: 2px solid color-mix(in srgb, var(--bu-acc) 45%, transparent);
		animation: ba-node-pulse 2.6s ease-out infinite;
	}
	@keyframes ba-node-pulse {
		0% { transform: scale(0.6); opacity: 1; }
		70%, 100% { transform: scale(1.5); opacity: 0; }
	}
	@media (prefers-reduced-motion: reduce) { .ba-node::after { animation: none; opacity: 0; } }
	.ba-rel { position: relative; padding-bottom: 1.5rem; }
	.ba-rel:last-child { padding-bottom: 0; }
	.ba-rel-top { display: flex; align-items: baseline; gap: 0.6rem; flex-wrap: wrap; }
	.ba-hash { font-family: var(--bu-mono); font-size: 0.74rem; color: var(--bu-faint); }
	.ba-tag {
		font-family: var(--bu-mono); font-size: 0.7rem; font-weight: 700;
		padding: 0.14rem 0.5rem; border-radius: 999px;
		border: 1px solid color-mix(in srgb, var(--bu-acc) 45%, transparent);
		color: var(--bu-acc);
	}
	:global(html:not(.dark)) .babout .ba-tag { color: #0b8a76; }
	.ba-rel-top strong { font-size: 1.02rem; font-weight: 800; }
	.ba-rel p { font-size: 0.9rem; line-height: 1.6; color: var(--bu-muted); margin: 0.3rem 0 0; max-width: 38rem; }

	/* ── 05 · contributors ── */
	.ba-team { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; list-style: none; margin: 0; padding: 0; align-items: stretch; }
	.ba-mate {
		position: relative; overflow: hidden; width: 100%; height: 100%; text-align: center; cursor: pointer;
		border: 1px solid var(--bu-line); border-radius: 1rem;
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.04), transparent 55%), var(--bu-card);
		padding: 1.2rem 0.8rem 1.1rem; color: var(--bu-ink);
		transform-style: preserve-3d; will-change: transform;
		transition: border-color 0.3s ease, box-shadow 0.3s ease;
	}
	.ba-mate:hover { border-color: color-mix(in srgb, var(--bu-acc) 55%, transparent); box-shadow: 0 22px 46px -22px color-mix(in srgb, var(--bu-acc) 55%, transparent); }
	.ba-mate-photo {
		display: block; width: 84px; height: 84px; margin: 0 auto 0.7rem;
		border-radius: 50%; overflow: hidden;
		border: 2px solid color-mix(in srgb, var(--bu-acc) 45%, transparent);
	}
	.ba-mate-photo img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.4s ease; }
	.ba-mate:hover .ba-mate-photo img { transform: scale(1.1); }
	.ba-mate strong { display: block; font-size: 0.95rem; font-weight: 800; }
	.ba-mate em { display: block; font-style: normal; font-size: 0.76rem; color: var(--bu-muted); margin-top: 0.12rem; }
	.ba-mate-view {
		display: inline-flex; align-items: center; gap: 0.3rem; margin-top: 0.55rem;
		font-family: var(--bu-mono); font-size: 0.68rem; color: var(--bu-acc);
		opacity: 0.55; transition: opacity 0.25s ease, gap 0.25s ease;
	}
	.ba-mate:hover .ba-mate-view { opacity: 1; gap: 0.5rem; }
	:global(html:not(.dark)) .babout .ba-mate-view { color: #0b8a76; }
	.ba-join {
		display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
		margin-top: 1.4rem; padding: 1rem 1.3rem;
		border: 1px dashed color-mix(in srgb, var(--bu-acc) 45%, transparent);
		border-radius: 1rem; background: var(--bu-card);
		font-size: 0.92rem; color: var(--bu-muted);
	}
	.ba-join b { color: var(--bu-ink); }

	/* modal — dark IDE styling */
	.ba-modal { position: fixed; inset: 0; z-index: 90; display: grid; place-items: center; padding: 1.2rem; }
	.ba-modal[hidden] { display: none; }
	.ba-modal-overlay {
		position: absolute; inset: 0; background: rgba(3, 8, 10, 0.72);
		backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
		opacity: 0; transition: opacity 0.25s ease; cursor: pointer;
	}
	.ba-modal-card {
		position: relative; width: min(46rem, 100%); max-height: min(86vh, 86dvh); overflow: auto;
		border-radius: 1.1rem;
		border: 1px solid color-mix(in srgb, var(--bu-acc) 35%, rgba(255, 255, 255, 0.12));
		background: linear-gradient(180deg, #0d141c, #080d13);
		color: #e8f0f4; padding: 1.7rem;
		transform: translateY(22px) scale(0.97); opacity: 0;
		transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.3s ease;
		box-shadow: 0 50px 120px -40px rgba(0, 0, 0, 0.9);
	}
	.ba-modal.is-open .ba-modal-overlay { opacity: 1; }
	.ba-modal.is-open .ba-modal-card { transform: none; opacity: 1; }
	.ba-modal-x {
		position: sticky; top: 0; float: right;
		display: grid; place-items: center; width: 38px; height: 38px; border-radius: 999px;
		border: 1px solid rgba(255, 255, 255, 0.16); background: rgba(255, 255, 255, 0.06);
		color: #fff; cursor: pointer; z-index: 2;
		transition: transform 0.2s ease, background 0.2s ease;
	}
	.ba-modal-x:hover { transform: rotate(90deg); background: rgba(255, 255, 255, 0.14); }
	.ba-modal-body { display: grid; grid-template-columns: 190px minmax(0, 1fr); gap: 1.5rem; }
	.ba-modal-photo {
		width: 140px; height: 140px; border-radius: 50%; overflow: hidden;
		border: 3px solid color-mix(in srgb, var(--bu-acc) 55%, transparent);
	}
	.ba-modal-photo img { width: 100%; height: 100%; object-fit: cover; }
	.ba-modal-name { font-size: 1.3rem; font-weight: 850; margin: 0.9rem 0 0.1rem; }
	.ba-modal-role { font-family: var(--bu-mono); font-size: 0.8rem; color: rgba(232, 240, 244, 0.6); margin: 0; }
	.ba-modal-linkedin { display: inline-flex; align-items: center; gap: 0.45rem; margin-top: 0.9rem; font-size: 0.85rem; font-weight: 700; color: var(--bu-acc); }
	.ba-modal-bio { font-size: 0.95rem; line-height: 1.7; color: rgba(232, 240, 244, 0.75); margin: 0.4rem 0 1.1rem; }
	.ba-modal-exp { list-style: none; margin: 0.4rem 0 0; padding: 0; display: grid; gap: 0.55rem; }
	.ba-modal-exp :global(li) {
		border: 1px solid rgba(255, 255, 255, 0.09); border-radius: 0.7rem;
		background: rgba(255, 255, 255, 0.035); padding: 0.65rem 0.85rem;
	}
	.ba-modal-exp :global(strong) { display: block; font-size: 0.9rem; font-weight: 800; }
	.ba-modal-exp :global(em) { display: block; font-style: normal; font-size: 0.8rem; color: rgba(232, 240, 244, 0.6); margin-top: 0.1rem; }

	/* ── 06 · assets ── */
	.ba-assets { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: 1rem; }
	.ba-asset {
		position: relative; overflow: hidden;
		display: grid; place-content: center; justify-items: center; gap: 0.35rem;
		min-height: 220px; text-align: center; padding: 1.4rem;
		border: 1.5px dashed color-mix(in srgb, var(--bu-acc) 40%, transparent);
		border-radius: 1rem; background: color-mix(in srgb, var(--bu-acc) 6%, transparent);
		color: var(--bu-acc);
		transform-style: preserve-3d; will-change: transform;
	}
	.ba-asset-name { font-family: var(--bu-mono); font-size: 0.82rem; font-weight: 700; }
	.ba-asset-sub { font-size: 0.8rem; color: var(--bu-muted); max-width: 24rem; }
	.ba-sheen {
		position: absolute; inset: 0;
		background: linear-gradient(115deg, transparent 42%, rgba(255, 255, 255, 0.07) 50%, transparent 60%);
