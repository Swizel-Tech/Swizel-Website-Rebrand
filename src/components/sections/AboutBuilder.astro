		padding: 0.6rem 1.2rem; border-top: 1px solid rgba(255, 255, 255, 0.06);
		font-family: var(--bu-mono); font-size: 0.72rem; color: rgba(232, 240, 244, 0.5);
	}
	.ba-live { width: 8px; height: 8px; border-radius: 50%; background: #28c840; animation: ba-live 2s ease-in-out infinite; }
	@keyframes ba-live { 0%, 100% { box-shadow: 0 0 0 0 rgba(40, 200, 64, 0.5); } 50% { box-shadow: 0 0 0 5px rgba(40, 200, 64, 0); } }

	/* ── 02 · mvv ── */
	.ba-mvv { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
	.ba-mvv-card {
		position: relative; overflow: hidden;
		border: 1px solid var(--bu-line); border-radius: 1rem;
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.04), transparent 55%), var(--bu-card);
