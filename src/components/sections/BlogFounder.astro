---
// Blog index · Founder world — the same journal as the Boardroom blog
// (featured lead, CSS category filter, all posts, newsletter, Brevarium
// promo) with founder momentum. Root carries `fbody` (reveals/counters)
// and `fbl` (tilt + magnetic CTAs via aboutFounder.ts).
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';

interface Props { posts: CollectionEntry<'blog'>[]; }
const { posts } = Astro.props;

const featured = posts.find((p) => p.data.featured) ?? posts[0];
const rest = posts;
const cats = [...new Set(posts.map((p) => p.data.category))];
const catSlug = (c: string) => c.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const catCount = (c: string) => posts.filter((p) => p.data.category === c).length;
const readTime = (body: string) => Math.max(1, Math.round((body?.trim().split(/\s+/).length || 0) / 200));
const fmtDate = (d: Date) => new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const catColor: Record<string, string> = { EdTech: '#2bb3c0', Fintech: '#6366f1', Marketing: '#ec4899', Technology: '#8b5cf6', Insights: '#a78bfa' };
const col = (c: string) => catColor[c] ?? '#8b5cf6';

// CSS-only category filter (fbl-* ids so they never clash with boardroom's)
const filterCss = cats
	.map((c) => {
		const s = catSlug(c);
		const cc = col(c);
		return [
			`#fbl-${s}:checked ~ .fb-grid .fb-card:not(.c-${s}){display:none}`,
			`#fbl-${s}:checked ~ .fb-chips label[for="fbl-${s}"]{color:#fff;background:${cc};border-color:transparent;box-shadow:0 12px 26px -12px ${cc}}`,
			`#fbl-${s}:checked ~ .fb-chips label[for="fbl-${s}"] span{color:#fff}`,
		].join('');
	})
	.join('');
---

<div class="fbl fbody view-body view-body-founder">
	<div class="fb-bg" aria-hidden="true">
		<span class="fb-orb fb-orb--a"></span>
		<span class="fb-orb fb-orb--b"></span>
		{Array.from({ length: 7 }).map((_, i) => (
			<i class="fb-spark" style={`--s:${i}`}></i>
		))}
	</div>

	<!-- ── hero ── -->
	<section class="fb-sec">
		<div class="fb-wrap fb-hero fd-rev">
			<span class="fb-stamp">The journal · Founder mode</span>
			<h2 class="fb-h fb-h--xl">Ideas worth <em>building.</em></h2>
			<p class="fb-p fb-p--center">
				Field notes on technology, design, fintech, edtech and growth.
				What we're building, learning and seeing across the African
				digital landscape.
			</p>
		</div>
	</section>

	<!-- ── featured ── -->
	{
		featured && (
			<section class="fb-sec">
				<div class="fb-wrap">
					<a
						href={`/blog/${featured.slug}`}
						class="fb-feature fd-rev"
						style={`--c:${col(featured.data.category)}`}
						data-cursor="book"
						data-fa-tilt="5"
					>
						<span class="fa-val-glare" aria-hidden="true" />
						<span class="fb-feature-media">
							<img src={featured.data.heroImage} alt={featured.data.title} loading="eager" />
						</span>
						<span class="fb-feature-body">
							<span class="fb-feature-tag">Featured · {featured.data.category}</span>
							<strong class="fb-feature-title">{featured.data.title}</strong>
							<span class="fb-feature-desc">{featured.data.description}</span>
							<span class="fb-meta">
								{featured.data.author} • {fmtDate(featured.data.pubDate)} • {readTime(featured.body)} min read
							</span>
							<span class="fb-link">
								Read the article
								<Icon width={15} name="mdi:arrow-right" />
							</span>
						</span>
					</a>
				</div>
			</section>
		)
	}

	<!-- ── all posts, category filter ── -->
	<section class="fb-sec" data-cursor="repo">
		<div class="fb-wrap">
			<div class="fb-head fd-rev">
				<span class="fb-stamp">Latest writing</span>
				<h2 class="fb-h">From the <em>journal.</em></h2>
				<p class="fb-p fb-p--center">
					{posts.length} {posts.length === 1 ? 'article' : 'articles'},
					more on the way. Filter by topic.
				</p>
			</div>

			<form class="fb-filter" autocomplete="off">
				<input class="fb-radio" type="radio" name="fbl" id="fbl-all" checked />
				{cats.map((c) => <input class="fb-radio" type="radio" name="fbl" id={`fbl-${catSlug(c)}`} />)}
				<div class="fb-chips fd-rev">
					<label class="fb-chip" for="fbl-all">All <span>{posts.length}</span></label>
					{
						cats.map((c) => (
							<label class="fb-chip" for={`fbl-${catSlug(c)}`}>
								{c} <span>{catCount(c)}</span>
							</label>
						))
					}
				</div>
				<div class="fb-grid">
					{
						rest.map((p, i) => (
							<article
								class:list={['fb-card', 'fd-rev', `c-${catSlug(p.data.category)}`]}
								style={`--c:${col(p.data.category)}; --i:${i % 3}`}
								data-cursor="book"
								data-fa-tilt="8"
							>
								<a href={`/blog/${p.slug}`} class="fb-card-link">
									<span class="fa-val-glare" aria-hidden="true" />
									<span class="fb-card-media">
										<img src={p.data.heroImage} alt={p.data.title} loading="lazy" />
										<span class="fb-card-cat">{p.data.category}</span>
									</span>
									<span class="fb-card-body">
										<strong class="fb-card-title">{p.data.title}</strong>
										<span class="fb-card-desc">{p.data.description}</span>
										<span class="fb-meta">
											{fmtDate(p.data.pubDate)} • {readTime(p.body)} min read
										</span>
									</span>
								</a>
							</article>
						))
					}
				</div>
			</form>
		</div>
	</section>

	<!-- ── newsletter ── -->
	<section class="fb-sec" data-cursor="phone">
		<div class="fb-wrap">
			<div class="fb-news fd-rev">
				<span class="fa-cta-orbit fb-orbit" aria-hidden="true">
					<i></i><i></i><i></i>
				</span>
				<span class="fb-stamp">Stay in the loop</span>
				<h2 class="fb-h">Get the next one <em>in your inbox.</em></h2>
				<p class="fb-p fb-p--center">
					No spam, no fluff. Just our sharpest thinking on building for
					the African market, when it's worth your time.
				</p>
				<form class="fb-news-form" name="newsletter" method="post" data-netlify="true" netlify-honeypot="bot-field">
					<input type="hidden" name="form-name" value="newsletter" />
					<p class="fb-hp"><label>Don't fill this out: <input name="bot-field" /></label></p>
					<input class="fb-news-input" type="email" name="email" placeholder="you@company.com" required aria-label="Email address" />
					<button class="fb-news-btn fs-cta" type="submit">
						Subscribe
						<Icon width={16} name="mdi:arrow-right" />
					</button>
				</form>
			</div>
		</div>
	</section>

	<!-- ── Brevarium cross-promo ── -->
	<section class="fb-sec fb-sec--last" data-cursor="repo">
		<div class="fb-wrap">
			<a class="fb-mag fd-rev" href="/brevarium/the-brevarium-latest.pdf" download data-fa-tilt="7">
				<span class="fb-mag-cover">
					<img src="/images/portfolio/mag-latest-cover.jpg" alt="The Brevarium magazine" loading="lazy" />
				</span>
				<span class="fb-mag-meta">
					<span class="fb-stamp fb-stamp--sm">Long-form, in print</span>
					<strong>Prefer the magazine? Read The Brevarium.</strong>
					<em>Our featured projects, the team and the thinking behind the work, cover to cover.</em>
					<span class="fb-link"><Icon width={16} name="mdi:download" /> Download the latest edition</span>
				</span>
			</a>
		</div>
	</section>
</div>

<style is:global set:html={filterCss}></style>

<style>
	.fbl {
		--fa-ink: #f1edfb;
		--fa-muted: rgba(241, 237, 251, 0.62);
		--fa-acc: var(--view-accent, #8b5cf6);
		--fa-acc2: #ec4899;
		--fa-line: rgba(255, 255, 255, 0.09);
		--fa-card: rgba(255, 255, 255, 0.035);
		font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI',
			Roboto, sans-serif;
		position: relative;
		isolation: isolate;
		background:
			radial-gradient(1000px 540px at 82% -6%, rgba(139, 92, 246, 0.16), transparent 62%),
			radial-gradient(820px 480px at 6% 44%, rgba(236, 72, 153, 0.08), transparent 60%),
			linear-gradient(180deg, #0a0714 0%, #0d0a18 50%, #080610 100%);
		color: var(--fa-ink);
		padding: clamp(3rem, 7vw, 5rem) clamp(1rem, 3vw, 2rem) clamp(2.5rem, 5vw, 4rem);
	}
	:global(html:not(.dark)) .fbl {
		--fa-ink: #1d1430;
		--fa-muted: rgba(29, 20, 48, 0.66);
		--fa-acc: #6d3fe0;
		--fa-line: rgba(29, 20, 48, 0.1);
		--fa-card: rgba(29, 20, 48, 0.04);
		background:
			radial-gradient(1000px 540px at 82% -6%, rgba(139, 92, 246, 0.12), transparent 62%),
			linear-gradient(180deg, #f4f1fb 0%, #ece7f8 55%, #f4f1fb 100%);
	}
	.fb-sec { position: relative; z-index: 1; padding-block: clamp(1.6rem, 4vw, 2.8rem); }
	.fb-sec--last { padding-bottom: clamp(3rem, 6vw, 4.5rem); }
	.fb-wrap { max-width: 74rem; margin: 0 auto; }

	.fb-bg { position: absolute; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
	.fb-orb { position: absolute; border-radius: 50%; filter: blur(70px); opacity: 0.5; animation: fb-drift 16s ease-in-out infinite alternate; }
	.fb-orb--a { width: 460px; height: 460px; left: -140px; top: 4%; background: radial-gradient(circle, rgba(139, 92, 246, 0.3), transparent 70%); }
	.fb-orb--b { width: 500px; height: 500px; right: -180px; top: 40%; background: radial-gradient(circle, rgba(236, 72, 153, 0.16), transparent 70%); animation-delay: -6s; }
	@keyframes fb-drift { to { transform: translate3d(60px, -44px, 0) scale(1.12); } }
	.fb-spark {
		position: absolute; bottom: -12px; left: calc(9% + var(--s) * 12%);
		width: 4px; height: 4px; border-radius: 50%;
		background: color-mix(in srgb, var(--fa-acc) 85%, #fff);
		box-shadow: 0 0 10px 2px color-mix(in srgb, var(--fa-acc) 55%, transparent);
		opacity: 0;
		animation: fb-rise calc(9s + var(--s) * 1.4s) linear infinite;
		animation-delay: calc(var(--s) * -2s);
	}
	@keyframes fb-rise {
		0% { transform: translateY(0); opacity: 0; }
		8% { opacity: 0.8; }
		92% { opacity: 0.25; }
		100% { transform: translateY(-105vh) translateX(28px); opacity: 0; }
	}
	@media (prefers-reduced-motion: reduce) { .fb-orb { animation: none; } .fb-spark { display: none; } }

	.fb-stamp {
		display: inline-block; font-size: 0.72rem; font-weight: 800;
		letter-spacing: 0.14em; text-transform: uppercase; color: var(--fa-acc);
		border: 1.5px dashed color-mix(in srgb, var(--fa-acc) 55%, transparent);
		padding: 0.35rem 0.8rem; border-radius: 0.5rem; transform: rotate(-2deg);
		margin-bottom: 1rem;
	}
	.fb-stamp--sm { font-size: 0.62rem; padding: 0.26rem 0.6rem; margin-bottom: 0.5rem; }
	:global(html:not(.dark)) .fbl .fb-stamp { color: #5d34c4; }
	.fb-h { font-size: clamp(1.9rem, 4.2vw, 3rem); font-weight: 850; letter-spacing: -0.025em; line-height: 1.06; margin: 0 0 1rem; }
	.fb-h--xl { font-size: clamp(2.2rem, 4.4vw, 3.4rem); }
	.fb-h em {
		font-style: italic;
		background: linear-gradient(95deg, var(--fa-acc), var(--fa-acc2), var(--fa-acc));
		background-size: 220% 100%;
		-webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
		padding-right: 0.06em;
		animation: fb-shimmer 5.5s ease-in-out infinite;
	}
	@keyframes fb-shimmer { 0%, 100% { background-position: 0% 0; } 50% { background-position: 100% 0; } }
	:global(html:not(.dark)) .fbl .fb-h em { background: linear-gradient(95deg, #5d34c4, #b81d68, #5d34c4); background-size: 220% 100%; -webkit-background-clip: text; background-clip: text; }
	.fb-p { font-size: 1rem; line-height: 1.65; color: var(--fa-muted); max-width: 36rem; margin: 0 0 1.2rem; }
	.fb-p--center { margin-inline: auto; text-align: center; }
	.fb-head { text-align: center; max-width: 46rem; margin: 0 auto clamp(1.4rem, 3vw, 2rem); }
	.fb-hero { text-align: center; max-width: 50rem; }
	.fb-link { display: inline-flex; align-items: center; gap: 0.45rem; font-weight: 700; color: var(--fa-acc); transition: gap 0.25s ease; }
	.fb-link:hover { gap: 0.75rem; }
	:global(html:not(.dark)) .fbl .fb-link { color: #5d34c4; }
	.fb-meta { display: block; font-size: 0.78rem; color: var(--fa-muted); }

	.fd-rev {
		opacity: 0; transform: translateY(22px);
		transition: opacity 0.6s ease calc(var(--i, 0) * 90ms),
			transform 0.6s cubic-bezier(0.22, 1, 0.36, 1) calc(var(--i, 0) * 90ms);
	}
	.fd-rev.is-on { opacity: 1; transform: none; }
	@media (prefers-reduced-motion: reduce) { .fd-rev { opacity: 1; transform: none; transition: none; } }
	.fa-val-glare {
		position: absolute; inset: 0;
		background: radial-gradient(340px 220px at var(--gx, 50%) var(--gy, 0%), rgba(255, 255, 255, 0.09), transparent 60%);
		opacity: 0; transition: opacity 0.3s ease; pointer-events: none;
	}
	:is(.fb-feature, .fb-card-link):hover .fa-val-glare { opacity: 1; }
	.fa-cta-orbit { position: absolute; inset: 0; pointer-events: none; }

	/* featured */
	.fb-feature {
		position: relative; overflow: hidden;
		display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
		gap: clamp(1.2rem, 2.6vw, 2rem); align-items: center;
		border: 1px solid color-mix(in srgb, var(--c, #8b5cf6) 35%, rgba(255, 255, 255, 0.1));
		border-radius: 1.4rem;
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.045), transparent 55%),
			radial-gradient(120% 90% at 85% -20%, color-mix(in srgb, var(--c, #8b5cf6) 12%, transparent), transparent 60%),
			var(--fa-card);
		padding: clamp(1.1rem, 2.4vw, 1.8rem);
		color: var(--fa-ink);
		transform-style: preserve-3d; will-change: transform;
		transition: border-color 0.3s ease;
	}
	.fb-feature:hover { border-color: color-mix(in srgb, var(--c) 60%, transparent); }
	.fb-feature-media { display: block; border-radius: 1rem; overflow: hidden; }
	.fb-feature-media img { display: block; width: 100%; height: 280px; object-fit: cover; transition: transform 0.5s ease; }
	.fb-feature:hover .fb-feature-media img { transform: scale(1.05); }
	.fb-feature-tag {
		display: inline-block; font-size: 0.66rem; font-weight: 800; letter-spacing: 0.1em;
		text-transform: uppercase; color: #fff;
		background: linear-gradient(95deg, var(--c), var(--fa-acc2));
		padding: 0.3rem 0.7rem; border-radius: 999px; margin-bottom: 0.7rem;
	}
	.fb-feature-title { display: block; font-size: clamp(1.3rem, 2.6vw, 1.8rem); font-weight: 850; line-height: 1.2; margin-bottom: 0.5rem; }
	.fb-feature-desc {
		display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
		font-size: 0.94rem; line-height: 1.6; color: var(--fa-muted); margin-bottom: 0.7rem;
	}
	.fb-feature .fb-meta { margin-bottom: 0.9rem; }

	/* filter + grid */
	.fb-filter { position: relative; }
	.fb-radio { position: absolute; opacity: 0; pointer-events: none; }
	.fb-chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem; margin-bottom: 1.5rem; }
	.fb-chip {
		display: inline-flex; align-items: center; gap: 0.45rem;
		font-size: 0.85rem; font-weight: 700; cursor: pointer;
		padding: 0.5rem 0.95rem; border-radius: 999px;
		border: 1px solid var(--fa-line); background: var(--fa-card);
		color: var(--fa-muted);
		transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
	}
	.fb-chip:hover { transform: translateY(-2px); color: var(--fa-ink); }
	.fb-chip span { font-size: 0.68rem; font-weight: 800; color: var(--fa-acc); }
	#fbl-all:checked ~ .fb-chips [for='fbl-all'] {
		color: #fff;
		background: linear-gradient(95deg, var(--fa-acc), var(--fa-acc2));
		border-color: transparent;
	}
	#fbl-all:checked ~ .fb-chips [for='fbl-all'] span { color: #fff; }
	#fbl-all:checked ~ .fb-grid .fb-card { display: block; }

	.fb-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
	.fb-card { display: block; }
	.fb-card-link {
		position: relative; overflow: hidden; display: block; height: 100%;
		border: 1px solid var(--fa-line); border-radius: 1.1rem;
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.045), transparent 55%),
			var(--fa-card);
		color: var(--fa-ink);
		transform-style: preserve-3d; will-change: transform;
		transition: border-color 0.3s ease, box-shadow 0.3s ease;
	}
	.fb-card:hover .fb-card-link {
		border-color: color-mix(in srgb, var(--c, #8b5cf6) 55%, transparent);
		box-shadow: 0 24px 50px -24px color-mix(in srgb, var(--c, #8b5cf6) 60%, transparent);
	}
	.fb-card-media { position: relative; display: block; overflow: hidden; }
	.fb-card-media img { display: block; width: 100%; height: 170px; object-fit: cover; transition: transform 0.5s ease; }
	.fb-card:hover .fb-card-media img { transform: scale(1.07); }
	.fb-card-cat {
		position: absolute; left: 0.7rem; bottom: 0.7rem;
		font-size: 0.64rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase;
		color: #fff; background: color-mix(in srgb, var(--c, #8b5cf6) 85%, #000);
		padding: 0.28rem 0.65rem; border-radius: 999px;
	}
	.fb-card-body { display: block; padding: 0.95rem 1rem 1.1rem; }
	.fb-card-title { display: block; font-size: 1.02rem; font-weight: 800; line-height: 1.3; margin-bottom: 0.4rem; }
	.fb-card-desc {
		display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
		font-size: 0.86rem; line-height: 1.55; color: var(--fa-muted); margin-bottom: 0.55rem;
	}

	/* newsletter */
	.fb-news {
		position: relative; text-align: center;
		border: 1px solid color-mix(in srgb, var(--fa-acc) 30%, transparent);
		border-radius: 1.4rem;
		background:
			radial-gradient(120% 130% at 50% -30%, color-mix(in srgb, var(--fa-acc) 16%, transparent), transparent 60%),
			var(--fa-card);
		padding: clamp(1.8rem, 4.5vw, 3rem);
	}
	.fb-news-form { display: flex; gap: 0.6rem; justify-content: center; flex-wrap: wrap; margin-top: 0.4rem; }
	.fb-hp { position: absolute; left: -9999px; }
	.fb-news-input {
		width: min(24rem, 100%);
		padding: 0.85rem 1.2rem; border-radius: 999px;
		border: 1px solid color-mix(in srgb, var(--fa-acc) 40%, transparent);
		background: rgba(255, 255, 255, 0.05); color: var(--fa-ink);
		font-size: 0.95rem; outline: none;
		transition: border-color 0.25s ease, box-shadow 0.25s ease;
	}
	:global(html:not(.dark)) .fbl .fb-news-input { background: rgba(255, 255, 255, 0.75); }
	.fb-news-input:focus { border-color: var(--fa-acc); box-shadow: 0 0 0 4px color-mix(in srgb, var(--fa-acc) 20%, transparent); }
	.fb-news-btn {
		display: inline-flex; align-items: center; gap: 0.5rem;
		font-weight: 800; font-size: 0.95rem; color: #fff; cursor: pointer; border: 0;
		background: linear-gradient(95deg, var(--fa-acc), var(--fa-acc2));
		padding: 0.85rem 1.6rem; border-radius: 9999px;
		box-shadow: 0 16px 38px -14px color-mix(in srgb, var(--fa-acc) 80%, transparent);
		transition: transform 0.22s ease;
	}
	.fb-news-btn:hover { transform: translateY(-2px); }
	.fb-orbit i {
		position: absolute; left: 50%; top: 50%; width: 7px; height: 7px; margin: -3.5px;
		border-radius: 50%;
		background: linear-gradient(95deg, var(--fa-acc), var(--fa-acc2));
		box-shadow: 0 0 12px color-mix(in srgb, var(--fa-acc) 70%, transparent);
		animation: fb-orbit 12s linear infinite;
	}
	.fb-orbit i:nth-child(2) { animation-delay: -4s; width: 5px; height: 5px; }
	.fb-orbit i:nth-child(3) { animation-delay: -8s; }
	@keyframes fb-orbit {
		from { transform: rotate(0deg) translateX(min(24rem, 46vw)) rotate(0deg); }
		to { transform: rotate(360deg) translateX(min(24rem, 46vw)) rotate(-360deg); }
	}
	@media (prefers-reduced-motion: reduce) { .fb-orbit { display: none; } }

	/* Brevarium promo */
	.fb-mag {
		display: grid; grid-template-columns: 150px minmax(0, 1fr); gap: 1.3rem; align-items: center;
		max-width: 52rem; margin: 0 auto;
		border: 1px solid var(--fa-line); border-radius: 1.3rem;
		background: var(--fa-card); padding: 1.2rem;
		color: var(--fa-ink);
		transform-style: preserve-3d; will-change: transform;
		transition: border-color 0.3s ease;
	}
