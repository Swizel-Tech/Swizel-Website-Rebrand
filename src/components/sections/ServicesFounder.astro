---
// Services hub · Founder world — the same foundational content as the
// Boardroom hub (six disciplines, process, showreel, numbers, stack,
// sectors, CTA) retold with founder momentum. Root carries `fbody` so the
// shared founder engine animates reveals + counters; tilt/steps/magnetic
// CTA come from aboutFounder.ts (which binds .fsvc too).
import { Icon } from 'astro-icon/components';
import { disciplines } from '../../data/disciplines';

const process = [
	{ n: '01', title: 'Discover', desc: 'We research, define and lock the goal together, so we build the right thing.' },
	{ n: '02', title: 'Design & build', desc: 'Design, engineer and test in tight, visible loops you can follow every week.' },
	{ n: '03', title: 'Launch & scale', desc: 'Ship it, market it, then maintain and grow what we shipped.' },
];

const stats = [
	{ to: 65, suffix: '+', label: 'products shipped' },
	{ to: 98, suffix: '%', label: 'on-time delivery' },
	{ to: 7, suffix: '+', label: 'years building' },
	{ to: 5, decimals: 1, suffix: '', label: 'average rating' },
];

const stack = [
	{ group: 'Design', icon: 'mdi:palette-outline', tools: ['Figma', 'Illustrator', 'Photoshop', 'After Effects', 'Framer', 'Sketch'] },
	{ group: 'Web', icon: 'mdi:language-html5', tools: ['React', 'Next.js', 'Vue', 'Nuxt', 'Astro', 'Svelte', 'Tailwind', 'TypeScript'] },
	{ group: 'Mobile', icon: 'mdi:cellphone', tools: ['Flutter', 'React Native', 'Swift', 'Kotlin', 'Expo'] },
	{ group: 'Backend', icon: 'mdi:server-network', tools: ['Node', 'Python', 'PHP', 'Laravel', 'Django', 'Go', 'Express'] },
	{ group: 'Cloud & DevOps', icon: 'mdi:cloud-outline', tools: ['AWS', 'Vercel', 'Docker', 'Kubernetes', 'Cloudflare', 'GitHub Actions'] },
	{ group: 'Data & AI', icon: 'mdi:database-outline', tools: ['PostgreSQL', 'MongoDB', 'Redis', 'Supabase', 'OpenAI', 'Prisma'] },
	{ group: 'Commerce', icon: 'mdi:cart-outline', tools: ['Stripe', 'Shopify', 'WooCommerce', 'Paystack', 'PayPal'] },
	{ group: 'CMS & content', icon: 'mdi:file-document-edit-outline', tools: ['WordPress', 'Sanity', 'Contentful', 'Strapi', 'Webflow'] },
	{ group: 'Quality & tooling', icon: 'mdi:check-decagram-outline', tools: ['Git', 'Jest', 'Playwright', 'Storybook', 'Sentry'] },
];

const sectors = [
	'Fintech', 'Real estate', 'Sports', 'E-commerce', 'Education', 'Logistics',
	'Healthcare', 'Beauty', 'Energy', 'Agritech', 'Hospitality', 'Media',
	'Retail', 'Travel', 'Gaming', 'Legal',
];
---

<div class="fsvc fbody view-body view-body-founder">
	<!-- ambient stage -->
	<div class="fs-bg" aria-hidden="true">
		<span class="fs-orb fs-orb--a"></span>
		<span class="fs-orb fs-orb--b"></span>
		<span class="fs-orb fs-orb--c"></span>
		{Array.from({ length: 8 }).map((_, i) => (
			<i class="fs-spark" style={`--s:${i}`}></i>
		))}
	</div>

	<!-- ── A · hero: copy + mission-control panel ─────────── -->
	<section class="fs-sec">
		<div class="fs-wrap fs-hero">
			<div class="fs-copy fd-rev">
				<span class="fs-stamp">Services · Founder mode</span>
				<h1 class="fs-h fs-h--xl">
					Your launch crew, <em>every discipline.</em>
				</h1>
				<p class="fs-p">
					Design, build, market and maintain. Everything your product
					needs to launch and grow, under one roof, on one contract.
				</p>
				<ul class="fs-stats">
					{
						stats.map((s) => (
							<li>
								<strong
									data-count={s.to}
									data-suffix={s.suffix}
									data-decimals={s.decimals || 0}
								>
									0{s.suffix}
								</strong>
								<span>{s.label}</span>
							</li>
						))
					}
				</ul>
				<div class="fs-hero-row">
					<a href="/contact" class="fs-cta">
						Start Week 1
						<Icon width={17} name="mdi:rocket-launch-outline" />
					</a>
					<a href="#fs-disciplines" class="fs-link">
						Explore what we do
						<Icon width={15} name="mdi:chevron-down" />
					</a>
				</div>
			</div>

			<div class="fs-panel fd-rev" data-fa-tilt="6">
				<span class="fa-val-glare" aria-hidden="true"></span>
				<span class="fs-panel-top">
					<span class="fs-panel-dot" aria-hidden="true"></span>
					Mission control · six disciplines, one contract
				</span>
				<div class="fs-panel-tiles">
					{
						disciplines.map((d, i) => (
							<a
								href={`/services/${d.slug}`}
								class="fs-tile"
								style={`--c:${d.color}; --i:${i}`}
								data-cursor={d.cursor}
								aria-label={d.title}
							>
								<span class="fs-tile-ic">
									<Icon width={19} name={d.icon} />
								</span>
								<span class="fs-tile-name">{d.title}</span>
								<Icon class="fs-tile-go" width={15} name="mdi:arrow-right" />
							</a>
						))
					}
				</div>
			</div>
		</div>

		<!-- kinetic proof marquee -->
		<div class="fs-marquee fd-rev" aria-hidden="true">
			<div class="fs-marquee-track">
				{
					Array.from({ length: 2 }).map(() => (
						<span class="fs-marquee-seq">
							<i>Design</i><b>✦</b>
							<i>Development</i><b>✦</b>
							<i>Marketing</i><b>✦</b>
							<i>Strategy</i><b>✦</b>
							<i>Maintenance</i><b>✦</b>
							<i>AI & automation</i><b>✦</b>
							<i>One roof, one contract</i><b>✦</b>
						</span>
					))
				}
			</div>
		</div>
	</section>

	<!-- ── B · the disciplines ─────────────────────────────── -->
	<section class="fs-sec" id="fs-disciplines" data-cursor="repo">
		<div class="fs-wrap">
			<div class="fs-head fd-rev">
				<span class="fs-stamp">What we do</span>
				<h2 class="fs-h">Six disciplines. <em>One contract.</em></h2>
				<p class="fs-p fs-p--center">
					No hiring, no hand-offs, no finger-pointing. Every capability
					your product needs lives in the same room.
				</p>
			</div>

			<div class="fs-grid">
				{
					disciplines.map((d, i) => (
						<a
							href={`/services/${d.slug}`}
							class="fs-card fd-rev"
							data-cursor={d.cursor}
							data-fa-tilt="9"
							style={`--c:${d.color}; --i:${i % 3}`}
						>
							<span class="fa-val-glare" aria-hidden="true" />
							<span class="fs-card-n">{d.n}</span>
							<span class="fs-card-ic">
								<Icon width={28} name={d.icon} />
							</span>
							<h3 class="fs-card-title">{d.title}</h3>
							<p class="fs-card-tag">{d.tagline}</p>
							<p class="fs-card-desc">{d.desc}</p>
							<span class="fs-card-items">
								{d.items.slice(0, 4).map((it) => (
									<i>{it}</i>
								))}
							</span>
							<span class="fs-card-go">
								Explore {d.title}
								<Icon width={15} name="mdi:arrow-right" />
							</span>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<!-- ── C · how the sprint goes ─────────────────────────── -->
	<section class="fs-sec" data-cursor="clock">
		<div class="fs-wrap">
			<div class="fs-head fd-rev">
				<span class="fs-stamp">The plan</span>
				<h2 class="fs-h">How the adventure <em>goes.</em></h2>
				<p class="fs-p fs-p--center">
					The same three moves on every project. Visible, predictable,
					yours to follow.
				</p>
			</div>

			<ol class="fs-steps fd-rev">
				<span class="fs-steps-line" aria-hidden="true"></span>
				{
					process.map((p, i) => (
						<li class="fs-step" style={`--i:${i}`}>
							<span class="fs-step-n">{p.n}</span>
							<h3 class="fs-step-t">{p.title}</h3>
							<p class="fs-step-d">{p.desc}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<!-- ── D · showreel ────────────────────────────────────── -->
	<section class="fs-sec" data-cursor="play">
		<div class="fs-wrap fs-reel fd-rev" data-fa-tilt="5">
			<span class="fa-val-glare" aria-hidden="true"></span>
			<div class="fs-reel-copy">
				<span class="fs-stamp">Inside the studio</span>
				<h2 class="fs-h">See how <em>we build.</em></h2>
				<p class="fs-p">
					A two-minute look from first sketch to launch day, the messy,
					honest middle included.
				</p>
				<ol class="fs-reel-chapters">
					<li><span>01</span> Discovery &amp; sketches</li>
					<li><span>02</span> Design &amp; build loops</li>
					<li><span>03</span> Launch day</li>
				</ol>
			</div>
			<div class="fs-media">
				<span class="fa-media-sheen fs-media-sheen" aria-hidden="true"></span>
				<Icon width={36} name="mdi:play-circle-outline" />
				<span class="fs-media-label">Video placeholder</span>
				<span class="fs-media-sub">2:00 · studio showreel</span>
			</div>
		</div>
	</section>

	<!-- ── E · the stack, always moving ────────────────────── -->
	<section class="fs-sec" data-cursor="repo">
		<div class="fs-wrap">
			<div class="fs-head fd-rev">
				<span class="fs-stamp">The toolkit</span>
				<h2 class="fs-h">The tools in <em>our hands.</em></h2>
				<p class="fs-p fs-p--center">
					A modern, proven toolkit, picked for the job, not for the hype.
				</p>
			</div>

			<div class="fs-stack fd-rev">
				{
					stack.map((cat, i) => (
						<div class="fs-stack-cat" style={`--i:${i % 3}`}>
							<span class="fs-stack-head">
								<span class="fs-stack-ic">
									<Icon width={17} name={cat.icon} />
								</span>
								{cat.group}
								<em>{cat.tools.length}</em>
							</span>
							<span class="fs-stack-chips">
								{cat.tools.map((t) => (
									<i>{t}</i>
								))}
							</span>
						</div>
					))
				}
			</div>
			<p class="fs-stack-note fd-rev">
				…and whatever else the job calls for. We pick tools to fit your
				product, not our comfort zone.
			</p>
		</div>
	</section>

	<!-- ── F · sectors marquee ─────────────────────────────── -->
	<section class="fs-sec" data-cursor="repo">
		<div class="fs-head fd-rev">
			<span class="fs-stamp">Across sectors</span>
			<h2 class="fs-h">At home in <em>your industry.</em></h2>
		</div>
		<div class="fs-marquee fs-marquee--sectors fd-rev" aria-hidden="true">
			<div class="fs-marquee-track fs-marquee-track--slow">
				{
					[0, 1].map(() => (
						<span class="fs-marquee-seq">
							{sectors.map((s) => (
								<><i>{s}</i><b>✦</b></>
							))}
						</span>
					))
				}
			</div>
		</div>
	</section>

	<!-- ── G · CTA ─────────────────────────────────────────── -->
	<section class="fs-sec fs-sec--last" data-cursor="phone">
		<div class="fs-cta-box fd-rev">
			<span class="fa-cta-orbit fs-orbit" aria-hidden="true">
				<i></i><i></i><i></i>
			</span>
			<h2 class="fs-h">Ready to <em>build?</em></h2>
			<p class="fs-p fs-p--center">
				Tell us what you have in mind. You'll have a reply within one
				business day.
			</p>
			<div class="fs-cta-row">
				<a href="/contact" class="fs-cta">
					Start your project
					<Icon width={17} name="mdi:rocket-launch-outline" />
				</a>
				<a href="/portfolio" class="fs-link">
					See the work
					<Icon width={15} name="mdi:arrow-right" />
				</a>
			</div>
			<a href="tel:+2348100204570" class="fs-call">
				<span>or call us now</span>
				<strong>
					<Icon width={22} name="mdi:phone" />
					+234 810 020 4570
				</strong>
			</a>
		</div>
	</section>
</div>

<style>
	/* ── founder tokens (mirrors .fabout) ── */
	.fsvc {
		--fa-ink: #f1edfb;
		--fa-muted: rgba(241, 237, 251, 0.62);
		--fa-acc: var(--view-accent, #8b5cf6);
		--fa-acc2: #ec4899;
		--fa-line: rgba(255, 255, 255, 0.09);
		--fa-card: rgba(255, 255, 255, 0.035);
		font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI',
			Roboto, sans-serif;
		position: relative;
		isolation: isolate;
		background:
			radial-gradient(1000px 540px at 82% -6%, rgba(139, 92, 246, 0.16), transparent 62%),
			radial-gradient(820px 480px at 6% 44%, rgba(236, 72, 153, 0.08), transparent 60%),
			linear-gradient(180deg, #0a0714 0%, #0d0a18 50%, #080610 100%);
		color: var(--fa-ink);
		padding: clamp(3rem, 7vw, 5.5rem) clamp(1rem, 3vw, 2rem)
			clamp(2.5rem, 5vw, 4rem);
		transition: background 0.4s ease, color 0.4s ease;
	}
	:global(html:not(.dark)) .fsvc {
		--fa-ink: #1d1430;
		--fa-muted: rgba(29, 20, 48, 0.66);
		--fa-acc: #6d3fe0;
		--fa-line: rgba(29, 20, 48, 0.1);
		--fa-card: rgba(29, 20, 48, 0.04);
		background:
			radial-gradient(1000px 540px at 82% -6%, rgba(139, 92, 246, 0.12), transparent 62%),
			linear-gradient(180deg, #f4f1fb 0%, #ece7f8 55%, #f4f1fb 100%);
	}
	.fs-sec { position: relative; z-index: 1; padding-block: clamp(2rem, 5vw, 3.5rem); }
	.fs-sec--last { padding-bottom: clamp(3rem, 6vw, 5rem); }
	.fs-wrap { max-width: 74rem; margin: 0 auto; }

	/* ambient */
	.fs-bg { position: absolute; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
	.fs-orb { position: absolute; border-radius: 50%; filter: blur(70px); opacity: 0.5; animation: fs-drift 16s ease-in-out infinite alternate; }
	.fs-orb--a { width: 460px; height: 460px; left: -140px; top: 3%; background: radial-gradient(circle, rgba(139, 92, 246, 0.32), transparent 70%); }
	.fs-orb--b { width: 520px; height: 520px; right: -180px; top: 34%; background: radial-gradient(circle, rgba(236, 72, 153, 0.18), transparent 70%); animation-delay: -6s; }
	.fs-orb--c { width: 420px; height: 420px; left: 30%; bottom: -6%; background: radial-gradient(circle, rgba(99, 102, 241, 0.22), transparent 70%); animation-delay: -11s; }
	@keyframes fs-drift { to { transform: translate3d(60px, -44px, 0) scale(1.12); } }
	.fs-spark {
		position: absolute; bottom: -12px; left: calc(8% + var(--s) * 11%);
		width: 4px; height: 4px; border-radius: 50%;
		background: color-mix(in srgb, var(--fa-acc) 85%, #fff);
		box-shadow: 0 0 10px 2px color-mix(in srgb, var(--fa-acc) 55%, transparent);
		opacity: 0;
		animation: fs-rise calc(9s + var(--s) * 1.3s) linear infinite;
		animation-delay: calc(var(--s) * -1.9s);
	}
	@keyframes fs-rise {
		0% { transform: translateY(0); opacity: 0; }
		8% { opacity: 0.8; }
		92% { opacity: 0.25; }
		100% { transform: translateY(-105vh) translateX(28px); opacity: 0; }
	}
	@media (prefers-reduced-motion: reduce) {
		.fs-orb { animation: none; }
		.fs-spark { display: none; }
	}

	/* type */
	.fs-stamp {
		display: inline-block; font-size: 0.72rem; font-weight: 800;
		letter-spacing: 0.14em; text-transform: uppercase; color: var(--fa-acc);
		border: 1.5px dashed color-mix(in srgb, var(--fa-acc) 55%, transparent);
		padding: 0.35rem 0.8rem; border-radius: 0.5rem; transform: rotate(-2deg);
		margin-bottom: 1rem;
	}
	:global(html:not(.dark)) .fsvc .fs-stamp { color: #5d34c4; }
	.fs-h {
		font-size: clamp(1.9rem, 4.2vw, 3rem); font-weight: 850;
		letter-spacing: -0.025em; line-height: 1.06; margin: 0 0 1rem;
	}
	.fs-h--xl { font-size: clamp(2.2rem, 4.4vw, 3.4rem); }
	.fs-h em {
		font-style: italic;
		background: linear-gradient(95deg, var(--fa-acc), var(--fa-acc2), var(--fa-acc));
		background-size: 220% 100%;
		-webkit-background-clip: text; background-clip: text;
		-webkit-text-fill-color: transparent; padding-right: 0.06em;
		animation: fs-shimmer 5.5s ease-in-out infinite;
	}
	@keyframes fs-shimmer { 0%, 100% { background-position: 0% 0; } 50% { background-position: 100% 0; } }
	:global(html:not(.dark)) .fsvc .fs-h em { background: linear-gradient(95deg, #5d34c4, #b81d68, #5d34c4); background-size: 220% 100%; -webkit-background-clip: text; background-clip: text; }
	.fs-p { font-size: 1.02rem; line-height: 1.65; color: var(--fa-muted); max-width: 34rem; margin: 0 0 1.4rem; }
	.fs-p--center { margin-inline: auto; text-align: center; }
	.fs-head { text-align: center; max-width: 46rem; margin: 0 auto clamp(1.5rem, 3vw, 2.25rem); }
	.fs-link { display: inline-flex; align-items: center; gap: 0.45rem; font-weight: 700; color: var(--fa-acc); transition: gap 0.25s ease; }
	.fs-link:hover { gap: 0.75rem; }
	:global(html:not(.dark)) .fsvc .fs-link { color: #5d34c4; }
	.fs-cta {
		display: inline-flex; align-items: center; gap: 0.55rem;
		font-weight: 800; font-size: 0.98rem; color: #fff;
		background: linear-gradient(95deg, var(--fa-acc), var(--fa-acc2));
		padding: 0.85rem 1.7rem; border-radius: 9999px;
		box-shadow: 0 16px 38px -14px color-mix(in srgb, var(--fa-acc) 80%, transparent);
		transition: transform 0.22s ease, box-shadow 0.22s ease;
	}
	.fs-cta:hover { transform: translateY(-2px); box-shadow: 0 22px 48px -14px color-mix(in srgb, var(--fa-acc) 85%, transparent); }

	/* reveals */
	.fd-rev {
		opacity: 0; transform: translateY(22px);
		transition: opacity 0.6s ease calc(var(--i, 0) * 90ms),
			transform 0.6s cubic-bezier(0.22, 1, 0.36, 1) calc(var(--i, 0) * 90ms);
	}
	.fd-rev.is-on { opacity: 1; transform: none; }
	@media (prefers-reduced-motion: reduce) { .fd-rev { opacity: 1; transform: none; transition: none; } }

	/* ── hero ── */
	.fs-hero { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: clamp(2rem, 4vw, 3.5rem); align-items: center; }
	.fs-stats { display: flex; align-items: stretch; margin: 1.6rem 0 1.5rem; padding: 0; list-style: none; }
	.fs-stats li { flex: 1; min-width: 0; padding: 0.2rem 1rem; border-left: 1px solid color-mix(in srgb, var(--fa-acc) 26%, transparent); transition: transform 0.25s ease; }
	.fs-stats li:first-child { padding-left: 0; border-left: 0; }
	.fs-stats li:hover { transform: translateY(-3px); }
	.fs-stats strong {
		display: block; font-size: clamp(1.4rem, 2.2vw, 1.9rem); font-weight: 850;
		letter-spacing: -0.02em; white-space: nowrap;
		background: linear-gradient(95deg, var(--fa-acc), var(--fa-acc2));
		-webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
	}
	.fs-stats span { display: block; font-size: 0.74rem; line-height: 1.3; color: var(--fa-muted); margin-top: 0.2rem; }
	.fs-hero-row { display: flex; align-items: center; gap: 1.4rem; flex-wrap: wrap; }

	/* mission control panel */
	.fs-panel {
		position: relative; overflow: hidden;
		border: 1px solid var(--fa-line); border-radius: 1.3rem;
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.05), transparent 55%), var(--fa-card);
		padding: 1.2rem;
		transform-style: preserve-3d; will-change: transform;
	}
	.fs-panel-top {
		display: flex; align-items: center; gap: 0.55rem;
		font-size: 0.75rem; font-weight: 800; letter-spacing: 0.1em;
		text-transform: uppercase; color: var(--fa-muted); margin-bottom: 0.9rem;
	}
	.fs-panel-dot { width: 8px; height: 8px; border-radius: 50%; background: #4ade80; box-shadow: 0 0 10px #4ade80; animation: fs-blink 2.2s ease-in-out infinite; }
	@keyframes fs-blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }
	.fs-panel-tiles { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.6rem; }
	.fs-tile {
		display: flex; align-items: center; gap: 0.6rem;
		padding: 0.7rem 0.8rem; border-radius: 0.85rem;
		border: 1px solid color-mix(in srgb, var(--c, #8b5cf6) 30%, rgba(255, 255, 255, 0.1));
		background: color-mix(in srgb, var(--c, #8b5cf6) 8%, transparent);
		color: var(--fa-ink);
		transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease;
		animation: fs-tile-in 0.5s cubic-bezier(0.22, 1, 0.36, 1) calc(var(--i, 0) * 90ms) both;
	}
	@keyframes fs-tile-in { from { opacity: 0; transform: translateY(10px); } }
	.fs-tile:hover {
		transform: translateY(-3px);
		border-color: color-mix(in srgb, var(--c) 60%, transparent);
		background: color-mix(in srgb, var(--c) 16%, transparent);
	}
