---
import { contactFormDetails } from '../../consts';
import CustomButton from '../CustomButton.astro';
import Input from '../HTML/Input.astro';
---

{/* novalidate: with type="email" the browser blocks the submit itself and
    shows its own grey bubble, so our own message — the one that says
    "Did you mean @gmail.com?" — never got the chance to appear. One
    voice, ours, on every field. */}
<form id="contact-form" class="space-y-8" novalidate>
	{/* The box no human can see. A browser skips it because it is off the
	    page and out of the tab order; a bot fills in everything it finds.
	    Anything in here means the submission is automated, and it is
	    dropped without a word so whatever is doing it learns nothing. */}
	<p class="cf-pot" aria-hidden="true">
		<label>
			Leave this empty
			<input type="text" name="bot-field" tabindex="-1" autocomplete="off" />
		</label>
	</p>
	{
		contactFormDetails.map((ele) => (
			<Input textWhite {...ele} id={ele.name} errorID={`${ele.name}-error`} />
		))
	}
	<CustomButton id="form-button" type="submit" class="w-fit block ml-auto rounded-full !px-16">
		Submit
	</CustomButton>
</form>

<style>
	.cf-pot {
		position: absolute;
		left: -9999px;
		width: 1px;
		height: 1px;
		overflow: hidden;
	}
	.msg {
		border: 1px solid red;
		padding: 12px 24px;
		border-radius: 12px;
	}
</style>

<script>
	import { type ContactFormData, contactFormDetails } from '../../consts';
	import { rules, looksAutomated } from '../../scripts/validate';
	import emailjs from '@emailjs/browser';
	import toaster from '../../scripts/toast';

	const assetNull = <T extends HTMLElement>(ele: T | null): T => {
		if (ele) return ele;

		throw new Error(`Element is undefined for ${ele}`);
	};

	(function () {
		emailjs.init('6seJt_G90tNz7cnD5');
	})();

	const toast = toaster();

	// Every world dresses this form differently, so the page can hold more
	// than one copy of it (founder's desk, builder's editor, the shared
	// fallback) with only one visible at a time. Wire them ALL, and scope
	// every lookup to the form it belongs to — a page-wide querySelector
	// only ever found the first copy and left every other one dead.
	const contactForms = document.querySelectorAll<HTMLFormElement>('form#contact-form');

	// The schema this used to carry asked for a name of three characters,
	// a message of five and nothing at all of a phone number — so "123"
	// was a perfectly good name and "hello" a perfectly good brief. The
	// checks live in one module now, shared with the campus sheet and the
	// application form, and they are written as sentences a person can act
	// on rather than "Invalid input".
	const CHECKS: Record<string, (v: string) => string | null> = {
		name: rules.name,
		email: rules.email,
		phoneNumber: rules.phone,
		message: rules.message,
	};

	contactForms.forEach((contactForm) => {
		const allFormInputs: (HTMLInputElement | HTMLTextAreaElement)[] = [];

		const allErrorParagraph: HTMLParagraphElement[] = [];

		contactFormDetails.forEach(({ name }) => {
			const inputEle = contactForm.querySelector<HTMLInputElement | HTMLTextAreaElement>(
				`#${name}`
			);

			const paragraphEle = contactForm.querySelector<HTMLParagraphElement>(
				`#${name}-error`
			);

			if (inputEle) {
				allFormInputs.push(inputEle);
			}

			if (paragraphEle) {
				allErrorParagraph.push(paragraphEle);
			}
		});

		contactForm.onsubmit = (e) => {
			e.preventDefault();

			allErrorParagraph.forEach((ele) => {
				ele.textContent = '';
			});

			let formData: ContactFormData = {
				email: '',
				message: '',
				name: '',
				phoneNumber: '',
			};

			// let inputElements: HTMLInputElement[] = [];

			allFormInputs.forEach((ele) => {
				const { value, name } = ele;

				formData = {
					...formData,
					[name]: value,
				};
			});

			// a machine filled in the box no human can see: drop it without
			// a word, so whatever is doing this learns nothing
			if (looksAutomated(contactForm)) {
				contactForm.reset();
				toast('success', "Thanks for reaching out to us, we'd be in touch shortly");
				return;
			}

			// Every field is checked, and every failing field says why on
			// itself — the old version put one "Please fill all required
			// fields" in a toast and left the person to work out which.
			const problems: { field: string; msg: string }[] = [];
			for (const key of Object.keys(CHECKS)) {
				const msg = CHECKS[key]!((formData as Record<string, string>)[key] ?? '');
				if (msg) problems.push({ field: key, msg });
			}

			if (problems.length) {
				problems.forEach(({ field, msg }) => {
					const note = allErrorParagraph.find(({ id }) => id === `${field}-error`);
					if (note) note.textContent = msg;
					const input = allFormInputs.find((el) => el.name === field);
					input?.setAttribute('aria-invalid', 'true');
				});
				// the toast says the first real problem rather than a count
				toast('danger', problems[0]!.msg);
				const first = allFormInputs.find((el) => el.name === problems[0]!.field);
				first?.focus();
				first?.scrollIntoView({ block: 'center', behavior: 'smooth' });
				return;
			}

			allFormInputs.forEach((el) => el.removeAttribute('aria-invalid'));

			const emailButtonn = assetNull(
				contactForm.querySelector<HTMLElement>('#form-button')
			);

			emailButtonn.textContent = 'Sending…';
			emailButtonn.setAttribute('disabled', 'true');

			emailjs
				.send('service_xtbicfb', 'template_gp3qzsk', {
					from_name: formData.name,
					name: formData.name,
					email: formData.email,
					message: formData.message,
					reply_to: formData.email,
					phoneNumber: formData.phoneNumber || 'Not given',
					to_email: 'contact@swizel.co',
					subject: `[Contact] ${formData.name}`,
					source: `Contact form · ${window.location.pathname}`,
				})
				.then(() => {
					toast('success', "Thanks for reaching out to us, we'd be in touch shortly");
					emailButtonn.textContent = 'Submit';
					emailButtonn.removeAttribute('disabled');
					contactForm.reset();
				})
				.catch((err) => {
					console.log(err);
					toast(
						'danger',
						'That did not send. You can reach us on live chat, or at contact@swizel.co.'
					);
					emailButtonn.textContent = 'Submit';
					emailButtonn.removeAttribute('disabled');
				});
		};
	});
</script>
