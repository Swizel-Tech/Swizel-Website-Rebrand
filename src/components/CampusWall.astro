---
// The wall under the board — Campus hero only.
//
// Three prints from the Abuja floor, taped up under the whiteboard the way
// photographs actually end up on a classroom wall: overlapping and tilted.
// Pick one up (hover / focus) and it straightens and grows.
//
// The board's own note stays where it always was, full width directly
// under the video; this hangs beneath it — kicker on the left, the fan
// centred. On a phone the fan opens into a snap rail you flick through,
// so the hero gains a sideways gesture instead of one more block in a
// vertical stack.
//
// Frames are paper white in BOTH themes, like the whiteboard: a photograph
// is a physical object, it does not repaint itself when the lights go out.
import { Icon } from 'astro-icon/components';

interface Props {
	class?: string;
}

const { class: klass = '' } = Astro.props;

const shots = [
	{
		img: '/images/campus/pairing.jpg',
		alt: 'A Swizel mentor reviewing an intern’s work at the desk in Abuja',
		cap: 'the review',
		tag: 'wk 03',
		w: 960,
		h: 1280,
		pos: '50% 42%',
		rot: '-3.4deg',
	},
	{
		img: '/images/campus/studio-floor.jpg',
		alt: 'The Swizel studio floor in Abuja, the team heads-down on live builds',
		cap: 'a normal Tuesday',
		tag: 'wk 07',
		w: 1050,
		h: 1400,
		pos: '50% 46%',
		rot: '2.6deg',
	},
	{
		img: '/images/campus/learning.jpg',
		alt: 'An intern working through a tutorial while the team builds around him',
		cap: 'learn it, teach it',
		tag: 'wk 11',
		w: 1050,
		h: 1400,
		pos: '56% 44%',
		rot: '-1.8deg',
	},
];
---

<div class:list={['cwall', klass]}>
	<!-- Under the copy column: the marker scribble that sends you right,
	     into the prints. Decorative, so it is hidden from the reader. -->
	<div class="cwall__nudge" aria-hidden="true">
		<span class="cwall__nudgetxt">this term, in pictures</span>
		<svg class="cwall__arrow" viewBox="0 0 156 76" fill="none">
			<path
				class="cwall__arrowline"
				d="M6 16C44 4 100 12 128 48"
				stroke="currentColor"
				stroke-width="3.2"
				stroke-linecap="round"
			></path>
			<path
				class="cwall__arrowhead"
				d="M126 32L128 48L113 42"
				stroke="currentColor"
				stroke-width="3.2"
				stroke-linecap="round"
				stroke-linejoin="round"
			></path>
		</svg>
	</div>

	<div class="cwall__body">
	<span class="cwall__k">
		<Icon width={13} name="mdi:pin-outline" />
		On the wall this term
	</span>

	<div class="cwall__rail" role="list">
		{
			shots.map((s, i) => (
				<figure
					class="cwall__shot"
					role="listitem"
					style={`--r:${s.rot}; --i:${i}`}
					tabindex="0"
				>
					<span class="cwall__tape" aria-hidden="true" />
					<span class="cwall__pic">
						<img
							src={s.img}
							alt={s.alt}
							width={s.w}
							height={s.h}
							loading="lazy"
							decoding="async"
							style={`object-position:${s.pos}`}
						/>
						<span class="cwall__sheen" aria-hidden="true" />
						<span class="cwall__tag">{s.tag}</span>
					</span>
					<figcaption class="cwall__cap">{s.cap}</figcaption>
				</figure>
			))
		}
	</div>
	</div>
</div>

<style>
	.cwall {
		--pw: clamp(116px, 11vw, 168px); /* photo width on the fan */
		--overlap: clamp(14px, 1.6vw, 22px);
		display: block;
		margin-top: 0.4rem;
	}
	.cwall__body { min-width: 0; }

	/* ── the marker arrow (desktop only) ─────────────────────────────── */
	.cwall__nudge {
		display: none;
		color: #fb7185;
	}
	.cwall__nudgetxt {
		display: block;
		font-family: 'Bradley Hand', 'Segoe Print', 'Comic Sans MS', cursive;
		font-size: 1.02rem;
		font-weight: 700;
		line-height: 1.15;
		white-space: nowrap;
		transform: rotate(-3.4deg);
	}
	.cwall__arrow {
		display: block;
		width: clamp(132px, 12.5vw, 190px);
		height: auto;
		margin: 0.15rem 0 0 auto;
		overflow: visible;
	}
	/* drawn on, once, like someone reached over and scribbled it */
	.cwall__arrowline {
		stroke-dasharray: 190;
		stroke-dashoffset: 190;
		animation: cwall-draw 1.05s cubic-bezier(0.5, 0, 0.2, 1) 0.5s forwards;
	}
	.cwall__arrowhead {
		stroke-dasharray: 46;
		stroke-dashoffset: 46;
		animation: cwall-draw 0.32s ease-out 1.45s forwards;
	}
	@keyframes cwall-draw {
		to { stroke-dashoffset: 0; }
	}

	@media (min-width: 1024px) {
		/* echoes .campus--layout's own columns, so the scribble lands under
		   the copy and the prints under the board */
		.cwall {
			display: grid;
			grid-template-columns: 0.86fr 1.14fr;
			gap: 2.25rem;
			align-items: start;
			margin-top: 1.1rem;
		}
		/* the fan is centred in this cell, so the kicker rides above it
		   rather than floating off to the left of nothing */
		.cwall__body { text-align: center; }
		.cwall__nudge {
			display: block;
			justify-self: end;
			align-self: center;
			padding-bottom: 0.4rem;
			/* reaches across the column gutter so the tip lands near the
			   prints instead of stopping short of them */
			margin-right: clamp(-2.6rem, -2.2vw, -1.2rem);
		}
	}

	/* the kicker sits on the left, under the board's note */
	.cwall__k {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-family: 'Bradley Hand', 'Segoe Print', 'Comic Sans MS', cursive;
		font-size: 0.86rem;
		font-weight: 700;
		color: rgba(252, 211, 77, 0.85);
		transform: rotate(-1.4deg);
		white-space: nowrap;
	}
	.cwall__k :global(svg) {
		color: #fb7185;
	}

	/* ── the fan, centred under the board ────────────────────────────── */
	.cwall__rail {
		display: flex;
		align-items: flex-end;
		justify-content: center;
		padding: 0.45rem 0 0.1rem;
	}
	.cwall__rail > * + * {
		margin-left: calc(var(--overlap) * -1);
	}

	.cwall__shot {
		--lift: 0px;
		position: relative;
		z-index: calc(3 - var(--i));
		flex: none;
		width: var(--pw);
		margin: 0;
		padding: 0.32rem 0.32rem 0;
		border-radius: 3px;
		background: linear-gradient(180deg, #fffdf8, #f4ead9);
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.7) inset,
			0 18px 34px -20px rgba(0, 0, 0, 0.85),
			0 4px 10px -6px rgba(0, 0, 0, 0.5);
		transform: rotate(var(--r)) translateY(var(--lift));
		transform-origin: 50% 100%;
		transition:
			transform 0.34s cubic-bezier(0.2, 0.8, 0.25, 1),
			box-shadow 0.34s ease;
		cursor: pointer;
		outline: none;
	}
	.cwall__shot:hover,
	.cwall__shot:focus-visible {
		--lift: -10px;
		z-index: 9;
		transform: rotate(0deg) translateY(var(--lift)) scale(1.16);
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.8) inset,
			0 34px 60px -26px rgba(0, 0, 0, 0.9),
			0 8px 18px -8px rgba(0, 0, 0, 0.55);
	}
	.cwall__shot:focus-visible {
		box-shadow:
			0 0 0 2px #fcd34d,
			0 34px 60px -26px rgba(0, 0, 0, 0.9);
	}

	/* a scrap of tape holding each one to the wall */
	.cwall__tape {
		position: absolute;
		top: -9px;
		left: 50%;
		width: 52%;
		height: 22px;
		margin-left: -26%;
		border-radius: 1px;
		background: linear-gradient(
			180deg,
			rgba(253, 230, 138, 0.78),
			rgba(252, 211, 77, 0.6)
		);
		box-shadow: 0 4px 9px -6px rgba(0, 0, 0, 0.7);
		transform: rotate(calc(var(--r) * -1.7));
		clip-path: polygon(4% 0, 96% 6%, 100% 94%, 2% 100%);
		pointer-events: none;
	}

	.cwall__pic {
		position: relative;
		display: block;
		overflow: hidden;
		border-radius: 1px;
		background: #1b1409;
	}
	.cwall__pic img {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 5;
		height: auto;
		object-fit: cover;
		filter: saturate(1.04) contrast(1.03);
	}

	/* a slow gloss travelling across the print, like light off photo paper */
	.cwall__sheen {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			110deg,
			transparent 32%,
			rgba(255, 255, 255, 0.36) 48%,
			transparent 62%
		);
		transform: translateX(-120%);
		pointer-events: none;
	}
	.cwall__shot:hover .cwall__sheen,
	.cwall__shot:focus-visible .cwall__sheen {
		animation: cwall-sheen 0.85s ease-out;
	}
	@keyframes cwall-sheen {
		to {
			transform: translateX(120%);
		}
	}

	/* the frame number, stamped in the corner of the print */
	.cwall__tag {
		position: absolute;
		right: 4px;
		bottom: 3px;
		font-family: ui-monospace, monospace;
		font-size: 0.52rem;
		font-weight: 800;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: #fcd34d;
		text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9);
		opacity: 0.9;
	}

	.cwall__cap {
		display: block;
		padding: 0.3rem 0.15rem 0.42rem;
		font-family: 'Bradley Hand', 'Segoe Print', 'Comic Sans MS', cursive;
		font-size: 0.72rem;
		line-height: 1.15;
		text-align: center;
		color: #4a3312;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	/* ── phones and tablets: the fan opens into a flick rail ──────────── */
	@media (max-width: 1023px) {
		.cwall {
			margin-top: 1rem;
		}
		.cwall__k {
			font-size: 0.95rem;
			margin-bottom: 0.15rem;
		}
		.cwall__rail {
			display: flex;
			justify-content: flex-start;
			gap: 0.85rem;
			padding: 0.7rem 0 0.9rem;
			overflow-x: auto;
			overscroll-behavior-x: contain;
			scroll-snap-type: x proximity;
			scroll-padding-left: 0.2rem;
			-webkit-overflow-scrolling: touch;
			scrollbar-width: none;
			/* let the tilted frames breathe without clipping their shadows */
			margin-inline: calc(var(--cw-bleed, 1.15rem) * -1);
			padding-inline: var(--cw-bleed, 1.15rem);
			mask-image: linear-gradient(
				90deg,
				#000 0,
				#000 calc(100% - 2.6rem),
				transparent 100%
			);
		}
		.cwall__rail::-webkit-scrollbar {
			display: none;
		}
		.cwall__rail > * + * {
			margin-left: 0;
		}
		.cwall__shot {
			width: min(56vw, 224px);
			scroll-snap-align: start;
			padding: 0.4rem 0.4rem 0;
		}
		/* touch has no hover: keep the tilt, drop the grow */
		.cwall__shot:hover {
			transform: rotate(var(--r)) translateY(0);
			scale: 1;
		}
		.cwall__cap {
			font-size: 0.82rem;
			padding-bottom: 0.5rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cwall__shot,
		.cwall__sheen {
			transition: none !important;
			animation: none !important;
		}
		.cwall__arrowline,
		.cwall__arrowhead {
			animation: none !important;
			stroke-dashoffset: 0 !important;
		}
	}

	/* ══ daylight ═════════════════════════════════════════════════════ */
	:global(html:not(.dark)) .cwall__nudge {
		color: #e11d48;
	}
	:global(html:not(.dark)) .cwall__k {
		color: #a1571b;
	}
	:global(html:not(.dark)) .cwall__k :global(svg) {
		color: #e11d48;
	}
	:global(html:not(.dark)) .cwall__shot {
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.9) inset,
			0 18px 30px -20px rgba(70, 45, 10, 0.7),
			0 3px 8px -5px rgba(70, 45, 10, 0.45);
	}
	:global(html:not(.dark)) .cwall__shot:hover,
	:global(html:not(.dark)) .cwall__shot:focus-visible {
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.9) inset,
			0 30px 52px -26px rgba(70, 45, 10, 0.75),
			0 6px 14px -7px rgba(70, 45, 10, 0.5);
	}
	:global(html:not(.dark)) .cwall__tape {
		background: linear-gradient(
			180deg,
			rgba(255, 255, 255, 0.62),
			rgba(214, 209, 199, 0.55)
		);
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.7) inset,
			0 4px 8px -6px rgba(70, 45, 10, 0.55);
	}
</style>
