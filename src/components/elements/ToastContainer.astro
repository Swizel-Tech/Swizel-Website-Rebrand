---
---

<div>
	<div
		id="toast-success"
		class="flex items-center w-full max-w-xs p-4 mb-4 rounded-lg shadow text-gray-400 bg-gray-800 toast-notification fixed top-4 right-2 sm:right-4"
		role="alert"
		data-mode="hidden"
	>
		<div
			class="inline-flex items-center justify-center flex-shrink-0 w-8 h-8 rounded-lg bg-green-800 text-green-200"
		>
			<svg
				class="w-5 h-5"
				aria-hidden="true"
				xmlns="http://www.w3.org/2000/svg"
				fill="currentColor"
				viewBox="0 0 20 20"
			>
				<path
					d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5Zm3.707 8.207-4 4a1 1 0 0 1-1.414 0l-2-2a1 1 0 0 1 1.414-1.414L9 10.586l3.293-3.293a1 1 0 0 1 1.414 1.414Z"
				></path>
			</svg>
			<span class="sr-only">Check icon</span>
		</div>
		<div class="ml-3 text-sm font-normal toast-message"></div>
		<button
			type="button"
			class="ml-auto -mx-1.5 -my-1.5 rounded-lg focus:ring-2 focus:ring-gray-300 p-1.5 inline-flex items-center justify-center h-8 w-8 text-gray-500 hover:text-white bg-gray-800 hover:bg-gray-700 toast-button"
			data-dismiss-target="#toast-success"
			aria-label="Close"
		>
			<span class="sr-only">Close</span>
			<svg
				class="w-3 h-3"
				aria-hidden="true"
				xmlns="http://www.w3.org/2000/svg"
				fill="none"
				viewBox="0 0 14 14"
			>
				<path
					stroke="currentColor"
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2"
					d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"></path>
			</svg>
		</button>
	</div>
	<div
		id="toast-danger"
		class="flex items-center w-full max-w-xs p-4 mb-4 rounded-lg shadow text-gray-400 bg-gray-800 toast-notification fixed top-4 right-4"
		role="alert"
		data-mode="hidden"
	>
		<div
			class="inline-flex items-center justify-center flex-shrink-0 w-8 h-8 rounded-lg bg-red-800 text-red-200"
		>
			<svg
				class="w-5 h-5"
				aria-hidden="true"
				xmlns="http://www.w3.org/2000/svg"
				fill="currentColor"
				viewBox="0 0 20 20"
			>
				<path
					d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5Zm3.707 11.793a1 1 0 1 1-1.414 1.414L10 11.414l-2.293 2.293a1 1 0 0 1-1.414-1.414L8.586 10 6.293 7.707a1 1 0 0 1 1.414-1.414L10 8.586l2.293-2.293a1 1 0 0 1 1.414 1.414L11.414 10l2.293 2.293Z"
				></path>
			</svg>
			<span class="sr-only">Error icon</span>
		</div>
		<div class="ml-3 text-sm font-normal toast-message"></div>
		<button
			type="button"
			class="ml-auto -mx-1.5 -my-1.5 rounded-lg focus:ring-2 focus:ring-gray-300 p-1.5 inline-flex items-center justify-center h-8 w-8 text-gray-500 hover:text-white bg-gray-800 hover:bg-gray-700 toast-button"
			data-dismiss-target="#toast-danger"
			aria-label="Close"
		>
			<span class="sr-only">Close</span>
			<svg
				class="w-3 h-3"
				aria-hidden="true"
				xmlns="http://www.w3.org/2000/svg"
				fill="none"
				viewBox="0 0 14 14"
			>
				<path
					stroke="currentColor"
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2"
					d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"></path>
			</svg>
		</button>
	</div>
	<div
		id="toast-warning"
		class="flex items-center w-full max-w-xs p-4 rounded-lg shadow text-gray-400 bg-gray-800 toast-notification fixed top-4 right-4"
		role="alert"
		data-mode="hidden"
	>
		<div
			class="inline-flex items-center justify-center flex-shrink-0 w-8 h-8 rounded-lg bg-orange-700 text-orange-200"
		>
			<svg
				class="w-5 h-5"
				aria-hidden="true"
				xmlns="http://www.w3.org/2000/svg"
				fill="currentColor"
				viewBox="0 0 20 20"
			>
				<path
					d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM10 15a1 1 0 1 1 0-2 1 1 0 0 1 0 2Zm1-4a1 1 0 0 1-2 0V6a1 1 0 0 1 2 0v5Z"
				></path>
			</svg>
			<span class="sr-only">Warning icon</span>
		</div>
		<div class="ml-3 text-sm font-normal toast-message"></div>
		<button
			type="button"
			class="ml-auto -mx-1.5 -my-1.5 rounded-lg focus:ring-2 focus:ring-gray-300 p-1.5 inline-flex items-center justify-center h-8 w-8 text-gray-500 hover:text-white bg-gray-800 hover:bg-gray-700 toast-button"
			data-dismiss-target="#toast-warning"
			aria-label="Close"
		>
			<span class="sr-only">Close</span>
			<svg
				class="w-3 h-3"
				aria-hidden="true"
				xmlns="http://www.w3.org/2000/svg"
				fill="none"
				viewBox="0 0 14 14"
			>
				<path
					stroke="currentColor"
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2"
					d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"></path>
			</svg>
		</button>
	</div>
</div>

<style>
	.toast-notification {
		/* Above the sticky header (z-index 20) and the leave modal (1000).
		   With z-index:auto it painted UNDERNEATH the nav bar. */
		z-index: 2000;
		/* and clear of the header rather than behind it: the bar runs
		   81–92px depending on scroll state */
		top: 6.5rem !important;
		border: 1px solid color-mix(in srgb, var(--view-accent, #18debe) 45%, transparent);
		backdrop-filter: blur(10px);
		box-shadow: 0 24px 50px -20px rgba(0, 0, 0, 0.6);
		transition: transform 420ms cubic-bezier(0.2, 0.9, 0.25, 1), opacity 300ms ease;
	}

	/* slides on its own transform now — animating `right` moved the box
	   across the whole viewport and made it easy to catch mid-flight */
	.toast-notification[data-mode='hidden'] {
		transform: translateX(calc(100% + 2rem));
		opacity: 0;
		pointer-events: none;
	}
	@media (max-width: 640px) {
		.toast-notification {
			top: 5.25rem !important;
			left: 0.75rem;
			right: 0.75rem !important;
			max-width: none;
		}
		.toast-notification[data-mode='hidden'] {
			transform: translateY(-140%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.toast-notification { transition: opacity 200ms ease; }
	}

	/* The shown state. `toast.ts` also sets these three inline, because a
	   notification that silently fails to appear is the worst kind of bug
	   and inline styles cannot lose the cascade. This rule is the belt to
	   that pair of braces. Kept last so no media query can out-order it. */
	.toast-notification[data-mode='visible'] {
		transform: none !important;
		opacity: 1 !important;
		pointer-events: auto !important;
	}
</style>
