---
// The mentors band — Campus world only. Full width of the copy column,
// under the stats row: the whole crew shot (nobody's head cropped), the
// line that earns the click, and three proof chips. Colour comes from
// --view-accent, so it stays right in either theme.
import { Icon } from 'astro-icon/components';

interface Props {
	href?: string;
	kicker?: string;
	label?: string;
	blurb?: string;
	photo?: string;
}

const {
	href = '/about',
	kicker = '// the mentors in your corner',
	label = 'Meet your mentors',
	blurb =
		'Not lecturers reading slides. Working engineers who ship for paying clients, and who will review every line you write.',
	photo = '/images/mentors-duo.jpg',
} = Astro.props;
---

<a href={href} class="mband" data-tour="team" data-mentors>
	<span class="mband__aura" aria-hidden="true"></span>
	<span class="mband__spot" aria-hidden="true"></span>

	<span class="mband__pic">
		<img src={photo} alt="The Swizel mentors" loading="lazy" width="1000" height="985" />
		<span class="mband__ring" aria-hidden="true"></span>
	</span>

	<span class="mband__body">
		<span class="mband__k">{kicker}</span>
		<span class="mband__l">
			{label}
			<Icon width={16} name="mdi:arrow-right" />
		</span>
		<span class="mband__d">{blurb}</span>
	</span>

	<span class="mband__sheen" aria-hidden="true"></span>
</a>

<style>
	.mband {
		--mb: var(--view-accent, #f59e0b);
		position: relative;
		display: grid;
		grid-template-columns: auto 1fr;
		align-items: center;
		gap: clamp(0.9rem, 2vw, 1.35rem);
		width: 100%;
		margin-top: 1rem;
		padding: 0.55rem 1rem 0.55rem 0.55rem;
		border-radius: 1.25rem;
		border: 1px solid rgba(255, 255, 255, 0.12);
		background:
			linear-gradient(115deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.02) 55%),
			color-mix(in srgb, var(--mb) 5%, transparent);
		overflow: hidden;
		isolation: isolate;
		transition: border-color 0.35s ease, transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
			box-shadow 0.35s ease;
	}
	.mband:hover {
		transform: translateY(-3px);
		border-color: color-mix(in srgb, var(--mb) 55%, transparent);
		box-shadow: 0 26px 60px -30px color-mix(in srgb, var(--mb) 70%, transparent);
	}

	/* a slow drifting wash of the world's accent, behind everything */
	.mband__aura {
		position: absolute;
		inset: -40% -10%;
		z-index: -2;
		background:
			radial-gradient(38% 60% at 18% 40%, color-mix(in srgb, var(--mb) 26%, transparent), transparent 70%),
			radial-gradient(32% 55% at 82% 65%, rgba(251, 113, 133, 0.16), transparent 70%);
		filter: blur(22px);
		opacity: 0.75;
		animation: mb-drift 14s ease-in-out infinite alternate;
		pointer-events: none;
	}
	@keyframes mb-drift {
		from { transform: translate3d(-3%, -2%, 0) scale(1); }
		to { transform: translate3d(4%, 3%, 0) scale(1.08); }
	}

	/* the pointer carries a soft light across the card */
	.mband__spot {
		position: absolute;
		inset: 0;
		z-index: -1;
		background: radial-gradient(
			220px circle at var(--mx, 50%) var(--my, 50%),
			color-mix(in srgb, var(--mb) 22%, transparent),
			transparent 70%
		);
		opacity: 0;
		transition: opacity 0.35s ease;
		pointer-events: none;
	}
	.mband:hover .mband__spot { opacity: 1; }

	/* the crew, whole: no cropped heads, the shirts and the mark in full */
	.mband__pic {
		position: relative;
		flex: none;
		width: clamp(88px, 9.5vw, 104px);
		aspect-ratio: 1000 / 985;
		border-radius: 0.85rem;
		overflow: hidden;
		background: #f5c518;
		box-shadow: 0 14px 30px -14px rgba(0, 0, 0, 0.6);
	}
	.mband__pic img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 18%;
		transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.mband:hover .mband__pic img { transform: scale(1.06); }
	/* a hairline of the accent, travelling round the frame */
	.mband__ring {
		position: absolute;
		inset: 0;
		border-radius: inherit;
		padding: 1.5px;
		background: conic-gradient(
			from var(--a, 0deg),
			transparent 0deg,
			color-mix(in srgb, var(--mb) 90%, transparent) 60deg,
			transparent 140deg,
			transparent 360deg
		);
		-webkit-mask:
			linear-gradient(#000 0 0) content-box,
			linear-gradient(#000 0 0);
		-webkit-mask-composite: xor;
		mask:
			linear-gradient(#000 0 0) content-box,
			linear-gradient(#000 0 0);
		mask-composite: exclude;
		animation: mb-spin 5.5s linear infinite;
	}
	@property --a {
		syntax: '<angle>';
		inherits: false;
		initial-value: 0deg;
	}
	@keyframes mb-spin { to { --a: 360deg; } }

	.mband__body { display: flex; flex-direction: column; gap: 0.18rem; min-width: 0; }

	.mband__k {
		display: block;
		font-family: ui-monospace, monospace;
		font-size: 0.7rem;
		letter-spacing: 0.02em;
		color: rgba(255, 255, 255, 0.5);
	}

	.mband__l {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font-size: clamp(1rem, 1.5vw, 1.12rem);
		font-weight: 800;
		letter-spacing: -0.015em;
		line-height: 1.25;
		color: #fff;
	}
	.mband__l :global(svg) { transition: transform 0.3s ease; flex: none; }
	.mband:hover .mband__l :global(svg) { transform: translateX(4px); }

	.mband__d {
		font-size: 0.8rem;
		line-height: 1.45;
		color: rgba(255, 255, 255, 0.6);
		margin-top: 0.15rem;
		max-width: 42rem;
	}


	/* a single sheen crossing the card on hover */
	.mband__sheen {
		position: absolute;
		top: -60%;
		left: -35%;
		width: 28%;
		height: 220%;
		background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.16), transparent);
		transform: rotate(14deg) translateX(-140%);
		pointer-events: none;
	}
	.mband:hover .mband__sheen { animation: mb-sheen 0.95s cubic-bezier(0.22, 1, 0.36, 1); }
	@keyframes mb-sheen { to { transform: rotate(14deg) translateX(560%); } }

	@media (max-width: 640px) {
		.mband {
			gap: 0.85rem;
			padding: 0.75rem 0.9rem 0.9rem 0.75rem;
			border-radius: 1.1rem;
			margin-top: 1.35rem;
		}
		.mband__pic { width: 88px; border-radius: 0.8rem; }
		.mband__k { font-size: 0.64rem; }
		.mband__l { font-size: 0.95rem; }
		.mband__d { font-size: 0.78rem; line-height: 1.5; }
	}

	/* ── Daylight ── */
	:global(html:not(.dark)) .mband {
		border-color: rgba(36, 23, 3, 0.12);
		background:
			linear-gradient(115deg, rgba(255, 255, 255, 0.92), rgba(255, 255, 255, 0.7) 55%),
			color-mix(in srgb, var(--mb) 6%, transparent);
	}
	:global(html:not(.dark)) .mband__aura { opacity: 0.45; }
	:global(html:not(.dark)) .mband__sheen {
		background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.55), transparent);
	}
	:global(html:not(.dark)) .mband__k { color: rgba(36, 23, 3, 0.55); }
	:global(html:not(.dark)) .mband__l { color: #241703; }
	:global(html:not(.dark)) .mband__d { color: rgba(36, 23, 3, 0.68); }

	@media (prefers-reduced-motion: reduce) {
		.mband__aura, .mband__ring { animation: none; }
		.mband:hover .mband__sheen { animation: none; }
	}
	:global(html.perf-lite) .mband__aura,
	:global(html.perf-lite) .mband__ring { animation: none; }
</style>
