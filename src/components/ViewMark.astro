---
// The world marks — one chunky, extruded, three-quarter-view object per
// world, drawn in SVG so they recolour with the world and never load a
// picture. They are the thing you actually see first on a card, so they are
// deliberately oversized and allowed to hang out of the corner.
interface Props {
	id: string;
	class?: string;
}
const { id, class: klass = '' } = Astro.props;

// face → tone. Every mark uses the same three-tone rule: a lit top, a
// mid-tone front, a shaded side, so they read as one family.
const tone: Record<string, [string, string, string]> = {
	builder: ['#6ee7d5', '#22c9ae', '#0f8f7c'],
	boardroom: ['#93d0f7', '#3fa9ec', '#1a6bab'],
	founder: ['#c9b6fd', '#8b5cf6', '#5b32b8'],
	campus: ['#fde08a', '#f4b21f', '#b3720a'],
	studio: ['#f9b0d3', '#ec4899', '#a81a63'],
	surprise: ['#8ff0dd', '#2fd3b8', '#12907c'],
};
const [lit, mid, dark] = tone[id] ?? tone.founder;
---

<svg
	class:list={['vmark', klass]}
	viewBox="0 0 128 128"
	role="img"
	aria-hidden="true"
	data-mark={id}
>
	<defs>
		<linearGradient id={`vm-lit-${id}`} x1="0" y1="0" x2="1" y2="1">
			<stop offset="0" stop-color="#ffffff" stop-opacity="0.9" />
			<stop offset="1" stop-color={lit} />
		</linearGradient>
		<linearGradient id={`vm-mid-${id}`} x1="0" y1="0" x2="0" y2="1">
			<stop offset="0" stop-color={lit} />
			<stop offset="1" stop-color={mid} />
		</linearGradient>
		<linearGradient id={`vm-dark-${id}`} x1="0" y1="0" x2="0" y2="1">
			<stop offset="0" stop-color={mid} />
			<stop offset="1" stop-color={dark} />
		</linearGradient>
		<radialGradient id={`vm-sh-${id}`} cx="0.5" cy="0.5" r="0.5">
			<stop offset="0" stop-color={dark} stop-opacity="0.55" />
			<stop offset="1" stop-color={dark} stop-opacity="0" />
		</radialGradient>
	</defs>

	<!-- the pool of shadow every mark stands in -->
	<ellipse cx="64" cy="112" rx="40" ry="9" fill={`url(#vm-sh-${id})`} />

	{
		id === 'builder' && (
			<g class="vmark__body">
				{/* left chevron — a real < with a gap before the > */}
				<path d="M48 22 L60 30 L32 62 L60 94 L48 102 L14 62 Z" fill={`url(#vm-mid-${id})`} />
				<path d="M48 22 L60 30 L32 62 L14 62 Z" fill={`url(#vm-lit-${id})`} opacity="0.9" />
				<path d="M32 62 L60 94 L48 102 L14 62 Z" fill={`url(#vm-dark-${id})`} opacity="0.85" />
				{/* right chevron */}
				<path d="M80 22 L114 62 L80 102 L68 94 L96 62 L68 30 Z" fill={`url(#vm-mid-${id})`} />
				<path d="M80 22 L114 62 L96 62 L68 30 Z" fill={`url(#vm-lit-${id})`} opacity="0.72" />
				<path d="M96 62 L114 62 L80 102 L68 94 Z" fill={`url(#vm-dark-${id})`} opacity="0.95" />
			</g>
		)
	}

	{
		id === 'boardroom' && (
			<g class="vmark__body">
				{/* three extruded columns, left to right, rising */}
				<g>
					<path d="M18 78 L34 70 L50 78 L34 86 Z" fill={`url(#vm-lit-${id})`} />
					<path d="M18 78 L34 86 L34 108 L18 100 Z" fill={`url(#vm-dark-${id})`} />
					<path d="M50 78 L34 86 L34 108 L50 100 Z" fill={`url(#vm-mid-${id})`} />
				</g>
				<g>
					<path d="M48 58 L64 50 L80 58 L64 66 Z" fill={`url(#vm-lit-${id})`} />
					<path d="M48 58 L64 66 L64 100 L48 92 Z" fill={`url(#vm-dark-${id})`} />
					<path d="M80 58 L64 66 L64 100 L80 92 Z" fill={`url(#vm-mid-${id})`} />
				</g>
				<g>
					<path d="M78 38 L94 30 L110 38 L94 46 Z" fill={`url(#vm-lit-${id})`} />
					<path d="M78 38 L94 46 L94 92 L78 84 Z" fill={`url(#vm-dark-${id})`} />
					<path d="M110 38 L94 46 L94 92 L110 84 Z" fill={`url(#vm-mid-${id})`} />
				</g>
				{/* the line that goes up and to the right */}
				<path
					d="M22 66 L46 48 L70 40 L100 18"
					fill="none"
					stroke="#ffffff"
					stroke-opacity="0.92"
					stroke-width="5"
					stroke-linecap="round"
					stroke-linejoin="round"
				/>
				<path d="M86 14 L104 12 L102 30 Z" fill="#ffffff" fill-opacity="0.92" />
			</g>
		)
	}

	{
		id === 'founder' && (
			<g class="vmark__body">
				{/* the flame */}
				<path d="M64 96 C56 104 58 116 64 120 C70 116 72 104 64 96 Z" fill="#fb7185" />
				<path d="M64 100 C60 106 61 113 64 116 C67 113 68 106 64 100 Z" fill="#fde68a" />
				{/* fins */}
				<path d="M46 66 L30 92 L46 92 Z" fill={`url(#vm-dark-${id})`} />
				<path d="M82 66 L98 92 L82 92 Z" fill={`url(#vm-dark-${id})`} />
				{/* body: lit left half, shaded right half */}
				<path d="M64 8 C46 26 44 58 46 92 L64 100 Z" fill={`url(#vm-lit-${id})`} />
				<path d="M64 8 C82 26 84 58 82 92 L64 100 Z" fill={`url(#vm-dark-${id})`} />
				<path d="M64 8 C55 17 51 34 50 52 L64 58 Z" fill="#ffffff" opacity="0.28" />
				{/* window */}
				<circle cx="64" cy="48" r="13" fill={`url(#vm-dark-${id})`} opacity="0.7" />
				<circle cx="64" cy="48" r="10" fill="#ffffff" opacity="0.92" />
				<circle cx="60" cy="44" r="3.4" fill={mid} opacity="0.5" />
			</g>
		)
	}

	{
		id === 'campus' && (
			<g class="vmark__body">
				{/* a stack of three books, seen three-quarter on */}
				<g>
					<path d="M20 84 L64 62 L108 84 L64 106 Z" fill={`url(#vm-lit-${id})`} />
					<path d="M20 84 L64 106 L64 116 L20 94 Z" fill={`url(#vm-dark-${id})`} />
					<path d="M108 84 L64 106 L64 116 L108 94 Z" fill={`url(#vm-mid-${id})`} />
				</g>
				<g opacity="0.96">
					<path d="M26 64 L64 45 L102 64 L64 83 Z" fill={`url(#vm-lit-${id})`} />
					<path d="M26 64 L64 83 L64 92 L26 73 Z" fill={`url(#vm-dark-${id})`} />
					<path d="M102 64 L64 83 L64 92 L102 73 Z" fill={`url(#vm-mid-${id})`} />
				</g>
				{/* the cap on top */}
				<path d="M18 34 L64 12 L110 34 L64 56 Z" fill={`url(#vm-mid-${id})`} />
				<path d="M18 34 L64 12 L110 34 L64 42 Z" fill={`url(#vm-lit-${id})`} opacity="0.75" />
				<path d="M64 56 L64 42 L110 34 L110 40 Z" fill={`url(#vm-dark-${id})`} opacity="0.8" />
				<path
					d="M100 38 L100 62"
					stroke="#ffffff"
					stroke-opacity="0.85"
					stroke-width="4"
					stroke-linecap="round"
				/>
				<circle cx="100" cy="66" r="6" fill="#ffffff" fill-opacity="0.9" />
			</g>
		)
	}

	{
		id === 'studio' && (
			<g class="vmark__body">
				{/* the palette slab, extruded */}
				<path
					d="M64 16 C96 16 116 38 116 62 C116 80 102 84 92 86 C82 88 78 94 82 102 C86 110 78 116 64 116 C34 116 14 94 14 66 C14 38 34 16 64 16 Z"
					fill={`url(#vm-mid-${id})`}
				/>
				<path
					d="M64 16 C96 16 116 38 116 62 C116 70 113 75 108 79 C110 55 92 28 58 24 Z"
					fill="#ffffff"
					opacity="0.22"
				/>
				<path
					d="M14 66 C14 92 34 116 64 116 C78 116 86 110 82 102 L76 108 C48 110 22 92 18 62 Z"
					fill={`url(#vm-dark-${id})`}
					opacity="0.75"
				/>
				{/* the wells */}
				<circle cx="44" cy="44" r="8" fill="#fde68a" />
				<circle cx="74" cy="38" r="8" fill="#7dd3fc" />
				<circle cx="94" cy="60" r="8" fill="#a78bfa" />
				<circle cx="40" cy="74" r="8" fill="#fb7185" />
			</g>
		)
	}

	{
		id === 'surprise' && (
			<g class="vmark__body">
				{/* a die, cleanly isometric */}
				<path d="M64 14 L110 40 L64 66 L18 40 Z" fill={`url(#vm-lit-${id})`} />
				<path d="M18 40 L64 66 L64 116 L18 90 Z" fill={`url(#vm-dark-${id})`} />
				<path d="M110 40 L64 66 L64 116 L110 90 Z" fill={`url(#vm-mid-${id})`} />
				{/* pips: top face */}
				<ellipse cx="64" cy="40" rx="6" ry="3.4" fill="#ffffff" fill-opacity="0.95" />
				<ellipse cx="42" cy="40" rx="5" ry="2.8" fill="#ffffff" fill-opacity="0.75" />
				<ellipse cx="86" cy="40" rx="5" ry="2.8" fill="#ffffff" fill-opacity="0.75" />
				{/* pips: left face */}
				<ellipse cx="32" cy="66" rx="4.6" ry="5.6" fill="#ffffff" fill-opacity="0.62" />
				<ellipse cx="50" cy="90" rx="4.6" ry="5.6" fill="#ffffff" fill-opacity="0.62" />
				{/* pips: right face */}
				<ellipse cx="78" cy="80" rx="4.6" ry="5.6" fill="#ffffff" fill-opacity="0.5" />
				<ellipse cx="96" cy="70" rx="4.6" ry="5.6" fill="#ffffff" fill-opacity="0.5" />
			</g>
		)
	}
</svg>

<style>
	.vmark {
		display: block;
		width: 100%;
		height: auto;
		overflow: visible;
		filter: drop-shadow(0 14px 22px rgba(0, 0, 0, 0.35));
	}
	.vmark__body {
		transform-origin: 64px 64px;
		transition: transform 0.42s cubic-bezier(0.34, 1.56, 0.64, 1);
		animation: vmark-hover 6s ease-in-out infinite;
	}
	@keyframes vmark-hover {
		0%, 100% { transform: translateY(0) rotate(0deg); }
		50% { transform: translateY(-5px) rotate(-1.5deg); }
	}
	@media (prefers-reduced-motion: reduce) {
		.vmark__body { animation: none; }
	}
</style>
