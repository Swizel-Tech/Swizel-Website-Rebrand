---
// A whiteboard with a real class projected on it. The video is a YouTube
// embed with YouTube's own chrome switched off: every control you see is
// drawn into the board furniture (the aluminium ledge, a marker seek line,
// marker-cap buttons). When the reel ends we cover the frame with our own
// "that's the class" card before YouTube can offer anybody else's videos.
import { Icon } from 'astro-icon/components';

interface Props {
	videoId: string;
	title?: string;
	kicker?: string;
	stickyA?: string;
	stickyB?: string;
	ctaHref?: string;
	ctaLabel?: string;
	class?: string;
	tilt?: boolean;
}

const {
	videoId,
	title = 'today: build something real',
	kicker = 'Lecture recording',
	stickyA = 'ship > perfect',
	stickyB = 'demo friday!',
	ctaHref = '/programs',
	ctaLabel = 'Join the bootcamp',
	class: klass = '',
	tilt = true,
} = Astro.props;

const rates = [0.5, 0.75, 1, 1.25, 1.5, 2];
---

<div
	class:list={['wbv', klass, tilt && 'wbv--tilt']}
	data-wbv
	data-video-id={videoId}
	tabindex="0"
	role="region"
	aria-label="Class recording"
>
	<!-- board head: date + marker headline -->
	<div class="wbv__head">
		<p class="wbv__title">
			{title}
			<span class="wbv__swish" aria-hidden="true"></span>
		</p>
		<span class="wbv__date" data-wbv-date>Mon, 1 Jan</span>
	</div>

	<!-- the projected screen -->
	<div class="wbv__screen" data-wbv-screen data-cursor="video">
		<div class="wbv__mount" data-wbv-mount></div>

		<!-- YouTube never sees a pointer, so it never draws its own chrome -->
		<button class="wbv__shield" type="button" data-wbv-shield hidden aria-label="Play or pause"></button>

		<!-- our paused state, in place of YouTube's -->
		<div class="wbv__paused" data-wbv-paused hidden aria-hidden="true">
			<span class="wbv__paused-ic"><Icon width={30} name="mdi:pause" /></span>
			<span class="wbv__paused-t">paused</span>
			<span class="wbv__paused-s">click the board to carry on</span>
		</div>

		<!-- facade: nothing from YouTube loads until this is pressed -->
		<button class="wbv__poster" type="button" data-wbv-play aria-label="Play the class recording">
			<img
				class="wbv__thumb"
				src={`https://i.ytimg.com/vi/${videoId}/maxresdefault.jpg`}
				data-wbv-thumb
				data-fallback={`https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`}
				alt=""
				loading="lazy"
				decoding="async"
				width="1280"
				height="720"
			/>
			<span class="wbv__scrim" aria-hidden="true"></span>

			<span class="wbv__cue" aria-hidden="true">
				<span class="wbv__bigwrap">
					<span class="wbv__pulse"></span>
					<svg class="wbv__ring" viewBox="0 0 100 100">
						<circle class="wbv__ring-bg" cx="50" cy="50" r="46" />
						<circle class="wbv__ring-fg" cx="50" cy="50" r="46" />
					</svg>
					<span class="wbv__big">
						<Icon width={34} name="mdi:play" />
					</span>
				</span>
				<span class="wbv__count" data-wbv-count hidden>
					class starts in <b data-wbv-countn>4</b>
				</span>
			</span>

			<span class="wbv__label">
				<b>Watch a real class</b>
				<i>{kicker}</i>
			</span>
		</button>

		<button class="wbv__sound" type="button" data-wbv-sound hidden>
			<span class="wbv__sound-ic"><Icon width={20} name="mdi:volume-off" /></span>
			<span class="wbv__sound-txt">
				<b>Sound is off</b>
				<i>tap to hear the class</i>
			</span>
		</button>

		<!-- spinner while the player boots -->
		<span class="wbv__boot" data-wbv-boot hidden aria-hidden="true">
			<i></i><i></i><i></i>
		</span>

		<!-- our own end card. YouTube never gets to suggest anything. -->
		<div class="wbv__end" data-wbv-end hidden>
			<span class="wbv__end-mark" aria-hidden="true"></span>
			<p class="wbv__end-t">that's the class.</p>
			<p class="wbv__end-s">Now go build something people actually use.</p>
			<div class="wbv__end-row">
				<button class="wbv__replay" type="button" data-wbv-replay>
					<Icon width={19} name="mdi:replay" />
					Watch again
				</button>
				<a class="wbv__end-cta" href={ctaHref}>
					{ctaLabel}
					<Icon width={16} name="mdi:arrow-right" />
				</a>
			</div>
		</div>
	</div>

	<!-- the seek line: drawn on the board in marker -->
	<div class="wbv__seekrow" data-wbv-tray hidden>
		<span class="wbv__t" data-wbv-cur>0:00</span>
		<span class="wbv__seek">
			<span class="wbv__seek-line" aria-hidden="true"></span>
			<span class="wbv__seek-buf" data-wbv-buf aria-hidden="true"></span>
			<span class="wbv__seek-fill" data-wbv-fill aria-hidden="true"></span>
			<span class="wbv__seek-cap" data-wbv-cap aria-hidden="true"></span>
			<input
				class="wbv__range"
				type="range"
				min="0"
				max="1000"
				value="0"
				step="1"
				aria-label="Seek through the recording"
				data-wbv-range
			/>
		</span>
		<span class="wbv__t wbv__t--dur" data-wbv-dur>0:00</span>
	</div>

	<!-- the ledge: markers on the left, the controls on the right -->
	<div class="wbv__ledge">
		<span class="wbv__markers" aria-hidden="true">
			<i class="wbv__marker wbv__marker--r"></i>
			<i class="wbv__marker wbv__marker--b"></i>
			<i class="wbv__marker wbv__marker--g"></i>
			<i class="wbv__eraser"></i>
		</span>

		<div class="wbv__btns">
			<button class="wbv__btn wbv__btn--main" type="button" data-wbv-toggle aria-label="Play">
				<Icon class="wbv__i-play" width={19} name="mdi:play" />
				<Icon class="wbv__i-pause" width={19} name="mdi:pause" />
			</button>
			<button class="wbv__btn" type="button" data-wbv-back aria-label="Back 10 seconds">
				<Icon width={18} name="mdi:rewind-10" />
			</button>
			<button class="wbv__btn" type="button" data-wbv-fwd aria-label="Forward 10 seconds">
				<Icon width={18} name="mdi:fast-forward-10" />
			</button>

			<span class="wbv__gap"></span>

			<span class="wbv__speed">
				<button
					class="wbv__btn wbv__btn--rate"
					type="button"
					data-wbv-speed
					aria-haspopup="true"
					aria-expanded="false"
					aria-label="Playback speed"
				>
					<b data-wbv-rate>1&times;</b>
				</button>
				<span class="wbv__menu" data-wbv-menu hidden role="menu">
					<em>Speed</em>
					{
						rates.map((r) => (
							<button
								class:list={['wbv__rate', r === 1 && 'is-on']}
								type="button"
								role="menuitem"
								data-rate={r}
							>
								{r === 1 ? 'Normal' : `${r}×`}
							</button>
						))
					}
				</span>
			</span>

			<button class="wbv__btn wbv__btn--mute" type="button" data-wbv-mute aria-label="Mute">
				<Icon class="wbv__i-vol" width={18} name="mdi:volume-high" />
				<Icon class="wbv__i-mute" width={18} name="mdi:volume-off" />
				<b class="wbv__mutelabel">Muted</b>
			</button>
			<input
				class="wbv__vol"
				type="range"
				min="0"
				max="100"
				value="100"
				step="1"
				aria-label="Volume"
				data-wbv-vol
			/>

			<button class="wbv__btn" type="button" data-wbv-fs aria-label="Full screen">
				<Icon class="wbv__i-fs" width={18} name="mdi:fullscreen" />
				<Icon class="wbv__i-fsx" width={18} name="mdi:fullscreen-exit" />
			</button>
		</div>
	</div>

	<span class="wbv__sticky wbv__sticky--y">{stickyA}</span>
	<span class="wbv__sticky wbv__sticky--p">{stickyB}</span>
</div>

<style>
	.wbv {
		--wbv-marker: 'Bradley Hand', 'Segoe Print', 'Comic Sans MS', cursive;
		--wbv-blue: #1d4ed8;
		--wbv-red: #dc2626;
		--wbv-frame: #d4dae1;
		position: relative;
		background: #fbfcfd;
		border: 7px solid var(--wbv-frame);
		border-bottom-width: 7px;
		border-radius: 0.9rem;
		padding: 1.15rem 1.15rem 0;
		box-shadow:
			inset 0 0 60px rgba(29, 78, 216, 0.04),
			0 34px 80px -30px rgba(0, 0, 0, 0.55);
		transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
		outline: none;
		/* faint ghost of yesterday's lesson, wiped but never quite gone */
		background-image:
			radial-gradient(420px 160px at 82% 4%, rgba(29, 78, 216, 0.05), transparent 70%),
			radial-gradient(360px 140px at 8% 92%, rgba(220, 38, 38, 0.04), transparent 70%);
	}
	.wbv--tilt { transform: rotate(-1deg); }
	.wbv--tilt:hover,
	.wbv:focus-visible { transform: rotate(0deg); }
	.wbv:focus-visible { box-shadow: 0 0 0 3px rgba(29, 78, 216, 0.45), 0 34px 80px -30px rgba(0, 0, 0, 0.55); }

	/* ── head ── */
	.wbv__head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.9rem;
	}
	.wbv__title {
		position: relative;
		display: inline-block;
		font-family: var(--wbv-marker);
		font-size: clamp(1.1rem, 2.2vw, 1.5rem);
		font-weight: 700;
		color: var(--wbv-blue);
		margin: 0;
		transform: rotate(-1deg);
	}
	.wbv__swish {
		position: absolute;
		left: 0;
		right: -6px;
		bottom: -7px;
		height: 5px;
		border-radius: 9999px;
		background: var(--wbv-red);
		opacity: 0.85;
		transform: rotate(-0.6deg);
	}
	.wbv__date {
		font-family: var(--wbv-marker);
		font-size: 0.86rem;
		color: #64748b;
		white-space: nowrap;
	}

	/* ── the screen ── */
	.wbv__screen {
		position: relative;
		width: 100%;
		min-width: 0;
		aspect-ratio: 16 / 9;
		border-radius: 0.7rem;
		overflow: hidden;
		background: #0b1220;
		box-shadow:
			0 0 0 2px rgba(29, 78, 216, 0.18),
			0 18px 40px -22px rgba(15, 23, 42, 0.7);
	}
	.wbv__mount,
	.wbv__screen :global(iframe) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
		display: block;
	}

	/* facade */
	.wbv__poster {
		position: absolute;
		inset: 0;
		z-index: 3;
		display: grid;
		place-items: center;
		cursor: pointer;
		border: 0;
		padding: 0;
		background: #0b1220;
		overflow: hidden;
	}
	.wbv__thumb {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transform: scale(1.02);
		transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1), filter 0.4s ease;
	}
	.wbv__poster:hover .wbv__thumb { transform: scale(1.06); filter: brightness(1.05); }
	.wbv__scrim {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(58% 58% at 50% 46%, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.34) 100%),
			linear-gradient(180deg, transparent 52%, rgba(4, 8, 18, 0.72));
	}
	/* the cue: play button, countdown ring, and the line underneath */
	.wbv__cue {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.85rem;
		transform: translateY(-4px);
	}
	.wbv__bigwrap {
		position: relative;
		display: grid;
		place-items: center;
		width: 78px;
		height: 78px;
	}
	.wbv__ring {
		position: absolute;
		inset: -14px;
		width: calc(100% + 28px);
		height: calc(100% + 28px);
		transform: rotate(-90deg);
		opacity: 0;
		transition: opacity 0.3s ease;
	}
	.wbv__ring-bg,
	.wbv__ring-fg {
		fill: none;
		stroke-width: 4;
		stroke-linecap: round;
	}
	.wbv__ring-bg { stroke: rgba(4, 8, 18, 0.55); stroke-width: 5; }
	.wbv__ring-fg {
		stroke: #fcd34d;
		stroke-width: 5;
		stroke-dasharray: 289;
		stroke-dashoffset: 289;
		filter: drop-shadow(0 0 6px rgba(252, 211, 77, 0.75));
	}
	.wbv[data-counting] .wbv__ring { opacity: 1; }
	.wbv[data-counting] .wbv__ring-fg {
		animation: wbv-ring var(--wbv-cd, 4s) linear forwards;
	}
	@keyframes wbv-ring { to { stroke-dashoffset: 0; } }
	/* while it counts down, the button asks to be pressed */
	.wbv[data-counting] .wbv__big { animation: wbv-throb 0.85s ease-in-out infinite; }
	@keyframes wbv-throb {
		0%, 100% { transform: scale(1); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.6), 0 14px 34px -10px rgba(245, 158, 11, 0.75); }
		50% { transform: scale(1.09); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.6), 0 18px 46px -8px rgba(245, 158, 11, 0.95); }
	}
	.wbv__count {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--wbv-marker);
		font-size: 1rem;
		font-weight: 700;
		color: #fff;
		padding: 0.3rem 0.4rem 0.3rem 0.85rem;
		border-radius: 9999px;
		background: rgba(4, 8, 18, 0.72);
		border: 1px solid rgba(255, 255, 255, 0.12);
		box-shadow: 0 12px 28px -14px rgba(0, 0, 0, 0.9);
	}
	.wbv__count[hidden] { display: none; }
	.wbv__count b {
		display: inline-grid;
		place-items: center;
		min-width: 1.75rem;
		height: 1.75rem;
		padding: 0 0.35rem;
		border-radius: 0.5rem;
		font-size: 1.05rem;
		color: #2b1c08;
		background: linear-gradient(180deg, #fde68a, #f59e0b);
		text-shadow: none;
	}

	/* A reel that starts itself must start silent, so the fact that it is
	   silent has to be unmissable — tosky thought his speakers had died. */
	.wbv__sound {
		position: absolute;
		left: 50%;
		bottom: 1.1rem;
		z-index: 4;
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		text-align: left;
		color: #2b1c08;
		background: linear-gradient(180deg, #fde68a, #f59e0b);
		padding: 0.55rem 1.1rem 0.55rem 0.6rem;
		border-radius: 9999px;
		cursor: pointer;
		border: 1px solid rgba(120, 67, 5, 0.35);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.6),
			0 14px 34px -12px rgba(0, 0, 0, 0.85);
		transform: translateX(-50%);
		animation:
			wbv-soundin 0.45s cubic-bezier(0.22, 1, 0.36, 1) both,
			wbv-soundbeat 1.9s ease-in-out 0.5s infinite;
	}
	.wbv__sound[hidden] { display: none; }
	.wbv__sound:hover { filter: brightness(1.06); }
	.wbv__sound-ic {
		display: grid;
		place-items: center;
		width: 34px;
		height: 34px;
		flex: none;
		border-radius: 9999px;
		color: #fff;
		background: #b91c1c;
		box-shadow: 0 0 0 3px rgba(185, 28, 28, 0.22);
	}
	.wbv__sound-txt { display: flex; flex-direction: column; line-height: 1.15; white-space: nowrap; }
	.wbv__sound-txt b { font-size: 0.9rem; font-weight: 900; letter-spacing: -0.01em; }
	.wbv__sound-txt i {
		font-style: normal;
		font-size: 0.72rem;
		font-weight: 700;
		opacity: 0.72;
		white-space: nowrap;
	}
	@keyframes wbv-soundin { from { opacity: 0; transform: translateX(-50%) translateY(8px); } to { opacity: 1; transform: translateX(-50%); } }
	@keyframes wbv-soundbeat {
		0%, 100% { box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.6), 0 14px 34px -12px rgba(0, 0, 0, 0.85), 0 0 0 0 rgba(245, 158, 11, 0.55); }
		55% { box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.6), 0 14px 34px -12px rgba(0, 0, 0, 0.85), 0 0 0 12px rgba(245, 158, 11, 0); }
	}

	/* the ledge button says it in words too */
	.wbv__mutelabel { display: none; }
	.wbv[data-muted] .wbv__btn--mute {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: auto;
		height: 34px;
		gap: 0.35rem;
		padding: 0 0.65rem;
		color: #fff;
		background: linear-gradient(180deg, #ef4444, #b91c1c);
		border-color: rgba(127, 29, 29, 0.6);
		animation: wbv-mutebeat 1.6s ease-in-out infinite;
	}
	.wbv[data-muted] .wbv__btn--mute:hover { color: #fff; background: linear-gradient(180deg, #f87171, #dc2626); }
	.wbv[data-muted] .wbv__mutelabel {
		display: inline-block;
		line-height: 1;
		font-size: 0.72rem;
		font-weight: 900;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	@keyframes wbv-mutebeat {
		0%, 100% { box-shadow: 0 0 0 0 rgba(220, 38, 38, 0.5); }
		60% { box-shadow: 0 0 0 8px rgba(220, 38, 38, 0); }
	}
	.wbv[data-muted] .wbv__vol { opacity: 0.4; }

	.wbv__big {
		position: relative;
		display: grid;
		place-items: center;
		width: 78px;
		height: 78px;
		border-radius: 9999px;
		color: #2b1c08;
		background: linear-gradient(180deg, #fde68a, #f59e0b);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.6),
			0 14px 34px -10px rgba(245, 158, 11, 0.75);
		transition: transform 0.25s ease;
	}
	.wbv__big :global(svg) { margin-left: 4px; }
	.wbv__poster:hover .wbv__big { transform: scale(1.07); }
	.wbv__pulse {
		position: absolute;
		inset: 0;
		border-radius: 9999px;
		border: 2px solid rgba(252, 211, 77, 0.7);
		animation: wbv-pulse 2.4s ease-out infinite;
	}
	@keyframes wbv-pulse {
		0% { transform: scale(1); opacity: 0.75; }
		70% { transform: scale(1.9); opacity: 0; }
		100% { opacity: 0; }
	}
	.wbv__label {
		position: absolute;
		left: 1rem;
		bottom: 0.95rem;
		display: flex;
		flex-direction: column;
		text-align: left;
		color: #fff;
	}
	.wbv__label b { font-size: 0.98rem; font-weight: 800; letter-spacing: -0.01em; }
	.wbv__label i {
		font-style: normal;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.13em;
		text-transform: uppercase;
		color: #fcd34d;
		margin-top: 0.15rem;
	}

	/* the shield: swallows every pointer event bound for the embed */
	.wbv__shield {
		position: absolute;
		inset: 0;
		z-index: 2;
		border: 0;
		padding: 0;
		background: transparent;
		cursor: pointer;
	}
	.wbv__shield[hidden] { display: none; }

	/* our paused card, so YouTube's never gets a turn */
	.wbv__paused {
		position: absolute;
		inset: 0;
		z-index: 3;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.15rem;
		pointer-events: none;
		background:
			radial-gradient(60% 60% at 50% 45%, rgba(4, 8, 18, 0.55), rgba(4, 8, 18, 0.86) 100%);
		animation: wbv-fade 0.22s ease both;
	}
	.wbv__paused[hidden] { display: none; }
	@keyframes wbv-fade { from { opacity: 0; } to { opacity: 1; } }
	.wbv__paused-ic {
		display: grid;
		place-items: center;
		width: 68px;
		height: 68px;
		border-radius: 9999px;
		color: #2b1c08;
		background: linear-gradient(180deg, #fde68a, #f59e0b);
		box-shadow: 0 14px 34px -12px rgba(245, 158, 11, 0.8);
		margin-bottom: 0.6rem;
	}
	.wbv__paused-t {
		font-family: var(--wbv-marker);
		font-size: 1.5rem;
		font-weight: 700;
		color: #fff;
		transform: rotate(-1.5deg);
	}
	.wbv__paused-s {
		font-size: 0.76rem;
		letter-spacing: 0.02em;
		color: rgba(255, 255, 255, 0.6);
	}
	@media (max-width: 620px) {
		.wbv__paused-ic { width: 54px; height: 54px; }
		.wbv__paused-t { font-size: 1.2rem; }
	}

	/* boot spinner */
	.wbv__boot {
		position: absolute;
		inset: 0;
		z-index: 4;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 7px;
		background: rgba(11, 18, 32, 0.9);
	}
	.wbv__boot[hidden] { display: none; }
	.wbv__boot i {
		width: 9px;
		height: 9px;
