---
// The gamified journey board. It used to live in the campus hero; the
// class recording took that seat, so the game moved down here where it
// has room to be a proper scoreboard. The DOM contract (#campus-widget,
// .cw--* hooks, data-pct) is unchanged — campusView.ts still drives it.
import { Icon } from 'astro-icon/components';

const levels = [
	{ name: 'Learn', pct: 20 },
	{ name: 'Build', pct: 50 },
	{ name: 'Ship', pct: 80 },
	{ name: 'Hired', pct: 100 },
];

const badges = [
	{ name: 'Web', pct: 18 },
	{ name: 'Mobile', pct: 42 },
	{ name: 'Design', pct: 66 },
	{ name: 'Marketing', pct: 88 },
];

const builds = [
	{ name: 'Physio clinic', tag: 'like Anchorstep' },
	{ name: 'Sports platform', tag: 'like Betslipswitch' },
	{ name: 'Online store', tag: 'like Brixmarket' },
	{ name: 'Brand campaign', tag: 'like Purple Panda' },
];
---

<div class="campus--widget" id="campus-widget" data-tour="game">
	<div class="cw--confetti" aria-hidden="true">
		{Array.from({ length: 14 }).map((_, i) => <span style={`--i:${i}`} />)}
	</div>

	<div class="cw--head">
		<div>
			<span class="cw--title">Your tech journey</span>
			<span class="cw--subt">from newbie to hired</span>
		</div>
		<button class="cw--start" type="button" data-cw-start>
			<Icon width={14} name="mdi:play" />
			<span class="cw--start-txt">Start</span>
		</button>
	</div>

	<div class="cw--grid">
		<div class="cw--left">
			<div class="cw--xprow">
				<span class="cw--level" id="cw-level">Level 0 · Newbie</span>
				<span class="cw--xp" id="cw-xp">0 XP</span>
			</div>

			<div class="cw--track" data-tour="track">
				<div class="cw--bar"><span class="cw--fill" id="cw-fill"></span></div>
				<span class="cw--avatar" id="cw-avatar"><Icon width={16} name="mdi:rocket-launch" /></span>
				<ol class="cw--levels">
					{
						levels.map((l) => (
							<li class="cw--node" data-pct={l.pct}>
								<span class="cw--nodedot" />
								<span class="cw--nodename">{l.name}</span>
							</li>
						))
					}
				</ol>
			</div>

			<div class="cw--badges" data-tour="badges">
				{
					badges.map((bdg) => (
						<span class="cw--badge" data-pct={bdg.pct}>
							<Icon width={13} name="mdi:check-decagram" />
							{bdg.name}
						</span>
					))
				}
			</div>
		</div>

		<div class="cw--builds" data-tour="builds">
			<span class="cw--builds-label">What you will build, across sectors</span>
			<div class="cw--buildcards">
				{
					builds.map((bld, i) => (
						<span class="cw--buildcard" style={`--i:${i}`}>
							<span class="cw--build-name">{bld.name}</span>
							<span class="cw--build-tag">{bld.tag}</span>
						</span>
					))
				}
			</div>
		</div>
	</div>
</div>

<style>
	/* ===== gamified widget ===== */
	.campus--widget { position: relative; border-radius: 1.25rem; padding: clamp(1.2rem, 2.6vw, 2rem); background: rgba(29, 22, 6, 0.6); border: 1px solid rgba(245, 158, 11, 0.25); backdrop-filter: blur(14px); box-shadow: 0 40px 90px -40px rgba(0, 0, 0, 0.85); overflow: hidden; }
	.cw--head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.4rem; }
	.cw--title { font-size: clamp(1.15rem, 2.2vw, 1.5rem); font-weight: 800; color: #fff; }
	.cw--subt { display: block; font-size: 0.8rem; color: rgba(253, 243, 227, 0.55); }
	.cw--start { display: inline-flex; align-items: center; gap: 0.45rem; font-size: 0.8rem; font-weight: 800; color: #2a1c02; background: linear-gradient(95deg, #fde68a, #f59e0b); padding: 0.6rem 1.1rem; border-radius: 9999px; cursor: pointer; transition: transform 0.2s ease, filter 0.2s ease; flex: none; }
	.cw--start:hover { transform: translateY(-1px); filter: brightness(1.05); }

	/* wide slot: the game on the left, what you will build on the right */
	.cw--grid { display: grid; gap: clamp(1.4rem, 3vw, 2.4rem); align-items: start; }
	@media (min-width: 900px) { .cw--grid { grid-template-columns: 1.15fr 0.85fr; } }
	.cw--grid > * { min-width: 0; }

	.cw--xprow { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 0.7rem; }
	.cw--level { font-size: 0.86rem; font-weight: 700; color: #fcd34d; }
	.cw--xp { font-family: 'Bebas Neue', sans-serif; font-size: clamp(1.4rem, 2.6vw, 1.9rem); color: #fff; letter-spacing: 1px; }

	.cw--track { position: relative; margin-bottom: 1.6rem; }
	.cw--bar { height: 14px; border-radius: 9999px; background: rgba(255, 255, 255, 0.08); overflow: hidden; }
	.cw--fill { display: block; height: 100%; width: 0%; border-radius: 9999px; background: linear-gradient(90deg, #fde68a, #f59e0b, #fb7185); }
	.cw--avatar { position: absolute; top: -8px; left: 0%; transform: translateX(-50%); width: 30px; height: 30px; display: grid; place-items: center; border-radius: 9999px; background: #f59e0b; color: #2a1c02; box-shadow: 0 6px 16px -4px rgba(245, 158, 11, 0.7); }
	.cw--levels { display: flex; justify-content: space-between; margin-top: 0.9rem; padding: 0; list-style: none; }
	.cw--node { display: flex; flex-direction: column; align-items: center; gap: 0.3rem; }
	.cw--nodedot { width: 11px; height: 11px; border-radius: 9999px; background: rgba(255, 255, 255, 0.15); transition: background 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease; }
	.cw--node.is-on .cw--nodedot { background: #f59e0b; transform: scale(1.3); box-shadow: 0 0 0 4px rgba(245, 158, 11, 0.25); }
	.cw--nodename { font-size: 0.74rem; color: rgba(253, 243, 227, 0.5); }
	.cw--node.is-on .cw--nodename { color: #fcd34d; font-weight: 700; }

	.cw--badges { display: flex; flex-wrap: wrap; gap: 0.5rem; }
	.cw--badge { display: inline-flex; align-items: center; gap: 0.3rem; font-size: 0.78rem; font-weight: 600; padding: 0.4rem 0.75rem; border-radius: 9999px; border: 1px solid rgba(255, 255, 255, 0.12); background: rgba(255, 255, 255, 0.03); color: rgba(253, 243, 227, 0.55); opacity: 0.45; transform: scale(0.92); transition: all 0.3s ease; }
	.cw--badge :global(svg) { opacity: 0.5; }
	.cw--badge.is-on { opacity: 1; transform: scale(1); border-color: rgba(245, 158, 11, 0.5); background: rgba(245, 158, 11, 0.12); color: #fcd34d; }

	.cw--builds { padding-top: 1rem; border-top: 1px dashed rgba(255, 255, 255, 0.1); }
	@media (min-width: 900px) { .cw--builds { padding-top: 0; border-top: 0; border-left: 1px dashed rgba(255, 255, 255, 0.1); padding-left: clamp(1.4rem, 3vw, 2.4rem); } }
	.cw--builds-label { display: block; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; color: rgba(253, 243, 227, 0.5); margin-bottom: 0.7rem; }
	.cw--buildcards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.55rem; }
	.cw--buildcard { display: flex; flex-direction: column; gap: 0.1rem; padding: 0.75rem 0.9rem; border-radius: 0.7rem; border: 1px solid rgba(245, 158, 11, 0.16); background: rgba(245, 158, 11, 0.04); opacity: 0.5; transition: opacity 0.3s ease; }
	/* they sit there quietly, then light up when you finish the run */
	.campus--widget.is-complete .cw--buildcard { animation: cwcard 0.5s cubic-bezier(0.22, 1, 0.36, 1) forwards; animation-delay: calc(var(--i) * 0.1s); }
	@keyframes cwcard {
		0% { opacity: 0.5; transform: translateY(6px) scale(0.985); }
		100% { opacity: 1; transform: none; border-color: rgba(245, 158, 11, 0.34); background: rgba(245, 158, 11, 0.09); }
	}
	.cw--build-name { font-size: 0.86rem; font-weight: 700; color: #fff; }
	.cw--build-tag { font-size: 0.72rem; color: #fcd34d; }

	/* confetti */
	.cw--confetti { position: absolute; inset: 0; pointer-events: none; }
	.cw--confetti span { position: absolute; top: 30%; left: calc(8% + var(--i) * 6.5%); width: 8px; height: 8px; border-radius: 2px; background: hsl(calc(20 + var(--i) * 26) 90% 60%); opacity: 0; }
	.campus--widget.is-complete .cw--confetti span { animation: cwfetti 1.1s ease-out forwards; animation-delay: calc(var(--i) * 0.03s); }
	@keyframes cwfetti {
		0% { opacity: 1; transform: translateY(0) rotate(0); }
		100% { opacity: 0; transform: translateY(220px) rotate(540deg); }
	}
	@media (max-width: 520px) {
		.cw--head { flex-wrap: wrap; }
		.cw--buildcards { grid-template-columns: 1fr; }
	}

	/* ══ Light mode ══ */
	:global(html:not(.dark)) .campus--widget {
		background: rgba(255, 255, 255, 0.82);
		border-color: rgba(180, 83, 9, 0.25);
		box-shadow: 0 40px 90px -44px rgba(36, 23, 3, 0.35);
	}
	:global(html:not(.dark)) .cw--title { color: #241703; }
	:global(html:not(.dark)) .cw--subt { color: rgba(36, 23, 3, 0.55); }
	:global(html:not(.dark)) .cw--level { color: #b45309; }
	:global(html:not(.dark)) .cw--xp { color: #241703; }
	:global(html:not(.dark)) .cw--bar { background: rgba(36, 23, 3, 0.1); }
	:global(html:not(.dark)) .cw--nodedot { background: rgba(36, 23, 3, 0.18); }
	:global(html:not(.dark)) .cw--nodename { color: rgba(36, 23, 3, 0.55); }
	:global(html:not(.dark)) .cw--node.is-on .cw--nodename { color: #b45309; }
	:global(html:not(.dark)) .cw--badge {
		border-color: rgba(36, 23, 3, 0.14);
		background: rgba(255, 255, 255, 0.5);
		color: rgba(36, 23, 3, 0.6);
	}
	:global(html:not(.dark)) .cw--badge.is-on {
		border-color: rgba(180, 83, 9, 0.5);
		background: rgba(245, 158, 11, 0.14);
		color: #92400e;
	}
	:global(html:not(.dark)) .cw--builds { border-top-color: rgba(36, 23, 3, 0.14); border-left-color: rgba(36, 23, 3, 0.14); }
	:global(html:not(.dark)) .cw--builds-label { color: rgba(36, 23, 3, 0.55); }
	:global(html:not(.dark)) .cw--build-name { color: #241703; }
	:global(html:not(.dark)) .cw--build-tag { color: #b45309; }
</style>
