---
// The Swizel spotlight — what "we stay after launch" actually looks like.
//
// Launch day is where most agencies stop. This section is the argument that
// we don't: one real client, picked out and followed. Swizel built the site
// and the booking system, then took the brand and both social accounts too,
// and the numbers kept moving.
//
// The layout is editorial rather than a grid of cards: three handsets stood
// up beside one wide column of argument, a single rule of numbers, and a
// wall of prints from the job. Everything carries our tag. This is a Swizel
// page about Swizel's work, told through somebody we grew.
import { Icon } from 'astro-icon/components';

const delivered = [
	{ n: '01', t: 'The website', d: 'Designed, built, hosted and monitored by us.' },
	{ n: '02', t: 'Booking & records', d: 'Intake forms, home visits, client notes.' },
	{ n: '03', t: 'Brand & content', d: 'Identity, price list, the whole visual kit.' },
	{ n: '04', t: 'Instagram & TikTok', d: 'Shot, written, posted and grown. Still ours.' },
];

const shots = [
	{ img: '/images/spotlight/work-2.jpg', cap: 'Home visit, Abuja', r: '-3.2deg' },
	{ img: '/images/spotlight/work-1.jpg', cap: 'Post-op rehab', r: '2.4deg' },
	{ img: '/images/spotlight/work-4.jpg', cap: 'In the clinic', r: '-1.6deg' },
	{ img: '/images/spotlight/work-3.jpg', cap: 'Sessions at home', r: '3deg' },
];

// Instagram 3,150+ and TikTok 950+, counted together, because we run both.
const numbers = [
	{ v: '4,100+', l: 'Followers' },
	{ v: '23.6K', l: 'Likes' },
	{ v: '40+', l: 'Posts by us' },
	{ v: '<1', l: 'Month to live' },
];

const links = [
	{ href: 'https://anchorsteppt.com', icon: 'mdi:web', label: 'Website' },
	{ href: 'https://www.instagram.com/anchorsteppt', icon: 'mdi:instagram', label: 'Instagram' },
	{ href: 'https://www.tiktok.com/@ptruke', icon: 'tiktok', label: 'TikTok' },
	{ href: 'https://m.facebook.com/anchorsteppt/', icon: 'mdi:facebook', label: 'Facebook' },
];
---

<section class="spot" id="fd-spotlight" data-cursor="quote">
	<span class="spot__ground" aria-hidden="true">
		<span class="spot__beam"></span>
	</span>

	<div class="spot__wrap">
		<header class="spot__head fd-rev">
			<span class="spot__stamp">
				<Icon width={13} name="mdi:spotlight-beam" />
				Swizel spotlight · No. 01
			</span>
			<h2 class="spot__h">We built it. <em>Then we grew it.</em></h2>
			<p class="spot__p">
				Launch day is where most studios stop. This is what happens when we
				don't. One Abuja practice, picked out and followed.
			</p>
		</header>

		<div class="spot__stage">
			<!-- ── three handsets: her cut, and the two accounts we run ── -->
			<div class="spot__devices fd-rev" style="--i:1">
				<figure class="spot__dev spot__dev--tt">
					<span class="spot__point" aria-hidden="true">
						<span class="spot__point-t">
							<svg viewBox="0 0 24 24" fill="currentColor" width="13" height="13"><path d="M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.21v12.67a2.59 2.59 0 1 1-2.59-2.59c.27 0 .53.04.78.12v-3.3a5.88 5.88 0 0 0-.78-.05 5.85 5.85 0 1 0 5.85 5.85V8.66a7.5 7.5 0 0 0 4.37 1.4V6.85a4.28 4.28 0 0 1-3.36-1.03z" /></svg>
							TikTok, ours
						</span>
						<em>23.6K likes</em>
						<svg class="spot__point-a" viewBox="0 0 44 46">
							<path class="spot__point-line" d="M22 3C13 12 31 22 22 37" />
							<path class="spot__point-head" d="M15 30L22 38L29 30" />
						</svg>
					</span>
					<span class="spot__screen">
						<img
							src="/images/spotlight/tiktok.jpg"
							alt="The AnchorStep TikTok account, run by Swizel: 950+ followers and 23.6K likes"
							width="587"
							height="1206"
							loading="lazy"
							decoding="async"
						/>
					</span>
				</figure>

				<figure class="spot__dev spot__dev--reel" data-spot-reel>
					<span class="spot__screen">
						<video
							class="spot__video"
							src="/videos/anchorstep-reel.mp4"
							poster="/images/spotlight/reel-poster.jpg"
							muted
							loop
							playsinline
							autoplay
							preload="none"
							aria-label="The founder of AnchorStep Physiotherapy at work, filmed by Swizel"
						></video>
						<span class="spot__chip" aria-hidden="true">
							<Icon class="spot__chip-ic" width={12} name="mdi:hammer-wrench" />
							Her at work
						</span>
						<span class="spot__deck">
							<button
								class="spot__skip"
								type="button"
								data-spot-skip="-10"
								aria-label="Back ten seconds"
							>
								<Icon width={15} name="mdi:rewind-10" />
							</button>
							<button class="spot__sound" type="button" data-spot-sound aria-pressed="false">
								<Icon width={15} name="mdi:volume-off" />
								<span data-spot-sound-t>Tap for sound</span>
							</button>
							<button
								class="spot__skip"
								type="button"
								data-spot-skip="10"
								aria-label="Forward ten seconds"
							>
								<Icon width={15} name="mdi:fast-forward-10" />
							</button>
						</span>
						<button
							class="spot__play"
							type="button"
							data-spot-play
							aria-label="Pause the film"
						>
							<Icon class="spot__play-i spot__play-i--pause" width={17} name="mdi:pause" />
							<Icon class="spot__play-i spot__play-i--play" width={17} name="mdi:play" />
						</button>
					</span>
					<figcaption class="spot__cap">
						<b>Her at work</b>
						<em>Filmed and edited by Swizel</em>
					</figcaption>
				</figure>

				<figure class="spot__dev spot__dev--ig">
					<span class="spot__point" aria-hidden="true">
						<span class="spot__point-t">
							<Icon width={13} name="mdi:instagram" />
							Instagram, ours
						</span>
						<em>3,150+ followers</em>
						<svg class="spot__point-a" viewBox="0 0 44 46">
							<path class="spot__point-line" d="M22 3C31 12 13 22 22 37" />
							<path class="spot__point-head" d="M15 30L22 38L29 30" />
						</svg>
					</span>
					<span class="spot__screen">
						<img
							src="/images/spotlight/instagram.jpg"
							alt="The AnchorStep Physiotherapy Instagram account, run by Swizel: 40 posts and 3,152 followers"
							width="529"
							height="1080"
							loading="lazy"
							decoding="async"
						/>
					</span>
				</figure>
			</div>

			<!-- ── the argument ── -->
			<div class="spot__copy">
				<div class="spot__client fd-rev" style="--i:2">
					<span class="spot__client-pic">
						<img
							src="/images/spotlight/portrait.jpg"
							alt="The founder of AnchorStep Physiotherapy, a Swizel client"
							width="800"
							height="1000"
							loading="lazy"
							decoding="async"
						/>
					</span>
					<span class="spot__client-txt">
						<strong>AnchorStep Physiotherapy</strong>
						<em>Home-visit physiotherapy · Abuja</em>
					</span>
					<span class="spot__client-tag">
						<Icon width={12} name="mdi:check-decagram" />
						Built &amp; managed by Swizel
					</span>
				</div>

				<p class="spot__lead fd-rev" style="--i:3">
					A one-person practice with no website and no way to be found.
					<b>Swizel put the site and the booking system live in under a month</b>,
					then took the brand and both social accounts too. We still run them.
					The bookings, the followers and the enquiries have not stopped
					moving since.
				</p>

				<ol class="spot__ledger fd-rev" style="--i:4">
					{
						delivered.map((d) => (
							<li class="spot__row">
								<span class="spot__row-n">{d.n}</span>
								<span class="spot__row-t">
									<b>{d.t}</b>
									<em>{d.d}</em>
								</span>
								<Icon width={15} name="mdi:check" class="spot__row-x" />
							</li>
						))
					}
				</ol>

				<p class="spot__kick fd-rev" style="--i:5">
					If a one-woman clinic can look like this in under a month, ask what
					your product could look like by the end of the quarter.
				</p>
			</div>
		</div>

		<!-- ── the numbers, one line, always ── -->
		<ul class="spot__numbers fd-rev" style="--i:1">
			{
				numbers.map((n) => (
					<li>
						<b>{n.v}</b>
						<em>{n.l}</em>
					</li>
				))
			}
		</ul>

		<!-- ── the wall: prints from the job ── -->
		<div class="spot__wall fd-rev" style="--i:2">
			<span class="spot__wall-k">
				<Icon width={13} name="mdi:pin-outline" />
				On the job, shot by us
			</span>
			<div class="spot__railwrap">
				<button
					class="spot__nav spot__nav--prev"
					type="button"
					data-spot-rail-prev
					aria-label="Previous photographs"
				>
					<Icon width={20} name="mdi:chevron-left" />
				</button>
				<div class="spot__rail" role="list" data-spot-rail>
				{
					shots.map((s, i) => (
						<figure class="spot__shot" role="listitem" style={`--r:${s.r}; --i:${i}`} tabindex="0">
							<span class="spot__tape" aria-hidden="true" />
							<span class="spot__pic">
								<img src={s.img} alt={s.cap} loading="lazy" decoding="async" />
								<span class="spot__sheen" aria-hidden="true" />
								<span class="spot__mark">Swizel</span>
							</span>
							<figcaption class="spot__shot-cap">{s.cap}</figcaption>
						</figure>
					))
				}
				</div>
				<button
					class="spot__nav spot__nav--next"
					type="button"
					data-spot-rail-next
					aria-label="More photographs"
				>
					<Icon width={20} name="mdi:chevron-right" />
				</button>
			</div>
		</div>

		<!-- ── the close ── -->
		<div class="spot__foot fd-rev" style="--i:3">
			<p class="spot__foot-t">
				Another founder gets this spot next.
				<span>It may as well be you.</span>
			</p>
			<div class="spot__foot-a">
				<a class="spot__cta" href="/contact">
					Start project
					<Icon width={15} name="mdi:arrow-right" />
				</a>
				<span class="spot__links">
					<i class="spot__links-k">Her work</i>
					{
						links.map((l) => (
							<a
								class="spot__link"
								href={l.href}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={`AnchorStep on ${l.label}`}
								title={l.label}
							>
								{l.icon === 'tiktok' ? (
									<svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.21v12.67a2.59 2.59 0 1 1-2.59-2.59c.27 0 .53.04.78.12v-3.3a5.88 5.88 0 0 0-.78-.05 5.85 5.85 0 1 0 5.85 5.85V8.66a7.5 7.5 0 0 0 4.37 1.4V6.85a4.28 4.28 0 0 1-3.36-1.03z" /></svg>
								) : (
									<Icon width={16} name={l.icon} />
								)}
							</a>
						))
					}
				</span>
			</div>
		</div>
	</div>
</section>

<style>
	.spot {
		--sp-ink: var(--fd-ink, #f1edfb);
		--sp-muted: var(--fd-muted, rgba(241, 237, 251, 0.62));
		--sp-faint: var(--fd-faint, rgba(241, 237, 251, 0.4));
		--sp-acc: var(--fd-acc, #8b5cf6);
		--sp-line: var(--fd-line, rgba(255, 255, 255, 0.1));
		--sp-hand: 'Bradley Hand', 'Segoe Print', 'Comic Sans MS', cursive;
		position: relative;
		isolation: isolate;
		padding: clamp(4rem, 8vw, 7rem) 0 clamp(3.4rem, 6vw, 5.5rem);
		color: var(--sp-ink);
	}

	/* the stage it stands on: one soft pool of light, nothing more */
	.spot__ground {
		position: absolute;
		inset: 0 calc(50% - 50vw);
		z-index: -1;
		overflow: hidden;
		pointer-events: none;
		background:
			radial-gradient(120% 70% at 50% 0%, color-mix(in srgb, var(--sp-acc) 13%, transparent), transparent 68%),
			linear-gradient(180deg, transparent, color-mix(in srgb, var(--sp-acc) 5%, transparent) 55%, transparent);
	}
	.spot__beam {
		position: absolute;
		top: -14%;
		left: 50%;
		width: 74%;
		height: 92%;
		margin-left: -37%;
		background: linear-gradient(180deg, color-mix(in srgb, var(--sp-acc) 26%, transparent), transparent 74%);
		clip-path: polygon(41% 0, 59% 0, 100% 100%, 0 100%);
		mix-blend-mode: screen;
		opacity: 0.5;
		animation: sp-sweep 13s ease-in-out infinite;
		transform-origin: 50% 0;
	}
	@keyframes sp-sweep {
		0%, 100% { transform: rotate(-3.5deg); }
		50% { transform: rotate(3.5deg); }
	}

	.spot__wrap {
		width: min(1200px, 100% - 2.4rem);
		margin-inline: auto;
	}

	/* ── head ─────────────────────────────────────────────────────── */
	.spot__head {
		max-width: 44rem;
		margin-bottom: clamp(2.4rem, 4.5vw, 3.6rem);
	}
	.spot__stamp {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.34rem 0.8rem;
		border: 1px dashed color-mix(in srgb, var(--sp-acc) 52%, transparent);
		border-radius: 9999px;
		font-size: 0.7rem;
		font-weight: 800;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--sp-acc);
	}
	.spot__h {
		margin: 0.85rem 0 0;
		font-size: clamp(2rem, 4.6vw, 3.35rem);
		font-weight: 800;
		line-height: 1.04;
		letter-spacing: -0.025em;
	}
	.spot__h em {
		font-family: var(--sp-hand);
		font-style: normal;
		font-weight: 700;
		background: linear-gradient(96deg, var(--sp-acc), #ec4899);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}
	.spot__p {
		margin: 0.85rem 0 0;
		max-width: 34rem;
		font-size: clamp(0.98rem, 1.3vw, 1.08rem);
		line-height: 1.65;
		color: var(--sp-muted);
	}

	/* ── stage: handsets left, argument right ─────────────────────── */
	.spot__stage {
		display: grid;
		gap: clamp(2.4rem, 4vw, 4rem);
		align-items: center;
	}
	@media (min-width: 1024px) {
		.spot__stage {
			grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
		}
		/* left-aligned, so the gap between the phones and the writing is
		   real rather than whatever is left over */
		.spot__devices { justify-content: flex-start; }
	}

	/* ── the handsets ─────────────────────────────────────────────── */
	.spot__devices {
		display: flex;
		align-items: flex-end;
		justify-content: center;
		gap: clamp(0.5rem, 1.2vw, 1rem);
		/* a grid track with minmax(0,…) will not stop a flex row of fixed
		   widths from spilling — this will */
		min-width: 0;
		max-width: 100%;
	}
	.spot__dev {
		position: relative;
		margin: 0;
		flex: none;
	}
	.spot__dev--reel {
		width: clamp(210px, 23vw, 290px);
		max-width: 40%;
		z-index: 3;
	}
	/* The two accounts are shorter than the film, which leaves a band of
	   dead air above them. That band is where their labels live now, so the
	   screenshots underneath are never written over. */
	.spot__dev--ig,
	.spot__dev--tt {
		width: clamp(150px, 16.5vw, 208px);
		max-width: 29%;
		z-index: 1;
	}

	.spot__point {
		display: grid;
		justify-items: center;
		gap: 0.02rem;
		padding-bottom: 0.35rem;
		text-align: center;
		font-family: var(--sp-hand);
		color: var(--sp-muted);
	}
	.spot__point-t {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		font-size: clamp(0.78rem, 1.1vw, 0.94rem);
		font-weight: 700;
		color: var(--sp-ink);
		white-space: nowrap;
	}
	.spot__point-t :global(svg) { color: var(--sp-acc); flex: none; }
	.spot__point em {
		font-style: normal;
		font-size: clamp(0.7rem, 0.95vw, 0.82rem);
		color: var(--sp-acc);
		white-space: nowrap;
	}
	.spot__point-a {
		width: clamp(26px, 2.6vw, 34px);
		height: auto;
		margin-top: 0.1rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2.4;
		stroke-linecap: round;
		stroke-linejoin: round;
		color: var(--sp-acc);
		opacity: 0.8;
		overflow: visible;
		filter: drop-shadow(0 1px 2px color-mix(in srgb, var(--sp-acc) 30%, transparent));
	}
	/* In daylight the accent is already dark ink on a pale ground, so the
	   stroke only needs weight, not a second colour. */
	:global(html:not(.dark)) .spot__point-a {
		opacity: 1;
		stroke-width: 2.8;
	}
	/* the stroke keeps re-drawing, so the hand looks live */
	.spot__point-line { stroke-dasharray: 52; animation: sp-ink 3.2s ease-in-out infinite; }
	.spot__point-head { stroke-dasharray: 30; animation: sp-ink 3.2s ease-in-out 0.25s infinite; }
	@keyframes sp-ink {
		0% { stroke-dashoffset: 52; }
		40%, 100% { stroke-dashoffset: 0; }
	}

	.spot__screen {
		position: relative;
		display: block;
		overflow: hidden;
		border-radius: clamp(18px, 2.2vw, 28px);
		padding: 5px;
		background-image: linear-gradient(150deg, color-mix(in srgb, var(--sp-acc) 70%, #fff 8%), #2a1c52 46%, #ec4899);
		box-shadow:
			0 34px 70px -32px rgba(0, 0, 0, 0.9),
			0 0 0 1px color-mix(in srgb, var(--sp-acc) 26%, transparent);
		transform: rotate(var(--sp-r, 0deg));
		transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.spot__dev--reel .spot__screen { --sp-r: -1.4deg; }
	.spot__dev--ig .spot__screen { --sp-r: 3.4deg; }
	.spot__dev--tt .spot__screen { --sp-r: -3.8deg; }
	.spot__dev:hover .spot__screen,
	.spot__dev:focus-within .spot__screen { --sp-r: 0deg; }

	.spot__screen video,
	.spot__screen img {
		display: block;
		width: 100%;
		aspect-ratio: 9 / 16;
		height: auto;
		object-fit: cover;
		border-radius: clamp(14px, 1.8vw, 23px);
		background: #0d0718;
	}
	.spot__dev--ig .spot__screen img,
	.spot__dev--tt .spot__screen img { object-position: 50% 0; }

	/* the little running tag on each screen */
	.spot__chip {
		position: absolute;
		top: 0.7rem;
		left: 0.7rem;
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0.22rem 0.5rem;
		border-radius: 9999px;
		background: rgba(10, 6, 20, 0.62);
		-webkit-backdrop-filter: blur(6px);
		backdrop-filter: blur(6px);
		font-size: 0.7rem;
		font-weight: 800;
		letter-spacing: 0.13em;
		text-transform: uppercase;
		color: #fff;
	}
	.spot__chip :global(.spot__chip-ic) {
		flex: none;
		animation: sp-reel 3s ease-in-out infinite;
	}
	@keyframes sp-reel {
		0%, 100% { opacity: 0.75; transform: translateY(0) rotate(0deg); }
		50% { opacity: 1; transform: translateY(-1px) rotate(-5deg); }
	}

	/* the transport: skip back, sound, skip on — one row on the glass */
	.spot__deck {
		position: absolute;
		left: 50%;
		bottom: 0.9rem;
		z-index: 3;
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		transform: translateX(-50%);
	}
	.spot__skip {
		display: grid;
		place-items: center;
		width: 1.85rem;
		height: 1.85rem;
		flex: none;
		border: 0;
		border-radius: 9999px;
		background: rgba(255, 255, 255, 0.82);
		color: #1d1430;
		cursor: pointer;
		box-shadow: 0 10px 24px -12px rgba(0, 0, 0, 0.9);
		transition: background 0.2s ease, transform 0.2s ease;
	}
	.spot__skip:hover { background: #fff; transform: translateY(-2px); }
	.spot__skip:active { transform: scale(0.92); }

	/* pause lives top-right, out of the way of her face */
	.spot__play {
		position: absolute;
		top: 0.7rem;
		right: 0.7rem;
		z-index: 3;
		display: grid;
		place-items: center;
		width: 1.9rem;
		height: 1.9rem;
		border: 0;
		border-radius: 9999px;
		background: rgba(12, 8, 26, 0.62);
		-webkit-backdrop-filter: blur(6px);
		backdrop-filter: blur(6px);
		color: #fff;
		cursor: pointer;
		transition: background 0.2s ease, transform 0.2s ease;
	}
	.spot__play:hover { background: rgba(12, 8, 26, 0.85); transform: scale(1.06); }
	.spot__play-i--play { display: none; }
	.spot__dev--reel.is-held .spot__play-i--pause { display: none; }
	.spot__dev--reel.is-held .spot__play-i--play { display: block; }

	.spot__sound {
		position: relative;
		display: inline-flex;
		align-items: center;
