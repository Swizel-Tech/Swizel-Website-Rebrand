			{ title: 'Patched', body: 'Hardened and recoverable, always.', icon: 'mdi:shield-sync-outline', tint: '#34d399' },
			{ title: 'Same-day', body: 'A real person answers, fast.', icon: 'mdi:headset', tint: '#f472b6' },
