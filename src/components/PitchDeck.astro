			0 0 0 1px rgba(255, 255, 255, 0.05),
			0 60px 130px -50px rgba(0, 0, 0, 0.95),
			0 0 120px -30px rgba(139, 92, 246, 0.35);
		overflow: hidden;
	}

	/* the beams */
	.pdeck__house { position: absolute; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
	.pdeck__beam {
		position: absolute;
		top: -46%;
		width: 44%;
		height: 150%;
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0.02) 55%, transparent 78%);
