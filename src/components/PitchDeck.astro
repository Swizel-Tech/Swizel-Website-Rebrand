---

<section class="pdeck-sec" id="fd-deck" data-cursor="repo">
	<div class="pdeck-wrap">
		<div class="pdeck-head fd-rev">
			<span class="pdeck-stamp">The deck</span>
			<h2 class="pdeck-h">What we <em>actually do.</em></h2>
			<p class="pdeck-p">
				Seven slides, seven disciplines, and a real product behind each
				one. Kill the lights and take it full screen.
			</p>
		</div>

		<div class="pdeck fd-rev" id="pdeck" data-pdeck style={`--pd-acc:${slides[0].accent}`}>
			<!-- the clicker rail -->
			<div class="pdeck__rail">
				<span class="pdeck__count">
					<b data-pd-now>01</b><i>/</i><span>{String(slides.length).padStart(2, '0')}</span>
				</span>

				<div class="pdeck__dots" role="tablist" aria-label="Slides">
					{
						slides.map((s, i) => (
							<button
								class="pdeck__dot"
								type="button"
								role="tab"
								data-pd-dot={i}
								aria-selected={i === 0 ? 'true' : 'false'}
								aria-label={`${s.kicker} — slide ${i + 1}`}
								style={`--d:${s.accent}`}
							/>
						))
					}
				</div>

				<div class="pdeck__tools">
					<button class="pdeck__tool" type="button" data-pd-play aria-label="Play the deck">
						<Icon class="pdeck__i-play" width={15} name="mdi:play" />
						<Icon class="pdeck__i-stop" width={15} name="mdi:pause" />
						<span class="pdeck__tool-t">Play</span>
					</button>
					<button class="pdeck__tool pdeck__tool--lights" type="button" data-pd-lights aria-pressed="false">
						<Icon class="pdeck__i-off" width={15} name="mdi:lightbulb-outline" />
						<Icon class="pdeck__i-on" width={15} name="mdi:lightbulb-on-outline" />
						<span class="pdeck__tool-t" data-pd-lights-t>Kill the lights</span>
					</button>
				</div>
			</div>

			<span class="pdeck__prog" aria-hidden="true"><span data-pd-prog></span></span>

			<!-- the stage -->
			<div class="pdeck__stage" data-pd-stage tabindex="0" role="region" aria-label="Pitch deck">
				{
					slides.map((s, i) => (
						<article
							class="pdeck__slide"
							data-pd-slide={i}
							style={`--pd-a:${s.accent}; --pd-b:${s.accent2}`}
							aria-hidden={i === 0 ? 'false' : 'true'}
						>
							<span class="pdeck__wash" aria-hidden="true" />

							<!-- left: the argument -->
							<div class="pdeck__copy">
								<span class="pdeck__kick">
									<Icon width={14} name={s.kickerIcon} />
									{s.kicker}
									<i class="pdeck__kick-rule" aria-hidden="true" />
								</span>
								<h3 class="pdeck__t">
									{s.title} <em>{s.em}</em>
								</h3>
								<p class="pdeck__line">{s.line}</p>
								<ul class="pdeck__gives">
									{s.gives.map((g) => (
										<li>
											<span class="pdeck__give-ic">
												<Icon width={15} name={g.icon} />
											</span>
											{g.label}
											<Icon class="pdeck__give-go" width={13} name="mdi:arrow-right" />
										</li>
									))}
								</ul>

								<!-- the house numbers, along the bottom of the argument -->
								<ul class="pdeck__figs">
									{figures.map((f) => (
										<li>
											<span class="pdeck__fig-ic"><Icon width={15} name={f.icon} /></span>
											<b>{f.v}</b>
											<em>{f.l}</em>
										</li>
									))}
								</ul>
							</div>

							<!-- right: the proof, on real hardware -->
							<div class="pdeck__show">
								<span class="pdeck__glow" aria-hidden="true" />

								<div class="pdeck__rig">
									<!-- laptop -->
									<span class="pdeck__lap">
										<span class="pdeck__lap-screen">
											<img
												src={s.work.img}
												alt={`${s.work.name} — built by Swizel`}
												loading={i === 0 ? 'eager' : 'lazy'}
												decoding="async"
												width="1280"
												height="800"
											/>
											<span class="pdeck__glare" aria-hidden="true" />
										</span>
										<span class="pdeck__lap-base" aria-hidden="true" />
									</span>

									<!-- phone, overlapping the laptop's corner -->
									<span class="pdeck__phone" aria-hidden="true">
										<span class="pdeck__phone-screen">
											<img src={s.work.img} alt="" loading="lazy" decoding="async" />
										</span>
									</span>

									<!-- the annotations that float off the hardware -->
									{s.notes.map((nt, k) => (
										<span class={`pdeck__note pdeck__note--${k + 1}`} style={`--t:${nt.tint}; --k:${k}`}>
											<span class="pdeck__note-ic"><Icon width={15} name={nt.icon} /></span>
											<span class="pdeck__note-txt">
												<b>{nt.title}</b>
												<em>{nt.body}</em>
											</span>
										</span>
									))}
								</div>

								<!-- the product's own card -->
								<a
									class="pdeck__work"
									href={s.work.url}
									target={s.work.url.startsWith('http') ? '_blank' : undefined}
									rel={s.work.url.startsWith('http') ? 'noopener' : undefined}
								>
									<span class="pdeck__work-mark" aria-hidden="true">
										<Icon width={19} name={s.kickerIcon} />
									</span>
									<span class="pdeck__work-txt">
										<strong>{s.work.name}</strong>
										<span class="pdeck__sector">{s.work.sector}</span>
										<span class="pdeck__note-line">{s.work.note}</span>
									</span>
									<span class="pdeck__work-go" aria-hidden="true">
										<Icon width={17} name="mdi:arrow-right" />
									</span>
								</a>
							</div>
						</article>
					))
				}

				<button class="pdeck__nav pdeck__nav--prev" type="button" data-pd-prev aria-label="Previous slide">
					<Icon width={20} name="mdi:chevron-left" />
				</button>
				<button class="pdeck__nav pdeck__nav--next" type="button" data-pd-next aria-label="Next slide">
					<Icon width={20} name="mdi:chevron-right" />
				</button>
			</div>

			<!-- only visible with the lights out -->
			<button class="pdeck__exit" type="button" data-pd-exit>
				<Icon width={15} name="mdi:close" />
				Lights on
				<kbd>Esc</kbd>
			</button>
			<span class="pdeck__hint">← → to move · Esc to leave</span>
		</div>
	</div>
</section>

<!-- the blackout, portalled to the end of the body by the script -->
<div class="pdeck-blackout" data-pd-blackout hidden></div>

<style>
	/* The founder body's shared type lives in that component's scoped sheet,
	   so it cannot reach in here — the deck carries its own head, tuned to
	   match. The --fd-* tokens do inherit, so the colours stay in step. */
	.pdeck-sec {
		position: relative;
		padding-block: clamp(2rem, 5vw, 3.5rem);
	}
	.pdeck-wrap { max-width: 78rem; margin: 0 auto; }
	.pdeck-head {
		text-align: center;
		max-width: 46rem;
		margin: 0 auto clamp(1.5rem, 3vw, 2.25rem);
	}
	.pdeck-stamp {
		display: inline-block;
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--fd-acc, #8b5cf6);
		border: 1.5px dashed color-mix(in srgb, var(--fd-acc, #8b5cf6) 55%, transparent);
		padding: 0.35rem 0.8rem;
		border-radius: 0.5rem;
		transform: rotate(-2deg);
		margin-bottom: 1rem;
	}
	.pdeck-h {
		font-size: clamp(1.9rem, 4.2vw, 3rem);
		font-weight: 850;
		letter-spacing: -0.025em;
		line-height: 1.06;
		margin: 0 0 1rem;
		color: var(--fd-ink, #f1edfb);
	}
	.pdeck-h em {
		font-style: italic;
		background: linear-gradient(95deg, var(--fd-acc, #8b5cf6), var(--fd-acc2, #ec4899));
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
		padding-right: 0.06em;
	}
	.pdeck-p {
		font-size: 1.02rem;
		line-height: 1.65;
		color: var(--fd-muted, rgba(241, 237, 251, 0.62));
		max-width: 34rem;
		margin: 0 auto;
		text-align: center;
	}

	/* ══ the deck shell ══ */
	.pdeck {
		--pd-ink: #f4f1ff;
		position: relative;
		border-radius: 1.5rem;
		border: 1px solid rgba(255, 255, 255, 0.09);
		background: linear-gradient(168deg, #0f0b22, #07050f 62%, #0b0818);
		box-shadow: 0 46px 110px -46px rgba(0, 0, 0, 0.95);
		overflow: hidden;
	}

	/* ── the clicker rail ─────────────────────────────────────── */
	.pdeck__rail {
		position: relative;
		z-index: 6;
		display: flex;
		align-items: center;
		gap: 0.9rem;
		padding: 0.7rem 0.9rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.07);
		background: rgba(255, 255, 255, 0.02);
	}
	.pdeck__count {
		display: inline-flex;
		align-items: baseline;
		gap: 0.15rem;
		font-family: ui-monospace, monospace;
		font-size: 0.74rem;
		color: rgba(244, 241, 255, 0.45);
		flex: none;
	}
	.pdeck__count b { font-size: 0.95rem; color: var(--pd-acc, #8b5cf6); font-weight: 800; }
	.pdeck__count i { font-style: normal; opacity: 0.5; }

	.pdeck__dots { display: flex; align-items: center; gap: 0.34rem; flex: 1; min-width: 0; flex-wrap: wrap; }
	.pdeck__dot {
		width: 22px;
		height: 5px;
		flex: none;
		border: 0;
		padding: 0;
		border-radius: 9999px;
		background: rgba(255, 255, 255, 0.16);
		cursor: pointer;
		transition: background 0.3s ease, width 0.3s ease;
	}
	.pdeck__dot:hover { background: rgba(255, 255, 255, 0.32); }
	.pdeck__dot[aria-selected='true'] { width: 40px; background: var(--d, #8b5cf6); }

	.pdeck__tools { display: flex; align-items: center; gap: 0.4rem; flex: none; }
	.pdeck__tool {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.4rem 0.75rem;
		border-radius: 9999px;
		font-size: 0.72rem;
		font-weight: 750;
		font-family: inherit;
		color: var(--pd-ink);
		background: rgba(255, 255, 255, 0.07);
		border: 1px solid rgba(255, 255, 255, 0.1);
		cursor: pointer;
		white-space: nowrap;
		transition: background 0.22s ease, border-color 0.22s ease, transform 0.18s ease;
	}
	.pdeck__tool:hover { background: rgba(255, 255, 255, 0.14); transform: translateY(-1px); }
	.pdeck__tool--lights {
		color: #14101f;
		background: linear-gradient(95deg, #fde68a, #fbbf24);
		border-color: transparent;
	}
	.pdeck__tool--lights:hover { filter: brightness(1.05); background: linear-gradient(95deg, #fde68a, #fbbf24); }
	.pdeck__i-stop, .pdeck__i-on { display: none; }
	.pdeck.is-playing .pdeck__i-stop { display: block; }
