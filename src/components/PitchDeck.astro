// The Swizel services pitch deck — staged as a screening, not a page.
//
// A founder does not read a services grid; they sit through a pitch. So the
// section is an auditorium: two spotlights sweep the wall, a velvet curtain
// is closed over the screen until you raise it, and behind it seven slides
// run with a clicker, arrow keys, swipe and an autoplay.
//
// Each slide argues in four sticky notes — the things a founder actually
// writes down — and proves itself with a real product on real hardware.
// Under the stage there is a Q&A rail: pick a question or type one, and the
// answer is projected over the slide.
//
// "Kill the lights" takes the whole thing full screen and blacks out the
// site behind it.
import { Icon } from 'astro-icon/components';

interface Slide {
	n: string;
	kicker: string;
	kickerIcon: string;
	title: string;
	em: string;
	line: string;
	/** four, always four — the notes a founder would actually write down */
	notes: { t: string; d: string }[];
	marks: { title: string; body: string; icon: string; tint: string }[];
	accent: string;
	accent2: string;
	work: { name: string; sector: string; img: string; host: string; url: string; note: string };
}

