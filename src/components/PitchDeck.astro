	/* the gentle sway of heavy cloth on a hook */
	@keyframes pd-swing-l {
		0%, 100% { transform: translateX(calc(-100% + var(--pd-band))) rotate(2.2deg) skewY(1deg); }
		50% { transform: translateX(calc(-100% + var(--pd-band) + 3px)) rotate(3.1deg) skewY(1.7deg); }
	}
	@keyframes pd-swing-r {
		0%, 100% { transform: translateX(calc(100% - var(--pd-band))) rotate(-2.2deg) skewY(-1deg); }
		50% { transform: translateX(calc(100% - var(--pd-band) - 3px)) rotate(-3.1deg) skewY(-1.7deg); }
	}
	/* the tie-back rope, and the shadow the gathered cloth throws inward */
	.pdeck__velvet::before {
		content: '';
