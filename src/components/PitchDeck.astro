---
// The pitch deck — what Swizel actually does, presented rather than listed.
//
// A founder does not read a services grid; they sit through a deck. So this
// is a deck: numbered slides, a clicker, a progress bar, arrow keys, swipe,
// and a play button that runs it hands-free.
//
// Every slide is built like a real deck slide: a gradient headline, three
// pill buttons for what's inside, a device rig carrying a live product, three
// annotation cards floating off it, a strip of house numbers along the
// bottom, and the product's own card with a way in.
//
// And there is a light switch. Press it and the room goes out: the whole
// site dims behind a blackout, the deck lifts into the middle of the screen
// at theatre size, and nothing else is competing for attention.
import { Icon } from 'astro-icon/components';

interface Slide {
	n: string;
	kicker: string;
	kickerIcon: string;
	title: string;
	em: string;
	line: string;
	gives: { label: string; icon: string }[];
	notes: { title: string; body: string; icon: string; tint: string }[];
	accent: string;
	accent2: string;
	work: {
		name: string;
		sector: string;
		img: string;
		host: string;
		url: string;
		note: string;
	};
}

// the house numbers, the same in every world — they sit under every slide
const figures = [
	{ v: '7+', l: 'Years shipping', icon: 'mdi:calendar-check-outline' },
	{ v: '25+', l: 'Specialists', icon: 'mdi:account-group-outline' },
	{ v: '10+', l: 'Countries', icon: 'mdi:earth' },
	{ v: '65+', l: 'Products live', icon: 'mdi:chart-box-outline' },
];

const slides: Slide[] = [
	{
		n: '01',
		kicker: 'Engineering',
		kickerIcon: 'mdi:code-tags',
		title: 'Websites and apps,',
		em: 'built to last.',
		line: 'Web, iOS and Android, e-commerce, portals and the APIs behind them — written by senior engineers, tested, and handed over documented.',
		gives: [
			{ label: 'Web & mobile apps', icon: 'mdi:cellphone-link' },
			{ label: 'E-commerce & portals', icon: 'mdi:cart-outline' },
			{ label: 'APIs and integrations', icon: 'mdi:cloud-outline' },
		],
		notes: [
			{ title: 'Fast & reliable', body: 'Optimised for performance and scale.', icon: 'mdi:lightning-bolt', tint: '#8b5cf6' },
			{ title: 'Secure', body: 'Built to current security practice.', icon: 'mdi:shield-check-outline', tint: '#34d399' },
			{ title: 'Scalable', body: 'Ready for your next big idea.', icon: 'mdi:cloud-upload-outline', tint: '#60a5fa' },
		],
		accent: '#8b5cf6',
		accent2: '#60a5fa',
		work: {
			name: 'Brixmarket',
			sector: 'Real-estate marketplace',
			img: '/images/portfolio/brix%20marketplace.jpg',
			host: 'brixmarket.com',
			url: 'https://brixmarket.com/',
			note: 'A full marketplace — listings, agents, search and payments.',
		},
	},
	{
		n: '02',
		kicker: 'Product design',
		kickerIcon: 'mdi:palette-outline',
		title: 'Design people',
		em: 'actually feel.',
		line: 'Brand identity, interface and motion. The part that decides whether a first-time user stays or leaves, treated as seriously as the code.',
		gives: [
			{ label: 'Brand identity', icon: 'mdi:shape-outline' },
			{ label: 'UI/UX & prototypes', icon: 'mdi:gesture-tap-button' },
			{ label: 'Design systems', icon: 'mdi:view-grid-outline' },
		],
		notes: [
			{ title: 'Clickable first', body: 'You feel it before we build it.', icon: 'mdi:cursor-default-click-outline', tint: '#22d3ee' },
			{ title: 'One system', body: 'Every screen from the same parts.', icon: 'mdi:puzzle-outline', tint: '#a78bfa' },
			{ title: 'Handover ready', body: 'Dev-ready files, not pretty pictures.', icon: 'mdi:file-check-outline', tint: '#f472b6' },
		],
		accent: '#22d3ee',
		accent2: '#a78bfa',
		work: {
			name: 'Beauty Hive',
			sector: 'Beauty & commerce',
