		],
		notes: [
			{ title: 'Channel fit', body: 'Only where your buyers actually are.', icon: 'mdi:target-account', tint: '#fb7185' },
			{ title: 'Read weekly', body: 'Numbers you see, not a monthly PDF.', icon: 'mdi:chart-line', tint: '#fbbf24' },
			{ title: 'Yours to keep', body: 'We hand over the playbook.', icon: 'mdi:book-open-page-variant-outline', tint: '#22d3ee' },
		],
		accent: '#fb7185',
		accent2: '#fbbf24',
