		pointer-events: none;
		background:
			radial-gradient(680px 420px at 88% 6%, color-mix(in srgb, var(--pd-a) 26%, transparent), transparent 64%),
			radial-gradient(520px 340px at 4% 96%, color-mix(in srgb, var(--pd-b) 18%, transparent), transparent 62%);
	}
	.pdeck__copy, .pdeck__show { position: relative; z-index: 1; min-width: 0; }

	.pdeck__kick {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.34rem 0.8rem;
		margin-bottom: 0.9rem;
		border-radius: 9999px;
		font-size: 0.7rem;
		font-weight: 800;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--pd-a) 72%, #fff);
		background: color-mix(in srgb, var(--pd-a) 16%, transparent);
		border: 1px solid color-mix(in srgb, var(--pd-a) 38%, transparent);
	}
	.pdeck__kick-rule {
		width: clamp(28px, 6vw, 74px);
		height: 1px;
		margin-left: 0.35rem;
		background: linear-gradient(90deg, currentColor, transparent);
		opacity: 0.6;
	}
	.pdeck__t {
		margin: 0 0 0.7rem;
		font-size: clamp(1.75rem, 3.6vw, 3.1rem);
		font-weight: 850;
		line-height: 1.03;
		letter-spacing: -0.03em;
		color: #fff;
	}
	.pdeck__t em {
		display: block;
		font-style: normal;
		background: linear-gradient(95deg, var(--pd-a), var(--pd-b));
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}
	.pdeck__line {
		margin: 0 0 1.1rem;
		font-size: clamp(0.88rem, 1.3vw, 1rem);
		line-height: 1.62;
		color: rgba(244, 241, 255, 0.64);
		max-width: 32rem;
	}

	/* the four notes, on the wall */
	.pdeck__stickies {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.65rem;
		list-style: none;
		margin: 0 0 1.2rem;
		padding: 0;
	}
	.pdeck__stickies li {
		position: relative;
		display: grid;
		gap: 0.12rem;
		padding: 0.7rem 0.8rem 0.75rem;
		border-radius: 0.2rem 0.2rem 0.5rem 0.2rem;
		color: #241a10;
		background: linear-gradient(165deg, #fef3c7, #fde68a 70%, #fcd34d);
		box-shadow: 0 12px 24px -14px rgba(0, 0, 0, 0.8);
		transform: rotate(var(--r, -1.4deg));
		transition: transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.28s ease;
	}
	.pdeck__stickies li:nth-child(1) { --r: -1.8deg; }
	.pdeck__stickies li:nth-child(2) { --r: 1.6deg; background: linear-gradient(165deg, #ddf7ef, #b8f0e0 70%, #99e9d4); }
	.pdeck__stickies li:nth-child(3) { --r: 1.2deg; background: linear-gradient(165deg, #e9e2ff, #d6cbff 70%, #c4b5fd); }
	.pdeck__stickies li:nth-child(4) { --r: -1.1deg; background: linear-gradient(165deg, #ffe4ef, #fecdd8 70%, #fda4c0); }
	.pdeck__stickies li:hover { transform: rotate(0deg) translateY(-4px) scale(1.03); box-shadow: 0 20px 34px -14px rgba(0, 0, 0, 0.85); }
	/* the curled corner */
	.pdeck__stickies li::after {
		content: '';
		position: absolute;
		right: 0;
		bottom: 0;
		width: 14px;
		height: 14px;
		background: linear-gradient(315deg, rgba(0, 0, 0, 0.22), transparent 60%);
		border-radius: 0 0 0.5rem 0;
	}
	.pdeck__stickies b {
		font-family: 'Bradley Hand', 'Segoe Print', 'Comic Sans MS', cursive;
		font-size: 0.94rem;
		font-weight: 800;
		line-height: 1.15;
	}
	.pdeck__stickies em {
		font-family: 'Bradley Hand', 'Segoe Print', 'Comic Sans MS', cursive;
		font-style: normal;
		font-size: 0.8rem;
		line-height: 1.25;
		opacity: 0.72;
	}

	.pdeck__figs {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.2rem;
		list-style: none;
		margin: 0;
		padding: 0.8rem 0.4rem;
		border-radius: 1rem;
		border: 1px solid rgba(255, 255, 255, 0.1);
		background: rgba(255, 255, 255, 0.04);
	}
	.pdeck__figs li {
		display: grid;
		justify-items: start;
		gap: 0.08rem;
		padding-inline: 0.55rem;
		border-left: 1px solid rgba(255, 255, 255, 0.08);
		min-width: 0;
	}
	.pdeck__figs li:first-child { border-left: 0; }
	.pdeck__fig-ic { color: color-mix(in srgb, var(--pd-a) 78%, #fff); display: block; }
	.pdeck__figs b { font-size: clamp(1rem, 1.9vw, 1.4rem); font-weight: 850; letter-spacing: -0.02em; color: #fff; line-height: 1.1; }
	.pdeck__figs em { font-style: normal; font-size: 0.7rem; font-weight: 650; letter-spacing: 0.04em; line-height: 1.25; color: rgba(244, 241, 255, 0.5); }

	/* ── the proof, on hardware ───────────────────────────────── */
	.pdeck__show { display: grid; gap: clamp(0.9rem, 2vw, 1.4rem); }
	.pdeck__glow {
		position: absolute;
		inset: -12% -6% 30%;
		z-index: 0;
		border-radius: 50%;
		background: radial-gradient(ellipse at 50% 45%, color-mix(in srgb, var(--pd-a) 42%, transparent), transparent 68%);
		filter: blur(56px);
		pointer-events: none;
	}
	.pdeck__rig {
		position: relative;
		z-index: 1;
		padding: clamp(0.9rem, 2.4vw, 2.2rem) clamp(0.4rem, 6vw, 4.4rem) clamp(1.6rem, 3vw, 2.4rem);
	}
	.pdeck__lap { display: block; }
	.pdeck__lap-screen {
		position: relative;
		display: block;
		overflow: hidden;
		border-radius: 0.75rem 0.75rem 0.2rem 0.2rem;
		padding: 8px 8px 0;
		background: linear-gradient(160deg, #3a3358, #1d1830);
		box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.12), 0 40px 80px -34px rgba(0, 0, 0, 0.95);
	}
	.pdeck__lap-screen img {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 10;
		height: auto;
		object-fit: cover;
		object-position: 50% 0;
		border-radius: 0.4rem 0.4rem 0 0;
	}
	.pdeck__lap-base {
		display: block;
		width: 116%;
		height: 12px;
		margin: 0 -8%;
		border-radius: 0 0 0.7rem 0.7rem;
		background: linear-gradient(180deg, #4a4270, #241e3d);
		box-shadow: 0 20px 34px -20px rgba(0, 0, 0, 0.9);
	}
	.pdeck__lap-base::after {
		content: '';
		display: block;
		width: 16%;
		height: 3px;
		margin: 2px auto 0;
		border-radius: 9999px;
		background: rgba(255, 255, 255, 0.18);
	}
	.pdeck__glare {
		position: absolute;
		inset: 0;
		background: linear-gradient(115deg, transparent 40%, rgba(255, 255, 255, 0.16) 50%, transparent 60%);
		transform: translateX(-110%);
		pointer-events: none;
	}
	.pdeck__slide.is-on .pdeck__glare { animation: pd-glare 2.2s ease-out 0.5s; }
	@keyframes pd-glare { to { transform: translateX(110%); } }

	.pdeck__phone {
		position: absolute;
		right: clamp(0.2rem, 1.5vw, 1rem);
		bottom: clamp(0.6rem, 2vw, 1.2rem);
		z-index: 3;
		width: clamp(62px, 9vw, 108px);
		padding: 4px;
		border-radius: 0.85rem;
		background: linear-gradient(150deg, #4a4270, #1d1734);
		box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.14), 0 26px 46px -22px rgba(0, 0, 0, 0.95);
		transform: rotate(3deg);
	}
	.pdeck__phone-screen { display: block; aspect-ratio: 9 / 18; overflow: hidden; border-radius: 0.65rem; background: #07060f; }
	.pdeck__phone-screen img { width: 100%; height: 100%; object-fit: cover; object-position: 18% 0; }

	.pdeck__mark {
		position: absolute;
		z-index: 4;
		display: none;
		align-items: flex-start;
		gap: 0.5rem;
		max-width: 11rem;
		padding: 0.55rem 0.75rem;
		border-radius: 0.85rem;
		background: color-mix(in srgb, var(--t) 14%, rgba(18, 13, 38, 0.9));
		border: 1px solid color-mix(in srgb, var(--t) 38%, transparent);
		-webkit-backdrop-filter: blur(12px);
		backdrop-filter: blur(12px);
		box-shadow: 0 22px 44px -24px rgba(0, 0, 0, 0.9);
		animation: pd-float 6s ease-in-out infinite;
		animation-delay: calc(var(--k) * -1.9s);
	}
	.pdeck__mark-ic { display: grid; place-items: center; width: 26px; height: 26px; flex: none; border-radius: 0.55rem; color: #fff; background: color-mix(in srgb, var(--t) 78%, transparent); }
	.pdeck__mark-txt { display: grid; gap: 0.05rem; min-width: 0; }
	.pdeck__mark-txt b { font-size: 0.76rem; font-weight: 800; color: #fff; }
	.pdeck__mark-txt em { font-style: normal; font-size: 0.7rem; line-height: 1.35; color: rgba(244, 241, 255, 0.62); }
	.pdeck__mark--1 { top: 0; right: 0; }
	.pdeck__mark--2 { bottom: 20%; left: 0; }
	.pdeck__mark--3 { top: 34%; right: -1%; max-width: 9.6rem; }
	@keyframes pd-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
	@media (min-width: 1100px) { .pdeck__mark { display: flex; } }

	.pdeck__work {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		gap: 0.85rem;
		padding: 0.85rem 0.95rem;
		border-radius: 1rem;
		border: 1px solid color-mix(in srgb, var(--pd-a) 28%, rgba(255, 255, 255, 0.12));
		background: color-mix(in srgb, var(--pd-a) 10%, rgba(255, 255, 255, 0.045));
		transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.25, 1), border-color 0.3s ease, background 0.3s ease;
	}
	.pdeck__work:hover {
		transform: translateY(-3px);
		border-color: color-mix(in srgb, var(--pd-a) 60%, transparent);
		background: color-mix(in srgb, var(--pd-a) 16%, rgba(255, 255, 255, 0.045));
	}
	.pdeck__work-mark {
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		flex: none;
		border-radius: 0.75rem;
		color: #fff;
		background: linear-gradient(135deg, var(--pd-a), var(--pd-b));
		box-shadow: 0 14px 26px -14px color-mix(in srgb, var(--pd-a) 80%, transparent);
	}
	.pdeck__work-txt { display: grid; gap: 0.05rem; flex: 1; min-width: 0; }
	.pdeck__work-txt strong { font-size: 0.98rem; font-weight: 800; color: #fff; }
	.pdeck__sector { font-size: 0.7rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: color-mix(in srgb, var(--pd-a) 75%, #fff); }
	.pdeck__note-line { font-size: 0.76rem; line-height: 1.4; color: rgba(244, 241, 255, 0.58); }
	.pdeck__work-go {
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		flex: none;
		border-radius: 9999px;
		color: #fff;
		border: 1px solid color-mix(in srgb, var(--pd-a) 55%, transparent);
		transition: background 0.25s ease, transform 0.25s ease;
	}
	.pdeck__work:hover .pdeck__work-go { background: linear-gradient(135deg, var(--pd-a), var(--pd-b)); transform: translateX(3px); }

	/* ── the projected answer ─────────────────────────────────── */
	.pdeck__answer {
		position: absolute;
		inset: 0;
		z-index: 8;
		display: grid;
		place-items: center;
		padding: clamp(1rem, 3vw, 2.4rem);
		background: rgba(10, 7, 24, 0.86);
		-webkit-backdrop-filter: blur(10px);
		backdrop-filter: blur(10px);
		animation: pd-ans-in 0.35s ease both;
	}
	.pdeck__answer[hidden] { display: none; }
	@keyframes pd-ans-in { from { opacity: 0; } }
	/* the beam that throws it onto the screen */
	.pdeck__answer-beam {
		position: absolute;
		top: -10%;
		left: 50%;
		width: 60%;
		height: 130%;
		transform: translateX(-50%);
		background: linear-gradient(180deg, rgba(252, 211, 77, 0.22), transparent 62%);
		clip-path: polygon(44% 0, 56% 0, 100% 100%, 0 100%);
		filter: blur(16px);
		pointer-events: none;
	}
	.pdeck__answer-card {
		position: relative;
		max-width: 40rem;
		display: grid;
		gap: 0.55rem;
		padding: clamp(1.1rem, 2.6vw, 1.8rem);
		border-radius: 1.1rem;
		border: 1px solid rgba(252, 211, 77, 0.32);
		background: linear-gradient(165deg, rgba(38, 30, 68, 0.96), rgba(22, 17, 44, 0.98));
		box-shadow: 0 40px 90px -40px rgba(0, 0, 0, 1);
		animation: pd-ans-rise 0.45s cubic-bezier(0.22, 1, 0.36, 1) both;
	}
	@keyframes pd-ans-rise { from { opacity: 0; transform: translateY(14px) scale(0.97); } }
	.pdeck__answer-k {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.7rem;
		font-weight: 800;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: #fcd34d;
	}
	.pdeck__answer-card h4 {
		margin: 0;
		font-size: clamp(1.1rem, 2.2vw, 1.5rem);
		font-weight: 850;
		letter-spacing: -0.02em;
		color: #fff;
	}
	.pdeck__answer-card p {
		margin: 0;
		font-size: clamp(0.86rem, 1.3vw, 0.98rem);
		line-height: 1.68;
		color: rgba(244, 241, 255, 0.76);
	}
	.pdeck__answer-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; margin-top: 0.35rem; }
	.pdeck__answer-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.55rem 1rem;
		border-radius: 9999px;
		font-size: 0.8rem;
		font-weight: 800;
		color: #2a0716;
		background: linear-gradient(95deg, #fde68a, #fbbf24);
	}
	.pdeck__answer-cta[hidden] { display: none; }
	.pdeck__answer-cta--ghost {
		color: rgba(244, 241, 255, 0.82);
		background: rgba(255, 255, 255, 0.1);
		border: 1px solid rgba(255, 255, 255, 0.18);
	}
	.pdeck__answer-cta--ghost:hover { background: rgba(255, 255, 255, 0.18); color: #fff; }
	.pdeck__answer-x {
		padding: 0.55rem 0.9rem;
		border-radius: 9999px;
		font-family: inherit;
		font-size: 0.78rem;
		font-weight: 700;
		color: rgba(244, 241, 255, 0.7);
		background: transparent;
		border: 1px solid rgba(255, 255, 255, 0.18);
		cursor: pointer;
	}
	.pdeck__answer-x:hover { color: #fff; background: rgba(255, 255, 255, 0.08); }

	/* ── the Q&A rail ─────────────────────────────────────────── */
	.pdeck__qa {
		position: relative;
		z-index: 6;
		display: grid;
		gap: 0.6rem;
		padding: 0.9rem 3.2rem 1.1rem;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		background: rgba(255, 255, 255, 0.03);
	}
	.pdeck__qa-k {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.7rem;
		font-weight: 800;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: rgba(244, 241, 255, 0.5);
	}
	.pdeck__qa-chips {
		display: flex;
		flex-wrap: nowrap;
		gap: 0.4rem;
		overflow-x: auto;
		scrollbar-width: none;
		margin-inline: -0.4rem;
		padding-inline: 0.4rem;
		-webkit-mask-image: linear-gradient(90deg, #000 0, #000 calc(100% - 1.6rem), transparent);
		mask-image: linear-gradient(90deg, #000 0, #000 calc(100% - 1.6rem), transparent);
	}
	.pdeck__qa-chips::-webkit-scrollbar { display: none; }
	.pdeck__qa-chip {
		flex: none;
		white-space: nowrap;
		padding: 0.4rem 0.8rem;
		border-radius: 9999px;
		font-family: inherit;
		font-size: 0.74rem;
		font-weight: 700;
		color: var(--pd-ink);
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid rgba(255, 255, 255, 0.12);
		cursor: pointer;
		transition: background 0.2s ease, border-color 0.2s ease, transform 0.18s ease;
	}
	.pdeck__qa-chip:hover {
		transform: translateY(-2px);
		border-color: rgba(252, 211, 77, 0.5);
		background: rgba(252, 211, 77, 0.12);
	}
	.pdeck__qa-form {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.35rem 0.35rem 0.35rem 0.75rem;
		border-radius: 9999px;
		background: rgba(0, 0, 0, 0.28);
		border: 1px solid rgba(255, 255, 255, 0.12);
	}
	.pdeck__qa-form :global(.pdeck__qa-ic) { color: rgba(244, 241, 255, 0.4); flex: none; }
	.pdeck__qa-form input {
		flex: 1;
		min-width: 0;
		background: transparent;
		border: 0;
		outline: none;
		font-family: inherit;
		font-size: 0.85rem;
		color: #fff;
	}
	.pdeck__qa-form input::placeholder { color: rgba(244, 241, 255, 0.36); }
	.pdeck__qa-form button {
		display: grid;
		place-items: center;
		width: 34px;
		height: 34px;
		flex: none;
		border: 0;
		border-radius: 9999px;
		color: #2a0716;
		background: linear-gradient(95deg, #fde68a, #fbbf24);
		cursor: pointer;
		transition: transform 0.2s ease;
	}
	.pdeck__qa-form button:hover { transform: scale(1.06); }

	/* ── the clicker arrows ───────────────────────────────────── */
	.pdeck__nav {
		position: absolute;
		top: 50%;
		z-index: 7;
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		transform: translateY(-50%);
		border-radius: 9999px;
		color: #fff;
		background: rgba(12, 9, 26, 0.66);
		border: 1px solid rgba(255, 255, 255, 0.18);
		-webkit-backdrop-filter: blur(8px);
		backdrop-filter: blur(8px);
		cursor: pointer;
		opacity: 0;
		transition: opacity 0.25s ease, background 0.2s ease, transform 0.2s ease;
	}
	.pdeck:hover .pdeck__nav, .pdeck__nav:focus-visible { opacity: 1; }
	.pdeck__nav:hover { background: var(--pd-acc, #8b5cf6); }
	.pdeck__nav--prev { left: 3.5rem; }
	.pdeck__nav--next { right: 3.5rem; }
	@media (hover: none) { .pdeck__nav { opacity: 1; } }

	.pdeck__exit, .pdeck__hint { display: none; }

	/* ══════ full screen ══════ */
	:global(.pdeck-blackout) {
		position: fixed;
		inset: 0;
		z-index: 90;
		background: radial-gradient(120% 100% at 50% 42%, rgba(6, 4, 14, 0.94), rgba(0, 0, 0, 0.99));
		-webkit-backdrop-filter: blur(10px) saturate(0.35) brightness(0.35);
		backdrop-filter: blur(10px) saturate(0.35) brightness(0.35);
		opacity: 0;
		transition: opacity 0.45s ease;
	}
	:global(.pdeck-blackout.is-on) { opacity: 1; }
	:global(html.pd-lights-out .site-header),
	:global(html.pd-lights-out #swizel-chat),
	:global(html.pd-lights-out #back-to-top),
	:global(html.pd-lights-out #view-banner) {
		opacity: 0 !important;
		pointer-events: none !important;
		transition: opacity 0.35s ease;
	}

	.pdeck.is-theatre {
		position: fixed;
		z-index: 95;
		top: 50%;
		left: 50%;
		width: min(97vw, 86rem);
		max-height: 94vh;
		overflow: auto;
		transform: translate(-50%, -50%);
		box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08), 0 80px 160px -50px rgba(0, 0, 0, 1);
		animation: pd-rise 0.5s cubic-bezier(0.22, 1, 0.36, 1);
	}
	@keyframes pd-rise { from { opacity: 0; transform: translate(-50%, -46%) scale(0.96); } }
	:global(.pdeck-hole) { display: block; }

	.pdeck.is-theatre .pdeck__slide { padding-block: clamp(1.6rem, 3vw, 3rem); }
	.pdeck.is-theatre .pdeck__t { font-size: clamp(1.9rem, 3.2vw, 3.4rem); }
	.pdeck.is-theatre .pdeck__nav { opacity: 1; }
	/* A round X that sits well clear of the corner. The old chip carried
	   the word and the Esc key inline, so on a wide screen it ran off the
	   edge of the frame and got clipped; the words now live inside it and
	   only unfold when you reach for the button. */
	.pdeck.is-theatre .pdeck__exit {
		position: absolute;
		z-index: 21;
		/* The auditorium has a velvet frame around the screen, and a 1.2rem
		   inset put this button on top of it — sitting half on the frame and
		   half off the edge, and clipped outright on a narrower laptop. It
		   now lines up with the Pause and Lights row, inside the picture. */
		top: 1.5rem;
		right: clamp(1.6rem, 2.6vw, 2.8rem);
		display: inline-flex;
		align-items: center;
