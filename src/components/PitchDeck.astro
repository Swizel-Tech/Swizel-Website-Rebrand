			{ label: 'AI features & chatbots', icon: 'mdi:robot-happy-outline' },
			{ label: 'Workflow automation', icon: 'mdi:sync' },
			{ label: 'Data pipelines', icon: 'mdi:database-arrow-right-outline' },
		],
		notes: [
			{ title: 'Bolt-on', body: 'Added to what you run today.', icon: 'mdi:puzzle-plus-outline', tint: '#f472b6' },
			{ title: 'Measured', body: 'We count the hours it gives back.', icon: 'mdi:timer-outline', tint: '#fbbf24' },
			{ title: 'Human in the loop', body: 'It assists your team, not replaces it.', icon: 'mdi:hand-heart-outline', tint: '#a78bfa' },
		],
		accent: '#f472b6',
		accent2: '#a78bfa',
		work: {
			name: 'JobbLander',
			sector: 'Careers · AI-enhanced',
			img: '/images/portfolio/shot-jobblander.jpg',
