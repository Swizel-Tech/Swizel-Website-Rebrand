		line: 'Designers, engineers and a PM embedded with your team for as long as you need them — your roadmap, our bench, no hiring cycle.',
		gives: [
			{ label: 'Embedded squads', icon: 'mdi:account-supervisor-outline' },
			{ label: 'Fractional CTO & PM', icon: 'mdi:badge-account-outline' },
			{ label: 'Staff augmentation', icon: 'mdi:account-plus-outline' },
		],
		notes: [
			{ title: 'Start in days', body: 'A bench that is already hired.', icon: 'mdi:rocket-launch-outline', tint: '#34d399' },
			{ title: 'Your process', body: 'We join your board and your standups.', icon: 'mdi:view-column-outline', tint: '#60a5fa' },
			{ title: 'Scale either way', body: 'Add or stand down by the month.', icon: 'mdi:arrow-expand-vertical', tint: '#a78bfa' },
		],
		accent: '#34d399',
		accent2: '#60a5fa',
		work: {
			name: 'Skaldon WatchTower ERP',
			sector: 'Infrastructure',
			img: '/images/portfolio/shot-skaldonerp.jpg',
			host: 'skaldongrouperp.netlify.app',
			url: 'https://skaldongrouperp.netlify.app/',
			note: 'An internal ERP, built and run alongside their own people.',
		},
