	{
		n: '04',
		kicker: 'Strategy',
		kickerIcon: 'mdi:compass-outline',
		title: 'The plan before',
		em: 'the pixels.',
		line: 'Discovery, research and a roadmap you can hold a team to — scoped so the first release is the smallest thing that can actually win.',
		gives: [
			{ label: 'Discovery sprints', icon: 'mdi:map-search-outline' },
			{ label: 'Product roadmaps', icon: 'mdi:map-marker-path' },
			{ label: 'MVP scoping', icon: 'mdi:target' },
		],
		notes: [
			{ title: 'In writing', body: 'Scope agreed before code starts.', icon: 'mdi:file-document-edit-outline', tint: '#a78bfa' },
			{ title: 'Your people', body: 'Workshops with your team in the room.', icon: 'mdi:account-multiple-outline', tint: '#34d399' },
			{ title: 'Portable', body: 'Take the roadmap to any team.', icon: 'mdi:briefcase-arrow-left-right-outline', tint: '#60a5fa' },
		],
		accent: '#a78bfa',
		accent2: '#34d399',
		work: {
			name: 'Hemam Synergy',
			sector: 'Energy & advisory',
			img: '/images/portfolio/shot-hemamsynergy.jpg',
			host: 'hemamsynergy.com',
			url: 'https://hemamsynergy.com/',
			note: 'The positioning and site behind an ~€850,000 funding win.',
		},
	},
	{
		n: '05',
		kicker: 'Growth',
		kickerIcon: 'mdi:bullhorn-outline',
		title: 'Marketing that',
		em: 'moves numbers.',
		line: 'SEO, paid, social, content and email — run for you or with you, and read against the only metric that matters: what converts.',
		gives: [
			{ label: 'SEO & paid ads', icon: 'mdi:magnify' },
			{ label: 'Social & content', icon: 'mdi:instagram' },
