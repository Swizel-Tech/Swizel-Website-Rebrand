	.pdeck__velvet {
		position: absolute;
		top: -1.4rem;
		bottom: 0;
		z-index: 1;
		width: 52%;
		background:
			repeating-linear-gradient(
				90deg,
				rgba(0, 0, 0, 0.42) 0 10px,
				rgba(255, 255, 255, 0.06) 20px,
