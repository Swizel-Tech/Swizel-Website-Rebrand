---
// A film with a real transport, themed off the active view's accent.
//
// One component drives two very different sources. A local file is a plain
// <video>; a YouTube id is an iframe with YouTube's own chrome switched off
// and the IFrame API driving it. Either way the control bar below is ours:
// play, a scrubbable line with buffered fill, elapsed and total, ten seconds
// either way, speed, mute with a volume slider, and full screen. So the same
// furniture appears whether the film sits on our server or YouTube's.
import { Icon } from 'astro-icon/components';

interface Props {
	/** a YouTube id — takes precedence over src */
	videoId?: string;
	/** a file in /public, e.g. /videos/how-we-build.mp4 */
	src?: string;
	poster?: string;
	label?: string;
	/** the little corner flag on the picture */
	tag?: string;
	caption?: string;
	/** start muted and loop, the way a silent showreel behaves */
	ambient?: boolean;
	/** fill a frame that is not 16/9, cropping rather than letterboxing */
	cover?: boolean;
	/** a local still to fall back to if YouTube's thumbnail will not load */
	fallback?: string;
	/** Start on its own once on screen — muted, because every browser
	    refuses autoplay with sound, and the visitor can unmute. On by
	    default: every film on the site behaves this way. Pass
	    `autoplay={false}` for one that should wait to be asked. */
	autoplay?: boolean;
	ratio?: string;
	class?: string;
}

const {
	videoId,
	src,
	poster,
	label = 'Play the film',
	tag,
	caption,
	ambient = false,
	cover = false,
	fallback,
	autoplay = true,
	ratio = '16 / 9',
	class: klass = '',
} = Astro.props;

// A YouTube film already has a still: its own thumbnail. Without it the
// frame is a black rectangle until the iframe mounts on first play. maxres
// does not exist for every upload and some networks refuse i.ytimg.com
// outright, so the poster walks down a ladder — maxres, then hq, then
// whatever local still the caller handed us.
const still = poster || (videoId ? `https://i.ytimg.com/vi/${videoId}/maxresdefault.jpg` : undefined);

const rates = [0.5, 1, 1.25, 1.5, 2];
---

<figure
	class:list={['flm', klass, { 'flm--yt': !!videoId, 'flm--ambient': ambient, 'flm--cover': cover }]}
	data-flm
	data-video-id={videoId}
	data-ambient={ambient ? '1' : undefined}
	data-autoplay={autoplay ? '1' : undefined}
	style={`--flm-ratio:${ratio}`}
>
	<div class="flm__screen" data-flm-screen>
		{
			videoId ? (
				<div class="flm__yt" data-flm-yt />
			) : (
				<video
					class="flm__vid"
					src={src}
					poster={poster}
					muted={ambient}
					loop={ambient}
					playsinline
					preload="none"
					aria-label={label}
					data-flm-vid
				/>
			)
		}

		{still && videoId && (
			<img
				class="flm__poster"
				src={still}
				alt=""
				aria-hidden="true"
				loading="lazy"
				decoding="async"
				data-flm-poster
				data-flm-poster-fallback={fallback}
			/>
		)}

		{tag && (
			<span class="flm__tag" aria-hidden="true">
				<Icon width={12} name="mdi:filmstrip" />
				{tag}
			</span>
		)}

		<!-- the big invitation, until the film is running -->
		<button class="flm__big" type="button" data-flm-big aria-label={label}>
			<span class="flm__big-ring" aria-hidden="true" />
			<Icon width={26} name="mdi:play" />
		</button>

		<span class="flm__spin" aria-hidden="true" data-flm-spin />

		<!-- Only ever seen in cinema mode: the way back out. iOS will not
		     put a div in real full screen, so on a phone "full screen"
		     means this player is thrown over the viewport instead, and a
		     thrown-over player with no visible way out is a trap. -->
		<button class="flm__close" type="button" data-flm-close aria-label="Close full screen" hidden>
			<Icon width={20} name="mdi:close" />
		</button>

		<!-- ── the transport, on the glass ── -->
		<div class="flm__bar" data-flm-bar>
			<div
				class="flm__seek"
				role="slider"
				tabindex="0"
				aria-label="Seek"
				aria-valuemin="0"
				aria-valuemax="100"
				aria-valuenow="0"
				data-flm-seek
			>
				<span class="flm__seek-track" aria-hidden="true">
					<span class="flm__seek-buf" data-flm-buf />
					<span class="flm__seek-fill" data-flm-fill />
					<span class="flm__seek-knob" data-flm-knob />
				</span>
			</div>

			<div class="flm__row">
				<button class="flm__b flm__b--play" type="button" data-flm-play aria-label="Play">
					<Icon class="flm__i flm__i--play" width={17} name="mdi:play" />
					<Icon class="flm__i flm__i--pause" width={17} name="mdi:pause" />
				</button>
				<button class="flm__b" type="button" data-flm-skip="-10" aria-label="Back ten seconds">
					<Icon width={16} name="mdi:rewind-10" />
				</button>
				<button class="flm__b" type="button" data-flm-skip="10" aria-label="Forward ten seconds">
					<Icon width={16} name="mdi:fast-forward-10" />
				</button>

				<div class="flm__vol">
					<button class="flm__b" type="button" data-flm-mute aria-label="Mute">
						<Icon class="flm__i flm__i--loud" width={17} name="mdi:volume-high" />
						<Icon class="flm__i flm__i--muted" width={17} name="mdi:volume-off" />
					</button>
					<input
						class="flm__vol-range"
						type="range"
						min="0"
						max="100"
						value="100"
						aria-label="Volume"
						data-flm-vol
					/>
				</div>

				<span class="flm__t" data-flm-now>0:00</span>
				<span class="flm__t flm__t--dim">/</span>
				<span class="flm__t flm__t--dim" data-flm-dur>0:00</span>

				<span class="flm__spacer" aria-hidden="true" />

				<button class="flm__b flm__b--rate" type="button" data-flm-rate aria-label="Playback speed">
					<b data-flm-rate-t>1×</b>
				</button>
				<button class="flm__b" type="button" data-flm-full aria-label="Full screen">
					<Icon width={16} name="mdi:fullscreen" />
				</button>
			</div>
		</div>
	</div>

	{caption && <figcaption class="flm__cap">{caption}</figcaption>}
	<span class="flm__rates" hidden data-flm-rates>{rates.join(',')}</span>
</figure>

<style>
	.flm {
		--flm-a: var(--view-accent, #18debe);
		position: relative;
		margin: 0;
		display: grid;
		gap: 0.55rem;
		width: 100%;
	}

	.flm__screen {
		position: relative;
		overflow: hidden;
		aspect-ratio: var(--flm-ratio, 16 / 9);
		border-radius: 0.9rem;
		background: #07070d;
		border: 1px solid color-mix(in srgb, var(--flm-a) 26%, transparent);
		box-shadow:
			0 30px 70px -34px rgba(0, 0, 0, 0.9),
			0 0 0 1px rgba(255, 255, 255, 0.04) inset;
	}
	.flm__vid,
	.flm__yt,
	.flm__poster {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
		display: block;
		object-fit: cover;
	}
	.flm__yt :global(iframe) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
		/* YouTube's own chrome is switched off in the player vars, but its
		   end screen, its wordmark and its full-screen button still paint
		   over our transport and still take clicks — the iframe is its own
		   layer. Reaching for "1×" was landing on YouTube's full-screen
		   button sitting in the same corner. Everything here is driven
		   through the IFrame API, so the frame itself never needs to be
		   clicked; the screen below still takes the tap-to-pause. */
		pointer-events: none;
	}

	/* ── covering a frame that is not 16/9 ────────────────────────────
	   A <video> takes object-fit; an iframe does not. So the YouTube
	   frame is given the smallest 16/9 box that still covers the screen
	   — measured in script, because container-query units are quietly
	   dropped by some browsers — then centred, with the excess cropped
	   by the screen's own overflow. No black bars, no squashed picture. */
	.flm--cover .flm__yt :global(iframe) {
		inset: auto;
		top: 50%;
		left: 50%;
		width: var(--flm-cw, 100%);
		height: var(--flm-ch, 100%);
		/* a global `iframe { max-width: 100% }` would clamp the overhang
		   straight back to the frame and undo the crop */
		max-width: none;
		max-height: none;
		transform: translate(-50%, -50%);
	}
	.flm__poster {
		object-fit: cover;
		z-index: 1;
		transition: opacity 0.4s ease;
	}
	.flm.is-started .flm__poster { opacity: 0; pointer-events: none; }

	.flm__tag {
		position: absolute;
		top: 0.7rem;
		left: 0.7rem;
		z-index: 3;
		display: inline-flex;
		align-items: center;
		gap: 0.32rem;
		padding: 0.24rem 0.55rem;
		border-radius: 9999px;
		background: rgba(8, 8, 16, 0.72);
		-webkit-backdrop-filter: blur(6px);
		backdrop-filter: blur(6px);
		color: #eef6f8;
		font-size: 0.6rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	/* the invitation */
	.flm__big {
		position: absolute;
		inset: 0;
		z-index: 4;
		display: grid;
		place-items: center;
		border: 0;
		background: radial-gradient(60% 60% at 50% 50%, rgba(6, 6, 14, 0.35), rgba(6, 6, 14, 0.62));
		color: #06231c;
		cursor: pointer;
		transition: opacity 0.35s ease;
	}
	.flm__big > :global(svg) {
		position: relative;
		z-index: 1;
		margin-left: 3px;
	}
	.flm__big-ring {
		position: absolute;
		width: 4.4rem;
		height: 4.4rem;
		border-radius: 9999px;
		background: linear-gradient(120deg, #fff, var(--flm-a));
		box-shadow:
			0 0 50px -4px color-mix(in srgb, var(--flm-a) 90%, transparent),
			0 0 0 0 color-mix(in srgb, var(--flm-a) 55%, transparent);
		transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
		animation: flm-beat 1.9s cubic-bezier(0.22, 1, 0.36, 1) infinite;
	}
	/* two rings leaving the button, half a beat apart, so the invitation
	   carries across a dark frame instead of sitting quietly in it */
	.flm__big::before,
	.flm__big::after {
		content: '';
		position: absolute;
		width: 4.4rem;
		height: 4.4rem;
		border-radius: 9999px;
		border: 2px solid var(--flm-a);
		opacity: 0;
		animation: flm-ping 1.9s cubic-bezier(0.16, 0.8, 0.4, 1) infinite;
		pointer-events: none;
	}
	.flm__big::after { animation-delay: 0.95s; }
	/* the invitation, turned up: a deeper breath and two rings that travel
	   further, so the button reads as "press me" across a busy still */
	@keyframes flm-beat {
		0%, 100% { transform: scale(1); }
		42% { transform: scale(1.13); }
		62% { transform: scale(1.04); }
	}
	@keyframes flm-ping {
		0% { opacity: 0.95; transform: scale(1); border-width: 3px; }
		70% { opacity: 0; transform: scale(2.8); border-width: 1px; }
		100% { opacity: 0; transform: scale(2.8); border-width: 1px; }
	}
	.flm__big:hover .flm__big-ring { transform: scale(1.12); animation-play-state: paused; }
	.flm.is-started .flm__big::before,
	.flm.is-started .flm__big::after { animation: none; opacity: 0; }
	@media (prefers-reduced-motion: reduce) {
		.flm__big-ring, .flm__big::before, .flm__big::after { animation: none; }
	}
	.flm.is-started .flm__big { opacity: 0; pointer-events: none; }

	.flm__spin {
		position: absolute;
		top: 50%;
		left: 50%;
		z-index: 5;
		width: 2rem;
		height: 2rem;
		margin: -1rem 0 0 -1rem;
		border-radius: 9999px;
		border: 2px solid rgba(255, 255, 255, 0.25);
		border-top-color: var(--flm-a);
		opacity: 0;
		pointer-events: none;
	}
	.flm.is-waiting .flm__spin { opacity: 1; animation: flm-spin 0.8s linear infinite; }

	/* a network that refuses YouTube still gets a way to the film */
	.flm__blocked {
		position: absolute;
		inset: auto 0 0 0;
		z-index: 7;
		padding: 0.55rem;
		text-align: center;
		background: rgba(6, 8, 14, 0.85);
		color: #fff;
		font-size: 0.76rem;
		font-weight: 700;
		text-decoration: none;
	}
	.flm__blocked:hover { background: rgba(6, 8, 14, 0.95); }
	.flm.is-blocked .flm__big { opacity: 1; pointer-events: auto; }
	@keyframes flm-spin { to { transform: rotate(1turn); } }

	/* ══ the transport, on the glass ══════════════════════════════════
	   It rides the bottom of the picture on its own scrim, shows while the
	   film is parked or the pointer is near, and gets out of the way once
	   it is running and nobody is asking. The scrub line spans the full
	   width above the buttons, the way a film player should. */
	.flm__bar {
		position: absolute;
		inset: auto 0 0 0;
		z-index: 6;
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.15rem;
		padding: 2.6rem 0.65rem 0.55rem;
		background: linear-gradient(180deg, transparent, rgba(4, 5, 10, 0.55) 45%, rgba(4, 5, 10, 0.88));
		opacity: 0;
		transform: translateY(8px);
		transition: opacity 0.28s ease, transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
		pointer-events: none;
	}
	.flm__bar > * { pointer-events: auto; }
	/* parked, hovered, focused or being scrubbed: the controls are there */
	.flm:not(.is-playing) .flm__bar,
	.flm__screen:hover .flm__bar,
	.flm.is-scrubbing .flm__bar,
	.flm__bar:focus-within {
		opacity: 1;
		transform: none;
	}
	/* until the film has started the big button owns the frame */
	.flm:not(.is-started) .flm__bar { opacity: 0; pointer-events: none; }
	/* A film that started itself is playing, and a playing film hides its
	   bar until you hover — which left the pulsing mute button where
	   nobody could see it. While it is asking to be pressed, the bar
	   stays up. */
	.flm__bar:has(.is-mutehint) { opacity: 1; transform: none; }
	/* Full screen: the transport stays up. YouTube's own chrome is out of
	   the hit test, so ours is the only way to stop the film — it must
	   never be the thing that is hidden. */
	.flm__screen:fullscreen .flm__bar,
	.flm__screen:-webkit-full-screen .flm__bar { opacity: 1; transform: none; }

	.flm__row {
		display: flex;
		align-items: center;
		gap: 0.2rem;
	}

	.flm__b {
		display: grid;
		place-items: center;
		flex: none;
		width: 2.1rem;
		height: 2.1rem;
		border: 0;
		border-radius: 0.55rem;
		background: transparent;
		color: rgba(240, 249, 252, 0.92);
		cursor: pointer;
		transition: background 0.18s ease, color 0.18s ease, transform 0.18s ease;
	}
	.flm__b:hover { background: rgba(255, 255, 255, 0.16); color: #fff; }
	.flm__b:active { transform: scale(0.9); }
	.flm__b:focus-visible { outline: 2px solid var(--flm-a); outline-offset: 1px; }
	.flm__b--play {
		width: 2.3rem;
		height: 2.3rem;
		margin-right: 0.15rem;
		background: var(--flm-a);
		color: #06231c;
		box-shadow: 0 6px 18px -8px color-mix(in srgb, var(--flm-a) 90%, transparent);
	}
	.flm__b--play:hover { background: var(--flm-a); filter: brightness(1.12); color: #06231c; }

	.flm__i--pause { display: none; }
	.flm.is-playing .flm__i--play { display: none; }
	.flm.is-playing .flm__i--pause { display: block; }
	.flm__i--muted { display: none; }
	.flm.is-muted .flm__i--loud { display: none; }
	.flm.is-muted .flm__i--muted { display: block; }

	.flm__b--rate { width: auto; padding: 0 0.45rem; font-size: 0.7rem; font-weight: 800; }

	.flm__t {
		flex: none;
		min-width: 2.45rem;
		font-size: 0.68rem;
		font-weight: 700;
		font-variant-numeric: tabular-nums;
		text-align: center;
		color: rgba(240, 249, 252, 0.9);
	}
	.flm__t--dim { color: rgba(240, 249, 252, 0.55); }

	.flm__spacer { flex: 1 1 auto; }

	/* the scrub line: full width, above the buttons */
	.flm__seek {
		width: 100%;
		height: 1.1rem;
		display: flex;
		align-items: center;
		cursor: pointer;
		touch-action: none;
	}
	.flm__seek:focus-visible { outline: 2px solid var(--flm-a); outline-offset: 2px; border-radius: 4px; }
	.flm__seek-track {
		position: relative;
		width: 100%;
		height: 3px;
		border-radius: 9999px;
		background: rgba(255, 255, 255, 0.22);
		transition: height 0.18s ease;
	}
	.flm__seek:hover .flm__seek-track,
	.flm.is-scrubbing .flm__seek-track { height: 5px; }
	.flm__seek-buf,
	.flm__seek-fill {
		position: absolute;
		inset: 0 auto 0 0;
		height: 100%;
		border-radius: inherit;
		width: 0%;
	}
	.flm__seek-buf { background: rgba(255, 255, 255, 0.24); }
	.flm__seek-fill { background: var(--flm-a); }
	.flm__seek-knob {
		position: absolute;
		top: 50%;
		left: 0%;
		width: 12px;
		height: 12px;
		margin: -6px 0 0 -6px;
		border-radius: 9999px;
		background: #fff;
		box-shadow: 0 0 0 4px color-mix(in srgb, var(--flm-a) 45%, transparent);
		transform: scale(0.001);
		transition: transform 0.18s ease;
	}
	.flm__seek:hover .flm__seek-knob,
	.flm__seek:focus-visible .flm__seek-knob,
	.flm.is-scrubbing .flm__seek-knob { transform: scale(1); }

	/* volume, revealed on approach so the bar stays calm */
	.flm__vol { display: flex; align-items: center; gap: 0.1rem; }
	.flm__vol-range {
		width: 0;
		opacity: 0;
		height: 3px;
		accent-color: var(--flm-a);
		cursor: pointer;
		transition: width 0.28s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.2s ease;
	}
	.flm__vol:hover .flm__vol-range,
	.flm__vol:focus-within .flm__vol-range { width: 3.6rem; opacity: 1; }

	.flm__cap {
		font-family: 'Bradley Hand', 'Segoe Print', 'Comic Sans MS', cursive;
		font-size: 0.92rem;
		font-weight: 700;
		text-align: center;
		color: var(--flm-cap, rgba(233, 240, 255, 0.72));
	}
	:global(html:not(.dark)) .flm__cap { color: rgba(20, 22, 40, 0.62); }

	/* a silent showreel hides the noisy half of the transport */
	.flm--ambient .flm__vol { display: none; }

	@media (max-width: 640px) {
		.flm__bar { padding: 2rem 0.45rem 0.45rem; }
		.flm__row { gap: 0.1rem; }
		.flm__b { width: 1.9rem; height: 1.9rem; }
		.flm__b--play { width: 2.1rem; height: 2.1rem; }
		.flm__t { min-width: 2.1rem; font-size: 0.62rem; }
		.flm__vol-range { display: none; }
		.flm__b--rate { display: none; }
		/* on a touch screen there is no hover, so the bar stays out */
		.flm.is-started .flm__bar { opacity: 1; transform: none; }
	}
	@media (hover: none) {
		.flm.is-started .flm__bar { opacity: 1; transform: none; }
	}
	@media (prefers-reduced-motion: reduce) {
		.flm__spin { animation: none !important; }
	}

	/* ══ cinema mode ══════════════════════════════════════════════════
	   What "full screen" means on a device that will not give an element
	   real full screen. The player is thrown over the viewport, the room
	   goes black around it, and the controls are at their proper size for
	   the first time — which on a phone is the whole point, because the
	   inline bar on a card a third of a screen wide is unusable.

	   Last in the sheet so it beats the sizing rules above it without
	   having to out-specify them. */
	/* !important on the box: the pages that host a film pin it to their own
	   panel with `.ab-screen .flm { width: 100%; height: 100% }`, which is
	   the same weight as this rule, so which one wins comes down to which
	   stylesheet the bundler happens to put last. A mode that fills the
	   screen cannot be decided by sheet order. */
	.flm.is-cinema {
		position: fixed !important;
		inset: 0 !important;
		z-index: 9000;
		margin: 0;
		display: grid;
		place-items: center;
		gap: 0;
		width: 100vw !important;
		height: 100dvh !important;
		max-width: none !important;
		max-height: none !important;
		padding: env(safe-area-inset-top) env(safe-area-inset-right)
			env(safe-area-inset-bottom) env(safe-area-inset-left);
		background: #000;
		animation: flm-cinema-in 0.28s cubic-bezier(0.22, 1, 0.36, 1) both;
	}
	@keyframes flm-cinema-in {
		from { opacity: 0; }
		to { opacity: 1; }
	}
	.flm.is-cinema .flm__screen {
		width: 100% !important;
		height: auto !important;
		max-height: 100% !important;
		aspect-ratio: 16 / 9 !important;
		border: 0;
		border-radius: 0;
		box-shadow: none;
		background: #000;
	}
	/* the cover crop exists to fill a short card; over a whole screen it
	   would throw away the sides of the picture instead */
	.flm.is-cinema :global(.flm__yt),
	.flm.is-cinema .flm__vid,
