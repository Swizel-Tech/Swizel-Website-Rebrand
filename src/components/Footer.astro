---
import { Icon } from 'astro-icon/components';
import Link from './Link.astro';
import Logo from './Logo.astro';
import { formatLink, links } from '../consts';

const offices = [
	{
		flag: '🇳🇬',
		country: 'Nigeria',
		city: 'Abuja',
		lines: ['2155 Peculiar Estate', 'Lokogoma, Abuja'],
		tz: 'Africa/Lagos',
	},
	{
		flag: '🇮🇪',
		country: 'Ireland',
		city: 'Cork',
		lines: ['Eden Hall, Modern Farm Road', 'Cork, Ireland'],
		tz: 'Europe/Dublin',
	},
	{
		flag: '🇬🇧',
		country: 'United Kingdom',
		city: 'Sheffield',
		lines: ['1, Sheffield', 'South Yorkshire', 'S2 3DB, England'],
		tz: 'Europe/London',
	},
	{
		flag: '🇺🇸',
		country: 'United States',
		city: 'New York',
		lines: ['Tiemann Ave', 'Bronx, New York'],
		tz: 'America/New_York',
	},
];

const socials = [
	{ name: 'X', short: '@swizelhq', handle: '@swizelhq', icon: 'twitter', isX: true, href: 'https://twitter.com/swizelhq', tag: 'Daily build updates', color: '#0f1419', peek: 'Ship week at Swizel. Another product just went live. Follow along for launches and behind-the-build threads.' },
	{ name: 'Instagram', short: '@swizelhq', handle: '@swizelhq', icon: 'instagram', href: 'https://instagram.com/swizelhq', tag: 'Behind the scenes', color: '#e1486c', peek: 'The studio, unfiltered. Whiteboards, late builds, launch days and the team behind it all.' },
	{ name: 'LinkedIn', short: 'Swizel Tech', handle: 'Swizel Technologies Limited', icon: 'linkedin', href: 'https://www.linkedin.com/company/swizel-technologies-limited/', tag: 'Company & careers', color: '#0a8bd4', peek: 'Company news, open roles and stories from the products we ship across 10+ countries.' },
	{ name: 'Facebook', short: 'Swizel Tech', handle: 'Swizel Technologies Limited', icon: 'facebook', href: 'https://www.facebook.com/SWIZELTECHNOLOGIESLIMITED/', tag: 'Community & news', color: '#3b82f6', peek: 'Our community home for announcements, events and milestones from the Swizel family.' },
];

// The channel's uploads playlist is simply UU + the channel id minus its
// UC prefix, so the TV in the footer always plays the newest videos with
// nothing to keep up to date by hand.
const YT_CHANNEL = 'UCZlQKVfjUd1Y0t362gQDgDg';
const YT_UPLOADS = `UU${YT_CHANNEL.slice(2)}`;
const YT_URL = 'https://www.youtube.com/@SwizelTechnologiesLtd';

// Local number first, then international lines. Flags, no labels.
const phones = [
	{ num: '+234 810 020 4570', flag: '🇳🇬' },
	{ num: '+1 701 498 1811', flag: '🇺🇸' },
];
---

<footer class="site-footer">
	<div class="ft-decor" aria-hidden="true">
		<span class="ft-weave"></span>
		<span class="ft-horizon"></span>
		<span class="ft-orb ft-orb-1"></span>
		<span class="ft-orb ft-orb-2"></span>
		{Array.from({ length: 6 }).map((_, i) => <span class="ft-spark" style={`--i:${i}`} />)}
	</div>

	<!-- CTA strip -->
	<div class="ft-cta">
		<span class="ft-cta-kicker">Have an idea?</span>
		<h2 class="ft-cta-title font-bebas">
			Let's build something
			<span class="gradient-text">unforgettable</span>
		</h2>
		<p class="ft-cta-sub">
			If you can imagine it, we will build it. Tell us about your project
			and get a reply within one business day.
		</p>
		<a href="/contact" class="ft-cta-btn">
			Start your project
			<Icon width={18} name="mdi:arrow-right" />
		</a>
	</div>

	<!-- Main grid -->
	<div class="ft-main">
		<div class="ft-brand">
			<Link href="/" class="ft-logo" aria-label="Swizel home">
				<Logo width={120} />
			</Link>
			<p class="ft-pitch">
				A global product studio. We design, build, market and maintain
				software people love, across every sector.
			</p>
			<!-- Campus TV: the channel's own uploads playlist, newest first,
			     rolling one into the next. It only loads once you have
			     scrolled to it, and it starts muted. -->
			<div class="ft-tv" data-ft-tv data-list={YT_UPLOADS}>
				<span class="ft-tv-top">
					<span class="ft-tv-badge">
						<i aria-hidden="true"></i>
						Swizel TV
					</span>
					<a class="ft-tv-link" href={YT_URL} target="_blank" rel="noopener noreferrer">
						the channel
						<Icon width={13} name="mdi:arrow-top-right" />
					</a>
				</span>
				<div class="ft-tv-screen">
					<div class="ft-tv-mount" data-ft-tv-mount></div>
					<button class="ft-tv-poster" type="button" data-ft-tv-play>
						<span class="ft-tv-play" aria-hidden="true">
							<Icon width={26} name="mdi:play" />
						</span>
						<span class="ft-tv-poster-t">Play the channel</span>
						<span class="ft-tv-poster-s">Latest uploads, back to back</span>
					</button>
					<span class="ft-tv-scan" aria-hidden="true"></span>
				</div>
				<button class="ft-tv-sound" type="button" data-ft-tv-sound hidden>
					<Icon width={14} name="mdi:volume-off" />
					Muted. Tap for sound
				</button>
			</div>

		</div>

		<div class="ft-col ft-offices">
			<span class="ft-h">Our offices</span>
			<ul>
				{
					offices.map((o) => (
						<li class="ft-office">
							<div class="ft-office-top">
								<span class="ft-flag">{o.flag}</span>
								<span class="ft-office-country">{o.country}</span>
								<span class="ft-clock" data-tz={o.tz}>
									<span class="ft-clock-dot" />
									<span class="ft-clock-time">--:--</span>
								</span>
							</div>
							<address>{o.lines.join(', ')}</address>
						</li>
					))
				}
			</ul>
		</div>

		<div class="ft-col">
			<span class="ft-h">Talk to us</span>
			<ul class="ft-contact">
				<li>
					<Icon width={17} name="mdi:email-outline" />
					<a href="mailto:contact@swizel.co">contact@swizel.co</a>
				</li>
				<li>
					<Icon width={17} name="mdi:email-outline" />
					<a href="mailto:swizelhq@swizel.co">swizelhq@swizel.co</a>
				</li>
				{
					phones.map((p) => (
						<li>
							<Icon width={17} name="mdi:phone-outline" />
							<span class="ft-flag-sm">{p.flag}</span>
							<a href={`tel:${p.num.replace(/[^0-9+]/g, '')}`}>{p.num}</a>
						</li>
					))
				}
				<li>
					<Icon width={17} name="mdi:whatsapp" />
					<span class="ft-flag-sm">🇳🇬</span>
					<a
						href="https://wa.me/2348100204570"
						target="_blank"
						rel="noopener noreferrer"
					>
						+234 810 020 4570
					</a>
				</li>
			</ul>
		</div>

		<div class="ft-col ft-social-col">
			<span class="ft-h">Follow the build</span>

			<!-- Campus keeps its own: a noticeboard of pinned cards rather
			     than a stack of logos, since we cannot pull live posts. -->
			<div class="ft-pinboard">
				{
					socials.map((sc, i) => (
						<a
							class="ft-pin"
							href={sc.href}
							target="_blank"
							rel="noopener noreferrer"
							style={`--pk:${sc.color}; --i:${i}; --r:${(i % 3) - 1}`}
						>
							<span class="ft-pin-tack" aria-hidden="true">📌</span>
							<span class="ft-pin-ic">
								{sc.isX ? (
									<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
										<path d="M13.86 10.9 21.2 2.4h-1.74l-6.37 7.38L7.99 2.4H2.4l7.7 11.2-7.7 8.95h1.74l6.73-7.82 5.38 7.82h5.59l-7.98-11.65Zm-2.38 2.77-.78-1.11L4.77 3.71h2.67l5.01 7.16.78 1.12 6.51 9.3h-2.67l-5.59-7.99Z" />
									</svg>
								) : (
									<Icon size={18} name={sc.icon} />
								)}
							</span>
							<strong class="ft-pin-handle">{sc.short}</strong>
							<em class="ft-pin-tag">{sc.tag}</em>
							<span class="ft-pin-go" aria-hidden="true">
								<Icon width={13} name="mdi:arrow-top-right" />
							</span>
						</a>
					))
				}
			</div>

			<div class="ft-socials">
				{
					socials.map((s) => (
						<a
							class="ft-social"
							href={s.href}
							target="_blank"
							rel="noopener noreferrer"
							style={`--pk:${s.color}`}
						>
							<span class="ft-social-ic">
								<Icon size={22} name={s.icon} />
							</span>
							<span class="ft-social-meta">
								<span class="ft-social-name">{s.name}</span>
								<span class="ft-social-handle">{s.handle}</span>
								<span class="ft-social-tag">{s.tag}</span>
							</span>
							<span class="ft-social-go">
								<Icon width={15} name="mdi:arrow-top-right" />
							</span>

							{/* hover preview of a recent post */}
							<span class="ft-peek" aria-hidden="true">
								<span class="ft-peek-head">
									<span class="ft-peek-ic">
										<Icon size={15} name={s.icon} />
									</span>
									<span class="ft-peek-id">
										<strong>{s.name}</strong>
										<em>{s.handle}</em>
									</span>
									<span class="ft-peek-live">latest</span>
								</span>
								<span class="ft-peek-media">
									<Icon width={22} name="mdi:image-multiple-outline" />
									<span>Recent post preview</span>
								</span>
								<span class="ft-peek-body">{s.peek}</span>
							</span>
						</a>
					))
				}
			</div>
		</div>

		<!-- the signal band: its own row, running from Talk to us all the
		     way across under Follow the build -->
		<div class="ft-signal">
			<span class="ft-signal-edge" aria-hidden="true"></span>
			<div class="ft-signal-copy">
				<span class="ft-signal-h">
					<Icon width={15} name="mdi:paper-airplane" />
					Stay in the loop
				</span>
				<p>One short note when something ships. No noise, no selling.</p>
			</div>
			<form id="footer-newsletter" class="ft-signal-form">
				<span class="ft-signal-field">
					<Icon width={16} name="mdi:email-outline" />
					<input
						type="email"
						name="email"
						required
						placeholder="you@company.com"
						aria-label="Email address"
					/>
				</span>
				<button type="submit" id="footer-news-btn">
					<span>Join</span>
					<Icon width={16} name="mdi:send" />
				</button>
			</form>
			<span class="ft-news-msg" id="footer-news-msg" role="status"></span>
		</div>
	</div>

	<nav class="ft-nav" aria-label="Footer">
		<Link href="/" class="ft-nav-item">Home</Link>
		{
			links.map((l) => (
				<Link class:list={['ft-nav-item capitalize', { 'nav-bootcamp': l === 'programs' }]} href={`/${l}`}>
					{formatLink(l)}
				</Link>
			))
		}
		<Link href="/contact" class="ft-nav-item">Contact</Link>
	</nav>

	<div class="ft-bottom">
		<span>&copy; <span id="footer-year"></span> <span class="ft-co-full">Swizel Technologies Limited</span><span class="ft-co-short">Swizel Tech LTD</span></span>
		<button class="ft-film" type="button" data-open-film aria-label="Watch the welcome film">
			<span class="ft-film-ic" aria-hidden="true">
				<svg viewBox="0 0 40 40">
					<circle cx="20" cy="20" r="18.4" fill="none" stroke="currentColor" stroke-width="1" opacity="0.3" />
					<circle class="ft-film-arc" cx="20" cy="20" r="18.4" fill="none" stroke="currentColor"
						stroke-width="1.4" stroke-linecap="round" stroke-dasharray="26 90" />
					<!-- the Swizel mark, wearing whichever world you are in -->
					<g class="ft-film-mark" transform="translate(11.6 11.2) scale(0.345)" fill="currentColor">
						<path d="M30.1778 20.2051H40.0144V33.0823H30.1778V20.2051Z" />
						<path d="M30.0466 0.904297H44.569C47.4137 0.904297 49.7198 3.21041 49.7198 6.05514V18.7893H30.0466V0.904297Z" />
						<path d="M0.00012207 6.05514C0.00012207 3.21041 2.30624 0.904297 5.15097 0.904297H28.6158V33.0973H0.00012207V6.05514Z" />
					</g>
				</svg>
			</span>
			<span class="ft-film-txt">Watch the intro</span>
		</button>
		<span class="ft-bottom-globe">You Imagine, We Build <span class="ft-globe">🌍</span></span>
	</div>
</footer>

<style>
	.site-footer {
		/* light by default, original deep look in dark mode */
		--ft-bg: linear-gradient(180deg, #eef2f7 0%, #e2e8f2 100%);
		--ft-ink: #14162a;
		--ft-muted: rgba(20, 22, 40, 0.66);
		--ft-faint: rgba(20, 22, 40, 0.45);
		--ft-card: rgba(20, 22, 40, 0.05);
		--ft-border: rgba(20, 22, 40, 0.12);
		position: relative;
		z-index: 2;
		overflow: hidden;
		color: var(--ft-ink);
		background: var(--ft-bg);
		padding: 0 5% 1.5rem;
		isolation: isolate;
		transition: background 0.4s ease, color 0.4s ease;
	}
	:global(html.dark) .site-footer {
		--ft-bg: linear-gradient(180deg, #15172a 0%, #0e0f1a 100%);
		--ft-ink: #e9eaf2;
		--ft-muted: rgba(233, 234, 242, 0.66);
		--ft-faint: rgba(233, 234, 242, 0.45);
		--ft-card: rgba(255, 255, 255, 0.04);
		--ft-border: rgba(255, 255, 255, 0.1);
	}
	.ft-decor { position: absolute; inset: 0; z-index: 0; pointer-events: none; }

	/* ── the ground ──
	   A fine weave rather than a flat slab, plus a lit horizon along the top
	   edge so the page closes on something rather than just stopping. Both
	   are per world: the weave changes pattern, the horizon changes colour
	   with the accent. */
	.ft-weave {
		position: absolute;
		inset: 0;
		opacity: 0.5;
		background-image:
			repeating-linear-gradient(90deg, transparent 0 63px, color-mix(in srgb, var(--view-accent, #18debe) 12%, transparent) 63px 64px),
			repeating-linear-gradient(180deg, transparent 0 63px, color-mix(in srgb, var(--view-accent, #18debe) 8%, transparent) 63px 64px);
		-webkit-mask-image: radial-gradient(120% 80% at 50% 0%, #000 10%, transparent 72%);
		mask-image: radial-gradient(120% 80% at 50% 0%, #000 10%, transparent 72%);
	}
	:global(html:not(.dark)) .ft-weave { opacity: 0.35; }

	/* the horizon: a hairline of accent light where the page ends */
	.ft-horizon {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 200px;
		background:
			linear-gradient(180deg, color-mix(in srgb, var(--view-accent, #18debe) 16%, transparent), transparent 70%);
	}
	.ft-horizon::after {
		content: '';
		position: absolute;
		top: 0;
		left: 8%;
		right: 8%;
		height: 1px;
		background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--view-accent, #18debe) 85%, transparent), transparent);
	}

	/* Boardroom: a calm, wide grid, almost architectural. */
	:global(html[data-view='boardroom']) .ft-weave {
		background-image:
			repeating-linear-gradient(90deg, transparent 0 95px, color-mix(in srgb, var(--view-accent) 11%, transparent) 95px 96px),
			repeating-linear-gradient(180deg, transparent 0 95px, color-mix(in srgb, var(--view-accent) 7%, transparent) 95px 96px);
	}
	/* Builder: terminal rules, tight and horizontal. */
	:global(html[data-view='builder']) .ft-weave {
		opacity: 0.42;
		background-image:
			repeating-linear-gradient(180deg, transparent 0 5px, color-mix(in srgb, var(--view-accent) 13%, transparent) 5px 6px);
	}
	/* Founder: a diagonal climb. */
	:global(html[data-view='founder']) .ft-weave {
		background-image:
			repeating-linear-gradient(58deg, transparent 0 70px, color-mix(in srgb, var(--view-accent) 12%, transparent) 70px 71px);
	}
	/* Campus: ruled exercise paper with the margin down one side. */
	:global(html[data-view='campus']) .ft-weave {
		opacity: 0.4;
		background-image:
			repeating-linear-gradient(180deg, transparent 0 33px, color-mix(in srgb, var(--view-accent) 15%, transparent) 33px 34px),
			linear-gradient(90deg, transparent 11%, rgba(239, 68, 68, 0.28) 11%, rgba(239, 68, 68, 0.28) calc(11% + 1px), transparent calc(11% + 1px));
	}
	/* Studio: a fine halftone. */
	:global(html[data-view='studio']) .ft-weave {
		opacity: 0.45;
		background-image: radial-gradient(color-mix(in srgb, var(--view-accent) 30%, transparent) 1px, transparent 1.4px);
		background-size: 14px 14px;
	}

	.ft-orb { position: absolute; border-radius: 9999px; filter: blur(80px); opacity: 0.5; }
	/* light mode: the glow orbs smear into a milky wash — keep them faint */
	:global(html:not(.dark)) .ft-orb { opacity: 0.12; }
	:global(html:not(.dark)) .ft-cta-kicker { color: color-mix(in srgb, var(--view-accent, #28a6ec) 60%, #0b2e40); }
	.ft-orb-1 { width: 34vw; height: 34vw; top: -14%; right: -8%; opacity: 0.34; background: radial-gradient(circle, color-mix(in srgb, var(--view-accent, #18debe) 42%, transparent), transparent 70%); }
	.ft-orb-2 { width: 28vw; height: 28vw; bottom: -18%; left: -10%; opacity: 0.3; background: radial-gradient(circle, color-mix(in srgb, var(--view-accent, #18debe) 26%, transparent), transparent 70%); }
	:global(html:not(.dark)) .ft-orb-1,
	:global(html:not(.dark)) .ft-orb-2 { opacity: 0.1; }
	.ft-spark { position: absolute; width: 4px; height: 4px; border-radius: 9999px; background: var(--view-accent, #86e2ef); bottom: 10%; left: calc(12% + var(--i) * 15%); opacity: 0.5; animation: ft-rise 8s linear infinite; animation-delay: calc(var(--i) * -1.4s); }
	@keyframes ft-rise { 0% { transform: translateY(20px); opacity: 0; } 30% { opacity: 0.8; } 100% { transform: translateY(-120px); opacity: 0; } }

	/* CTA */
	.ft-cta { position: relative; z-index: 1; max-width: 720px; margin: 0 auto; text-align: center; padding: clamp(4rem, 8vw, 6.5rem) 0 clamp(2rem, 4vw, 3rem); }
	.ft-cta-kicker { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--view-accent, #86e2ef); }
	.ft-cta-title { font-size: clamp(2.6rem, 7vw, 5rem); line-height: 0.98; letter-spacing: 1px; text-transform: uppercase; margin: 0.6rem 0 1rem; }
	.ft-cta-sub { color: var(--ft-muted); max-width: 30rem; margin: 0 auto 1.6rem; line-height: 1.6; }
	.ft-cta-btn { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; font-size: 0.85rem; color: #0b0d18; background: linear-gradient(95deg, #8dfeea, var(--view-accent, #18debe), #28a6ec); padding: 0.95rem 1.8rem; border-radius: 9999px; box-shadow: 0 14px 34px -12px color-mix(in srgb, var(--view-accent, #18debe) 70%, transparent); transition: transform 0.25s ease, box-shadow 0.25s ease; }
	.ft-cta-btn:hover { transform: translateY(-3px); box-shadow: 0 22px 44px -12px color-mix(in srgb, var(--view-accent, #18debe) 80%, transparent); }

	/* Main grid */
	.ft-main { position: relative; z-index: 1; display: grid; gap: 2.5rem; max-width: 1200px; margin: 0 auto; padding: 2.5rem 0; border-top: 1px solid var(--ft-border); }
	@media (min-width: 720px) {
		.ft-main { grid-template-columns: 1.3fr 1fr; align-items: start; }
		.ft-signal { grid-column: 1 / -1; }
	}
	@media (min-width: 1040px) {
		.ft-main { grid-template-columns: 1.4fr 1fr 1fr 1.1fr; column-gap: 2.2rem; row-gap: 2.2rem; }
		/* the tall columns hold both rows so the band can sit under the two
		   short ones without a hole under the brand */
		.ft-brand { grid-row: 1 / span 2; }
		.ft-offices { grid-row: 1 / span 2; }
		.ft-signal { grid-column: 3 / -1; grid-row: 2; }
	}

	.ft-logo { display: inline-block; color: var(--ft-ink); }
	.ft-logo :global(svg) { height: auto; max-width: 100%; display: block; }
	.ft-logo :global(svg path) { fill: var(--ft-ink); }
	.ft-pitch { color: var(--ft-muted); font-size: 0.98rem; line-height: 1.65; margin: 1.1rem 0 1.5rem; max-width: 26rem; }
	.ft-h { display: block; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ft-faint); margin-bottom: 1rem; }
	.ft-h-2 { margin-top: 1.8rem; }

	/* ── Campus TV ──
	   The uploads playlist rolls one video into the next. Nothing loads
	   until you scroll to it, and it starts muted, so a footer never
	   ambushes anybody with sound. */
	.ft-tv { max-width: 22rem; margin-bottom: 1.8rem; }
	.ft-tv-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.6rem;
		margin-bottom: 0.55rem;
	}
	.ft-tv-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.42rem;
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--ft-ink);
	}
	.ft-tv-badge i {
		width: 7px;
		height: 7px;
		border-radius: 9999px;
		background: #ef4444;
		box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.6);
		animation: ft-tv-pulse 2.4s ease-out infinite;
	}
	@keyframes ft-tv-pulse {
		0% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.55); }
		70% { box-shadow: 0 0 0 7px rgba(239, 68, 68, 0); }
		100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
	}
	.ft-tv-link {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		font-size: 0.72rem;
		font-weight: 600;
		color: var(--ft-muted);
		transition: color 0.2s ease;
	}
	.ft-tv-link:hover { color: var(--view-accent, #28a6ec); }

	.ft-tv-screen {
		position: relative;
		aspect-ratio: 16 / 9;
		border-radius: 0.8rem;
		overflow: hidden;
		border: 1px solid var(--ft-border);
		background: #0a0a0f;
		box-shadow: 0 22px 44px -24px rgba(0, 0, 0, 0.8);
	}
	.ft-tv-mount { position: absolute; inset: 0; }
	.ft-tv-mount :global(iframe) { width: 100%; height: 100%; border: 0; display: block; }
	.ft-tv-poster {
		position: absolute;
		inset: 0;
		z-index: 2;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.3rem;
		border: 0;
		cursor: pointer;
		color: #fff;
		background:
			radial-gradient(70% 60% at 50% 40%, color-mix(in srgb, var(--view-accent, #28a6ec) 26%, transparent), transparent 70%),
			linear-gradient(160deg, #1a1408, #0a0a0f);
		transition: opacity 0.35s ease, visibility 0.35s ease;
	}
	.ft-tv[data-playing] .ft-tv-poster { opacity: 0; visibility: hidden; }
	.ft-tv-play {
		display: grid;
		place-items: center;
		width: 46px;
		height: 46px;
		border-radius: 9999px;
		color: #fff;
		background: #ef4444;
		box-shadow: 0 10px 24px -8px rgba(239, 68, 68, 0.8);
		transition: transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1);
	}
	.ft-tv-poster:hover .ft-tv-play { transform: scale(1.1); }
	.ft-tv-poster-t { font-size: 0.85rem; font-weight: 800; margin-top: 0.35rem; }
	.ft-tv-poster-s { font-size: 0.7rem; color: rgba(255, 255, 255, 0.62); }
	/* the faint sweep of a screen that is on */
	.ft-tv-scan {
		position: absolute;
		inset: 0;
		z-index: 3;
		pointer-events: none;
		background: linear-gradient(115deg, rgba(255, 255, 255, 0.07) 0 16%, transparent 32%);
	}
	.ft-tv-sound {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		margin-top: 0.5rem;
		padding: 0.3rem 0.7rem;
		border-radius: 9999px;
		border: 1px solid var(--ft-border);
		background: var(--ft-card);
		font-size: 0.7rem;
		font-weight: 600;
		color: var(--ft-muted);
		cursor: pointer;
		transition: color 0.2s ease, border-color 0.2s ease;
	}
	.ft-tv-sound:hover { color: var(--ft-ink); border-color: var(--view-accent, #28a6ec); }
	.ft-tv-sound[hidden] { display: none; }

	/* ── the noticeboard (Campus only) ──
	   We cannot pull live posts, so rather than fake a feed the socials
	   become pinned index cards, the same corkboard the page already uses. */
	.ft-pinboard { display: none; }
	:global(html[data-view='campus']) .ft-pinboard {
		display: grid;
		align-items: stretch;
		grid-template-columns: 1fr 1fr;
		gap: 0.7rem;
		padding: 0.9rem;
		border-radius: 0.9rem;
		border: 6px solid #7c4a23;
		background:
			radial-gradient(7px 7px at 22% 32%, rgba(0, 0, 0, 0.06), transparent),
			linear-gradient(160deg, #c89a6b, #b07f4e);
		box-shadow: inset 0 0 34px rgba(60, 35, 12, 0.35);
	}
	:global(html[data-view='campus']) .ft-socials { display: none; }

	.ft-pin {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		padding: 1.15rem 0.7rem 0.65rem;
		background: #fffdf5;
		color: #44403c;
		box-shadow: 0 10px 22px -10px rgba(0, 0, 0, 0.5);
		transform: rotate(calc(var(--r, 0) * 1.5deg));
		transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s ease;
	}
	.ft-pin:hover {
		transform: rotate(0deg) scale(1.05);
		box-shadow: 0 16px 30px -12px rgba(0, 0, 0, 0.55);
		z-index: 2;
	}
	.ft-pin-tack {
		position: absolute;
		top: -9px;
		left: 50%;
		transform: translateX(-50%) rotate(14deg);
		font-size: 1rem;
		filter: drop-shadow(0 3px 3px rgba(0, 0, 0, 0.3));
	}
	.ft-pin-ic {
		display: grid;
		place-items: center;
		width: 28px;
		height: 28px;
		border-radius: 0.45rem;
		margin-bottom: 0.3rem;
		color: #fff;
		background: var(--pk, #44403c);
	}
	.ft-pin-handle {
		font-size: 0.8rem;
		font-weight: 800;
		line-height: 1.25;
		word-break: break-word;
	}
	.ft-pin-tag {
		font-style: normal;
		font-size: 0.68rem;
		line-height: 1.35;
		color: #78716c;
	}
	.ft-pin-go {
		position: absolute;
		top: 0.45rem;
		right: 0.45rem;
		color: #a8a29e;
		opacity: 0;
		transition: opacity 0.25s ease;
	}
	.ft-pin:hover .ft-pin-go { opacity: 1; }

	@media (max-width: 460px) {
		.ft-pinboard { grid-template-columns: 1fr; }
	}
	@media (prefers-reduced-motion: reduce) {
		.ft-tv-badge i { animation: none; }
		.ft-pin { transition: none; }
	}

	/* ── the signal band ──
	   Its own row rather than a field tucked under the pitch, and the input
	   runs the full width of the two columns above it. Takes the world's
	   accent, so it changes with the view like everything else. */
	.ft-signal {
		position: relative;
		display: grid;
		gap: 0.9rem;
		padding: 1.15rem 1.25rem 1.25rem;
		border-radius: 1rem;
		overflow: hidden;
		border: 1px solid color-mix(in srgb, var(--view-accent, #18debe) 24%, var(--ft-border));
		background:
			radial-gradient(120% 140% at 0% 0%, color-mix(in srgb, var(--view-accent, #18debe) 13%, transparent), transparent 62%),
			var(--ft-card);
	}
	/* a fine lit edge along the top, the tell that this is the live bit */
	.ft-signal-edge {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 1px;
		background: linear-gradient(90deg, transparent, var(--view-accent, #18debe), transparent);
		opacity: 0.85;
	}
	.ft-signal-copy { display: flex; flex-direction: column; gap: 0.2rem; }
	.ft-signal-h {
		display: inline-flex;
		align-items: center;
		gap: 0.42rem;
		font-size: 0.74rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--view-accent, #18debe);
	}
	.ft-signal-copy p {
		margin: 0;
		font-size: 0.82rem;
		line-height: 1.5;
		color: var(--ft-muted);
	}
	.ft-signal-form { display: flex; gap: 0.55rem; width: 100%; }
	.ft-signal-field {
		flex: 1 1 auto;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		min-width: 0;
		padding: 0 0.9rem;
		border-radius: 9999px;
		border: 1px solid var(--ft-border);
		background: var(--ft-bg-solid, rgba(255, 255, 255, 0.04));
		color: var(--ft-faint);
		transition: border-color 0.25s ease, box-shadow 0.25s ease;
	}
	.ft-signal-field:focus-within {
		border-color: var(--view-accent, #18debe);
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--view-accent, #18debe) 16%, transparent);
	}
	.ft-signal-field input {
		flex: 1 1 auto;
		min-width: 0;
		padding: 0.72rem 0;
		border: 0;
		background: none;
		outline: none;
		font-size: 0.9rem;
		color: var(--ft-ink);
	}
	.ft-signal-form button {
		flex: none;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0 1.15rem;
		border: 0;
		border-radius: 9999px;
		font-size: 0.85rem;
		font-weight: 800;
		color: #06121a;
		background: var(--view-accent, #18debe);
		cursor: pointer;
		transition: transform 0.2s ease, filter 0.2s ease;
	}
	.ft-signal-form button:hover { transform: translateY(-1px); filter: brightness(1.08); }
	.ft-signal-form button:disabled { opacity: 0.65; cursor: default; transform: none; }
	.ft-news-msg {
		display: block;
		font-size: 0.78rem;
		line-height: 1.4;
		color: var(--view-accent, #86e2ef);
	}
	.ft-news-msg:empty { display: none; }
	.ft-news-msg[data-bad] { color: #f87171; }
	@media (max-width: 520px) {
		.ft-signal-form { flex-wrap: wrap; }
		.ft-signal-form button { width: 100%; justify-content: center; padding: 0.72rem 1rem; }
	}

	/* ── Campus ──
	   He liked the hand the nav is set in, so the rest of the footer joins
	   it. Inputs stay in the system face: handwriting in a form field is
	   charming for one word and unreadable for an address. */
	:global(html[data-view='campus']) .site-footer {
		--ft-hand: 'Bradley Hand', 'Segoe Print', 'Comic Sans MS', cursive;
	}
	:global(html[data-view='campus']) .ft-pitch,
	:global(html[data-view='campus']) .ft-h,
	:global(html[data-view='campus']) .ft-office-country,
	:global(html[data-view='campus']) .ft-office address,
	:global(html[data-view='campus']) .ft-contact,
	:global(html[data-view='campus']) .ft-signal-h,
	:global(html[data-view='campus']) .ft-signal-copy p,
	:global(html[data-view='campus']) .ft-signal-form button,
	:global(html[data-view='campus']) .ft-news-msg,
	:global(html[data-view='campus']) .ft-tv-badge,
	:global(html[data-view='campus']) .ft-tv-link,
	:global(html[data-view='campus']) .ft-tv-poster-t,
	:global(html[data-view='campus']) .ft-tv-poster-s,
	:global(html[data-view='campus']) .ft-tv-sound,
	:global(html[data-view='campus']) .ft-cta-kicker,
	:global(html[data-view='campus']) .ft-cta-sub,
	:global(html[data-view='campus']) .ft-bottom,
	:global(html[data-view='campus']) .ft-film-txt {
		font-family: var(--ft-hand);
	}
	/* the hand runs small, so give the quiet labels a little more size and
	   drop the wide tracking that only suits caps */
	:global(html[data-view='campus']) .ft-h {
		font-size: 0.9rem;
		letter-spacing: 0.02em;
		text-transform: none;
	}
	:global(html[data-view='campus']) .ft-signal-h {
		font-size: 1rem;
		letter-spacing: 0.01em;
		text-transform: none;
	}
	:global(html[data-view='campus']) .ft-tv-badge {
		font-size: 0.86rem;
		letter-spacing: 0.01em;
		text-transform: none;
	}
	:global(html[data-view='campus']) .ft-pitch,
	:global(html[data-view='campus']) .ft-office address,
	:global(html[data-view='campus']) .ft-contact { font-size: 1.02rem; }

	/* half the height: the label and the field share one line, and the
	   promise rides along beside the label instead of on its own row */
	:global(html[data-view='campus']) .ft-signal {
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
		align-items: center;
		gap: 0.75rem 1.1rem;
		padding: 0.75rem 0.9rem;
	}
	:global(html[data-view='campus']) .ft-signal-copy p { font-size: 0.9rem; line-height: 1.35; }
	:global(html[data-view='campus']) .ft-signal-field input { padding-block: 0.5rem; }
	:global(html[data-view='campus']) .ft-signal-form button { padding-block: 0.5rem; }
	:global(html[data-view='campus']) .ft-news-msg { grid-column: 1 / -1; }
	@media (max-width: 640px) {
		:global(html[data-view='campus']) .ft-signal {
			grid-template-columns: minmax(0, 1fr);
			gap: 0.55rem;
		}
		:global(html[data-view='campus']) .ft-signal-copy p { display: none; }
		/* field and button stay on one line, so the band is one row deep */
		:global(html[data-view='campus']) .ft-signal-form { flex-wrap: nowrap; }
		:global(html[data-view='campus']) .ft-signal-form button {
			width: auto;
			padding: 0 0.95rem;
		}
	}

	/* ── Campus on a phone ──
	   The footer was the longest thing on the page. Everything tightens:
	   the TV shrinks, the offices pair up, the board loses its padding. */
	@media (max-width: 719px) {
		:global(html[data-view='campus']) .ft-main { gap: 1.5rem; padding: 1.6rem 0; }
		:global(html[data-view='campus']) .ft-cta { padding: 2.4rem 0 1.4rem; }
		:global(html[data-view='campus']) .ft-pitch { margin: 0.8rem 0 1.1rem; font-size: 0.95rem; }
		:global(html[data-view='campus']) .ft-tv { margin-bottom: 1.1rem; max-width: 100%; }
		:global(html[data-view='campus']) .ft-h { margin-bottom: 0.6rem; }

		/* four addresses stacked is most of the scroll: pair them up and
		   keep them to one line each */
		:global(html[data-view='campus']) .ft-offices ul {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 0.55rem 0.9rem;
		}
		:global(html[data-view='campus']) .ft-office { padding: 0; border: 0; }
		:global(html[data-view='campus']) .ft-office address {
			font-size: 0.86rem;
			line-height: 1.35;
			display: -webkit-box;
			overflow: hidden;
		}
		:global(html[data-view='campus']) .ft-office-top { gap: 0.35rem; }

		:global(html[data-view='campus']) .ft-pinboard { padding: 0.6rem; gap: 0.5rem; border-width: 5px; }
		:global(html[data-view='campus']) .ft-pin { padding: 0.95rem 0.55rem 0.5rem; }
		:global(html[data-view='campus']) .ft-pin-ic { width: 24px; height: 24px; margin-bottom: 0.2rem; }
		:global(html[data-view='campus']) .ft-pin-handle { font-size: 0.76rem; }
		:global(html[data-view='campus']) .ft-pin-tag { font-size: 0.64rem; }

		:global(html[data-view='campus']) .ft-nav { padding: 0.4rem 0.5rem; margin-bottom: 0.7rem; }
		:global(html[data-view='campus']) .ft-bottom { padding-block: 0.8rem; }
	}

	/* Newsletter */
	.ft-news-form { display: flex; gap: 0.5rem; max-width: 22rem; }
	.ft-news-form input { flex: 1; min-width: 0; background: var(--ft-card); border: 1px solid var(--ft-border); border-radius: 9999px; padding: 0.65rem 1rem; color: var(--ft-ink); font-size: 0.9rem; outline: none; transition: border-color 0.25s ease; }
	.ft-news-form input:focus { border-color: var(--view-accent, #18debe); }
	.ft-news-form button { flex-shrink: 0; width: 44px; height: 44px; display: grid; place-items: center; border-radius: 9999px; color: #0b0d18; background: var(--view-accent, #18debe); cursor: pointer; transition: transform 0.2s ease; }
	.ft-news-form button:hover { transform: scale(1.07); }
	.ft-news-msg { display: block; font-size: 0.8rem; color: var(--view-accent, #86e2ef); margin-top: 0.6rem; min-height: 1rem; }

	/* Offices + clocks */
	.ft-offices ul, .ft-contact, .ft-links { list-style: none; padding: 0; margin: 0; }
	.ft-office { padding: 0.7rem 0; border-bottom: 1px solid var(--ft-border); }
	.ft-office:last-child { border-bottom: 0; }
	.ft-office-top { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem; }
	.ft-flag { font-size: 1rem; }
	.ft-office-country { font-weight: 600; font-size: 0.92rem; color: var(--ft-ink); }
	.ft-clock { margin-left: auto; display: inline-flex; align-items: center; gap: 0.35rem; font-family: ui-monospace, monospace; font-size: 0.82rem; color: var(--view-accent, #86e2ef); }
	.ft-clock-dot { width: 6px; height: 6px; border-radius: 9999px; background: #28c840; box-shadow: 0 0 0 0 rgba(40, 200, 64, 0.5); animation: ft-pulse 2s infinite; }
	@keyframes ft-pulse { 0% { box-shadow: 0 0 0 0 rgba(40, 200, 64, 0.5); } 70% { box-shadow: 0 0 0 6px rgba(40, 200, 64, 0); } 100% { box-shadow: 0 0 0 0 rgba(40, 200, 64, 0); } }
	.ft-office address { font-style: normal; font-size: 0.82rem; color: var(--ft-faint); line-height: 1.4; }

	/* Contact + links */
	.ft-contact li, .ft-links li { margin-bottom: 0.7rem; }
	.ft-contact li { display: flex; align-items: center; gap: 0.55rem; color: var(--ft-muted); font-size: 0.9rem; }
	.ft-flag-sm { font-size: 0.95rem; line-height: 1; flex-shrink: 0; }
	.ft-contact a, .ft-links a { color: var(--ft-muted); transition: color 0.2s ease; }
	.ft-contact a:hover, .ft-links a:hover { color: var(--view-accent, #18debe); }
	.ft-contact :global(svg) { color: var(--view-accent, #18debe); flex-shrink: 0; }

	/* Social preview cards */
	.ft-socials { display: grid; gap: 0.7rem; }
	.ft-social { position: relative; display: flex; align-items: center; gap: 0.8rem; padding: 0.7rem 0.85rem; border-radius: 0.9rem; border: 1px solid var(--ft-border); background: var(--ft-card); transition: border-color 0.25s ease, background 0.25s ease, transform 0.25s ease; }
	.ft-social:hover { transform: translateY(-2px); border-color: var(--view-accent, #18debe); background: color-mix(in srgb, var(--view-accent, #18debe) 8%, transparent); }
	.ft-social-ic { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 0.7rem; background: var(--ft-card); color: var(--ft-ink); flex-shrink: 0; }
	.ft-social:hover .ft-social-ic { color: var(--view-accent, #18debe); }
	.ft-social-meta { display: flex; flex-direction: column; line-height: 1.25; min-width: 0; }
	.ft-social-name { font-weight: 700; font-size: 0.86rem; color: var(--ft-ink); }
	.ft-social-handle { font-size: 0.78rem; color: var(--view-accent, #86e2ef); }
	.ft-social-tag { font-size: 0.72rem; color: var(--ft-faint); }
	.ft-social-go { margin-left: auto; color: var(--ft-faint); transition: transform 0.25s ease, color 0.25s ease; }
	.ft-social:hover .ft-social-go { color: var(--view-accent, #18debe); transform: translate(2px, -2px); }

	/* Horizontal pill nav */
	/* Footer nav — a tidy wrap of glossy, transparent, curved pill buttons. */
	/* ── the footer nav ──
	   One line, quiet, and dressed differently in every world. The pills
	   were two rows of chunky buttons that added most of the footer's
	   height for the least of its value. */
	.ft-nav {
		position: relative;
		z-index: 1;
		display: flex;
		flex-wrap: nowrap;
		justify-content: flex-start;
		align-items: center;
		gap: 0.15rem;
		max-width: 1200px;
		margin: 0 auto 1.1rem;
		padding: 0.65rem 0.5rem;
		overflow-x: auto;
		scrollbar-width: none;
	}
	.ft-nav::-webkit-scrollbar { display: none; }
	@media (min-width: 720px) { .ft-nav { justify-content: center; } }
	.ft-nav-item {
		flex: none;
		display: inline-flex;
		align-items: center;
		padding: 0.32rem 0.7rem;
		border-radius: 0.45rem;
		font-size: 0.78rem;
		font-weight: 600;
		white-space: nowrap;
		color: var(--ft-muted);
		border: 1px solid transparent;
		transition: color 0.22s ease, background 0.22s ease, border-color 0.22s ease,
			letter-spacing 0.22s ease, transform 0.22s ease;
	}
	.ft-nav-item:hover {
		color: var(--ft-ink);
		background: color-mix(in srgb, var(--view-accent, #18debe) 12%, transparent);
	}
	.ft-nav-item.active {
		color: var(--view-accent, #18debe);
		background: color-mix(in srgb, var(--view-accent, #18debe) 14%, transparent);
	}

	/* Boardroom: a thin rule under the word, nothing else. */
	:global(html[data-view='boardroom']) .ft-nav-item {
		border-radius: 0;
		border-bottom: 1px solid transparent;
	}
	:global(html[data-view='boardroom']) .ft-nav-item:hover,
	:global(html[data-view='boardroom']) .ft-nav-item.active {
		background: none;
		border-bottom-color: var(--view-accent, #28a6ec);
	}

	/* Builder: monospace, and the hover writes the brackets in. */
	:global(html[data-view='builder']) .ft-nav-item {
		font-family: ui-monospace, 'SFMono-Regular', monospace;
		font-size: 0.74rem;
		letter-spacing: 0.02em;
	}
	:global(html[data-view='builder']) .ft-nav-item::before { content: '['; opacity: 0; margin-right: 0.1rem; }
	:global(html[data-view='builder']) .ft-nav-item::after { content: ']'; opacity: 0; margin-left: 0.1rem; }
