---
// The people who launch with you.
//
// The campus hero puts its photographs on the wall — taped, tilted,
// overlapping. This does the same thing for the founder world, but the
// prints are cleaner: numbered contact-sheet frames with a strip of tape,
// fanned so they overlap, and one of them is the room itself. Pick one up
// (hover / focus) and it straightens, grows and names itself.
import { Icon } from 'astro-icon/components';

interface Props {
	class?: string;
}
const { class: klass = '' } = Astro.props;

const crew = [
	{ img: '/images/team/t1.jpg', name: 'Engineering', role: 'senior hands on the build', r: '-4.2deg' },
	{ img: '/images/team/t2.jpg', name: 'Design & brand', role: 'how it looks and feels', r: '2.8deg' },
	{ img: '/images/team/t3.jpg', name: 'Product & delivery', role: 'the one who owns your date', r: '-2.2deg' },
	{ img: '/images/founder/studio.jpg', name: 'The Abuja floor', role: 'where it actually happens', r: '3.6deg', wide: true },
];
---

<div class:list={['bteam', klass]}>
	<span class="bteam__k">
		<Icon width={13} name="mdi:account-group-outline" />
		The people who launch with you
	</span>

	<div class="bteam__rail" role="list" data-bteam>
		{
			crew.map((c, i) => (
				<figure
					class:list={['bteam__card', { 'bteam__card--wide': c.wide }]}
					role="listitem"
					style={`--r:${c.r}; --i:${i}`}
					tabindex="0"
					data-bteam-card={i}
					aria-label={`${c.name} — ${c.role}`}
				>
					<span class="bteam__tape" aria-hidden="true" />
					<span class="bteam__pic">
						<img src={c.img} alt={`${c.name} at Swizel`} loading="lazy" decoding="async" />
						<span class="bteam__sheen" aria-hidden="true" />
						<span class="bteam__no">{String(i + 1).padStart(2, '0')}</span>
					</span>
				</figure>
			))
		}
	</div>

	<!-- One caption for the whole fan, under it, where nothing can cover it.
	     The prints overlap by design, so a name printed on each one was always
	     going to be cut in half by the print in front. This names whichever
	     one is lifted, walks the crew on its own, and hands over the moment
	     you point at a print. -->
	<p class="bteam__now" data-bteam-now aria-live="polite">
		{
			crew.map((c, i) => (
				<span class:list={['bteam__now-i', { 'is-on': i === 0 }]} data-bteam-now-i={i}>
					<b>{c.name}</b>
					<em>{c.role}</em>
				</span>
			))
		}
	</p>

	<a href="/about#team" class="bteam__go">
		Meet the whole crew
		<Icon width={14} name="mdi:arrow-right" />
	</a>
</div>

<style>
	.bteam {
		--bt-w: clamp(74px, 8vw, 104px);
		--bt-lap: clamp(16px, 2vw, 26px);
		display: grid;
		gap: 0.5rem;
		justify-items: start;
	}

	.bteam__k {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.7rem;
		font-weight: 800;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--bt-kick, rgba(237, 233, 251, 0.55));
	}
	.bteam__k :global(svg) { color: var(--view-accent, #8b5cf6); }

	.bteam__rail {
		display: flex;
		align-items: flex-end;
		/* headroom for the lifted print: it grows 16% out of its own bottom
		   edge, and without this it climbed over the line above it */
		padding-top: 1.9rem;
		margin-top: -0.6rem;
	}
	.bteam__rail > * + * { margin-left: calc(var(--bt-lap) * -1); }

	.bteam__card {
		position: relative;
		z-index: calc(9 - var(--i));
		flex: none;
		width: var(--bt-w);
		margin: 0;
		padding: 4px 4px 0;
		border-radius: 4px;
		background: linear-gradient(180deg, #fffdf8, #efe9f7);
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.75) inset,
			0 18px 34px -20px rgba(0, 0, 0, 0.85),
			0 4px 10px -6px rgba(0, 0, 0, 0.45);
		transform: rotate(var(--r)) translateY(0);
		transform-origin: 50% 100%;
		transition:
			transform 0.34s cubic-bezier(0.2, 0.8, 0.25, 1),
			box-shadow 0.34s ease;
		cursor: pointer;
		outline: none;
	}
	.bteam__card--wide { width: calc(var(--bt-w) * 1.34); }
	.bteam__card:hover,
	.bteam__card:focus-visible {
		z-index: 20;
		transform: rotate(0deg) translateY(-9px) scale(1.16);
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.85) inset,
			0 34px 60px -26px rgba(0, 0, 0, 0.9),
			0 0 0 2px color-mix(in srgb, var(--view-accent, #8b5cf6) 45%, transparent);
	}

	/* a scrap of tape, in the world's colour */
	.bteam__tape {
		position: absolute;
		top: -7px;
		left: 50%;
		width: 54%;
		height: 17px;
		margin-left: -27%;
		border-radius: 1px;
		background: linear-gradient(
			180deg,
			color-mix(in srgb, var(--view-accent, #8b5cf6) 40%, rgba(255, 255, 255, 0.6)),
			color-mix(in srgb, #ec4899 30%, rgba(255, 255, 255, 0.4))
		);
		box-shadow: 0 4px 9px -6px rgba(0, 0, 0, 0.7);
		transform: rotate(calc(var(--r) * -1.7));
		clip-path: polygon(4% 0, 96% 6%, 100% 94%, 2% 100%);
		pointer-events: none;
		opacity: 0.85;
	}

	.bteam__pic {
		position: relative;
		display: block;
		overflow: hidden;
		border-radius: 2px;
		background: #17112c;
	}
	.bteam__pic img {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 5;
		height: auto;
		object-fit: cover;
		object-position: 50% 26%;
		filter: saturate(1.04) contrast(1.02);
	}
	.bteam__card--wide .bteam__pic img { aspect-ratio: 4 / 3.4; object-position: 50% 44%; }

	.bteam__sheen {
		position: absolute;
		inset: 0;
		background: linear-gradient(110deg, transparent 32%, rgba(255, 255, 255, 0.4) 48%, transparent 62%);
		transform: translateX(-120%);
		pointer-events: none;
	}
	.bteam__card:hover .bteam__sheen,
	.bteam__card:focus-visible .bteam__sheen { animation: bt-sheen 0.85s ease-out; }
	@keyframes bt-sheen { to { transform: translateX(120%); } }

	.bteam__no {
		position: absolute;
		right: 3px;
		bottom: 2px;
		font-family: ui-monospace, monospace;
		font-size: 0.7rem;
		font-weight: 800;
		letter-spacing: 0.1em;
		color: #fff;
		text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9);
		opacity: 0.85;
	}

	/* the single caption under the fan: one line, never clipped, and it
	   crossfades from one name to the next so the strip is never still */
	.bteam__now {
		position: relative;
		display: grid;
		min-height: 2.35rem;
		margin: 0.5rem 0 0;
		padding: 0;
	}
	.bteam__now-i {
		grid-area: 1 / 1;
		display: grid;
		gap: 0.05rem;
		opacity: 0;
		transform: translateY(4px);
		transition: opacity 0.3s ease, transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
		pointer-events: none;
	}
	.bteam__now-i.is-on { opacity: 1; transform: none; }
	.bteam__now-i b {
		font-size: 0.82rem;
		font-weight: 800;
		letter-spacing: 0.01em;
		line-height: 1.15;
		color: var(--bt-name, #f3efff);
	}
	.bteam__now-i em {
		font-style: normal;
		font-size: 0.74rem;
		line-height: 1.25;
		color: var(--bt-role, rgba(237, 233, 251, 0.6));
	}
	/* the lifted print reads as lifted, whether you hovered it or it came
	   round on its own */
	.bteam__card.is-up {
		z-index: 20;
		transform: rotate(0deg) translateY(-9px) scale(1.16);
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.85) inset,
			0 34px 60px -26px rgba(0, 0, 0, 0.9),
			0 0 0 2px color-mix(in srgb, var(--view-accent, #8b5cf6) 45%, transparent);
	}

	.bteam__go {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		margin-top: 0.35rem;
		font-size: 0.78rem;
		font-weight: 800;
		color: var(--view-accent, #8b5cf6);
		transition: gap 0.24s ease;
	}
	.bteam__go:hover { gap: 0.65rem; }

	@media (max-width: 1023px) {
		.bteam { justify-items: center; justify-self: center; }
		.bteam__rail { justify-content: center; }
	}
	@media (max-width: 420px) {
		.bteam { --bt-w: clamp(64px, 19vw, 84px); --bt-lap: 14px; }
		.bteam__k { font-size: 0.7rem; letter-spacing: 0.12em; }
	}
	@media (prefers-reduced-motion: reduce) {
		.bteam__card, .bteam__sheen { transition: none !important; animation: none !important; }
	}

	:global(html:not(.dark)) .bteam__k { color: rgba(29, 20, 48, 0.6); }
	/* daylight: the caption sits on the page, not on a print, so it needs the
	   page's ink rather than the dark palette's */
	:global(html:not(.dark)) .bteam {
		--bt-name: #1d1430;
		--bt-role: rgba(29, 20, 48, 0.62);
	}
	:global(html:not(.dark)) .bteam__card {
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.9) inset,
			0 18px 30px -20px rgba(40, 24, 70, 0.6),
			0 3px 8px -5px rgba(40, 24, 70, 0.4);
	}
</style>
