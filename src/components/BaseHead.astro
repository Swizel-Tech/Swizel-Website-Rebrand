---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import { SITE_TITLE } from '../consts';

export interface Props {
	title: string;
	description: string;
	image?: string;
	/**
	 * @deprecated Kept so existing pages keep compiling. We now emit exactly
	 * ONE og:image — the 1200x630 landscape. A second square tag made
	 * WhatsApp fall back to its small thumbnail layout instead of the big
	 * preview, which buried the card.
	 */
	imageSquare?: string;
	/** Set to "article" on blog posts so social cards render correctly. */
	type?: 'website' | 'article';
	/**
	 * Only for a piece that was published somewhere else first: it tells a
	 * search engine which copy is the original, so ours is not read as the
	 * duplicate. Everything else uses its own URL.
	 */
	canonical?: string;
}

const canonicalURL = Astro.props.canonical
	? new URL(Astro.props.canonical)
	: new URL(Astro.url.pathname, Astro.site);

const {
	title,
	description,
	image = '/images/og-default.jpg',
	type = 'website',
} = Astro.props;

// Absolute URL for the social share image (required by Facebook/Twitter).
// Canonicals stay on Astro.site (swizel.co), but share images must live on a
// domain that actually serves this build — otherwise WhatsApp/X fetch a 404
// and show no preview. On Vercel, VERCEL_PROJECT_PRODUCTION_URL is the
// project's shortest production domain (the vercel.app URL today, and
// swizel.co automatically once that domain is attached).
const deployedHost = process.env.VERCEL_PROJECT_PRODUCTION_URL;
const shareBase = deployedHost ? `https://${deployedHost}` : Astro.site;
const socialImageURL = new URL(image, shareBase);

// Breadcrumbs, derived from the path so every page gets a trail without
// each one having to declare it.
const segments = Astro.url.pathname.split('/').filter(Boolean);
const titleCase = (s: string) =>
	s.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://swizel.co/' },
		...segments.map((seg, i) => ({
			'@type': 'ListItem',
			position: i + 2,
			name: titleCase(seg),
			item: `https://swizel.co/${segments.slice(0, i + 1).join('/')}/`,
		})),
	],
};

const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: SITE_TITLE,
	url: 'https://swizel.co',
	inLanguage: 'en',
	publisher: { '@id': 'https://swizel.co/#organization' },
};

// Structured data for rich results in Google.
//
// The type matters more than it looks. An Organization tells Google what
// the company is; it does not tell it where the company *is*, so it can
// never surface for "software company in Abuja". ProfessionalService is
// a LocalBusiness, which is the family Google draws local results from —
// and it needs a street, coordinates, hours and a service area to be
// taken seriously, all of which are below.
const organizationSchema = {
	'@context': 'https://schema.org',
	'@type': ['Organization', 'ProfessionalService'],
	'@id': 'https://swizel.co/#organization',
	name: 'Swizel Technologies Limited',
	legalName: 'Swizel Technologies Limited',
	alternateName: 'Swizel',
	url: 'https://swizel.co',
	logo: {
		'@type': 'ImageObject',
		url: 'https://swizel.co/swizel.svg',
		caption: 'Swizel Technologies Limited',
	},
	image: 'https://swizel.co/images/og-default.jpg',
	foundingDate: '2019',
	areaServed: 'Worldwide',
	address: {
		'@type': 'PostalAddress',
		streetAddress: '2155 Peculiar Estate, Lokogoma',
		addressLocality: 'Abuja',
		addressRegion: 'FCT',
		postalCode: '900107',
		addressCountry: 'NG',
	},
	// Lokogoma, Abuja. Coordinates are what put a business on a map result.
	geo: {
		'@type': 'GeoCoordinates',
		latitude: 8.9806,
		longitude: 7.4165,
	},
	hasMap: 'https://www.google.com/maps/search/?api=1&query=Swizel+Technologies+Lokogoma+Abuja',
	telephone: '+234-810-020-4570',
	priceRange: '$$',
	currenciesAccepted: 'NGN, USD, GBP, EUR',
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '09:00',
			closes: '18:00',
		},
	],
	// Named places, not "Worldwide": a country and a city are things Google
	// can match a search against; an adverb is not.
	areaServed: [
		{ '@type': 'City', name: 'Abuja' },
		{ '@type': 'City', name: 'Lagos' },
		{ '@type': 'Country', name: 'Nigeria' },
		{ '@type': 'Country', name: 'Ireland' },
		{ '@type': 'Country', name: 'United Kingdom' },
		{ '@type': 'Country', name: 'United States' },
	],
	// The services themselves, so the company can be matched to the thing
	// somebody is actually searching for rather than only to its own name.
	hasOfferCatalog: {
		'@type': 'OfferCatalog',
		name: 'Software, design and marketing',
		itemListElement: [
			['Web development', 'Websites, web apps, PWAs and e-commerce, built to scale.', '/services/web-development'],
			['Mobile app development', 'iOS and Android apps, designed, built and maintained.', '/services/mobile-development'],
			['Product design', 'Interfaces, brand and the thinking behind both.', '/services/design'],
			['Digital marketing', 'Search, social and campaigns that earn attention.', '/services/digital-marketing'],
			['Software maintenance', 'Keeping shipped software running and earning.', '/services/maintenance'],
			['AI automation', 'Putting AI to work on the parts of a business that repeat.', '/services/ai-automation'],
		].map(([name, description, path]) => ({
			'@type': 'Offer',
			itemOffered: {
				'@type': 'Service',
				name,
				description,
				url: `https://swizel.co${path}`,
				provider: { '@id': 'https://swizel.co/#organization' },
				areaServed: [
					{ '@type': 'City', name: 'Abuja' },
					{ '@type': 'Country', name: 'Nigeria' },
				],
			},
		})),
	},
	contactPoint: {
		'@type': 'ContactPoint',
		telephone: '+234-810-020-4570',
		contactType: 'sales',
		email: 'contact@swizel.co',
		areaServed: 'Worldwide',
		availableLanguage: ['en'],
	},
	knowsAbout: [
		'Web development',
		'Mobile app development',
		'Product design',
		'Digital marketing',
		'Software maintenance',
		'AI automation',
	],
	description:
		'Swizel Technologies Limited is a software development company in Abuja, Nigeria. We design, build, market and maintain websites, web platforms and mobile apps for businesses in Nigeria and beyond.',
	email: 'contact@swizel.co',
	sameAs: [
		'https://twitter.com/swizelhq',
		'https://www.instagram.com/swizelhq',
		'https://www.facebook.com/swizelhq',
		'https://www.linkedin.com/company/swizelhq',
	],
};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.webmanifest" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#28293E" />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta name="author" content="Swizel Technologies Limited" />
<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

<!-- Apply saved theme + view before paint to avoid a flash -->
<script is:inline>
	(function () {
		try {
			// Light is the house default: a first-time visitor gets daylight
			// whatever their OS is set to. Dark is opt-in, and once chosen it
			// is remembered.
			var stored = localStorage.getItem('theme');
			// Light is the house default: a first-time visitor gets daylight
			// whatever their OS is set to. Dark is opt-in, and once chosen it
			// is remembered.
			if (stored === 'dark') {
				document.documentElement.classList.add('dark');
			}
			// Raise the curtain before the first paint. It is released by
			// initBootCurtain once fonts and images have settled.
			document.documentElement.classList.add('swz-booting');

			// The ceiling lives here, inline, rather than in the page bundle.
			// The bundle only runs once the whole document has parsed, so on a
			// thin connection its timer was not even armed until the visitor
			// had been staring at the curtain for fifteen seconds. Armed here,
			// the clock starts the moment the head is read, and the curtain
			// lifts on time whatever the network is doing behind it.
			var swzRoot = document.documentElement;
			window.__swzRelease = function () {
				if (!swzRoot.classList.contains('swz-booting')) return;
				swzRoot.classList.remove('swz-booting');
				swzRoot.classList.add('swz-booted');
				window.setTimeout(function () {
					swzRoot.classList.remove('swz-booted');
				}, 700);
			};
			window.setTimeout(window.__swzRelease, 2600);

			var view = localStorage.getItem('swizel-view');
			// the Legacy world was retired — send old visitors to the default view
			if (view === 'legacy') {
				view = 'boardroom';
				localStorage.setItem('swizel-view', view);
			}
			if (view) {
				document.documentElement.setAttribute('data-view', view);
			}
		} catch (e) {}
	})();
</script>

<!-- PWA: register the service worker so the site is installable.
     Skipped on localhost so dev never serves stale cached assets. -->
<script is:inline>
	if (
		'serviceWorker' in navigator &&
		location.hostname !== 'localhost' &&
		location.hostname !== '127.0.0.1'
	) {
		window.addEventListener('load', function () {
			navigator.serviceWorker.register('/sw.js').catch(function () {});
		});
	}
</script>

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Fonts. These used to be an @import at the top of global.css, which
     chains the request: the browser had to download and parse global.css
     before it even learned the fonts existed, so the first screen could sit
     unstyled for a beat on a slow machine. A link here starts both at once. -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
	rel="stylesheet"
	href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Epilogue:wght@400;500;600;700;800;900&display=swap"
/>

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:locale" content="en_NG" />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:alt" content={title} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:site" content="@swizelhq" />
<meta property="twitter:creator" content="@swizelhq" />
<meta property="twitter:image:alt" content={title} />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={socialImageURL} />

<!-- Performance mode: decided before first paint so the page never starts
     heavy and then downgrades in front of the visitor. A machine that
     struggled earlier this session, or one that tells us it is modest, gets
     the calm version of every decorative layer. -->
<script is:inline>
	(function () {
		try {
			var n = navigator;
			var weak =
				(n.hardwareConcurrency && n.hardwareConcurrency <= 4) ||
				(n.deviceMemory && n.deviceMemory <= 4);
			var flagged = sessionStorage.getItem('swizel-lite') === '1';
			if (weak || flagged) document.documentElement.classList.add('perf-lite');
		} catch (e) {}
	})();
</script>

<!-- Scroll reveals start at opacity 0 and are turned on by an observer once
     the page's scripts run. On a slow machine, or if a script throws, that
     left whole sections blank. This is the backstop: if the page has not
     reported itself ready within three seconds, everything is shown as-is. -->
<script is:inline>
	(function () {
		try {
			var r = document.documentElement;
			window.setTimeout(function () {
				if (!r.classList.contains('swz-ready')) r.classList.add('swz-show-all');
			}, 3000);
		} catch (e) {}
	})();
</script>

<!-- Structured data -->
<script
	type="application/ld+json"
	set:html={JSON.stringify(organizationSchema)}
/>
<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

<!-- Global CSS -->
<link rel="stylesheet" href="/styles/global.css" />

<!-- swiper js — every carousel is below the fold, so this loads without
     blocking the first paint and swaps in when it arrives -->
<link
	rel="stylesheet"
	href="https://cdn.jsdelivr.net/npm/swiper@8/swiper-bundle.min.css"
	media="print"
	onload="this.media='all'"
/>
<noscript
	><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@8/swiper-bundle.min.css" /></noscript
>

<!-- The Google tag used to sit here, async in the head, competing with
     the fonts and the first images for the connection on the very
     request where the first screen is being assembled. It loads from
     src/scripts/analytics.ts now: on idle, or on the visitor's first
     move, whichever comes first — and it knows about swup, which this
     snippet did not, so every page after the first was invisible to it.
     The IDs live in src/consts.ts. -->
