---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import { SITE_NAME, SITE_TITLE } from '../consts';
import { seoFor } from '../data/seo';
import { BUILD_ID } from '../buildId';
import { stripWorld, worldInPath, type World } from '../lib/worlds';

// The site's two typefaces, bundled into the page CSS (see the fonts
// comment below). Upright weights only, exactly the set the Google Fonts
// link used to load; italics stay browser-synthesised as they were.
import '@fontsource/bebas-neue/latin-400.css';
import '@fontsource/epilogue/latin-400.css';
import '@fontsource/epilogue/latin-500.css';
import '@fontsource/epilogue/latin-600.css';
import '@fontsource/epilogue/latin-700.css';
import '@fontsource/epilogue/latin-800.css';
import '@fontsource/epilogue/latin-900.css';
import bebas400 from '@fontsource/bebas-neue/files/bebas-neue-latin-400-normal.woff2?url';
import epilogue400 from '@fontsource/epilogue/files/epilogue-latin-400-normal.woff2?url';
import epilogue700 from '@fontsource/epilogue/files/epilogue-latin-700-normal.woff2?url';
import epilogue800 from '@fontsource/epilogue/files/epilogue-latin-800-normal.woff2?url';

export interface Props {
	/** The world this page was built in, for pages that have one per world. */
	world?: World;
	/**
	 * What a shared link's preview card says, when that should differ from
	 * the page's own title and description. Used by the /v/<world>/ home
	 * pages so a link sent from Founder shows "Swizel in Founder view"
	 * on WhatsApp, while the tab and the search snippet keep the real
	 * title. Only the og:/twitter: tags read these.
	 */
	shareTitle?: string;
	shareDescription?: string;
	title: string;
	description: string;
	image?: string;
	/**
	 * @deprecated Kept so existing pages keep compiling. We now emit exactly
	 * ONE og:image — the 1200x630 landscape. A second square tag made
	 * WhatsApp fall back to its small thumbnail layout instead of the big
	 * preview, which buried the card.
	 */
	imageSquare?: string;
	/** Set to "article" on blog posts so social cards render correctly. */
	type?: 'website' | 'article';
	/**
	 * Only for a piece that was published somewhere else first: it tells a
	 * search engine which copy is the original, so ours is not read as the
	 * duplicate. Everything else uses its own URL.
	 */
	canonical?: string;
}

// ── /v/<world>/… is the same page in another world ────────────────────
//
// Those files exist so the edge can serve a visitor their chosen world
// at the clean address (see src/lib/worlds.ts). To a search engine they
// are duplicates, so every one of them canonicalises to the clean path
// and asks not to be indexed — the same treatment the old /v/<world>
// share endpoints had. Everything below that derives from the path
// (canonical, breadcrumbs, the keywords record) uses the clean one.
const pagePath = stripWorld(Astro.url.pathname);
const isWorldVariant = worldInPath(Astro.url.pathname) !== null;

const canonicalURL = Astro.props.canonical
	? new URL(Astro.props.canonical)
	: new URL(pagePath, Astro.site);

const {
	title,
	description,
	image = '/images/og-default.jpg',
	type = 'website',
	shareTitle = title,
	shareDescription = description,
} = Astro.props;

// Absolute URL for the social share image (required by Facebook/Twitter).
// Canonicals stay on Astro.site (swizel.co), but share images must live on a
// domain that actually serves this build — otherwise WhatsApp/X fetch a 404
// and show no preview. On Vercel, VERCEL_PROJECT_PRODUCTION_URL is the
// project's shortest production domain (the vercel.app URL today, and
// swizel.co automatically once that domain is attached).
const deployedHost = process.env.VERCEL_PROJECT_PRODUCTION_URL;
const shareBase = deployedHost ? `https://${deployedHost}` : Astro.site;
const socialImageURL = new URL(image, shareBase);

// The page's own record in src/data/seo.ts, when it has one. Only used
// for the keywords tag below — the title and description are passed in
// as props by the page itself, so this is not a second source of truth
// for them.
const registry = seoFor(pagePath);

// One stamp for the whole build — see src/buildId.ts for why it cannot
// be computed here.
const cssVersion = BUILD_ID;

// Breadcrumbs, derived from the path so every page gets a trail without
// each one having to declare it.
const segments = pagePath.split('/').filter(Boolean);
const titleCase = (s: string) =>
	s.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.swizel.co/' },
		...segments.map((seg, i) => ({
			'@type': 'ListItem',
			position: i + 2,
			name: titleCase(seg),
			item: `https://www.swizel.co/${segments.slice(0, i + 1).join('/')}/`,
		})),
	],
};

const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: SITE_NAME,
	url: 'https://www.swizel.co',
	inLanguage: 'en',
	publisher: { '@id': 'https://www.swizel.co/#organization' },
};

// Structured data for rich results in Google.
//
// The type matters more than it looks. An Organization tells Google what
// the company is; it does not tell it where the company *is*, so it can
// never surface for "software company in Abuja". ProfessionalService is
// a LocalBusiness, which is the family Google draws local results from —
// and it needs a street, coordinates, hours and a service area to be
// taken seriously, all of which are below.
const organizationSchema = {
	'@context': 'https://schema.org',
	'@type': ['Organization', 'ProfessionalService'],
	'@id': 'https://www.swizel.co/#organization',
	name: 'Swizel Technologies Limited',
	legalName: 'Swizel Technologies Limited',
	alternateName: 'Swizel',
	url: 'https://www.swizel.co',
	logo: {
		'@type': 'ImageObject',
		url: 'https://www.swizel.co/swizel.svg',
		caption: 'Swizel Technologies Limited',
	},
	image: 'https://www.swizel.co/images/og-default.jpg',
	foundingDate: '2019',
	// NOTE: areaServed used to be declared here as the string 'Worldwide'
	// AND again further down as a list of named places. In an object
	// literal the second wins, so the string was dead code — but it is
	// removed rather than left, because the next person to read this
	// would reasonably assume the first one was the one in force.
	address: {
		'@type': 'PostalAddress',
		streetAddress: '2155 Peculiar Estate, Lokogoma',
		addressLocality: 'Abuja',
		addressRegion: 'FCT',
		postalCode: '900107',
		addressCountry: 'NG',
	},
	// Lokogoma, Abuja. Coordinates are what put a business on a map result.
	geo: {
		'@type': 'GeoCoordinates',
		latitude: 8.9806,
		longitude: 7.4165,
	},
	hasMap: 'https://www.google.com/maps/search/?api=1&query=Swizel+Technologies+Lokogoma+Abuja',
	telephone: '+234-810-020-4570',
	priceRange: '$$',
	currenciesAccepted: 'NGN, USD, GBP, EUR',
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '09:00',
			closes: '18:00',
		},
	],
	// Named places, not "Worldwide": a country and a city are things Google
	// can match a search against; an adverb is not.
	// The cities and countries we actually work from and in, plus the
	// plain fact that the work is not limited to them — there is a
	// platform being built for a client in Iceland as this is written.
	areaServed: [
		{ '@type': 'City', name: 'Abuja' },
		{ '@type': 'City', name: 'Lagos' },
		{ '@type': 'Country', name: 'Nigeria' },
		{ '@type': 'Country', name: 'Ireland' },
		{ '@type': 'Country', name: 'United Kingdom' },
		{ '@type': 'Country', name: 'United States' },
		{ '@type': 'Place', name: 'Worldwide' },
	],
	// The services themselves, so the company can be matched to the thing
	// somebody is actually searching for rather than only to its own name.
	//
	// Four of the six URLs in here used to be wrong — /services/web-development,
	// /services/mobile-development, /services/digital-marketing and a
	// /services/design that was right by accident. The site's real slugs
	// are development, design, marketing, strategy, maintenance and
	// ai-automation, so this record was pointing Google at 404s from
	// every page on the site. They are the real paths now, with the three
	// pages written for a search added alongside them.
	hasOfferCatalog: {
		'@type': 'OfferCatalog',
		name: 'Software, design and marketing',
		itemListElement: [
			['Custom software development', 'Bespoke platforms built around how a business actually works.', '/services/custom-software'],
			['Mobile and web app development', 'iOS and Android apps and web applications, designed, built and maintained.', '/services/app-development'],
			['Enterprise ERP software development', 'Custom ERP: stock, finance, operations and reporting in one system.', '/services/erp-systems'],
			['Web and mobile development', 'Websites, web apps, PWAs, e-commerce and APIs, built to scale.', '/services/development'],
			['Product and UI/UX design', 'Interfaces, brand and the thinking behind both.', '/services/design'],
			['Digital marketing', 'Search, social and campaigns that earn attention.', '/services/marketing'],
			['Product strategy and consulting', 'Deciding what to build, for whom, and why now.', '/services/strategy'],
			['Software maintenance and support', 'Keeping shipped software running and earning.', '/services/maintenance'],
			['AI and automation', 'Putting AI to work on the parts of a business that repeat.', '/services/ai-automation'],
		].map(([name, description, path]) => ({
			'@type': 'Offer',
			itemOffered: {
				'@type': 'Service',
				name,
				description,
				url: `https://www.swizel.co${path}`,
				provider: { '@id': 'https://www.swizel.co/#organization' },
				areaServed: [
					{ '@type': 'City', name: 'Abuja' },
					{ '@type': 'City', name: 'Lagos' },
					{ '@type': 'Country', name: 'Nigeria' },
					{ '@type': 'Place', name: 'Africa' },
					{ '@type': 'Country', name: 'United Kingdom' },
					{ '@type': 'Country', name: 'Ireland' },
					{ '@type': 'Country', name: 'United States' },
					{ '@type': 'Place', name: 'European Union' },
				],
			},
		})),
	},
	contactPoint: {
		'@type': 'ContactPoint',
		telephone: '+234-810-020-4570',
		contactType: 'sales',
		email: 'contact@swizel.co',
		areaServed: 'Worldwide',
		availableLanguage: ['en'],
	},
	knowsAbout: [
		'Web development',
		'Mobile app development',
		'Product design',
		'Digital marketing',
		'Software maintenance',
		'AI automation',
	],
	// The company's own words, from its Google Business Profile — so the
	// profile, the site and the structured data all say the same thing,
	// which is one of the few local-search signals you get for free.
	description:
		'We craft world-class custom software for ambitious businesses, no matter where you call home. Swizel Technologies Limited designs, builds, markets and maintains websites, web platforms and mobile apps from Abuja, Lagos, Cork, Sheffield and New York.',
	slogan: 'You imagine. We build.',
	email: 'contact@swizel.co',
	// The same profile URLs the footer links to. /company/swizelhq on
	// LinkedIn is an empty page, which tells search engines nothing.
	sameAs: [
		'https://www.tiktok.com/@swizelhq',
		'https://twitter.com/swizelhq',
		'https://www.instagram.com/swizelhq',
		'https://www.facebook.com/SWIZELTECHNOLOGIESLIMITED/',
		'https://www.linkedin.com/company/swizel-technologies-limited/',
		'https://www.youtube.com/@SwizelTechnologiesLtd',
	],
};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.webmanifest" />
<meta name="generator" content={Astro.generator} />
{/* Which build this page came from. Three times now a bug has been
    chased that was simply an old file being served — stale CSS from the
    service worker, then a stale copy at the edge — and each time the
    first twenty minutes went on establishing whether the code was even
    live. View source, read this, compare it to the commit in Vercel.
    On Vercel it is the commit SHA; locally, a build timestamp. */}
<meta name="swizel:build" content={BUILD_ID} />
<meta name="theme-color" content="#28293E" />
<meta
	name="robots"
	content={
		isWorldVariant
			? 'noindex, follow'
			: 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'
	}
/>
<meta name="author" content="Swizel Technologies Limited" />
<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

<!-- ── the curtain, drawn before anything is fetched ──────────────────
     This is the whole fix for the flash of raw text on load.

     The curtain is meant to cover the page while it assembles, and the
     inline script below raises it before the first paint. But every rule
     that makes it *look* like a curtain lived in /styles/global.css —
     an external file, on a separate request. So on any connection where
     that file was slow, the class went on, nothing was styled by it, and
     the browser painted unstyled HTML underneath a curtain that did not
     yet exist. The one element whose job was to hide the flash was
     waiting on the same stylesheet as everything it was hiding.

     These few rules are inline, so they apply the instant the head is
     parsed, before a single request goes out. Everything else about the
     curtain — the glow, the mark, the sheen, the wipe — stays in the
     stylesheet, because none of it matters until the page is up.
     ────────────────────────────────────────────────────────────────── -->
<style is:inline>
	html.swz-booting .page-curtain {
		position: fixed;
		inset: 0;
		z-index: 9990;
		transform: none;
		background: #090b16;
		pointer-events: none;
	}
	/* and the page itself is not shown until the curtain is real. Without
	   this, content can still paint in the gap before the rules above are
	   reached on a very slow parse. */
	html.swz-booting body > *:not(.page-curtain) {
		visibility: hidden;
	}
	html.swz-booting .page-curtain,
	html.swz-booted .page-curtain {
		visibility: visible;
	}
	/* light mode gets a light curtain, so the wipe is not a black flash on
	   a white page */
	html.swz-booting:not(.dark) .page-curtain {
		background: #eef1f7;
	}
</style>

<!-- Apply saved theme + view before paint to avoid a flash -->
<script is:inline>
	(function () {
		try {
			// Light is the house default: a first-time visitor gets daylight
			// whatever their OS is set to. Dark is opt-in, and once chosen it
			// is remembered.
			var stored = localStorage.getItem('theme');
			// Light is the house default: a first-time visitor gets daylight
			// whatever their OS is set to. Dark is opt-in, and once chosen it
			// is remembered.
			if (stored === 'dark') {
				document.documentElement.classList.add('dark');
			}
			// Raise the curtain before the first paint. It is released by
			// initBootCurtain once fonts and images have settled.
			document.documentElement.classList.add('swz-booting');

			// The ceiling lives here, inline, rather than in the page bundle.
			// The bundle only runs once the whole document has parsed, so on a
			// thin connection its timer was not even armed until the visitor
			// had been staring at the curtain for fifteen seconds. Armed here,
			// the clock starts the moment the head is read, and the curtain
			// lifts on time whatever the network is doing behind it.
			var swzRoot = document.documentElement;
			window.__swzRelease = function () {
				if (!swzRoot.classList.contains('swz-booting')) return;
				swzRoot.classList.remove('swz-booting');
				swzRoot.classList.add('swz-booted');
				window.setTimeout(function () {
					swzRoot.classList.remove('swz-booted');
				}, 700);
			};

			// ── the curtain comes up when the CSS is here, not when a clock
			//    says so ──
			//
			// This used to be a flat 2.6 second timer. On a desktop the
			// stylesheets are always back inside that, so it looked fine. On
			// a phone they often are not — and the timer fired anyway,
			// lifting the curtain on a page whose CSS had not arrived. That
			// is the flash of raw text, and it is why it only ever showed on
			// mobile.
			//
			// Every <link rel=stylesheet> exposes a .sheet once the browser
			// has actually parsed it, so that is what is waited on. The
			// timer stays, much longer, purely so a stylesheet that never
			// answers cannot hold the page hostage.
			// ── has the stylesheet actually taken effect? ─────────────────
			//
			// This used to ask every <link rel=stylesheet> whether it had a
			// .sheet object. That is a weaker question than it looks: a
			// media="print" sheet (the carousel's) reports one almost at
			// once, a cross-origin sheet throws on access whether or not it
			// has applied, and .sheet can be present a beat before the rules
			// are in force. All three let the curtain up while the page was
			// still unstyled underneath it — the flash of raw text that
			// looks like the site loading twice.
			//
			// So it asks the page instead. --page-bg is declared in
			// global.css and nowhere else; until that file is parsed AND
			// applied, this reads as an empty string. It cannot be true
			// early, and it is one lookup.
			var swzStyled = function () {
				try {
					var v = getComputedStyle(document.documentElement)
						.getPropertyValue('--page-bg');
					return !!(v && v.trim());
				} catch (e) {
					return false;
				}
			};
			var swzCssReady = function () {
				if (!swzStyled()) return false;
				var links = document.querySelectorAll('link[rel="stylesheet"]');
				for (var i = 0; i < links.length; i++) {
					// a cross-origin sheet throws on access once loaded, which
					// is itself proof that it loaded
					try {
						if (!links[i].sheet) return false;
					} catch (e) {
						/* loaded, just not readable */
					}
				}
				return true;
			};
			var swzWaited = 0;
			var swzWatch = function () {
				// Not before the document has finished parsing. This script
				// runs in the head, ABOVE the stylesheet links, so on the
				// first pass there are none in the DOM yet — the check found
				// zero sheets, concluded they had all loaded, and lifted the
				// curtain immediately. Which is the bug it was written to fix.
				if (document.readyState === 'loading') {
					window.setTimeout(swzWatch, 40);
					return;
				}
				if (swzCssReady()) {
					// one more frame so the first styled paint lands behind it
					requestAnimationFrame(function () {
						requestAnimationFrame(window.__swzRelease);
					});
					return;
				}
				swzWaited += 60;
				if (swzWaited >= 8000) return window.__swzRelease(); // hard ceiling
				window.setTimeout(swzWatch, 60);
			};
			swzWatch();

			// ── which world is this visitor in? ───────────────────────────
			//
			// Three places can say: the /v/<world>/ prefix of the address
			// (a shared link), a ?view=<world> query (the older share
			// shape), and localStorage (what they chose last time). The
			// first two win, and are remembered.
			var WORLDS = ['boardroom', 'founder', 'builder', 'studio', 'campus'];
			var root = document.documentElement;
			var path = location.pathname;
			var vm = /^\/v\/(boardroom|founder|builder|studio|campus)(?=\/|$)/.exec(path);
			var fromPath = vm ? vm[1] : '';
			var view = localStorage.getItem('swizel-view');
			// the Legacy world was retired — send old visitors to the default view
			if (view === 'legacy') {
				view = 'boardroom';
				localStorage.setItem('swizel-view', view);
			}

			// ── a shared link carries the world it was sent from ──────────
			//
			// ?view=builder is read here rather than in a page script for
			// one reason: this runs before the first paint, so the right
			// world is on the html element before anything is drawn.
			//
			// It also counts as onboarded. Somebody who followed a link to a
			// specific thing has been sent somewhere deliberately; opening
			// the two-question quiz over the top of it would be answering a
			// question they did not ask. The tour is still one tap away.
			try {
				var params = new URLSearchParams(location.search);
				var sent = params.get('view');
				if (sent && WORLDS.indexOf(sent) !== -1) {
					view = sent;
					localStorage.setItem('swizel-view', view);
					localStorage.setItem('swizel-onboarded', '1');
					// Take it back out of the address bar once it has been
					// read, so a URL copied out of the bar is a plain link.
					// replaceState, so Back still returns to wherever they
					// came from, and it runs before swup initialises.
					try {
						params.delete('view');
						var q = params.toString();
						history.replaceState(
							history.state,
							'',
							location.pathname + (q ? '?' + q : '') + location.hash
						);
					} catch (e) {}
				}
				if (fromPath) {
					view = fromPath;
					localStorage.setItem('swizel-view', view);
					localStorage.setItem('swizel-onboarded', '1');
				}
			} catch (e) {}

			// The edge reads a cookie, localStorage is what the page reads;
			// keep the two in step so the next request lands in the same
			// world this one did.
			if (view) {
				try {
					document.cookie =
						'swizel-view=' + view + ';path=/;max-age=31536000;SameSite=Lax';
				} catch (e) {}
			}

			// ── was this page built for the right world? ──────────────────
			//
			// Pages that exist in all five worlds carry data-world, stamped
			// at build time. If the visitor chose a different world than
			// the one that arrived, the edge rewrite did not happen (local
			// dev, another host) — so go to that world's own address
			// instead, and remember that links must do the same from now
			// on. One extra request, once, and only when the edge is away.
			var built = root.getAttribute('data-world') || '';
			if (built) {
				if (view && view !== built && !fromPath) {
					try { sessionStorage.setItem('swizel-noedge', '1'); } catch (e) {}
					var to =
						view === 'boardroom'
							? path
							: '/v/' + view + (path === '/' ? '/' : path);
					location.replace(to + location.search + location.hash);
					return;
				}
				root.setAttribute('data-view', built);
				if (built !== 'boardroom' && !fromPath) {
					// the clean address came back in the chosen world: the
					// edge is doing its job
					try { sessionStorage.removeItem('swizel-noedge'); } catch (e) {}
				}
				// Arrived on a /v/ address while the edge is known to work:
				// show the clean one, so a copied link is a plain link. The
				// world itself is already stored above.
				var noedge = false;
				try { noedge = sessionStorage.getItem('swizel-noedge') === '1'; } catch (e) {}
				var local = location.hostname === 'localhost' || location.hostname === '127.0.0.1';
				if (fromPath && !noedge && !local) {
					try {
						var clean = path.replace(/^\/v\/[a-z]+/, '') || '/';
						history.replaceState(history.state, '', clean + location.search + location.hash);
					} catch (e) {}
				}
			} else if (view) {
				root.setAttribute('data-view', view);
			}
		} catch (e) {}
	})();
</script>

<!-- PWA: register the service worker so the site is installable.
     Skipped on localhost so dev never serves stale cached assets. -->
<script is:inline>
	if (
		'serviceWorker' in navigator &&
		location.hostname !== 'localhost' &&
		location.hostname !== '127.0.0.1'
	) {
		window.addEventListener('load', function () {
			navigator.serviceWorker.register('/sw.js').catch(function () {});
		});
	}
</script>

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Fonts, served from this site.
     They came from Google Fonts: two extra origins to connect to, a
     stylesheet to fetch and parse before the browser even learned where
     the font files were, all on the critical path of every first visit.
     The same faces — Bebas Neue, and Epilogue in the same six upright
     weights, latin subset, font-display: swap — now ship with the site's
     own CSS, and the four files the first screen needs are preloaded so
     they start downloading with the HTML. Nothing about how the type
     renders has changed. -->
<link rel="preload" as="font" type="font/woff2" href={bebas400} crossorigin />
<link rel="preload" as="font" type="font/woff2" href={epilogue400} crossorigin />
<link rel="preload" as="font" type="font/woff2" href={epilogue700} crossorigin />
<link rel="preload" as="font" type="font/woff2" href={epilogue800} crossorigin />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
{
	/* Google has ignored the keywords tag since 2009, and this is not an
	   attempt to fool it. Bing and Yandex still read it lightly, and more
	   usefully it makes the page's intended phrase visible in view-source
	   next to the title it is supposed to match — which is how you catch
	   two pages quietly chasing the same search. The list lives in
	   src/data/seo.ts and is only emitted for pages that have one. */
	registry?.keywords?.length && (
		<meta name="keywords" content={registry.keywords.join(', ')} />
	)
}

<!-- ── where the company is ──────────────────────────────────────────
     Not a ranking factor on their own, but they are read by Bing, by a
     few aggregators, and by anything that builds a local listing from a
     page it crawled. Cheap, and they agree with the ProfessionalService
     record below rather than contradicting it. -->
<meta name="geo.region" content="NG-FC" />
<meta name="geo.placename" content="Abuja, Federal Capital Territory, Nigeria" />
<meta name="geo.position" content="8.9806;7.4165" />
<meta name="ICBM" content="8.9806, 7.4165" />

<!-- Open Graph / Facebook -->
<!-- en_NG is where the company is, and it stays primary. The alternates
     are here because roughly half the people who see a Swizel link are
     in Britain, Ireland or the United States, and a share card that
     declares only a Nigerian locale tells Facebook and LinkedIn that
     the page is for one market. -->
<meta property="og:locale" content="en_NG" />
<meta property="og:locale:alternate" content="en_GB" />
<meta property="og:locale:alternate" content="en_US" />
<meta property="og:locale:alternate" content="en_IE" />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={SITE_NAME} />
