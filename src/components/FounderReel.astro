---
// The founder's reel — one film, three phones.
//
// On a wide screen the film is a rig: the live player stands upright in the
// middle with two more handsets fanned out behind it, angled and dimmed, so
// the right-hand half of the hero is furniture instead of empty space. On a
// phone the fan collapses and only the live handset is left.
//
// The source is a YouTube short, so the frame is 9:16 and the chrome is
// ours: it starts muted the moment it is on screen (the only autoplay a
// browser allows), loops, and hands sound over on one obvious press.
import { Icon } from 'astro-icon/components';

interface Props {
	videoId: string;
	kicker?: string;
	still?: string;
	/**
	 * rig    — the three-handset hero (9:16)
	 * cinema — one wide frame for a landscape film, same founder chrome
	 */
	variant?: 'rig' | 'cinema';
	note?: string;
	class?: string;
}

const {
	videoId,
	kicker = 'Founder’s cut',
	still = '/images/founder/reel-still.jpg',
	variant = 'rig',
	note,
	class: klass = '',
} = Astro.props;

// the two handsets behind the live one carry other moments from the same
// story — the founder we built for, actually at work
const sideL = '/images/founder/reel-b.jpg';
const sideR = '/images/founder/reel-c.jpg';

// the three things a founder is actually shopping for, floated beside the rig
const chips = [
	{ icon: 'mdi:rocket-launch-outline', label: 'Real projects', tint: '#8b5cf6' },
	{ icon: 'mdi:account-group-outline', label: 'Expert team', tint: '#22d3ee' },
	{ icon: 'mdi:shield-check-outline', label: 'Long-term support', tint: '#ec4899' },
	{ icon: 'mdi:timer-sand', label: 'Six-week launches', tint: '#fbbf24' },
];
---

<div class:list={['freel', `freel--${variant}`, klass]} data-freel data-video-id={videoId}>
	<span class="freel__halo" aria-hidden="true"></span>

	<div class="freel__rig">
		<!-- the two handsets behind, same film, other moments -->
		<span class="freel__ghost freel__ghost--l" aria-hidden="true">
			<span class="freel__ghost-screen">
				<img src={sideL} alt="" width="576" height="1024" loading="lazy" decoding="async" />
			</span>
		</span>
		<span class="freel__ghost freel__ghost--r" aria-hidden="true">
			<span class="freel__ghost-screen">
				<img src={sideR} alt="" width="576" height="1024" loading="lazy" decoding="async" />
			</span>
		</span>

		<div class="freel__frame">
			<div class="freel__screen" data-freel-screen>
				<img
					class="freel__poster"
					src={still}
					data-freel-poster
					alt=""
					width="720"
					height="1280"
					decoding="async"
				/>
				<div class="freel__mount" data-freel-mount></div>

				<!-- YouTube never sees the pointer, so it never draws its own chrome -->
				<button
					class="freel__shield"
					type="button"
					data-freel-shield
					aria-label="Play or pause the reel"
				></button>

				<span class="freel__vignette" aria-hidden="true"></span>

				<div class="freel__top">
					<span class="freel__live">
						<Icon class="freel__livemark" width={12} name="mdi:filmstrip" />
						{kicker}
					</span>
					<span class="freel__ratio">9:16</span>
				</div>

				<!-- SOUND. Big, lit, and impossible to miss until it is pressed. -->
				<button class="freel__sound" type="button" data-freel-mute aria-label="Unmute">
					<span class="freel__sound-ic">
						<Icon class="freel__i-off" width={19} name="mdi:volume-off" />
						<Icon class="freel__i-on" width={19} name="mdi:volume-high" />
					</span>
					<span class="freel__sound-t">Tap for sound</span>
				</button>

				<div class="freel__bar">
					<button class="freel__btn" type="button" data-freel-toggle aria-label="Pause">
						<Icon class="freel__i-pause" width={17} name="mdi:pause" />
						<Icon class="freel__i-play" width={17} name="mdi:play" />
					</button>
					<div class="freel__track" data-freel-track>
						<span class="freel__fill" data-freel-fill></span>
					</div>
					<span class="freel__len">9:16</span>
				</div>
			</div>

			<span class="freel__notch" aria-hidden="true"></span>
		</div>

	</div>

	{note && <p class="freel__note">{note}</p>}

	<!-- what the rig is actually saying, on the floor beneath it -->
	<div class="freel__foot">
		<span class="freel__scrawl" aria-hidden="true">
			<em>More than<br />just code.</em>
			<svg viewBox="0 0 104 58" class="freel__scrawl-arrow">
				<!-- one hand-drawn stroke: down out of the note, then flat and
				     right, with the head landing on the first promise -->
				<path class="freel__arrow-line" d="M5 6C13 30 38 46 92 44" />
				<path class="freel__arrow-head" d="M79 35L96 44L80 53" />
			</svg>
		</span>

		<ul class="freel__chips" data-drift>
			{
				chips.map((c, i) => (
					<li style={`--t:${c.tint}; --i:${i}`}>
						<span class="freel__chip-ic"><Icon width={16} name={c.icon} /></span>
						{c.label}
					</li>
				))
			}
		</ul>
	</div>
</div>

<style>
	.freel {
		position: relative;
		width: 100%;
		--fr-a: var(--view-accent, #8b5cf6);
		--fr-b: #ec4899;
		--fr-w: clamp(15rem, 20vw, 19rem); /* the live handset's width */
	}

	/* the light the screen throws on the room */
	.freel__halo {
		position: absolute;
		inset: -10% -14% 2%;
		z-index: 0;
		border-radius: 50%;
		background: radial-gradient(
			ellipse at 50% 45%,
			color-mix(in srgb, var(--fr-a) 42%, transparent),
			transparent 68%
		);
		filter: blur(52px);
		opacity: 0.7;
		pointer-events: none;
		animation: freel-breathe 7s ease-in-out infinite;
	}
	@keyframes freel-breathe {
		0%, 100% { opacity: 0.5; transform: scale(1); }
		50% { opacity: 0.8; transform: scale(1.05); }
	}

	/* ── the rig ───────────────────────────────────────────────── */
	.freel__rig {
		position: relative;
		z-index: 1;
		display: grid;
		place-items: center;
		padding-block: 0.5rem;
	}

	.freel__frame {
		position: relative;
		z-index: 3;
		width: var(--fr-w);
		padding: 7px;
		border-radius: 2rem;
		background:
			linear-gradient(160deg, rgba(255, 255, 255, 0.22), rgba(255, 255, 255, 0.03) 42%, rgba(255, 255, 255, 0.12)),
			linear-gradient(150deg, var(--fr-a), var(--fr-b));
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.35) inset,
			0 44px 90px -34px rgba(0, 0, 0, 0.85),
			0 0 0 1px rgba(255, 255, 255, 0.08);
	}

	/* the two behind: same phone, angled back, dimmed */
	.freel__ghost {
		position: absolute;
		z-index: 1;
		top: 50%;
		width: calc(var(--fr-w) * 0.82);
		padding: 6px;
		border-radius: 1.7rem;
		background: linear-gradient(150deg, color-mix(in srgb, var(--fr-a) 55%, #241a44), #191233);
		box-shadow: 0 34px 70px -34px rgba(0, 0, 0, 0.9);
		pointer-events: none;
		opacity: 0.82;
		filter: saturate(0.92) brightness(0.86);
		transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.5s ease;
	}
	.freel__ghost--l {
		right: 58%;
		transform: translateY(-50%) rotate(-12deg) translateX(-4%) scale(0.9);
		transform-origin: bottom right;
	}
	.freel__ghost--r {
		left: 58%;
		transform: translateY(-50%) rotate(12deg) translateX(4%) scale(0.9);
		transform-origin: bottom left;
	}
	/* the fan opens a little when you point at the rig */
	.freel__rig:hover .freel__ghost--l {
		transform: translateY(-50%) rotate(-16deg) translateX(-11%) scale(0.93);
		opacity: 0.85;
	}
	.freel__rig:hover .freel__ghost--r {
		transform: translateY(-50%) rotate(16deg) translateX(11%) scale(0.93);
		opacity: 0.85;
	}
	.freel__ghost-screen {
		display: block;
		aspect-ratio: 9 / 16;
		overflow: hidden;
		border-radius: 1.35rem;
		background: #07060f;
	}
	.freel__ghost-screen img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.freel__ghost--l .freel__ghost-screen img { object-position: 50% 22%; transform: scale(1.06); }
	.freel__ghost--r .freel__ghost-screen img { object-position: 50% 40%; transform: scale(1.22); }

	/* ══ cinema: the same chrome around a landscape film ═══════════════
	   The About briefing was wearing the campus whiteboard, which belongs
	   to another world. This is the founder frame: one wide screen in the
	   world's gradient bezel, our own controls, nothing borrowed. */
	.freel--cinema { --fr-w: min(54rem, 100%); width: 100%; }
	.freel--cinema .freel__ghost,
	.freel--cinema .freel__foot { display: none !important; }
	.freel--cinema .freel__frame { width: 100%; max-width: var(--fr-w); }
	.freel--cinema .freel__screen { aspect-ratio: 16 / 9; border-radius: 1.1rem; }
	.freel--cinema .freel__halo { inset: -12% -8% 0; }
	.freel__note {
		margin: 0.75rem 0 0;
		font-family: 'Bradley Hand', 'Segoe Print', 'Comic Sans MS', cursive;
		font-size: 0.95rem;
		text-align: center;
		color: var(--fr-ink, #ede9fb);
		opacity: 0.72;
		transform: rotate(-1deg);
	}

	.freel__screen {
		position: relative;
		aspect-ratio: 9 / 16;
		width: 100%;
		overflow: hidden;
		border-radius: 1.6rem;
		background: #07060f;
		isolation: isolate;
	}

	.freel__poster,
	.freel__mount :global(iframe) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
		object-fit: cover;
	}
	.freel__poster { transition: opacity 0.5s ease; }
	.freel.is-live .freel__poster { opacity: 0; }
	.freel__mount { position: absolute; inset: 0; }

	.freel__shield {
		position: absolute;
		inset: 0;
		z-index: 3;
		background: transparent;
		border: 0;
		cursor: pointer;
	}

	.freel__vignette {
		position: absolute;
		inset: 0;
		z-index: 2;
		pointer-events: none;
		background:
			linear-gradient(180deg, rgba(7, 6, 15, 0.6) 0%, transparent 22%, transparent 62%, rgba(7, 6, 15, 0.78) 100%),
			radial-gradient(120% 90% at 50% 40%, transparent 55%, rgba(7, 6, 15, 0.45) 100%);
	}

	/* ── rails ─────────────────────────────────────────────────── */
	.freel__top {
		position: absolute;
		z-index: 4;
		top: 0.7rem;
		left: 0.7rem;
		right: 0.7rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		pointer-events: none;
	}
	.freel__live {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.28rem 0.6rem;
		border-radius: 9999px;
		font-size: 0.6rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: #fff;
		background: rgba(12, 10, 24, 0.55);
		border: 1px solid rgba(255, 255, 255, 0.16);
		-webkit-backdrop-filter: blur(8px);
		backdrop-filter: blur(8px);
	}
	.freel :global(.freel__livemark) {
		flex: none;
		animation: freel-reel 3s ease-in-out infinite;
	}
	@keyframes freel-reel {
		0%, 100% { opacity: 0.72; transform: translateY(0) rotate(0deg); }
		50% { opacity: 1; transform: translateY(-1px) rotate(-6deg); }
	}
	.freel__ratio {
		font-family: ui-monospace, monospace;
		font-size: 0.58rem;
		letter-spacing: 0.12em;
		color: rgba(255, 255, 255, 0.5);
	}

	/* ── the sound button: the loudest thing on the frame ──────── */
	.freel__sound {
		position: absolute;
		z-index: 6;
		left: 50%;
		bottom: 3.9rem;
		transform: translateX(-50%);
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.42rem 0.9rem 0.42rem 0.42rem;
		border-radius: 9999px;
		font-size: 0.78rem;
		font-weight: 800;
		font-family: inherit;
		white-space: nowrap;
		color: #14101f;
		background: #fff;
		border: 0;
		cursor: pointer;
		box-shadow:
			0 0 0 0 rgba(255, 255, 255, 0.5),
			0 14px 30px -12px rgba(0, 0, 0, 0.85);
		animation: freel-callout 2.4s ease-out infinite;
		transition: background 0.25s ease, color 0.25s ease, padding 0.25s ease;
	}
	.freel__sound-ic {
		display: grid;
		place-items: center;
		width: 28px;
		height: 28px;
		flex: none;
		border-radius: 9999px;
		color: #fff;
		background: linear-gradient(135deg, var(--fr-a), var(--fr-b));
	}
	@keyframes freel-callout {
		0% { box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.55), 0 14px 30px -12px rgba(0, 0, 0, 0.85); }
		70%, 100% { box-shadow: 0 0 0 16px rgba(255, 255, 255, 0), 0 14px 30px -12px rgba(0, 0, 0, 0.85); }
	}
	/* once it has sound it stops shouting and becomes a plain mute toggle */
	.freel.has-sound .freel__sound {
		animation: none;
		padding: 0.42rem;
		color: #fff;
		background: rgba(12, 10, 24, 0.6);
		border: 1px solid rgba(255, 255, 255, 0.18);
		-webkit-backdrop-filter: blur(10px);
		backdrop-filter: blur(10px);
	}
	.freel.has-sound .freel__sound-t { display: none; }
	.freel__i-on { display: none; }
	.freel.has-sound .freel__i-on { display: block; }
	.freel.has-sound .freel__i-off { display: none; }

	.freel__bar {
		position: absolute;
		z-index: 4;
		left: 0.7rem;
		right: 0.7rem;
		bottom: 0.7rem;
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.4rem 0.6rem 0.4rem 0.4rem;
		border-radius: 9999px;
		background: rgba(12, 10, 24, 0.5);
		border: 1px solid rgba(255, 255, 255, 0.14);
		-webkit-backdrop-filter: blur(10px);
		backdrop-filter: blur(10px);
	}
	.freel__btn {
		display: grid;
		place-items: center;
		width: 30px;
		height: 30px;
		flex: none;
		border-radius: 9999px;
		color: #fff;
		background: rgba(255, 255, 255, 0.1);
		border: 0;
		cursor: pointer;
		transition: background 0.2s ease, transform 0.2s ease;
	}
	.freel__btn:hover { background: rgba(255, 255, 255, 0.2); transform: scale(1.06); }
	.freel__i-play { display: none; }
	.freel.is-paused .freel__i-play { display: block; }
	.freel.is-paused .freel__i-pause { display: none; }
	.freel__len {
		font-family: ui-monospace, monospace;
		font-size: 0.58rem;
		color: rgba(255, 255, 255, 0.45);
		flex: none;
	}

	.freel__track {
		position: relative;
		flex: 1;
		height: 4px;
		min-width: 0;
		border-radius: 9999px;
		background: rgba(255, 255, 255, 0.18);
		cursor: pointer;
	}
	.freel__fill {
		position: absolute;
		inset: 0 auto 0 0;
		width: 0%;
		border-radius: 9999px;
		background: linear-gradient(90deg, #fff, var(--fr-b));
	}

	.freel__notch {
		position: absolute;
		left: 50%;
		bottom: -6px;
		width: 34%;
		height: 6px;
		transform: translateX(-50%);
		border-radius: 0 0 9999px 9999px;
		background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.28), transparent);
	}

	/* ── the floor under the rig: a note on the left, the promises on the
	   right. This is the band that used to be dead space. ─────────── */
	.freel__foot {
		position: relative;
		z-index: 4;
		display: none;
		align-items: center;
		justify-content: space-between;
		gap: clamp(0.6rem, 1.6vw, 1.1rem);
		width: 100%;
		/* the fanned handsets hang below the live one, so the floor starts
		   clear of them rather than under their corners */
		margin-top: clamp(1.6rem, 3.4vw, 3rem);
		padding-inline: clamp(0.5rem, 2vw, 1.5rem);
	}
	.freel__chips {
		display: flex;
		flex-wrap: wrap;
		flex: 1 1 auto;
		min-width: 0;
		justify-content: flex-end;
		gap: clamp(0.4rem, 0.9vw, 0.7rem);
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.freel__chips li {
		display: inline-flex;
		flex: none;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 0.9rem 0.5rem 0.5rem;
		border-radius: 0.8rem;
		font-size: 0.76rem;
		font-weight: 750;
		white-space: nowrap;
		color: var(--fr-ink, #ede9fb);
		background: color-mix(in srgb, var(--t) 12%, rgba(20, 15, 40, 0.72));
		border: 1px solid color-mix(in srgb, var(--t) 34%, transparent);
		-webkit-backdrop-filter: blur(12px);
		backdrop-filter: blur(12px);
		box-shadow: 0 18px 36px -22px rgba(0, 0, 0, 0.8);
		animation: freel-float 5.5s ease-in-out infinite;
		animation-delay: calc(var(--i) * -1.6s);
	}
	.freel__chip-ic {
		display: grid;
		place-items: center;
		width: 26px;
		height: 26px;
		flex: none;
		border-radius: 0.55rem;
		color: #fff;
		background: color-mix(in srgb, var(--t) 72%, transparent);
	}
	@keyframes freel-float {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(-6px); }
	}

	.freel__scrawl {
		display: inline-flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.1rem;
		flex: none;
		color: var(--fr-ink, #ede9fb);
	}
	.freel__scrawl em { white-space: nowrap; }
	.freel__scrawl em {
		font-family: 'Bradley Hand', 'Segoe Print', 'Comic Sans MS', cursive;
		font-style: normal;
		font-size: 1.28rem;
		font-weight: 700;
		line-height: 1.08;
		transform: rotate(-4deg);
	}
	.freel__scrawl-arrow {
		width: clamp(150px, 13vw, 200px);
		height: auto;
		flex: none;
		margin: -0.15rem 0 0 0.9rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2.6;
		stroke-linecap: round;
		stroke-linejoin: round;
		opacity: 0.75;
		overflow: visible;
		filter: drop-shadow(0 2px 8px color-mix(in srgb, var(--fr-a) 45%, transparent));
		animation: freel-point 2.6s ease-in-out infinite;
	}
	/* it leans toward what it is pointing at, then eases back */
	@keyframes freel-point {
		0%, 100% { transform: translateX(0) rotate(0deg); opacity: 0.6; }
		45% { transform: translateX(7px) rotate(-3deg); opacity: 1; }
	}
	/* and the line itself keeps re-drawing, so the hand looks live */
	.freel__arrow-line { stroke-dasharray: 120; animation: freel-ink 2.6s ease-in-out infinite; }
	@keyframes freel-ink {
		0% { stroke-dashoffset: 116; }
		45%, 100% { stroke-dashoffset: 0; }
	}
	.freel__arrow-head { stroke-width: 3; }

	/* the fan and the furniture are a wide-screen luxury */
	@media (min-width: 1024px) {
		.freel__foot { display: flex; }
	}
	/* On a phone the floor still appears — the note and its arrow on top,
	   the three promises in a row you can flick. */
	@media (max-width: 1023px) {
		.freel__foot {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 0.7rem;
			margin-top: 1.1rem;
		}
		.freel__scrawl { align-items: center; flex: none; }
		.freel__scrawl em { font-size: 1.05rem; text-align: center; }
		.freel__scrawl-arrow { width: 84px; margin: -0.1rem 0 0; transform: rotate(88deg); }
		@keyframes freel-point {
			0%, 100% { transform: rotate(88deg) translateX(0); opacity: 0.6; }
			45% { transform: rotate(88deg) translateX(6px); opacity: 1; }
		}
		.freel__chips {
			flex-wrap: nowrap;
			justify-content: flex-start;
			width: 100%;
			overflow-x: auto;
			overscroll-behavior-x: contain;
			scroll-snap-type: x proximity;
			scrollbar-width: none;
			-ms-overflow-style: none;
			/* the row owns the horizontal gesture, so a flick moves the
			   chips instead of dragging the page sideways */
			touch-action: pan-x;
			-webkit-overflow-scrolling: touch;
			margin-inline: calc(var(--fr-bleed, 1rem) * -1);
			padding-inline: var(--fr-bleed, 1rem);
			-webkit-mask-image: linear-gradient(90deg, transparent, #000 1.2rem, #000 calc(100% - 1.8rem), transparent);
			mask-image: linear-gradient(90deg, transparent, #000 1.2rem, #000 calc(100% - 1.8rem), transparent);
		}
		.freel__chips::-webkit-scrollbar { display: none; }
		.freel__chips li { flex: none; scroll-snap-align: start; }
		/* a single hint on first sight that there is more to the right */
		.freel__chips li:last-child { margin-right: 0.2rem; }
	}
	/* On a phone the fan does not disappear — it just peeks. Two slivers of
	   the other frames lean in from the edges, tilted further back, so the
	   hero still reads as a rig rather than one lonely handset. */
