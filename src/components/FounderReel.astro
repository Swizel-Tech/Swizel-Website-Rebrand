---
// The founder's reel — one film, three phones.
//
// On a wide screen the film is a rig: the live player stands upright in the
// middle with two more handsets fanned out behind it, angled and dimmed, so
// the right-hand half of the hero is furniture instead of empty space. On a
// phone the fan collapses and only the live handset is left.
//
// The source is a YouTube short, so the frame is 9:16 and the chrome is
// ours: it starts muted the moment it is on screen (the only autoplay a
// browser allows), loops, and hands sound over on one obvious press.
import { Icon } from 'astro-icon/components';

interface Props {
	videoId: string;
	kicker?: string;
	still?: string;
	/**
	 * rig    — the three-handset hero (9:16)
	 * cinema — one wide frame for a landscape film, same founder chrome
	 */
	variant?: 'rig' | 'cinema';
	note?: string;
	/**
	 * false stops the film dead at the end and shows our own end card.
	 * Nothing from YouTube is ever allowed to follow it.
	 */
	loop?: boolean;
	/** what the end card offers to do next */
	endLabel?: string;
	class?: string;
}

const {
	videoId,
	kicker = 'Founder’s cut',
	still,
	variant = 'rig',
	note,
	loop = true,
	endLabel = 'Watch it again',
	class: klass = '',
} = Astro.props;

// The cover. Unless a still is handed in deliberately, this is the film's
// own thumbnail as it is set on YouTube — not a frame we picked, which is
// what used to sit here and never matched the upload. maxres does not exist
// for every video, so the script falls back to hq, and then to our still.
const poster = still || `https://i.ytimg.com/vi/${videoId}/maxresdefault.jpg`;
// A chain, not a single fallback: maxres is not generated for every upload,
// hq always is, and if neither can be reached at all we still want a picture
// rather than a hole.
const posterChain = (
	still
		? ['/images/founder/reel-still.jpg']
		: [
				`https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`,
				`https://img.youtube.com/vi/${videoId}/hqdefault.jpg`,
				'/images/founder/reel-still.jpg',
			]
).join('|');

// the two handsets behind the live one carry other moments from the same
// story — the founder we built for, actually at work
const sideL = '/images/founder/reel-b.jpg';
const sideR = '/images/founder/reel-c.jpg';

// the three things a founder is actually shopping for, floated beside the rig
const chips = [
	{ icon: 'mdi:rocket-launch-outline', label: 'Real projects', tint: '#8b5cf6' },
	{ icon: 'mdi:account-group-outline', label: 'Expert team', tint: '#22d3ee' },
	{ icon: 'mdi:shield-check-outline', label: 'Long-term support', tint: '#ec4899' },
	{ icon: 'mdi:timer-sand', label: 'Six-week launches', tint: '#fbbf24' },
];
---

<div
	class:list={['freel', `freel--${variant}`, klass]}
	data-freel
	data-video-id={videoId}
	data-loop={loop ? '1' : '0'}
>
	<span class="freel__halo" aria-hidden="true"></span>

	<div class="freel__rig">
		<!-- the two handsets behind, same film, other moments -->
		<span class="freel__ghost freel__ghost--l" aria-hidden="true">
			<span class="freel__ghost-screen">
				<img src={sideL} alt="" width="576" height="1024" loading="lazy" decoding="async" />
			</span>
		</span>
		<span class="freel__ghost freel__ghost--r" aria-hidden="true">
			<span class="freel__ghost-screen">
				<img src={sideR} alt="" width="576" height="1024" loading="lazy" decoding="async" />
			</span>
		</span>

		<div class="freel__frame">
			<div class="freel__screen" data-freel-screen>
				<img
					class="freel__poster"
					src={poster}
					data-freel-poster
					data-fallback={posterChain}
					alt=""
					width="1280"
					height="720"
					loading="lazy"
					decoding="async"
				/>
				<div class="freel__mount" data-freel-mount></div>

				<!-- YouTube never sees the pointer, so it never draws its own chrome -->
				<button
					class="freel__shield"
					type="button"
					data-freel-shield
					aria-label="Play or pause the reel"
				></button>

				<span class="freel__vignette" aria-hidden="true"></span>

				<div class="freel__top">
					<span class="freel__live">
						<Icon class="freel__livemark" width={12} name="mdi:filmstrip" />
						{kicker}
					</span>
					<span class="freel__ratio">{variant === 'cinema' ? 'Full film' : '9:16'}</span>
				</div>

				<!-- SOUND. Big, lit, and impossible to miss until it is pressed. -->
				<button class="freel__sound" type="button" data-freel-mute aria-label="Unmute">
					<span class="freel__sound-ic">
						<Icon class="freel__i-off" width={19} name="mdi:volume-off" />
						<Icon class="freel__i-on" width={19} name="mdi:volume-high" />
					</span>
					<span class="freel__sound-t">Tap for sound</span>
				</button>

				<div class="freel__bar">
					<!-- ten seconds either way. A briefing is ten minutes long;
					     nobody should have to drag a four-pixel scrubber to
					     hear a sentence again. -->
					<button class="freel__btn freel__btn--skip" type="button" data-freel-back aria-label="Back ten seconds">
						<Icon width={16} name="mdi:rewind-10" />
					</button>
					<button class="freel__btn" type="button" data-freel-toggle aria-label="Pause">
						<Icon class="freel__i-pause" width={17} name="mdi:pause" />
						<Icon class="freel__i-play" width={17} name="mdi:play" />
					</button>
					<button class="freel__btn freel__btn--skip" type="button" data-freel-fwd aria-label="Forward ten seconds">
						<Icon width={16} name="mdi:fast-forward-10" />
					</button>
					<div class="freel__track" data-freel-track>
						<span class="freel__buf" data-freel-buf></span>
						<span class="freel__fill" data-freel-fill></span>
					</div>
					<!-- the real clock, not the aspect ratio pretending to be one -->
					<span class="freel__len" data-freel-time>0:00</span>
					<!-- once sound is on the big pill leaves the picture and the
					     mute toggle lives down here with the other controls -->
					<button class="freel__btn freel__btn--vol" type="button" data-freel-mute2 aria-label="Mute">
						<Icon class="freel__i-on" width={16} name="mdi:volume-high" />
						<Icon class="freel__i-off" width={16} name="mdi:volume-off" />
					</button>
				</div>

				<!-- the end card. Only for films that are not on a loop: the
				     player stops on our own frame so YouTube never gets the
				     chance to offer anything else. -->
				{!loop && (
					<div class="freel__end" data-freel-end>
						<span class="freel__end-ic">
							<Icon width={26} name="mdi:replay" />
						</span>
						<p class="freel__end-t">That is the film.</p>
						<button class="freel__end-go" type="button" data-freel-replay>
							{endLabel}
						</button>
					</div>
				)}
			</div>

			<span class="freel__notch" aria-hidden="true"></span>
		</div>

	</div>

	{note && <p class="freel__note">{note}</p>}

	<!-- what the rig is actually saying, on the floor beneath it -->
	<div class="freel__foot">
		<span class="freel__scrawl" aria-hidden="true">
			<em>More than<br />just code.</em>
			<svg viewBox="0 0 104 58" class="freel__scrawl-arrow">
				<!-- one hand-drawn stroke: down out of the note, then flat and
				     right, with the head landing on the first promise -->
				<path class="freel__arrow-line" d="M5 6C13 30 38 46 92 44" />
				<path class="freel__arrow-head" d="M79 35L96 44L80 53" />
			</svg>
		</span>

		<ul class="freel__chips" data-drift>
			{
				chips.map((c, i) => (
					<li style={`--t:${c.tint}; --i:${i}`}>
						<span class="freel__chip-ic"><Icon width={16} name={c.icon} /></span>
						{c.label}
					</li>
				))
			}
		</ul>
	</div>
</div>

<style>
	.freel {
		position: relative;
		width: 100%;
		--fr-a: var(--view-accent, #8b5cf6);
		--fr-b: #ec4899;
		--fr-w: clamp(15rem, 20vw, 19rem); /* the live handset's width */
	}

	/* the light the screen throws on the room */
	.freel__halo {
		position: absolute;
		inset: -10% -14% 2%;
		z-index: 0;
		border-radius: 50%;
		background: radial-gradient(
			ellipse at 50% 45%,
			color-mix(in srgb, var(--fr-a) 42%, transparent),
			transparent 68%
		);
		filter: blur(52px);
		opacity: 0.7;
		pointer-events: none;
		animation: freel-breathe 7s ease-in-out infinite;
	}
	@keyframes freel-breathe {
		0%, 100% { opacity: 0.5; transform: scale(1); }
		50% { opacity: 0.8; transform: scale(1.05); }
	}

	/* ── the rig ───────────────────────────────────────────────── */
	.freel__rig {
		position: relative;
		z-index: 1;
		display: grid;
		place-items: center;
		padding-block: 0.5rem;
	}

	.freel__frame {
		position: relative;
		z-index: 3;
		width: var(--fr-w);
		padding: 7px;
		border-radius: 2rem;
		background:
			linear-gradient(160deg, rgba(255, 255, 255, 0.22), rgba(255, 255, 255, 0.03) 42%, rgba(255, 255, 255, 0.12)),
			linear-gradient(150deg, var(--fr-a), var(--fr-b));
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.35) inset,
			0 44px 90px -34px rgba(0, 0, 0, 0.85),
			0 0 0 1px rgba(255, 255, 255, 0.08);
	}

	/* the two behind: same phone, angled back, dimmed */
	.freel__ghost {
		position: absolute;
		z-index: 1;
		top: 50%;
		width: calc(var(--fr-w) * 0.82);
		padding: 6px;
		border-radius: 1.7rem;
		background: linear-gradient(150deg, color-mix(in srgb, var(--fr-a) 55%, #241a44), #191233);
		box-shadow: 0 34px 70px -34px rgba(0, 0, 0, 0.9);
		pointer-events: none;
		opacity: 0.82;
		filter: saturate(0.92) brightness(0.86);
		transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.5s ease;
	}
	.freel__ghost--l {
		right: 58%;
		transform: translateY(-50%) rotate(-12deg) translateX(-4%) scale(0.9);
		transform-origin: bottom right;
	}
	.freel__ghost--r {
		left: 58%;
		transform: translateY(-50%) rotate(12deg) translateX(4%) scale(0.9);
		transform-origin: bottom left;
	}
	/* the fan opens a little when you point at the rig */
	.freel__rig:hover .freel__ghost--l {
		transform: translateY(-50%) rotate(-16deg) translateX(-11%) scale(0.93);
		opacity: 0.85;
	}
	.freel__rig:hover .freel__ghost--r {
		transform: translateY(-50%) rotate(16deg) translateX(11%) scale(0.93);
		opacity: 0.85;
	}
	.freel__ghost-screen {
		display: block;
		aspect-ratio: 9 / 16;
		overflow: hidden;
		border-radius: 1.35rem;
		background: #07060f;
	}
	.freel__ghost-screen img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.freel__ghost--l .freel__ghost-screen img { object-position: 50% 22%; transform: scale(1.06); }
	.freel__ghost--r .freel__ghost-screen img { object-position: 50% 40%; transform: scale(1.22); }

	/* ══ cinema: the same chrome around a landscape film ═══════════════
	   The About briefing was wearing the campus whiteboard, which belongs
	   to another world. This is the founder frame: one wide screen in the
	   world's gradient bezel, our own controls, nothing borrowed. */
	/* A proper tablet, not a thumbnail. The About briefing is ten minutes of
	   the crew talking; it is the point of that half of the hero, so it gets
	   the size of a large iPad propped on a desk: a thick aluminium bezel, a
	   camera dot, and it breaks out past its column on a wide screen rather
	   than politely fitting inside it. */
	.freel--cinema { --fr-w: min(64rem, 100%); width: 100%; }
	.freel--cinema .freel__ghost,
	.freel--cinema .freel__foot { display: none !important; }
	.freel--cinema .freel__frame {
		width: 100%;
		max-width: var(--fr-w);
		margin-inline: auto;
		padding: clamp(10px, 1.1vw, 18px);
		border-radius: clamp(1.4rem, 2vw, 2.1rem);
		background:
			linear-gradient(158deg, #4a4358 0%, #211d2c 26%, #17141f 62%, #322c3f 100%);
		box-shadow:
			0 0 0 1px rgba(255, 255, 255, 0.14) inset,
			0 2px 0 rgba(255, 255, 255, 0.1) inset,
			0 44px 90px -40px rgba(12, 6, 32, 0.85),
			0 16px 36px -24px rgba(12, 6, 32, 0.7);
	}
	.freel--cinema .freel__screen {
		aspect-ratio: 16 / 10;
		border-radius: clamp(0.7rem, 1vw, 1.05rem);
		box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.6) inset;
	}
	/* the camera, so it reads as a device rather than a floating rectangle */
	.freel--cinema .freel__notch {
		display: block;
		position: absolute;
		top: clamp(4px, 0.5vw, 8px);
		left: 50%;
		width: 6px;
		height: 6px;
		margin-left: -3px;
		border-radius: 9999px;
		background: radial-gradient(circle at 34% 30%, #6d6486, #1a1723 70%);
		box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.1);
	}
	.freel--cinema .freel__halo { inset: -16% -10% -4%; }
	/* on a wide screen it leans out of its column, the way a tablet on a desk
	   overhangs the papers next to it */
	@media (min-width: 1200px) {
		.freel--cinema { width: calc(100% + clamp(1rem, 5vw, 5.5rem)); }
	}
	/* the chrome grows with the frame so a 1000px screen is not wearing
	   phone-sized buttons */
	.freel--cinema .freel__bar {
		left: 1.1rem;
		right: 1.1rem;
		bottom: 1.1rem;
		gap: 0.7rem;
		padding: 0.5rem 0.8rem 0.5rem 0.5rem;
	}
	.freel--cinema .freel__btn { width: 38px; height: 38px; }
	.freel--cinema .freel__btn--skip,
	.freel--cinema .freel__btn--vol { width: 34px; height: 34px; }
	.freel--cinema .freel__len { font-size: 0.8rem; }
	.freel--cinema .freel__sound { bottom: 5rem; font-size: 0.86rem; }
	.freel--cinema .freel__track { height: 5px; }
	.freel__note {
		margin: 0.75rem 0 0;
		font-family: 'Bradley Hand', 'Segoe Print', 'Comic Sans MS', cursive;
		font-size: 0.95rem;
		text-align: center;
		color: var(--fr-ink, #ede9fb);
		opacity: 0.72;
		transform: rotate(-1deg);
	}

	.freel__screen {
		position: relative;
		aspect-ratio: 9 / 16;
		width: 100%;
		overflow: hidden;
		border-radius: 1.6rem;
		background: #07060f;
		isolation: isolate;
	}

	.freel__poster,
	.freel__mount :global(iframe) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
		object-fit: cover;
	}
	/* The cover used to be dismissed the moment the player object existed,
	   which is before a single frame has arrived — so on anything but a fast
	   line the visitor watched a black rectangle instead of the thumbnail.
	   It now holds until the film is genuinely playing. */
	.freel__poster { transition: opacity 0.45s ease; }
	.freel.is-live .freel__poster { opacity: 0; }
	/* a slow pulse while the film is still coming down the wire */
	.freel:not(.is-live) .freel__poster { animation: freel-wait 2.6s ease-in-out infinite; }
	/* every cover in the chain failed: show the world's gradient rather than
	   a broken-image hole */
	.freel.is-coverless .freel__poster { opacity: 0; }
	.freel.is-coverless .freel__screen {
		background:
			radial-gradient(120% 90% at 50% 40%, color-mix(in srgb, var(--fr-a) 40%, #07060f), #07060f);
	}
	@keyframes freel-wait {
		0%, 100% { filter: brightness(1); }
		50% { filter: brightness(1.08); }
	}
	.freel__mount { position: absolute; inset: 0; }

	.freel__shield {
		position: absolute;
		inset: 0;
		z-index: 3;
		background: transparent;
		border: 0;
		cursor: pointer;
	}

	.freel__vignette {
		position: absolute;
		inset: 0;
		z-index: 2;
		pointer-events: none;
		background:
			linear-gradient(180deg, rgba(7, 6, 15, 0.6) 0%, transparent 22%, transparent 62%, rgba(7, 6, 15, 0.78) 100%),
			radial-gradient(120% 90% at 50% 40%, transparent 55%, rgba(7, 6, 15, 0.45) 100%);
	}
	/* YouTube paints its own watermark into the bottom of the iframe and there
	   is no parameter left that removes it. This is an opaque floor under our
	   control bar, deep enough to swallow it at any frame size. */
	.freel__screen::after {
		content: '';
		position: absolute;
		z-index: 3;
		inset: auto 0 0 0;
		height: clamp(52px, 22%, 88px);
		pointer-events: none;
		background: linear-gradient(180deg, transparent, rgba(7, 6, 15, 0.82) 46%, rgba(7, 6, 15, 0.96));
	}

	/* ── rails ─────────────────────────────────────────────────── */
	.freel__top {
		position: absolute;
		z-index: 4;
		top: 0.7rem;
		left: 0.7rem;
		right: 0.7rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		pointer-events: none;
	}
	.freel__live {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.28rem 0.6rem;
		border-radius: 9999px;
		font-size: 0.7rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: #fff;
		background: rgba(12, 10, 24, 0.55);
		border: 1px solid rgba(255, 255, 255, 0.16);
		-webkit-backdrop-filter: blur(8px);
		backdrop-filter: blur(8px);
	}
	.freel :global(.freel__livemark) {
		flex: none;
		animation: freel-reel 3s ease-in-out infinite;
	}
	@keyframes freel-reel {
		0%, 100% { opacity: 0.72; transform: translateY(0) rotate(0deg); }
		50% { opacity: 1; transform: translateY(-1px) rotate(-6deg); }
	}
	.freel__ratio {
		font-family: ui-monospace, monospace;
		font-size: 0.7rem;
		letter-spacing: 0.12em;
		color: rgba(255, 255, 255, 0.5);
	}

	/* ── the sound button: the loudest thing on the frame ──────── */
	.freel__sound {
		position: absolute;
		z-index: 6;
		left: 50%;
		bottom: 3.9rem;
		transform: translateX(-50%);
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.42rem 0.9rem 0.42rem 0.42rem;
		border-radius: 9999px;
		font-size: 0.78rem;
		font-weight: 800;
		font-family: inherit;
		white-space: nowrap;
		color: #14101f;
		background: #fff;
		border: 0;
		cursor: pointer;
		box-shadow:
			0 0 0 0 rgba(255, 255, 255, 0.5),
			0 14px 30px -12px rgba(0, 0, 0, 0.85);
		animation: freel-callout 2.4s ease-out infinite;
		transition: background 0.25s ease, color 0.25s ease, padding 0.25s ease;
	}
	.freel__sound-ic {
		display: grid;
		place-items: center;
		width: 28px;
		height: 28px;
		flex: none;
		border-radius: 9999px;
		color: #fff;
		background: linear-gradient(135deg, var(--fr-a), var(--fr-b));
	}
	@keyframes freel-callout {
		0% { box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.55), 0 14px 30px -12px rgba(0, 0, 0, 0.85); }
		70%, 100% { box-shadow: 0 0 0 16px rgba(255, 255, 255, 0), 0 14px 30px -12px rgba(0, 0, 0, 0.85); }
	}
	/* Once the sound is on, the pill has said its only sentence. It used to
	   shrink into a second mute button parked in the middle of the picture,
	   which left a control floating over the film forever. Now it leaves,
	   and muting lives in the bar with everything else. */
	.freel.has-sound .freel__sound {
		opacity: 0;
		transform: translateX(-50%) translateY(6px) scale(0.92);
		pointer-events: none;
		animation: none;
		visibility: hidden;
		transition: opacity 0.3s ease, transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
			visibility 0s linear 0.35s;
	}
	.freel__i-on { display: none; }
	.freel.has-sound .freel__i-on { display: block; }
	.freel.has-sound .freel__i-off { display: none; }
	/* the in-bar volume button is the mirror image: absent until there is
	   sound to turn off */
	.freel__btn--vol { display: none; }
	.freel.has-sound .freel__btn--vol { display: grid; }
	.freel.has-sound .freel__btn--vol .freel__i-off { display: none; }
	.freel.has-sound .freel__btn--vol .freel__i-on { display: block; }

	.freel__bar {
		position: absolute;
		z-index: 4;
		left: 0.7rem;
		right: 0.7rem;
		bottom: 0.7rem;
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.4rem 0.6rem 0.4rem 0.4rem;
		border-radius: 9999px;
		background: rgba(12, 10, 24, 0.5);
		border: 1px solid rgba(255, 255, 255, 0.14);
		-webkit-backdrop-filter: blur(10px);
		backdrop-filter: blur(10px);
	}
	.freel__btn {
		display: grid;
		place-items: center;
		width: 30px;
		height: 30px;
		flex: none;
		border-radius: 9999px;
		color: #fff;
		background: rgba(255, 255, 255, 0.1);
		border: 0;
		cursor: pointer;
		transition: background 0.2s ease, transform 0.2s ease;
	}
	.freel__btn:hover { background: rgba(255, 255, 255, 0.2); transform: scale(1.06); }
	.freel__btn:active { transform: scale(0.94); }
	.freel__i-play { display: none; }
	.freel.is-paused .freel__i-play { display: block; }
